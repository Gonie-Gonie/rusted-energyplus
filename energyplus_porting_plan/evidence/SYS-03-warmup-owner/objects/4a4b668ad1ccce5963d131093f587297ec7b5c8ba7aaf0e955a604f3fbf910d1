+// Destructure every actual snapshot field, so future added owners cannot silently
+// disappear from this no-transport handoff check.
+fn assert_weather_snapshot_matches(
+    actual: super::production_trace::WeatherSessionSnapshot,
+    expected: &super::production_trace::WeatherSessionSnapshot,
+) {
+    let super::production_trace::WeatherSessionSnapshot {
+        state, header, stream, raw_arguments, cursor_byte, line_read_count,
+        interpret_count, available, errors_found, print_environment_stamp,
+        current_cycle, set_week_days,
+    } = actual;
+    assert_eq!(state, expected.state);
+    assert_eq!(header, expected.header);
+    assert_eq!(stream, expected.stream);
+    assert_eq!(raw_arguments, expected.raw_arguments);
+    assert_eq!(cursor_byte, expected.cursor_byte);
+    assert_eq!(line_read_count, expected.line_read_count);
+    assert_eq!(interpret_count, expected.interpret_count);
+    assert_eq!(available, expected.available);
+    assert_eq!(errors_found, expected.errors_found);
+    assert_eq!(print_environment_stamp, expected.print_environment_stamp);
+    assert_eq!(current_cycle, expected.current_cycle);
+    assert_eq!(set_week_days, expected.set_week_days);
+}

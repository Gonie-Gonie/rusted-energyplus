"""Emit ignored source proposals and metadata only; never import reviewed targets."""
import ast
import difflib
import hashlib
import json
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
PREP = Path(__file__).resolve().parent
OLD = ROOT / ".runtime/porting/CTF-08/comparer-prep-04"
QA = ROOT / ".runtime/porting/CTF-09/original-data-review-prep-02"
OBS = ROOT / ".runtime/porting/CTF-09/rust-observer-prep-01"


def identity(path):
    raw = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(raw).hexdigest(),
            "size_bytes": len(raw), "line_count": len(raw.splitlines())}


def assignments(path):
    result = {}
    for node in ast.parse(path.read_text(encoding="utf-8")).body:
        if isinstance(node, ast.Assign) and isinstance(node.targets[0], ast.Name):
            try:
                result[node.targets[0].id] = ast.literal_eval(node.value)
            except (ValueError, TypeError):
                pass
    return result


def replace(text, old, new, count=1):
    assert text.count(old) == count, (old[:120], text.count(old), count)
    return text.replace(old, new)


def write(name, text):
    (PREP / name).write_text(text, encoding="utf-8", newline="\n")


def diff(before, after, label):
    return "".join(difflib.unified_diff(before.splitlines(keepends=True), after.splitlines(keepends=True),
        fromfile=("accepted-CTF08/" + label if before else "/dev/null"), tofile="proposed-CTF09/" + label))


def rust_paths(path, name):
    source = path.read_text(encoding="utf-8")
    body = re.search(r"const " + name + r": &\[&str\] = &\[(.*?)\];", source, re.S).group(1)
    return re.findall(r'"([^"]+)"', body)


def main():
    assert not (PREP / "manifest.json").exists(), "Immutable held source is never rewritten"
    before = PREP / "before"; before.mkdir(exist_ok=True)
    deltas = PREP / "diffs"; deltas.mkdir(exist_ok=True)
    # The exact old numeric helper is retained; only its copied/values/matrix_map utilities run.
    copy_sources = {"method_compare.py": OLD, "packet_io.py": OLD, "initial_shape.py": QA,
        "method_shape.py": QA, "gamma_shape.py": QA, "coefficient_shape.py": QA, "retry_shape.py": QA}
    for name, owner in copy_sources.items():
        raw = (owner / name).read_bytes()
        (PREP / name).write_bytes(raw if name != "packet_io.py" else raw.replace(b'CTF-08"', b'CTF-09"'))

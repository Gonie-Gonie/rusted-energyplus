        "reviewed_freezer_source_inventory": ".runtime/porting/CTF-09/input-writer-prep-01/manifest.json",
        "reviewed_PE_source_inventory": ".runtime/porting/CTF-09/native-build-review-prep-01/manifest.json"}.items()}
    initial_constants = assignments(QA / "initial_shape.py")

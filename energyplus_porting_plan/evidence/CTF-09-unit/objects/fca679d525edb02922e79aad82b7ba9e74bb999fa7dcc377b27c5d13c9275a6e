def write(name, value):
    path = DEST / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(value.encode('utf-8'))
    return path

def ref(path):
    raw = path.read_bytes()
    return {'path':path.relative_to(ROOT).as_posix(), 'sha256':hashlib.sha256(raw).hexdigest(),
            'size_bytes':len(raw), 'line_count':len(raw.splitlines())}

def replace_once(source, before, after):
    assert source.count(before) == 1, before[:100]
    return source.replace(before, after, 1)

def old_function(source, name):
    start = source.index('pub(super) fn ' + name + '(')
    end = source.index('\npub(super) fn ', start + 1) if '\npub(super) fn ' in source[start+1:] else len(source)
    return source[start:end]


+// The single copy of the selected source loop's repeated assignments.
+#[allow(clippy::neg_multiply)] // Retain the original interface multiplication order.
+fn assign_1d_ctf_state_space(
+    layers: &[CtfNormalizedLayer],
+    nodes: &[i32],
+    dx: &[f64],
+    rcmax: usize,
+    a_mat: &mut [f64],
+    b_mat: &mut [f64; 3],
+    checkpoint: Option<(&mut Option<CtfAssemblyPreAssignment>, CtfAssemblyContext, i32, &[f64])>,
+) -> ([f64; 2], [f64; 2]) {
+    let count = layers.len();
+    // Construction.cc 659, before the selected 1D assignments.
+    b_mat[2] = 0.0;
+    if let Some((destination, context, source_rcmax, iden_matrix)) = checkpoint {
+        *destination = Some(CtfAssemblyPreAssignment {
+            context,
+            rcmax: source_rcmax,
+            a_mat: a_mat.to_vec(),
+            iden_matrix: iden_matrix.to_vec(),
+            b_mat3_after_reset: b_mat[2],
+        });
+    }
+    let mut cap = layers[0].rho * layers[0].cp * dx[0];
+    cap *= 1.5;
+    let mut dxtmp = 1.0 / dx[0] / cap;
+    write_a(a_mat, rcmax, 1, 1, -2.0 * layers[0].rk * dxtmp);
+    write_a(a_mat, rcmax, 2, 1, layers[0].rk * dxtmp);
+    b_mat[0] = layers[0].rk * dxtmp;
+
+    let mut layer = 0;
+    let mut node_in_layer = 2;
+    for node in 2..rcmax {
+        if node_in_layer == nodes[layer] && count != 1 {
+            cap = (layers[layer].rho * layers[layer].cp * dx[layer]
+                + layers[layer + 1].rho * layers[layer + 1].cp * dx[layer + 1])
+                * 0.5;
+            write_a(
+                a_mat,
+                rcmax,
+                node - 1,
+                node,
+                layers[layer].rk / dx[layer] / cap,
+            );
+            write_a(
+                a_mat,
+                rcmax,
+                node,
+                node,
+                -1.0 * (layers[layer].rk / dx[layer] + layers[layer + 1].rk / dx[layer + 1]) / cap,
+            );
+            write_a(
+                a_mat,
+                rcmax,
+                node + 1,
+                node,
+                layers[layer + 1].rk / dx[layer + 1] / cap,
+            );
+            node_in_layer = 0;
+            layer += 1;
+        } else {
+            cap = layers[layer].rho * layers[layer].cp * dx[layer];
+            dxtmp = 1.0 / dx[layer] / cap;
+            write_a(a_mat, rcmax, node - 1, node, layers[layer].rk * dxtmp);
+            write_a(
+                a_mat,
+                rcmax,
+                node,
+                node,
+                -2.0 * layers[layer].rk * dxtmp,
+            );
+            write_a(a_mat, rcmax, node + 1, node, layers[layer].rk * dxtmp);
+        }
+        node_in_layer += 1;
+    }
+
+    let last = count - 1;
+    cap = layers[last].rho * layers[last].cp * dx[last];
+    cap *= 1.5;
+    dxtmp = 1.0 / dx[last] / cap;
+    write_a(
+        a_mat,
+        rcmax,
+        rcmax,
+        rcmax,
+        -2.0 * layers[last].rk * dxtmp,
+    );
+    write_a(a_mat, rcmax, rcmax - 1, rcmax, layers[last].rk * dxtmp);
+    b_mat[1] = layers[last].rk * dxtmp;
+    let c_mat = [-layers[0].rk / dx[0], layers[last].rk / dx[last]];
+    let d_mat = [layers[0].rk / dx[0], -layers[last].rk / dx[last]];
+    (c_mat, d_mat)
+}
+
 fn write_a(values: &mut [f64], rcmax: usize, i1: usize, i2: usize, value: f64) {
     values[(i1 - 1) * rcmax + i2 - 1] = value;
 }
 

+/// A failed reassignment precondition, never a Native retry decision.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CtfAssemblyReassignmentError {
+    /// The stored selected owner has an unsupported scope or shape.
+    Scope(CtfAssemblyScopeError),
+    /// Reassignment cannot turn an unavailable route into initialized storage.
+    UnavailableRoute(CtfAssemblyUnavailable),
+    /// The invocation belongs to a different original construction.
+    ConstructionIdentityMismatch,
+    /// Route, dimensions, selectors or original caller bits changed.
+    StaticContextMismatch,
+    /// The caller did not supply exactly the next representable ordinal.
+    AttemptSequence,
+}
+
+/// Repeat Construction.cc 659-728 in the same actual matrix storage.
+///
+/// The caller retains custody of the unchanged converted prefix, Nodes, dx,
+/// AMat and IdenMatrix from the initial allocation. This checks their supported
+/// shape without placing nodes or deriving spacings. Only the original band,
+/// compressed B/C/D and invocation context are assigned. In particular AMat's
+/// other cells and every IdenMatrix bit survive, as they do in the source loop.
+///
+/// The caller supplies current CTFTimeStep and NumHistories literally; this API
+/// neither chooses a retry nor verifies an invented arithmetic relationship.
+/// No mutation occurs on a rejected precondition. First-only owners do not
+/// invoke this function and keep their existing guards and result contracts.
+pub fn reassign_1d_ctf_state_space(
+    assembly: &mut CtfStateSpaceAssembly,
+    current_context: CtfAssemblyContext,
+) -> Result<(), CtfAssemblyReassignmentError> {
+    use CtfAssemblyReassignmentError as Error;
+
+    let previous = assembly.context;
+    if let CtfAssemblyRoute::Unavailable(reason) = previous.route {
+        return Err(Error::UnavailableRoute(reason));
+    }
+    if let CtfAssemblyRoute::Unavailable(reason) = current_context.route {
+        return Err(Error::UnavailableRoute(reason));
+    }
+    if previous.construction_id != current_context.construction_id {
+        return Err(Error::ConstructionIdentityMismatch);
+    }
+    if previous.route != current_context.route
+        || previous.solution_dimensions != current_context.solution_dimensions
+        || previous.source_sink_present != current_context.source_sink_present
+        || previous.node_source != current_context.node_source
+        || previous.node_user_temp != current_context.node_user_temp
+        || previous.time_step_zone.to_bits() != current_context.time_step_zone.to_bits()
+    {
+        return Err(Error::StaticContextMismatch);
+    }
+    if previous.source_sink_present {
+        return Err(Error::Scope(CtfAssemblyScopeError::InternalSource));
+    }
+    if previous.solution_dimensions != 1 {
+        return Err(Error::Scope(CtfAssemblyScopeError::UnsupportedDimensions(
+            previous.solution_dimensions,
+        )));
+    }
+    if previous.node_source != 0 || previous.node_user_temp != 0 {
+        return Err(Error::Scope(CtfAssemblyScopeError::SourceNodeState));
+    }
+    if previous.attempt_ordinal == 0 {
+        return Err(Error::Scope(CtfAssemblyScopeError::AttemptOrdinal));
+    }
+    if previous.attempt_ordinal.checked_add(1) != Some(current_context.attempt_ordinal) {
+        return Err(Error::AttemptSequence);
+    }
+
+    // Check the already stored nodal owner, not a new node placement.
+    let count = assembly.layers.len();
+    if count == 0 || count > 11 {
+        return Err(Error::Scope(CtfAssemblyScopeError::LayerCount(count)));
+    }
+    if assembly.nodes.len() != count || assembly.dx.len() != count {
+        return Err(Error::Scope(CtfAssemblyScopeError::ActivePrefixShape));
+    }
+    for (index, &nodes) in assembly.nodes.iter().enumerate() {
+        let interior_resistance = index > 0 && index + 1 < count && assembly.layers[index].res_layer;
+        let valid = if interior_resistance {
+            nodes == 1
+        } else {
+            (6..=19).contains(&nodes)
+        };
+        if !valid {
+            return Err(Error::Scope(CtfAssemblyScopeError::NodeCount(index + 1)));
+        }
+    }
+    // One-through-eleven validated node counts bound this sum and product.
+    let source_rcmax = assembly.nodes.iter().sum::<i32>() - 1;
+    if assembly.rcmax != source_rcmax {
+        return Err(Error::Scope(CtfAssemblyScopeError::MatrixShape));
+    }
+    let rcmax = source_rcmax as usize;
+    if assembly.a_mat.len() != rcmax * rcmax || assembly.iden_matrix.len() != rcmax * rcmax {
+        return Err(Error::Scope(CtfAssemblyScopeError::MatrixShape));
+    }
+
+    let (c_mat, d_mat) = assign_1d_ctf_state_space(
+        &assembly.layers,
+        &assembly.nodes,
+        &assembly.dx,
+        rcmax,
+        &mut assembly.a_mat,
+        &mut assembly.b_mat,
+        None,
+    );
+    assembly.c_mat = c_mat;
+    assembly.d_mat = d_mat;
+    assembly.context = current_context;
+    Ok(())
+}

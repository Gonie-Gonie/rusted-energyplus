use serde_json::{Value, json};

pub(super) use super::unit_fields::scalar;
fn values(source: &[f64]) -> Vec<Value> {
    source.iter().copied().map(scalar).collect()
}
fn missing(reason: &str) -> Value {
    json!({"owner_available":false,"value":null,"reason":reason,"counted_as_PASS":false})
}
pub(super) fn unavailable() -> Value {
    json!({"owner_available":false,"construction_preprocessing":null,
        "reason":"initializer has not returned an actual HeatBalanceState owner",
        "counted_as_PASS":false,"Native_IsUsedCTF":missing("Native flag has no Rust owner"),
        "Native_DoCTFErrorReport":missing("Native whole-method flag is separate from the actual selected Rust caller flag")})
}
pub(super) fn selected(source: &HeatBalanceState) -> Value {
    json!({"owner_available":true,"construction_preprocessing":source.construction_ctf01_layers.iter()
        .enumerate().map(|(index,actual)|json!({"state_vector_index":index,
            "construction_id":actual.construction_id.0,
            "actual_Rust_surface_derived_is_used_ctf":actual.is_used_ctf,
            "result":unit_fields::result(&actual.result)})).collect::<Vec<_>>(),
        "actual_owner_count":source.construction_ctf01_layers.len(),
        "Native_IsUsedCTF":missing("Rust use owner is surface-derived; Native loader flag remains separately unpaired"),
        "Native_DoCTFErrorReport":missing("Native whole-method flag is separate from the actual selected Rust caller flag"),
        "Native_whole_solver_final_ErrorsFound":missing("selected Rust preprocessing flag is not the whole Native solver flag"),
        "selected_ErrorsFound_observed_only_in_actual_results":true,
        "preprocessing_reexecuted_by_observer":false,"numerical_PASS_claimed":false})
}

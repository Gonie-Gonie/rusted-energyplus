fn first_wrapper_context(source: &HeatBalanceState, api: &str, key: &str, retained_count: usize) -> Value {
    let mut out = json!({"owner_available":false,"actual_compatibility_vector_count":retained_count,
        "unavailable_reason":"retry driver invokes actual pure methods; first-only public wrappers uninvoked",
        "actual_wrapper_ledger":source.construction_ctf09_retry_driver.iter().enumerate().map(|(index,actual)|json!({
            "state_vector_index":index,"construction_id":actual.construction_id.0,
            "result":unit_fields::first_wrapper_uninvoked(api,actual.construction_id.0)})).collect::<Vec<_>>(),
        "actual_first_method_handoff_location":"selected_CTF09_owners.construction_retry_initialization[].result.driver.first_method_handoff",
        "historical_first_only_policy_reinterpreted":false,"counted_as_PASS":false});
    out[key] = json!([]);
    out
}
fn unavailable_first(key: &str) -> Value {
    let mut out = json!({"owner_available":false,
        "unavailable_reason":"initializer has not returned an actual HeatBalanceState owner","counted_as_PASS":false});
    out[key] = Value::Null;
    out
}

from pathlib import Path
import ast
import difflib
import hashlib
import json

ROOT = Path(__file__).resolve().parents[4]
PREP = Path(__file__).resolve().parent

def rel(path):
    return path.relative_to(ROOT).as_posix()

def ref(path):
    path = ROOT / path if isinstance(path, str) else path
    raw = path.read_bytes()
    return dict(path=rel(path), sha256=hashlib.sha256(raw).hexdigest(),
                size_bytes=len(raw), line_count=len(raw.splitlines()))

def selected(path, first, last, purpose):
    source = ROOT / path
    lines = source.read_bytes().splitlines(keepends=True)
    assert 1 <= first <= last <= len(lines)
    raw = b"".join(lines[first-1:last])
    return dict(path=path, start_line=first, end_line=last,
                sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), purpose=purpose)

def diff(before, after, destination, canonical):
    old = before.read_text(encoding="utf-8").splitlines(keepends=True) if before else []
    new = after.read_text(encoding="utf-8").splitlines(keepends=True)
    value = "".join(difflib.unified_diff(old, new,
                   fromfile="a/"+canonical if before else "/dev/null", tofile="b/"+canonical))
    destination.write_text(value, encoding="utf-8", newline="\n")
    return ref(destination)


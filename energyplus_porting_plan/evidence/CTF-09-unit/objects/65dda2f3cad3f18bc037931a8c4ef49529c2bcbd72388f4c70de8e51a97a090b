+#[test]
+fn real_preprocessing_errors_remain_shared_and_do_not_become_invented_fatal_outcomes() -> TestResult {
+    let mut model = massive_model();
+    model.materials.insert(0, material(9, true, 0.0001));
+    model.constructions.insert(0, construction(70, 9));
+    model.surfaces.insert(0, surface(1, 70));
+    let mut cache = ConstructionThermalDataCache::build(&model, &BTreeMap::new())
+        .map_err(|error| format!("shared source error cache: {error:?}"))?;
+    let ordered = cache.take_retry_initializations();
+    assert_eq!(ordered.len(), 2);
+    assert!(ordered[0].flags_on_entry.errors_found);
+    assert!(ordered[1].flags_on_entry.errors_found);
+    for owner in ordered {
+        assert_eq!(owner.selected_chain_stop, None);
+        let actual = owner.result.as_ref().map_err(|error| format!("error-return owner: {error:?}"))?;
+        assert_eq!(actual.outcome, CtfRetryDriverOutcome::ScopeStopped(CtfRetryDriverStop::FirstAssembly(
+            CtfFirstAssemblyUnavailable::InitialUnavailable(CtfInitialUnavailable::PreprocessingErrorReturn))));
+        assert!(actual.attempts.is_empty());
+        assert!(actual.flags_on_return.errors_found);
+    }
+    Ok(())
+}

+#[test]
+fn unused_construction_returns_without_stopping_the_next_genuine_massive_owner() -> TestResult {
+    let mut model = massive_model();
+    model.materials.insert(0, material(9, false, 0.2));
+    model.constructions.insert(0, construction(70, 9));
+    let mut cache = ConstructionThermalDataCache::build(&model, &BTreeMap::new())
+        .map_err(|error| format!("ordered cache: {error:?}"))?;
+    let ordered = cache.take_retry_initializations();
+    assert_eq!(ordered.iter().map(|owner| owner.construction_id).collect::<Vec<_>>(),
+        [ConstructionId(70), ConstructionId(30)]);
+    let skipped = ordered[0].result.as_ref().map_err(|error| format!("unused owner: {error:?}"))?;
+    assert_eq!(skipped.outcome, CtfRetryDriverOutcome::ScopeStopped(CtfRetryDriverStop::FirstAssembly(
+        CtfFirstAssemblyUnavailable::InitialUnavailable(CtfInitialUnavailable::UnusedConstruction))));
+    assert!(skipped.attempts.is_empty());
+    assert_eq!(ordered[0].selected_chain_stop, None);
+    let next = ordered[1].result.as_ref().map_err(|error| format!("next owner: {error:?}"))?;
+    assert!(!next.attempts.is_empty());
+    assert_eq!(ordered[1].flags_on_entry, ordered[0].flags_on_return);
+    Ok(())
+}

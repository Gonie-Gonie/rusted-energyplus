+#[test]
+fn vector_handoff_moves_original_storage_and_retains_legacy_eio_precedence() -> TestResult {
+    let model = massive_model();
+    let row = ConstructionCtfCoefficientOverride {
+        construction_name: "C30".to_string(), time_index: 0,
+        outside_w_per_m2_k: 7.0, cross_w_per_m2_k: 8.0, inside_w_per_m2_k: 9.0, flux: None,
+    };
+    let overrides = BTreeMap::from([("C30".to_string(), vec![&row])]);
+    let mut cache = ConstructionThermalDataCache::build(&model, &overrides)
+        .map_err(|error| format!("EIO cache: {error:?}"))?;
+    let entry = cache.data_for_surface(&model.surfaces[0])
+        .map_err(|error| format!("legacy surface lookup: {error:?}"))?;
+    assert_eq!(entry.ctf_coefficient_source, ConstructionCtfCoefficientSource::EnergyPlusEioSeeded);
+    assert_eq!(entry.ctf_coefficients, [row]);
+    let before = cache.retry_initializations[0].result.as_ref()
+        .map_err(|error| format!("retry owner: {error:?}"))?.retained_assembly.as_ref()
+        .ok_or("actual storage absent")?;
+    let pointers = (before.a_mat.as_ptr(), before.iden_matrix.as_ptr());
+    let cache_hash = cache.coefficient_cache_hash;
+    // The final state shell uses this exact move-only handoff, not driver.clone().
+    let owners = cache.take_retry_initializations();
+    let after = owners[0].result.as_ref()
+        .map_err(|error| format!("state retry owner: {error:?}"))?.retained_assembly.as_ref()
+        .ok_or("state original storage absent")?;
+    assert_eq!(pointers, (after.a_mat.as_ptr(), after.iden_matrix.as_ptr()));
+    assert_eq!(cache.coefficient_cache_hash, cache_hash);
+    assert_eq!(cache.eio_seeded_count(), 1);
+    assert!(cache.take_retry_initializations().is_empty());
+    assert!(cache.first_assemblies().is_empty());
+    assert!(cache.first_private_coefficients().is_empty());
+    Ok(())
+}

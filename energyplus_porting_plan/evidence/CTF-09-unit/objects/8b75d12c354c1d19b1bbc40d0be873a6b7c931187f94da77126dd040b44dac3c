+#[test]
+fn frozen_active_prefix_11_reaches_natural_retries_and_fresh_gamma_owners() -> TestResult {
+    let first = frozen_active_prefix_11()?;
+    let original_names = ["MASS_A", "MASS_B", "MASS_C", "MASS_A", "MASS_B", "MASS_C",
+        "MASS_A", "MASS_B", "MASS_C", "MASS_A", "MASS_B"];
+    let diagnostics = CtfCallerDiagnosticNames {
+        construction_name: "construction-1", original_tot_layers: 11,
+        original_layer_material_names: &original_names,
+    };
+    let result = run_selected_construction_ctf_retry_driver(first, flags(), diagnostics);
+    assert!(matches!(result.outcome, CtfRetryDriverOutcome::ConvergedLoopExit
+        | CtfRetryDriverOutcome::SevenHourSevereBreak | CtfRetryDriverOutcome::FatalNoCtfs));
+    assert!(result.attempts.len() > 1, "existing frozen input must exercise an actual retry");
+    let initial_checkpoint = result.initial_pre_assignment()
+        .ok_or_else(|| std::io::Error::other("natural retry lost its actual initial checkpoint"))?;
+    assert_eq!(Some(initial_checkpoint.context), result.initial_context);
+    assert_eq!(initial_checkpoint.context.attempt_ordinal, 1);
+    assert_eq!(bits(&initial_checkpoint.iden_matrix), bits(&result.attempts[0].assembly.iden_matrix));
+    assert_eq!(result.reassignments.len() + 1, result.attempts.len());
+    for (index, pair) in result.attempts.windows(2).enumerate() {
+        let caller = pair[0].caller.as_ref().and_then(|value| value.as_ref().ok())
+            .ok_or_else(|| std::io::Error::other("natural retry lacks an actual caller"))?;
+        assert_eq!(caller.outcome, CtfCallerStabilityOutcome::Retry);
+        let previous = pair[0].assembly.context;
+        let next = pair[1].assembly.context;
+        assert_eq!(next.attempt_ordinal, previous.attempt_ordinal + 1);
+        assert_eq!(next.ctf_time_step.to_bits(), caller.postcheck_context.ctf_time_step.to_bits());
+        assert_eq!(next.num_histories, caller.postcheck_context.num_histories);
+        assert_eq!(next.time_step_zone.to_bits(), previous.time_step_zone.to_bits());
+        assert_eq!(result.reassignments[index].preceding_num_ctf_terms, caller.num_ctf_terms);
+        let Some(Ok(CtfGammaObservation::Gamma(before))) = &pair[0].gammas else {
+            return Err(std::io::Error::other("preceding actual Gamma unavailable").into());
+        };
+        let Some(Ok(CtfGammaObservation::Gamma(after))) = &pair[1].gammas else {
+            return Err(std::io::Error::other("retry actual Gamma unavailable").into());
+        };
+        assert_eq!(before.context, previous);
+        assert_eq!(after.context, next);
+        // Both real owners stay live; the retry cannot reuse a mutated old buffer.
+        assert_ne!(before.gamma1.as_ptr(), after.gamma1.as_ptr());
+        assert_ne!(before.gamma2.as_ptr(), after.gamma2.as_ptr());
+        assert_eq!(before.gamma1.len(), after.gamma1.len());
+        assert_eq!(before.gamma2.len(), after.gamma2.len());
+    }
+    Ok(())
+}

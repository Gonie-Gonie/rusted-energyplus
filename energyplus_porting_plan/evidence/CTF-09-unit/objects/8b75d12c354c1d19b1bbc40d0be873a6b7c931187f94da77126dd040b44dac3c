+// Existing frozen39 active-prefix-11 INPUTS only, helper-request SHA3fdf7a11.
+// These stored member bits and original IDs pass through the real public
+// preprocessing/initial/assembly owners. No normalized/node/timestep answers.
+fn frozen_active_prefix_11() -> TestResult<ConstructionCtfFirstAssembly> {
+    use crate::heat_balance::ctf_first_assembly_owner::initialize_construction_ctf_first_assembly;
+    use crate::heat_balance::ctf_initial_owner::initialize_construction_ctf_initial;
+    use crate::heat_balance::surface_manager::ctf_layer_preprocessing::{
+        ConstructionCtfLayerPreprocessing, CtfLayerContext, CtfLayerInput, preprocess_ctf_layers,
+    };
+    use ep_model::{Construction, ConstructionKind, MaterialId, NormalizedName};
+    use std::collections::BTreeSet;
+
+    let members = [
+        CtfLayerInput {
+            material_id: MaterialId(0),
+            thickness: f64::from_bits(0x3fbeb851eb851eb8),
+            conductivity: f64::from_bits(0x3fe999999999999a),
+            density: f64::from_bits(0x409c200000000000),
+            specific_heat: f64::from_bits(0x408c200000000000),
+            resistance: f64::from_bits(0x3fc3333333333333), resistance_only: false,
+        },
+        CtfLayerInput {
+            material_id: MaterialId(1),
+            thickness: f64::from_bits(0x3fb47ae147ae147b),
+            conductivity: f64::from_bits(0x3fc47ae147ae147b),
+            density: f64::from_bits(0x4089000000000000),
+            specific_heat: f64::from_bits(0x4095e00000000000),
+            resistance: f64::from_bits(0x3fe0000000000000), resistance_only: false,
+        },
+        CtfLayerInput {
+            material_id: MaterialId(2),
+            thickness: f64::from_bits(0x3f9999999999999a),
+            conductivity: f64::from_bits(0x3fc999999999999a),
+            density: f64::from_bits(0x403e000000000000),
+            specific_heat: f64::from_bits(0x408f400000000000),
+            resistance: f64::from_bits(0x3fc0000000000000), resistance_only: false,
+        },
+    ];
+    let original_indices = [0_usize, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1];
+    let input = original_indices.iter().map(|&index| members[index]).collect::<Vec<_>>();
+    let layers = input.iter().map(|member| member.material_id).collect::<Vec<_>>();
+    let construction = Construction {
+        id: ConstructionId(0), name: NormalizedName("construction-1".to_owned()),
+        kind: ConstructionKind::Opaque, outside_layer: layers.first().copied(), layers,
+        thermochromic_master: None, ground_factor: None, air_boundary: None,
+        complex_fenestration: None, window_equivalent_layer: None, internal_heat_source: None,
+    };
+    let context = CtfLayerContext {
+        is_used_ctf: true, errors_found: false, source_sink_present: false, solution_dimensions: 1,
+    };
+    let preprocessing = ConstructionCtfLayerPreprocessing {
+        construction_id: construction.id, is_used_ctf: true,
+        result: preprocess_ctf_layers(&input, context),
+    };
+    let used = BTreeSet::from([construction.id.0]);
+    let initial = initialize_construction_ctf_initial(
+        &construction, &[], &used, &preprocessing, context, f64::from_bits(0x3fd0000000000000),
+    );
+    let first = initialize_construction_ctf_first_assembly(&initial, &preprocessing);
+    if !matches!(&first.result, Ok(CtfAssemblyObservation::Assembled(_))) {
+        return Err(std::io::Error::other(format!("frozen active-prefix-11 route unavailable: {:?}", first.result)).into());
+    }
+    Ok(first)
+}

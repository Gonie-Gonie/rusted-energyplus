def raw(path):
    return (ROOT / path).read_bytes()

def ref(path):
    data = raw(path)
    return {'path': path, 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}

def write(name, data):
    path = BASE / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data)
    return path.relative_to(ROOT).as_posix()

def diff(before, after, name, destination=None):
    text = ''.join(difflib.unified_diff(
        raw(before).decode('utf8').splitlines(keepends=True) if before else [],
        raw(after).decode('utf8').splitlines(keepends=True),
        fromfile=destination if before and destination else before or '/dev/null',
        tofile=destination or after))
    return ref(write('diffs/' + name, text.encode('utf8')))

def selected(path, first, last, purpose):
    lines = raw(path).splitlines(keepends=True)
    assert 1 <= first <= last <= len(lines)
    data = b''.join(lines[first - 1:last])
    return {'path': path, 'start_line': first, 'end_line': last,
            'sha256': hashlib.sha256(data).hexdigest(), 'size_bytes': len(data), 'purpose': purpose}


+#[test]
+fn history_sums_use_actual_history_order_before_absolute_values() -> Result<(), CtfCallerStabilityScopeError> {
+    let mut value = coefficients(2, 2, -1.0, -1.0, -1.0);
+    for offset in [0, 2, 10] {
+        value.s[offset] = -2.0;
+        value.s[offset + 1] = 4.0;
+    }
+    let actual = decide(&value)?;
+    assert_eq!(actual.sums, Some(CtfCallerSeriesSums {
+        sum_xi: 1.0, sum_yi: 1.0, sum_zi: 1.0, biggest_sum: 1.0,
+    }));
+    assert_eq!(actual.outcome, CtfCallerStabilityOutcome::ConvergedLoopExit);
+    Ok(())
+}

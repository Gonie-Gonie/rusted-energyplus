+#[test]
+fn next_stamp_copies_actual_postcheck_bits_and_only_advances_ordinal() -> TestResult {
+    let mut first = first_assembly()?;
+    let context = actual(&mut first)?.context;
+    let postcheck = CtfAssemblyContext { ctf_time_step: 0.75, num_histories: 3, ..context };
+    let next = next_retry_context(postcheck)
+        .map_err(|error| std::io::Error::other(format!("{error:?}")))?;
+    assert_eq!(next, CtfAssemblyContext { attempt_ordinal: 2, ..postcheck });
+    // This helper performs no numeric validation or substitute timestep math.
+    let unusual = CtfAssemblyContext {
+        time_step_zone: -0.0, ctf_time_step: f64::from_bits(0x7ff8_0000_0000_0042), ..postcheck
+    };
+    let copied = next_retry_context(unusual)
+        .map_err(|error| std::io::Error::other(format!("{error:?}")))?;
+    assert_eq!(copied.time_step_zone.to_bits(), unusual.time_step_zone.to_bits());
+    assert_eq!(copied.ctf_time_step.to_bits(), unusual.ctf_time_step.to_bits());
+    assert_eq!(copied.num_histories, unusual.num_histories);
+    assert_eq!(copied.attempt_ordinal, 2);
+    Ok(())
+}

+#[test]
+fn actual_prerequisite_error_has_no_invented_assembly_or_method() {
+    let reason = CtfFirstAssemblyUnavailable::InitialUnavailable(CtfInitialUnavailable::UnusedConstruction);
+    let shared = CtfCallerSharedFlags { errors_found: true, do_ctf_error_report: true };
+    let result = run_selected_construction_ctf_retry_driver(ConstructionCtfFirstAssembly {
+        construction_id: ConstructionId(2), result: Err(reason),
+    }, shared, names());
+    assert_eq!(result.outcome, CtfRetryDriverOutcome::ScopeStopped(CtfRetryDriverStop::FirstAssembly(reason)));
+    assert!(result.retained_assembly.is_none());
+    assert!(result.attempts.is_empty());
+    assert!(result.reassignments.is_empty());
+    assert_eq!(result.initial_context, None);
+    assert_eq!(result.postcheck_context, None);
+    assert!(result.initial_pre_assignment().is_none());
+    assert_eq!(result.flags_on_return, shared);
+}

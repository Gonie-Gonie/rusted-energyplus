+fn actual(owner: &mut ConstructionCtfFirstAssembly) -> TestResult<&mut CtfStateSpaceAssembly> {
+    match &mut owner.result {
+        Ok(CtfAssemblyObservation::Assembled(value)) => Ok(value),
+        other => Err(std::io::Error::other(format!("fixture assembly unavailable: {other:?}")).into()),
+    }
+}

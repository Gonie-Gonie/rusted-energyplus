+#[test]
+fn genuine_chain_keeps_the_original_allocations_and_actual_visit_order() -> TestResult {
+    let mut first = first_assembly()?;
+    let original = actual(&mut first)?;
+    let pointers = (original.a_mat.as_ptr(), original.iden_matrix.as_ptr(),
+        original.layers.as_ptr(), original.nodes.as_ptr(), original.dx.as_ptr());
+    let original_layers = original.layers.clone();
+    let original_nodes = original.nodes.clone();
+    let original_dx = bits(&original.dx);
+    let identity_bits = bits(&original.iden_matrix);
+    let checkpoint = original.initial_pre_assignment.clone()
+        .ok_or_else(|| std::io::Error::other("genuine initial producer checkpoint absent"))?;
+    let result = run_selected_construction_ctf_retry_driver(first, flags(), names());
+    assert!(matches!(result.outcome, CtfRetryDriverOutcome::ConvergedLoopExit
+        | CtfRetryDriverOutcome::SevenHourSevereBreak | CtfRetryDriverOutcome::FatalNoCtfs));
+    assert!(!result.attempts.is_empty());
+    let retained = result.retained_assembly.as_ref()
+        .ok_or_else(|| std::io::Error::other("actual assembly was lost"))?;
+    assert_eq!(pointers, (retained.a_mat.as_ptr(), retained.iden_matrix.as_ptr(),
+        retained.layers.as_ptr(), retained.nodes.as_ptr(), retained.dx.as_ptr()));
+    assert_eq!(retained.layers, original_layers);
+    assert_eq!(retained.nodes, original_nodes);
+    assert_eq!(bits(&retained.dx), original_dx);
+    assert_eq!(bits(&retained.iden_matrix), identity_bits);
+    let retained_checkpoint = result.initial_pre_assignment()
+        .ok_or_else(|| std::io::Error::other("driver lost the genuine initial producer checkpoint"))?;
+    assert_eq!(retained_checkpoint.context, checkpoint.context);
+    assert_eq!(bits(&retained_checkpoint.a_mat), bits(&checkpoint.a_mat));
+    assert_eq!(bits(&retained_checkpoint.iden_matrix), bits(&checkpoint.iden_matrix));
+    assert_eq!(retained_checkpoint.b_mat3_after_reset.to_bits(), checkpoint.b_mat3_after_reset.to_bits());
+    for (index, attempt) in result.attempts.iter().enumerate() {
+        let context = attempt.assembly.context;
+        assert_eq!(context.attempt_ordinal, index + 1);
+        assert_eq!(context.construction_id, result.construction_id);
+        assert_eq!(bits(&attempt.assembly.iden_matrix), identity_bits);
+        let Ok(CtfExponentialObservation::Exponential(exponential)) = &attempt.exponential else {
+            return Err(std::io::Error::other("actual exponential did not return its owner").into());
+        };
+        let Some(Ok(inverse)) = &attempt.inverse else {
+            return Err(std::io::Error::other("actual inverse did not return its owner").into());
+        };
+        let Some(Ok(CtfGammaObservation::Gamma(gammas))) = &attempt.gammas else {
+            return Err(std::io::Error::other("actual Gamma did not return its owner").into());
+        };
+        let Some(Ok(CtfFinalCoefficientObservation::Coefficients(private))) = &attempt.final_coefficients else {
+            return Err(std::io::Error::other("actual private final method did not return its owner").into());
+        };
+        let Some(Ok(caller)) = &attempt.caller else {
+            return Err(std::io::Error::other("actual caller decision did not return").into());
+        };
+        assert_eq!(exponential.context, context);
+        assert_eq!(inverse.rcmax, attempt.assembly.rcmax);
+        assert_eq!(gammas.context, context);
+        assert_eq!(private.context, context);
+        assert_eq!(caller.input_context, context);
+        assert_eq!(caller.postcheck_context.attempt_ordinal, context.attempt_ordinal);
+    }
+    assert_eq!(retained.context, result.attempts.last()
+        .ok_or_else(|| std::io::Error::other("missing last real attempt"))?.assembly.context);
+    assert_eq!(result.postcheck_context, result.attempts.last()
+        .and_then(|attempt| attempt.caller.as_ref()).and_then(|caller| caller.as_ref().ok())
+        .map(|caller| caller.postcheck_context));
+    assert_eq!(result.reassignments.len() + 1, result.attempts.len());
+    for (index, reassignment) in result.reassignments.iter().enumerate() {
+        let previous = &result.attempts[index];
+        let caller = previous.caller.as_ref().and_then(|value| value.as_ref().ok())
+            .ok_or_else(|| std::io::Error::other("reassignment lacks actual preceding caller"))?;
+        assert_eq!(caller.outcome, CtfCallerStabilityOutcome::Retry);
+        assert_eq!(reassignment.before, previous.assembly);
+        assert_eq!(reassignment.preceding_num_ctf_terms, caller.num_ctf_terms);
+        assert_eq!(reassignment.supplied_context, next_retry_context(caller.postcheck_context)
+            .map_err(|error| std::io::Error::other(format!("{error:?}")))?);
+        assert_eq!(reassignment.result, Ok(()));
+        assert_eq!(reassignment.context_after, result.attempts[index + 1].assembly.context);
+    }
+    Ok(())
+}

+#[test]
+fn unsupported_routes_and_invalid_actual_shapes_do_not_publish_workspaces() {
+    let empty = CtfFinalCoefficientInput { rcmax: 0, a_exp: &[], iden_matrix: &[],
+        gamma1: &[], gamma2: &[], c_mat: &[], d_mat: &[] };
+    let mut caller = context();
+    caller.route = CtfAssemblyRoute::Unavailable(CtfAssemblyUnavailable::AllResistive);
+    assert_eq!(calculate_selected_ctf_final_coefficients(empty, caller),
+        Ok(CtfFinalCoefficientObservation::Unavailable(CtfAssemblyUnavailable::AllResistive)));
+    assert_eq!(calculate_selected_ctf_final_coefficients(empty, context()),
+        Err(CtfFinalCoefficientScopeError::Dimension(0)));
+    for (edit, expected) in [
+        (0, CtfFinalCoefficientScopeError::InternalSource),
+        (1, CtfFinalCoefficientScopeError::UnsupportedDimensions(2)),
+        (2, CtfFinalCoefficientScopeError::SourceNodeState),
+        (3, CtfFinalCoefficientScopeError::SourceNodeState),
+        (4, CtfFinalCoefficientScopeError::AttemptOrdinal),
+    ] {
+        let mut caller = context();
+        match edit { 0 => caller.source_sink_present = true, 1 => caller.solution_dimensions = 2,
+            2 => caller.node_source = 1, 3 => caller.node_user_temp = 1, _ => caller.attempt_ordinal = 0 }
+        assert_eq!(calculate_selected_ctf_final_coefficients(empty, caller), Err(expected));
+    }
+    let one = CtfFinalCoefficientInput { rcmax: 1, a_exp: &[1.0], iden_matrix: &[1.0],
+        gamma1: &[0.0; 3], gamma2: &[0.0; 3], c_mat: &[1.0; 2], d_mat: &[0.0; 2] };
+    assert_eq!(calculate_selected_ctf_final_coefficients(CtfFinalCoefficientInput { a_exp: &[], ..one }, context()),
+        Err(CtfFinalCoefficientScopeError::MatrixShape));
+    assert_eq!(calculate_selected_ctf_final_coefficients(CtfFinalCoefficientInput { gamma2: &[], ..one }, context()),
+        Err(CtfFinalCoefficientScopeError::GammaShape));
+    assert_eq!(calculate_selected_ctf_final_coefficients(CtfFinalCoefficientInput { c_mat: &[], ..one }, context()),
+        Err(CtfFinalCoefficientScopeError::BoundaryShape));
+}

+#[test]
+fn zero_first_e_stops_after_one_history_and_retains_full_initialized_tail() -> Result<(), String> {
+    let actual = reached(CtfFinalCoefficientInput {
+        rcmax: 2, a_exp: &[0.0; 4], iden_matrix: &[1.0, 0.0, 0.0, 1.0],
+        gamma1: &[1.0, 2.0, 3.0, 4.0, 0.0, 0.0], gamma2: &[0.0; 6],
+        c_mat: &[1.0, -1.0], d_mat: &[0.0; 2],
+    })?;
+    assert_eq!(actual.num_ctf_terms, 1);
+    assert!(actual.history_loop_converged);
+    assert_eq!(actual.next_history_term, 2);
+    assert_eq!(bits(&actual.e), bits(&[-0.0, 0.0]));
+    assert_eq!(actual.s.len(), 24);
+    assert_eq!(actual.s[0].to_bits(), 1.0_f64.to_bits());
+    assert_eq!(actual.s[2].to_bits(), (-2.5_f64).to_bits());
+    assert_eq!(actual.s[8].to_bits(), 2.5_f64.to_bits());
+    assert_eq!(actual.s[10].to_bits(), (-4.0_f64).to_bits());
+    assert!(actual.s.iter().skip(1).step_by(2).all(|v| v.to_bits() == 0.0_f64.to_bits()));
+    Ok(())
+}

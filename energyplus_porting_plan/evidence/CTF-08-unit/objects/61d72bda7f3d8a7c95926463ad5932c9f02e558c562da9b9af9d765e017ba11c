+#[test]
+fn both_underflow_guards_are_strict_double_epsilon_checks() -> Result<(), String> {
+    let eps = f64::EPSILON;
+    for (a, r0) in [(1.0, eps), (eps, 1.0)] {
+        let actual = reached(CtfFinalCoefficientInput {
+            rcmax: 2, a_exp: &[a, 0.0, 0.0, 0.0], iden_matrix: &[r0, 0.0, 0.0, 0.0],
+            gamma1: &[0.0; 6], gamma2: &[0.0; 6], c_mat: &[0.0; 2], d_mat: &[0.0; 2],
+        })?;
+        assert_eq!(bits(&actual.phi_r0), bits(&[0.0; 4]));
+        assert_eq!(actual.e[0].to_bits(), (-0.0_f64).to_bits());
+        assert!(actual.history_loop_converged);
+    }
+    let next = f64::from_bits(eps.to_bits() + 1);
+    let actual = reached(CtfFinalCoefficientInput {
+        rcmax: 2, a_exp: &[next, 0.0, 0.0, 0.0], iden_matrix: &[1.0, 0.0, 0.0, 0.0],
+        gamma1: &[0.0; 6], gamma2: &[0.0; 6], c_mat: &[0.0; 2], d_mat: &[0.0; 2],
+    })?;
+    assert_eq!(actual.phi_r0[0].to_bits(), next.to_bits());
+    assert_eq!(actual.e[0].to_bits(), (-next).to_bits());
+    Ok(())
+}

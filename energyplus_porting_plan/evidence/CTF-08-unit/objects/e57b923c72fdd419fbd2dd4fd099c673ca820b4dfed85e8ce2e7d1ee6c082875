/// Source of CTF coefficients held by one construction thermal cache entry.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum ConstructionCtfCoefficientSource {
    /// Coefficients were generated by the Rust steady no-mass fallback.
    RustGeneratedSteady,
    /// Coefficients were generated by the selected source all-resistive branch.
    RustGeneratedAllResistive,
    /// Coefficients were seeded from EnergyPlus EIO rows.
    EnergyPlusEioSeeded,
}

impl ConstructionCtfCoefficientSource {
    /// Stable identifier used in reports.
    #[must_use]
    pub const fn id(self) -> &'static str {
        match self {
            Self::RustGeneratedSteady => "rust-generated-steady",
            Self::RustGeneratedAllResistive => "rust-generated-all-resistive",
            Self::EnergyPlusEioSeeded => "energyplus-eio-seeded",
        }
    }
}

#[derive(Clone, Debug, PartialEq)]
pub(crate) struct ConstructionThermalDataCache {
    entries: Vec<ConstructionThermalData>,
    initial_discretizations: Vec<ConstructionCtfInitialDiscretization>,
    first_assemblies: Vec<ConstructionCtfFirstAssembly>,
    first_exponentials: Vec<ConstructionCtfFirstExponential>,
    first_inverses: Vec<ConstructionCtfFirstInverseAfterExponential>,
    first_gammas: Vec<ConstructionCtfFirstGammas>,
    first_private_coefficients: Vec<ConstructionCtfFirstFinalCoefficients>,
    construction_slots: TypedIdSlotIndex,
    entry_index_by_construction_slot: Vec<Option<usize>>,
    pub(crate) no_mass_construction_ids: Vec<ConstructionId>,
    pub(crate) massive_ctf_construction_ids: Vec<ConstructionId>,
    pub(crate) coefficient_cache_hash: u64,
    pub(crate) build_wall_seconds: f64,
}

impl ConstructionThermalDataCache {
    pub(crate) fn build(
        model: &TypedModel,
        ctf_coefficients_by_construction: &BTreeMap<
            String,
            Vec<&ConstructionCtfCoefficientOverride>,
        >,
    ) -> Result<Self, RuntimeError> {
        let build_start = Instant::now();
        let mut entries = Vec::with_capacity(
            model
                .constructions
                .iter()
                .filter(|construction| construction.is_ordinary_opaque())
                .count(),
        );
        let mut initial_discretizations = Vec::with_capacity(entries.capacity());
        let mut first_assemblies = Vec::with_capacity(entries.capacity());
        let mut first_exponentials = Vec::with_capacity(entries.capacity());
        let mut first_inverses = Vec::with_capacity(entries.capacity());
        let mut first_gammas = Vec::with_capacity(entries.capacity());
        let mut first_private_coefficients = Vec::with_capacity(entries.capacity());
        let time_step_zone_hours = 1.0 / f64::from(model.timestep.number_of_timesteps_per_hour);
        let mut no_mass_construction_ids = Vec::new();
        let mut massive_ctf_construction_ids = Vec::new();
        let construction_slots = TypedIdSlotIndex::new(
            model
                .constructions
                .iter()
                .map(|construction| construction.id.0),
        );
        let material_slots =
            TypedIdSlotIndex::new(model.materials.iter().map(|material| material.id.0));
        let mut entry_index_by_construction_slot = vec![None; model.constructions.len()];

        // This existing initializer constructs opaque CTF surface state. Mark
        // only actual referenced construction owners, preserving vector order.
        let used_ctf_constructions = model
            .surfaces
            .iter()
            .map(|surface| surface.construction.0)
            .collect::<BTreeSet<_>>();
        let mut preprocessing_errors_found = false;
        for (construction_index, construction) in model.constructions.iter().enumerate() {
            if !construction.is_ordinary_opaque() {
                continue;
            }
            let context = CtfLayerContext {
                is_used_ctf: used_ctf_constructions.contains(&construction.id.0),
                errors_found: preprocessing_errors_found,
                source_sink_present: construction.has_internal_heat_source(),
                // Normal Construction defaults in HeatBalanceManager1410.
                // Internal-source declarations are explicitly rejected.
                solution_dimensions: 1,
            };
            let entry = construction_thermal_data(
                model,
                &material_slots,
                construction,
                entries.len(),
                ctf_coefficients_by_construction,
                context,
            )?;
            let initial = initialize_construction_ctf_initial(
                construction,
                &model.constructions[..construction_index],
                &used_ctf_constructions,
                &entry.ctf01_layer_preprocessing,
                context,
                time_step_zone_hours,
            );
            let first_assembly = initialize_construction_ctf_first_assembly(
                &initial,
                &entry.ctf01_layer_preprocessing,
            );
            // Same original first assembly: actual06, then05, public07, public08.
            // Each actual error/non-invocation owner remains separate.
            let first_functions =
                initialize_construction_ctf_first_matrix_with_final_coefficients(&first_assembly);
            first_exponentials.push(first_functions.methods.exponential);
            first_inverses.push(first_functions.methods.inverse);
            first_gammas.push(first_functions.gammas);
            first_private_coefficients.push(first_functions.final_coefficients);
            first_assemblies.push(first_assembly);
            initial_discretizations.push(initial);
            if let Ok(preprocessing) = &entry.ctf01_layer_preprocessing.result {
                preprocessing_errors_found = preprocessing.errors_found;
            }
            if entry.heat_capacity_j_per_m2_k.is_some() {
                massive_ctf_construction_ids.push(entry.construction_id);
            } else {
                no_mass_construction_ids.push(entry.construction_id);
            }
            if let Some(index_slot) = construction_slots
                .slot(construction.id.0)
                .and_then(|slot| entry_index_by_construction_slot.get_mut(slot))
            {
                if index_slot.is_none() {
                    *index_slot = Some(entry.cache_index);
                }
            }
            entries.push(entry);
        }

        validate_surface_construction_families(model, &construction_slots)?;

        let coefficient_cache_hash = construction_cache_hash(&entries);
        Ok(Self {
            entries,
            initial_discretizations,
            first_assemblies,
            first_exponentials,
            first_inverses,
            first_gammas,
            first_private_coefficients,
            construction_slots,
            entry_index_by_construction_slot,
            no_mass_construction_ids,
            massive_ctf_construction_ids,
            coefficient_cache_hash,
            build_wall_seconds: build_start.elapsed().as_secs_f64(),
        })
    }

    pub(crate) fn layer_preprocessing(&self) -> Vec<ConstructionCtfLayerPreprocessing> {
        self.entries
            .iter()
            .map(|entry| entry.ctf01_layer_preprocessing.clone())
            .collect()
    }

    pub(crate) fn all_resistive_coefficients(&self) -> Vec<ConstructionCtfAllResistive> {
        self.entries
            .iter()
            .map(|entry| entry.ctf02_coefficients)
            .collect()
    }

    pub(crate) fn initial_discretizations(&self) -> Vec<ConstructionCtfInitialDiscretization> {
        self.initial_discretizations.clone()
    }

    pub(crate) fn first_assemblies(&self) -> Vec<ConstructionCtfFirstAssembly> {
        self.first_assemblies.clone()
    }

    pub(crate) fn first_exponentials(&self) -> Vec<ConstructionCtfFirstExponential> {
        self.first_exponentials.clone()
    }

    pub(crate) fn first_inverses(&self) -> Vec<ConstructionCtfFirstInverseAfterExponential> {
        self.first_inverses.clone()
    }

    pub(crate) fn first_gammas(&self) -> Vec<ConstructionCtfFirstGammas> {
        self.first_gammas.clone()
    }

    pub(crate) fn first_private_coefficients(&self) -> Vec<ConstructionCtfFirstFinalCoefficients> {
        self.first_private_coefficients.clone()
    }

    pub(crate) fn len(&self) -> usize {
        self.entries.len()
    }

    pub(crate) fn invalidation_token(&self) -> ConstructionCacheInvalidationToken {
        ConstructionCacheInvalidationToken::from_coefficient_cache_hash(self.coefficient_cache_hash)
    }

    pub(crate) fn is_invalidated_by(&self, token: ConstructionCacheInvalidationToken) -> bool {
        self.coefficient_cache_hash != token.coefficient_cache_hash
    }

    pub(crate) fn eio_seeded_count(&self) -> usize {
        self.entries
            .iter()
            .filter(|entry| {
                entry.ctf_coefficient_source
                    == ConstructionCtfCoefficientSource::EnergyPlusEioSeeded
            })
            .count()
    }

    pub(crate) fn rust_generated_count(&self) -> usize {
        self.entries.len() - self.eio_seeded_count()
    }

    pub(crate) fn data_for_surface(
        &self,
        surface: &Surface,
    ) -> Result<&ConstructionThermalData, RuntimeError> {
        self.construction_slots
            .slot(surface.construction.0)
            .and_then(|slot| self.entry_index_by_construction_slot.get(slot))
            .and_then(|entry_index| *entry_index)
            .and_then(|entry_index| self.entries.get(entry_index))
            .filter(|entry| entry.construction_id == surface.construction)
            .ok_or_else(|| RuntimeError::MissingConstruction {
                surface_name: surface.name.0.clone(),
            })
    }
}

pub(crate) fn surface_thermal_properties(
    model: &TypedModel,
    surface: &Surface,
) -> Result<ConstructionThermalData, RuntimeError> {
    let cache = ConstructionThermalDataCache::build(model, &BTreeMap::new())?;
    Ok(cache.data_for_surface(surface)?.clone())
}

fn construction_thermal_data(
    model: &TypedModel,
    material_slots: &TypedIdSlotIndex,
    construction: &Construction,
    cache_index: usize,
    ctf_coefficients_by_construction: &BTreeMap<String, Vec<&ConstructionCtfCoefficientOverride>>,
    ctf_layer_context: CtfLayerContext,
) -> Result<ConstructionThermalData, RuntimeError> {
    let layer_ids = construction_layer_stack(construction);
    let layer_materials = layer_materials(model, material_slots, construction, &layer_ids)?;
    let opaque_layer_materials = opaque_layer_materials(&layer_materials, construction)?;
    let ctf01_result = if ctf_layer_context.is_used_ctf {
        material_layer_inputs(&layer_materials)
            .and_then(|inputs| preprocess_ctf_layers(&inputs, ctf_layer_context))
    } else {
        preprocess_ctf_layers(&[], ctf_layer_context)
    };
    let ctf01_layer_preprocessing = ConstructionCtfLayerPreprocessing {
        construction_id: construction.id,
        is_used_ctf: ctf_layer_context.is_used_ctf,
        result: ctf01_result,
    };
    // SimulationManager.cc878 assigns this actual selected zone-timestep caller.
    let time_step_zone_hours = 1.0 / f64::from(model.timestep.number_of_timesteps_per_hour);
    let ctf02_coefficients = ConstructionCtfAllResistive {
        construction_id: construction.id,
        result: match &ctf01_layer_preprocessing.result {
            Ok(preprocessing) => generate_all_resistive_ctf(preprocessing, time_step_zone_hours),
            Err(error) => Err(CtfAllResistiveUnavailable::PreprocessingScope(*error)),
        },
    };
    let outside_material =
        layer_materials
            .first()
            .ok_or_else(|| RuntimeError::MissingMaterial {
                construction_name: construction.name.0.clone(),
            })?;
    let outside_opaque_material =
        *opaque_layer_materials
            .first()
            .ok_or_else(|| RuntimeError::MissingMaterial {
                construction_name: construction.name.0.clone(),
            })?;
    let inside_opaque_material =
        *opaque_layer_materials
            .last()
            .ok_or_else(|| RuntimeError::MissingMaterial {
                construction_name: construction.name.0.clone(),
            })?;
    let thermal_resistance_m2_k_per_w =
        material_thermal_resistance_sum(&layer_materials, &opaque_layer_materials, construction)?;
    let heat_capacity_j_per_m2_k = material_heat_capacity_per_area_sum(&opaque_layer_materials);
    let ctf_coefficients = ctf_coefficients_by_construction
        .get(&construction.name.0)
        .map(|rows| rows.iter().copied().cloned().collect::<Vec<_>>())
        .unwrap_or_default();
    let ctf_coefficient_source = if !ctf_coefficients.is_empty() {
        ConstructionCtfCoefficientSource::EnergyPlusEioSeeded
    } else if ctf02_coefficients.result.is_ok() {
        ConstructionCtfCoefficientSource::RustGeneratedAllResistive
    } else {
        ConstructionCtfCoefficientSource::RustGeneratedSteady
    };

    Ok(ConstructionThermalData {
        cache_index,
        construction_id: construction.id,
        construction_name: construction.name.0.clone(),
        material_layer_stack: layer_ids,
        ctf01_layer_preprocessing,
        ctf02_coefficients,
        outside_layer_material_id: outside_material.id,
        outside_layer_material_name: outside_material.name.0.clone(),
        outside_layer_roughness: outside_opaque_material
            .roughness()
            .unwrap_or(MaterialSurfaceRoughness::MediumRough),
        thermal_resistance_m2_k_per_w,
        heat_capacity_j_per_m2_k,
        thermal_absorptance: outside_opaque_material
            .surface_properties()
            .thermal_absorptance,
        inside_thermal_absorptance: inside_opaque_material
            .surface_properties()
            .thermal_absorptance,
        solar_absorptance: outside_opaque_material
            .surface_properties()
            .solar_absorptance,
        ctf_coefficient_source,
        ctf_coefficients,
    })
}

fn construction_layer_stack(construction: &Construction) -> Vec<MaterialId> {
    construction.effective_layers().to_vec()
}

fn layer_materials<'a>(
    model: &'a TypedModel,
    material_slots: &TypedIdSlotIndex,
    construction: &Construction,
    layer_ids: &[MaterialId],
) -> Result<Vec<&'a Material>, RuntimeError> {
    let mut layer_materials = Vec::with_capacity(layer_ids.len());
    for layer_id in layer_ids {
        let material = material_slots
            .slot(layer_id.0)
            .and_then(|slot| model.materials.get(slot))
            .filter(|material| material.id == *layer_id)
            .ok_or_else(|| RuntimeError::MissingMaterial {
                construction_name: construction.name.0.clone(),
            })?;
        layer_materials.push(material);
    }
    Ok(layer_materials)
}

fn opaque_layer_materials<'a>(
    layer_materials: &[&'a Material],
    construction: &Construction,
) -> Result<Vec<OpaqueMaterialRef<'a>>, RuntimeError> {
    layer_materials
        .iter()
        .map(|material| {
            material.as_opaque().ok_or_else(|| {
                RuntimeError::UnsupportedMaterialForOpaqueHeatBalance {
                    construction_name: construction.name.0.clone(),
                    material_name: material.name.0.clone(),
                    material_family: material.family(),
                }
            })
        })
        .collect()
}

fn material_thermal_resistance_sum(
    layer_materials: &[&Material],
    opaque_layer_materials: &[OpaqueMaterialRef<'_>],
    construction: &Construction,
) -> Result<f64, RuntimeError> {
    let mut thermal_resistance_m2_k_per_w = 0.0;
    for (material, opaque_material) in layer_materials.iter().zip(opaque_layer_materials) {
        thermal_resistance_m2_k_per_w += opaque_material.thermal_resistance().ok_or_else(|| {
            RuntimeError::MissingThermalResistance {
                material_name: material.name.0.clone(),
            }
        })?;
    }
    if thermal_resistance_m2_k_per_w > 0.0 {
        Ok(thermal_resistance_m2_k_per_w)
    } else {
        Err(RuntimeError::MissingThermalResistance {
            material_name: construction.name.0.clone(),
        })
    }
}

fn material_heat_capacity_per_area_sum(
    opaque_layer_materials: &[OpaqueMaterialRef<'_>],
) -> Option<f64> {
    let heat_capacity_j_per_m2_k = opaque_layer_materials
        .iter()
        .filter_map(|material| material.heat_capacity_per_area())
        .sum::<f64>();
    if heat_capacity_j_per_m2_k > 0.0 {
        Some(heat_capacity_j_per_m2_k)
    } else {
        None
    }
}

fn validate_surface_construction_families(
    model: &TypedModel,
    construction_slots: &TypedIdSlotIndex,
) -> Result<(), RuntimeError> {
    for surface in &model.surfaces {
        let Some(construction) = construction_slots
            .slot(surface.construction.0)
            .and_then(|slot| model.constructions.get(slot))
            .filter(|construction| construction.id == surface.construction)
        else {
            continue;
        };
        if !construction.is_ordinary_opaque() {
            return Err(RuntimeError::UnsupportedConstructionForOpaqueHeatBalance {
                surface_name: surface.name.0.clone(),
                construction_name: construction.name.0.clone(),
                construction_kind: construction.kind,
            });
        }
    }
    Ok(())
}

fn construction_cache_hash(entries: &[ConstructionThermalData]) -> u64 {
    let mut hasher = std::collections::hash_map::DefaultHasher::new();
    for entry in entries {
        entry.construction_id.hash(&mut hasher);
        entry.material_layer_stack.hash(&mut hasher);
        entry
            .thermal_resistance_m2_k_per_w
            .to_bits()
            .hash(&mut hasher);
        entry
            .heat_capacity_j_per_m2_k
            .map(f64::to_bits)
            .hash(&mut hasher);
        entry.ctf_coefficient_source.id().hash(&mut hasher);
        if entry.ctf_coefficient_source
            == ConstructionCtfCoefficientSource::RustGeneratedAllResistive
            && let Ok(coefficients) = &entry.ctf02_coefficients.result
        {
            coefficients.ctf_time_step.to_bits().hash(&mut hasher);
            coefficients.num_histories.hash(&mut hasher);
            coefficients.num_ctf_terms.hash(&mut hasher);
            coefficients.u_value.to_bits().hash(&mut hasher);
            for array in [
                &coefficients.outside,
                &coefficients.cross,
                &coefficients.inside,
                &coefficients.flux,
            ] {
                for value in array {
                    value.to_bits().hash(&mut hasher);
                }
            }
        }
        for coefficient in &entry.ctf_coefficients {
            coefficient.time_index.hash(&mut hasher);
            coefficient.outside_w_per_m2_k.to_bits().hash(&mut hasher);
            coefficient.cross_w_per_m2_k.to_bits().hash(&mut hasher);
            coefficient.inside_w_per_m2_k.to_bits().hash(&mut hasher);
            coefficient.flux.map(f64::to_bits).hash(&mut hasher);
        }
    }
    hasher.finish()
}

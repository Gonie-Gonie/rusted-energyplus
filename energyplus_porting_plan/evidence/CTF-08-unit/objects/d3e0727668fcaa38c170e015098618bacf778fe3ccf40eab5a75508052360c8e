def ref(path):
    data = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(data).hexdigest(),
            "size_bytes": len(data), "line_count": len(data.splitlines())}


def checked(binding):
    path = ROOT / binding["path"]
    actual = ref(path)
    for key in ("sha256", "size_bytes", "line_count"):
        if key in binding:
            assert actual[key] == binding[key], (path, key)
    return path


def once(source, old, new):
    assert source.count(old) == 1, (old, source.count(old))
    return source.replace(old, new, 1)


def namespace(source):
    for old, new in [
        ("ctf07_candidate_", "ctf08_candidate_"), ("ctf07-candidate-", "ctf08-candidate-"),
        ("ctf07-helper-cases.v1", "ctf08-helper-cases.v1"),
        ("ctf07-native-admission-contract.v1", "ctf08-native-admission-contract.v1"),
        ("ctf07-production-helper-cases.v1", "ctf08-production-helper-cases.v1"),
        ("ctf07-production-native-admission-contract.v1", "ctf08-production-native-admission-contract.v1"),
        ("frozen_before_this_CTF07_helper_execution", "frozen_before_this_CTF08_helper_execution"),
        ("actual frozen CTF07 production packet differs", "actual frozen CTF08 production packet differs"),
    ]:
        source = source.replace(old, new)
    return source


def write(path, source):
    path.write_text(source, encoding="utf-8", newline="\n")


def api_paths(source):
    start = source.index("pub(super) const API_PATHS")
    return re.findall(r'"(crates/[^"\n]+)"', source[start:source.index("];", start)])



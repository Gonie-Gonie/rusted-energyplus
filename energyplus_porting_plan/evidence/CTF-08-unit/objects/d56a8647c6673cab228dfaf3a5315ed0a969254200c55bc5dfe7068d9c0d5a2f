        for index, (x, y) in enumerate(zip(left["matrices"][key], values)):
            if x is None or y is None: c.absence(path + "/matrices/" + key + "/" + str(index), x is not None, y is not None, True, "required actual matrix scalar absent")
            else: c.number(path + "/matrices/" + key + "/" + str(index), key, x, y)
    for key, profile in [("CTFTimeStep", "assembly_CTFTimeStep"), ("TimeStepZone", "caller_TimeStepZone")]:
        if right.get(key) is None: c.absence(path + "/" + key, True, False, True, "required first-attempt scalar absent")

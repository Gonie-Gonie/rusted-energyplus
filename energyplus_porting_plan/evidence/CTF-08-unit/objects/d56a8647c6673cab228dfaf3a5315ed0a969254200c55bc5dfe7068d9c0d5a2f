        c.exact(path + "/same_initial/" + key, initial_owner.get(key), right.get(key))
    for label, owner in [("Native_initial619", observed["InitialDiscretization"]["snapshot"]), ("Rust_initial", initial_owner)]:
        c.exact(path + "/" + label + "/NumHistories", owner.get("NumHistories"), left["NumHistories"] if label.startswith("Native") else right.get("NumHistories"))
        c.initial_handoff(path + "/" + label + "/CTFTimeStep", "initial_CTFTimeStep", owner["CTFTimeStep"], left["CTFTimeStep"] if label.startswith("Native") else right["CTFTimeStep"])
    a, b = left["active_prefix"], right.get("active_prefix")
    shape = isinstance(b, list) and type(right.get("LayersInConstruct")) is int and len(b) == right["LayersInConstruct"] == right.get("copied_layer_count") == right.get("actual_nodes_count") == right.get("actual_dx_count")
    if not shape or len(a) != len(b):
        c.absence(path + "/active_prefix_shape", True, shape, True, "required same actual matrix active-prefix shapes absent/different")
        return record
    if not isinstance(initial_owner.get("active_prefix"), list) or not isinstance(converted.get("active_prefix"), list) or len(initial_owner["active_prefix"]) != len(b) or len(converted["active_prefix"]) != len(b):
        c.absence(path + "/same_handoff_shape", True, False, True, "required same actual initial/converted handoff shape differs")
        return record
    for index, (x, y) in enumerate(zip(a, b)):
        p = path + "/active_prefix/" + str(index)
        if not isinstance(y, dict):
            c.absence(p, True, False, True, "required actual Rust layer copy absent"); continue
        for key in ["Nodes", "ResLayer"]:
            c.exact(p + "/" + key, x[key], y.get(key))
        c.exact(p + "/same_initial_Nodes", initial_owner["active_prefix"][index]["Nodes"], y.get("Nodes"))
        for key in ["dl", "rk", "rho", "cp", "lr"]:
            if y.get(key) is None: c.absence(p + "/" + key, True, False, True, "required actual converted scalar absent")
            else:
                c.handoff(p + "/" + key, "PostConversion." + key, x[key], y[key])
                c.handoff(p + "/same_converted/" + key, "PostConversion." + key, converted["active_prefix"][index][key], y[key])
        if y.get("dx") is None: c.absence(p + "/dx", True, False, True, "required actual dx absent")
        else:
            c.initial_handoff(p + "/dx", "dx", x["dx"], y["dx"])
            c.initial_handoff(p + "/same_initial_dx", "dx", initial_owner["active_prefix"][index]["dx"], y["dx"])
    matrices = right.get("matrices")
    for key in MATRIX_FIELDS:
        expected_size = left["rcmax"] * left["rcmax"] if key in ["AMat", "IdenMatrix"] else MATRIX_FIXED_SHAPES[key]
        values = matrices.get(key) if isinstance(matrices, dict) else None
        if not isinstance(values, list) or len(values) != expected_size:
            c.absence(path + "/matrices/" + key + "/shape", True, isinstance(values, list), True, "required exact actual matrix shape absent/different")

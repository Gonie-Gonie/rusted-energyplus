def matrix_count_proof(c, qa):
    counts = qa["actual_observation_counts"]
    for key, actual in [("actual_matrix_attempt_callback_count", "Native_actual_matrix_attempt_callback_count"),
                        ("actual_retained_matrix_attempt_count", "Native_actual_retained_matrix_attempt_count"),
                        ("matrix_later_unpaired_attempt_count", "Native_later_matrix_attempts_unpaired"),
                        ("matrix_uninvoked_whole_call_count", "Native_matrix_uninvoked_whole_calls")]:
        c.exact("actual_DataQA_count/" + key, counts[key], c.counts[actual])
    c.need(qa["complete_actual_matrix_records"] is True and counts["matrix_attempt_records_omitted"] == 0 and
           counts["matrix_failure_event_count"] == 0 and all(qa["actual_matrix_failure_event_counts"][key] == 0 for key in FAILURE_KINDS),
           "Actual DataQA all-attempt integrity/count proof required")


def compare_matrix_models(native, rust, request, c):
    ledger = []
    for expected, left, right in zip(request["model_cases"], native["model_cases"], rust["model_cases"]):
        for index, (declared, operation, observed) in enumerate(zip(expected["operations"], left["operations"], right["operations"])):
            path = expected["id"] + "/" + declared["id"] + "/CTF04"
            c.exact(path + "/actual_API", "initialize_construction_ctf_first_assembly", observed.get("actual_Rust_CTF04_API"))
            c.exact(path + "/actual_API_invoked", True, observed.get("actual_Rust_CTF04_API_invoked"))
            c.need(observed.get("preprocessing_or_initial_reexecuted_for_assembly_owner") is False,
                   "Actual same two-owner API call required")
            record = first_assembly_storage(c, path, operation, observed.get("CTF04_first_assembly"),
                observed.get("CTF03_initial"), observed.get("result"), observed.get("actual_caller_TimeStepZone"), index)
            record.update({"model_id": expected["id"], "operation_id": declared["id"], "actual_native_whole_outcome_context_only": operation["call_outcome"]})
            ledger.append(record)
    return ledger


def run(args):
    path = PREP / "packet_io.py"

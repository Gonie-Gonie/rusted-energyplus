pub(super) fn ctf08_selected(source: &HeatBalanceState) -> Value {
    json!({"owner_available":true,"construction_first_private_coefficients":source.construction_ctf08_first_private_coefficients.iter()
        .enumerate().map(|(index,actual)| {
            let assembly = source.construction_ctf04_first_assembly.iter()
                .find(|owner|owner.construction_id == actual.construction_id);
            let exponential = source.construction_ctf06_first_exponential.iter()
                .find(|owner|owner.construction_id == actual.construction_id);
            let inverse = source.construction_ctf05_first_inverse.iter()
                .find(|owner|owner.construction_id == actual.construction_id);
            let gammas = source.construction_ctf07_first_gammas.iter()
                .find(|owner|owner.construction_id == actual.construction_id);
            json!({"state_vector_index":index,"construction_id":actual.construction_id.0,
                "result":unit_fields::first_private_coefficients(actual,assembly,exponential,inverse,gammas)})
        }).collect::<Vec<_>>(),
        "actual_owner_count":source.construction_ctf08_first_private_coefficients.len(),
        "predecessor_or_private_coefficient_owners_reexecuted_by_observer":false,
        "actual_CTF06_then_CTF05_then_CTF07_then_CTF08_order_is_producer_owned":true,
        "only_first_Rust_method_invocation_owned":true,"retry_driver_available":false,

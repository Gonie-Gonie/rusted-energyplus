                if stage == "Entry" and context["assembly_context_available"]:
                    if copy["owner"] == "IdenMatrix": actual_values = assembly["snapshot"]["matrices"]["IdenMatrix"]
                    else:
                        name = "Exponential" if copy["owner"] == "AExp" else "Inverse"
                        preceding = predecessors[name].get(ordinal)
                        need(preceding is not None and preceding["SourceReturn"]["available"] and preceding["observed_assembly_ordinal"] == assembly_ordinal, "Gamma input requires actual matching predecessor return")
                        actual_values = next(r["values"] for r in preceding["SourceReturn"]["snapshot"]["matrices"] if r["owner"] == copy["owner"])
                    need([v["value_bits"] for v in copy["values"]] == [v["value_bits"] for v in actual_values], "Actual predecessor-to-Gamma matrix handoff differs")
                if stage == "SourceReturn" and copy["copy_available"]:
                    prior_stage = record["Gamma1Final" if copy["owner"] == "Gamma1" else "Gamma2Final"]
                    need(prior_stage["available"] and [v["value_bits"] for v in copy["values"]] ==
                         [v["value_bits"] for v in prior_stage["snapshot"]["matrices"][0]["values"]], "Actual final-to-caller Gamma storage handoff differs")
            need(not snapshot["matrices_available"] or complete, "Available Gamma matrices require all actual copies")
            if not value["available"]: failed = True
            bounds = snapshot["BMat_actual_bounds"]
            need(bounds is None or isinstance(bounds, dict) and set(bounds) == {"lower", "upper", "size"} and all(type(v) is int for v in bounds.values()), "Actual BMat bounds required")
            if stage == "Entry":
                if snapshot["BMat_available"]:
                    need(bounds == {"lower": 1, "upper": 3, "size": 3} and isinstance(snapshot["BMat"], list) and len(snapshot["BMat"]) == 3, "Actual BMat3 shape differs")
                    for field in snapshot["BMat"]: scalar(field)
                    if context["assembly_context_available"]: need([v["value_bits"] for v in snapshot["BMat"]] == [v["value_bits"] for v in assembly["snapshot"]["matrices"]["BMat"]], "Original BMat handoff differs")
                else: need(snapshot["BMat"] is None, "Unavailable BMat cannot fabricate values"); failed = True
            else: need(snapshot["BMat_available"] is False and snapshot["BMat"] is None and bounds is None, "BMat not observed outside actual entry")
            caller = snapshot["actual_return_site_caller_context"]
            if stage == "SourceReturn":
                need(snapshot["caller_context_available"] is True and isinstance(caller, dict) and set(caller) == {"ErrorsFound", "DoCTFErrorReport", "TimeStepZone"} and
                     type(caller["ErrorsFound"]) is bool and type(caller["DoCTFErrorReport"]) is bool, "Actual Gamma caller return marker required")
                scalar(caller["TimeStepZone"])
                if context["assembly_context_available"]: need(caller == context["earlier_checked_assembly_context"], "Actual Gamma return caller differs")
            else: need(snapshot["caller_context_available"] is False and caller is None, "Gamma return cannot be inferred before caller site")
        for i in range(5):
            retained[i] += reached[i]; actual_sum[i] += actual[i]
            need(actual[i] >= reached[i], "Gamma callback count cannot omit retained stage")
        if actual != reached: failed = True
        need(all(not reached[i] or all(reached[:i]) for i in range(1, 5)), "Actual Gamma stage order differs")
        if operation["call_outcome"]["status"] == "source_returned": need(all(reached), "Returned whole call with Gamma entry requires real complete Gamma return")
        if ordinal > 1: counts["gamma_later_unpaired_invocation_count"] += 1
        elif record["association_available"] and assembly_ordinal == 1 and assembly is not None and assembly["available"] and assembly["snapshot"]["SourceSinkPresent"] is False and assembly["snapshot"]["SolutionDimensions"] == 1:
            counts["gamma_selected_first_invocation_count"] += 1
        counts["gamma_actual_return_marker_count"] += reached[4]
    need(all(callbacks[i] == retained[i] + omitted[i] and actual_sum[i] <= callbacks[i] for i in range(5)) and all(flag_sum[i] <= event_counts[i] for i in range(6)), "All Gamma visits/failures require exact retained or omitted accounting")
    failed = bool(failed or callbacks != retained)
    need(ledger["method_copy_integrity_failed"] is failed, "Actual Gamma integrity summary differs")
    if failed: integrity.append(label + "/Gamma/required-observation-integrity-failed")
    exp, inv = observed["Exponential"], observed["Inverse"]
    if not (failed or exp["method_copy_integrity_failed"] or inv["method_copy_integrity_failed"]):
        need(callbacks[0] <= inv["actual_stage_callback_counts"][6] <= exp["actual_stage_callback_counts"][6] and
             inv["actual_invocation_count"] <= callbacks[4] + 1, "Actual exponential-before-inverse-before-Gamma return order differs")
        if operation["call_outcome"]["status"] == "source_returned":
            need(callbacks[0] == callbacks[4] == inv["actual_invocation_count"], "Normally returned whole call requires each real inverse-to-Gamma visit")
        for record in ledger["invocations"]:
            for name in ["Exponential", "Inverse"]:
                preceding = predecessors[name].get(record["observed_invocation_ordinal"])
                need(preceding is not None and preceding["SourceReturn"]["reached"] and preceding["observed_assembly_ordinal"] == record["observed_assembly_ordinal"], "Actual Gamma entry requires both matching prior returns")
    counts["gamma_actual_invocation_count"] += callbacks[0]; counts["gamma_actual_retained_invocation_count"] += len(ledger["invocations"])
    for i, stage in enumerate(STAGES): counts["gamma_stage_" + stage] += callbacks[i]; counts["gamma_omitted_" + stage] += omitted[i]
    for i, kind in enumerate(FAILURES): counts["gamma_failure_" + kind] += event_counts[i]
    counts["gamma_method_copy_integrity_failed"] = bool(counts["gamma_method_copy_integrity_failed"] or failed)


def summary(result, counts, need):
    expected = {"actual_invocation_count": counts["gamma_actual_invocation_count"], "actual_retained_invocation_count": counts["gamma_actual_retained_invocation_count"],
        "actual_stage_callback_counts": [counts["gamma_stage_" + stage] for stage in STAGES], "stage_records_omitted": [counts["gamma_omitted_" + stage] for stage in STAGES],
        "failure_event_counts": [counts["gamma_failure_" + kind] for kind in FAILURES], "method_copy_integrity_failed": bool(counts["gamma_method_copy_integrity_failed"]),
        "complete_method_return_parity_claimed": False, "numerical_PASS_claimed": False}
    total = result["actual_gamma_observation_counts"]
    need(isinstance(total, dict) and set(total) == set(expected) and total == expected, "Global Gamma totals differ from all actual records")
    for key in ["actual_invocation_count", "actual_retained_invocation_count"]: need(type(total[key]) is int, "Typed global Gamma count required")
    for key, size in [("actual_stage_callback_counts", 5), ("stage_records_omitted", 5), ("failure_event_counts", 6)]:
        need(isinstance(total[key], list) and len(total[key]) == size and all(type(n) is int and n >= 0 for n in total[key]), "Typed global Gamma count array required")
    for key in ["method_copy_integrity_failed", "complete_method_return_parity_claimed", "numerical_PASS_claimed"]: need(type(total[key]) is bool, "Typed global Gamma flag required")
    return {"actual_gamma_observation_counts": expected, **{key: counts[key] for key in ["gamma_whole_call_records", "gamma_uninvoked_whole_call_records", "gamma_selected_first_invocation_count", "gamma_later_unpaired_invocation_count", "gamma_actual_return_marker_count"]}}

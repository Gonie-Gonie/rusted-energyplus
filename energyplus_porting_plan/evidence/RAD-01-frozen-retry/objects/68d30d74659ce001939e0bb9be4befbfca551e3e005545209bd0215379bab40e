# Source-only additional target: full genuine Original TU plus passive copies.
if(NOT DEFINED CLK03_REPOSITORY_ROOT OR NOT DEFINED RAD01_SOURCE_DIR)
  message(FATAL_ERROR "RAD01 requires explicit repository/source directories")
endif()
include("${CLK03_REPOSITORY_ROOT}/.runtime/porting/CTF-10/native-helper-prep-01/ctf10_reference.cmake")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_rad01_scheduled GLOBAL PROPERTY RAD01_REFERENCE_SCHEDULED)
  if(NOT _rad01_scheduled)
    set_property(GLOBAL PROPERTY RAD01_REFERENCE_SCHEDULED TRUE)
    function(rad01_add_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "RAD01 requires unchanged genuine core archive")
      endif()
      get_target_property(_rad01_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_rad01_dir_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      list(APPEND _rad01_defs ${_rad01_dir_defs})
      list(FILTER _rad01_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _rad01_defs)
      add_executable(rad01_unit_helper "${RAD01_SOURCE_DIR}/rad01_helper.cpp"
        "${CLK03_REPOSITORY_ROOT}/.runtime/porting/RAD-01/native-helper-prep-01/HeatBalanceIntRadExchange.rad01.cc"
        "${CLK03_REPOSITORY_ROOT}/.runtime/porting/RAD-01/native-helper-prep-01/rad01_observer.cc")
      target_include_directories(rad01_unit_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${CLK03_REPOSITORY_ROOT}/.runtime/porting/RAD-01/native-helper-prep-01")
      target_compile_definitions(rad01_unit_helper PRIVATE ${_rad01_defs})
      target_link_libraries(rad01_unit_helper PRIVATE energypluslib project_options project_fp_options project_warnings bcrypt)
      target_compile_features(rad01_unit_helper PRIVATE cxx_std_20)
      target_link_options(rad01_unit_helper PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/rad01_unit_helper.map")
    endfunction()
    cmake_language(DEFER CALL rad01_add_reference)
  endif()
endif()

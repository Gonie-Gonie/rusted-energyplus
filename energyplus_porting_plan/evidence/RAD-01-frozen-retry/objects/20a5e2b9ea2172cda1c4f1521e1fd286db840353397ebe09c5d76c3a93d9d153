NATIVE_SHA = 'b4e10bd483af44f6f5d0b6f5fa13051d106d6d672d1ec0af1b79bbf5d5986b89'


def ref(path):
    raw = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(raw).hexdigest(),
            'size_bytes': len(raw), 'line_count': len(raw.splitlines())}


def delta(before, after, destination):
    raw = ''.join(difflib.unified_diff(before.read_text(encoding='utf-8').splitlines(True),
        after.read_text(encoding='utf-8').splitlines(True), fromfile=ref(before)['path'], tofile=ref(after)['path']))
    destination.write_bytes(raw.encode('utf-8'))
    return ref(destination)


assert ref(NATIVE_PATH)['sha256'] == NATIVE_SHA
native = json.loads(NATIVE_PATH.read_bytes())
native_old_path = BASE / 'native-helper-prep-01/manifest.json'
native_old = json.loads(native_old_path.read_bytes())
native_changes = {native_old_path.relative_to(ROOT).as_posix(): ref(NATIVE_PATH)}
for before, after in zip(native_old['own_sources'], native['own_sources']):
    if before != after:
        native_changes[before['path']] = after


def author(kind, names, replacements, extra_changes, disclosure):
    old = BASE / (kind + '-prep-02')
    out = BASE / (kind + '-prep-03')
    out.mkdir(exist_ok=True)
    before = out / 'before'
    previous = out / 'before-02'
    before.mkdir(exist_ok=False)
    previous.mkdir(exist_ok=False)
    old_manifest = json.loads((old / 'manifest.json').read_bytes())
    for name in names:
        (before / name).write_bytes((old / 'before' / name).read_bytes())
        (previous / name).write_bytes((old / name).read_bytes())
        raw = (old / name).read_bytes()
        if name == names[0]:
            for original, proposed in replacements:
                assert raw.count(original) == 1, original
                raw = raw.replace(original, proposed)
        (out / name).write_bytes(raw)
        ast.parse(raw.decode('utf-8'))
    for name in ['manifest.json', 'README.md']:
        (previous / name).write_bytes((old / name).read_bytes())
    readme = (old / 'README.md').read_bytes() + ('\n' + disclosure + '\n').encode('utf-8')
    (out / 'README.md').write_bytes(readme)
    m = copy.deepcopy(old_manifest)
    m['own_sources'] = [ref(out / name) for name in names]
    m['authoring_source'] = ref(Path(__file__).resolve())
    m['readme'] = ref(out / 'README.md')
    m['before_sources'] = [ref(before / name) for name in names]
    m['exact_diffs'] = [delta(before / name, out / name, out / (name + '.diff')) for name in names]
    changes = {**native_changes, **extra_changes}
    m['historical_dependencies_superseded_by_03'] = [row for row in m['source_dependencies'] if row['path'] in changes]
    m['source_dependencies'] = [copy.deepcopy(changes.get(row['path'], row)) for row in m['source_dependencies']]
    # The two helper ranges retain the same semantic regions after the reviewed13-line reflow.
    for row in m['read_source_ranges']:
        if row['path'] == '.runtime/porting/RAD-01/native-helper-prep-01/rad01_helper.cpp':
            original = copy.deepcopy(row)
            m.setdefault('historical_helper_ranges_before_03', []).append(original)
            row['path'] = native['native_source_files'][0]['path']
            if row['start_line'] == 16:
                assert row['end_line'] == 108
                row['end_line'] = 121
            else:
                assert (row['start_line'], row['end_line']) == (111, 140)
                row['start_line'], row['end_line'] = 124, 153
            raw = b''.join((ROOT / row['path']).read_bytes().splitlines(True)[row['start_line'] - 1:row['end_line']])
            row['sha256'], row['size_bytes'] = hashlib.sha256(raw).hexdigest(), len(raw)
    m['predecessor_02'] = ref(old / 'manifest.json')
    m['before_02'] = [ref(previous / name) for name in [*names, 'manifest.json', 'README.md']]
    m['from_02_diffs'] = [delta(previous / name, out / name, out / (name + '.from-02.diff')) for name in [*names, 'README.md']]
    m['successor_change'] = disclosure
    m['runtime_protocol']['scope_successful_build_or_engine_flag'] = 'actual_RAD01_successful_build_or_engine_execution_performed'
    m['runtime_protocol']['failed_build_attempt_is_historical_context_not_scientific_execution'] = True
    (out / 'manifest.json').write_bytes((json.dumps(m, indent=2) + '\n').encode('utf-8'))
    return out, m



+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ep_model::ReportInputObject;
+
+    fn row(kind: Kind, alphas: [&str; 3], count: u8) -> ReportInputObject {
+        ReportInputObject {
+            object_name: "authored direct API input".to_string(), object_type: kind,
+            alphas: alphas.map(str::to_string), alpha_blank: [false; 3],
+            default_applied: [false; 3], num_alphas: count, is_epjson: true,
+        }
+    }
+
+    #[test]
+    fn first_scan_reads_real_a_families_then_later_queries_reuse_cache() {
+        let input = ReportInputs { objects: vec![
+            row(Kind::VariableDictionary, ["IDF", "", ""], 1),
+            row(Kind::SurfacesDrawing, ["DXF:WIREFRAME", "TRIANGULATE3DFACE", ""], 1),
+            row(Kind::Constructions, ["CONSTRUCTIONS", "", ""], 1),
+        ], ..ReportInputs::default() };
+        let mut state = ReportScanState::default();
+        assert_eq!(scan_for_reports(&input, &mut state, "Constructions", Some("Constructions"), None, None, |_| {}), Ok(true));
+        assert!(!state.get_report_input);
+        assert!(state.variable_dictionary && state.dxf_wireframe);
+        let mut first = "keep".to_string();
+        let mut second = "keep".to_string();
+        assert_eq!(scan_for_reports(&ReportInputs::default(), &mut state, "Surfaces", Some("dxf:wireframe"), Some(&mut first), Some(&mut second), |_| {}), Ok(true));
+        assert_eq!((first.as_str(), second.as_str()), ("TRIANGULATE3DFACE", ""));
+        assert_eq!(state.variable_dictionary_options, ["IDF", ""]);
+    }
+
+    #[test]
+    fn unknown_surface_list_token_uses_native_map_empty_warning_not_invalid() {
+        let input = ReportInputs { objects: vec![row(Kind::SurfacesList, ["UNRECOGNIZED", "", ""], 1)], ..ReportInputs::default() };
+        let mut messages = Vec::new();
+        let mut state = ReportScanState::default();
+        assert_eq!(scan_for_reports(&input, &mut state, "Constructions", Some("Constructions"), None, None, |message| messages.push(message)), Ok(false));
+        assert_eq!(messages, vec![
+            ReportScanDiagnostic::Warning("Output:Surfaces:List: No report_type supplied.".to_string()),
+            ReportScanDiagnostic::Continue(" Legal values are: \"Lines\", \"Vertices\", \"Details\", \"DetailsWithVertices\", \"CostInfo\", \"ViewFactorIinfo\".".to_string()),
+        ]);
+        assert!(!state.get_report_input);
+    }
+
+    #[test]
+    fn materials_only_second_alpha_count_and_optional_refs_remain_distinct() {
+        let input = ReportInputs { objects: vec![row(Kind::Constructions, ["MATERIALS", "CONSTRUCTIONS", ""], 1)], ..ReportInputs::default() };
+        let mut state = ReportScanState::default();
+        let mut untouched = "caller option".to_string();
+        assert_eq!(scan_for_reports(&input, &mut state, "Constructions", Some("Constructions"), Some(&mut untouched), None, |_| {}), Ok(false));
+        assert!(state.materials);
+        assert_eq!(untouched, "caller option");
+        assert_eq!(scan_for_reports(&input, &mut state, "Constructions", Some("Materials"), None, None, |_| {}), Ok(true));
+        let mut two_alpha = input;
+        two_alpha.objects[0].num_alphas = 2;
+        let mut fresh = ReportScanState::default();
+        assert_eq!(scan_for_reports(&two_alpha, &mut fresh, "Constructions", Some("Constructions"), None, None, |_| {}), Ok(true));
+    }
+
+    #[test]
+    fn last_ordered_options_and_ems_assignments_replace_earlier_values() {
+        let input = ReportInputs { legacy_variable_dictionary_sections: 1, objects: vec![
+            row(Kind::VariableDictionary, ["IDF", "NAME", ""], 2),
+            row(Kind::VariableDictionary, ["REGULAR", "UNSORTED", ""], 2),
+            row(Kind::EnergyManagementSystem, ["VERBOSE", "NOTBYUNIQUEKEYNAMES", "VERBOSE"], 3),
+            row(Kind::EnergyManagementSystem, ["NONE", "NONE", "ERRORSONLY"], 3),
+        ] };
+        let mut state = ReportScanState::default();
+        assert_eq!(scan_for_reports(&input, &mut state, "EnergyManagementSystem", None, None, None, |_| {}), Ok(true));
+        assert_eq!(state.variable_dictionary_options, ["REGULAR", "UNSORTED"]);
+        assert_eq!(state.ems_actuator_availability, [false; 2]);
+        assert_eq!(state.ems_internal_variable_availability, [false; 2]);
+        assert!(state.ems_errors);
+        assert!(!state.ems_full_trace);
+    }
+
+    #[test]
+    fn missing_surfaces_key_is_typed_unavailable_after_real_first_cache_read() {
+        let mut state = ReportScanState::default();
+        assert_eq!(scan_for_reports(&ReportInputs::default(), &mut state, "Surfaces", None, None, None, |_| {}), Err(ReportScanUnavailable::MissingSurfacesKey));
+        assert!(!state.get_report_input);
+        assert_eq!(scan_for_reports(&ReportInputs::default(), &mut state, "unknown", None, None, None, |_| {}), Ok(false));
+    }
+}

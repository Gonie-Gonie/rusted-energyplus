def write_diff(a, b, old_name, new_name, target):
    body = "".join(difflib.unified_diff(a.decode("utf-8").splitlines(True),
        b.decode("utf-8").splitlines(True), fromfile=old_name, tofile=new_name))
    target.write_text(body, encoding="utf-8", newline="")


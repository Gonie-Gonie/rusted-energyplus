    source = OUT / "new" / name
    diff = OUT / (name + ".new.diff")
    diff.write_text(delta(owner, "", source.read_text()), encoding="utf-8", newline="\n")
    changes.append({"owner": owner, "new_owner": True, "before": None,
                    "proposed": ref(source), "exact_diff": ref(diff)})


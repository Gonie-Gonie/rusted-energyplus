def ref(path):
    raw = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(raw).hexdigest(),
            "size_bytes": len(raw), "line_count": len(raw.splitlines())}


def replace_once(text, before, after):
    assert text.count(before) == 1, before
    return text.replace(before, after, 1)


def delta(owner, before, after):
    return "".join(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
        fromfile="a/" + owner if before else "/dev/null", tofile="b/" + owner))



+void matrix_failure(Capture &capture, MatrixAttemptSnapshot *snapshot,
+                    std::size_t ordinal, MatrixAttemptFailureKind kind) noexcept
+{
+    capture.matrix_observer_failure = true;
+    std::size_t const index = static_cast<std::size_t>(kind);
+    ++capture.matrix_failure_event_counts[index];
+    if (snapshot != nullptr) snapshot->failure_kinds[index] = true;
+    MatrixAttemptFailure const failure{ordinal, kind};
+    if (!capture.first_matrix_failure) capture.first_matrix_failure = failure;
+    capture.last_matrix_failure = failure;
+}
+
+std::optional<Array1Bounds> array_bounds(Array1D<Real64> const &values) noexcept
+{
+    if (!values.allocated()) return std::nullopt;
+    return Array1Bounds{values.l(), values.u(), values.size()};
+}
+
+std::optional<Array2Bounds> array_bounds(Array2D<Real64> const &values) noexcept
+{
+    if (!values.allocated()) return std::nullopt;
+    return Array2Bounds{values.l1(), values.u1(), values.l2(), values.u2(), values.size()};
+}
+
+bool exact_vector(std::optional<Array1Bounds> const &bounds, int count) noexcept
+{
+    return bounds && bounds->lower == 1 && bounds->upper == count &&
+           bounds->size == static_cast<std::size_t>(count);
+}
+
+bool exact_square(std::optional<Array2Bounds> const &bounds, int count,
+                  std::size_t elements) noexcept
+{
+    return bounds && bounds->lower1 == 1 && bounds->upper1 == count &&
+           bounds->lower2 == 1 && bounds->upper2 == count && bounds->size == elements;
+}

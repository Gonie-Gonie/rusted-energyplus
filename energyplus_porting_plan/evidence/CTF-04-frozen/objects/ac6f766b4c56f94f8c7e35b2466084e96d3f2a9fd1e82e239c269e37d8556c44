"""Prepare source-only first-assembly observers from actual CTF03 source bytes."""
from pathlib import Path
import ast
import difflib
import hashlib
import json
import re

ROOT = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent
INGRESS = ROOT / ".runtime/porting/CTF-04/cache-ingress-prep-01"
PURE = ROOT / ".runtime/porting/CTF-04/rust-assembly-prep-04"
NATIVE = ROOT / ".runtime/porting/CTF-04/native-helper-prep-01"


def ref(path):
    raw = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(raw).hexdigest(),
            "size_bytes": len(raw), "line_count": len(raw.splitlines())}


def once(text, old, new):
    assert text.count(old) == 1, old
    return text.replace(old, new, 1)


def namespace(text):
    for old, new in [
        ("ctf03_candidate_", "ctf04_candidate_"),
        ("ctf03-candidate-", "ctf04-candidate-"),
        ("ctf03-helper-cases.v1", "ctf04-helper-cases.v1"),
        ("ctf03-native-admission-contract.v1", "ctf04-native-admission-contract.v1"),
        ("ctf03-production-helper-cases.v1", "ctf04-production-helper-cases.v1"),
        ("ctf03-production-native-admission-contract.v1", "ctf04-production-native-admission-contract.v1"),
        ("frozen_before_this_CTF03_helper_execution", "frozen_before_this_CTF04_helper_execution"),
        ("actual frozen CTF03 production packet differs", "actual frozen CTF04 production packet differs"),
    ]:
        text = text.replace(old, new)
    return text


SERIALIZER = r'''pub(super) fn first_assembly(
    source: &ConstructionCtfFirstAssembly,
    initial: Option<&ConstructionCtfInitialDiscretization>,
    preprocessing: Option<&ConstructionCtfLayerPreprocessing>,
) -> Value {
    let phases = preprocessing.and_then(|owner| owner.result.as_ref().ok());
    let converted = phases.and_then(|owner| owner.after_conversion.as_ref());
    let (available, route, reason, snapshot) = match &source.result {
        Err(reason) => {
            let route = match reason {
                CtfFirstAssemblyUnavailable::InitialUnavailable(_) => "InitialUnavailable",
                CtfFirstAssemblyUnavailable::ConstructionIdentityMismatch => "ConstructionIdentityMismatch",
                CtfFirstAssemblyUnavailable::PreprocessingScope(_) => "PreprocessingScope",
                CtfFirstAssemblyUnavailable::PreprocessingRouteMismatch => "PreprocessingRouteMismatch",
                CtfFirstAssemblyUnavailable::PostConversionUnavailable => "PostConversionUnavailable",
                CtfFirstAssemblyUnavailable::CallerTimeStepMismatch => "CallerTimeStepMismatch",
                CtfFirstAssemblyUnavailable::AssemblyScope(_) => "AssemblyScope",
            };
            (false, route, Some(format!("{reason:?}")), Value::Null)
        }
        Ok(CtfAssemblyObservation::Unavailable(reason)) =>
            (false, "AssemblyUnavailable", Some(format!("{reason:?}")), Value::Null),
        Ok(CtfAssemblyObservation::Assembled(actual)) => {
            let values = |source: &[f64]| source.iter().copied().map(scalar).collect::<Vec<_>>();
            (true, "FirstAssemblyReturned", None, json!({
                "LayersInConstruct":actual.layers.len(),
                "NumResLayers":converted.map(|owner|owner.active.num_res_layers),
                "ErrorsFound":phases.map(|owner|owner.errors_found),
                "DoCTFErrorReport":null,"DoCTFErrorReport_paired":false,
                "IsUsedCTF":initial.map(|owner|owner.context.is_used_ctf),
                "SourceSinkPresent":actual.context.source_sink_present,
                "SolutionDimensions":actual.context.solution_dimensions,
                "active_prefix_available":true,"copied_layer_count":actual.layers.len(),
                "active_prefix":actual.layers.iter().enumerate().map(|(index,layer)|json!({
                    "dl":scalar(layer.dl),"rk":scalar(layer.rk),"rho":scalar(layer.rho),
                    "cp":scalar(layer.cp),"lr":scalar(layer.lr),"ResLayer":layer.res_layer,
                    "Nodes":actual.nodes.get(index).copied(),
                    "dx":actual.dx.get(index).copied().map(scalar)})).collect::<Vec<_>>(),
                "actual_nodes_count":actual.nodes.len(),"actual_dx_count":actual.dx.len(),
                "rcmax":actual.rcmax,"NodeSource":actual.context.node_source,
                "NodeUserTemp":actual.context.node_user_temp,
                "CTFTimeStep":scalar(actual.context.ctf_time_step),
                "NumHistories":actual.context.num_histories,
                "TimeStepZone":scalar(actual.context.time_step_zone),
                "attempt_ordinal":actual.context.attempt_ordinal,
                "actual_context_construction_id":actual.context.construction_id.0,
                "actual_route":format!("{:?}",actual.context.route),
                "matrices_available":true,"matrices":{
                    "AMat":values(&actual.a_mat),"IdenMatrix":values(&actual.iden_matrix),
                    "BMat":values(&actual.b_mat),"CMat":values(&actual.c_mat),"DMat":values(&actual.d_mat)},
                "storage_order":"source_i1_outer_i2_inner_row_first",
                "Native_Objexx_bounds_not_Rust_owner":true}))
        }
    };
    json!({"protocol":"ctf04-matrix-assembly.v1","owner_available":available,
        "selected_first_assembly_operands":available,"actual_source_route":route,
        "unavailable_reason":reason,"snapshot":snapshot,"construction_id":source.construction_id.0,
        "same_initial_owner_available":initial.is_some(),
        "same_initial_construction_id":initial.map(|owner|owner.construction_id.0),
        "same_preprocessing_owner_available":preprocessing.is_some(),
        "same_preprocessing_construction_id":preprocessing.map(|owner|owner.construction_id.0),
        "same_post_conversion_handoff_available":converted.is_some(),
        "only_first_Rust_assembly_invocation_owned":true,
        "later_Native_attempts_available_in_Rust":false,"later_Native_attempts_counted_as_PASS":false,
        "retry_driver_available":false,"Native_retry_state_or_counts_supplied_to_Rust":false,
        "observer_matrix_identity_or_route_arithmetic_performed":false,
        "Native_whole_method_outcome_or_flags_inferred":false,"counted_as_PASS":false})
}

'''

PRODUCTION_SERIALIZER = r'''pub(super) fn ctf04_unavailable() -> Value {
    json!({"owner_available":false,"construction_first_assembly":null,
        "unavailable_reason":"initializer has not returned an actual HeatBalanceState owner","counted_as_PASS":false})
}
pub(super) fn ctf04_selected(source: &HeatBalanceState) -> Value {
    json!({"owner_available":true,"construction_first_assembly":source.construction_ctf04_first_assembly.iter()
        .enumerate().map(|(index,actual)| {
            let initial = source.construction_ctf03_initial.iter()
                .find(|owner|owner.construction_id == actual.construction_id);
            let preprocessing = source.construction_ctf01_layers.iter()
                .find(|owner|owner.construction_id == actual.construction_id);
            json!({"state_vector_index":index,"construction_id":actual.construction_id.0,
                "result":unit_fields::first_assembly(actual,initial,preprocessing)})
        }).collect::<Vec<_>>(),
        "actual_owner_count":source.construction_ctf04_first_assembly.len(),
        "preprocessing_initial_or_assembly_reexecuted_by_observer":false,
        "observer_reverse_classifier_duplicated":false,"external_CTF_rows_supplied_to_initializer":false,
        "only_first_Rust_assembly_invocation_owned":true,"retry_driver_available":false,
        "later_Native_attempts_paired":false,"later_Native_attempts_counted_as_PASS":false,
        "Native_whole_solver_flags_unpaired":true,"numerical_PASS_claimed":false})
}

'''


def main():
    assert not (OUT / "manifest.json").exists(), "Held preparation is immutable"
    assert ref(INGRESS / "manifest.json")["sha256"] == "7cb278fcb90240a3b5ed5a528eb0b18e558127b94a915b28e1e1ae04bdcfafbf"
    assert ref(PURE / "manifest.json")["sha256"] == "d156fd37a226cb959234e61aeea30664410008797d61bdd080e1f6d0667c6b29"
    assert ref(NATIVE / "manifest.json")["sha256"] == "3ff67aa44a00c2529b98a6e4c62d4b1288830010c45ef5da9e996d11c4772815"
    predecessors = {
        "ctf04_candidate_unit_observer.rs":"crates/ep_run/examples/ctf03_candidate_unit_observer.rs",
        "unit_fields.rs":"crates/ep_run/examples/ctf03_candidate_unit_support/fields.rs",
        "ctf04_candidate_production_observer.rs":"crates/ep_run/examples/ctf03_candidate_production_observer.rs",
        "production_fields.rs":"crates/ep_run/examples/ctf03_candidate_production_support/fields.rs",
        "production_unit_fields.rs":"crates/ep_run/examples/ctf03_candidate_production_support/unit_fields.rs",
    }
    sources = {name:namespace((ROOT / owner).read_text(encoding="utf-8")) for name,owner in predecessors.items()}
    unit = sources["ctf04_candidate_unit_observer.rs"]
    unit = once(unit, "use ep_runtime::heat_balance::ctf_initial_owner::initialize_construction_ctf_initial;",
        "use ep_runtime::heat_balance::ctf_initial_owner::initialize_construction_ctf_initial;\nuse ep_runtime::heat_balance::ctf_first_assembly_owner::initialize_construction_ctf_first_assembly;")
    unit = once(unit, "        if let Ok(actual) = &preprocessing.result {", "        let first_assembly = initialize_construction_ctf_first_assembly(&initial, &preprocessing);\n        if let Ok(actual) = &preprocessing.result {")
    unit = once(unit, '            "CTF03_initial":fields::initial(&initial,Some(&preprocessing)),',
        '            "CTF03_initial":fields::initial(&initial,Some(&preprocessing)),\n            "CTF04_first_assembly":fields::first_assembly(&first_assembly,Some(&initial),Some(&preprocessing)),\n            "actual_Rust_CTF04_API":"initialize_construction_ctf_first_assembly","actual_Rust_CTF04_API_invoked":true,\n            "preprocessing_or_initial_reexecuted_for_assembly_owner":false,')
    unit = once(unit, '        "ctf03_initial_observation_policy":request["ctf03_initial_observation_policy"],',
        '        "ctf03_initial_observation_policy":request["ctf03_initial_observation_policy"],\n        "ctf04_matrix_observation_policy":request["ctf04_matrix_observation_policy"],\n        "actual_Rust_CTF04_API_invocations":calls,"Rust_retry_driver_available":false,\n        "later_Native_attempts_paired":false,"later_Native_attempts_counted_as_PASS":false,')
    sources["ctf04_candidate_unit_observer.rs"] = unit

    fields = sources["unit_fields.rs"]
    fields = once(fields, "use serde_json::{Value, json};", "use ep_runtime::heat_balance::ctf_first_assembly_owner::{\n    ConstructionCtfFirstAssembly, CtfFirstAssemblyUnavailable,\n};\nuse ep_runtime::heat_balance::surface_manager::ctf_state_space_assembly::CtfAssemblyObservation;\nuse serde_json::{Value, json};")
    fields = once(fields, "pub(super) const OBSERVER_PATHS", SERIALIZER + "pub(super) const OBSERVER_PATHS")
    api_append = ('    "crates/ep_runtime/src/heat_balance/surface_manager/ctf_state_space_assembly.rs",\n'
                  '    "crates/ep_runtime/src/heat_balance/ctf_first_assembly_owner.rs",\n')
    at = fields.index("];",fields.index("pub(super) const API_PATHS"))
    fields = fields[:at] + api_append + fields[at:]
    sources["unit_fields.rs"] = fields
    sources["production_unit_fields.rs"] = fields

    production = sources["ctf04_candidate_production_observer.rs"]
    production = once(production, '        "selected_CTF03_owners":fields::ctf03_unavailable(),"Native_or_expected_values_read":false});',
        '        "selected_CTF03_owners":fields::ctf03_unavailable(),\n        "selected_CTF04_owners":fields::ctf04_unavailable(),"Native_or_expected_values_read":false});')
    production = once(production, '            out["selected_CTF03_owners"] = fields::ctf03_selected(&state);',
        '            out["selected_CTF03_owners"] = fields::ctf03_selected(&state);\n            out["selected_CTF04_owners"] = fields::ctf04_selected(&state);')
    production = once(production, '        "ctf03_initial_observation_policy":native["ctf03_initial_observation_policy"],',
        '        "ctf03_initial_observation_policy":native["ctf03_initial_observation_policy"],\n        "ctf04_matrix_observation_policy":native["ctf04_matrix_observation_policy"],\n        "Rust_retry_driver_available":false,"later_Native_attempts_paired":false,\n        "later_Native_attempts_counted_as_PASS":false,')
    sources["ctf04_candidate_production_observer.rs"] = production
    prod_fields = sources["production_fields.rs"]
    prod_fields = once(prod_fields, "pub(super) fn typed(", PRODUCTION_SERIALIZER + "pub(super) fn typed(")
    at = prod_fields.index("];",prod_fields.index("pub(super) const API_PATHS"))
    sources["production_fields.rs"] = prod_fields[:at] + api_append + prod_fields[at:]

    canonical = {
        "ctf04_candidate_unit_observer.rs":"crates/ep_run/examples/ctf04_candidate_unit_observer.rs",
        "unit_fields.rs":"crates/ep_run/examples/ctf04_candidate_unit_support/fields.rs",
        "ctf04_candidate_production_observer.rs":"crates/ep_run/examples/ctf04_candidate_production_observer.rs",
        "production_fields.rs":"crates/ep_run/examples/ctf04_candidate_production_support/fields.rs",
        "production_unit_fields.rs":"crates/ep_run/examples/ctf04_candidate_production_support/unit_fields.rs",
    }
    (OUT / "before").mkdir()
    own = []
    for name, text in sources.items():
        before = OUT / "before" / name
        before.write_bytes((ROOT / predecessors[name]).read_bytes())
        target = OUT / name
        target.write_text(text,encoding="utf-8",newline="\n")
        patch = OUT / (name + ".from-CTF03.diff")
        patch.write_text("".join(difflib.unified_diff(before.read_text(encoding="utf-8").splitlines(True),
            text.splitlines(True),fromfile=predecessors[name],tofile=canonical[name])),encoding="utf-8",newline="\n")
        own.append({"proposed_canonical_path":canonical[name],"source":ref(target),
            "predecessor_current_source":ref(ROOT / predecessors[name]),"before":ref(before),"exact_diff":ref(patch)})
    api_lists = {}
    for lane,name in [("unit","unit_fields.rs"),("production","production_fields.rs")]:
        body = sources[name].split("pub(super) const API_PATHS: &[&str] = &[",1)[1].split("];",1)[0]
        api_lists[lane] = re.findall(r'"([^"]+)"',body)
    assert [len(api_lists[key]) for key in ["unit","production"]] == [14,27]
    proposals = {
        "crates/ep_runtime/src/heat_balance/surface_manager.rs":PURE / "proposed/crates/ep_runtime/src/heat_balance/surface_manager.rs",
        "crates/ep_runtime/src/heat_balance/surface_manager/ctf_state_space_assembly.rs":PURE / "proposed/crates/ep_runtime/src/heat_balance/surface_manager/ctf_state_space_assembly.rs",
        "crates/ep_runtime/src/heat_balance/ctf_first_assembly_owner.rs":INGRESS / "new/ctf_first_assembly_owner.rs",
    }
    for item in json.loads((INGRESS / "manifest.json").read_text())["changes"]:
        proposals[item["owner"]] = ROOT / item["proposed"]["path"]
    api_rows = []
    for owner in dict.fromkeys(api_lists["unit"] + api_lists["production"]):
        row = {"canonical_path":owner,"current_source":ref(ROOT/owner) if (ROOT/owner).is_file() else None,
            "actual_applied_formatted_identity_required_at_runtime":True}
        if owner in proposals: row["held_proposed_owner"] = ref(proposals[owner])
        api_rows.append(row)
    readme = '''# CTF04 candidate observers: source-only hold

Five new observer sources adapt the actual formatted, accepted CTF03 canonical
templates. Immutable before copies and exact patches retain those genuine source
bytes. No canonical source, compiler, formatter, engine or Git action is performed.

The unit lane preserves all39 literal model rows and42 declared whole calls. It
calls preprocessing once, then the actual initial-owner API with the real original
Construction/Material associations and ordered prior/used IDs, then calls
initialize_construction_ctf_first_assembly once with those same two owners. The
new API owns ordinal1 and all arithmetic; the observer only copies its return.
Selected preprocessing ErrorsFound carry remains unchanged. Native whole-method
flags, outcome and later retry carry are neither supplied to Rust nor inferred.

The production lane preserves fixedCON15 original IDF/default overlay, actual
conversion proofs, compiler and ordinary initializer. It copies the initialized
construction_ctf04_first_assembly vector in actual order, associating each row
with the actual initial and preprocessing owners by original ConstructionId.
It invokes no preprocessing, node, matrix, identity, reverse or retry evaluator.
Real material, construction, surface, timestep, CTF01 and CTF03 fields persist.
The Native13x15=195 loader record obligation is unchanged and is not invented as
a Rust operation count. Native whole calls remain derived from real loaded owners.

Available first-assembly owners copy active converted layers, Nodes/dx, rcmax,
node selectors, actual construction/attempt context, initial CTFTimeStep/history,
actual caller timestep, and all owned AMat/IdenMatrix/B3/C2/D2 values. Flat matrix
storage retains source i1-outer/i2-inner order. Native Objexx bounds are not a Rust
owner and are not fabricated. Nonfinite/scalar classes and exact bits persist;
JSON numeric values are null only for actual nonfinite values. Missing handoff
owners remain null and unavailable, never synthetic zero or fallback matrices.

CTF03 initial policy and fields remain separately inherited. Fresh CTF04 matrix
policy is copied from the authenticated new Native input packet. Only the actual
first Native matrix visit, ordinal1 in the same whole-call binding, may later be
paired. All later actual Native attempts must remain retained as unpaired/noPASS
context by the Native reader/comparer. Rust has no retry driver; this observer
does not fabricate Native visit counts or assert caller timestep==initial dt.

Unit owns2 sources plus ordered API14; production owns3 plus ordered API27.
Both inventories append the real pure assembly and first-assembly ingress modules.
The two serializers are byte-identical. Proposed source hashes are preparation
identities only. Root must apply/format, bind actual current source hashes, and
match the complete genuine Cargo SourceSnapshot before admitting any result.
CLI remains unit five input-only arguments (request+SHA, admission+SHA, sources)
and production request+SHA. Namespaces are ctf04-candidate-unit-runtime-source-
bindings.v1, ctf04-candidate-unit-observer-results.v1 and ctf04-candidate-production-
observer-request/results.v1. Request/member rows,45 guards, input-only conversion
provenance and source ordering remain unchanged. No numerical PASS, gate update,
downstream solver claim or new proof framework/stage is introduced. Root alone
executes; required selected one-sided or both-sided absence remains failure.
'''
    (OUT/"README.md").write_text(readme,encoding="utf-8",newline="\n")
    bindings = [ref(INGRESS/"manifest.json"),ref(PURE/"manifest.json"),ref(NATIVE/"manifest.json"),
        ref(ROOT/".runtime/porting/CTF-03/candidate-observer-prep-01/manifest.json"),
        ref(NATIVE/"ctf04_observation_fields.hh"),ref(NATIVE/"input-policy-proposal.json"),
        ref(NATIVE/"projection-policy-proposal.json")]
    manifest = {"schema":"ctf04-candidate-observer-source-inventory.v1","status":"SOURCE-READY-HELD-unapplied-unexecuted",
        "own_source_rows":own,"observer_source_counts":{"unit":2,"production":3},
        "API_paths":api_lists,"API_source_counts":{"unit":14,"production":27},
        "API_source_identities":api_rows,"source_preparation_bindings":bindings,
        "own_preparation_source":ref(Path(__file__).resolve()),"README":ref(OUT/"README.md"),
        "scalar_serializer_byte_identical_in_both_lanes":sources["unit_fields.rs"]==sources["production_unit_fields.rs"],
        "first_only_pairing":{"Native_policy":"ctf04-matrix-assembly.v1","selected_ordinal":1,
            "later_actual_Native_attempts_retained_unpaired":True,"Rust_retry_driver_available":False},
        "unchanged_input_counts":{"unit_models":39,"unit_whole_calls":42,"production_models":15,"Native_production_loader_records":195},
        "target_imported_or_executed":False,"scientific_or_binary_payloads_read":False,
        "canonical_sources_written":False,"new_QA_execution_stage":False}
    (OUT/"manifest.json").write_text(json.dumps(manifest,indent=2)+"\n",encoding="utf-8",newline="\n")
    ast.parse(Path(__file__).read_text(encoding="utf-8"))
    print(json.dumps({"manifest":ref(OUT/"manifest.json"),"sources":[row["source"] for row in own]}))


if __name__ == "__main__":
    main()

"""Write source-only inventory/proposals. No project imports or executions."""
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
PREP = ROOT / ".runtime/porting/CTF-04/native-helper-prep-01"
PRIOR = ROOT / ".runtime/porting/CTF-03/native-helper-prep-01"
OBSERVER = ROOT / ".runtime/porting/CTF-04/native-observer-prep-01"


def ref(path):
    data = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(data).hexdigest(),
            "size_bytes": len(data), "line_count": len(data.splitlines())}


def put(path, value):
    text = value if isinstance(value, str) else json.dumps(value, indent=2, ensure_ascii=True) + "\n"
    path.write_bytes(text.encode("utf-8"))



+        names |= {p.relative_to(ROOT).as_posix() for p in (ROOT / 'crates').rglob('Cargo.toml')}
+        names |= {name for name in ('Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml') if (ROOT / name).is_file()}
+        m.require(names == set(rows), 'Actual comparer current Source membership differs')
+    return rows

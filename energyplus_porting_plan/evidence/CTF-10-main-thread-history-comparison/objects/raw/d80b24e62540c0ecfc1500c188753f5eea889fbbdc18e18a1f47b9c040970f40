"""Root-only bounded publication of the closed ordinary history comparison; no event parsing."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import sys

ROOT = Path(__file__).resolve().parents[4]
OUT = ROOT / 'energyplus_porting_plan/evidence/CTF-10-main-thread-history-comparison'
SEEN = {}
ROLES = {}


def need(value, text):
    if not value: raise ValueError(text)


def full(path):
    with path.open('rb') as stream: digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest, 'size_bytes': path.stat().st_size}


def checked(row):
    path = (ROOT / row['path']).resolve()
    need(path.is_relative_to(ROOT) and path.is_file(), 'contained exact artifact required: ' + row['path'])
    value = full(path)
    need(value['sha256'] == row['sha256'] and ('size_bytes' not in row or value['size_bytes'] == row['size_bytes']), 'artifact bytes differ: ' + row['path'])
    SEEN[path] = value
    return path


def load(row):
    return json.loads(checked(row).read_bytes())


def same(a, b):
    need(checked(a) == checked(b), 'actual artifact identities differ')


def select(row, role):
    path = checked(row)
    if path.name in ['stdout.log', 'stderr.log']:
        receipt_path = path.parent / 'receipt.json'
        need(receipt_path.is_file(), 'active/unrecorded output log cannot be selected')
        receipt = load(full(receipt_path))
        need(receipt['schema'] == 'recorded-porting-command.v1' and receipt['finished_utc'] is not None and receipt['launch_error'] is None, 'closed authentic sibling receipt required')
        same(receipt['stdout' if path.name == 'stdout.log' else 'stderr'], row)
    ROLES.setdefault(path, set()).add(role)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['source-preparation', 'packet']: parser.add_argument('--' + name, required=True)
    args = parser.parse_args()
    def operand(token):
        name, sha = token.rsplit('#', 1); return full(checked({'path': name, 'sha256': sha}))
    prep_ref, packet_ref = operand(args.source_preparation), operand(args.packet)
    prep, packet = load(prep_ref), load(packet_ref)
    need(prep['schema'] == 'ctf10-main-thread-history-publication-Source-preparation.v1' and checked(prep['runtime_interfaces']['publisher']) == Path(__file__).resolve(), 'reviewed bounded publisher required')
    need(set(packet) == {'schema', 'comparison', 'comparison_execution', 'Root_factual_review', 'independent_factual_review'} and packet['schema'] == 'ctf10-main-thread-history-publication-inputs.v1', 'exact runtime publication packet required')
    report, execution = load(packet['comparison']), load(packet['comparison_execution'])
    same(packet['comparison'], prep['actual_comparison']); same(packet['comparison_execution'], prep['actual_comparison_execution'])
    comparer = load(prep['reviewed_comparer_preparation'])
    need(report['schema'] == 'ctf10-persistent-ordinary-history-comparison.v1' and report['status'] == 'fail-retained-mismatch-or-required-unavailable' and report['selected_paired_boundary_comparison_passed'] is False and report['stream_custody_failure'] is None and report['all_unmatched_and_mismatches_retained_without_cap'] is True, 'complete honest closed comparison FAIL required')
    need(all(report[k] is False for k in ['Native_only_context_or_Rust_generation_counted_as_PASS', 'inside_equation_per_iteration_PASS_claimed', 'whole_manager_PASS_claimed', 'integration_PASS_claimed', 'full_card_gates_updated']), 'bounded scientific failure scope differs')
    same(report['reviewed_comparer_preparation'], prep['reviewed_comparer_preparation'])
    same(report['prospective_pairing_policy_preparation'], prep['prospective_policy_preparation'])
    need(execution['schema'] == 'recorded-porting-command.v1' and execution['exit_code'] == 1 and execution['launch_error'] is None and execution['finished_utc'] is not None and execution['source_bytes_match_before_and_after'] is True and execution['recorder_updates_gates'] is False and execution['recorder_supplies_reference_answers'] is False, 'actual closed guarded failure receipt required')
    same(execution['source_snapshot'], report['actual_comparison_Source_snapshot']); same(execution['executed_launcher']['archive'], prep['recorder_Source'])
    expected = ['python', '-X', 'utf8', '-B', comparer['own_sources'][0]['path'], '--source-manifest', prep['reviewed_comparer_preparation']['path'] + '#' + prep['reviewed_comparer_preparation']['sha256'], '--approved-source-sha256', comparer['own_sources'][0]['sha256'], '--original-data-review', report['Native_QA']['original-data-review']['path'] + '#' + report['Native_QA']['original-data-review']['sha256'], '--original-data-review-execution', report['Native_QA']['original-data-review-execution']['path'] + '#' + report['Native_QA']['original-data-review-execution']['sha256'], '--production-packet', report['actual_invocation']['production_packet']['path'] + '#' + report['actual_invocation']['production_packet']['sha256'], '--comparison-source-snapshot', report['actual_comparison_Source_snapshot']['path'] + '#' + report['actual_comparison_Source_snapshot']['sha256'], '--rust-events', report['actual_Rust_events']['path'] + '#' + report['actual_Rust_events']['sha256'], '--output-dir', checked(packet['comparison']).parent.relative_to(ROOT).as_posix()]
    need(execution['command'] == expected, 'exact actual accepted comparer invocation required')
    stdout = load(execution['stdout'])
    # The historical comparer emits its entire report on stdout.
    need(stdout == report, 'actual complete comparer stdout/report differ')
    need(checked(execution['stderr']).stat().st_size == 0, 'unexpected comparison stderr')
    ledger_names = {'mismatches', 'required-boundaries', 'optional-context', 'inside-prerequisites', 'Native-selected-boundaries'}
    need(set(report['full_gzip_ledgers']) == ledger_names, 'all five complete compressed ledgers required')
    reviews = [load(packet[k]) for k in ['Root_factual_review', 'independent_factual_review']]
    root_review, peer_review = reviews
    need(root_review['schema'] == 'ctf10-main-thread-comparison-Root-full-factual-review.v1' and root_review['full_all_five_ledgers_read'] is True and root_review['stream_custody_failure'] is None, 'full Root factual ledger review required')
    need(peer_review['schema'] == 'ctf10-ordinary-main-thread-comparison-factual-review.v1' and peer_review['all_five_ledgers_full_hash_JSON_and_gzip_integrity_accepted'] is True and peer_review['all_235456_mismatch_values_independently_joined_to_actual_both_side_owners'] is True and peer_review['all_1340_pair_clock_identity_and_actual_scope_return_joins_verified'] is True and peer_review['scientific_PASS_claimed'] is False and peer_review['whole_ordinary_PASS_claimed'] is False, 'full independent factual ledger/owner review required')
    for review in reviews:
        need(review['accepted'] is True and review['gates_updated'] is False, 'both complete independent factual reviews required')
        same(review['actual_comparison'], packet['comparison']); same(review['actual_execution'], packet['comparison_execution'])
    need(root_review['comparison_counts'] == report['comparison_counts'] and root_review['boundary_counts'] == report['boundary_counts'] and set(root_review['ledgers']) == ledger_names, 'full Root review/report/count joins differ')
    need(set(peer_review['ledger_rows']) == set(peer_review['ledger_decoded_bytes']) == set(peer_review['ledger_decoded_sha256']) == ledger_names, 'complete independent five-ledger witnesses required')
    for name, row in root_review['ledgers'].items():
        need(row == {'records': peer_review['ledger_rows'][name], 'decoded_bytes': peer_review['ledger_decoded_bytes'][name], 'decoded_sha256': peer_review['ledger_decoded_sha256'][name]}, 'independent complete decoded ledger SHA/size/count reviews differ')
    need(peer_review['mismatches'] == root_review['ledgers']['mismatches']['records'] == report['comparison_counts']['mismatches'] and peer_review['paired'] == report['boundary_counts']['paired'] and peer_review['required_unavailable_or_unmatched'] == report['boundary_counts']['required_unavailable_or_unmatched'] > 0, 'factual failure ledger counts required')
    for name, row in report['full_gzip_ledgers'].items(): select(row, 'complete-opaque-gzip-ledger:' + name)
    for row in [prep_ref, packet_ref] + prep['own_sources'] + prep['fixed_evidence']: select(row, 'bounded-Source-or-proof')
    for role, row in packet.items():
        if role != 'schema': select(row, 'actual-' + role)
    need(checked(report['frozen_policy']).read_bytes() == checked(prep['prospective_policy']).read_bytes(), 'historical frozen policy must remain literal accepted policy02')
    for row in [execution['stdout'], execution['stderr'], report['frozen_policy'], report['actual_Native_freeze'], report['historical_policy_freeze']['request'], report['historical_policy_freeze']['execution']]: select(row, 'actual-comparison-or-historical-freeze-metadata')
    for row in comparer['own_sources'] + [comparer['README'], comparer['author_source']]: select(row, 'reviewed-comparer-Source')
    for row in comparer['source_correspondence']:
        for key in ['before', 'proposal', 'exact_diff']: select(row[key], 'exact-comparer-Source-correspondence')
    for row in report['Native_QA'].values(): select(row, 'released-OriginalDataQA-metadata')
    for source_review in [prep['Root_Source_review'], prep['independent_Source_review']]:
        review = load(source_review)
        need(review.get('accepted') is True or review.get('status') == 'accepted-source-only', 'both actual comparer Source acceptances required')
        same(review.get('Source_preparation', review.get('reviewed_preparation')), prep['reviewed_comparer_preparation'])
        select(source_review, 'actual-comparer-Source-review')
    for row in [prep['previous_CLI_summary'], prep['previous_Native_summary']]: select(row, 'explicit-prior-published-provenance')
    for path, row in list(SEEN.items()): need(full(path) == row, 'bounded artifact changed before publication')
    need(not OUT.exists(), 'fresh canonical evidence directory required')
    objects = OUT / 'objects/raw'; objects.mkdir(parents=True)
    rows = []
    for path in sorted(ROLES):
        original = SEEN[path]; target = objects / original['sha256']
        if not target.exists():
            with path.open('rb') as source, target.open('xb') as sink: shutil.copyfileobj(source, sink, 1024 * 1024)
        stored = full(target); need(stored['sha256'] == original['sha256'] and stored['size_bytes'] == original['size_bytes'], 'full raw archive bytes differ')
        rows.append({'historical_path': original['path'], 'original': original, 'stored': stored, 'storage': 'raw-byte-exact', 'roles': sorted(ROLES[path])})
    for path, row in SEEN.items(): need(full(path) == row, 'bounded artifact changed during publication')
    manifest = {'schema': 'ctf10-main-thread-history-selected-archive.v1', 'objects': rows, 'all_selected_bytes_stored_exact': True, 'recursive_ancestry_collected': False, 'whole_Source_snapshot_payloads_published': False, 'large_original_stream_payloads_published': False}
    def write(path, value):
        with path.open('x', encoding='utf8', newline='\n') as stream: json.dump(value, stream, ensure_ascii=False, allow_nan=False, indent=2); stream.write('\n')
    write(OUT / 'manifest.json', manifest)
    summary = {'schema': 'ctf10-main-thread-history-comparison-evidence.v1', 'status': report['status'], 'actual_comparison': packet['comparison'], 'actual_execution': packet['comparison_execution'], 'actual_factual_reviews': {k: packet[k] for k in ['Root_factual_review', 'independent_factual_review']}, 'actual_comparison_Source_snapshot': report['actual_comparison_Source_snapshot'], 'actual_comparison_Source_members': report['actual_comparison_Source_members'], 'comparison_counts': report['comparison_counts'], 'boundary_counts': report['boundary_counts'], 'full_gzip_ledgers': report['full_gzip_ledgers'], 'selected_archive': full(OUT / 'manifest.json'), 'previous_CLI_evidence': prep['previous_CLI_summary'], 'previous_released_Native_evidence': prep['previous_Native_summary'], 'Native_stream_provenance_only': report['actual_Native_results'], 'Rust_stream_provenance_only': report['actual_Rust_events'], 'large_stream_storage_scope': 'Full hash/size provenance retained; large original streams are not copied or revalidated by this bounded publisher. Their released custody and availability statements remain in the prior published CLI/Native evidence.', 'event_or_ledger_values_parsed_by_publisher': False, 'full_ledger_compressed_bytes_published': True, 'selected_closure_transitively_replayable': False, 'whole_Source_or_stream_payloads_published': False, 'numerical_PASS_claimed': False, 'integration_PASS_claimed': False, 'gates_updated': False}
    write(OUT / 'summary.json', summary)
    print(json.dumps({'summary': full(OUT / 'summary.json'), 'manifest': full(OUT / 'manifest.json'), 'status': report['status'], 'selected_rows': len(rows), 'stored_objects': len(list(objects.iterdir()))}))
    return 0


if __name__ == '__main__':
    sys.exit(main())

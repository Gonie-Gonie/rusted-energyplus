import difflib
import hashlib
import json
from pathlib import Path
ROOT=Path.cwd(); HERE=ROOT/'.runtime/porting/CTF-10/ordinary-history-comparison-prep-04'
seen=set(); checks=0; ranges=0
def ref(path):
    raw=path.read_bytes(); return dict(path=path.relative_to(ROOT).as_posix(),sha256=hashlib.sha256(raw).hexdigest(),size_bytes=len(raw))
def checked(row):
    global checks
    raw=(ROOT/row['path']).read_bytes(); assert hashlib.sha256(raw).hexdigest()==row['sha256']
    assert 'size_bytes' not in row or len(raw)==row['size_bytes']
    assert 'line_count' not in row or len(raw.splitlines())==row['line_count']
    seen.add((row['path'],row['sha256'])); checks+=1; return raw
def collect(value):
    global ranges
    if isinstance(value,dict):
        if {'path','sha256'}<=value.keys(): checked(value)
        if 'source' in value and ('start_line' in value or 'first_line' in value):
            raw=checked(value['source']); start=value.get('start_line',value.get('first_line')); end=value.get('end_line',value.get('last_line'))
            chunk=b''.join(raw.splitlines(True)[start-1:end])
            if 'archive' in value: assert checked(value['archive'])==chunk
            else: assert hashlib.sha256(chunk).hexdigest()==value['sha256'] and len(chunk)==value['size_bytes']
            ranges+=1
        for key,child in value.items():
            if key!='historical_source': collect(child)
    elif isinstance(value,list):
        for child in value: collect(child)
mref=ref(HERE/'manifest.json'); assert mref['sha256']=='201953b343269271d185aef6bfc2b455c99fb2c0785268bb9e7f6a37bebb826b'

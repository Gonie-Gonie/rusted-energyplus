"""Compare full genuine ordinary boundary streams under one prospective policy."""
import argparse
from contextlib import ExitStack
from datetime import datetime, timezone
import difflib
import gzip
import hashlib
import importlib.util
import json
from pathlib import Path

PREP = Path(__file__).resolve().parent
ROOT = PREP.parents[3]
COMMON = ROOT / '.runtime/porting/CTF-10/thermal-history-unit-comparison-prep-01/history_unit_common.py'
PRIMITIVES = COMMON.with_name('compare_units.py')
POLICY = {'path': '.runtime/porting/CTF-10/ordinary-history-pairing-policy-prep-02/manifest.json',
          'sha256': '5e59c6e3e73d840e982f79fee676033919c353e3ce4b35295385349ea9b31031'}
EXPORTER_SHA = '0754e521a9bbc6eac7a26aa96bc5865626343a9df011cce21a6e984c09ae879e'
RECORDER_SHA = '5745ad9809e196af00b858fcdc0d3d783531628fa2abf1e086f75c7d293514ba'
CONFIG = ['--config', 'profile.dev.debug=0', '--config', 'profile.test.debug=0',
          '--config', 'build.incremental=false', '--locked']
QUALITY = {'fmt_check': ['cargo', 'fmt', '--all', '--', '--check'],
    'clippy': ['cargo', 'clippy', *CONFIG, '--workspace', '--all-targets', '--', '-D', 'warnings'],
    'focused': ['cargo', 'test', *CONFIG, '-p', 'ep_runtime', '--lib', 'heat_balance::'],
    'workspace': ['cargo', 'test', *CONFIG, '--workspace']}
BUILD = ['cargo', 'build', *CONFIG, '-p', 'ep_run', '--example', 'ctf10_ordinary_history_observer',
         '--message-format=json-render-diagnostics']
EVENT_KEYS = set('schema record_type boundary rust_local_generation_id caller_clock begin_timestep_seconds_argument outdoor_dry_bulb_c owner public model_catalog consumer_surfaces selected_inputs selected_context update_route error counted_as_PASS'.split())
LARGE = []


def boot(path, digest, name):
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise ValueError('Reviewed Source differs before import: ' + str(path))
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    return module


def current_recorded(c, m, ref, allowed_exit=(0,)):
    value = c.recorded(m, ref, large_stdout=True, allowed_exit=allowed_exit)
    LARGE.append(value['stdout'])
    m.require(value['executed_launcher']['archive']['sha256'] == RECORDER_SHA, 'Reviewed current recorder required')
    return value


def rust_stream(m, pair, path, execution, optional):
    header = summary = None; generations = set(); events = 0
    with path.open('rb') as handle:
        for line_number, raw in enumerate(handle, 1):
            m.require(raw.endswith(b'\n') and len(raw) > 1, 'Complete nonblank actual NDJSON record required')
            row = json.loads(raw, object_pairs_hook=m.unique_object,
                             parse_constant=lambda token: m.require(False, 'No non-JSON number'))
            m.require(type(row) is dict and row.get('counted_as_PASS') is False and summary is None,
                      'Complete ordered actual NDJSON object before footer required')
            kind = row.get('record_type')
            if header is None:
                m.require(line_number == 1 and kind == 'header' and row['schema'] == 'ctf10-persistent-ordinary-history-stream.v1' and
                          row['expected_endpoints_read'] is False and row['Native_prestate_replayed'] is False and
                          row['all_instrumented_lifecycle_visits_without_caps_or_filters'] is True and
                          row['absent_lifecycle_is_not_observed_or_assumed_reached'] is True, 'Actual uncapped ordinary header required')
                header = row
            elif kind == 'generation':
                gid = row['rust_local_generation_id']
                m.require(row['schema'] == 'ctf10-persistent-ordinary-generation.v1' and type(gid) is int and
                          gid == len(generations) + 1 and gid not in generations, 'Actual unique ordered Rust-local generation required')
                generations.add(gid)
                optional.write(pair.c.line(row) + b'\n')
            elif kind == 'event':
                m.require(row['schema'] == 'ctf10-persistent-ordinary-history-event.v1' and set(row) == EVENT_KEYS and
                          row['rust_local_generation_id'] in generations and type(row['owner']) is dict and
                          set(row['owner']) == set('initialized current_clock last_committed_clock failure history heat_transfer_groups opaque_groups all_heat_transfer_surfaces'.split()),
                          'Complete actual borrowed event/owner inventory required')
                events += 1; pair.rust_visit(row)
            elif kind == 'summary':
                m.require(row['schema'] == 'ctf10-persistent-ordinary-history-stream.v1', 'Actual ordinary footer schema differs'); summary = row
            else: m.require(False, 'Unknown actual NDJSON record')
    m.require(header is not None and summary is not None and summary['capture_complete'] is True and
              summary['actual_written_event_count'] == summary['actual_observed_event_count'] == events and
              summary['actual_Rust_generation_count'] == len(generations) and
              summary['actual_runtime_exit_code'] == execution['exit_code'] and
              all(summary[name] is False for name in ['boundary_reachability_verified', 'numerical_comparison_performed', 'integration_PASS_claimed']),
              'Full actual IO footer/counts/runtime exit required; no inferred reachability')
    return {'header': header, 'summary': summary, 'records': line_number}


def run(args):
    c = boot(COMMON, '7808162aa42c0d06c3893acf325346c473455df993d2705ac1f7a3888f1dd74c', 'ordinary_existing_custody')
    m, shape, stream = c.modules()
    own_ref = m.argument(args.source_manifest); own = m.load(own_ref)
    m.require(Path.cwd().resolve() == ROOT and m.identity(__file__)['sha256'] == args.approved_source_sha256 and
              own['schema'] == 'ctf10-ordinary-history-comparison-source-preparation.v1', 'Reviewed own Source/cwd required')
    for row in own['own_sources']: m.bind(row)
    primitive = boot(PRIMITIVES, '1b915c830af575f5cb0792f9ddd627309397d3411a7005f93798f389c9c7dfcd', 'ordinary_existing_comparison')
    pair_module = boot(PREP / 'pair_history.py', own['own_sources'][1]['sha256'], 'ordinary_boundary_pairs')
    policy_preparation = m.load(POLICY); policy_ref = m.bind(policy_preparation['own_sources'][0]); policy = m.load(policy_ref)
    m.require(policy_preparation['final_exporter_Source_binding_available'] is True and policy_preparation['runtime_execution_authorized'] is False and
              policy['rust_exporter_source_manifest']['sha256'] == EXPORTER_SHA,
              'Exact prospectively reviewed policy required; this command is separately Root-authorized')
    original_refs, qa, original_execution, freeze, _, _ = c.original(m, args)
    custody = boot(PREP / 'main_thread_custody.py', own['own_sources'][2]['sha256'], 'ordinary_main_thread_custody')
    refs, request, execution, rust_ref = custody.candidate(c, m, args, qa, original_refs, freeze, policy_ref, own)
    output = m.contained(args.output_dir, existing=False)
    m.require(output.is_relative_to(m.CTF) and output != m.CTF and not output.exists(), 'Fresh contained comparison directory required')
    output.mkdir(parents=True, exist_ok=False)
    names = ['mismatches', 'required-boundaries', 'optional-context', 'inside-prerequisites']
    stream_failure = None; native_counts = rust_counts = None
    with ExitStack() as stack:
        handles = {name: stack.enter_context(gzip.open(output / (name + '.ndjson.gz'), 'xb')) for name in names}
        spool = stack.enter_context((output / 'Native-selected-boundaries.ndjson.gz').open('x+b'))
        arithmetic_names = [row[0] for family in ['normal_histories', 'master_histories', 'scratch', 'flux_reports']
                            for row in policy['field_profiles'][family]['pairs']]
        profiles = {'real_profiles_by_owner': {name: dict(policy['scalar_rules']['finite_arithmetic']) for name in arithmetic_names}}
        cmp = primitive.Comparison(m, shape, profiles, handles['mismatches'])
        pair = pair_module.Pairing(c, shape, cmp, policy, handles['required-boundaries'], handles['optional-context'], handles['inside-prerequisites'], spool)
        try:
            m.require(rust_ref['size_bytes'] <= policy['full_stream_contract']['resource_bound_bytes'],
                      'Retained full Rust stream exceeds prospective4GiB factual-reader resource bound; no truncation or shortening')
            native_counts = c.review_stream(m, shape, stream, qa, pair.native_visit); spool.flush()
            rust_counts = rust_stream(m, pair, Path(rust_ref['path']), execution, handles['optional-context'])
            proof = request['actual_capture_custody']
            m.require(rust_counts['header'] == proof['actual_header'] and rust_counts['summary'] == proof['actual_footer'] and
                      rust_counts['records'] == proof['physical_line_count'], 'Complete parsed stream must equal accepted IO custody')
            pair.finish()
        except (ValueError, KeyError, TypeError, IndexError, OSError, UnicodeError) as error:
            stream_failure = str(error); pair.issue(stream_failure, 'full-stream-custody', None)
        if execution['exit_code'] != 0: pair.issue('Actual ordinary runtime/observer returned nonzero', 'Rust', execution['exit_code'])
        if not pair.counts['Rust_selected_stages']: pair.issue('No required Rust selected lifecycle visits observed', 'Rust', None)
        if not pair.counts['Native_selected_stages']: pair.issue('No required Native selected lifecycle visits observed', 'Native', None)
        if any(value['nonfinite_unverified'] for value in cmp.profiles.values()):
            pair.issue('Required arithmetic owner has nonfinite unverified cells', 'paired-numeric', None)
    custody.recheck(c, m)
    for ref in LARGE: c.large(m, ref)
    m.recheck()
    ledgers = {name: m.identity(output / (name + '.ndjson.gz'), max_bytes=(output / (name + '.ndjson.gz')).stat().st_size)
               for name in names + ['Native-selected-boundaries']}
    passed = stream_failure is None and cmp.counts['mismatches'] == 0 and pair.counts['required_unavailable_or_unmatched'] == 0
    report = {'schema': 'ctf10-persistent-ordinary-history-comparison.v1', 'status': 'pass-selected-paired-boundaries' if passed else 'fail-retained-mismatch-or-required-unavailable',
        'reviewed_comparer_preparation': own_ref, 'prospective_pairing_policy_preparation': POLICY, 'frozen_policy': request['observation_policy'],
        'Native_QA': original_refs, 'actual_Native_results': qa['reviewed_results'], 'actual_Native_freeze': qa['actual_packet_freeze'],
        'actual_invocation': refs, 'actual_Rust_events': rust_ref, 'actual_Source_snapshot': request['Source_snapshot'],
        'actual_applied_source_inventory': request['actual_applied_source_inventory'], 'actual_quality_executions': request['quality_executions'],
        'actual_main_thread_validation': request['actual_validation'], 'actual_main_thread_execution_custody': request['actual_execution_custody'],
        'historical_policy_freeze': request['historical_policy_freeze'], 'new_pre_run_policy_copy_claimed': False,
        'captured_Source_validated_from_immutable_archives': True,
        'actual_comparison_Source_snapshot': request['actual_comparison_Source_snapshot'],
        'actual_comparison_Source_members': request['actual_comparison_Source_members'],
        'actual_native_stream_review': native_counts, 'actual_rust_stream_review': rust_counts, 'stream_custody_failure': stream_failure,
        'boundary_counts': dict(pair.counts), 'comparison_counts': dict(cmp.counts), 'real_profiles': cmp.profiles, 'full_gzip_ledgers': ledgers,
        'selected_paired_boundary_comparison_passed': passed, 'all_unmatched_and_mismatches_retained_without_cap': stream_failure is None,
        'Native_only_context_or_Rust_generation_counted_as_PASS': False, 'inside_equation_per_iteration_PASS_claimed': False,
        'whole_manager_PASS_claimed': False, 'integration_PASS_claimed': False, 'full_card_gates_updated': False,
        'reviewed_utc': datetime.now(timezone.utc).isoformat()}
    m.emit(output / 'comparison.json', report); print(json.dumps(report, ensure_ascii=False, allow_nan=False, indent=2))
    return 0 if passed else 1


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['source-manifest', 'approved-source-sha256', 'original-data-review', 'original-data-review-execution',
                 'production-packet', 'comparison-source-snapshot', 'rust-events', 'output-dir']:
        parser.add_argument('--' + name, required=True)
    raise SystemExit(run(parser.parse_args()))

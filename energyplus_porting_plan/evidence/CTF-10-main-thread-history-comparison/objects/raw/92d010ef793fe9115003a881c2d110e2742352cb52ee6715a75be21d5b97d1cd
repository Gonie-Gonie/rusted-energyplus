"""Source-only recorder archive byte join; preserve the actual failed publication attempt."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/CTF-10'
OLD = BASE / 'main-thread-history-publication-prep-02'
NEW = BASE / 'main-thread-history-publication-prep-03'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


old = (OLD / 'publish.py').read_bytes()
left = b"same(execution['executed_launcher']['archive'], prep['recorder_Source'])"
right = b"need(checked(execution['executed_launcher']['archive']).read_bytes() == checked(prep['recorder_Source']).read_bytes(), 'actual archived recorder bytes differ from accepted Source')"
assert old.count(left) == 1
new = old.replace(left, right, 1)
assert new.replace(right, left, 1) == old
ast.parse(new)
before = write(NEW / 'before/publish.py', old)
source = write(NEW / 'publish.py', new)
diff = write(NEW / 'diffs/publish.py.diff', ''.join(difflib.unified_diff(old.decode().splitlines(True), new.decode().splitlines(True), fromfile=before['path'], tofile=source['path'])).encode())
readme = (OLD / 'README.md').read_bytes().replace(b'publication-prep-02/', b'publication-prep-03/')
readme += b'\nSuccessor03 preserves the actual failed publication01 receipt and02 Source. The one runtime change compares the archived recorder and canonical accepted recorder by authenticated byte equality, allowing their intentionally different paths. All other identity joins retain exact physical identity; input/policy/ledger/selection and scientific semantics are unchanged. This publisher has not been executed during authoring.\n'
doc = write(NEW / 'README.md', readme)
manifest = json.loads((OLD / 'manifest.json').read_bytes())
failed = BASE / 'main-thread-history-publication-command-01/receipt.json'
assert ref(failed)['sha256'] == '08e209041b6cc6627081bd1f2f3d6733629068a79da1b4770346bb50c738b191'
receipt = json.loads(failed.read_bytes())
assert receipt['exit_code'] == 1 and receipt['source_bytes_match_before_and_after'] is True
manifest.update(parent_Source_preparation=ref(OLD / 'manifest.json'), own_sources=[source, doc, ref(Path(__file__)), before, diff], exact_source_correspondence=dict(before=before, proposal=source, exact_diff=diff), retained_failed_publication_execution=ref(failed))
manifest['runtime_interfaces'] = dict(manifest['runtime_interfaces'], publisher=source)
manifest['fixed_evidence'] += [ref(OLD / name) for name in ['manifest.json', 'publish.py', 'README.md']] + [ref(BASE / 'seal-main-thread-history-publication-02.py'), ref(failed)] + [ref(ROOT / receipt[k]['path']) for k in ['stdout', 'stderr']]
print(json.dumps(write(NEW / 'manifest.json', (json.dumps(manifest, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())))

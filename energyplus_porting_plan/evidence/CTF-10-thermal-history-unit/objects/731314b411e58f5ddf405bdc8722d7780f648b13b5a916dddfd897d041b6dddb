"""Root losslessly archives complete actual direct-unit inputs and Rust output."""
import gzip,hashlib,json,shutil
from pathlib import Path
ROOT=Path.cwd();BASE=ROOT/'.runtime/porting/CTF-10';OUT=ROOT/'energyplus_porting_plan/evidence/CTF-10-thermal-history-unit'
def read(p):return json.loads(p.read_bytes())
def sha(p):
 with p.open('rb')as s:return hashlib.file_digest(s,'sha256').hexdigest()
def ref(p):return {'path':p.relative_to(ROOT).as_posix(),'sha256':sha(p),'size_bytes':p.stat().st_size}
report_path=BASE/'thermal-history-unit-comparison-01/comparison.json';report=read(report_path)
assert report['all_actual_events_and_projected_cases_consumed']and report['full_input_SHA_externally_verified']and not report['sampling_or_event_caps_used']
receipt=read(BASE/'thermal-history-unit-comparison-command-01/receipt.json')
assert receipt['exit_code']in(0,1)and receipt['launch_error']is None and receipt['source_bytes_match_before_and_after']
assert not OUT.exists();(OUT/'observations').mkdir(parents=True);rows=[]
for role,row in [('complete_projected_inputs',report['reviewed_input_cases']),('complete_actual_Rust_results',report['Rust_results'])]:
 source=ROOT/row['path'];before=ref(source);assert before==row
 dest=OUT/'observations'/(before['sha256']+'.ndjson.gz')
 with source.open('rb')as src,dest.open('xb')as dst:
  with gzip.GzipFile(filename='',mode='wb',compresslevel=6,fileobj=dst,mtime=0)as packed:shutil.copyfileobj(src,packed,16*1024*1024)
 digest=hashlib.sha256();count=0
 with gzip.open(dest,'rb')as stream:
  while chunk:=stream.read(16*1024*1024):digest.update(chunk);count+=len(chunk)
 assert digest.hexdigest()==before['sha256']and count==before['size_bytes']and ref(source)==before
 rows.append({'role':role,'original':before,'stored':ref(dest),'compression':'gzip','full_decompressed_sha256':digest.hexdigest(),'full_decompressed_size_bytes':count,'all_original_bytes_retained':True,'original_file_retained':True})
 print('Root complete thermal observation losslessly archived',role,ref(dest),flush=True)
record={'schema':'ctf10-thermal-history-lossless-direct-unit-observations.v1','actual_comparison':ref(report_path),'files':rows,'numerical_values_modified_or_recomputed':False,'numerical_PASS_produced_by_storage_operation':False,'gates_updated':False}
record_dir=BASE/'thermal-history-observation-archive-01';record_dir.mkdir();(record_dir/'record.json').write_bytes((json.dumps(record,indent=2,allow_nan=False)+'\n').encode('utf8'))

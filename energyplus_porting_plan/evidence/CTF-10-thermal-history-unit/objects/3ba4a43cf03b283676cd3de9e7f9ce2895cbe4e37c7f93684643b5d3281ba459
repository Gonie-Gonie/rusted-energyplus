+def state(event, need):
+    """Transpose complete actual owners only; never evaluate a history equation."""
+    context = event['history_entry_context'] if event['checkpoint'] == 'history_update_entry_owners' else event['history_boundary_context']
+    ids = [row['index'] for row in context['allocated_surfaces']]; total = context['TotSurfaces']
+    need(total > 0 and ids == list(range(1, total + 1)), 'Complete nonempty actual allocated layout required')
+    rows = event['owners'] + context['non_AllHT_history_owners']
+    by_id = {row['surface_index']: row for row in rows}
+    need(len(by_id) == len(rows) == total and set(by_id) == set(ids), 'All actual history columns required')
+    def matrix(name):
+        flags = [by_id[index][name]['allocated'] for index in ids]
+        if not any(flags): return None
+        need(all(flags), 'Mixed history allocation is unrepresentable')
+        out = [[] for _ in range(19)]
+        for index in ids:
+            value = by_id[index][name]
+            need(value['lower'] == 1 and value['upper'] == 19 and len(value['terms']) == 19, 'Actual full19 bounds required')
+            for position, term in enumerate(value['terms']):
+                need(term['term'] == position + 1 and term['surface_allocated'] is True and
+                     term['surface_lower'] == 1 and term['surface_upper'] == total and term['value'] is not None,
+                     'Actual complete allocated history row required')
+                out[position].append(term['value'])
+        return out
+    def vector(value):
+        if value['allocated'] is False: return None
+        need(value['lower'] == 1 and value['upper'] == total and [row['index'] for row in value['values']] == ids,
+             'Full actual vector bounds/order required')
+        return [row['value'] for row in value['values']]
+    normal = {name: matrix(name) for name in HISTORIES}
+    need(all(value is not None for value in normal.values()), 'Required actual normal histories absent')
+    masters = {name: matrix(name) for name in MASTERS}; counters = vector(context['SurfCurrNumHist'])
+    for position, index in enumerate(ids):
+        need(by_id[index]['SurfCurrNumHist'] == (None if counters is None else counters[position]), 'Same-owner counter copies differ')
+    if counters is None and all(value is None for value in masters.values()): masters = None
+    else:
+        need(counters is not None and all(value is not None for value in masters.values()), 'Joint master/counter allocation required')
+        masters['SurfCurrNumHist'] = counters
+    scratch = {name: vector(context['scratch'][name]) for name in SCRATCH}
+    if all(value is None for value in scratch.values()): scratch = None
+    else: need(all(value is not None for value in scratch.values()), 'Partial scratch allocation is unrepresentable')

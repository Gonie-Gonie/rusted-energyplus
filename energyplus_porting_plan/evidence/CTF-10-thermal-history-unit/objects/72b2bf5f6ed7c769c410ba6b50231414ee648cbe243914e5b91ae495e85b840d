+fn history(owners: &[&Value], name: &str, total: usize) -> Result<Option<[Vec<f64>; 19]>> {
+    let flags = owners.iter().map(|row| boolean(&row[name]["allocated"])).collect::<Result<Vec<_>>>()?;
+    if flags.iter().all(|flag| !flag) {
+        for row in owners {
+            keys(&row[name], &["allocated", "terms"])?;
+            need(row[name]["terms"].is_null(), "unallocated history terms must stay null")?;
+        }
+        return Ok(None);
+    }
+    need(flags.iter().all(|flag| *flag), "partially allocated history cannot become a complete owner")?;
+    let mut out: [Vec<f64>; 19] = std::array::from_fn(|_| Vec::with_capacity(total));
+    for row in owners {
+        let source = &row[name];
+        keys(source, &["allocated", "lower", "upper", "terms"])?;
+        need(integer(&source["lower"])? == 1 && integer(&source["upper"])? == 19 && rows(&source["terms"] )?.len() == 19,
+            "all19 actual history terms required")?;
+        for (term, value) in rows(&source["terms"] )?.iter().enumerate() {
+            keys(value, &["term", "surface_lower", "surface_upper", "surface_allocated", "value"])?;
+            need(index(&value["term"])? == term + 1 && integer(&value["surface_lower"])? == 1 &&

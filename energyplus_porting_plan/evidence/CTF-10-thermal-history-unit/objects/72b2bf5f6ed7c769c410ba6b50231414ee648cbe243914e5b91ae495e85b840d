+pub(super) fn prepare<'a>(event: &'a Value, operation: &str) -> Result<Prepared<'a>> {
+    let (checkpoint, procedure, context_key) = if operation == "initialize" {
+        ("history_selected_initialization_input", "InitThermalAndFluxHistories", "history_boundary_context")
+    } else {
+        need(operation == "update", "declared selected operation required")?;
+        ("history_update_entry_owners", "UpdateThermalHistories", "history_entry_context")
+    };
+    keys(event, &["event_ordinal", "checkpoint", "copy_kind", "clock", "procedure", "invocation_ordinal",
+        "parent_procedure", "parent_invocation_ordinal", "locals", "owners", "counted_as_PASS", context_key, "current_history_catalog"])?;
+    need(event["checkpoint"] == checkpoint && event["procedure"] == procedure && event["copy_kind"] == 3 &&
+        event["counted_as_PASS"] == false && event["event_ordinal"].as_u64().is_some_and(|v| v > 0) &&
+        event["invocation_ordinal"].as_u64().is_some_and(|v| v > 0), "genuine selected input boundary required")?;
+    let context = &event[context_key];
+    let catalog = &event["current_history_catalog"];
+    need(context["protocol"] == "ctf10-surface-history-entry-context.v1" && boolean(&context["Surface_allocated"] )?,
+        "actual allocated history context required")?;
+    let total = index(&context["TotSurfaces"])?;
+    need(total > 0, "empty layout has no observed per-term allocation witness")?;
+    let surfaces = rows(&catalog["surfaces"])?;
+    need(surfaces.len() == total && rows(&context["allocated_surfaces"] )?.len() == total &&
+        index(&context["NumOfZones"])? == rows(&catalog["zones"] )?.len() &&
+        context["AllHTSurfaceList"] == catalog["AllHTSurfaceList"], "actual context/catalog layout differs")?;
+    let all = rows(&catalog["AllHTSurfaceList"] )?.iter().map(id).collect::<Result<Vec<_>>>()?;
+    need(all.iter().copied().collect::<BTreeSet<_>>().len() == all.len(), "duplicate AllHT identity")?;
+    let mut owners: BTreeMap<usize, &Value> = BTreeMap::new();
+    let all_owners = rows(&event["owners"])?;
+    need(all_owners.len() == all.len(), "complete AllHT histories required")?;
+    for (row, surface) in all_owners.iter().zip(&all) {
+        need(row["surface_index"].as_u64() == Some(u64::from(surface.0)), "AllHT history order differs")?;
+    }
+    for row in all_owners.iter().chain(rows(&context["non_AllHT_history_owners"] )?) {
+        let position = index(&row["surface_index"])?;
+        need(position > 0 && position <= total && owners.insert(position, row).is_none(), "history owner association differs")?;
+    }
+    need(owners.len() == total, "no full-layout history owner may be dropped")?;
+    let owners = owners.into_values().collect::<Vec<_>>();
+    let counters = vector(&context["SurfCurrNumHist"], total, integer)?;
+    for (position, row) in owners.iter().enumerate() {
+        need(row["SurfCurrNumHist"] == counters.as_ref().map_or(Value::Null, |values| json!(values[position])),
+            "independent same-owner counter copies differ")?;
+    }
+    let normal = arrays(&owners, total, "")?.ok_or_else(|| "required normal histories absent".to_owned())?;
+    let master_arrays = arrays(&owners, total, "Master")?;
+    let masters = match (master_arrays, counters) {
+        (None, None) => None,
+        (Some(arrays), Some(current_num_histories)) => Some(CtfThermalHistoryMasters { arrays, current_num_histories }),
+        _ => return Err("master/counter allocation is not jointly representable".to_owned()),
+    };
+    let scratch_names = ["QExt1", "QInt1", "TempInt1", "TempExt1", "SumTime"];
+    keys(&context["scratch"], &scratch_names)?;
+    let scratch_values = scratch_names.iter().map(|name| vector(&context["scratch"][*name], total, real)).collect::<Result<Vec<_>>>()?;
+    let scratch = if scratch_values.iter().all(Option::is_none) { None } else {
+        need(scratch_values.iter().all(Option::is_some), "partial scratch allocation cannot be filled")?;
+        let mut values = scratch_values.into_iter();
+        let mut next = || values.next().flatten().ok_or_else(|| "complete scratch owner required".to_owned());
+        Some(CtfThermalHistoryScratch { outside_flux_first: next()?, inside_flux_first: next()?,
+            inside_temperature_first: next()?, outside_temperature_first: next()?, sum_time: next()? })
+    };
+    let reports = &context["flux_reports"];
+    keys(reports, &["SurfOpaqInsFaceCond", "SurfOpaqInsFaceCondFlux", "SurfOpaqOutFaceCond", "SurfOpaqOutFaceCondFlux"])?;
+    let state = CtfThermalHistoryState {
+        surface_ids: (1..=total).map(|v| u32::try_from(v).map(SurfaceId).map_err(|_| "surface ID capacity".to_owned())).collect::<Result<Vec<_>>>()?,
+        normal, masters, scratch, update_first_time: boolean(&event["clock"]["UpdateThermalHistoriesFirstTimeFlag"] )?,
+        flux_reports: CtfThermalHistoryFluxReports { inside_conduction: required(&reports["SurfOpaqInsFaceCond"], total)?,
+            inside_flux: required(&reports["SurfOpaqInsFaceCondFlux"], total)?, outside_flux: required(&reports["SurfOpaqOutFaceCondFlux"], total)?,
+            outside_conduction: required(&reports["SurfOpaqOutFaceCond"], total)? },
+    };
+    for (position, surface) in surfaces.iter().enumerate() {
+        need(index(&surface["index"])? == position + 1, "complete declared surface order differs")?;
+        let witness = &context["allocated_surfaces"][position];
+        for key in ["index", "Name", "Construction", "Class", "HeatTransferAlgorithm", "ExtBoundCond", "Area"] {
+            need(surface[key] == witness[key], "current catalog/layout identity differs")?;
+        }
+    }
+    let spaces = rows(&catalog["spaces"])?;
+    let mut heat_transfer = Vec::new(); let mut opaque = Vec::new();
+    for (zone_position, zone) in rows(&catalog["zones"] )?.iter().enumerate() {
+        need(index(&zone["index"])? == zone_position + 1, "actual Zone order differs")?;
+        for space_index in rows(&zone["spaceIndexes"])? {
+            let number = index(space_index)?;
+            let space = number.checked_sub(1).and_then(|v| spaces.get(v)).ok_or("actual Space unavailable")?;
+            need(index(&space["index"])? == number, "actual Space identity differs")?;
+            for (first, last, out) in [("HTSurfaceFirst", "HTSurfaceLast", &mut heat_transfer),
+                ("OpaqOrIntMassSurfaceFirst", "OpaqOrIntMassSurfaceLast", &mut opaque)] {
+                let ids = (integer(&space[first])?..=integer(&space[last])?).map(|number| {
+                    need(number > 0 && usize::try_from(number).is_ok_and(|v| v <= total), "traversed surface outside allocated layout")?;
+                    Ok(SurfaceId(u32::try_from(number).map_err(|_| "traversal ID representation".to_owned())?))
+                }).collect::<Result<Vec<_>>>()?;
+                out.push(ids);
+            }
+        }
+    }
+    let mut construction_positions = BTreeMap::new(); let mut coefficients_values = Vec::new();
+    let mut expected = Vec::new();
+    for surface in &all {
+        let row = surfaces.get(usize::try_from(surface.0).map_err(|_| "surface ID representation")? - 1).ok_or("AllHT surface unavailable")?;
+        let construction = integer(&row["Construction"])?;
+        if !expected.contains(&construction) { expected.push(construction); }
+    }
+    let construction_rows = rows(&catalog["constructions"])?;
+    need(construction_rows.len() == expected.len(), "all referenced public owners required")?;
+    for (position, (row, expected_id)) in construction_rows.iter().zip(expected).enumerate() {
+        let actual_id = integer(&row["index"])?;
+        need(actual_id > 0 && actual_id == expected_id && construction_positions.insert(actual_id, position).is_none(),
+            "first current Construction encounter order differs")?;
+        coefficients_values.push(coefficients(row)?);
+    }
+    Ok(Prepared { state, inputs: Inputs { total, catalog, context_value: context, clock: &event["clock"], coefficients: coefficients_values,
+        construction_positions, heat_transfer, opaque, all } })
+}

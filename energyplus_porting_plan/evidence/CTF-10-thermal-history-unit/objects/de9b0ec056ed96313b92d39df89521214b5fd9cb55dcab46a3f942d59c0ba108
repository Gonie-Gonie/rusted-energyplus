"""Root installs accepted history math and observer after genuine Original QA/projection."""
import difflib,hashlib,json,shutil,subprocess
from pathlib import Path
ROOT=Path.cwd();BASE=ROOT/'.runtime/porting/CTF-10';RAW=BASE/'thermal-history-applied-source-01';FINAL=BASE/'thermal-history-applied-final-source-01'
def read(p):return json.loads(p.read_bytes())
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def ref(p):return {'path':p.relative_to(ROOT).as_posix(),'sha256':sha(p),'size_bytes':p.stat().st_size}
def write(p,v):p.write_bytes((json.dumps(v,ensure_ascii=False,indent=2,allow_nan=False)+'\n').encode('utf8'))
assert not RAW.exists()and not FINAL.exists()and not subprocess.check_output(['git','status','--porcelain'])
assert subprocess.check_output(['git','rev-parse','HEAD'])==subprocess.check_output(['git','rev-parse','@{upstream}'])
qa=BASE/'surface-consumer05-original-stages-02/original-data-review/review.json'
assert sha(qa)=='59b16aa6d6fa4f1417b98baa85a02a6e6942a28efc2c2ed8f1ac70f47145f82a'
assert read(qa)['Original_capture_custody_released']and not read(qa)['observation_integrity_failures']
projection=BASE/'thermal-history-projection-01/projection.json';projected=read(projection)
receipt=read(BASE/'thermal-history-projection-command-01/receipt.json')
assert receipt['exit_code']==0 and receipt['launch_error']is None and receipt['source_bytes_match_before_and_after']
assert projected['complete_actual_native_event_ledger_validated']and projected['Native_expected_endpoint_values_supplied']is False
assert projected['projected_case_count']>0 and sha(ROOT/projected['input_cases']['path'])==projected['input_cases']['sha256']
math=BASE/'thermal-history-prep-01/manifest.json';observer=BASE/'thermal-history-rust-observer-prep-01/manifest.json'
assert sha(math)=='343fb38575bdf76f6fc6d671fae06a03422384b9b920dde65c2553acddcf5c83'
assert sha(observer)=='202759a7affb854fbad35d9368d75fdfdb202de8376b5c7f96f29780842c1183'
rows=read(math)['own_sources'][:2]+read(observer)['own_observer_sources']
parent=read(observer)['minimal_parent_proposal']
rows.append({'source':parent['proposed'],'target':parent['target'],'before':parent['actual_current_before']})
assert len(rows)==5
for row in rows:
 assert sha(ROOT/row['source']['path'])==row['source']['sha256']
 destination=ROOT/row['target']
 if row['before']is None:assert not destination.exists()
 else:assert ref(destination)=={k:row['before'][k]for k in ['path','sha256','size_bytes']}
RAW.mkdir();FINAL.mkdir();actual=[]
for row in rows:
 destination=ROOT/row['target'];before=None
 if destination.exists():
  prior=RAW/'before'/row['target'];prior.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(destination,prior);before=ref(prior)
 destination.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(ROOT/row['source']['path'],destination)
 assert sha(destination)==row['source']['sha256']
 archive=RAW/row['target'];archive.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(destination,archive)
 actual.append({'canonical_path':row['target'],'accepted_held_source':row['source'],'actual_before_archive':before,'actual_literal_archive':ref(archive)})
write(RAW/'manifest.json',{'schema':'ctf10-thermal-history-actual-literal-source-application.v1','actual_sources':actual,'Root_and_other_author_FULL_literal_sources_accepted':True,'actual_Original_QA':ref(qa),'actual_input_projection':ref(projection),'old71_parent_not_installed':True,'current_ZON05_parent_preserved':True,'scientific_execution_claimed':False})
with(RAW/'format-orchestration.log').open('xb')as output:
 subprocess.run(['python','-X','utf8','-B','tools/porting/record_command.py','--output-dir',(BASE/'thermal-history-source-format-command-01').relative_to(ROOT).as_posix(),'--','cargo','fmt','--all'],check=True,stdout=output,stderr=subprocess.STDOUT)
formatter=read(BASE/'thermal-history-source-format-command-01/receipt.json');assert formatter['exit_code']==0 and formatter['launch_error']is None
final=[]
for row in actual:
 destination=ROOT/row['canonical_path'];literal=ROOT/row['actual_literal_archive']['path'];archive=FINAL/row['canonical_path'];archive.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(destination,archive)
 delta=FINAL/'format-diffs'/(row['canonical_path'].replace('/','__')+'.diff');delta.parent.mkdir(exist_ok=True)
 delta.write_bytes(''.join(difflib.unified_diff(literal.read_text(encoding='utf8').splitlines(keepends=True),destination.read_text(encoding='utf8').splitlines(keepends=True),fromfile='accepted-literal/'+row['canonical_path'],tofile='actual-formatted/'+row['canonical_path'])).encode('utf8'))
 final.append({**row,'actual_final_source':ref(archive),'format_correspondence_diff':ref(delta),'line_count':len(destination.read_bytes().splitlines())})
assert set(subprocess.check_output(['git','diff','--name-only','-z']).decode().split('\0')[:-1])<={row['canonical_path']for row in final}
write(FINAL/'manifest.json',{'schema':'ctf10-thermal-history-actual-formatted-source-inventory.v1','actual_sources':final,'accepted_literal_application':ref(RAW/'manifest.json'),'actual_formatter_execution':ref(BASE/'thermal-history-source-format-command-01/receipt.json'),'Root_and_other_author_FULL_formatter_correspondence_accepted':False,'quality_or_candidate_execution_claimed':False,'gates_updated':False})
print('Actual accepted five thermal Source bodies installed/formatted; final delta review pending',ref(FINAL/'manifest.json'),flush=True)

class Comparison:
    def __init__(self, need):
        self.need = need
        self.profiles = FROZEN_PROFILES
        self.counts = Counter()
        self.samples = []
        self.unavailable = []
        self.metrics = {key: {"count": 0, "maximum_absolute_error": 0.0, "norm": 0.0,
                              "nonfinite_error_count": 0} for key in VARIABLES}

    def failure(self, path, category, native, rust):
        self.counts["mismatches"] += 1
        self.counts[category] += 1
        if len(self.samples) < 1000:
            self.samples.append({"path": path, "category": category, "Native": native, "Rust": rust})

    def exact(self, path, native, rust):
        self.counts["discrete_comparisons"] += 1
        if type(native) is not type(rust) or native != rust:
            self.failure(path, "discrete_mismatches", native, rust)

    def absence(self, path, native_available, rust_available, required, reason):
        self.unavailable.append({"path": path, "Native_available": native_available, "Rust_available": rust_available,
                                 "required": required, "reason": reason, "counted_as_PASS": False})
        if required:
            self.failure(path, "availability_failures", native_available, rust_available)

    def dto(self, row):
        self.need(isinstance(row, dict) and set(row) == {"value", "value_bits", "value_class"}, "Actual complete binary64 DTO required")
        bits = row["value_bits"]
        self.need(isinstance(bits, str) and len(bits) == 16 and all(c in "0123456789abcdef" for c in bits), "Actual binary64 bits required")
        word = int(bits, 16)
        value = struct.unpack(">d", word.to_bytes(8, "big"))[0]
        kind = "nan" if math.isnan(value) else ("negative_infinity" if word >> 63 else "positive_infinity") if math.isinf(value) else (
            "negative_zero" if word >> 63 else "positive_zero") if value == 0 else "finite"
        self.need(row["value_class"] == kind, "Actual binary64 class differs from its bits")
        if math.isfinite(value):
            self.need(type(row["value"]) in (int, float) and struct.pack(">d", float(row["value"])).hex() == bits,
                      "Actual JSON scalar differs from its bits")
        else:
            self.need(row["value"] is None, "Observed nonfinite must retain bits/class and null JSON decimal")
        return value

    def number(self, path, profile, native, rust):
        left, right = self.dto(native), self.dto(rust)
        self.exact(path + "/class", native["value_class"], rust["value_class"])
        if left == 0.0 and right == 0.0:
            self.exact(path + "/signed_zero_bits", native["value_bits"], rust["value_bits"])
        if not (math.isfinite(left) and math.isfinite(right)):
            self.absence(path, True, True, True, "actual nonfinite remains available; frozen policy supplies no nonfinite numerical PASS")
            return
        metric = self.metrics[profile]
        error = abs(left - right)
        metric["count"] += 1
        self.counts["numeric_comparisons"] += 1
        if not math.isfinite(error):
            metric["nonfinite_error_count"] += 1
        else:
            metric["maximum_absolute_error"] = max(metric["maximum_absolute_error"], error)
            metric["norm"] = math.hypot(metric["norm"], error)
        threshold = self.profiles[profile]["atol"] + self.profiles[profile]["rtol"] * abs(left)
        if error > threshold:
            self.failure(path, "numeric_mismatches", native, rust)

    def report(self):
        metrics = {}
        for key, metric in self.metrics.items():
            available = metric["count"] > 0 and metric["nonfinite_error_count"] == 0 and math.isfinite(metric["norm"])
            if metric["count"] == 0:
                self.absence("metrics/" + key, False, False, True, "no finite actual observations for this frozen profile")
            metrics[key] = {"count": metric["count"], "finite_metric_available": available,
                            "maximum_absolute_error": metric["maximum_absolute_error"] if available else None,
                            "RMSE": metric["norm"] / math.sqrt(metric["count"]) if available else None,
                            "nonfinite_error_count": metric["nonfinite_error_count"]}
        return {"numeric_comparisons": self.counts["numeric_comparisons"], "discrete_comparisons": self.counts["discrete_comparisons"],
                "mismatch_count": self.counts["mismatches"], "mismatch_categories": dict(self.counts), "metrics": metrics,
                "mismatch_samples": self.samples, "mismatch_samples_omitted": max(0, self.counts["mismatches"] - len(self.samples)),
                "unavailable_observations": self.unavailable, "unavailable_counted_as_PASS": False}


def exact_dto(c, path, left, right):
    c.dto(left); c.dto(right)
    c.exact(path + "/class", left["value_class"], right["value_class"])
    c.exact(path + "/bits", left["value_bits"], right["value_bits"])


def compare_snapshot(c, path, left, right, initial, computed):
    c.need(isinstance(right, dict) and set(right) == {"phase", "actual_context", "zone_fields", "moisture_source_terms",
        "SumLatentHTRadSys", "SumLatentPool", "nodes", "actual_node_row_count", "psychrometrics"}, "Actual complete Rust snapshot required")
    context_keys = "zone_id space_id zone_name Volume ZoneVolCapMultpMoist Multiplier ListMultiplier IsControlled IsReturnPlenum IsSupplyPlenum SystemZoneNodeNumber leakageParallelPIU_count ZoneAirSolutionAlgo RoomAirModel doSpaceHeatBalance DoLatentSizing AFN_control_type AFN_multizone_always_simulated AFN_FanActivated AFN_distribution_simulated DuctLossSimu FlagHybridModel OutBaroPress OutHumRat TimeStepSysSec TimeStepSys TimeStepZone inlet_node_ids".split()
    context = right["actual_context"]
    c.need(isinstance(context, dict) and set(context) == set(context_keys), "Actual Rust context shape differs")
    scalar_keys = "Volume ZoneVolCapMultpMoist OutBaroPress OutHumRat TimeStepSysSec".split()
    for key in context_keys:
        if key in scalar_keys:
            exact_dto(c, path + "/context/" + key, left[key], context[key])
        elif key in ["TimeStepSys", "TimeStepZone"]:
            clock = "system_timestep_hours" if key == "TimeStepSys" else "zone_timestep_hours"
            exact_dto(c, path + "/context/" + key, left["context"][clock], context[key])
        elif key == "inlet_node_ids":
            c.need(type(context[key]) is list and all(type(value) is int for value in context[key]), "Typed original inlet IDs required")
            c.exact(path + "/inlet_order", [row["node_id"] for row in left["inlet_order"]], context[key])
        else:
            c.exact(path + "/context/" + key, left[key], context[key])
    fields = right["zone_fields"]
    c.need(isinstance(fields, dict) and set(fields) == set(left["zone_fields"]), "All24 actual Rust fields required")
    for key, value in left["zone_fields"].items():
        label = path + "/zone_fields/" + key
        if type(value) is list:
            c.need(type(fields[key]) is list and len(value) == len(fields[key]) == 4, "All four actual slots required")
            for index, (a, b) in enumerate(zip(value, fields[key])): exact_dto(c, label + "/" + str(index), a, b)
        elif key == "airHumRatTemp" and computed:
            c.number(label, "airHumRatTemp", value, fields[key])
        else:
            exact_dto(c, label, value, fields[key])
    source = right["moisture_source_terms"]
    c.need(isinstance(source, dict) and set(source) == set(left["moisture_source_terms"]), "All actual source terms required")
    for key, value in left["moisture_source_terms"].items(): exact_dto(c, path + "/sources/" + key, value, source[key])
    for key in ["SumLatentHTRadSys", "SumLatentPool"]: exact_dto(c, path + "/" + key, left[key], right[key])
    nodes = right["nodes"]
    c.need(type(nodes) is list and len(nodes) == len(left["nodes"]) == len(initial["nodes"]), "Full actual Rust node shape required")
    c.exact(path + "/actual_node_row_count", left["NumOfNodes"], right["actual_node_row_count"])
    feedback = initial["SystemZoneNodeNumber"]
    for a, b in zip(left["nodes"], nodes):
        c.need(isinstance(b, dict) and set(b) == set(a), "Actual Rust node owner keys differ")
        label = path + "/node/" + str(a["node_id"])
        for key in ["node_id", "name"]: c.exact(label + "/" + key, a[key], b[key])
        for key in ["MassFlowRate", "Temp", "HumRat", "Enthalpy"]:
            if computed and feedback > 0 and a["node_id"] == feedback and key in ["HumRat", "Enthalpy"]:
                c.number(label + "/" + key, "SystemNode." + key, a[key], b[key])
            else:
                exact_dto(c, label + "/" + key, a[key], b[key])
    a, b = left["psychrometrics"], right["psychrometrics"]
    psych_scalars = "iconvTol last_Patm last_tBoil Press_Save tSat_Save".split()
    c.need(isinstance(b, dict) and set(b) == set(psych_scalars + ["warmup", "useInterpolationPsychTsatFnPb", "nondefault_Psat_rows",
        "Psat_cache_capacity", "other_actual_nondefault_cache_rows", "cache_hits_or_Native_internal_locals_observed", "Native_global_diagnostic_indices_or_backend_inferred"]),
        "Actual Rust psychrometric owner keys differ")
    for key in psych_scalars: exact_dto(c, path + "/psych/" + key, a[key], b[key])
    for key in ["useInterpolationPsychTsatFnPb", "Psat_cache_capacity"]: c.exact(path + "/psych/" + key, a[key], b[key])
    c.exact(path + "/psych/warmup", left["context"]["warmup"], b["warmup"])
    for key in ["cache_hits_or_Native_internal_locals_observed", "Native_global_diagnostic_indices_or_backend_inferred"]:
        c.exact(path + "/psych/" + key, False, b[key])
    other = b["other_actual_nondefault_cache_rows"]
    c.need(isinstance(other, dict) and set(other) == {"Twb", "TsatPb", "TsatHPb"} and all(type(row) is list for row in other.values()),
        "Actual other Rust cache owners remain unpaired context, never defaulted")
    a_rows, b_rows = a["nondefault_Psat_rows"], b["nondefault_Psat_rows"]
    c.need(type(b_rows) is list and len(a_rows) == len(b_rows), "Complete actual Psat row shape required")
    previous = -1
    for aa, bb in zip(a_rows, b_rows):
        c.need(isinstance(bb, dict) and set(bb) == {"index", "iTdb", "Psat"} and type(bb["index"]) is int and
            previous < bb["index"] < b["Psat_cache_capacity"] and type(bb["iTdb"]) is int, "Actual ordered cache indices/tags required")
        previous = bb["index"]
        c.need(bb["iTdb"] != -1000 or bb["Psat"]["value_bits"] != "0000000000000000", "Actual nondefault copied row required")
        c.exact(path + "/Psat/index", aa["index"], bb["index"]); c.exact(path + "/Psat/tag", aa["iTdb"], bb["iTdb"])
        if computed: c.number(path + "/Psat/" + str(aa["index"]), "psychrometrics.nondefault_Psat_rows.Psat", aa["Psat"], bb["Psat"])
        else: exact_dto(c, path + "/Psat/" + str(aa["index"]), aa["Psat"], bb["Psat"])


def retained_cache_bits(c, path, before, after, rust_before, rust_after):
    # Observe exact own retention only; never classify HIT/MISS or recompute tags.
    families = [{(row["index"], row["iTdb"]): row["Psat"] for row in owner["psychrometrics"]["nondefault_Psat_rows"]}
                for owner in [before, after, rust_before, rust_after]]
    for key in families[0].keys() & families[1].keys() & families[2].keys() & families[3].keys():
        a, b, x, y = [family[key] for family in families]
        if a["value_bits"] == b["value_bits"] or x["value_bits"] == y["value_bits"]:
            exact_dto(c, path + "/retained_Psat/" + str(key), x, y)
            exact_dto(c, path + "/retained_Native_Psat/" + str(key), a, b)


def compare_cases(native, rust, request, c):
    c.need(type(rust["cases"]) is list and len(native["cases"]) == len(rust["cases"]) == len(request["cases"]), "Complete ordered case ledger required")
    actual_calls = 0
    for expected, left, right in zip(request["cases"], native["cases"], rust["cases"]):
        c.need(isinstance(right, dict) and set(right) == {"case_id", "purpose", "admission_lane", "input", "prepared", "operations",
            "requested_operation_count", "actual_member_invocation_count", "all_requested_owners_available", "Native_warning_backend_or_outcome_inferred"}, "Exact actual Rust case keys required")
        path = expected["case_id"]; initial = expected["initial"]
        for key in ["case_id", "purpose", "admission_lane"]: c.exact(path + "/" + key, expected[key], right[key])
        c.exact(path + "/literal_input", expected, right["input"])
        c.exact(path + "/Native_backend_inferred", False, right["Native_warning_backend_or_outcome_inferred"])
        c.exact(path + "/prepared_phase", "after-declared-input-preparation-no-correction-call", right["prepared"]["phase"])
        compare_snapshot(c, path + "/prepared", left["prepared"], right["prepared"], initial, False)
        actual = right["operations"]
        c.need(type(actual) is list and 0 < len(actual) <= len(expected["operations"]), "Actual Rust invoked prefix required")
        c.exact(path + "/requested_operations", len(expected["operations"]), right["requested_operation_count"])
        c.exact(path + "/actual_invocations", len(actual), right["actual_member_invocation_count"])
        c.exact(path + "/complete_operations", len(left["operations"]), len(actual))
        c.exact(path + "/all_owners_available", True, right["all_requested_owners_available"])
        previous = right["prepared"]
        stopped = False
        for ordinal, (wanted, a, b) in enumerate(zip(expected["operations"], left["operations"], actual), 1):
            label = path + "/" + wanted["operation_id"]
            c.need(not stopped and isinstance(b, dict) and set(b) == {"operation_id", "operation", "actual_member_invocation_ordinal", "actual_source_invoked",
                "result", "before", "after", "history_selection_caller_invoked", "current_average_or_history_commit_invoked", "Native_internal_locals_or_guard_decisions_inferred"}, "Exact actual Rust call keys and no calls after typed stop required")
            for key in ["operation_id", "operation"]: c.exact(label + "/" + key, wanted[key], b[key])
            c.exact(label + "/invocation_ordinal", ordinal, b["actual_member_invocation_ordinal"])
            c.exact(label + "/source_invoked", True, b["actual_source_invoked"]); actual_calls += int(b["actual_source_invoked"] is True)
            c.exact(label + "/before_phase", "before-actual-correctHumRat", b["before"]["phase"])
            c.exact(label + "/after_phase", "after-actual-Rust-member-return", b["after"]["phase"])
            for key in ["history_selection_caller_invoked", "current_average_or_history_commit_invoked", "Native_internal_locals_or_guard_decisions_inferred"]:
                c.exact(label + "/" + key, False, b[key])
            result = b["result"]
            c.need(isinstance(result, dict) and set(result) == {"status", "owner_available", "unavailable", "zone_id", "system_node_written", "actual_Rust_saturation_property_call", "counted_as_PASS"} and
                type(result["owner_available"]) is bool and result["counted_as_PASS"] is False, "Actual typed Rust returned/unavailable owner required")
            available = result["owner_available"]
            c.need(available is (result["status"] == "source-returned") and result["status"] in ["source-returned", "typed-unavailable-returned"], "Actual result status/availability differs")
            if not available:
                c.need(isinstance(result["unavailable"], str) and all(result[key] is None for key in ["zone_id", "system_node_written", "actual_Rust_saturation_property_call"]), "Typed stop cannot contain fabricated returned fields")
                stopped = True
                c.absence(label, a["actual_source_return_observed"], False, True, "genuine typed Rust unavailable; required returned pair absent")
                continue
            c.need(result["unavailable"] is None, "Returned owner cannot contain unavailable error")
            c.exact(label + "/source_returned", True, a["actual_source_return_observed"])
            c.exact(label + "/zone_id", a["after"]["zone_id"], result["zone_id"])
            node = initial["SystemZoneNodeNumber"]
            c.exact(label + "/actual_system_node_written", node if node > 0 else None, result["system_node_written"])
            c.exact(label + "/persistent_owner", {k: v for k, v in previous.items() if k != "phase"}, {k: v for k, v in b["before"].items() if k != "phase"})
            compare_snapshot(c, label + "/before", a["before"], b["before"], initial, ordinal > 1)
            compare_snapshot(c, label + "/after", a["after"], b["after"], initial, True)
            for key in ["actual_context", "moisture_source_terms", "SumLatentHTRadSys", "SumLatentPool", "actual_node_row_count"]:
                c.exact(label + "/retained/" + key, b["before"][key], b["after"][key])
            for key in set(b["before"]["zone_fields"]) - {"airHumRatTemp"}:
                c.exact(label + "/retained/" + key, b["before"]["zone_fields"][key], b["after"]["zone_fields"][key])
            for old, new in zip(b["before"]["nodes"], b["after"]["nodes"]):
                for key in old:
                    if old["node_id"] != node or key not in ["HumRat", "Enthalpy"]: c.exact(label + "/retained_node/" + str(old["node_id"]) + "/" + key, old[key], new[key])
                if node > 0 and new["node_id"] == node: exact_dto(c, label + "/actual_feedback_W_assignment", b["after"]["zone_fields"]["airHumRatTemp"], new["HumRat"])
            retained_cache_bits(c, label, a["before"], a["after"], b["before"], b["after"])
            call = result["actual_Rust_saturation_property_call"]
            c.need(isinstance(call, dict) and set(call) == {"actual_Rust_property_result", "state_before", "state_after", "cache_before", "cache_after", "paired_as_Native_internal_Wsat_or_guard"} and
                call["paired_as_Native_internal_Wsat_or_guard"] is False, "Rust-only property custody cannot claim Native locals")
            c.dto(call["actual_Rust_property_result"])
            for phase in ["before", "after"]:
                observed = b[phase]["psychrometrics"]
                keys = "iconvTol last_Patm last_tBoil Press_Save tSat_Save warmup useInterpolationPsychTsatFnPb".split()
                state = call["state_" + phase]
                c.need(isinstance(state, dict) and set(state) == set(keys), "Complete actual Rust property state required")
                c.exact(label + "/Rust_property_state_" + phase, {key: observed[key] for key in keys}, state)
            c.need(call["cache_before"] is None and call["cache_after"] is None,
                "Actual WFromRh operation has no direct target slot; nested actual Psat rows are observed separately")
            previous = b["after"]
        if len(actual) != len(expected["operations"]): c.absence(path + "/required_requested_suffix", True, False, True, "stopped or omitted requested Rust calls never PASS")
    c.need(type(rust["actual_Rust_API_invocations"]) is int, "Typed actual Rust invocation aggregate required")
    c.exact("actual_Rust_API_invocations", actual_calls, rust["actual_Rust_API_invocations"])
    c.exact("complete_requested_owners_available", True, rust["complete_requested_owners_available"])


def boot(name, filename, digest):
    path = SUPPORT / filename
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest: raise ValueError("Reviewed reader dependency differs before import")
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    return module


def run(args):
    m = boot("zon05_compare_io", "packet_io.py", IO_SHA)
    shape = boot("zon05_compare_shape", "shape.py", SHAPE_SHA)
    own = m.bind(m.identity(__file__))
    m.require(Path.cwd().resolve() == m.ROOT and own["sha256"] == args.approved_source_sha256, "Root-reviewed source and repository cwd required")
    started = datetime.now(timezone.utc).isoformat()

    def same(a, b):
        m.require(m.contained(a["path"], existing=False) == m.contained(b["path"], existing=False) and a["sha256"] == b["sha256"], "Actual direct identities differ")

    def instant(value):
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00")); m.require(parsed.tzinfo is not None, "Aware actual UTC required"); return parsed

    def recorded(ref):
        value = m.load(ref)
        m.require(value["schema"] == "recorded-porting-command.v1" and type(value["exit_code"]) is int and value["exit_code"] == 0 and
                  value["launch_error"] is None and value["source_bytes_match_before_and_after"] is True and Path(value["cwd"]).resolve() == m.ROOT,
                  "Actual successful source-preserving repository command required")
        m.require(instant(value["started_utc"]) <= instant(value["finished_utc"]) <= instant(started), "Actual preceding command interval required")
        for key in ["stdout", "stderr", "source_snapshot"]: m.bind(value[key])
        m.require(value["executed_launcher"]["historical_path"] == "tools/porting/record_command.py", "Actual recorder source owner differs")
        m.bind(value["executed_launcher"]["archive"])
        return value

    refs = {name: m.argument(getattr(args, name.replace("-", "_"))) for name in [
        "original-data-review", "original-data-review-execution", "Rust-build-execution", "Rust-execution", "Rust-results"]}
    qa, qc = m.load(refs["original-data-review"]), recorded(refs["original-data-review-execution"])
    m.require(qa["schema"] == "zon05-independent-original-data-review.v1" and qa["status"] == "pass-actual-original-data-and-provenance-before-Rust" and
              qa["Rust_baseline_released"] is True and qa["complete_requested_record_ledger_validated"] is True and qa["actual_method_counts_unknown"] is False and
              type(qa["actual_native_process_exit_code"]) is int and qa["actual_native_process_exit_code"] == 0 and qa["actual_native_launch_error"] is None and
              not qa["observation_integrity_failures"] and qa["numerical_PASS_claimed"] is False and m.load(qc["stdout"]) == qa,
              "Genuine preceding OriginalDataQA0/full stdout and release required")
    preparation = m.load(QA_PREPARATION)
    qa_sources = [m.bind(row) for row in preparation["own_sources"]]
    archives = qa["executed_reader_sources"]
    m.require(len(qa_sources) == len(archives) == 3, "Exact executed QA source3 required")
    for source, row in zip(qa_sources, archives):
        m.bind(row["archive"])
        m.require(row["historical_path"] == source["path"] and row["archive"]["sha256"] == source["sha256"], "Actual executed QA archive differs from approved hold")
    same(qa["executed_reader_source_archive"], archives[0]["archive"])
    argv = qc["command"]
    m.require(len(argv) == 25 and Path(argv[0]).name.lower() in ["python", "python.exe"] and argv[1:4] == ["-X", "utf8", "-B"] and

"""Project every genuine selected history preevent; no expected endpoints or equations."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path

PREP = Path(__file__).resolve().parent
COMMON_SHA = '7808162aa42c0d06c3893acf325346c473455df993d2705ac1f7a3888f1dd74c'


def run(args):
    path = PREP / 'history_unit_common.py'
    if hashlib.sha256(path.read_bytes()).hexdigest() != COMMON_SHA: raise ValueError('Held helper differs before import')
    spec = importlib.util.spec_from_file_location('history_projection_common', path)
    c = importlib.util.module_from_spec(spec); spec.loader.exec_module(c)
    m, shape, stream = c.modules(); own_ref, own_paths = c.own(m, args, Path(__file__))
    refs, qa, execution, freeze, policy_ref, policy = c.original(m, args)
    output = m.contained(args.output_dir, existing=False)
    m.require(output.is_relative_to(m.CTF) and output != m.CTF and not output.exists(), 'Fresh contained projection output required')
    output.mkdir(parents=True, exist_ok=False)
    cases_path = output / 'input-cases.ndjson'; count = 0
    with cases_path.open('xb') as handle:
        def visit(event):
            nonlocal count
            if event['checkpoint'] in c.INPUTS:
                count += 1; handle.write(c.line(c.case(event, count)) + b'\n')
        counts = c.review_stream(m, shape, stream, qa, visit)
    cases_ref = m.identity(cases_path, max_bytes=cases_path.stat().st_size)
    sources = [m.archive(m.identity(path), output, index) for index, path in enumerate(own_paths)]
    projection = {'schema': 'ctf10-thermal-history-direct-unit-projection.v1', 'input_cases': cases_ref,
        'projected_case_count': count, 'reviewed_original_data': refs['original-data-review'],
        'reviewed_original_data_execution': refs['original-data-review-execution'],
        'actual_packet_freeze': qa['actual_packet_freeze'], 'thermal_history_direct_unit_policy': policy_ref,
        'native_source_preparation': m.bind(c.NATIVE), 'thermal_history_API_preparation': m.bind(c.API),
        'OriginalQA_source_preparation': m.bind(c.QA), 'projector_source_preparation': own_ref,
        'executed_projector_source': m.identity(__file__), 'executed_projector_sources': sources,
        'complete_actual_native_event_ledger_validated': True, 'actual_observation_counts': counts,
        'Native_expected_endpoint_values_supplied': False, 'scientific_values_computed_or_compared': False,
        'unreached_or_excluded_counted_as_PASS': False, 'integration_PASS_claimed': False}
    m.recheck(); c.large(m, cases_ref); m.emit(output / 'projection.json', projection); m.recheck(); c.large(m, cases_ref)
    print(json.dumps(projection, ensure_ascii=False, allow_nan=False, indent=2))
    return 0


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['approved-source-sha256', 'source-manifest', 'original-data-review', 'original-data-review-execution', 'output-dir']:
        parser.add_argument('--' + name, required=True)
    raise SystemExit(run(parser.parse_args()))

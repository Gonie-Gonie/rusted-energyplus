"""Create a metadata-only sizing successor with stdlib file operations."""
import copy
import difflib
import hashlib
import json
from pathlib import Path

OLD = Path('.runtime/porting/CTF-10/predefined-sizing-input-prep-01')
NEW = Path('.runtime/porting/CTF-10/predefined-sizing-input-prep-02')


def reference(path):
    data = path.read_bytes()
    return {'path': path.as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}


def emit(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes((json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode('utf-8'))
    return reference(path)


def delta(before, after, name):
    path = NEW / 'diffs' / name
    path.parent.mkdir(parents=True, exist_ok=True)
    text = ''.join(difflib.unified_diff(before.read_text('utf-8').splitlines(True),
                                      after.read_text('utf-8').splitlines(True),
                                      fromfile=before.as_posix(), tofile=after.as_posix()))
    path.write_bytes(text.encode('utf-8'))
    return {'before': reference(before), 'after': reference(after), 'diff': reference(path)}


old_bytes = (OLD / 'manifest.json').read_bytes()
assert hashlib.sha256(old_bytes).hexdigest() == '63bc1273ec67755f494f7a505ae09140ddfa4631e930228a8957181818e7bcb3'
manifest = json.loads(old_bytes)
before = NEW / 'before-01'
before.mkdir(parents=True, exist_ok=True)
for name in ['manifest.json', 'README.md']:
    (before / name).write_bytes((OLD / name).read_bytes())

old_metadata = {'selected_ranges': manifest['source_context']['selected_ranges'],
                'source_checks': manifest['source_checks']}
old_meta_path = before / 'metadata.json'
emit(old_meta_path, old_metadata)

manifest = copy.deepcopy(manifest)
lib_range = [row for row in manifest['source_context']['selected_ranges']
             if row['path'] == 'crates/ep_model/src/lib.rs']
assert len(lib_range) == 1 and lib_range[0]['last_line'] == 18
lib_range[0]['last_line'] = 17
checks = manifest['source_checks']
checks['old5_report_family_parser_and_existing_tests_inverse_logical_LF_exact'] = checks.pop('old5_report_family_parser_and_existing_tests_inverse_exact')
checks['model_field_and_Default_only_inverse_logical_LF_exact'] = checks.pop('model_field_and_Default_only_inverse_exact')
facts = []
for row in manifest['own_sources']:
    original = Path(row['before']['path']).read_bytes()
    proposed = Path(row['source']['path']).read_bytes()
    if row['target'] in ['crates/ep_compiler/src/compiler/report_inputs.rs', 'crates/ep_model/src/model.rs']:
        assert b'\r' not in original and proposed.count(b'\r\n') == proposed.count(b'\n')
        facts.append({'target': row['target'], 'before_line_endings': 'LF',
                      'proposal_line_endings': 'CRLF',
                      'raw_byte_inverse_claimed': False,
                      'unchanged_body_inverse_comparison': 'logical-LF'})
    assert Path(row['target']).read_bytes() == original
checks['existing_newline_transformations_disclosed'] = facts
checks['all_three_Rust_proposals_byte_exact_predecessor01'] = True
new_meta_path = NEW / 'metadata.json'
emit(new_meta_path, {'selected_ranges': manifest['source_context']['selected_ranges'],
                     'source_checks': checks})

readme = (OLD / 'README.md').read_text('utf-8')
readme = readme.replace('all five report-family parsing bodies otherwise remain exact.',
                        'all five report-family parsing bodies otherwise remain logical-LF exact.')
readme = readme.replace('All prior report parsing, tests and typed-count code remain literal.',
                        'All prior report parsing, tests and typed-count code remain logical-LF exact.')
readme += ('\nFresh02 corrects the ep_model/lib.rs selected range from 1-18 to its actual\n'
           '1-17 lines; selected bytes, hash and size are unchanged. The three Rust\n'
           'proposals, before archives and source diffs are borrowed byte-for-byte\n'
           'from immutable01. The existing compiler/report_inputs.rs and model.rs\n'
           'proposals use CRLF while their actual before archives use LF. Their\n'
           'unchanged-body inverse checks are logical-LF comparisons, not raw-byte\n'
           'inverses. This successor changes only metadata/documentation and makes\n'
           'no new implementation, execution or gate claim.\n')
(NEW / 'README.md').write_bytes(readme.encode('utf-8'))
manifest['README'] = reference(NEW / 'README.md')
manifest['predecessor_source_preparation'] = reference(before / 'manifest.json')
manifest['predecessor_documentation'] = reference(before / 'README.md')
manifest['metadata_only_successor'] = True
manifest['successor_scope'] = 'Actual lib.rs range end 17 and explicit existing LF-to-CRLF documentation only; all Rust proposals and original source diffs literal01.'
manifest['exact_metadata_and_document_deltas'] = [delta(old_meta_path, new_meta_path, 'metadata.diff'),
                                                 delta(before / 'README.md', NEW / 'README.md', 'README.diff')]
manifest['authoring_source'] = reference(NEW / 'prepare_metadata.py')
emit(NEW / 'manifest.json', manifest)
print(json.dumps(reference(NEW / 'manifest.json')))

 #[cfg(test)]
+mod predefined_sizing_tests {
+    use crate::compile_raw_model;
+    use ep_raw_model::parse_epjson_str;
+
+    type TestResult = Result<(), Box<dyn std::error::Error>>;
+
+    #[test]
+    fn absent_object_retains_literal_false_reset_without_getter_owner() -> TestResult {
+        let model = compile_raw_model(&parse_epjson_str("{}")?).model.ok_or("compiled model missing")?;
+        assert_eq!(model.predefined_table_sizing.actual_flags(), (false, false));
+        assert!(model.predefined_table_sizing.first_object.is_none());
+        Ok(())
+    }
+
+    #[test]
+    fn missing_and_empty_fields_retain_genuine_no_defaults() -> TestResult {
+        let raw = parse_epjson_str(r#"{"SimulationControl":{"control":{"do_system_sizing_calculation":""}}}"#)?;
+        let model = compile_raw_model(&raw).model.ok_or("compiled model missing")?;
+        assert_eq!(model.predefined_table_sizing.actual_flags(), (false, false));
+        let input = model.predefined_table_sizing.first_object.ok_or("getter owner missing")?;
+        assert_eq!(input.object_name, "control");
+        assert_eq!(input.alphas, ["NO", "NO"]);
+        assert_eq!(input.alpha_blank, [true, true]);
+        assert_eq!(input.default_applied, [true, true]);
+        Ok(())
+    }
+
+    #[test]
+    fn each_actual_yes_flag_is_preserved_independently() -> TestResult {
+        for (zone, system, flags) in [("yEs", "No", (true, false)), ("No", "YES", (false, true)), ("Yes", "Yes", (true, true))] {
+            let text = format!(r#"{{"SimulationControl":{{"control":{{"do_zone_sizing_calculation":"{zone}","do_system_sizing_calculation":"{system}"}}}}}}"#);
+            let model = compile_raw_model(&parse_epjson_str(&text)?).model.ok_or("compiled model missing")?;
+            assert_eq!(model.predefined_table_sizing.actual_flags(), flags);
+            let input = model.predefined_table_sizing.first_object.ok_or("getter owner missing")?;
+            assert_eq!(input.alpha_blank, [false, false]);
+            assert_eq!(input.default_applied, [false, false]);
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn malformed_choice_or_type_does_not_release_a_defaulted_success() -> TestResult {
+        for value in [r#""Sometimes""#, "42"] {
+            let text = format!(r#"{{"SimulationControl":{{"control":{{"do_zone_sizing_calculation":{value}}}}}}}"#);
+            let compiled = compile_raw_model(&parse_epjson_str(&text)?);
+            assert!(compiled.has_errors());
+            assert!(compiled.model.is_none());
+            assert!(compiled.report.diagnostics.iter().any(|diagnostic| diagnostic.object_type == "SimulationControl" && diagnostic.field.as_deref() == Some("do_zone_sizing_calculation")));
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn multiple_unique_objects_are_not_silently_admitted() -> TestResult {
+        let compiled = compile_raw_model(&parse_epjson_str(r#"{"SimulationControl":{"a":{},"b":{}}}"#)?);
+        assert!(compiled.has_errors());
+        assert!(compiled.model.is_none());
+        assert!(compiled.report.diagnostics.iter().any(|diagnostic| diagnostic.code == "TooManyObjects" && diagnostic.object_type == "SimulationControl"));
+        Ok(())
+    }

"""Seal tested complete registry, selected producer diagnostics and Init postlude."""
import difflib
import hashlib
import json
import re
import shutil
from pathlib import Path
ROOT = Path.cwd().resolve()
BASE = ROOT / '.runtime/porting/CTF-10'
OUT = ROOT / 'energyplus_porting_plan/evidence/CTF-10-init-postlude'
SOURCE = '8790104a80664af191a9c49103364ca57edb7068aa814f25a8d3b1816b2fe807'
def read(path): return json.loads(path.read_bytes())
def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(), 'size_bytes': len(data)}
def exact(row):
    path = ROOT / row['path']
    assert ref(path)['sha256'] == row['sha256']
    return path
def write(path, value): path.write_bytes((json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode())
application_path = BASE / 'postlude-registry-severe-applied-01/record.json'
application = read(application_path)
assert application['Root_and_other_author_Source_review_accepted'] is True and len(application['actual_sources']) == 24
for row in application['actual_sources']:
    held, actual, delta = [exact(row[key]) for key in ['actual_composed_source', 'actual_final_source', 'actual_formatter_diff']]
    assert actual.read_bytes() == (ROOT / row['canonical_path']).read_bytes()
    regenerated = ''.join(difflib.unified_diff(held.read_bytes().decode().splitlines(True), actual.read_bytes().decode().splitlines(True), fromfile=row['actual_composed_source']['path'], tofile=row['canonical_path'])).encode()
    assert regenerated == delta.read_bytes()
quality = {}
pattern = re.compile(r'test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored;')
for role in ['fmt-check', 'clippy', 'focused', 'workspace']:
    path = BASE / ('postlude-registry-severe-' + role + '-command-01/receipt.json')
    receipt = read(path)
    assert receipt['exit_code'] == 0 and receipt['launch_error'] is None and receipt['source_bytes_match_before_and_after'] is True and receipt['source_snapshot']['sha256'] == SOURCE
    assert receipt['command'] == read(BASE / ('report-output-' + role + '-command-02/receipt.json'))['command']
    groups = [tuple(map(int, row)) for row in pattern.findall(exact(receipt['stdout']).read_text(encoding='utf-8'))]
    quality[role] = {'actual_execution': ref(path), 'exit_code': 0, 'test_groups': len(groups), 'passed': sum(row[0] for row in groups), 'failed': sum(row[1] for row in groups), 'ignored': sum(row[2] for row in groups)}
assert quality['focused']['passed'] == 299 and quality['workspace']['passed'] == 4914 and quality['workspace']['test_groups'] == 21
assert quality['focused']['failed'] == quality['workspace']['failed'] == quality['focused']['ignored'] == quality['workspace']['ignored'] == 0
assert not OUT.exists()
(OUT / 'objects').mkdir(parents=True)
rows = []
seen = set()
def store(path, role):
    path = path.resolve()
    assert path.is_relative_to(ROOT) and path.suffix.lower() not in ['.exe', '.dll', '.rlib', '.obj', '.a', '.map', '.epw']
    original = ref(path)
    key = (original['path'], original['sha256'])
    if key in seen: return
    seen.add(key)
    stored = OUT / 'objects' / original['sha256']
    if not stored.exists(): shutil.copyfile(path, stored)
    assert stored.read_bytes() == path.read_bytes()
    rows.append({'role': role, 'original': original, 'stored': ref(stored)})
def command(name):
    path = BASE / name / 'receipt.json'
    receipt = read(path)
    store(path, 'actual-command')
    for key in ['stdout', 'stderr', 'source_snapshot']: store(exact(receipt[key]), 'actual-command/' + key)
    store(exact(receipt['executed_launcher']['archive']), 'actual-recorder-source')
for name in ['whole-init-postlude-prep-01', 'predefined-registry-prep-01', 'predefined-registry-prep-02',
             'predefined-sizing-input-prep-01', 'predefined-sizing-input-prep-02', 'severe-producer-prep-01',
             'postlude-registry-severe-applied-01']:
    for path in sorted((BASE / name).rglob('*')):
        if path.is_file(): store(path, 'reviewed-source-and-application/' + name)
for role in quality: command('postlude-registry-severe-' + role + '-command-01')
for name in ['postlude-registry-severe-apply-command-01', 'postlude-registry-severe-format-command-01', 'postlude-registry-severe-quality-launch-command-01']: command(name)
for name in ['apply-postlude-registry-severe-01.py', 'run-postlude-registry-severe-quality-01.py']: store(BASE / name, 'actual-Root-source')
store(Path(__file__).resolve(), 'actual-finalization-source')
store(ROOT / '.gitattributes', 'actual-Git-line-ending-contract')
write(OUT / 'accepted.json', {'schema': 'ctf10-init-postlude-accepted-source.v1', 'actual_application': ref(application_path),
    'actual_sources': application['actual_sources'], 'independent_Source_and_formatter_correspondence_review_accepted': True,
    'source_review_scope': 'Root reviewed critical implementation and deltas; Raw independently matched every1206 catalog call/1301 name and full postlude; Base reviewed sizing; Header reviewed all severe bodies/deltas and actual formatter/composed-module correspondence.',
    'raw_worktree_Source_snapshots_normalized': False, 'ordinary_production_connection_applied': False, 'gates_updated': False})
write(OUT / 'manifest.json', {'schema': 'ctf10-init-postlude-selected-evidence.v1', 'selected_files': rows,
    'actual_quality': quality, 'actual_source_snapshot': read(BASE / 'postlude-registry-severe-workspace-command-01/receipt.json')['source_snapshot'],
    'selected_archive_is_transitive_replay_closure': False, 'gates_updated': False})
summary = {'schema': 'ctf10-init-postlude-implementation-milestone.v1', 'card': 'CTF-10',
    'status': 'Complete predefined registry, real sizing inputs, selected severe producers and Init postlude implemented and regression-tested; ordinary connection pending.',
    'selected_evidence_manifest': ref(OUT / 'manifest.json'), 'actual_accepted_source': ref(OUT / 'accepted.json'),
    'actual_quality': quality, 'additional_tests': 34,
    'implementation': ['Retain all1301 named predefined indices and1206 ordered registrations, sizing branch and real opaque-layer IDs.',
        'Compile the actual first SimulationControl sizing alphas/default facts; no sizing success is guessed.',
        'Emit real loading/retry Severe/Continue/Fatal calls at producer sites before later flags/stores; preserve borrowed output and actual backend failures.',
        'Retain final shared flags independently of returned rows; execute reportLayers, fallible Scan, conditional EIO and final fatal in original postlude order.'],
    'remaining': ['Connect caller-owned registry/table/Scan/error/output state through both ordinary production initialization paths.',
        'Native F/G, registry/backend/report/whole-Init evidence and ordinary persistent numerical integration.', 'Remaining CTF card prerequisites and gates.'],
    'actual_Native_registry_backend_or_whole_Init_comparison_performed': False, 'ordinary_production_connection_applied': False,
    'complete_CTF10_PASS_claimed': False, 'gates_updated': False}
write(OUT / 'summary.json', summary)
plan_path = ROOT / 'energyplus_porting_plan/plan.json'
plan = read(plan_path)
task = next(row for row in plan['tasks'] if row['id'] == 'CTF-10')
assert 'actual_init_postlude_registry_implementation' not in task
task['actual_init_postlude_registry_implementation'] = ref(OUT / 'summary.json')
write(plan_path, plan)
card_path = ROOT / 'energyplus_porting_plan/cards/CTF-10.md'
card = card_path.read_text(encoding='utf-8')
anchor = '## Actual selected Scan comparison\n'
assert card.count(anchor) == 1
section = '## Complete registry, producer diagnostics and Init postlude\n\nThe full predefined registry retains1301 named indices, all1206 ordered calls, the actual sizing branch and opaque-layer IDs. Genuine first SimulationControl sizing inputs are retained. Selected loading/retry Severe/Continue/Fatal effects execute at their producer callpoints before later flags/stores, through borrowed real backend owners. Final shared flags and the complete ordered report/Scan/EIO/fatal postlude are implemented.\nThe [Init postlude implementation evidence](../evidence/CTF-10-init-postlude/summary.json) records fmt/Clippy0, focused299 and workspace4914 PASS, adding34 tests. Independent Source and actual formatter/composed-module reviews passed. Ordinary caller connection and Native registry/backend/whole-Init comparison remain pending; no card gate is promoted.\n\n'
card_path.write_bytes(card.replace(anchor, section + anchor).encode())
checklist_path = ROOT / 'energyplus_porting_plan/CHECKLIST.md'
checklist = checklist_path.read_text(encoding='utf-8')
anchor = '| [ ] | [CTF-10]'
assert checklist.count(anchor) == 1
checklist_path.write_bytes(checklist.replace(anchor, 'CTF-10의 전체 보고서 등록·실제 오류 발생 지점·초기화 후처리를 구현하고 추가 34개를 포함한 전체 4,914개 테스트를 통과했습니다. [구현 증거](evidence/CTF-10-init-postlude/summary.json)를 보존했으며 일반 실행 경로 연결과 원본 통합 비교는 계속 진행합니다.\n\n' + anchor).encode())
print(json.dumps(ref(OUT / 'summary.json')), flush=True)

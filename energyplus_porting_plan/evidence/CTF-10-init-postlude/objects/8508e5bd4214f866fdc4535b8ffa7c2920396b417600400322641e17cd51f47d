+#[test]
+fn fallible_loading_calls_are_reached_in_original_order_before_sticky_flags() {
+    let mut thick = mass(1);
+    thick.thickness = 4.0;
+    let mut calls = Vec::new();
+    let result = try_preprocess_ctf_layers(&[thick, no_mass(2, -0.0)], context(), |call| {
+        calls.push(call);
+        Ok::<(), ()>(())
+    });
+    assert!(matches!(result, Ok(CtfLayerPreprocessing { errors_found: true, .. })));
+    assert_eq!(calls, [
+        CtfLayerDiagnostic::MaterialTooThick { layer_ordinal: 1 },
+        CtfLayerDiagnostic::MaterialName { layer_ordinal: 1 },
+        CtfLayerDiagnostic::ResistanceBelowMinimum { layer_ordinal: 2 },
+        CtfLayerDiagnostic::ResistanceValues { layer_ordinal: 2, minimum: 1.0e-3, resistance: -0.0 },
+    ]);
+    assert!(matches!(calls[3], CtfLayerDiagnostic::ResistanceValues { resistance, .. }
+        if resistance.to_bits() == (-0.0_f64).to_bits()));
+}
+
+#[test]
+fn diagnostic_failure_stops_loading_before_next_call_or_later_layer() {
+    let mut thick = mass(1);
+    thick.thickness = 4.0;
+    let mut calls = Vec::new();
+    let result = try_preprocess_ctf_layers(&[thick, no_mass(2, 0.0)], context(), |call| {
+        calls.push(call);
+        Err("actual borrowed severe sink failure")
+    });
+    assert_eq!(result, Err(CtfLayerFailure::Diagnostic("actual borrowed severe sink failure")));
+    assert_eq!(calls, [CtfLayerDiagnostic::MaterialTooThick { layer_ordinal: 1 }]);
+}

//! Actual whole-Init postlude, borrowing the real public/report/backend owners.
//!
//! Construction calculations have already returned. Nothing here reevaluates
//! coefficients, fabricates predefined IDs, or replays earlier diagnostics.

use super::ctf_public_initialization::OrderedCtfPublicInitialization;
use super::ctf_reports::{
    CtfReportError, CtfReportUnavailable, PredefinedStringTable,
    prepare_ctf_construction_report, report_ctf_layers, report_ctf_transfer_function,
    write_ctf_report_headers,
};
use super::error_backend::{SourceErrorBackend, SourceErrorBackendFailure, SourceFatalStop};
use super::report_scan::{
    ReportScanDiagnostic, ReportScanFailure, ReportScanState, ReportScanUnavailable,
    try_scan_for_reports,
};
use ep_model::TypedModel;
use std::io::Write;

/// Source/custody stops remain distinct from actual report/backend failures.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum CtfInitPostludeUnavailable {
    /// A construction did not reach the selected actual public return.
    IncompleteConstructionLoop,
    /// Original declared positions and IDs do not match the same model owner.
    Association,
    /// The actual producer's local shared flags were not retained.
    MissingFinalSharedFlags,
}

/// Every borrowed output and the reached progress remain owned by the caller.
#[derive(Debug)]
pub enum CtfInitPostludeError {
    /// A genuine unavailable selected owner, never a successful whole Init.
    Unavailable(CtfInitPostludeUnavailable),
    /// An actual report representability or writer failure.
    Report(CtfReportError),
    /// A requested Scan call is not representable.
    Scan(ReportScanUnavailable),
    /// A real warning/continue backend failed before later Scan work.
    Backend(SourceErrorBackendFailure),
    /// The final actual fatal effects either failed or reached typed termination.
    Fatal(SourceFatalStop),
}

impl From<CtfReportUnavailable> for CtfInitPostludeError {
    fn from(value: CtfReportUnavailable) -> Self {
        Self::Report(CtfReportError::Unavailable(value))
    }
}

impl From<CtfReportError> for CtfInitPostludeError {
    fn from(value: CtfReportError) -> Self { Self::Report(value) }
}

impl std::fmt::Display for CtfInitPostludeError {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Unavailable(value) => write!(formatter, "whole CTF postlude unavailable: {value:?}"),
            Self::Report(value) => std::fmt::Display::fmt(value, formatter),
            Self::Scan(value) => write!(formatter, "report scan unavailable: {value:?}"),
            Self::Backend(value) => std::fmt::Display::fmt(value, formatter),
            Self::Fatal(value) => std::fmt::Display::fmt(value, formatter),
        }
    }
}

impl std::error::Error for CtfInitPostludeError {}

/// Reached Rust call boundaries only; not a Native return, report or PASS claim.
#[derive(Clone, Debug, Default, Eq, PartialEq)]
pub struct CtfInitPostludeProgress {
    /// Actual successful used-row reportLayers calls, in declared order.
    pub layer_report_declared_indices: Vec<usize>,
    /// Absent until the real Scan returned and assigned its output flag.
    pub construction_scan_result: Option<bool>,
    /// True only after all four writes actually completed.
    pub report_headers_written: bool,
    /// Actual successful used-row reportTransferFunction calls.
    pub coefficient_report_declared_indices: Vec<usize>,
    /// Set immediately before invoking the real final fatal boundary.
    pub final_fatal_invoked: bool,
    /// True only if this function returned past the final ErrorsFound test.
    pub postlude_returned: bool,
}

/// Executes HeatBalanceManager.cc6166-6202 in the same actual owner order.
///
/// `any_internal_heat_source_in_input` must be the real loader/global owner.
/// `layer_columns` must come from the actual predefined registry. This API
/// supplies no IDs, empty fallback registry, output sink or backend defaults.
/// Earlier construction severe/continue effects must already have reached the
/// supplied backend at their genuine producer call boundaries.
pub fn complete_ctf_init_postlude(
    model: &TypedModel,
    public: &mut OrderedCtfPublicInitialization,
    any_internal_heat_source_in_input: bool,
    layer_columns: &[i32],
    table: &mut PredefinedStringTable,
    scan: &mut ReportScanState,
    eio: &mut impl Write,
    backend: &mut SourceErrorBackend<'_>,
    progress: &mut CtfInitPostludeProgress,
) -> Result<(), CtfInitPostludeError> {
    use CtfInitPostludeUnavailable as Unavailable;
    if !public.selected_declared_loop_completed || public.selected_stop.is_some() {
        return Err(CtfInitPostludeError::Unavailable(Unavailable::IncompleteConstructionLoop));
    }
    if public.constructions.len() != model.constructions.len()
        || public.constructions.iter().enumerate().any(|(index, row)| {
            row.declared_index != index || row.construction_id != model.constructions[index].id
                || row.result.is_err()
        })
    {
        return Err(CtfInitPostludeError::Unavailable(Unavailable::Association));
    }
    let flags = public.final_shared_flags.ok_or(CtfInitPostludeError::Unavailable(
        Unavailable::MissingFinalSharedFlags,
    ))?;
    if any_internal_heat_source_in_input {
        public.aggregate_after_returned_calls.simple_ctf_only = false;
    }

    // Prepare only the reached used row. A later unavailable row cannot erase
    // or prevent the already completed earlier table writes.
    for row in &public.constructions {
        if !row.is_used_ctf { continue; }
        let report = prepare_ctf_construction_report(model, row)?;
        report_ctf_layers(&report, layer_columns, table)?;
        progress.layer_report_declared_indices.push(row.declared_index);
    }

    let do_report = try_scan_for_reports(
        &model.report_inputs, scan, "Constructions", Some("Constructions"), None, None,
        |diagnostic| match diagnostic {
            ReportScanDiagnostic::Warning(message) => backend.show_warning_error(&message),
            ReportScanDiagnostic::Continue(message) => backend.show_continue_error(&message),
        },
    ).map_err(|error| match error {
        ReportScanFailure::Unavailable(value) => CtfInitPostludeError::Scan(value),
        ReportScanFailure::Diagnostic(value) => CtfInitPostludeError::Backend(value),
    })?;
    progress.construction_scan_result = Some(do_report);
    if do_report || flags.do_ctf_error_report {
        write_ctf_report_headers(eio).map_err(CtfReportError::Io)?;
        progress.report_headers_written = true;
        // The declared counter includes unused rows through each row's original
        // declaration index; no filtered-vector index substitutes for it.
        for row in &public.constructions {
            if !row.is_used_ctf { continue; }
            let report = prepare_ctf_construction_report(model, row)?;
            report_ctf_transfer_function(&report, eio)?;
            progress.coefficient_report_declared_indices.push(row.declared_index);
        }
    }
    if flags.errors_found {
        progress.final_fatal_invoked = true;
        return match backend.show_fatal_error(
            "Program terminated for reasons listed (InitConductionTransferFunctions)",
        ) {
            Ok(never) => match never {},
            Err(stop) => Err(CtfInitPostludeError::Fatal(stop)),
        };
    }
    progress.postlude_returned = true;
    Ok(())
}


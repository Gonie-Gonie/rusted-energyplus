"""Root-only finite dispatcher evidence publication; no endpoint or gzip-ledger decoding."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import shutil
import sys

ROOT = Path(__file__).resolve().parents[4]
OUT = ROOT / 'energyplus_porting_plan/evidence/SRC-06-tarp-dispatcher'
SEEN, ROLES, PROVENANCE, CONVERTER_LOGS = {}, {}, [], {}


def need(value, message):
    if not value: raise ValueError(message)


def full(path):
    with path.open('rb') as stream: sha = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=sha, size_bytes=path.stat().st_size)


def checked(row):
    path = (ROOT / row['path']).resolve()
    need(path.is_relative_to(ROOT) and path.is_file(), 'contained exact artifact required: ' + row['path'])
    actual = full(path)
    need(actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes']), 'artifact bytes differ: ' + row['path'])
    SEEN[path] = actual
    return path


def load(row):
    return json.loads(checked(row).read_bytes())


def same(left, right):
    need(checked(left) == checked(right), 'exact metadata artifact identity differs')


def select(row, role):
    path = checked(row)
    if path in CONVERTER_LOGS:
        need(full(path) == CONVERTER_LOGS[path], 'exact closed converter child log differs')
    elif path.name in ['stdout.log', 'stderr.log']:
        receipt_path = path.parent / 'receipt.json'
        need(receipt_path.is_file(), 'active/unrecorded standard log cannot be selected')
        receipt = load(full(receipt_path))
        need(receipt['schema'] == 'recorded-porting-command.v1' and receipt['finished_utc'] is not None and receipt['launch_error'] is None, 'closed sibling recorder receipt required')
        same(receipt['stdout' if path.name == 'stdout.log' else 'stderr'], row)
    ROLES.setdefault(path, set()).add(role)


def receipt(row, role, allowed, source=None, argv=None, stable=True):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] in allowed and value['launch_error'] is None and value['finished_utc'] is not None and value['started_utc'] <= value['finished_utc'], 'closed actual receipt/outcome required')
    need(value['source_bytes_match_before_and_after'] is stable and value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'actual Source/recorder guard differs')
    if source is not None: same(value['source_snapshot'], source)
    if argv is not None: need(value['command'] == argv, 'exact actual role command differs')
    need(checked(value['executed_launcher']['archive']).read_bytes() == checked(PREP['recorder_Source']).read_bytes(), 'actual archived recorder differs')
    for item in [row, value['stdout'], value['stderr'], value['executed_launcher']['archive']]: select(item, role)
    return value


def closed_converter_logs(observer):
    authority = PREP['closed_input_converter']
    for key in ['ledger', 'execution', 'recorded_command']: same(observer['actual_input_only_conversion'][key], authority[key])
    child, ledger = load(authority['execution']), load(authority['ledger'])
    outer = receipt(authority['recorded_command'], 'actual-input-only-converter-recorder', (0,))
    need(load(outer['stdout']) == ledger, 'closed outer conversion stdout/ledger differs')
    need(child['schema'] == 'sch01-input-conversion-command.v1' and child['exit_code'] == 0 and child['launch_error'] is None and child['finished_utc'] is not None, 'closed actual input-converter child required')
    need(outer['started_utc'] <= child['started_utc'] <= child['finished_utc'] <= outer['finished_utc'], 'actual converter chronology differs')
    need(child['original_and_staged_IDF_preserved'] is True and all(child[key] is False for key in ['numerical_engine_executed', 'Native_scientific_outputs_used_as_inputs', 'expected_answers_supplied']), 'genuine input-only converter required')
    need(ledger['schema'] == 'sch01-converted-inputs.v1' and len(ledger['conversions']) == 1, 'exact single input conversion ledger required')
    row = ledger['conversions'][0]; same(row['actual_conversion_execution'], authority['execution'])
    need(row['available'] is True and row['case_id'] == child['case_id'], 'actual successful conversion identity differs')
    for key in ['source_input', 'staged_input']: same(child[key], observer['actual_input_only_conversion'][key])
    need(checked(child['source_input']).read_bytes() == checked(child['staged_input']).read_bytes(), 'actual original/staged IDF bytes differ')
    need(len(authority['logs']) == 2, 'exact two declared converter child logs required')
    for key, expected in zip(['stdout', 'stderr'], authority['logs']):
        same(child[key], expected)
        need(expected['size_bytes'] == full(checked(child[key]))['size_bytes'] and child[key] in child['actual_output_inventory'], 'full converter child log inventory differs')
        CONVERTER_LOGS[checked(expected)] = full(checked(expected))


def provenance(row, reason, verify_metadata=False):
    # Whole snapshots and executable/map/object/library payloads are never selected.
    if verify_metadata: checked(row)
    PROVENANCE.append(dict(artifact=row, reason=reason, payload_published=False, current_payload_rehashed_by_publisher=verify_metadata))


def source_preparation(row, role):
    value = load(row); select(row, role)
    for item in value.get('own_sources', []): select(item, role + ':owned-Source')
    for key in ['README', 'author_source', 'authoring_Source']:
        if key in value: select(value[key], role + ':Source-document')
    for item in value.get('application_sources', []):
        for key in ['proposal', 'exact_diff']: select(item[key], role + ':held-application')
        if not item['new_destination_absent']: select(item['before_archive'], role + ':held-before')
    for item in value.get('Original_helper_ranges', []): select(item['literal_archive'], role + ':literal-Original-range')
    for item in value.get('selected_source_ranges', []): select(item['archive'], role + ':literal-Original-range')
    return value


def application(row, role, current=False):
    value = load(row); select(row, role)
    for key in ['source_before', 'source_literal', 'source_final']: provenance(value[key], role + ':whole-Source-snapshot-metadata-only', True)
    for item in value['application']:
        for key in ['proposal', 'exact_diff', 'actual_before_archive', 'actual_literal_archive', 'actual_final_archive', 'actual_semantic_diff', 'actual_formatter_diff']: select(item[key], role + ':literal-format-correspondence')
        if not item['new_destination_absent']: select(item['before_archive'], role + ':held-before')
        if current: select(item['actual_final'], role + ':current-final')
    receipt(value['actual_formatter_execution'], role + ':actual-format', (0,), value['source_literal'], ['cargo', 'fmt', '--all'], value['source_literal'] == value['source_final'])
    return value



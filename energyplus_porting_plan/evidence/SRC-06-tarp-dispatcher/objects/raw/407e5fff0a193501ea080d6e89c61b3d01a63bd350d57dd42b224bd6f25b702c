"""Root-only dispatcher quality/build, then separately approved actual main-thread capture."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[4]


def module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value)
    return value


def application(A, prep, application_ref, review_ref, source_ref):
    app, review = A.load(application_ref), A.load(review_ref)
    A.need(app['schema'] == 'src06-tarp-dispatcher-actual-application.v1' and A.bind(app['Source_preparation']) == A.bind(prep['application_Source_preparation']), 'actual eight-path application authority differs')
    A.need(A.bind(source_ref) == A.bind(app['source_final']), 'explicit actual formatted full Source differs')
    A.need(review['schema'] == 'src06-tarp-dispatcher-actual-formatter-review.v1' and review['Root_FULL_formatter_correspondence_accepted'] is True and review['independent_FULL_formatter_correspondence_accepted'] is True and A.bind(review['actual_application']) == A.bind(application_ref) and A.bind(review['Source_snapshot']) == A.bind(source_ref), 'Root and independent full formatter acceptance required')
    source = app['source_final']
    old, literal, current = A.members(app['source_before']), A.members(app['source_literal']), A.members(source, current=True)
    authority = A.load(prep['application_Source_preparation'])
    dispatcher, observer = A.load(authority['dispatcher_Source_preparation']), A.load(authority['observer_Source_preparation'])
    held = [dict(r, source_preparation=authority['dispatcher_Source_preparation']) for r in dispatcher['application_sources']] + [dict(r, source_preparation=authority['observer_Source_preparation']) for r in observer['application_sources']]
    paths = [r['canonical_path'] for r in held]
    A.need(app['source_before'] == authority['source_before'] and len(old) == 3931 and len(literal) == len(current) == app['source_file_count'] == 3937 and app['unrelated_source_files_verified_byte_exact'] == 3929, 'complete eight-path Source counts differ')
    added = {r['canonical_path'] for r in held if r['new_destination_absent']}
    A.need(len(paths) == len(set(paths)) == 8 and len(added) == 6 and set(literal) == set(current) == set(old) | added and all(old[n] == literal[n] == current[n] for n in set(old) - set(paths)), 'only reviewed eight paths may change')
    A.need(len(app['application']) == len(held), 'complete actual application rows required')
    for row, original in zip(app['application'], held):
        A.need(all(row[k] == v for k, v in original.items()), 'reviewed Source row differs')
        before, body, final = [A.bind(row[k]).read_bytes() for k in ['actual_before_archive', 'actual_literal_archive', 'actual_final_archive']]
        A.need(before == (b'' if original['new_destination_absent'] else A.bind(original['before_archive']).read_bytes()) and body == A.bind(original['proposal']).read_bytes(), 'literal/before archive differs')
        A.check_diff(before, body, row['actual_semantic_diff']); A.check_diff(body, final, row['actual_formatter_diff'])
        name = row['canonical_path']
        A.need(literal[name]['archive']['sha256'] == row['actual_literal_archive']['sha256'] and literal[name]['size_bytes'] == len(body), 'actual literal snapshot differs')
        A.need(A.bind(row['actual_final']).read_bytes() == final and current[name]['archive']['sha256'] == row['actual_final_archive']['sha256'] and current[name]['size_bytes'] == len(final), 'actual formatted canonical endpoint differs')
    fmt = A.recorded(app['actual_formatter_execution'], app['source_literal'], ['cargo', 'fmt', '--all'], stable=app['source_literal'] == source)
    runtime = A.load(app['runtime_source_bindings'])
    interfaces = observer['runtime_interfaces']
    A.need(set(runtime) == {'schema', 'observer_sources', 'actual_public_API_sources'} and runtime['schema'] == interfaces['runtime_source_bindings_schema'], 'exact actual runtime binding schema required')
    for key, ordered in [('observer_sources', 'ordered_observer_source_paths'), ('actual_public_API_sources', 'ordered_public_API_source_paths')]:
        A.need([r['path'] for r in runtime[key]] == interfaces[ordered], 'ordered actual runtime Source paths differ')
        for row in runtime[key]:
            A.bind(row); A.need(row['sha256'] == current[row['path']]['archive']['sha256'] and row['size_bytes'] == current[row['path']]['size_bytes'], 'runtime Source/full snapshot join differs')
    native = A.load(prep['Native_baseline_acceptance'])
    A.need(A.bind(app['Native_baseline_acceptance']) == A.bind(prep['Native_baseline_acceptance']) and native['accepted'] is True and native['complete_input_owner_prefix_and_custody_review_accepted'] is True, 'genuine closed Native baseline release required')
    actual = A.load(native['actual_Native_execution']); A.recorded(native['actual_Native_execution'], native['Source_snapshot'], actual['command'])
    A.need(actual['finished_utc'] <= fmt['started_utc'], 'Native capture must close before Rust application')
    for key in ['factual_review', 'actual_custody', 'actual_provider_acceptance', 'independent_FULL_factual_review', 'release_Source']:
        A.bind(native[key])
    A.bind(observer['input_only_request']); A.bind(observer['prospective_pair_policy'])
    for row in observer['actual_input_only_conversion'].values():
        A.bind(row)
    return app, source, fmt, observer


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('phase', choices=['build', 'execute'])
    for name in ['source-preparation', 'application', 'formatter-review', 'Source-snapshot', 'output-dir']:
        parser.add_argument('--' + name, required=True)
    parser.add_argument('--build-record'); parser.add_argument('--artifact-review')
    args = parser.parse_args()
    name, sha = args.source_preparation.rsplit('#', 1)
    prep_path = (ROOT / name).resolve()
    if not prep_path.is_relative_to(ROOT) or hashlib.sha256(prep_path.read_bytes()).hexdigest() != sha:
        raise ValueError('reviewed workflow Source preparation differs')
    prep = json.loads(prep_path.read_bytes())
    shared = prep['shared_custody_Source']; shared_path = (ROOT / shared['path']).resolve()
    if not shared_path.is_relative_to(ROOT) or hashlib.sha256(shared_path.read_bytes()).hexdigest() != shared['sha256']:
        raise ValueError('reviewed custody Source differs')
    A = module('reviewed_custody', shared_path)
    A.need(prep['schema'] == 'src06-tarp-dispatcher-validation-Source-preparation.v1' and A.ROOT == ROOT, 'workflow scope differs')
    for row in prep['own_sources']:
        A.bind(row)
    A.need(A.bind(prep['runtime_interfaces']['workflow']) == Path(__file__).resolve(), 'actual workflow Source differs')
    V = module('reviewed_PE_and_quality', A.bind(prep['CLI_validation_Source']))
    prep_ref, application_ref, review_ref, source_ref = A.ref(prep_path), A.operand(args.application), A.operand(args.formatter_review), A.operand(args.Source_snapshot)
    app, source, fmt, observer = application(A, prep, application_ref, review_ref, source_ref)
    command = ['cargo', 'build'] + V.CONFIGS + ['--locked', '-p', 'ep_run', '--example', 'src06_tarp_dispatcher_main', '--message-format=json-render-diagnostics']
    out = (ROOT / args.output_dir).resolve()
    A.need(out.is_relative_to(ROOT / '.runtime/porting/SRC-06') and not out.exists(), 'fresh ignored output directory required')
    prefix = [sys.executable, '-X', 'utf8', '-B', str(A.bind(A.RECORDER)), '--output-dir']
    common = {'Source_preparation': prep_ref, 'actual_application': application_ref, 'actual_formatter_review': review_ref, 'Source_snapshot': source, 'Native_baseline_acceptance': prep['Native_baseline_acceptance'], 'scientific_PASS_claimed': False, 'ordinary_cadence_activated': False, 'gates_updated': False}
    if args.phase == 'build':
        A.need(args.build_record is None and args.artifact_review is None, 'build phase takes no prior artifact')
        out.mkdir(parents=True)
        policy = observer['prospective_pair_policy']
        A.need(policy['sha256'] == 'ff49c35addf3990ff45e46d6be85e16fb71b9ba87b90f6b58416fd0000b27dc4', 'frozen prospective policy differs')
        frozen = A.write(out / 'frozen-pair-policy.json', A.bind(policy).read_bytes())
        A.dump(out / 'before.json', dict(common, quality_commands=V.QUALITY, build_command=command, frozen_pair_policy=frozen, target_execution_performed=False))
        quality, totals = {}, {}
        for role, argv in {**V.QUALITY, 'dispatcher_build': command}.items():
            A.members(source, current=True)
            code = subprocess.call(prefix + [str(out / (role + '-command')), '--'] + argv, cwd=ROOT)
            receipt_ref = A.ref(out / (role + '-command') / 'receipt.json')
            if code != 0:
                A.dump(out / 'failed-build.json', dict(common, actual_failed_role=role, actual_execution=receipt_ref, actual_exit_code=code, target_execution_performed=False)); return code
            actual = A.recorded(receipt_ref, source, argv)
            A.need(fmt['finished_utc'] <= actual['started_utc'], 'quality/build must follow reviewed formatting')
            A.members(source, current=True)
            if role in V.QUALITY:
                quality[role] = receipt_ref
                if role in ['focused', 'workspace']:
                    groups = [tuple(map(int, r)) for r in re.findall(r'test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored;', A.bind(actual['stdout']).read_text(encoding='utf8'))]
                    A.need(groups and all(r[1] == 0 for r in groups), 'actual test group summaries required')
                    totals[role] = dict(groups=len(groups), passed=sum(r[0] for r in groups), failed=sum(r[1] for r in groups), ignored=sum(r[2] for r in groups))
                continue
            A.need(set(quality) == set(V.QUALITY) and all(A.load(r)['finished_utc'] <= actual['started_utc'] for r in quality.values()), 'four closed quality commands must precede build')
            messages = [json.loads(line) for line in A.bind(actual['stdout']).read_text(encoding='utf8').splitlines() if line]
            emitted = [v for v in messages if v.get('reason') == 'compiler-artifact' and v.get('executable')]
            A.need(len(emitted) == 1 and any(v.get('reason') == 'build-finished' and v.get('success') is True for v in messages), 'sole successful Cargo-emitted executable required')
            message = emitted[0]
            A.need(message['target']['name'] == 'src06_tarp_dispatcher_main' and message['target']['kind'] == ['example'] and Path(message['target']['src_path']).resolve() == ROOT / 'crates/ep_run/examples/src06_tarp_dispatcher_main.rs', 'actual emitted target Source differs')
            A.need(message['package_id'].startswith((ROOT / 'crates/ep_run').as_uri()) or message['package_id'].startswith('path+' + (ROOT / 'crates/ep_run').as_uri()), 'actual Cargo package differs')
            A.need(message['profile']['opt_level'] == '0' and message['profile']['test'] is False, 'actual dev executable required')
            binary = Path(message['executable']).resolve()
            A.need(binary.is_relative_to(ROOT / 'target') and binary.suffix.lower() == '.exe', 'actual contained Windows emitted executable required')
            immediate = A.ref(binary); captured = actual['cargo_compiler_artifacts_capture']
            A.need(captured['status'] == 'pass' and len(captured['rows']) == 1 and captured['rows'][0]['cargo_message'] == message and captured['rows'][0]['executable']['sha256'] == immediate['sha256'], 'recorder/immediate emitted artifact differs')
            artifact = dict(actual_build_execution=receipt_ref, actual_full_Cargo_JSON=actual['stdout'], cargo_message=message, executable=immediate, PE_inspection=V.pe_header(A, binary, out, 'dispatcher'))
        A.members(source, current=True); A.bind(artifact['executable']); application(A, prep, application_ref, review_ref, source_ref)
        for row in prep['own_sources']:
            A.bind(row)
        A.dump(out / 'record.json', dict(common, schema='src06-tarp-dispatcher-actual-quality-and-artifact.v1', quality_executions=quality, actual_test_totals=totals, actual_Cargo_artifact=artifact, frozen_pair_policy=frozen, pair_policy=policy, runtime_source_bindings=app['runtime_source_bindings'], target_execution_performed=False, Root_full_PE_acceptance_required_before_target_execution=True))
        return 0
    A.need(args.build_record is not None and args.artifact_review is not None, 'execute requires closed build and explicit Root artifact review')
    build_ref, approval_ref = A.operand(args.build_record), A.operand(args.artifact_review)
    build, approval = A.load(build_ref), A.load(approval_ref)
    A.need(build['schema'] == 'src06-tarp-dispatcher-actual-quality-and-artifact.v1' and all(A.bind(build[k]) == A.bind(v) for k, v in [('Source_preparation', prep_ref), ('actual_application', application_ref), ('actual_formatter_review', review_ref), ('Source_snapshot', source)]), 'same-Source reviewed build authority differs')
    A.need(approval['schema'] == 'src06-tarp-dispatcher-Root-artifact-acceptance.v1' and approval['Root_FULL_PE_and_Cargo_artifact_accepted'] is True and A.bind(approval['actual_build_record']) == A.bind(build_ref) and A.bind(approval['Source_snapshot']) == A.bind(source), 'explicit Root PE and Cargo artifact acceptance required')
    A.need(set(build['quality_executions']) == set(V.QUALITY), 'four actual same-Source quality receipts required')
    for role, argv in V.QUALITY.items():
        A.recorded(build['quality_executions'][role], source, argv)
    artifact = build['actual_Cargo_artifact']; actual_build = A.recorded(artifact['actual_build_execution'], source, command)
    messages = [json.loads(line) for line in A.bind(actual_build['stdout']).read_text(encoding='utf8').splitlines() if line]
    emitted = [v for v in messages if v.get('reason') == 'compiler-artifact' and v.get('executable')]
    captured = actual_build['cargo_compiler_artifacts_capture']
    A.need(emitted == [artifact['cargo_message']] and any(v.get('reason') == 'build-finished' and v.get('success') is True for v in messages) and captured['status'] == 'pass' and len(captured['rows']) == 1 and captured['rows'][0]['cargo_message'] == emitted[0] and captured['rows'][0]['executable']['sha256'] == artifact['executable']['sha256'] and Path(emitted[0]['executable']).resolve() == A.bind(artifact['executable']), 'actual Cargo JSON/recorder/emitted executable differs')
    A.need(A.bind(artifact['actual_full_Cargo_JSON']) == A.bind(actual_build['stdout']) and all(fmt['finished_utc'] <= A.load(r)['started_utc'] <= A.load(r)['finished_utc'] <= actual_build['started_utc'] for r in build['quality_executions'].values()), 'actual formatter/quality/build chronology differs')
    A.need(A.bind(approval['actual_executable']) == A.bind(artifact['executable']) and artifact['PE_inspection']['actual_binary'] == artifact['executable'] and artifact['PE_inspection']['stack_reserve_bytes'] == 8388608, 'accepted actual emitted PE identity differs')
    A.bind(artifact['actual_full_Cargo_JSON']); A.bind(artifact['PE_inspection']['actual_PE_header_bytes'])
    A.need(A.bind(build['pair_policy']).read_bytes() == A.bind(build['frozen_pair_policy']).read_bytes() == A.bind(observer['prospective_pair_policy']).read_bytes() and build['runtime_source_bindings'] == app['runtime_source_bindings'], 'frozen policy/runtime Source binding differs')
    conversion = observer['actual_input_only_conversion']
    binding = dict(schema=observer['runtime_interfaces']['binding_schema'], native_source_preparation=prep['Native_Source_preparation'], dispatcher_source_preparation=prep['dispatcher_Source_preparation'], native_request=observer['input_only_request'], conversion_ledger=conversion['ledger'], conversion_execution=conversion['execution'], conversion_command_receipt=conversion['recorded_command'], runtime_sources=app['runtime_source_bindings'], backend_context=prep['authored_unpaired_backend_context'], pair_policy=build['pair_policy'], expected_values_supplied=False, Native_results_supplied=False)
    A.need(set(binding) == set(observer['runtime_interfaces']['binding_keys']), 'exact observer input-only protocol required')
    out.mkdir(parents=True)
    binding_ref = A.dump(out / 'input-binding.json', binding)
    argv = [str(A.bind(artifact['executable'])), str(A.bind(binding_ref)), binding_ref['sha256'], str(out / 'cases')]
    A.dump(out / 'before.json', dict(common, actual_build_record=build_ref, actual_Root_artifact_acceptance=approval_ref, input_binding=binding_ref, prospective_command=argv, target_execution_performed=False))
    A.members(source, current=True)
    code = subprocess.call(prefix + [str(out / 'command'), '--'] + argv, cwd=ROOT)
    receipt_ref = A.ref(out / 'command/receipt.json'); actual = A.load(receipt_ref)
    A.need(actual['schema'] == 'recorded-porting-command.v1' and actual['command'] == argv and actual['source_snapshot'] == source and actual['exit_code'] == code and actual['launch_error'] is None and actual['source_bytes_match_before_and_after'] is True, 'actual capture command/Source custody differs')
    A.need(A.bind(actual['executed_launcher']['archive']).read_bytes() == A.bind(A.RECORDER).read_bytes() and actual['recorder_updates_gates'] is False and actual['recorder_supplies_reference_answers'] is False and actual_build['finished_utc'] <= actual['started_utc'], 'actual recorder/build chronology differs')
    A.bind(actual['stdout']); A.bind(actual['stderr']); A.bind(artifact['executable']); A.bind(binding_ref); A.members(source, current=True)
    application(A, prep, application_ref, review_ref, source_ref)
    for row in prep['own_sources']:
        A.bind(row)
    A.load(build_ref); A.load(approval_ref)
    files = [A.ref(p) for p in sorted((out / 'cases').rglob('*')) if p.is_file()] if (out / 'cases').exists() else []
    A.dump(out / 'custody.json', dict(common, schema='src06-tarp-dispatcher-actual-Rust-capture-custody.v1', actual_build_record=build_ref, actual_Root_artifact_acceptance=approval_ref, input_binding=binding_ref, actual_execution=receipt_ref, actual_exit_code=code, actual_complete_stdout=actual['stdout'], actual_complete_stderr=actual['stderr'], actual_case_files=files, actual_executable_after=A.ref(A.bind(artifact['executable'])), target_execution_performed=True, comparison_performed=False))
    return code


if __name__ == '__main__':
    raise SystemExit(main())

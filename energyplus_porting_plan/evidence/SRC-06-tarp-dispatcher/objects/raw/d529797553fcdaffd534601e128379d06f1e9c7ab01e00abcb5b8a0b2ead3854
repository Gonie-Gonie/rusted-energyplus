    struct EdgeOfSurf
    {
        int surfNum = 0;
        Vector start;
        Vector end;
        std::vector<int> otherSurfNums;
        int count = 0;
        EdgeOfSurf() : start(Vector(0., 0., 0.)), end(Vector(0., 0., 0.))
        {
        }

        bool operator==(const EdgeOfSurf &other) const;
        bool operator!=(const EdgeOfSurf &other) const;
        bool containsPoints(const Vector &vertex) const;
        double length() const;
    };

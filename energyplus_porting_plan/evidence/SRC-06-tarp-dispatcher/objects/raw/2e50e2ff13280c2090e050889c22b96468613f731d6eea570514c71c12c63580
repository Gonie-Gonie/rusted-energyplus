        'result_schema': 'src06-tarp-dispatcher-Rust-observer-results.v1', 'result_authority': 'actual recorded complete stdout',
        'complete_capture_exit_codes': [0,2], 'runtime_Source_and_Cargo_artifact_proof': 'Root must authenticate actual emitted executable, actual linker/main-thread/stack evidence and full current Source snapshot before execution.',

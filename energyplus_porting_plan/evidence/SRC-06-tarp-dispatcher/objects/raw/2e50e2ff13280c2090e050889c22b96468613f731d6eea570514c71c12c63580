fields = fields_path.read_text()
lists = {}
for name, count in [('OBSERVER_PATHS', 3), ('API_PATHS', 15)]:
    body = re.search(rf'const {name}: \[&str; {count}\] = \[(.*?)\];', fields, re.S).group(1)
    lists[name] = re.findall(r'"([^"]+)"', body)
    assert len(lists[name]) == count and len(set(lists[name])) == count
proposal_map = {r['canonical_path']: r['proposal'] for r in dispatcher['application_sources']}
observer_map = {r['canonical_path']: r['proposal'] for r in application}
runtime_source_authorities = []
for name in lists['OBSERVER_PATHS'] + lists['API_PATHS']:
    authority = observer_map.get(name) or proposal_map.get(name) or ref(ROOT / name)
    checked(authority)
    runtime_source_authorities.append({'canonical_path': name, 'reviewed_Source_authority': authority,
        'actual_formatted_runtime_SHA_required_later': True})


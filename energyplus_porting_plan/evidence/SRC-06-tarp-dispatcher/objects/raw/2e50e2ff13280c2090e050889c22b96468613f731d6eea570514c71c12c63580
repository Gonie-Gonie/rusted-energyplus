}
parent = ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-observer-prep-01'
manifest['previous_Source_preparation'] = ref(parent / 'manifest.json')
manifest['authentic_before_manifest'] = write(BASE / 'before' / 'manifest.json', (parent / 'manifest.json').read_bytes())

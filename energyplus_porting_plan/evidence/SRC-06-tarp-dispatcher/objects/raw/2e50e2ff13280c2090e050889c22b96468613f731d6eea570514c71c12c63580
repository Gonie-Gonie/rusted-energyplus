ROOT = Path(__file__).resolve().parents[4]
BASE = Path(__file__).resolve().parent
assert BASE == ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-observer-prep-02'
assert not (BASE / 'manifest.json').exists()

def digest(data):
    return hashlib.sha256(data).hexdigest()

def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest(data),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}

def checked(row):
    data = (ROOT / row['path']).read_bytes()
    assert digest(data) == row['sha256']
    if 'size_bytes' in row:
        assert len(data) == row['size_bytes']
    return data

def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    assert not path.exists()
    path.write_bytes(data)
    return ref(path)

def addition(path, data):
    return ''.join(difflib.unified_diff([], data.decode().splitlines(keepends=True),
        fromfile='/dev/null', tofile=path)).encode()


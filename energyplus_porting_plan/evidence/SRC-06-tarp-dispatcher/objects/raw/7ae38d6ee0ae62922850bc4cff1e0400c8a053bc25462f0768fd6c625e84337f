paths |= {ROOT / p for p in ['Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml'] if (ROOT / p).is_file()}
assert {p.relative_to(ROOT).as_posix() for p in paths} == {r['historical_path'] for r in snapshot['files']}
assert len(snapshot['files']) == 3929
for row in snapshot['files']:

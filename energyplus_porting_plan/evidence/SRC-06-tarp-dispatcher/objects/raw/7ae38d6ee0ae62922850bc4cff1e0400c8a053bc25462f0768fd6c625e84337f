manifest = copy.deepcopy(parent)
application = []
incremental = []
for row in parent['application_sources']:
    name = row['canonical_path']
    old = checked(row['proposal'])
    if row['new_destination_absent']:
        assert not (ROOT / name).exists()
        before = b''
    else:
        before = checked(row['actual_before'])
        assert before == checked(row['before_archive'])
    assert checked(row['exact_diff']) == delta(before, old, name if before else '/dev/null', name)
    proposed = old
    if name == main:
        assert old.count(old_guard.encode()) == 1
        proposed = old.replace(old_guard.encode(), new_guard.encode())
        assert proposed.replace(new_guard.encode(), old_guard.encode()) == old
    elif name == tests:
        proposed = old + new_test.encode()
        assert proposed[:-len(new_test.encode())] == old
    new_row = copy.deepcopy(row)
    new_row['proposal'] = write(BASE / 'proposed' / name, proposed)
    new_row['exact_diff'] = write(BASE / 'diffs' / (name.replace('/', '__') + '.diff'),
        delta(before, proposed, name if before else '/dev/null', name))
    application.append(new_row)
    incremental.append({'canonical_path': name, 'before': row['proposal'], 'after': new_row['proposal'],
        'exact_diff': write(BASE / 'from-01' / (name.replace('/', '__') + '.diff'),
            delta(old, proposed, 'prep-01/' + name, 'prep-02/' + name))})
assert len(application) == 6 and sum(r['new_destination_absent'] for r in application) == 4
assert sum(bool(checked(r['exact_diff'])) for r in incremental) == 2


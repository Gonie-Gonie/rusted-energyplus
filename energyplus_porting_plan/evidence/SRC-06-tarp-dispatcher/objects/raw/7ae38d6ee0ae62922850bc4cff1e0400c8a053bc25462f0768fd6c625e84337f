from pathlib import Path
import ast
import copy
import difflib
import hashlib
import json

ROOT = Path(__file__).resolve().parents[4]
BASE = Path(__file__).resolve().parent
PRIOR = ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-rust-prep-01'
assert BASE == ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-rust-prep-02'
assert not (BASE / 'manifest.json').exists()

def digest(data):
    return hashlib.sha256(data).hexdigest()

def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest(data),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}

def checked(row):
    data = (ROOT / row['path']).read_bytes()
    assert digest(data) == row['sha256'] and len(data) == row['size_bytes']
    if 'line_count' in row:
        assert len(data.splitlines()) == row['line_count']
    return data

def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    assert not path.exists()
    path.write_bytes(data)
    return ref(path)

def delta(before, after, old, new):
    return ''.join(difflib.unified_diff(before.decode('utf-8').splitlines(keepends=True),
        after.decode('utf-8').splitlines(keepends=True), fromfile=old, tofile=new)).encode('utf-8')

assert digest((PRIOR / 'manifest.json').read_bytes()) == 'd15dec91565f526c906be5de803db845fae01450e415f0ebfe60685d852312c4'
parent = json.loads((PRIOR / 'manifest.json').read_bytes())
assert parent['schema'] == 'src06-tarp-dispatcher-Rust-source-preparation.v1'
snapshot = json.loads(checked(parent['current_Source_snapshot']))

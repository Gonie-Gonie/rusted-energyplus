"""Root-only test-import correction; preserve the actual eight-path parent and failed quality."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[4]


def module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value)
    return value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source-preparation', required=True)
    parser.add_argument('--output-dir', required=True)
    args = parser.parse_args()
    name, sha = args.source_preparation.rsplit('#', 1)
    path = (ROOT / name).resolve()
    if not path.is_relative_to(ROOT) or hashlib.sha256(path.read_bytes()).hexdigest() != sha:
        raise ValueError('reviewed import correction preparation differs')
    prep = json.loads(path.read_bytes())
    helper = prep['shared_custody_Source']; helper_path = (ROOT / helper['path']).resolve()
    if not helper_path.is_relative_to(ROOT) or hashlib.sha256(helper_path.read_bytes()).hexdigest() != helper['sha256']:
        raise ValueError('reviewed custody Source differs')
    A = module('import_correction_custody', helper_path)
    A.need(prep['schema'] == 'src06-tarp-dispatcher-import-correction-Source-preparation.v1' and A.ROOT == ROOT, 'correction scope differs')
    for row in prep['own_sources']: A.bind(row)
    A.need(A.bind(prep['runtime_interfaces']['apply']) == Path(__file__).resolve(), 'physical correction executable differs')
    parent_prep = A.load(prep['parent_validation_Source_preparation'])
    W = module('original_dispatcher_validation', A.bind(parent_prep['runtime_interfaces']['workflow']))
    app, source, parent_fmt, observer = W.application(A, parent_prep, prep['parent_application'], prep['parent_formatter_review'], prep['source_before'])
    failure = A.load(prep['retained_failed_quality'])
    V = module('actual_quality_commands', A.bind(parent_prep['CLI_validation_Source']))
    A.need(failure['schema'] == 'recorded-porting-command.v1' and failure['command'] == V.QUALITY['clippy'] and failure['source_snapshot'] == source and failure['exit_code'] == 101 and failure['launch_error'] is None and failure['source_bytes_match_before_and_after'] is True, 'genuine original Clippy failure required')
    A.need(A.bind(failure['executed_launcher']['archive']).read_bytes() == A.bind(prep['recorder_Source']).read_bytes() and parent_fmt['finished_utc'] <= failure['started_utc'] <= failure['finished_utc'], 'failed quality recorder/chronology differs')
    A.bind(failure['stdout']); errors = A.bind(failure['stderr']).read_text(encoding='utf8')
    A.need(errors.count('error[E0433]: cannot find type `SurfaceType` in this scope') == 4 and errors.count('error[E') == 4, 'retained failure must be exactly the four missing test imports')
    failed = A.load(prep['retained_failed_workflow'])
    A.need(A.bind(failed['actual_execution']) == A.bind(prep['retained_failed_quality']) and A.bind(failed['actual_application']) == A.bind(prep['parent_application']) and failed['Source_snapshot'] == source and failed['actual_exit_code'] == 101, 'failed workflow ancestry differs')
    row = prep['application'][0]; name = row['canonical_path']
    old = A.members(source, current=True)
    before, body = A.bind(row['before_archive']).read_bytes(), A.bind(row['proposal']).read_bytes()
    A.need(len(prep['application']) == 1 and row['new_destination_absent'] is False and A.bind(row['actual_before']).read_bytes() == before, 'single current-before correction required')
    A.need(body == before.replace(b'use ep_model::{SurfaceId, TypedModel};', b'#[cfg(test)]\nuse ep_model::SurfaceType;\nuse ep_model::{SurfaceId, TypedModel};', 1) and before.count(b'use ep_model::{SurfaceId, TypedModel};') == 1, 'only the two-line test import may change')
    A.check_diff(before, body, row['exact_diff'])
    out = (ROOT / args.output_dir).resolve()
    A.need(out.is_relative_to(ROOT / '.runtime/porting/SRC-06') and not out.exists(), 'fresh ignored correction directory required')
    recorder = module('actual_Source_recorder', A.bind(prep['recorder_Source']))
    A.need(recorder.source_snapshot() == source, 'complete current Source differs')
    out.mkdir(parents=True)
    actual = dict(row, actual_before_archive=A.write(out / 'before.rs', before), actual_literal_archive=A.write(out / 'literal.rs', body), actual_semantic_diff=A.write(out / 'semantic.diff', A.bind(row['exact_diff']).read_bytes()))
    (ROOT / name).write_bytes(body)
    literal = recorder.source_snapshot(); literal_rows = A.members(literal, current=True)
    A.need(set(old) == set(literal_rows) and len(old) == 3937 and all(old[n] == literal_rows[n] for n in old if n != name), 'correction changed unrelated Source or membership')
    code = subprocess.call([sys.executable, '-X', 'utf8', '-B', str(A.bind(prep['recorder_Source'])), '--output-dir', str(out / 'fmt-command'), '--', 'cargo', 'fmt', '--all'], cwd=ROOT)
    A.need(code == 0, 'formatter failed; literal Source and failed receipt retained')
    final = recorder.source_snapshot(); current = A.members(final, current=True)
    fmt_ref = A.ref(out / 'fmt-command/receipt.json')
    fmt = A.recorded(fmt_ref, literal, ['cargo', 'fmt', '--all'], stable=literal == final)
    A.need(failure['finished_utc'] <= fmt['started_utc'] and set(current) == set(old) and all(old[n] == current[n] for n in old if n != name), 'failed quality must precede correction; unrelated Source must remain literal')
    data = (ROOT / name).read_bytes()
    actual.update(actual_final=A.ref(ROOT / name), actual_final_archive=A.write(out / 'formatted.rs', data), actual_formatter_diff=A.write(out / 'formatter.diff', A.diff(body, data, actual['actual_literal_archive']['path'], name)))
    prior_runtime = A.load(app['runtime_source_bindings'])
    runtime = dict(schema=prior_runtime['schema'], **{key: [A.ref(ROOT / r['path']) for r in prior_runtime[key]] for key in ['observer_sources', 'actual_public_API_sources']})
    runtime_ref = A.dump(out / 'runtime-source-bindings.json', runtime)
    for own in prep['own_sources']: A.bind(own)
    A.members(final, current=True)
    result = dict(schema='src06-tarp-dispatcher-import-actual-application.v1', correction_Source_preparation=A.ref(path), parent_application=prep['parent_application'], parent_formatter_review=prep['parent_formatter_review'], retained_failed_quality=prep['retained_failed_quality'], retained_failed_workflow=prep['retained_failed_workflow'], source_before=source, source_literal=literal, source_final=final, source_file_count=3937, unrelated_source_files_verified_byte_exact=3936, actual_formatter_execution=fmt_ref, application=[actual], runtime_source_bindings=runtime_ref, Native_baseline_acceptance=app['Native_baseline_acceptance'], formatter_correspondence_review_pending=True, target_execution_performed=False, scientific_PASS_claimed=False, ordinary_cadence_activated=False, gates_updated=False)
    print(json.dumps({'record': A.dump(out / 'record.json', result), 'source_final': final}))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

    std::set<int> seen_spaces;
    for (auto const &entry : order) {
        require(entry.is_number_integer(), "Integer space association required"); int const n = entry.get<int>();
        require(n >= 1 && n <= s.dataGlobal->numSpaces && seen_spaces.insert(n).second, "Unique in-bounds space association required");
        z.spaceIndexes.push_back(n);
    }
    s.dataZoneTempPredictorCorrector->zoneHeatBalance(1).MAT = input_real(zone.at("MAT"));
#define ZONE_REAL(name) z.name = input_real(zone.at(#name));
    ZONE_REAL(CeilingHeight) ZONE_REAL(Volume) ZONE_REAL(FloorArea) ZONE_REAL(MinimumX) ZONE_REAL(MaximumX)
    ZONE_REAL(MinimumY) ZONE_REAL(MaximumY) ZONE_REAL(ExtGrossWallArea) ZONE_REAL(ExtWindowArea)
#undef ZONE_REAL
    z.Multiplier = zone.at("Multiplier").get<int>(); z.ListMultiplier = zone.at("ListMultiplier").get<int>();
    require(z.CeilingHeight > 0 && z.Volume > 0 && z.FloorArea > 0 && z.MaximumX > z.MinimumX && z.MaximumY > z.MinimumY &&
            z.Multiplier > 0 && z.ListMultiplier > 0 && z.ExtGrossWallArea >= 0 && z.ExtWindowArea == 0,
            "Positive exogenous geometry/nonwindow static-setup domain required");
    int const count = static_cast<int>(surfaces.size()); d.TotSurfaces = count;
    d.Surface.allocate(surfaces.size()); d.surfIntConv.allocate(surfaces.size()); d.surfExtConv.allocate(surfaces.size());
    s.dataHeatBalSurf->SurfTempIn.allocate(count); s.dataHeatBalSurf->SurfTempInTmp.allocate(count); s.dataHeatBalSurf->SurfHConvInt.allocate(count);
    d.SurfTAirRef.allocate(count); d.SurfTAirRefRpt.allocate(count); d.SurfAdjacentZone.dimension(count, 0);
    d.SurfEMSOverrideIntConvCoef.dimension(count, false); d.SurfEMSValueForIntConvCoef.dimension(count, 0.0);
    std::set<int> membership;
    for (int i = 1; i <= s.dataGlobal->numSpaces; ++i) {
        auto const &r = spaces.at(static_cast<std::size_t>(i - 1));
        keys(r, {"actual_array_index", "Name", "HTSurfaceFirst", "HTSurfaceLast", "MAT"}); index(r, i);
        auto &sp = h.space(i); sp.Name = r.at("Name").get<std::string>(); sp.zoneNum = 1;
        sp.HTSurfaceFirst = r.at("HTSurfaceFirst").get<int>(); sp.HTSurfaceLast = r.at("HTSurfaceLast").get<int>();
        sp.WindowSurfaceFirst = 1; sp.WindowSurfaceLast = 0;
        require((sp.HTSurfaceFirst == 1 && sp.HTSurfaceLast == 0) ||
                (sp.HTSurfaceFirst >= 1 && sp.HTSurfaceLast >= sp.HTSurfaceFirst && sp.HTSurfaceLast <= count), "Actual HT inclusive range required");
        for (int n = sp.HTSurfaceFirst; n <= sp.HTSurfaceLast; ++n) { require(membership.insert(n).second, "Duplicate surface membership"); }
        s.dataZoneTempPredictorCorrector->spaceHeatBalance(i).MAT = input_real(r.at("MAT"));
    }
    require(membership.size() == surfaces.size(), "Every actual surface must have one declared space owner");
    std::set<std::string> names;
    for (int i = 1; i <= count; ++i) {
        auto const &r = surfaces.at(static_cast<std::size_t>(i - 1));
        keys(r, {"actual_array_index", "Name", "spaceNum", "Class", "model", "CosTilt", "Tilt", "Azimuth", "Area", "GrossArea", "Width", "Height",

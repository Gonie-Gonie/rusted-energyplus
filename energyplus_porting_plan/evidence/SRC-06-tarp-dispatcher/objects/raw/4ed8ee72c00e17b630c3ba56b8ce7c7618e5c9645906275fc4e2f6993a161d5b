        v.Class = cls == "Wall" ? EnergyPlus::DataSurfaces::SurfaceClass::Wall : cls == "Roof" ? EnergyPlus::DataSurfaces::SurfaceClass::Roof : EnergyPlus::DataSurfaces::SurfaceClass::Floor;
        v.OriginalClass = v.Class; v.HeatTransSurf = true; v.ExtBoundCond = EnergyPlus::DataSurfaces::ExternalEnvironment;
        auto const model = r.at("model").get<std::string>(); require(model == "SetByZone" || model == "ASHRAETARP", "Default/explicit TARP only");

        require(v.spaceNum >= 1 && v.spaceNum <= s.dataGlobal->numSpaces &&
                i >= h.space(v.spaceNum).HTSurfaceFirst && i <= h.space(v.spaceNum).HTSurfaceLast, "Surface/space association differs");
        auto const cls = r.at("Class").get<std::string>();

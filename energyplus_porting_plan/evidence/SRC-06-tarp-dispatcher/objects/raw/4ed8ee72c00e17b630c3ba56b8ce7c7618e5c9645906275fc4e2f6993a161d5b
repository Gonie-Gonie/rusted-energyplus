    s.dataZoneTempPredictorCorrector->spaceHeatBalance.allocate(spaces.size());
    s.dataZoneEquip->ZoneEquipConfig.allocate(1);
    s.dataConstruction->Construct.allocate(1);
    require(!s.dataConstruction->Construct(1).TypeIsWindow, "Genuine default nonwindow construction required");
    auto &z = h.Zone(1); z.Name = zone.at("Name").get<std::string>();
    z.IntConvAlgo = EnergyPlus::Convect::HcInt::ASHRAETARP;

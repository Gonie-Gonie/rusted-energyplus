std::string read_bytes(fs::path const &path)
{
    std::ifstream in(path, std::ios::binary); require(in.is_open(), "Cannot read physical input");
    std::ostringstream bytes; bytes << in.rdbuf(); require(!in.bad(), "Cannot read complete physical input"); return bytes.str();
}
void index(json const &row, int expected)
{
    require(row.at("actual_array_index").is_number_integer() && row.at("actual_array_index").get<std::int64_t>() == expected,
            "Contiguous one-based literal owner index required");
}
struct ConsoleCapture {
    std::ostringstream text;
    std::streambuf *previous = nullptr;
    ConsoleCapture() : previous(std::cout.rdbuf(text.rdbuf())) {}
    ~ConsoleCapture() { std::cout.rdbuf(previous); }
    ConsoleCapture(ConsoleCapture const &) = delete;
    ConsoleCapture &operator=(ConsoleCapture const &) = delete;
};
struct Fixture {
    ConsoleCapture console;
    std::unique_ptr<EnergyPlus::EnergyPlusData> state;
    std::ostringstream *error = nullptr;
    json callbacks = json::array(), calls = json::array();
    std::size_t callback_count = 0, actual_calls = 0;
    bool callback_integrity_failed = false, stopped = false;
    Fixture() : state(std::make_unique<EnergyPlus::EnergyPlusData>())
    {
        auto sink = std::make_unique<std::ostringstream>(); error = sink.get(); state->files.err_stream = std::move(sink);
        state->files.eio.open_as_stringstream();
        state->dataGlobal->errorCallback = [this](EnergyPlus::Error level, std::string const &text) noexcept {
            callback("errorCallback", static_cast<int>(level), text);
        };
        state->dataGlobal->messageCallback = [this](std::string const &text) noexcept { callback("messageCallback", std::nullopt, text); };
        state->init_constant_state(*state);
    }
    Fixture(Fixture const &) = delete;
    Fixture &operator=(Fixture const &) = delete;
    void callback(char const *kind, std::optional<int> level, std::string const &text) noexcept
    {
        if (callback_count == std::numeric_limits<std::size_t>::max()) { callback_integrity_failed = true; return; }
        ++callback_count;
        try {
            callbacks.push_back({{"actual_ordinal", callback_count}, {"kind", kind},
                                 {"level", level ? json(*level) : json(nullptr)}, {"message", text}});
        } catch (...) { callback_integrity_failed = true; }
    }
    json snapshot() const
    {
        return {{"owner", Dispatcher::owners(*state)}, {"error_stream", error->str()}, {"eio", state->files.eio.get_output()},
                {"console", console.text.str()}, {"callbacks", callbacks}, {"actual_callback_count", callback_count},
                {"callback_integrity_failed", callback_integrity_failed}};
    }
    template<class Call> void invoke(std::string const &id, char const *api, Call const &call)
    {
        auto const before = snapshot(); bool returned = false; json exception = nullptr; ++actual_calls;
        try { call(); returned = true; }
        catch (EnergyPlus::FatalError const &e) { exception = {{"kind", "OriginalFatalError"}, {"message", e.what()}}; }
        catch (std::exception const &e) { exception = {{"kind", "std_exception"}, {"message", e.what()}}; }
        catch (...) { exception = {{"kind", "nonstandard_exception"}, {"message", nullptr}}; }
        stopped = !returned;
        calls.push_back({{"operation_id", id}, {"actual_call_ordinal", actual_calls}, {"api", api}, {"actual_source_invoked", true},
                         {"actual_source_return_observed", returned}, {"source_exception", exception}, {"before", before}, {"after", snapshot()}});
    }
    void transport(fs::path const &input, fs::path const &output)
    {
        state->dataStrGlobals->inputFilePath = input; state->dataStrGlobals->outDirPath = output;
        state->dataStrGlobals->outputPerfLogFilePath = output / "eplusout_perflog.csv";
        state->files.outputErrFilePath = output / "eplusout.err";
        state->files.sln.filePath = output / "eplusout.sln"; state->files.dxf.filePath = output / "eplusout.dxf";
        state->files.sci.filePath = output / "eplusout.sci"; state->files.wrl.filePath = output / "eplusout.wrl";
        state->files.endFile.filePath = output / "eplusout.end";
        require(!state->dataGlobal->isEpJSON && state->dataGlobal->preserveIDFOrder &&
                !state->dataGlobal->outputEpJSONConversion && !state->dataGlobal->outputEpJSONConversionOnly,
                "Actual raw-IDF preserved-order no-conversion constructor context required");
    }
};
void prepare(Fixture &f, json const &v)

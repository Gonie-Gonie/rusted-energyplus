"""Seal only the approved historical archive size custody correction."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-comparison-prep-04'
PARENT = ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-comparison-prep-03/manifest.json'

def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))

def checked(row):
    path = ROOT / row['path']; current = ref(path)
    assert current['sha256'] == row['sha256'] and ('size_bytes' not in row or current['size_bytes'] == row['size_bytes'])
    return path

def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)

def delta(before, after, name):
    raw = ''.join(difflib.unified_diff(checked(before).read_text(encoding='utf8').splitlines(True), checked(after).read_text(encoding='utf8').splitlines(True), fromfile=before['path'], tofile=after['path'])).encode()
    return write(OUT / 'diffs' / name, raw)

parent_ref = ref(PARENT)
assert parent_ref['sha256'] == '6b9248a0b4e2fb21df5eb87533aae502f273710e0d42aeb3a24049b10fa2ab94'
parent = json.loads(checked(parent_ref).read_bytes())
before_custody = parent['runtime_interfaces']['custody_Source']
old = checked(before_custody).read_bytes()
needle = b"row['historical']['size_bytes'] == row['actual_archive']['size_bytes']"
replacement = b"row['historical']['size_bytes'] == N.full(N.bind(row['actual_archive']))['size_bytes']"
assert old.count(needle) == 1
new = old.replace(needle, replacement)
assert new.replace(replacement, needle) == old
ast.parse(new); ast.parse(Path(__file__).read_bytes())
before_rows = [write(OUT / 'before' / 'manifest.json', PARENT.read_bytes()), write(OUT / 'before' / 'custody.py', old), write(OUT / 'before' / 'README.md', checked(parent['README']).read_bytes())]
custody = write(OUT / 'custody.py', new)
readme = write(OUT / 'README.md', b'''# Dispatcher comparison04 - held custody correction

The comparer and owner projection remain the exact physical01 files. The new custody04 file changes only the historical BUILD archive size lookup: existing N.bind verifies the full archive SHA, and N.full obtains its actual byte size. Both the declared historical SHA and size must still match the authentic archive. An archive descriptor need not itself repeat optional size metadata.

Policy ff49, validation04, application02, Rust03, the immutable observer request parent, the complete 8/20/700 input contract and every owner/profile/pairing rule remain unchanged. Source03 and all preceding runtime files are immutable. The genuine comparison01 integrity failure and its closed exit2 receipt are retained; scientific endpoint pairing was not performed.

Root invokes the unchanged physical01 compare.py with this04 manifest via --source-preparation path#SHA, the authentic existing seven-key --custody packet, and a fresh --output-dir. No target, comparator or Native/Rust result computation is executed by this Source author. No formulas, tolerances, inputs, scientific scope or gates change.
''')
changes = [dict(actual_before=before_rows[1], proposal=custody, exact_diff=delta(before_rows[1], custody, 'custody.py.diff')), dict(actual_before=before_rows[2], proposal=readme, exact_diff=delta(before_rows[2], readme, 'README.md.diff'))]
failed_report = ref(ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-comparison-01/comparison.json')
failed_execution = ref(ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-comparison-command-01/receipt.json')
assert failed_report['sha256'] == '1f1954abcf7e5b195c5d83662c52b9e9b45db94a8e2e554e17464f76f4457f77'
assert failed_execution['sha256'] == 'b69343801f48a788f21fe22fb08c2c3d66265f34e538bb29ab9aebe5bb566865'
failed = json.loads(checked(failed_report).read_bytes()); command = json.loads(checked(failed_execution).read_bytes())
assert failed['status'] == 'fail-observation-or-custody-integrity' and failed['findings']['endpoint_pairing_performed'] is False and failed['mismatch_count'] == 0 and command['exit_code'] == 2
manifest = copy.deepcopy(parent)
manifest['status'] = 'HELD-Source-only-custody-correction-after-integrity-failure-before-numerical-pairing'
manifest['parent_Source_preparation'] = parent_ref
manifest['runtime_interfaces']['custody_Source'] = custody
manifest['own_sources'] = [row for row in parent['own_sources'] if row != before_custody] + [custody, readme, ref(Path(__file__))]
manifest['README'] = readme
manifest['author_source'] = ref(Path(__file__))
manifest['narrow_source_correspondence'] = changes
manifest['before_parent_manifest'] = before_rows[0]
manifest['retained_integrity_failure'] = dict(actual_comparison=failed_report, actual_execution=failed_execution, scientific_endpoint_pairing_performed=False)
manifest['dependencies'] += [parent_ref, before_custody, parent['README'], failed_report, failed_execution]
manifest['sole_runtime_delta'] = 'Resolve the actual full historical archive size through existing N.full/N.bind; preserve declared historical SHA and size equality.'
for row in manifest['own_sources']: checked(row)
for row in manifest['dependencies']: checked(row)
print(json.dumps(write(OUT / 'manifest.json', (json.dumps(manifest, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())))

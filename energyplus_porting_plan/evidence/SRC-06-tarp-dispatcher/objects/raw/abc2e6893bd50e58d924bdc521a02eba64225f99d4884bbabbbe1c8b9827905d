import argparse
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def operand(token):
    name, sha = token.rsplit('#', 1); path = (ROOT / name).resolve()
    assert path.is_relative_to(ROOT) and ref(path)['sha256'] == sha
    return ref(path), json.loads(path.read_bytes())


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def dump(path, value):
    return write(path, (json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())


def body(old_dir, new_dir, name, raw):
    old = (old_dir / name).read_bytes()
    prior = write(new_dir / 'before' / name, old)
    current = write(new_dir / name, raw)
    diff = write(new_dir / (name + '.diff'), ''.join(difflib.unified_diff(old.decode().splitlines(True), raw.decode().splitlines(True), fromfile=prior['path'], tofile=current['path'])).encode())
    return current, dict(before=prior, proposal=current, exact_diff=diff)



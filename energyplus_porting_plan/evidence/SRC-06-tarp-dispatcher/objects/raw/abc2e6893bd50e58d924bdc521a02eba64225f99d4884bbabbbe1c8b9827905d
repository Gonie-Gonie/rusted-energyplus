manifest.update(parent_Source_preparation=ref(old_dir / 'manifest.json'), dispatcher_Source_preparation=dispatcher, Root_Source_acceptance=root_ref, independent_Source_acceptance=peer_ref, own_sources=[source, doc, ref(Path(__file__))], exact_Source_diff=correspondence['exact_diff'], authentic_before_archive=correspondence['before'], source_correspondence=correspondence, actual_restore_provenance=ref(BASE / 'dispatcher-owned-restore-01/record.json'))

# Append one unchanged-public-API caller; keep the complete inherited graph.
if(NOT DEFINED SRC06_DISPATCHER_SOURCE_DIR OR NOT DEFINED SRC06_DISPATCHER_INHERITED_RECIPE)
  message(FATAL_ERROR "SRC06 dispatcher requires reviewed Source and authentic inherited recipe")
endif()
include("${SRC06_DISPATCHER_INHERITED_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_src06_dispatcher_scheduled GLOBAL PROPERTY SRC06_DISPATCHER_REFERENCE_SCHEDULED)
  if(NOT _src06_dispatcher_scheduled)
    set_property(GLOBAL PROPERTY SRC06_DISPATCHER_REFERENCE_SCHEDULED TRUE)
    function(src06_add_dispatcher_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "SRC06 dispatcher requires unchanged Original energypluslib")
      endif()
      get_target_property(_src06_dispatcher_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_src06_dispatcher_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      list(APPEND _src06_dispatcher_defs ${_src06_dispatcher_directory_defs})
      list(FILTER _src06_dispatcher_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _src06_dispatcher_defs)
      add_executable(src06_tarp_dispatcher_helper "${SRC06_DISPATCHER_SOURCE_DIR}/tarp_dispatcher_helper.cpp")
      target_include_directories(src06_tarp_dispatcher_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${SRC06_DISPATCHER_SOURCE_DIR}")
      target_compile_definitions(src06_tarp_dispatcher_helper PRIVATE ${_src06_dispatcher_defs})
      target_link_libraries(src06_tarp_dispatcher_helper PRIVATE energypluslib project_options project_fp_options project_warnings bcrypt)
      target_compile_features(src06_tarp_dispatcher_helper PRIVATE cxx_std_20)
      target_link_options(src06_tarp_dispatcher_helper PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/src06_tarp_dispatcher_helper.map")
    endfunction()
    cmake_language(DEFER CALL src06_add_dispatcher_reference)
  endif()
endif()

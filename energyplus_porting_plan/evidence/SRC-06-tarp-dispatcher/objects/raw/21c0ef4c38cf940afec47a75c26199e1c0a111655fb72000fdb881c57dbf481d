"""Root-only six dispatcher and two observer literal copies, after actual CLI/Native release; one fmt."""
import argparse
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[4]


def module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    value = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(value)
    return value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['source-preparation', 'CLI-validation', 'CLI-production-execution', 'output-dir']:
        parser.add_argument('--' + name, required=True)
    args = parser.parse_args()
    import hashlib
    name, sha = args.source_preparation.rsplit('#', 1)
    prep_path = (ROOT / name).resolve()
    if not prep_path.is_relative_to(ROOT) or hashlib.sha256(prep_path.read_bytes()).hexdigest() != sha:
        raise ValueError('reviewed applicator manifest differs')
    prep = json.loads(prep_path.read_bytes())
    helper = prep['shared_custody_Source']
    helper_path = (ROOT / helper['path']).resolve()
    if not helper_path.is_relative_to(ROOT) or hashlib.sha256(helper_path.read_bytes()).hexdigest() != helper['sha256']:
        raise ValueError('reviewed custody helper differs')
    A = module('reviewed_custody', helper_path)
    A.need(A.ROOT == ROOT and prep['schema'] == 'src06-tarp-dispatcher-application-Source-preparation.v1', 'actual preparation scope differs')
    for own in prep['own_sources']:
        A.bind(own)
    A.need(A.bind(prep['runtime_interfaces']['apply']) == Path(__file__).resolve(), 'actual applicator Source differs')
    prep_ref = A.ref(prep_path)
    source, held_ref = prep['source_before'], prep['dispatcher_Source_preparation']
    held = A.load(held_ref)
    observer_ref = prep['observer_Source_preparation']
    observer = A.load(observer_ref)
    A.need(observer_ref['sha256'] == '00bedf159b8886992ad47caad6095a30840d327dc7a7db15e22fcf98452472ad', 'exact reviewed observer02 required')
    observer_peer = A.load(prep['observer_independent_Source_acceptance'])
    A.need(observer_peer['accepted'] is True and A.bind(observer_peer['Source_preparation']) == A.bind(observer_ref), 'independent cumulative observer Source acceptance required')
    A.bind(observer['prospective_pair_policy'])
    A.need(held_ref['sha256'] == '75db177e8d881a7b3edfaccccbcae407f5ba6c2fdbbc09280964d5767087bbd4', 'exact reviewed dispatcher02 required')
    root_review, peer_review = A.load(prep['Root_Source_acceptance']), A.load(prep['independent_Source_acceptance'])
    A.need(root_review['Root_FULL_Source_accepted'] is True and peer_review['narrow_successor_FULL_review_accepted'] is True, 'both complete Source acceptances required')
    A.need(A.bind(root_review['reviewed_manifest']) == A.bind(held_ref) == A.bind(peer_review['reviewed_Source_preparation']), 'accepted Source authority differs')
    native_ref = prep['Native_baseline_acceptance']
    native = A.load(native_ref)
    A.need(native['schema'] == 'src06-tarp-dispatcher-Root-factual-baseline-acceptance.v1' and native['accepted'] is True and native['complete_input_owner_prefix_and_custody_review_accepted'] is True, 'genuine Native factual release required')
    for key in ['factual_review', 'actual_custody', 'actual_provider_acceptance', 'independent_FULL_factual_review', 'release_Source']:
        A.bind(native[key])
    actual_native = A.load(native['actual_Native_execution'])
    A.recorded(native['actual_Native_execution'], native['Source_snapshot'], actual_native['command'])
    cli = A.load(prep['actual_CLI_application'])
    A.need(cli['schema'] == 'src05-ordinary-main-thread-actual-application.v1' and cli['source_final'] == source and cli['source_file_count'] == 3931, 'actual CLI parent differs')
    validation_ref, production_ref = A.operand(args.CLI_validation), A.operand(args.CLI_production_execution)
    validation = A.load(validation_ref)
    A.need(validation['schema'] == 'src05-ordinary-main-thread-actual-quality-and-artifacts.v1' and validation['Source_snapshot'] == source and A.bind(validation['actual_application']) == A.bind(prep['actual_CLI_application']), 'same-Source actual CLI validation required')
    V = module('reviewed_CLI_validator', A.bind(prep['CLI_validation_Source']))
    A.need(set(validation['quality_executions']) == set(V.QUALITY), 'all four actual CLI quality receipts required')
    for role, command in V.QUALITY.items():
        A.recorded(validation['quality_executions'][role], source, command)
    artifact = validation['actual_Cargo_artifacts']['CLI']
    A.need(artifact['PE_inspection']['stack_reserve_bytes'] == 8388608 and artifact['cargo_message']['target']['name'] == 'eplus-rs', 'actual emitted CLI and main stack required')
    A.need(artifact['PE_inspection']['actual_binary'] == artifact['executable'], 'actual PE/emitted binary identity differs')
    binary = A.bind(artifact['executable'])
    build = A.load(artifact['actual_build_execution'])
    A.recorded(artifact['actual_build_execution'], source, build['command'])
    A.bind(artifact['actual_full_Cargo_JSON']); A.bind(artifact['PE_inspection']['actual_PE_header_bytes'])
    production = A.load(production_ref)
    A.recorded(production_ref, source, production['command'])
    A.need((ROOT / production['command'][0]).resolve() == binary and build['finished_utc'] <= production['started_utc'], 'actual emitted CLI production invocation must follow build')
    A.need(all(A.load(r)['finished_utc'] <= build['started_utc'] for r in validation['quality_executions'].values()), 'actual four quality commands must precede CLI build')
    old = A.members(source, current=True)
    A.need(source['sha256'] == '00bfa56db38bf31ce1f11772b0c0d5cd0479d707fa80c6b3e20a54252db1fd0a' and len(old) == 3931, 'exact CLI-after full Source required')
    rows = [dict(r, source_preparation=held_ref) for r in held['application_sources']] + [dict(r, source_preparation=observer_ref) for r in observer['application_sources']]
    paths = [r['canonical_path'] for r in rows]
    A.need(len(paths) == len(set(paths)) == 8 and paths == prep['application_paths'], 'exact eight held paths required')
    for row in rows:
        canonical = ROOT / row['canonical_path']
        body = A.bind(row['proposal']).read_bytes()
        before = b'' if row['new_destination_absent'] else A.bind(row['before_archive']).read_bytes()
        A.check_diff(before, body, row['exact_diff'])
        if row['new_destination_absent']:
            A.need(not canonical.exists(), 'new destination must be absent')
        else:
            A.need(A.bind(row['actual_before']).read_bytes() == before, 'actual current before differs from reviewed source')
    out = (ROOT / args.output_dir).resolve()
    A.need(out.is_relative_to(ROOT / '.runtime/porting/SRC-06') and not out.exists(), 'fresh ignored output required')
    recorder = module('actual_recorder', A.bind(prep['recorder_Source']))
    A.need(recorder.source_snapshot() == source, 'full Source changed before literal application')
    out.mkdir(parents=True)
    A.dump(out / 'before.json', {'Source_preparation': prep_ref, 'Native_baseline_acceptance': native_ref, 'actual_CLI_validation': validation_ref, 'actual_CLI_production_execution': production_ref, 'source_before': source})
    actual_rows = []
    for row in rows:
        name = row['canonical_path']
        before = b'' if row['new_destination_absent'] else A.bind(row['before_archive']).read_bytes()
        actual_rows.append(dict(row, actual_before_archive=A.write(out / 'before' / name, before), actual_literal_archive=A.write(out / 'literal' / name, A.bind(row['proposal']).read_bytes()), actual_semantic_diff=A.write(out / 'semantic-diffs' / (name.replace('/', '__') + '.diff'), A.bind(row['exact_diff']).read_bytes())))
    for row in actual_rows:
        path = ROOT / row['canonical_path']; path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(A.bind(row['actual_literal_archive']).read_bytes())
    literal = recorder.source_snapshot()
    literal_rows = A.members(literal, current=True)
    added = {r['canonical_path'] for r in rows if r['new_destination_absent']}
    unrelated = set(old) - set(paths)
    A.need(len(added) == 6 and len(literal_rows) == 3937 and set(literal_rows) == set(old) | added and len(unrelated) == 3929 and all(old[n] == literal_rows[n] for n in unrelated), 'only six dispatcher plus two observer paths may change')
    command = ['cargo', 'fmt', '--all']
    code = subprocess.call([sys.executable, '-X', 'utf8', '-B', str(A.bind(prep['recorder_Source'])), '--output-dir', str(out / 'fmt-command'), '--'] + command, cwd=ROOT)
    A.need(code == 0, 'formatter failed; actual literal files/receipt retained')
    final = recorder.source_snapshot()
    fmt_ref = A.ref(out / 'fmt-command/receipt.json')
    fmt = A.recorded(fmt_ref, literal, command, stable=literal == final)
    A.need(production['finished_utc'] <= fmt['started_utc'] and actual_native['finished_utc'] <= fmt['started_utc'], 'closed CLI production and Native baseline must precede formatting')
    final_rows = A.members(final, current=True)
    A.need(set(final_rows) == set(literal_rows) and all(old[n] == final_rows[n] for n in unrelated), 'formatter changed unrelated Source or membership')
    for row in actual_rows:
        name = row['canonical_path']; data = (ROOT / name).read_bytes()
        row.update(actual_final=A.ref(ROOT / name), actual_final_archive=A.write(out / 'formatted' / name, data), actual_formatter_diff=A.write(out / 'formatter-diffs' / (name.replace('/', '__') + '.diff'), A.diff(A.bind(row['actual_literal_archive']).read_bytes(), data, row['actual_literal_archive']['path'], name)))
    A.load(held_ref); A.load(observer_ref); A.load(native_ref); A.load(validation_ref); A.load(production_ref)
    for own in prep['own_sources']:
        A.bind(own)
    interfaces = observer['runtime_interfaces']
    runtime_bindings = {'schema': interfaces['runtime_source_bindings_schema'],
        'observer_sources': [A.ref(ROOT / p) for p in interfaces['ordered_observer_source_paths']],
        'actual_public_API_sources': [A.ref(ROOT / p) for p in interfaces['ordered_public_API_source_paths']]}
    binding_ref = A.dump(out / 'runtime-source-bindings.json', runtime_bindings)
    A.members(final, current=True); A.bind(observer['prospective_pair_policy'])
    record = {'schema': 'src06-tarp-dispatcher-actual-application.v1', 'Source_preparation': prep_ref, 'dispatcher_Source_preparation': held_ref, 'observer_Source_preparation': observer_ref, 'observer_independent_Source_acceptance': prep['observer_independent_Source_acceptance'], 'runtime_source_bindings': binding_ref, 'Root_Source_acceptance': prep['Root_Source_acceptance'], 'independent_Source_acceptance': prep['independent_Source_acceptance'], 'Native_baseline_acceptance': native_ref, 'actual_CLI_application': prep['actual_CLI_application'], 'actual_CLI_validation': validation_ref, 'actual_CLI_production_execution': production_ref, 'source_before': source, 'source_literal': literal, 'source_final': final, 'actual_formatter_execution': fmt_ref, 'source_file_count': len(final_rows), 'unrelated_source_files_verified_byte_exact': len(unrelated), 'application': actual_rows, 'formatter_correspondence_review_pending': True, 'target_execution_performed': False, 'ordinary_cadence_activated': False, 'scientific_PASS_claimed': False, 'gates_updated': False}
    print(json.dumps({'record': A.dump(out / 'record.json', record), 'source_final': final}))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

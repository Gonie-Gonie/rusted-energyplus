    dependencies = [ref(ROOT / p) for p in references.values()]
    dependencies += native['Native_source_files'] + validation['dependencies'] + [validation['shared_custody_Source'], validation['CLI_validation_Source'], validation['runtime_interfaces']['workflow']]
    dependencies += [r['proposal'] for r in observer['application_sources']]
    dependencies += [ref(ROOT / '.runtime/porting/SRC-06/tarp-inside-selected-comparison-prep-03/compare.py')]
    selected = list(native['selected_source_ranges'])
    extra = [('.reference/energyplus-src/26.1.0/src/EnergyPlus/DataSurfaces.hh', 149, 170, 'Exact Source surface-class enum mapping'), ('.reference/energyplus-src/26.1.0/src/EnergyPlus/ConvectionConstants.hh', 62, 80, 'Exact Source SetByZone and ASHRAETARP IDs'), (observer['application_sources'][0]['proposal']['path'], 1, 288, 'Complete held Rust observer input, invocation and full result serializer'), (observer['application_sources'][1]['proposal']['path'], 1, 174, 'Complete held Rust actual-owner and prefix copier')]
    (OUT / 'source-ranges').mkdir()
    for path, start, end, purpose in extra:
        source = ROOT / path; data = b''.join(source.read_bytes().splitlines(True)[start-1:end])
        target = OUT / 'source-ranges' / (source.name + '.' + str(start) + '-' + str(end) + '.txt'); target.write_bytes(data)
        selected.append(dict(source=ref(source), start_line=start, end_line=end, purpose=purpose, archive=ref(target)))
    (OUT / 'before').mkdir(); (OUT / 'diffs').mkdir()
    correspondence = []
    for name in ['compare.py', 'owners.py', 'custody.py']:
        path = OUT / name; body = path.read_bytes(); ast.parse(body)
        before = OUT / 'before' / name; before.write_bytes(b'')
        delta = ''.join(difflib.unified_diff([], body.decode('utf8').splitlines(True), fromfile='/dev/null', tofile=path.relative_to(ROOT).as_posix())).encode('utf8')
        difference = OUT / 'diffs' / (name + '.diff'); difference.write_bytes(delta)
        correspondence.append(dict(actual_before=ref(before), proposal=ref(path), exact_diff=ref(difference), new_ignored_Source_only=True))
    own = [ref(OUT / p) for p in ['compare.py', 'owners.py', 'custody.py', 'README.md']] + [ref(Path(__file__))]
    unique = {}
    for row in dependencies:
        p = (ROOT / row['path']).resolve(); actual = ref(p)
        assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes'])
        unique[(actual['path'], actual['sha256'])] = actual
    for row in selected:
        source, archive = ROOT / row['source']['path'], ROOT / row['archive']['path']
        assert ref(source)['sha256'] == row['source']['sha256'] and b''.join(source.read_bytes().splitlines(True)[row['start_line']-1:row['end_line']]) == archive.read_bytes()
    manifest = dict(schema='src06-tarp-dispatcher-comparison-Source-preparation.v1', status='HELD-Source-only-before-any-dispatcher-numerical-result-read', **{k: ref(ROOT / p) for k, p in references.items()}, input_only_request=inputs, literal_IDF=idf, prospective_policy=policy, dependencies=list(unique.values()), selected_source_ranges=selected, own_sources=own, exact_source_correspondence=correspondence,
        runtime_interfaces=dict(comparer=ref(OUT / 'compare.py'), owner_Source=ref(OUT / 'owners.py'), custody_Source=ref(OUT / 'custody.py'), required_options=['--source-preparation', '--custody', '--output-dir'], packet_schema='src06-tarp-dispatcher-comparison-custody.v1', packet_keys=['schema', 'prospective_policy', 'Native_baseline_acceptance', 'Rust_execution_custody', 'Rust_launch_execution', 'Root_Rust_factual_review', 'independent_Rust_factual_review'], Rust_factual_review_schema='src06-tarp-dispatcher-Rust-factual-review.v1', Rust_factual_review_required_keys=['accepted', 'actual_custody', 'actual_execution', 'Source_snapshot'], result_schema='src06-selected-tarp-dispatcher-comparison.v1', actual_input_contract=dict(cases=8, Init_calls=20, processInput_calls=8, binary64_cells=700, physical_IDF_bytes=158)), Native_dispatcher_numerical_results_read=False, Rust_dispatcher_numerical_results_read=False, expected_values_supplied=False, target_execution_performed=False, canonical_mutation_performed=False, whole_unit_or_ordinary_PASS_claimed=False, gates_updated=False)
    (OUT / 'manifest.json').write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + '\n', encoding='utf8')
    print(json.dumps({'manifest': ref(OUT / 'manifest.json'), 'own_sources': [(r['path'], r['line_count']) for r in own], 'dependency_count': len(unique), 'ranges': len(selected)}))


if __name__ == '__main__':
    main()

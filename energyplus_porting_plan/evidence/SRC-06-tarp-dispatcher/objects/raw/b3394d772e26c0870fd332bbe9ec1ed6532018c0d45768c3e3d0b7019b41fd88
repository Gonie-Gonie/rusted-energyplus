        'observer_Source_preparation': '.runtime/porting/SRC-06/tarp-dispatcher-observer-prep-02/manifest.json',
        'validation_Source_preparation': '.runtime/porting/SRC-06/tarp-dispatcher-validation-prep-01/manifest.json',
        'Native_baseline_acceptance': '.runtime/porting/SRC-06/tarp-dispatcher-Native-observation-01/Root-baseline-acceptance.json',

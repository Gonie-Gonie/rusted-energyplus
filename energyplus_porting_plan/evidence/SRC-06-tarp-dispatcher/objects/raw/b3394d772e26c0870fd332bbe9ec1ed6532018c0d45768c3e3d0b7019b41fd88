"""Source-only metadata seal; never import or execute the proposed comparer."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-comparison-prep-01'


def ref(path):
    path = path.resolve(); raw = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(raw).hexdigest(), 'size_bytes': len(raw), 'line_count': len(raw.splitlines())}


def load(path):
    return json.loads((ROOT / path).read_bytes())


def main():
    assert not (OUT / 'manifest.json').exists()
    native = load('.runtime/porting/SRC-06/native-tarp-dispatcher-prep-02/manifest.json')
    observer = load('.runtime/porting/SRC-06/tarp-dispatcher-observer-prep-02/manifest.json')

+/// Execute the genuine selected no-user first call, readiness transitions and
+/// opaque TARP traversal. Unsupported branches stop explicitly; success covers
+/// this declared selected domain, never full adaptive/window/user setup.
+pub fn initialize_inside_convection(
+    layout: &InsideConvectionLayout, zones: &[InsideConvectionZone], surfaces: &[InsideConvectionSurface],
+    no_user_input: NoUserConvectionInput, state: &mut InsideConvectionState,
+    temperatures: InsideSurfaceTemperatures<'_>, readiness: InsideConvectionReadiness, actual_low_limit: f64,
+    actual_reports: &ReportInputs, scan: &mut ReportScanState, backend: &mut SourceErrorBackend<'_>,
+) -> Result<(), InsideConvectionError> {
+    validate(layout, zones, surfaces, state, temperatures)?;
+    if no_user_input.counts() != [0; 6] { return Err(InsideConvectionUnavailable::UserConvectionInput.into()); }
+    if state.get_user_input {
+        // GetUser: allocate both zero user curves, then reset/count/allocate
+        // both zero surface model arrays, reset counts, and run static setup.
+        state.user_arrays[0] = Some(Vec::new()); state.user_arrays[1] = Some(Vec::new());
+        state.user_model_counts = [0; 2];
+        state.user_arrays[2] = Some(Vec::new()); state.user_arrays[3] = Some(Vec::new());
+        state.user_model_counts = [0; 2];
+        setup_static(layout, zones, surfaces, state)?;
+        let details = try_scan_for_reports(actual_reports, scan, "Surfaces", Some("Details"), None, None,
+            |diagnostic| match diagnostic {
+                ReportScanDiagnostic::Warning(message) => backend.show_warning_error(&message),
+                ReportScanDiagnostic::Continue(message) => backend.show_continue_error(&message),
+            }).map_err(|error| match error {
+                ReportScanFailure::Unavailable(value) => InsideConvectionError::Scan(value),
+                ReportScanFailure::Diagnostic(value) => InsideConvectionError::Backend(value),
+            })?;
+        if details { return Err(InsideConvectionUnavailable::SurfaceDetailsReport.into()); }
+        state.get_user_input = false;
+    }
+    if state.node_check && !readiness.system_sizing && !readiness.zone_sizing
+        && readiness.equipment_inputs_filled && readiness.nodes_allocated {
+        // Every genuine admitted zone is TARP: the CeilingDiffuser warning
+        // loop makes no writes; do not infer readiness from that fact.
+        state.node_check = false;
+    }
+    if state.active_surface_check && !readiness.system_sizing && !readiness.zone_sizing && readiness.equipment_simulated_once {
+        for (zone, active) in &mut state.active_elements {
+            let mut count = [0; 3]; let mut area = [0.0; 3];
+            for group in layout.groups().iter().filter(|g| g.zone_id == *zone) {
+                for id in &group.surfaces {
+                    let index = state.surfaces.iter().position(|r| r.surface_id == *id).ok_or(InsideConvectionUnavailable::Association)?;
+                    if !state.surfaces[index].radiant_and_active[1] { continue; }
+                    let kind = match surfaces[index].class { SurfaceType::Wall => 0, SurfaceType::Roof | SurfaceType::Ceiling => 1, SurfaceType::Floor => 2 };
+                    count[kind] += 1; area[kind] += surfaces[index].area;
+                }
+            }
+            *active = std::array::from_fn(|i| count[i] > 0 && area[i] > 0.0);
+        }
+        state.active_surface_check = false;
+    }
+    // Both actual surface model alternatives and every admitted zone are TARP;
+    // the BeginEnvrn adaptive search is genuinely false, so Node reset is not reached.
+    if readiness.begin_environment && state.my_environment { state.my_environment = false; }
+    if !readiness.begin_environment { state.my_environment = true; }
+    for group in layout.groups() {
+        let mat = state.space_air.rows.iter().find(|r| r.space_id == group.space_id).ok_or(InsideConvectionUnavailable::Association)?.mat;
+        for id in &group.surfaces {
+            let index = state.surfaces.iter().position(|r| r.surface_id == *id).ok_or(InsideConvectionUnavailable::Association)?;
+            // SetByZone is a local resolution only: retain the actual model owner.
+            let mut coefficient = detailed_inside_coefficient_w_per_m2_k(temperatures.rows[index].1, mat,
+                surfaces[index].outward_cos_tilt, actual_low_limit);
+            // The caller's second strict lower-limit check is distinct and retained.
+            if coefficient < actual_low_limit { coefficient = actual_low_limit; }
+            state.surfaces[index].coefficient = coefficient;
+        }
+    }
+    // Actual WindowSurface ranges are empty in this selected opaque domain.
+    Ok(())
+}

+fn setup_static(layout: &InsideConvectionLayout, zones: &[InsideConvectionZone], surfaces: &[InsideConvectionSurface],
+    state: &mut InsideConvectionState) -> Result<(), InsideConvectionUnavailable> {
+    let mut building_volume = 0.0;
+    for zone in zones {
+        building_volume += zone.volume * f64::from(zone.multiplier) * f64::from(zone.list_multiplier);
+        let mut perimeter = 0.0;
+        let [xmin, xmax, ymin, ymax] = zone.xy_bounds;
+        let simple_perimeter = 2.0 * (ymax - ymin) + 2.0 * (xmax - xmin);
+        let diameter = if simple_perimeter > 0.0 { 4.0 * zone.floor_area / simple_perimeter }
+            else { zone.floor_area.sqrt() };
+        let ratio = if zone.exterior_gross_wall_area > 0.0 { zone.exterior_window_area / zone.exterior_gross_wall_area } else { -999.0 };
+        for group in layout.groups().iter().filter(|g| g.zone_id == zone.zone_id) {
+            for id in &group.surfaces {
+                let surface = surfaces.iter().find(|r| r.surface_id == *id).ok_or(InsideConvectionUnavailable::Association)?;
+                if surface.exterior && surface.class == SurfaceType::Wall { perimeter += surface.width; }
+            }
+        }
+        for group in layout.groups().iter().filter(|g| g.zone_id == zone.zone_id) {
+            for id in &group.surfaces {
+                let row = state.surfaces.iter_mut().find(|r| r.surface_id == *id).ok_or(InsideConvectionUnavailable::Association)?;
+                row.interior_geometry = [zone.ceiling_height, perimeter, diameter, ratio];
+            }
+        }
+        // ExtWindowCount is genuinely zero in this admitted opaque domain.
+    }
+    state.cube_root_building_volume = building_volume.powf(1.0 / 3.0);
+    let roof = geometry::roof(surfaces);
+    state.roof_long_axis_outward_azimuth = roof.azimuth;
+    let facades = geometry::facades(surfaces)?;
+    for (surface, row) in surfaces.iter().zip(&mut state.surfaces) {
+        if !surface.exterior || !surface.heat_transfer { continue; }
+        // This distinct extrema loop retains Original's else-if ordering.
+        let mut low = f64::MAX; let mut high = -f64::MAX;
+        for p in &surface.vertices { if p[2] < low { low = p[2]; } else if p[2] > high { high = p[2]; } }
+        let height = high - low;
+        row.exterior_geometry = if surface.tilt >= 45.0 && surface.tilt < 135.0 {
+            let facade = facades[geometry::compass(surface.azimuth)?];
+            [geometry::source_max(facade.area, surface.gross_area), geometry::source_max(facade.perimeter, surface.perimeter),
+                geometry::source_max(facade.height, height)]
+        } else if surface.tilt < 45.0 {
+            [geometry::source_max(roof.area, surface.gross_area), geometry::source_max(roof.perimeter, surface.perimeter),
+                geometry::source_max(roof.height, height)]
+        } else { [surface.gross_area, surface.perimeter, height] };
+    }
+    Ok(())
+}

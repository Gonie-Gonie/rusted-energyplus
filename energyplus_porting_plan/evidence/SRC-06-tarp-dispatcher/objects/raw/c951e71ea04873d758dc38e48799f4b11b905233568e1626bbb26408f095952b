+fn validate(layout: &InsideConvectionLayout, zones: &[InsideConvectionZone], surfaces: &[InsideConvectionSurface],
+    state: &InsideConvectionState, temperatures: InsideSurfaceTemperatures<'_>) -> Result<(), InsideConvectionUnavailable> {
+    state.space_air.validate(layout)?;
+    if state.layout != *layout || zones.iter().map(|r| r.zone_id).ne(layout.zones().iter().copied())
+        || state.active_elements.iter().map(|r| r.0).ne(layout.zones().iter().copied())
+        || surfaces.iter().map(|r| r.surface_id).ne(layout.surfaces().iter().map(|r| r.surface_id))
+        || state.surfaces.iter().map(|r| r.surface_id).ne(layout.surfaces().iter().map(|r| r.surface_id)) {
+        return Err(InsideConvectionUnavailable::Association);
+    }
+    if temperatures.rows.iter().map(|r| r.0).ne(layout.surfaces().iter().map(|r| r.surface_id)) {
+        return Err(InsideConvectionUnavailable::TemperatureOwner);
+    }
+    for zone in zones {
+        let [xmin, xmax, ymin, ymax] = zone.xy_bounds;
+        if !zone.tarp { return Err(InsideConvectionUnavailable::AlgorithmOrSurface); }
+        if ![zone.ceiling_height, zone.volume, zone.floor_area, xmin, xmax, ymin, ymax,
+            zone.exterior_gross_wall_area, zone.exterior_window_area].iter().all(|v| v.is_finite())
+            || zone.ceiling_height <= 0.0 || zone.volume <= 0.0 || zone.floor_area <= 0.0
+            || xmax <= xmin || ymax <= ymin || zone.multiplier <= 0 || zone.list_multiplier <= 0
+            || zone.exterior_gross_wall_area < 0.0 || zone.exterior_window_area != 0.0 {
+            return Err(InsideConvectionUnavailable::Geometry);
+        }
+    }
+    for surface in surfaces {
+        if !surface.heat_transfer || surface.construction_is_window || surface.kiva
+            || surface.representative_calculations || surface.ems_override {
+            return Err(InsideConvectionUnavailable::AlgorithmOrSurface);
+        }
+        if ![surface.outward_cos_tilt, surface.tilt, surface.azimuth, surface.area, surface.gross_area,
+            surface.width, surface.perimeter].iter().all(|v| v.is_finite())
+            || !(-1.0..=1.0).contains(&surface.outward_cos_tilt) || !(0.0..=180.0).contains(&surface.tilt)
+            || !(0.0..360.0).contains(&surface.azimuth) || surface.area <= 0.0 || surface.gross_area <= 0.0
+            || surface.width <= 0.0 || surface.perimeter <= 0.0 || surface.vertices.len() < 3
+            || surface.vertices.iter().flatten().any(|v| !v.is_finite()) {
+            return Err(InsideConvectionUnavailable::Geometry);
+        }
+        if surface.exterior && surface.tilt <= 45.0 && surface.vertices.iter().enumerate()
+            .any(|(i, p)| {
+                let next = surface.vertices[(i + 1) % surface.vertices.len()];
+                let t = std::array::from_fn::<_, 3, _>(|axis| next[axis] - p[axis]);
+                ((t[0] * t[0]) + (t[1] * t[1]) + (t[2] * t[2])).sqrt() == 0.0
+            }) {
+            // Original normalize asserts computed length != 0, including underflow.
+            // A computed +Inf length remains admitted and follows Source IEEE operations.
+            return Err(InsideConvectionUnavailable::Geometry);
+        }
+    }
+    Ok(())
+}

+    pub fn write_all(&mut self, layout: &InsideConvectionLayout, rows: &[SpaceAirTemperature]) -> Result<(), InsideConvectionUnavailable> {
+        if rows.len() != layout.spaces().len() || rows.iter().zip(layout.spaces()).any(|(a, b)| (a.space_id, a.zone_id) != *b) {
+            return Err(InsideConvectionUnavailable::Association);

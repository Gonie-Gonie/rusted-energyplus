+        for row in &mut self.rows { row.mat = 23.0; row.zt = 23.0; row.ztav = 23.0; }
+        Ok(())
+    }
+    /// Actual disabled-space/sizing selected ZT/MAT copy after zone correction.
+    /// No ZTAV write occurs at Original3843–3847; its previous owner is retained.
+    pub fn copy_zone_after_correction(&mut self, layout: &InsideConvectionLayout, zone_id: ZoneId, zone_zt: f64, zone_mat: f64)
+        -> Result<(), InsideConvectionUnavailable> {
+        self.validate(layout)?;
+        if !layout.zones().contains(&zone_id) { return Err(InsideConvectionUnavailable::Association); }
+        for group in layout.groups().iter().filter(|g| g.zone_id == zone_id) {
+            let row = self.rows.iter_mut().find(|r| r.space_id == group.space_id)
+                .ok_or(InsideConvectionUnavailable::Association)?;
+            row.zt = zone_zt; row.mat = zone_mat;
+        }
+        Ok(())
+    }
+    fn validate(&self, layout: &InsideConvectionLayout) -> Result<(), InsideConvectionUnavailable> {
+        if self.rows.len() != layout.spaces().len() || self.rows.iter().zip(layout.spaces()).any(|(a, b)| (a.space_id, a.zone_id) != *b) {
+            return Err(InsideConvectionUnavailable::Association);
+        }
+        Ok(())
+    }
+}

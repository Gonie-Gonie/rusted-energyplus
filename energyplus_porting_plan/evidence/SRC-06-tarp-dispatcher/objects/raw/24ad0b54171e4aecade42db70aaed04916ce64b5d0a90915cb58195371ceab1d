C = O = K = None
UNMATCHED = []


def module(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value)
    return value


def absent(path, reason, details=None, required=True):
    C.UNAVAILABLE.append({'path': path, 'reason': reason, 'required_for_selected_pair': required, 'counted_as_PASS': False, 'details': details})


def indexed(rows, field, expected, path):
    C.need(isinstance(rows, list), 'complete actual ordered ledger required')
    result = {}
    for i, row in enumerate(rows):
        C.need(isinstance(row, dict) and type(row.get(field)) is str, 'actual identity required')
        key = row[field]
        if key in result: UNMATCHED.append({'path': path, 'identity': key, 'reason': 'duplicate-actual-identity', 'ordinal': i, 'required': True, 'counted_as_PASS': False})
        else: result[key] = row
        if key not in expected: UNMATCHED.append({'path': path, 'identity': key, 'reason': 'unexpected-actual-identity', 'required': True, 'counted_as_PASS': False})
    for key in expected:
        if key not in result: UNMATCHED.append({'path': path, 'identity': key, 'reason': 'missing-required-identity', 'required': True, 'counted_as_PASS': False})
    return result


def physical(case, idf, side, path):
    C.need(case['physical_IDF_bytes_unchanged'] is True, 'literal physical IDF custody failed')
    for key in ['physical_IDF_before', 'physical_IDF_after']:
        row = case[key]
        C.need(row['sha256'] == idf['sha256'] and row['size_bytes'] == idf['size_bytes'], 'complete physical IDF SHA/size differs')
        C.exact(row)
    K.same(case['physical_IDF_before'], case['physical_IDF_after'])
    C.same(case['case_id'], path, path + '/' + side + '/physical-case', 'input_join_comparisons')


def context(snapshot, path, native):
    O.transport(snapshot, native)
    d = snapshot['owner']
    unpaired = {k: d[k] for k in (['Zone', 'space', 'Surface', 'zoneHeatBalance', 'Node_selected_members', 'HighHConvLimit_unread', 'SurfAdjacentZone', 'SurfEMSValueForIntConvCoef'] if native else [])}
    backend_keys = ['VerStringVar', 'IDDVerString', 'CurrentDateTime'] if native else ['VerStringVar', 'IDDVerString', 'Native_header_strings_paired', 'KickOffSimulation', 'DeveloperFlag', 'WarmupFlag', 'DoingSizing']
    unpaired['backend_context'] = {k: d['backend'][k] for k in backend_keys}
    # Full raw result is authoritative; these context owners remain available but unpaired.
    absent(path + '/unpaired-context', 'Native-only-or-authored-header/context; no-paired-PASS', unpaired, False)


def counts(case, native, path):
    name = 'actual_no_user_object_counts' if native else 'actual_raw_object_counts'
    rows = case[name]
    families = ['SurfaceConvectionAlgorithm:Inside:UserCurve', 'SurfaceConvectionAlgorithm:Outside:UserCurve', 'SurfaceProperty:ConvectionCoefficients:MultipleSurface', 'SurfaceProperty:ConvectionCoefficients', 'SurfaceConvectionAlgorithm:Inside:AdaptiveModelSelections', 'SurfaceConvectionAlgorithm:Outside:AdaptiveModelSelections']
    C.need(isinstance(rows, list) and len(rows) == len(families), 'all six actual getter/count rows required')
    for i, (row, family) in enumerate(zip(rows, families), 1):
        O.keys(row, ['actual_validation_getter_ordinal', 'family', 'actual_count'])
        C.need(type(row['actual_validation_getter_ordinal']) is int and type(row['family']) is str and type(row['actual_count']) is int, 'actual count/getter types required')
        C.same({'actual_validation_getter_ordinal': i, 'family': family, 'actual_count': 0}, row, path + '/count/' + family, 'input_join_comparisons')
    return rows


def write_only(before, after):
    expected = copy.deepcopy(before)
    for name in O.READY: expected['owner'][name] = after['owner'][name]
    for name in ['SurfTempIn', 'SurfTempInTmp']: expected['owner'][name] = after['owner'][name]
    for left, right in zip(expected['owner']['spaceHeatBalance']['rows'], after['owner']['spaceHeatBalance']['rows']): left['value']['MAT'] = right['value']['MAT']
    if 'zoneHeatBalance' in expected['owner']: expected['owner']['zoneHeatBalance']['rows'][0]['value']['MAT'] = after['owner']['zoneHeatBalance']['rows'][0]['value']['MAT']
    else: expected['owner']['zoneHeatBalance_MAT_input_owner'] = after['owner']['zoneHeatBalance_MAT_input_owner']
    C.need(expected == after, 'declared input write changed an undeclared owner or transport')


def lane(case, spec, native, policy, path):
    selected = case['actual_calls'][1:] if native else case['actual_calls']
    writes = case['actual_operation_input_writes']; ops = spec['operations']
    C.need(type(case['actual_source_stopped']) is bool, 'actual stopped flag required')
    C.need(len(selected) == len(writes) and case['actual_recorded_outer_call_count' if native else 'actual_recorded_selected_call_count'] == len(case['actual_calls']), 'complete actual call ledger count differs')
    C.same([v['operation_id'] for v in selected], [v['operation_id'] for v in ops[:len(selected)]], path + '/ordered-selected-calls', 'input_join_comparisons')
    C.same([v['operation_id'] for v in writes], [v['operation_id'] for v in selected], path + '/ordered-input-writes', 'input_join_comparisons')
    C.need(len(selected) <= len(ops), 'extra actual selected calls')
    C.same(case['unreached_operations'], ops[len(selected):], path + '/unreached-literal-tail', 'input_join_comparisons')
    previous = case['prepared_literal_owners']; projections = {}
    for i, (write, call) in enumerate(zip(writes, selected), 1):
        key = call['operation_id']; op = next((v for v in ops if v['operation_id'] == key), None)
        C.need(op is not None and write['operation_id'] == key and write['literal_input'] == op, 'complete actual operation input witness differs')
        C.need(write['before_declared_writes'] == previous and call['before'] == write['after_declared_writes'], 'complete actual input/call continuity differs')
        C.need(call['actual_call_ordinal'] == i + int(native) and call['api'] == ('Convect::InitIntConvCoeff' if native else 'initialize_inside_convection') and call['actual_source_invoked'] is True and type(call['actual_source_return_observed']) is bool, 'genuine actual selected API order/return required')
        returned = call['actual_source_return_observed']; error = call['source_exception' if native else 'source_error']
        if native: C.need(error is None if returned else isinstance(error, dict) and error.get('kind') == 'OriginalFatalError' and type(error.get('message')) is str, 'unexpected Native exception/integrity failure')
        else: C.need(error is None if returned else type(error) is str, 'actual typed Rust error/return differs')
        C.need(returned or i == len(selected), 'actual calls continued after source failure')
        write_only(write['before_declared_writes'], write['after_declared_writes'])
        for boundary, snapshot in [('before-write', write['before_declared_writes']), ('after-write', write['after_declared_writes']), ('before', call['before']), ('after', call['after'])]:
            projection = O.project(snapshot, spec, native, policy); context(snapshot, path + '/' + key + '/' + boundary, native)
            if boundary != 'before-write': O.literal_joins(snapshot, projection, spec, op, native, path + '/' + key + '/' + boundary)
            if boundary in ['before', 'after']: projections[(key, boundary)] = projection
        O.prefix(call['before'], call['after'], native)
        previous = call['after']
    C.need(case['final'] == previous and case['actual_source_stopped'] is (bool(selected) and not selected[-1]['actual_source_return_observed']), 'full final/actual stop closure differs')
    O.project(case['final'], spec, native, policy); context(case['final'], path + '/final', native)
    return selected, writes, projections


def compare(prep, packet):
    O.keys(packet, ['schema', 'prospective_policy', 'Native_baseline_acceptance', 'Rust_execution_custody', 'Rust_launch_execution', 'Root_Rust_factual_review', 'independent_Rust_factual_review'])
    C.need(packet['schema'] == 'src06-tarp-dispatcher-comparison-custody.v1', 'reviewed actual comparison custody packet required')
    K.same(packet['prospective_policy'], prep['prospective_policy'])
    policy, request = C.load(prep['prospective_policy']), C.load(prep['input_only_request'])
    C.need(policy['schema'] == 'src06-tarp-dispatcher-Rust-prospective-pair-policy.v1' and policy['exact_copy_rules']['absolute_tolerance'] == policy['exact_copy_rules']['relative_tolerance'] == policy['exact_copy_rules']['ULP_tolerance'] == 0, 'frozen exact prospective policy required')
    cells = []
    def literals(value):
        if isinstance(value, dict):
            if set(value) == {'bits'}: cells.append(O.normalized_literal(value))
            else:
                for child in value.values(): literals(child)
        elif isinstance(value, list):
            for child in value: literals(child)
    literals(request['cases'])
    C.need(len(request['cases']) == 8 and sum(len(v['operations']) for v in request['cases']) == 20 and len(cells) == 700, 'complete prospective literal input contract required')
    nreceipt, nbefore, release = K.native(prep, packet)
    rreceipt, rguard, binding, totals = K.rust(prep, packet, nreceipt)
    native, rust = C.load(nreceipt['stdout']), C.load(rreceipt['stdout'])
    C.need(native['schema'] == 'src06-tarp-dispatcher-direct-results.v1' and rust['schema'] == 'src06-tarp-dispatcher-Rust-observer-results.v1', 'complete actual result schemas differ')
    K.same(native['request_before'], prep['input_only_request']); K.same(native['request_after'], prep['input_only_request'])
    K.same(rust['literal_request'], prep['input_only_request']); K.same(rust['prospective_pair_policy'], prep['prospective_policy'])
    C.same(C.load(binding['runtime_sources']), rust['actual_runtime_sources'], 'Rust/actual-runtime-sources', 'input_join_comparisons')
    C.same({k: binding[v] for k, v in [('ledger', 'conversion_ledger'), ('execution', 'conversion_execution'), ('recorded_command', 'conversion_command_receipt')]}, rust['conversion_proof'], 'Rust/actual-conversion-proof', 'input_join_comparisons')
    C.need(rust['input_binding_sha256'] == rguard['input_binding']['sha256'], 'Rust actual invocation SHA witness differs')
    for result in [native, rust]:
        C.need(result['requested_case_count'] == result['recorded_case_count'] == len(result['cases']) and result['scientific_PASS_claimed'] is False and result['gates_updated'] is False and result['inner_surface_visit_trace_available'] is False, 'actual root count/scope differs')
    C.need(native['Original_bodies_modified'] is False and rust['ordinary_production_handoff_verified'] is False, 'actual root scope differs')
    ids = [v['case_id'] for v in request['cases']]
    C.need(len(set(ids)) == 8, 'prospective case IDs must be unique')
    nc, rc = indexed(native['cases'], 'case_id', ids, 'Native/cases'), indexed(rust['cases'], 'case_id', ids, 'Rust/cases')
    C.same([v['case_id'] for v in native['cases']], ids, 'Native/full-case-order', 'input_join_comparisons'); C.same([v['case_id'] for v in rust['cases']], ids, 'Rust/full-case-order', 'input_join_comparisons')
    future_pairs, native_stopped, rust_stopped, actual_counts = [], False, False, {'Native_processInput': 0, 'Native_Init': 0, 'Rust_Init': 0}
    native_files, rust_files = [], []
    for spec in request['cases']:
        path = spec['case_id']
        if path not in nc or path not in rc: continue
        n, r = nc[path], rc[path]
        C.same(spec, n['literal_input'], path + '/Native/full-literal-input', 'input_join_comparisons'); C.same(spec, r['literal_input'], path + '/Rust/full-literal-input', 'input_join_comparisons')
        physical(n, prep['literal_IDF'], 'Native', path); physical(r, prep['literal_IDF'], 'Rust', path)
        native_files.extend(n['produced_files_full_SHA_inventory']); rust_files.append(r['physical_IDF_after'])
        for row in n['produced_files_full_SHA_inventory']: C.exact(row)
        for side, case in [('Native', n), ('Rust', r)]:
            C.need(case['inner_surface_visit_trace_available'] is False and case['ordinary_production_handoff_verified'] is False and case['numerical_PASS_claimed'] is False, 'actual case scope differs')
        C.need(r['actual_raw_parser_calls'] == r['actual_compiler_calls'] == 1 and type(r['compiler_diagnostics']) is str and type(r['compiler_report']) is str and r['Native_InputProcessor_semantics_verified'] is False, 'actual parser/compiler once-per-case witnesses required')
        C.same(counts(n, True, path + '/Native'), counts(r, False, path + '/Rust'), path + '/all-six-actual-counts', 'input_join_comparisons')
        C.need(len(n['actual_calls']) >= 1, 'real processInput call absent')
        process = n['actual_calls'][0]; actual_counts['Native_processInput'] += 1
        C.need(process['operation_id'] == 'process-input' and process['api'] == 'InputProcessor::processInput' and process['actual_call_ordinal'] == 1 and process['actual_source_invoked'] is True and process['before'] == n['fresh_constructor_state'], 'genuine fresh processInput invocation required')
        O.transport(process['before'], True); O.transport(process['after'], True); O.prefix(process['before'], process['after'], True)
        C.need(process['actual_source_return_observed'] is True and process['source_exception'] is None, 'actual processInput failed; selected domain unavailable')
        absent(path + '/processInput-and-constructor', 'Native-only actual constructor/InputProcessor call; Rust compiler is independent', {'fresh': n['fresh_constructor_state'], 'call': process}, False)
        for family in policy['full_unavailable_ledger_required']: absent(path + '/coverage/' + family, family, required=False)
        if r['prepared_literal_owners'] is None:
            absent(path, 'actual-typed-input-unavailable', {'compiler_report': r['compiler_report']}); rust_stopped = True
            for op in spec['operations']: UNMATCHED.append({'path': path + '/' + op['operation_id'], 'reason': 'Rust-typed-input-unavailable', 'required': True, 'counted_as_PASS': False})
            continue
        C.need(isinstance(r['actual_report_inputs'], dict), 'actual real ReportInputs owner required')
        O.validate(r['actual_report_inputs'])
        left, right = O.project(n['prepared_literal_owners'], spec, True, policy), O.project(r['prepared_literal_owners'], spec, False, policy)
        O.literal_joins(n['prepared_literal_owners'], left, spec, None, True, path + '/Native/prepared'); O.literal_joins(r['prepared_literal_owners'], right, spec, None, False, path + '/Rust/prepared')
        O.compare_tree(left, right, path + '/prepared-selected-owner', 'input_join_comparisons')
        for side, case in [(True, n), (False, r)]: context(case['prepared_literal_owners'], path + ('/Native' if side else '/Rust') + '/prepared', side)
        O.prefix(process['after'], n['prepared_literal_owners'], True)
        ns, nw, np = lane(n, spec, True, policy, path + '/Native'); rs, rw, rp = lane(r, spec, False, policy, path + '/Rust')
        actual_counts['Native_Init'] += len(ns); actual_counts['Rust_Init'] += len(rs)
        native_stopped |= n['actual_source_stopped']; rust_stopped |= r['actual_source_stopped']
        reached_n = indexed(ns, 'operation_id', [v['operation_id'] for v in spec['operations']], path + '/Native/Init'); reached_r = indexed(rs, 'operation_id', [v['operation_id'] for v in spec['operations']], path + '/Rust/Init')
        for op in spec['operations']:
            key = op['operation_id']
            if key in reached_n and key in reached_r: future_pairs.append((path + '/' + key, reached_n[key], reached_r[key], np[(key, 'before')], rp[(key, 'before')], np[(key, 'after')], rp[(key, 'after')]))
        disposal = n['post_owner_disposal_transport']
        C.need(disposal['callback_integrity_failed'] is False and disposal['actual_callback_count'] == len(disposal['callbacks']) and disposal['callbacks'][:len(n['final']['callbacks'])] == n['final']['callbacks'] and disposal['console'].startswith(n['final']['console']), 'complete Native disposal prefix/callback custody differs')
        absent(path + '/disposal', 'Native-only actual post-owner disposal transport', disposal, False)
    def file_set(rows):
        values = [((ROOT / v['path']).resolve(), v['sha256'], v['size_bytes']) for v in rows]
        C.need(len(values) == len(set(values)), 'duplicate actual produced file')
        return set(values)
    C.need(file_set(native_files) == file_set(C.load(release['actual_custody'])['produced_case_files_full_SHA_inventory']), 'all Native case file inventories must join outer custody')
    C.need(file_set(rust_files) == file_set(rguard['actual_case_files']), 'all Rust physical case files must join outer custody')
    C.need(nreceipt['exit_code'] == (2 if native_stopped else 0) and rreceipt['exit_code'] == (2 if rust_stopped else 0), 'actual process exit disagrees with complete stop ledger')
    admitted = not C.MISMATCHES and not UNMATCHED and not any(v['required_for_selected_pair'] for v in C.UNAVAILABLE)
    for key, n, r, before_n, before_r, after_n, after_r in future_pairs:
        if not admitted:
            absent(key, 'global-input-or-initial-owner-admission-failed; endpoint-not-paired'); continue
        pre = len(C.MISMATCHES)
        O.compare_tree(before_n, before_r, key + '/full-preowner', 'pre_owner_comparisons')
        if len(C.MISMATCHES) != pre:
            absent(key, 'full-preowner-join-failed; endpoint-not-paired'); continue
        nr, rr = n['actual_source_return_observed'], r['actual_source_return_observed']
        C.same(nr, rr, key + '/actual-return-route', 'selected_endpoint_comparisons')
        after_path = key + '/full-after-owner'
        O.compare_tree(after_n, after_r, after_path, 'selected_endpoint_comparisons', O.generated_paths(after_path, before_n, nr and rr))
        O.compare_tree(O.prefix(n['before'], n['after'], True), O.prefix(r['before'], r['after'], False), key + '/complete-selected-transport-delta', 'selected_endpoint_comparisons')
        if not (nr and rr): absent(key, 'actual-selected-call-did-not-return', {'Native': n['source_exception'], 'Rust': r['source_error']})
        C.PAIRS.append({'path': key, 'full_preowner_join_passed': True, 'actual_Native_returned': nr, 'actual_Rust_returned': rr, 'endpoint_compared': True, 'whole_unit_PASS_claimed': False})
    return {'global_input_and_initial_full_owner_join_passed': admitted, 'actual_case_count': len(ids), 'literal_binary64_input_cells': len(cells), 'actual_calls': actual_counts, 'actual_Native_exit_code': nreceipt['exit_code'], 'actual_Rust_exit_code': rreceipt['exit_code'], 'actual_test_totals': totals, 'Native_capture_Source_snapshot': nreceipt['source_snapshot'], 'Rust_capture_Source_snapshot': rreceipt['source_snapshot'], 'actual_Native_stdout': nreceipt['stdout'], 'actual_Rust_stdout': rreceipt['stdout'], 'actual_Native_baseline_acceptance': packet['Native_baseline_acceptance'], 'selected_source_reachability_complete': actual_counts == {'Native_processInput': 8, 'Native_Init': 20, 'Rust_Init': 20} and not native_stopped and not rust_stopped}


def main():
    global C, O, K
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['source-preparation', 'custody', 'output-dir']: parser.add_argument('--' + name, required=True)
    args = parser.parse_args(); name, sha = args.source_preparation.rsplit('#', 1)
    prep_path = (ROOT / name).resolve()
    if not prep_path.is_relative_to(ROOT) or hashlib.sha256(prep_path.read_bytes()).hexdigest() != sha: raise ValueError('reviewed comparison Source preparation differs')
    prep = json.loads(prep_path.read_bytes()); base = prep['comparison_primitives_Source']; base_path = (ROOT / base['path']).resolve()
    if not base_path.is_relative_to(ROOT) or hashlib.sha256(base_path.read_bytes()).hexdigest() != base['sha256']: raise ValueError('accepted scalar/custody primitives differ')
    C = module(base_path, 'accepted_comparison_primitives')
    C.need(prep['schema'] == 'src06-tarp-dispatcher-comparison-Source-preparation.v1', 'reviewed comparison preparation required')
    for row in prep['own_sources']: C.exact(row)
    K = module(C.exact(prep['runtime_interfaces']['custody_Source']), 'dispatcher_comparison_custody'); K.C = C
    O = module(C.exact(prep['runtime_interfaces']['owner_Source']), 'dispatcher_comparison_owners'); O.C = C
    C.need(C.exact(prep['runtime_interfaces']['comparer']) == Path(__file__).resolve(), 'actual comparer Source differs')
    packet_name, packet_sha = args.custody.rsplit('#', 1); packet_ref = {'path': packet_name, 'sha256': packet_sha}; packet = C.load(packet_ref)
    out = (ROOT / args.output_dir).resolve(); C.need(out.is_relative_to(ROOT / '.runtime/porting/SRC-06') and not out.exists(), 'fresh ignored comparison directory required'); out.mkdir(parents=True)
    try:
        findings = compare(prep, packet)
        required = sum(v['required_for_selected_pair'] for v in C.UNAVAILABLE)
        passed = findings['global_input_and_initial_full_owner_join_passed'] and findings['selected_source_reachability_complete'] and not C.MISMATCHES and not UNMATCHED and required == 0
        status, code = ('pass-available-finite-selected-dispatcher-owners-only', 0) if passed else ('fail-selected-owner-or-input-or-required-unavailable', 1)
    except (KeyError, TypeError, ValueError, IndexError, OSError, AssertionError) as error:
        findings, status, code = {'integrity_failure': str(error), 'endpoint_pairing_performed': False}, 'fail-observation-or-custody-integrity', 2
    K.recheck()
    for path, expected in C.SEEN.items(): C.need(C.digest(path) == expected, 'authenticated artifact changed during comparison')
    ledgers = {}
    for label, rows in [('mismatches', C.MISMATCHES), ('unmatched', UNMATCHED), ('unavailable', C.UNAVAILABLE), ('paired-boundaries', C.PAIRS)]:
        path = out / (label + '.ndjson.gz')
        with path.open('xb') as raw, gzip.GzipFile(filename='', mode='wb', fileobj=raw, mtime=0) as zipped:
            for row in rows: zipped.write((json.dumps(row, ensure_ascii=False, allow_nan=False) + '\n').encode('utf8'))
        ledgers[label] = dict(C.ref(path), rows=len(rows), compression='gzip', uncapped=True)
    report = {'schema': 'src06-selected-tarp-dispatcher-comparison.v1', 'status': status, 'actual_Source_preparation': C.ref(prep_path), 'actual_custody': packet_ref, 'actual_prospective_policy': prep['prospective_policy'], 'findings': findings, 'counts': C.COUNTS, 'mismatch_count': len(C.MISMATCHES), 'required_unmatched_count': len(UNMATCHED), 'required_unavailable_count': sum(v['required_for_selected_pair'] for v in C.UNAVAILABLE), 'optional_unpaired_count': sum(not v['required_for_selected_pair'] for v in C.UNAVAILABLE), 'all_ledgers_retained_uncapped': True, 'ledgers': ledgers, 'unavailable_counted_as_PASS': False, 'whole_SRC06_or_ordinary_handoff_PASS_claimed': False, 'gates_updated': False}
    with (out / 'comparison.json').open('x', encoding='utf8', newline='\n') as stream: json.dump(report, stream, ensure_ascii=False, allow_nan=False, indent=2); stream.write('\n')
    print(json.dumps({'comparison': C.ref(out / 'comparison.json'), 'status': status, 'exit_code': code}))
    return code


if __name__ == '__main__':
    sys.exit(main())

"""Seal a Source-only dispatcher Cargo/PE factual checker; never import or execute it."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-artifact-review-prep-01'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def dump(path, value):
    return write(path, (json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())


checker = ref(OUT / 'check.py'); ast.parse((OUT / 'check.py').read_bytes())
template = ROOT / '.runtime/porting/SRC-05/review-actual-PE-Root-01.py'
before = write(OUT / 'before/review-actual-PE-Root-01.py', template.read_bytes())
delta = write(OUT / 'check.py.diff', ''.join(difflib.unified_diff(template.read_text(encoding='utf8').splitlines(True), (OUT / 'check.py').read_text(encoding='utf8').splitlines(True), fromfile=before['path'], tofile=checker['path'])).encode())

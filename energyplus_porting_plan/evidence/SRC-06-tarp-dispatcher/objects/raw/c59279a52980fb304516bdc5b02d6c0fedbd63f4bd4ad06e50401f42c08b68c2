validation = ref(ROOT / '.runtime/porting/SRC-06/tarp-dispatcher-validation-prep-04/manifest.json')
assert validation['sha256'] == 'ef1a8587c1cf778be7e588e1e5d788476937567852468df89f5340a90e4bc740'
workflow = json.loads((ROOT / validation['path']).read_bytes())
prior_ref = ref(ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-validation-01/record.json')
assert prior_ref['sha256'] == 'decafdcbfd1fa6118bc27fe513b79cea7143494429064309f487d494a10a9183'
prior = json.loads((ROOT / prior_ref['path']).read_bytes())
dependencies = [ref(template), validation, workflow['shared_custody_Source'], workflow['CLI_validation_Source'], workflow['runtime_interfaces']['workflow'], workflow['application_Source_preparation'], workflow['dispatcher_Source_preparation'], workflow['actual_applied_dispatcher_Source_preparation'], workflow['observer_Source_preparation'], workflow['Native_baseline_acceptance'], prior_ref]

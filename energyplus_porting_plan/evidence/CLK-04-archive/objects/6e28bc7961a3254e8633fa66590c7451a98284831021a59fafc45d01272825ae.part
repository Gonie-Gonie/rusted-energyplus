"""Root-invoked byte archival only; no canonical writes or scientific execution."""
from pathlib import Path
from datetime import datetime, timezone
import argparse
import gzip
import hashlib
import io
import json
import re
import stat
import zlib

ROOT = Path(__file__).resolve().parents[4]
BASE = '.runtime/porting/CLK-04/'
CAP = 4_000_000
PART = 3_500_000
PLAIN = 512_000
SHA = re.compile(r'[0-9a-f]{64}')
KNOWN = {
    'unit-comparison': ('candidate-unit-comparison-03/unit-comparison.json', 'ad547d36ac37d5e69a6ef5317f6409c09e0875de91c951e5c9532af31c1d3ac6'),
    'unit-result-review': ('independent-unit-result-review-01/review.json', 'd7425d39aadbb5de36496ce98ec3b5c506888454fad10bbad6bb24dd2f763c9e'),
    'preserved-failed-unit-comparison': ('candidate-unit-comparison-02/unit-comparison.json', 'efce900319ad89ebcb7566e9777dd0ee9f9f329185eb77d055c7f00e108b6575'),
    'legacy-gap': ('legacy-gap-observation-01/gap.json', '5806571825a4241c43ba2585d1faf1c5eb5043eccd0be20b763b8c47e1efec3c'),

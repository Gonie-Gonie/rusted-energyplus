def source_contract(read, check, put, clock, prerequisite):
    historical = read({'path': '.runtime/porting/CLK-04/preparation-01/source-draft.json',
                       'sha256': PREP_SHA['source-draft.json']})
    prior = read(OLD_NATIVE_MANIFEST)
    value = copy.deepcopy(historical)
    normalized = {}
    for row in historical['source_files']:
        check(row['original']); check(row['archive'])
        normalized[row['original_path']] = {'path': row['original_path'], 'sha256': row['original']['sha256'],
                                           'original': row['original'], 'archive': row['archive'], 'bytes': row['bytes']}
    if len(normalized) != 8:
        raise ValueError('Exactly eight original audited pairing files required')
    additional = []
    for context in prior['narrow_genuine_context']:
        source = context['source']; path = check(source)
        relative = source['path'].removeprefix('.reference/energyplus-src/26.1.0/')
        payload = path.read_bytes()
        archive = put('original-source/' + relative, payload)
        normalized.setdefault(relative, {'path': relative, 'sha256': source['sha256'], 'original': source,
                                         'archive': archive, 'bytes': len(payload)})
        lines = payload.splitlines(keepends=True)
        for selected in context['ranges']:
            fragment = b''.join(lines[selected['start_line'] - 1:selected['end_line']])
            binding = put(f"preparation-ranges/{len(additional):02}-{selected['start_line']}-{selected['end_line']}.txt", fragment)
            if binding['sha256'] != selected['raw_bytes_sha256']:
                raise ValueError('Pinned actual preparation range bytes differ')
            additional.append({'file': relative, **selected, 'archive': binding,
                               'role': 'genuine preparation/current-function context, not all math paired'})
    for row in historical['selected_ranges']:
        check(row['archive'])
        path = check(normalized[row['file']]['original'])
        fragment = b''.join(path.read_bytes().splitlines(keepends=True)[row['start_line'] - 1:row['end_line']])
        if put('paired-ranges/' + Path(row['archive']['path']).name, fragment)['sha256'] != row['range_sha256']:
            raise ValueError('Pinned actual selected source range bytes differ')
    value.update({'schema': 'clk04-source-contract.v1', 'status': 'frozen-input-and-source-before-numerical-execution',
                  'created_utc': clock, 'contracts_frozen': True, 'frozen_before_numerical_execution': True,
                  'source_files': [normalized[name] for name in sorted(normalized)],
                  'base_paired_source_file_count': 8, 'preparation_source_ranges': additional,
                  'historical_preparation_draft': OLD_NATIVE_MANIFEST,
                  'actual_CLK03_prerequisite': prerequisite,
                  'required_retired_registry': REGISTRY,
                  'remaining_preparation_closure': [],
                  'genuine_preparation_source_context_only': True,
                  'whole_ground_water_solar_daylight_mathematics_paired': False,
                  'constructor_current_extension_available': False,
                  'native_reference_calls': ['SetupInterpolationValues', 'interpolateWindDirection',
                                             'GetNextEnvironment', 'InitializeWeather', 'SetCurrentWeather'],
                  'prospective_PASS_claimed': False})
    value['dependencies']['historical_preparation_plan_snapshot'] = value['dependencies'].pop('observed_plan_snapshot')
    value['dependencies']['current_actual_prerequisites_complete_before_freeze'] = True
    return value


def tolerance_contract(read, clock):
    resolved = {key: read(binding) for key, binding in PSY_REFS.items()}
    rows = []
    for profile, values in [('day_grid_and_raw_hour_cache', LINEAR_ROWS), ('current_non_solar_weather', CURRENT_ROWS)]:
        for field, (unit, atol, rtol) in values.items():
            row = {'profile': profile, 'field': field, 'unit': unit, 'atol': atol, 'rtol': rtol}
            if profile == 'current_non_solar_weather' and field in PSY_REUSE:
                card, function = PSY_REUSE[field]
                inherited = next(item for item in resolved[card]['rows'] if item['function'] == function)
                if (atol, rtol, unit) != (inherited['atol'], inherited['rtol'], inherited['unit']):
                    raise ValueError('Explicit accepted PSY field profile differs')
                row['accepted_PSY_tolerance'] = {'contract': PSY_REFS[card], 'function': function}
            rows.append(row)
    return {'schema': 'clk04-tolerances-contract.v1', 'card': 'CLK-04', 'created_utc': clock,
            'frozen_before_numerical_execution': True, 'scientific_execution_performed': False,
            'gates_updated': False, 'rows': rows,
            'pure_wind_return': {'unit': 'degree', 'atol': 1e-10, 'rtol': 0.0},
            'exact_value_fields': ['IsRain', 'IsRainThreshold', 'TimeStepFraction', 'Interpolation',
                                   'WeightNow', 'WeightPreviousHour', 'CurrentTime', 'TimeStepZone',
                                   'TimeStepZoneSec', 'MinutesInTimeStep', 'SimTimeSteps', 'NextHour', 'RptIsRain'],
            'exact_metadata': ['input identity/bits/order', 'available call outcome/fatal/return type',
                               'flags/enums/dates/integers', 'header/cursor semantic position and availability',
                               'allocation/shape/order', 'missing/range counts', 'within-owner whole copy bits'],
            'classification': 'exact IEEE class; exact zero sign when both compared outputs are zero',
            'criterion': 'Every available numeric field abs(actual-original)<=atol+rtol*abs(original), selected per profile/field',
            'field_error_metrics': ['maximum_absolute_error', 'RMSE', 'comparison_count', 'mismatch_count'],
            'unavailable_counted_as_PASS': False, 'post_output_relaxation_allowed': False,
            'reused_PSY_contracts': PSY_REFS,
            'no_generic_textual_PSY_or_unit_tolerance_fallback': True}


def observation_projection(request_ref, contracts, clock):
    return {'schema': 'clk04-observation-projection.v1', 'card': 'CLK-04', 'created_utc': clock,
            'frozen_before_numerical_execution': True, 'helper_request': request_ref, 'contracts': contracts,
            'native_observation_policy': copy.deepcopy(NATIVE_OBSERVATION_POLICY),
            'day_boundary_paired_grid_fields': DAY_FIELDS, 'selected_current_fields': CURRENT_FIELDS,
            'current_weather_profile': 'current_non_solar_weather',
            'grid_weather_profile': 'day_grid_and_raw_hour_cache',
            'all_day_boundary_24_by_steps_selected_fields_required': True,
            'pure_wind_function': 'whole genuine interpolateWindDirection',
            'linear_setup_values': 'exact actual array values/shape',
            'source_formula_order_required': True,
            'original_results_supplied_to_Rust': False, 'scientific_execution_performed': False,
            'unavailable_counted_as_PASS': False, 'gates_updated': False,
            'unpaired': ['solar interpolation/radiation/coefficients', 'sky/IR/sky-temperature generation',
                         'cloud/snow/albedo/WaterPrecip generation', 'ground/water/daylight calculations',
                         'native private source record index', 'std-ios private bit flags',
                         'whole first simulation registration', 'error-message wording',
                         'unselected grid contents not recorded by declared compact observation'],
            'existing_CLK03_whole_copy_proof_is_distinct': True,
            'existing_observer_projection_is_separate_and_not_a_native_contract_operand': True}

"""Root archives actual CLI plan validation and verifies literal Git index bytes."""
import hashlib
import io
import json
import shutil
import subprocess
from pathlib import Path

ROOT = Path.cwd()
OUT = ROOT / 'energyplus_porting_plan/evidence/CTF-10-thermal-history-unit'
COMMAND = ROOT / '.runtime/porting/CTF-10/thermal-history-plan-check-command-01'
def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()
def ref(p): return {'path': p.relative_to(ROOT).as_posix(), 'sha256': sha(p), 'size_bytes': p.stat().st_size}
def write(p, value): p.write_bytes((json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode('utf8'))
receipt = json.loads((COMMAND / 'receipt.json').read_bytes())
assert receipt['exit_code'] == 0 and receipt['launch_error'] is None and receipt['source_bytes_match_before_and_after']
rows = []
for name in ['receipt.json', 'stdout.log', 'stderr.log']:
    p = COMMAND / name
    dest = OUT / 'objects' / sha(p)
    if not dest.exists(): shutil.copyfile(p, dest)
    assert p.read_bytes() == dest.read_bytes()
    rows.append({'original': ref(p), 'stored': ref(dest)})
write(OUT / 'validation.json', {'schema': 'ctf10-actual-selected-thermal-history-plan-validation.v1',
    'role': 'actual-plan-validation-after-selected-thermal-history-comparison',
    'actual_execution': ref(COMMAND / 'receipt.json'), 'exit_code': 0,
    'source_bytes_match_before_and_after': True, 'selected_files': rows,
    'validated_plan': ref(ROOT / 'energyplus_porting_plan/plan.json'),
    'scientific_PASS_produced_by_check_plan': False})
subprocess.run(['git', 'diff', '--check'], check=True)
paths = ['energyplus_porting_plan/plan.json', 'energyplus_porting_plan/cards/CTF-10.md',
         'energyplus_porting_plan/CHECKLIST.md',
         'energyplus_porting_plan/energyplus_porting_checklist.html', OUT.relative_to(ROOT).as_posix(),
         'crates/ep_runtime/src/heat_balance/mod.rs',
         'crates/ep_runtime/src/heat_balance/ctf_thermal_history.rs',
         'crates/ep_runtime/src/heat_balance/ctf_thermal_history_tests.rs',
         'crates/ep_run/examples/ctf10_thermal_history_unit_observer.rs',
         'crates/ep_run/examples/ctf10_thermal_history_unit_support/fields.rs']
subprocess.run(['git', 'add', '--', *paths], check=True)
changed = subprocess.check_output(['git', 'diff', '--cached', '--name-only', '-z']).decode().split('\0')[:-1]
selected = json.loads((OUT / 'manifest.json').read_bytes())['selected_files'] + rows
checks = set(changed) | {r['stored']['path'] for r in selected}
requests = [':' + p for p in sorted(checks)]
raw = subprocess.check_output(['git', 'cat-file', '--batch'], input=('\n'.join(requests)+'\n').encode())
stream = io.BytesIO(raw)
for name in sorted(checks):
    header = stream.readline().decode().strip().split()
    assert len(header) == 3 and header[1] == 'blob', (name, header)
    body = stream.read(int(header[2])); assert stream.read(1) == b'\n'
    live = (ROOT / name).read_bytes()
    assert body == live and hashlib.sha1(b'blob '+str(len(body)).encode()+b'\0'+body).hexdigest() == header[0], name
    assert hashlib.sha256(body).hexdigest() == sha(ROOT / name), name
assert stream.read() == b''
print('actual validation archived; staged', len(changed), 'literal indexed files verified', len(checks), flush=True)
subprocess.run(['git', 'commit', '--quiet', '-m', 'feat(ctf): port verified thermal history updates'], check=True)
subprocess.run(['git', 'push', 'origin', 'main'], check=True)
assert not subprocess.check_output(['git', 'status', '--porcelain'])
assert subprocess.check_output(['git', 'rev-parse', 'HEAD']) == subprocess.check_output(['git', 'rev-parse', '@{upstream}'])
print('published clean main', subprocess.check_output(['git', 'rev-parse', 'HEAD']).decode().strip(), flush=True)

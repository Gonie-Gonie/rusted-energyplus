def digest(b):return hashlib.sha256(b).hexdigest()
def read(p):return json.loads(p.read_bytes())
def ref(p):
 b=p.read_bytes();return {'path':p.relative_to(ROOT).as_posix(),'sha256':digest(b),'size_bytes':len(b)}
def bound(r):
 p=(ROOT/r['path']).resolve();assert p.is_relative_to(BASE)
 b=p.read_bytes();assert digest(b)==r['sha256'] and len(b)==r['size_bytes'];return b

def inputs():
 latest={};records=[]
 for name,sha,schema,approval in INPUTS:
  path=BASE/name;b=path.read_bytes();assert digest(b)==sha
  m=json.loads(b);assert m['schema']==schema and m[approval]is True and m['gates_updated']is False
  authority=ref(path);records.append(authority)
  rows=m.get('actual_sources',m.get('changed_sources',[m]));seen=set()
  for row in rows:
   name=row['canonical_path'];path=(ROOT/name).resolve()
   assert path.is_relative_to(ROOT/'crates') and path.suffix=='.rs' and name not in seen;seen.add(name)
   for key in ARCHIVES:
    if row.get(key)is not None:bound(row[key])
   before=row.get('actual_before_archive',row.get('actual_before'))
   if name in latest and before is not None:assert before['sha256']==latest[name]['archive']['sha256']
   final=row.get('actual_final_source',row.get('actual_final'));assert final is not None
   latest[name]={'archive':final,'source_record':authority,'bytes':bound(final)}
 return records,latest

def dirty_rust():
 raw=subprocess.check_output(['git','status','--porcelain=v1','-z','--untracked-files=all'],cwd=ROOT)
 paths=set()
 for row in raw.decode('utf8').split('\0'):
  if not row:continue
  assert len(row)>=4 and row[2]==' ' and not any(c in row[:2]for c in 'RCU')
  if row[3:].endswith('.rs'):paths.add(row[3:])
 return paths

def delta(before,after,name):
 return ''.join(difflib.unified_diff(before.decode('utf8').splitlines(True),after.decode('utf8').splitlines(True),fromfile=name+' (actual before)',tofile=name+' (CRLF to LF only)')).encode('utf8')
def write_json(p,v):p.write_bytes((json.dumps(v,indent=2,allow_nan=False)+'\n').encode('utf8'))

assert sys.argv[1:] and sys.argv[1]in ('apply','accept')
records,latest=inputs();expected=set(latest);dirty=dirty_rust();assert expected==dirty|OBSERVER_PATHS
if sys.argv[1]=='apply':
 assert len(sys.argv)==2 and not OUT.exists()
 for name,row in latest.items():assert (ROOT/name).read_bytes()==row['bytes']
 prepared={name:(row['bytes'],row['bytes'].replace(b'\r\n',b'\n'))for name,row in latest.items()}
 for before,after in prepared.values():assert b'\r'not in after;after.decode('utf8')
 OUT.mkdir();rows=[]
 # Archive every before/final pair before any canonical mutation.
 for name in sorted(prepared):
  before,after=prepared[name];a=OUT/'before'/name;b=OUT/'final'/name;d=OUT/'normalization-diffs'/(name.replace('/','__')+'.diff')
  for path in (a,b,d):path.parent.mkdir(parents=True,exist_ok=True)
  a.write_bytes(before);b.write_bytes(after);d.write_bytes(delta(before,after,name))
  rows.append({'canonical_path':name,'latest_authenticated_source_record':latest[name]['source_record'],'latest_authenticated_source_archive':latest[name]['archive'],'actual_before_archive':ref(a),'actual_final_source':ref(b),'normalization_diff':ref(d),'CRLF_pairs_replaced':before.count(b'\r\n')})
 for name,(before,after)in prepared.items():
  assert (ROOT/name).read_bytes()==before
  if before!=after:(ROOT/name).write_bytes(after)
 for name,(_,after)in prepared.items():assert (ROOT/name).read_bytes()==after
 assert set(latest)==dirty_rust()|OBSERVER_PATHS
 candidate={'schema':'ctf10-production-activation-current-normalized-final-source-inventory.v1','source_records_chronological':records,'actual_sources':rows,'actual_Git_dirty_Rust_paths_before':sorted(dirty),'extra_observer_paths':sorted(OBSERVER_PATHS),'canonical_pathset_equals_actual_Git_dirty_Rust_union_observer2':True,'only_transformation':'raw CRLF bytes replaced with LF bytes; no formatter or other transformation','Root_and_other_author_FULL_formatter_correspondence_accepted':False,'quality_or_candidate_execution_claimed':False,'gates_updated':False}
 write_json(OUT/'candidate.json',candidate);print(json.dumps(ref(OUT/'candidate.json')),flush=True)
else:
 # Root invokes accept only after actual candidate normalization correspondence peers.
 assert len(sys.argv)==3 and not (OUT/'manifest.json').exists()
 path=OUT/'candidate.json';candidate_ref=ref(path);assert candidate_ref['sha256']==sys.argv[2]
 candidate=read(path);assert candidate['schema']=='ctf10-production-activation-current-normalized-final-source-inventory.v1'
 assert candidate['Root_and_other_author_FULL_formatter_correspondence_accepted']is False and candidate['source_records_chronological']==records
 rows=candidate['actual_sources'];assert len(rows)==len(latest) and {r['canonical_path']for r in rows}==set(latest)
 for row in rows:
  name=row['canonical_path'];assert row['latest_authenticated_source_record']==latest[name]['source_record'] and row['latest_authenticated_source_archive']==latest[name]['archive']
  before=bound(row['actual_before_archive']);after=bound(row['actual_final_source'])
  assert before==latest[name]['bytes'] and after==before.replace(b'\r\n',b'\n') and b'\r'not in after and (ROOT/name).read_bytes()==after
  assert bound(row['normalization_diff'])==delta(before,after,name) and row['CRLF_pairs_replaced']==before.count(b'\r\n')
 manifest={**candidate,'accepted_actual_candidate':candidate_ref,'Root_and_other_author_FULL_formatter_correspondence_accepted':True,'approval_scope':'Root explicitly accepted actual CRLF-only correspondence after independent Source peer; no quality or scientific claim'}

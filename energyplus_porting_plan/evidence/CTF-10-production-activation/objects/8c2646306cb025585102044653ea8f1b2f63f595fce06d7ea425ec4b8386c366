+#[test]
+fn empty_surface_ids_do_not_admit_nonempty_normal_rows() {
+    let groups = [];
+    let all = [];
+    let mut caller = context(&groups, &all);
+    caller.simple_ctf_only = true;
+    caller.global_max_ctf_terms = 0;
+    let mut actual = empty_state();
+    actual.normal.inside_temperature[0].push(1.0);
+    let before = actual.clone();
+    assert_eq!(
+        update_selected_ctf_thermal_histories(&mut actual, &[], caller),
+        Err(CtfThermalHistoryUnavailable::AllocatedShape)
+    );
+    assert_eq!(actual, before);
+}

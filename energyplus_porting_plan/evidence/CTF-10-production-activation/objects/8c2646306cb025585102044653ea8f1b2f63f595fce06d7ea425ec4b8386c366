+fn empty_state() -> CtfThermalHistoryState {
+    let mut actual = state();
+    actual.surface_ids.clear();
+    actual.normal = arrays(0, 0.0);
+    actual.masters = None;
+    actual.flux_reports = CtfThermalHistoryFluxReports {
+        inside_conduction: Vec::new(),
+        inside_flux: Vec::new(),
+        outside_flux: Vec::new(),
+        outside_conduction: Vec::new(),
+    };
+    actual
+}

+#[test]
+fn zero_global_simple_shift_accepts_only_a_fully_empty_allocated_layout() -> TestResult {
+    let groups = [];
+    let all = [];
+    let mut caller = context(&groups, &all);
+    caller.simple_ctf_only = true;
+    caller.global_max_ctf_terms = 0;
+    let mut actual = empty_state();
+    assert_eq!(
+        update_selected_ctf_thermal_histories(&mut actual, &[], caller)?,
+        CtfThermalHistoryUpdateRoute::SimpleShift
+    );
+    assert!(!actual.update_first_time);
+    assert!(arrays_match(&actual.normal, 0));
+    let scratch = actual.scratch.as_ref().ok_or(CtfThermalHistoryUnavailable::ScratchUnallocated)?;
+    assert!([
+        &scratch.outside_flux_first, &scratch.inside_flux_first,
+        &scratch.inside_temperature_first, &scratch.outside_temperature_first, &scratch.sum_time,
+    ].iter().all(|row| row.is_empty()));
+    let retained = actual.clone();
+    assert_eq!(
+        update_selected_ctf_thermal_histories(&mut actual, &[], caller)?,
+        CtfThermalHistoryUpdateRoute::SimpleShift
+    );
+    assert_eq!(actual, retained);
+    Ok(())
+}

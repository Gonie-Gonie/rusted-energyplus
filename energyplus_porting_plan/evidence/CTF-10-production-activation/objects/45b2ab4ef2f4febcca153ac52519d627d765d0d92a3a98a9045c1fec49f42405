def read(p):
 assert p.stat().st_size<16000000
 return json.loads(p.read_bytes())
def sha(p):
 with p.open('rb')as s:return hashlib.file_digest(s,'sha256').hexdigest()
def ref(p):return {'path':p.relative_to(ROOT).as_posix(),'sha256':sha(p),'size_bytes':p.stat().st_size}
def exact(row):
 p=(ROOT/row['path']).resolve();assert p.is_relative_to(ROOT)and p.is_file()and sha(p)==row['sha256']
 if 'size_bytes'in row:assert type(row['size_bytes'])is int and p.stat().st_size==row['size_bytes']
 return p

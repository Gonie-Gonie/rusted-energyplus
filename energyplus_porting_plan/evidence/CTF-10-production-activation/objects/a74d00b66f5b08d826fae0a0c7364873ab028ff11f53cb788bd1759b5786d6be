"""Root compresses retained replay storage without changing bytes or paths."""
import hashlib, json, shutil, subprocess, sys
from pathlib import Path
ROOT=Path.cwd().resolve(); BASE=ROOT/'.runtime/porting/CTF-10'
OUT=BASE/'thermal-history-rust-output-storage-compression-02'

def sha(p):
 with p.open('rb') as stream: return hashlib.file_digest(stream,'sha256').hexdigest()
def ref(p): return {'path':p.relative_to(ROOT).as_posix(),'sha256':sha(p),'size_bytes':p.stat().st_size}

assert len(sys.argv)==2
authority=BASE/'thermal-history-unit-comparison-02/comparison.json'
assert sha(authority)==sys.argv[1]
report=json.loads(authority.read_bytes()); assert report['selected_available_direct_unit_calls_PASS_claimed'] is True
row=report['Rust_results']; p=(ROOT/row['path']).resolve(strict=True)
assert p==BASE/'thermal-history-candidate-unit-command-02/stdout.log'
assert p.is_file() and not p.is_symlink() and not p.is_junction() and not (p.stat().st_file_attributes & 0x400)
before=ref(p); assert before==row and not OUT.exists(); OUT.mkdir()
free_before=shutil.disk_usage(ROOT).free; log=OUT/'compact.log'
with log.open('xb') as stream:
 result=subprocess.run(['compact.exe','/C','/EXE:LZX','/Q',str(p)],stdout=stream,stderr=subprocess.STDOUT)
after=ref(p); assert before==after and result.returncode==0
record={'schema':'root-retained-rust-output-transparent-compression.v1','actual_before_authority':ref(authority),
 'operation':'NTFS compact.exe /C /EXE:LZX /Q exact retained genuine Rust complete output',
 'file_before':before,'file_after':after,'compact_exit_code':result.returncode,'command_log':ref(log),
 'bytes_and_path_unchanged':True,'file_deleted_or_moved':False,'scientific_values_recomputed':False,
 'observed_free_bytes_before':free_before,'observed_free_bytes_after':shutil.disk_usage(ROOT).free,
 'physical_free_change_is_observation_not_exclusive_attribution':True,'gates_updated':False}
(OUT/'record.json').write_bytes((json.dumps(record,indent=2)+'\n').encode())
print('Retained complete Rust replay compressed with exact bytes unchanged; observed free',record['observed_free_bytes_after'],flush=True)

#[test]
fn manual_explicit_clock_runs_two_real_steps_with_distinct_weather() -> TestResult {
    let model = model();
    let mut state = state(&model)?;
    let generation = state.ctf_surface_lifecycle.as_ref().ok_or("missing lifecycle")?
        .generation_key().clone();
    let mut caller = CtfHistoryCallerClock::begin();
    for (substep, outdoor) in [(1, 7.0), (2, 11.5)] {
        let clock = caller.prepare(WeatherDayPhase::Run { day: 1 }, 0, 3, substep, 1200.0)
            .map_err(|error| format!("prepare: {error:?}"))?;
        advance_heat_balance_state_one_timestep_with_clock(
            &model.typed, &mut state,
            HeatBalanceStepInput { outdoor_dry_bulb_c: outdoor, hour_ending: 1, timestep_seconds: 1200.0 },
            clock,
        ).map_err(|error| format!("step: {error:?}"))?;
        caller.commit(clock).map_err(|error| format!("caller commit: {error:?}"))?;
    }
    assert_eq!(state.timestep_index, 2);
    assert_eq!(caller.committed_steps(), 2);
    assert!(caller.pending().is_none());
    assert!(!caller.last_committed().ok_or("no committed clock")?.begin_environment);
    let owner = state.ctf_surface_lifecycle.as_ref().ok_or("missing lifecycle")?;
    assert_eq!(owner.generation_key(), &generation);
    assert!(owner.failure().is_none());
    // Manual authority is the supplied caller, not a manufactured weather owner
    // or a revision of the State's independent legacy loop clock.
    assert_eq!(state.ctf_history_caller_clock.committed_steps(), 0);
    Ok(())
}

#[test]
fn legacy_warmup_to_run_keeps_one_environment_and_real_clock_owner() -> TestResult {
    let model = model();
    let mut state = state(&model)?;
    let generation = state.ctf_surface_lifecycle.as_ref().ok_or("missing lifecycle")?
        .generation_key().clone();
    let runtime = HeatBalanceZoneAirAlgorithm::SimplifiedAnalytical.runtime_config();
    let mut clocks = Vec::new();
    let mut day_end = Vec::new();
    let warmup = run_heat_balance_run_period_warmup(
        &model.typed, &mut state, &[7.0], None, None, 3, 1200.0,
        warmup_options(), runtime, 1, None,
        HeatBalanceSurfaceLoopZoneAirCorrection::EachSurfaceIteration,
        ep_model::FirstHourInterpolationStartingValues::Hour1, &mut day_end,
        |model, state, input, weather, runtime, iterations, hconv, correction| {
            if let Some(clock) = state.ctf_history_caller_clock.pending() { clocks.push(clock); }
            advance_heat_balance_state_one_timestep_internal(
                model, state, input, weather, runtime, iterations, hconv, correction,
            );
        },
    ).map_err(|error| format!("warmup: {error:?}"))?;
    assert_eq!(warmup.timestep_count, 3);
    let (_, outputs) = sample_heat_balance_run_period_with_step_driver(
        &model, &mut state, &[11.5], None, None,
        HeatBalanceSimulationOptions::hourly_samples(1), runtime, 3, 1200.0,
        ep_model::FirstHourInterpolationStartingValues::Hour1,
        |state, input, weather, _hour, _substep| {
            if let Some(clock) = state.ctf_history_caller_clock.pending() { clocks.push(clock); }
            advance_heat_balance_state_one_timestep_internal(
                &model.typed, state, input, weather, runtime, 1, None,
                HeatBalanceSurfaceLoopZoneAirCorrection::EachSurfaceIteration,
            );
            crate::heat_balance::ctf_surface_lifecycle::ensure_available(state)
        },
    ).map_err(|error: RuntimeError| format!("run: {error:?}"))?;
    assert_eq!(outputs.len(), 3);
    assert_eq!(state.timestep_index, 6);
    assert_eq!(clocks.len(), 6);
    assert_eq!(clocks[0].phase, WeatherDayPhase::Warmup { day: 1 });
    assert_eq!(clocks[3].phase, WeatherDayPhase::Run { day: 1 });
    assert!(clocks[0].begin_environment && clocks[0].begin_simulation);
    assert!(clocks[1..].iter().all(|clock| !clock.begin_environment && !clock.begin_simulation));
    assert_eq!(clocks.iter().map(|clock| clock.sim_time_steps).collect::<Vec<_>>(), [1, 2, 3, 4, 5, 6]);
    assert_eq!(state.ctf_history_caller_clock.committed_steps(), 6);
    assert_eq!(state.ctf_history_caller_clock.last_committed(), clocks.last().copied());
    assert!(state.ctf_history_caller_clock.pending().is_none());
    let owner = state.ctf_surface_lifecycle.as_ref().ok_or("missing lifecycle")?;
    assert_eq!(owner.generation_key(), &generation);
    assert!(owner.failure().is_none());
    Ok(())
}

#[test]
fn failed_legacy_step_keeps_pending_clock_and_cannot_replay() -> TestResult {
    let mut model = model();
    let mut state = state(&model)?;
    let MaterialDefinition::Regular(material) = &mut model.typed.materials[0].definition else {
        return Err("fixture material route changed".to_owned());
    };
    material.thermal_resistance_m2_k_per_w = 0.25;
    let runtime = HeatBalanceZoneAirAlgorithm::SimplifiedAnalytical.runtime_config();
    let calls = std::cell::Cell::new(0);
    let mut day_end = Vec::new();
    for _ in 0..2 {
        let result = run_heat_balance_run_period_warmup(
            &model.typed, &mut state, &[7.0], None, None, 3, 1200.0,
            warmup_options(), runtime, 1, None,
            HeatBalanceSurfaceLoopZoneAirCorrection::EachSurfaceIteration,
            ep_model::FirstHourInterpolationStartingValues::Hour1, &mut day_end,
            |model, state, input, weather, runtime, iterations, hconv, correction| {
                calls.set(calls.get() + 1);
                advance_heat_balance_state_one_timestep_internal(
                    model, state, input, weather, runtime, iterations, hconv, correction,
                );
            },
        );
        assert!(matches!(result, Err(RuntimeError::CtfSurfaceLifecycle(Error::StaleGeneration))));
        assert_eq!(state.ctf_history_caller_clock.committed_steps(), 0);
        assert!(state.ctf_history_caller_clock.last_committed().is_none());
        let pending = state.ctf_history_caller_clock.pending().ok_or("failed pending clock missing")?;
        assert!(pending.begin_environment && pending.begin_simulation);
        assert_eq!(pending.sim_time_steps, 1);
        assert_eq!(state.timestep_index, 0);
    }
    assert_eq!(calls.get(), 1);
    assert!(day_end.is_empty());
    Ok(())
}

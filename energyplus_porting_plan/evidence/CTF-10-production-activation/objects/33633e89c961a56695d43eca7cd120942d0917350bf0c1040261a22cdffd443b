+#[test]
+fn unused_nonordinary_rows_preserve_declared_order_around_the_real_ordinary_owner() -> TestResult {
+    let mut unused = construction(701, &[700]);
+    unused.kind = ConstructionKind::Fenestration;
+    let current = construction(3, &[1]);
+    let actual = owners(&current, std::slice::from_ref(&unused), &BTreeSet::from([3]),
+        &[material(1, true, 2.0)], context(true, false))?;
+    let mut state = OrderedCtfPublicInitialization::begin(true, 0);
+    state.record_unused_reset(0, &unused, actual.retry.flags_on_entry);
+    record(&mut state, &current, &actual);
+    let mut later = construction(702, &[700]);
+    later.kind = ConstructionKind::Fenestration;
+    state.record_unused_reset(2, &later, actual.retry.flags_on_return);
+    state.finish_declared_loop(3);
+    assert!(state.selected_declared_loop_completed);
+    assert_eq!(state.constructions.iter().map(|row| row.construction_id).collect::<Vec<_>>(),
+        vec![unused.id, current.id, later.id]);
+    assert_eq!(state.constructions.iter().map(|row| row.declared_index).collect::<Vec<_>>(), vec![0, 1, 2]);
+    assert_eq!(returned(&state, 0)?.route, CtfPublicReturnRoute::UnusedReset);
+    assert_eq!(returned(&state, 1)?.route, CtfPublicReturnRoute::AllResistive);
+    assert_eq!(returned(&state, 2)?.route, CtfPublicReturnRoute::UnusedReset);
+    assert_eq!(state.aggregate_after_returned_calls.returned_constructions, 3);
+    assert_eq!(state.aggregate_after_returned_calls.max_ctf_terms,
+        returned(&state, 1)?.storage.num_ctf_terms);
+    assert_eq!(state.constructions[1].unused_reset_flags, None);
+    assert_eq!(state.constructions[1].retry_flags_on_return, Some(actual.retry.flags_on_return));
+    Ok(())
+}

+#[test]
+fn unused_nonordinary_reset_retains_actual_caller_flags_without_retry_owner() -> TestResult {
+    let mut unused = construction(701, &[700]);
+    unused.kind = ConstructionKind::Fenestration;
+    let flags = CtfCallerSharedFlags { errors_found: true, do_ctf_error_report: true };
+    let mut state = OrderedCtfPublicInitialization::begin(false, 8);
+    state.record_unused_reset(0, &unused, flags);
+    let row = &state.constructions[0];
+    assert_eq!(row.construction_id, unused.id);
+    assert_eq!(row.declared_index, 0);
+    assert_eq!(row.original_material_ids, unused.effective_layers());
+    assert!(!row.is_used_ctf);
+    assert!(row.public_initializer_invoked);
+    assert_eq!(row.retry_flags_on_entry, None);
+    assert_eq!(row.retry_flags_on_return, None);
+    assert_eq!(row.unused_reset_flags, Some(flags));
+    let actual = returned(&state, 0)?;
+    assert_eq!(actual.route, CtfPublicReturnRoute::UnusedReset);
+    let storage = &actual.storage;
+    assert!([
+        storage.outside, storage.cross, storage.inside, storage.flux,
+        storage.source_in, storage.source_out, storage.temperature_source_out,
+        storage.temperature_source_in, storage.temperature_source_q,
+        storage.temperature_user_out, storage.temperature_user_in, storage.temperature_user_source,
+    ].iter().flatten().all(|value| value.to_bits() == 0));
+    assert_eq!(storage.ctf_time_step.to_bits(), 0);
+    assert_eq!(storage.u_value.to_bits(), 0);
+    assert_eq!((storage.num_histories, storage.num_ctf_terms), (0, 0));
+    assert_eq!(state.aggregate_after_returned_calls, CtfPublicInitAggregate {
+        simple_ctf_only: false, max_ctf_terms: 8, returned_constructions: 1,
+    });
+    state.finish_declared_loop(1);
+    assert!(state.selected_declared_loop_completed);
+    assert!(state.selected_stop.is_none());
+    Ok(())
+}

+#[test]
+fn used_excluded_and_prior_stops_cannot_invoke_an_unused_reset() {
+    let mut used = construction(701, &[700]);
+    used.kind = ConstructionKind::Fenestration;
+    let mut state = OrderedCtfPublicInitialization::begin(true, 0);
+    state.record_excluded(0, &used, true);
+    let stop = CtfPublicInitStop::Scope { construction_id: used.id };
+    assert_eq!(state.selected_stop, Some(stop));
+    let mut unused = construction(702, &[700]);
+    unused.kind = ConstructionKind::Fenestration;
+    state.record_unused_reset(1, &unused,
+        CtfCallerSharedFlags { errors_found: false, do_ctf_error_report: false });
+    let row = &state.constructions[1];
+    assert_eq!(row.result, Err(CtfPublicInitializationUnavailable::PriorSelectedStop(stop)));
+    assert!(!row.public_initializer_invoked);
+    assert_eq!(row.unused_reset_flags, None);
+    assert_eq!(row.retry_flags_on_entry, None);
+    assert_eq!(row.retry_flags_on_return, None);
+    assert_eq!(state.aggregate_after_returned_calls.returned_constructions, 0);
+    state.finish_declared_loop(2);
+    assert!(!state.selected_declared_loop_completed);
+}

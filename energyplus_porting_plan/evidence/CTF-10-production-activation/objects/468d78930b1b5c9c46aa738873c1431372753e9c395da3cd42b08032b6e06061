+#[test]
+fn second_distinct_caller_clock_and_weather_commit_preserves_generation() -> TestResult {
+    let model = model();
+    let mut state = state(&model)?;
+    begin_step(&model.typed, &mut state, Some(clock(1, true)), 7.0, 1200.0)
+        .map_err(|error| format!("first begin: {error:?}"))?;
+    commit_step(&model.typed, &mut state, 7.0)
+        .map_err(|error| format!("first commit: {error:?}"))?;
+    let owner = state.ctf_surface_lifecycle.as_ref().ok_or("owner missing")?;
+    let generation = owner.generation_key.clone();
+    let retained_history = owner.history.clone();
+    assert_eq!(owner.last_committed_clock, Some(clock(1, true)));
+
+    // Prepared caller operands change while producer inputs stay unchanged.
+    // Neither endpoint nor coefficients come from a Native observation.
+    state.surfaces[0].inside_face_temperature_c = 18.25;
+    state.surfaces[0].inside_ctf_outside_temperature_c = 11.5;
+    begin_step(&model.typed, &mut state, Some(clock(2, false)), 11.5, 1200.0)
+        .map_err(|error| format!("second begin: {error:?}"))?;
+    let owner = state.ctf_surface_lifecycle.as_ref().ok_or("owner missing")?;
+    assert_eq!(owner.history, retained_history);
+    assert_eq!(owner.current_clock, Some(clock(2, false)));
+    assert_eq!(state.surfaces[0].inside_face_temperature_c.to_bits(), 18.25_f64.to_bits());
+    commit_step(&model.typed, &mut state, 11.5)
+        .map_err(|error| format!("second commit: {error:?}"))?;
+    let owner = state.ctf_surface_lifecycle.as_ref().ok_or("owner missing")?;
+    assert_eq!(owner.generation_key, generation);
+    assert_eq!(owner.last_committed_clock, Some(clock(2, false)));
+    assert!(owner.current_clock.is_none());
+    assert!(owner.failure.is_none());
+    assert!(owner.initialized);
+    assert_eq!(state.timestep_index, 0);
+    Ok(())
+}

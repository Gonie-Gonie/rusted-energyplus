"""Root selects actual completed activation evidence and runs the reviewed archiver."""
import hashlib,json,runpy,sys
from pathlib import Path
ROOT=Path.cwd().resolve();BASE=ROOT/'.runtime/porting/CTF-10'
OUT=ROOT/'energyplus_porting_plan/evidence/CTF-10-production-activation'
def read(p):return json.loads(p.read_bytes())
def sha(p):
 with p.open('rb')as s:return hashlib.file_digest(s,'sha256').hexdigest()
def arg(p):return p.relative_to(ROOT).as_posix()+'#'+sha(p)
def refs(value):
 if isinstance(value,dict):
  if 'path'in value and 'sha256'in value:
   if not any(k in value for k in ['first_line','start_line']):yield value
   return
  for item in value.values():yield from refs(item)
 elif isinstance(value,list):
  for item in value:yield from refs(item)
final=BASE/'production-activation-applied-final-source-03/manifest.json'
assert sha(final)=='2626c66ee2fe7171cfc8102b694324959cd7b6c2121087a160c3136ee112cafb'
comparison=BASE/'thermal-history-unit-comparison-02/comparison.json'
assert sha(comparison)=='bd01b399e5a7588d94fef91726173d5ea8f6ae52dbe9b475cfa84ad5ac887de5'
cli_path=BASE/'production-activation-cli6-inputs-01/execution-summary.json';cli=read(cli_path)
assert cli['all6_exit0_and_source_unchanged']is True and cli['all45_input_guards_unchanged_after']is True
assert cli['hours_override_supplied']is False and cli['EIO_or_Native_expected_values_supplied']is False
assert cli['same_actual_source_snapshot']==read(comparison)['actual_source_snapshot']
source=BASE/'production-activation-publication-prep-02/archive-production-activation.py'
assert sha(source)=='ec5cac079c449b7ea20628a641fdda04f7be900129ef214c4012f8dddac2d74f'
args=['--final-inventory',arg(final),'--comparison',arg(comparison),'--comparison-execution',arg(BASE/'thermal-history-unit-comparison-command-02/receipt.json'),'--output-dir',OUT.relative_to(ROOT).as_posix()]
for role in ['fmt-check','clippy','focused','workspace']:
 args+=['--quality',role+'='+arg(BASE/f'production-activation-{role}-command-02/receipt.json')]
for name in ['CTF-10-thermal-history-unit/manifest.json','CTF-10-thermal-history-unit/summary.json','CTF-10-surface-consumer05-original-baseline/summary.json','CTF-10-unit/summary.json']:
 args+=['--prior-evidence',arg(ROOT/'energyplus_porting_plan/evidence'/name)]
files={Path(__file__).resolve(),cli_path,BASE/'production-activation-cli6-inputs-01/manifest.json',BASE/'run-production-activation-quality-02.py',BASE/'compress-thermal-history-retained-rust-output-02.py',BASE/'thermal-history-rust-output-storage-compression-02/record.json'}
for key in ['complete_case_ledger','complete_mismatch_ledger']:
 row=read(comparison)[key];p=ROOT/row['path'];assert sha(p)==row['sha256'];files.add(p)
files.add(BASE/'thermal-history-candidate-launch-inputs-02/runtime-source-bindings.json')
for name in ['production-initializer-activation-prep-01','production-initializer-activation-prep-02','thermal-history-empty-layout-prep-01','production-caller-clock-prep-01','production-phase-contract-tests-prep-01','boundary-reference-preflight-prep-01','public-unused-reset-prep-01','surface-binding-unread-definitions-prep-01','surface-binding-unread-definitions-prep-02','production-profiled-report-clock-tests-prep-01','production-profiled-report-clock-tests-prep-02','production-final-source-inventory-prep-01','thermal-history-replay-runner-prep-01','production-activation-cli6-runner-prep-01','production-activation-publication-prep-01','production-activation-publication-prep-02','whole-init-postlude-audit-prep-01']:
 manifest=BASE/name/'manifest.json';files.add(manifest)
 for row in refs(read(manifest)):
  p=(ROOT/row['path']).resolve()
  if p.is_relative_to(manifest.parent) and p.is_file():
   assert sha(p)==row['sha256'],row['path'];files.add(p)
receipts=[BASE/name/'receipt.json'for name in ['production-activation-workspace-command-01','production-activation-runtime-regressions-command-01','production-activation-runtime-fixture-regressions-command-01','production-activation-clock-focused-command-01','production-activation-clock-runtime-regressions-command-01','production-activation-source-format-command-01','production-activation-source-format-command-02','production-activation-fixture-source-format-command-01','thermal-history-empty-layout-format-command-01','production-caller-clock-format-command-01','production-runtime-contract-fixes-format-command-01','production-profiled-report-clock-tests-format-command-02','thermal-history-rust-output-storage-compression-command-02','production-activation-cli6-build-command-01']]
for row in cli['executions']:
 receipt=ROOT/row['receipt']['path'];assert sha(receipt)==row['receipt']['sha256'];receipts.append(receipt)
 r=read(receipt);assert r['exit_code']==0 and r['source_bytes_match_before_and_after']is True and r['source_snapshot']==cli['same_actual_source_snapshot']
 output=Path(r['command'][r['command'].index('--output-dir')+1]);files.add(output/'run-summary.json')
for row in read(final)['source_records_chronological']:
 for item in refs(read(ROOT/row['path'])):
  p=(ROOT/item['path']).resolve()
  if p.is_file() and p.is_relative_to(BASE):
   assert sha(p)==item['sha256'],item['path'];files.add(p)
for i,p in enumerate(sorted(files)):
 args+=['--lineage',f'selected-file-{i:03}='+arg(p)]
for i,p in enumerate(receipts):args+=['--lineage-receipt',f'actual-command-{i:03}='+arg(p)]
launch=BASE/'production-activation-archive-launch-inputs-01';launch.mkdir()
(launch/'arguments.json').write_bytes((json.dumps({'archiver':arg(source),'arguments':args,'actual_selected_lineage_files':len(files),'actual_lineage_receipts':len(receipts)},indent=2)+'\n').encode())
print('Root actual archive operands fixed',len(files),'files',len(receipts),'receipts',flush=True)
sys.argv=[str(source),*args]
runpy.run_path(str(source),run_name='__main__')

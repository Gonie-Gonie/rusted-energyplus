+    // Each one-step manual test authors its own first caller stamp. These
+    // phase/hour/substep operands never come from the thermal State counter.
+    fn first_manual_ctf_test_clock(
+        steps: u32, hour_ending: u32, substep: u32, seconds: f64,
+    ) -> Result<crate::weather::day::ProductionCtfHistoryClock, RuntimeError> {
+        let record_index = usize::try_from(hour_ending).ok()
+            .and_then(|hour| hour.checked_sub(1))
+            .ok_or(RuntimeError::CtfSurfaceLifecycle(
+                crate::heat_balance::ctf_surface_lifecycle::CtfSurfaceLifecycleUnavailable::Association))?;
+        crate::heat_balance::ctf_caller_clock::CtfHistoryCallerClock::begin()
+            .prepare(crate::weather::day::WeatherDayPhase::Run { day: 1 },
+                record_index, steps, substep, seconds)
+            .map_err(RuntimeError::CtfSurfaceLifecycle)
+    }

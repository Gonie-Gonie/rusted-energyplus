+                    value.CMat_bounds->lower != 1 || value.CMat_bounds->upper != 2 || value.CMat_bounds->size != 2 ||
+                    value.DMat_bounds->lower != 1 || value.DMat_bounds->upper != 2 || value.DMat_bounds->size != 2 ||
+                    value.history_available || value.s_available || value.e_available || value.s_bounds || value.e_bounds ||
+                    !value.s.empty() || !value.e.empty() || value.NumCTFTerms || value.controls || value.caller_context_available || value.caller_TimeStepZone) return true;
+            } else {
+                auto const n = static_cast<std::size_t>(value.context.rcmax);
+                if (!value.history_available || !value.s_available || !value.e_available || !value.NumCTFTerms ||
+                    !value.s_bounds || !value.e_bounds || n > std::numeric_limits<std::size_t>::max() / 12 ||
+                    value.s.size() != 12 * n || value.e.size() != n ||
+                    value.s_bounds->lower1 != 1 || value.s_bounds->upper1 != 3 || value.s_bounds->lower2 != 1 || value.s_bounds->upper2 != 4 ||
+                    value.s_bounds->lower3 != 1 || value.s_bounds->upper3 != value.context.rcmax || value.s_bounds->size != value.s.size() ||

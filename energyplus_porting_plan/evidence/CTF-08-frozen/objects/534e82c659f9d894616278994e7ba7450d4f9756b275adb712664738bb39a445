+void final_coefficient_entry(Construction::ConstructionProps const &construction) noexcept
+{
+    Capture *capture = active_capture;
+    if (capture == nullptr) return;
+    FinalCoefficientCapture &ledger = capture->final_coefficients;
+    std::size_t const ordinal = ++ledger.actual_invocation_count;
+    std::size_t const entry = static_cast<std::size_t>(FinalCoefficientStage::Entry);
+    ++ledger.actual_stage_callback_counts[entry];
+    bool const previous_returned = ordinal == 1 ||
+        (!ledger.invocations.empty() && ledger.invocations.back().observed_invocation_ordinal == ordinal - 1 &&
+         ledger.invocations.back().source_return.reached);
+    try {
+        ledger.invocations.emplace_back();
+    } catch (...) {
+        ++ledger.stage_records_omitted[entry];
+        coefficient_failure(*capture, nullptr, FinalCoefficientStage::Entry, MethodFailureKind::LedgerAppendException);
+        return;
+    }
+    FinalCoefficientInvocationSnapshot &invocation = ledger.invocations.back();
+    invocation.observed_invocation_ordinal = ordinal;
+    invocation.observed_assembly_ordinal = capture->actual_matrix_attempt_callback_count;
+    ++invocation.actual_stage_callback_counts[entry];
+    if (capture->bound_state == nullptr || capture->bound_construction != &construction) {
+        coefficient_failure(*capture, &invocation, FinalCoefficientStage::Entry, MethodFailureKind::IdentityMismatch);
+        invocation.entry.reached = true;
+        return;
+    }
+    invocation.association_available = ordinal == invocation.observed_assembly_ordinal &&
+        associated_assembly(*capture, construction, invocation.observed_assembly_ordinal) != nullptr &&
+        coefficient_prior_Gamma_returned(*capture, construction, ordinal);
+    if (!invocation.association_available) {
+        coefficient_failure(*capture, &invocation, FinalCoefficientStage::Entry, MethodFailureKind::AssociationFailure);
+    }
+    if (!previous_returned) coefficient_failure(*capture, &invocation, FinalCoefficientStage::Entry, MethodFailureKind::OrderFailure);
+    copy_coefficient_matrices(*capture, invocation, FinalCoefficientStage::Entry, construction, invocation.entry,
+        {{FinalCoefficientMatrixOwner::AExp, &construction.AExp}, {FinalCoefficientMatrixOwner::IdenMatrix, &construction.IdenMatrix},
+         {FinalCoefficientMatrixOwner::Gamma1, &construction.Gamma1}, {FinalCoefficientMatrixOwner::Gamma2, &construction.Gamma2}});
+    invocation.entry.CMat_bounds = array_bounds(construction.CMat);
+    invocation.entry.DMat_bounds = array_bounds(construction.DMat);
+    if (exact_vector(invocation.entry.CMat_bounds, 2)) {
+        for (int i = 1; i <= 2; ++i) invocation.entry.CMat[static_cast<std::size_t>(i - 1)] = copy_bits(construction.CMat(i));
+        invocation.entry.CMat_available = true;
+    } else {
+        coefficient_failure(*capture, &invocation, FinalCoefficientStage::Entry, MethodFailureKind::MatrixShape);
+    }
+    if (exact_vector(invocation.entry.DMat_bounds, 2)) {
+        for (int i = 1; i <= 2; ++i) invocation.entry.DMat[static_cast<std::size_t>(i - 1)] = copy_bits(construction.DMat(i));
+        invocation.entry.DMat_available = true;
+    } else {
+        coefficient_failure(*capture, &invocation, FinalCoefficientStage::Entry, MethodFailureKind::MatrixShape);
+    }
+}

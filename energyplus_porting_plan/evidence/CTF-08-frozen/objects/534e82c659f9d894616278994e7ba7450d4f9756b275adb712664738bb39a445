+void final_coefficient_return(EnergyPlusData const &state, Construction::ConstructionProps const &construction,
+    bool ErrorsFound, bool DoCTFErrorReport, Real64 const &TimeStepZone) noexcept
+{
+    Capture *capture = active_capture;
+    if (capture == nullptr) return;
+    FinalCoefficientInvocationSnapshot *invocation = coefficient_visit(*capture, construction, FinalCoefficientStage::SourceReturn);
+    if (invocation == nullptr) return;
+    if (capture->bound_state != &state) {
+        coefficient_failure(*capture, invocation, FinalCoefficientStage::SourceReturn, MethodFailureKind::IdentityMismatch);
+    }
+    FinalCoefficientValueSnapshot &snapshot = invocation->source_return;
+    snapshot.caller_context_available = capture->bound_state == &state && capture->bound_construction == &construction;
+    snapshot.caller_ErrorsFound = ErrorsFound;
+    snapshot.caller_DoCTFErrorReport = DoCTFErrorReport;
+    snapshot.caller_TimeStepZone = copy_bits(TimeStepZone);
+    MatrixAttemptSnapshot const *assembly = associated_assembly(*capture, construction, invocation->observed_assembly_ordinal);
+    if (assembly == nullptr || assembly->ErrorsFound != ErrorsFound ||
+        assembly->DoCTFErrorReport != DoCTFErrorReport || assembly->TimeStepZone.bits != copy_bits(TimeStepZone).bits) {
+        coefficient_failure(*capture, invocation, FinalCoefficientStage::SourceReturn, MethodFailureKind::AssociationFailure);
+    }
+    copy_coefficient_matrices(*capture, *invocation, FinalCoefficientStage::SourceReturn, construction, snapshot,
+        {{FinalCoefficientMatrixOwner::Gamma1, &construction.Gamma1}, {FinalCoefficientMatrixOwner::s0, &construction.s0}});
+    copy_coefficient_history(*capture, *invocation, FinalCoefficientStage::SourceReturn, construction, snapshot);
+}

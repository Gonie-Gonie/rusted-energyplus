+bool coefficient_prior_Gamma_returned(Capture const &capture,
+                                      Construction::ConstructionProps const &construction,
+                                      std::size_t ordinal) noexcept
+{
+    GammaCapture const &ledger = capture.gamma;
+    std::size_t const returned = static_cast<std::size_t>(GammaStage::SourceReturn);
+    if (ledger.actual_invocation_count != ordinal || ledger.actual_stage_callback_counts[returned] != ordinal ||
+        ledger.invocations.empty() || !gamma_prior_methods_returned(capture, ordinal)) return false;
+    GammaInvocationSnapshot const &prior = ledger.invocations.back();
+    if (prior.observed_invocation_ordinal != ordinal || prior.observed_assembly_ordinal != ordinal ||
+        !prior.association_available || !prior.source_return.reached ||
+        !prior.source_return.caller_context_available || !prior.source_return.caller_TimeStepZone) return false;
+    MatrixAttemptSnapshot const *assembly = associated_assembly(capture, construction, ordinal);
+    if (assembly == nullptr) return false;
+    MethodContext const &context = prior.source_return.context;
+    return context.assembly_context_available &&
+        context.IsUsedCTF == construction.IsUsedCTF && context.SourceSinkPresent == construction.SourceSinkPresent &&
+        context.SolutionDimensions == construction.SolutionDimensions && context.TotLayers == construction.TotLayers &&
+        context.rcmax == construction.rcmax && context.NodeSource == construction.NodeSource &&
+        context.NodeUserTemp == construction.NodeUserTemp && context.NumHistories == construction.NumHistories &&
+        context.CTFTimeStep.bits == copy_bits(construction.CTFTimeStep).bits &&
+        context.assembly_ErrorsFound == assembly->ErrorsFound &&
+        context.assembly_DoCTFErrorReport == assembly->DoCTFErrorReport &&
+        context.assembly_TimeStepZone.bits == assembly->TimeStepZone.bits &&
+        prior.source_return.caller_ErrorsFound == assembly->ErrorsFound &&
+        prior.source_return.caller_DoCTFErrorReport == assembly->DoCTFErrorReport &&
+        prior.source_return.caller_TimeStepZone->bits == assembly->TimeStepZone.bits;

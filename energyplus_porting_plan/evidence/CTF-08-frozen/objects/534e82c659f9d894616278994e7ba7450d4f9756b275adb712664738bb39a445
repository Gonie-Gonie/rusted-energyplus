+void copy_coefficient_history(Capture &capture, FinalCoefficientInvocationSnapshot &invocation,
+    FinalCoefficientStage stage, Construction::ConstructionProps const &construction,
+    FinalCoefficientValueSnapshot &snapshot) noexcept
+{
+    if (capture.bound_state == nullptr || capture.bound_construction != &construction) return;
+    snapshot.NumCTFTerms = construction.NumCTFTerms;
+    if (construction.s.allocated()) {
+        snapshot.s_bounds = Array3Bounds{construction.s.l1(), construction.s.u1(),
+            construction.s.l2(), construction.s.u2(), construction.s.l3(), construction.s.u3(), construction.s.size()};
+    }
+    snapshot.e_bounds = array_bounds(construction.e);
+    int const n = construction.rcmax;
+    if (n < 1 || static_cast<std::size_t>(n) > std::numeric_limits<std::size_t>::max() / 12) {
+        coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+        return;
+    }
+    std::size_t const count = static_cast<std::size_t>(n);
+    bool const s_shape = snapshot.s_bounds && snapshot.s_bounds->lower1 == 1 && snapshot.s_bounds->upper1 == 3 &&
+        snapshot.s_bounds->lower2 == 1 && snapshot.s_bounds->upper2 == 4 &&
+        snapshot.s_bounds->lower3 == 1 && snapshot.s_bounds->upper3 == n && snapshot.s_bounds->size == 12 * count;
+    if (!s_shape) {
+        coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+    } else {
+        try {
+            snapshot.s.reserve(12 * count);
+            for (int j = 1; j <= 3; ++j) {
+                for (int k = 1; k <= 4; ++k) {
+                    for (int term = 1; term <= n; ++term) snapshot.s.push_back(copy_bits(construction.s(j, k, term)));
+                }
+            }
+            snapshot.s_available = snapshot.s.size() == 12 * count;
+            if (!snapshot.s_available) coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+        } catch (...) {
+            snapshot.s.clear();
+            coefficient_failure(capture, &invocation, stage, MethodFailureKind::CopyException);
+        }
+    }
+    if (!exact_vector(snapshot.e_bounds, n)) {
+        coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+    } else {
+        try {
+            snapshot.e.reserve(count);
+            for (int term = 1; term <= n; ++term) snapshot.e.push_back(copy_bits(construction.e(term)));
+            snapshot.e_available = snapshot.e.size() == count;
+            if (!snapshot.e_available) coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+        } catch (...) {
+            snapshot.e.clear();
+            coefficient_failure(capture, &invocation, stage, MethodFailureKind::CopyException);
+        }
+    }
+    snapshot.history_available = snapshot.s_available && snapshot.e_available;
+}

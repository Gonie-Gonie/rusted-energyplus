inline bool final_coefficient_copy_failed(MethodObservation::FinalCoefficientCapture const &source)
{
    if (source.observer_failure || source.actual_invocation_count != source.invocations.size() ||
        source.first_failure || source.last_failure) return true;
    for (auto count : source.failure_event_counts) if (count != 0) return true;
    for (auto count : source.stage_records_omitted) if (count != 0) return true;
    std::array<std::size_t, 3> retained_counts{};
    using Owner = MethodObservation::FinalCoefficientMatrixOwner;
    for (std::size_t index = 0; index < source.invocations.size(); ++index) {
        auto const &record = source.invocations[index];
        if (record.observed_invocation_ordinal != index + 1 || !record.association_available ||
            record.observed_assembly_ordinal != record.observed_invocation_ordinal) return true;
        for (bool failed : record.failure_kinds) if (failed) return true;
        std::array<std::size_t, 3> const retained{{record.entry.reached ? 1u : 0u,
            record.private_final.reached ? 1u : 0u, record.source_return.reached ? 1u : 0u}};
        if (record.actual_stage_callback_counts != retained || !record.entry.reached ||
            (record.source_return.reached && !record.private_final.reached)) return true;
        for (std::size_t stage = 0; stage < retained.size(); ++stage) retained_counts[stage] += retained[stage];
        std::array<MethodObservation::FinalCoefficientValueSnapshot const *, 3> const values{{
            &record.entry, &record.private_final, &record.source_return}};
        std::array<std::vector<Owner>, 3> const owners{{
            {Owner::AExp, Owner::IdenMatrix, Owner::Gamma1, Owner::Gamma2},
            {Owner::Gamma1, Owner::s0, Owner::PhiR0, Owner::Rnew, Owner::Rold}, {Owner::Gamma1, Owner::s0}}};
        for (std::size_t stage = 0; stage < values.size(); ++stage) {
            auto const &value = *values[stage];
            if (!value.reached) continue; // Actual source stops do not fabricate stages.
            if (!value.matrices_available || !value.context.assembly_context_available || value.context.rcmax < 1 ||
                value.observed_matrix_count != owners[stage].size()) return true;
            for (std::size_t matrix = 0; matrix < value.observed_matrix_count; ++matrix) {
                auto const &copy = value.matrices[matrix];
                if (copy.owner != owners[stage][matrix] || !copy.copy_available || !copy.bounds) return true;
                auto const n = static_cast<std::size_t>(value.context.rcmax);
                auto const rows = copy.owner == Owner::Gamma1 || copy.owner == Owner::Gamma2 || copy.owner == Owner::s0 ? 3u : n;
                auto const columns = copy.owner == Owner::s0 ? 4u : n;
                if (columns > std::numeric_limits<std::size_t>::max() / rows || copy.values.size() != rows * columns ||
                    copy.bounds->lower1 != 1 || copy.bounds->upper1 != static_cast<int>(rows) ||
                    copy.bounds->lower2 != 1 || copy.bounds->upper2 != static_cast<int>(columns) ||
                    copy.bounds->size != copy.values.size()) return true;
            }
            if (stage == 0) {
                if (!value.CMat_available || !value.DMat_available || !value.CMat_bounds || !value.DMat_bounds ||
                    value.CMat_bounds->lower != 1 || value.CMat_bounds->upper != 2 || value.CMat_bounds->size != 2 ||
                    value.DMat_bounds->lower != 1 || value.DMat_bounds->upper != 2 || value.DMat_bounds->size != 2 ||
                    value.history_available || value.s_available || value.e_available || value.s_bounds || value.e_bounds ||
                    !value.s.empty() || !value.e.empty() || value.NumCTFTerms || value.controls || value.caller_context_available || value.caller_TimeStepZone) return true;
            } else {
                auto const n = static_cast<std::size_t>(value.context.rcmax);
                if (!value.history_available || !value.s_available || !value.e_available || !value.NumCTFTerms ||
                    !value.s_bounds || !value.e_bounds || n > std::numeric_limits<std::size_t>::max() / 12 ||
                    value.s.size() != 12 * n || value.e.size() != n ||
                    value.s_bounds->lower1 != 1 || value.s_bounds->upper1 != 3 || value.s_bounds->lower2 != 1 || value.s_bounds->upper2 != 4 ||
                    value.s_bounds->lower3 != 1 || value.s_bounds->upper3 != value.context.rcmax || value.s_bounds->size != value.s.size() ||
                    value.e_bounds->lower != 1 || value.e_bounds->upper != value.context.rcmax || value.e_bounds->size != value.e.size() ||
                    value.CMat_available || value.DMat_available || value.CMat_bounds || value.DMat_bounds) return true;
                if (stage == 1 && (!value.controls || value.caller_context_available || value.caller_TimeStepZone)) return true;
                if (stage == 2 && (value.controls || !value.caller_context_available || !value.caller_TimeStepZone)) return true;
            }
        }
    }
    return retained_counts != source.actual_stage_callback_counts;
}
inline json final_coefficient_observations(MethodObservation::FinalCoefficientCapture const &source)

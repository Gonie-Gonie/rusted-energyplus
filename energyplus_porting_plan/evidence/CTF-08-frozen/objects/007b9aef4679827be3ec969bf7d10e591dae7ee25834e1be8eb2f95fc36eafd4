inline json matrix_failure_kind(EnergyPlus::CTF08Observation::MatrixAttemptFailureKind kind)
{
    using Kind = EnergyPlus::CTF08Observation::MatrixAttemptFailureKind;
    switch (kind) {
    case Kind::IdentityMismatch: return "IdentityMismatch";
    case Kind::OrderFailure: return "OrderFailure";
    case Kind::ActivePrefixShape: return "ActivePrefixShape";

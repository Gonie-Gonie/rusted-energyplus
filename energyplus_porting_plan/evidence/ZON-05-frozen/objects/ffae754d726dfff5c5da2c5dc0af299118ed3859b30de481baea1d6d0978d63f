"""Independent actual ZON05 build/PE inspection; no engine is invoked."""
from pathlib import Path
import argparse
import datetime
import hashlib
import importlib.util
import json

ROOT = Path.cwd().resolve()
parser = argparse.ArgumentParser()
parser.add_argument('--build', required=True, help='Actual build manifest path#sha256')
parser.add_argument('--output-dir', required=True)
args = parser.parse_args()
OUT = (ROOT / args.output_dir).resolve()
assert OUT.is_relative_to(ROOT) and not OUT.exists()


def ref(path):
    path = path if isinstance(path, Path) else ROOT / path
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        while chunk := stream.read(16 * 1024 * 1024):
            digest.update(chunk)
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest.hexdigest(),
            'size_bytes': path.stat().st_size}


def bound(binding):
    path = (ROOT / binding['path']).resolve()
    assert path.is_relative_to(ROOT) and path.is_file()
    observed = ref(path)
    assert observed['sha256'] == binding['sha256']
    assert binding.get('size_bytes', observed['size_bytes']) == observed['size_bytes']
    return path


def write(path, value):
    assert not path.exists()
    path.write_text(json.dumps(value, indent=2) + '\n', encoding='utf-8')


build_name, separator, build_sha = args.build.rpartition('#')
assert separator and len(build_sha) == 64 and all(c in '0123456789abcdef' for c in build_sha)
build_path = bound({'path': build_name, 'sha256': build_sha})
build = json.loads(build_path.read_text(encoding='utf-8'))
prefix = 'zon05'
target = 'zon05_unit_helper'
assert build['schema'] == prefix + '-native-build.v1'
assert build['target'] == target
assert build['status'] == 'pass-actual-1TU-link-and-preservation'
for key in ('configure_execution', 'compile_execution', 'derivation_execution'):
    receipt = json.loads(bound(build[key]).read_text(encoding='utf-8'))
    assert receipt['exit_code'] == 0 and receipt['source_bytes_match_before_and_after']
    for stream in ('stdout', 'stderr'):
        bound(receipt[stream])
for key in ('all_previous_compile_commands_unchanged',
            'protected_artifacts_and_present_core_objects_unchanged', 'link_provider_verified'):
    assert build[key] is True
for key in ('previous_compile_rows', 'current_compile_rows', 'core_registered', 'core_present', 'core_absent', 'protected_ref_count'):
    assert type(build[key]) is int and build[key] >= 0
# One ZON TU plus the three authenticated inherited RAD registration rows.
assert (build['previous_compile_rows'], build['current_compile_rows']) == (717, 721)
for key in ('inherited_RAD_registration_count', 'new_ZON_registration_count', 'actual_fresh_compiled_TU_count'):
    assert type(build[key]) is int
assert (build['inherited_RAD_registration_count'], build['new_ZON_registration_count'], build['actual_fresh_compiled_TU_count']) == (3, 1, 1)
assert (build['core_registered'], build['core_present'], build['core_absent']) == (643, 631, 12)
assert build['protected_ref_count'] == 52
assert len(build['native_source_files']) == 4 and len(build['compiled_source_files']) == 1
assert {Path(row['path']).name for row in build['native_source_files']} == {
    'zon05_reference_helper.cpp', 'zon05_reference_fields.hh', 'zon01_reference_fields.hh', 'zon05_reference.cmake'}
for binding in build['native_source_files']:
    bound(binding)
assert build['compiled_source_files'] == [row for row in build['native_source_files'] if Path(row['path']).suffix == '.cpp']
preservation = json.loads(bound(build['preservation']).read_text(encoding='utf-8'))
assert preservation['schema'] == 'zon05-native-preservation-after.v1'
assert type(preservation['selected_core_ZoneTempPredictorCorrector_object_hits']) is int and preservation['selected_core_ZoneTempPredictorCorrector_object_hits'] > 0
provider = preservation['core_provider']
assert provider['symbol'].strip().endswith('EnergyPlus::ZoneTempPredictorCorrector::ZoneSpaceHeatBalanceData::correctHumRat(EnergyPlus::EnergyPlusData&, int, int)')
assert 'libenergypluslib.a(ZoneTempPredictorCorrector.cc.obj)' in provider['section_provider']['text']
section = provider['section_provider']['text'].split(); address = int(provider['symbol'].split()[0], 16)
assert int(section[1], 16) <= address < int(section[1], 16) + int(section[2], 16)
bound(preservation['link_map'])
assert preservation['target_objects_before_core_archive'] == len(preservation['actual_target_object_loads']) == 1
assert 'zon05_reference_helper.cpp.obj' in preservation['actual_target_object_loads'][0]['text']
assert len(preservation['present_objects']) == build['core_present']
assert len(preservation['absent_registered_object_paths']) == 12 and len(preservation['prior_original_absent_paths']) == 12
assert len(preservation['protected_refs']) == len({row['path'] for row in preservation['protected_refs']}) == build['protected_ref_count']
assert all(preservation[key] == build[key] for key in ('previous_compile_rows', 'current_compile_rows', 'core_registered'))
correspondence = json.loads(bound(preservation['actual_compile_correspondence']).read_text(encoding='utf-8'))
assert correspondence['schema'] == 'zon05-actual-compile-row-correspondence.v1'
assert len(correspondence['new_rows']) == 4 and len(correspondence['inherited_RAD_registration_rows']) == 3 and len(correspondence['new_ZON_rows']) == 1
assert len(correspondence['actual_one_new_TU_compile_commands']) == 1
assert all(correspondence[key] is True for key in ('all_prior_rows_unchanged_in_relative_order',
    'inherited_RAD_registration_rows_byte_equal_actual720', 'new_rows_selected_by_target_output_and_exact_source_set',
    'no_prior_core_or_RAD_object_compile_command_observed'))

derivation = json.loads(bound(build['validated_derivative']).read_text(encoding='utf-8'))
assert derivation['status'] == 'pass-exact-retained-runtime-sections-and-directories'
reader = ROOT / 'tools/porting/native_pe.py'
spec = importlib.util.spec_from_file_location('actual_zon_pe', reader)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
original = module.inspect(bound(build['linked_original']))
derived = module.inspect(bound(build['helper_binary']))
comparison = module.compare(original, derived)
assert comparison['status'] == 'pass-exact-retained-runtime-sections-and-directories'
assert original == json.loads(bound(derivation['maps']['original_before']).read_text(encoding='utf-8'))
assert derived == json.loads(bound(derivation['maps']['derived']).read_text(encoding='utf-8'))
OUT.mkdir(parents=True)
maps = {}
for name, value in (('original', original), ('derived', derived), ('comparison', comparison)):
    path = OUT / (name + '-pe.json')
    write(path, value)
    maps[name] = ref(path)
report = {'schema': prefix + '-independent-build-PE-review.v1',
          'status': 'pass-exact-retained-PE-runtime-and-actual-build-identity',
          'observed_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
          'lane': 'unit', 'target': target,
          'actual_previous_compile_rows': build['previous_compile_rows'],
          'actual_current_compile_rows': build['current_compile_rows'],
          'actual_protected_ref_count': build['protected_ref_count'],
          'build': ref(build_path), 'helper_binary': build['helper_binary'],
          'linked_original': build['linked_original'], 'validated_derivative': build['validated_derivative'],
          'native_pe_source': ref(reader), 'executed_reader': ref(Path(__file__).resolve()),
          'maps': maps, 'retained_runtime_exact': True,
          'engine_invoked': False, 'scientific_execution_certified': False, 'gates_updated': False}
write(OUT / 'review.json', report)
print(json.dumps({'review': ref(OUT / 'review.json'), 'status': report['status']}))

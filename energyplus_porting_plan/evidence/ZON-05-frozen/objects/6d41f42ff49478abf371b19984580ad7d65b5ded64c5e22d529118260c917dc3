"""Root-only existing derivative mechanism and actual ZON05 compile correspondence."""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
from pathlib import Path

p = argparse.ArgumentParser(); p.add_argument('--root', type=Path, default=Path.cwd())
p.add_argument('--before-preservation', required=True); p.add_argument('--prior-derivation-execution', required=True)
p.add_argument('--output-dir', required=True); a = p.parse_args(); ROOT = a.root.resolve()
def contained(value):
    path = (ROOT / value).resolve(); assert path.is_relative_to(ROOT) and path != ROOT; return path
def read(path): return json.loads(path.read_bytes())
def sha(path):
    with path.open('rb') as stream: return hashlib.file_digest(stream, 'sha256').hexdigest()
def ref(path): return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha(path), 'size_bytes': path.stat().st_size}
def bound(value):
    path, expected = value.rsplit('#', 1); path = contained(path); assert sha(path) == expected; return path, read(path)
def write(path, value):
    with path.open('x', encoding='utf8', newline='\n') as stream: json.dump(value, stream, indent=2); stream.write('\n')
def good(receipt):
    assert receipt['schema'] == 'recorded-porting-command.v1' and receipt['exit_code'] == 0
    assert receipt['source_bytes_match_before_and_after'] and receipt['launch_error'] is None

OUT = contained(a.output_dir); before_path, before = bound(a.before_preservation)
assert before_path == OUT / 'before/preservation.json' and before['schema'] == 'zon05-actual-before-build-preservation.v1'
prep_path = contained(before['build_source_manifest']['path']); assert ref(prep_path) == before['build_source_manifest']; prep = read(prep_path)
for row in prep['own_sources'] + prep['mechanism_sources'] + before['native_source_files']:
    actual = ref(contained(row['path'])); assert all(actual[key] == row[key] for key in ['path', 'sha256', 'size_bytes'])
assert Path(__file__).resolve() in {contained(row['path']) for row in prep['own_sources']}
compile_path = OUT / 'native-compile-command-01/receipt.json'; compile = read(compile_path); good(compile)
assert compile['source_snapshot'] == before['source_snapshot']
native_path = contained(before['native_source_manifest']['path']); assert ref(native_path) == before['native_source_manifest']
sources = [contained(row['path']) for row in before['compiled_source_files']]; assert len(sources) == len(set(sources)) == 1
directory = contained(before['build_directory']); after = OUT / 'after'; assert not after.exists(); after.mkdir()
live = directory / 'compile_commands.json'; copy = after / 'compile_commands.json'; shutil.copyfile(live, copy); assert sha(live) == sha(copy)
old_path = contained(before['compile_commands']['path']); assert sha(old_path) == before['compile_commands']['sha256']
rad_path = contained(before['actual_RAD720_compile_inventory']['path']); assert ref(rad_path) == before['actual_RAD720_compile_inventory']
old, new, rad = read(old_path), read(copy), read(rad_path)
def row_source(row): return (Path(row['directory']) / row['file']).resolve()
def target_row(row, name): return (Path(row['directory']) / row['output']).resolve().is_relative_to(directory / ('CMakeFiles/' + name + '.dir'))
rad_added = [row for row in new if target_row(row, 'rad01_unit_helper')]
zon_added = [row for row in new if target_row(row, 'zon05_unit_helper')]
remaining = [row for row in new if not target_row(row, 'rad01_unit_helper') and not target_row(row, 'zon05_unit_helper')]
assert len(old) == before['previous_compile_rows'] == 717 and len(rad) == 720 and len(new) == 721
assert rad_added == before['inherited_RAD_registration_rows'] == [row for row in rad if target_row(row, 'rad01_unit_helper')]
assert len(rad_added) == len({row['output'] for row in rad_added}) == 3
assert [row for row in rad if not target_row(row, 'rad01_unit_helper')] == old
assert len(zon_added) == len({row['output'] for row in zon_added}) == 1 and {row_source(row) for row in zon_added} == set(sources) and remaining == old
stdout = contained(compile['stdout']['path']); assert sha(stdout) == compile['stdout']['sha256']
compiled = [line for line in stdout.read_text(encoding='utf8').splitlines() if re.match(r'^\[\d+/\d+\] ', line) and ' -c ' in line]
assert len(compiled) == 1
normalized = compiled[0].replace('\\', '/').casefold()
assert 'cmakefiles/zon05_unit_helper.dir/' in normalized and sources[0].as_posix().casefold() in normalized
write(after / 'compile-row-correspondence.json', {'schema': 'zon05-actual-compile-row-correspondence.v1',
    'before': before['compile_commands'], 'after': ref(copy), 'previous_rows': len(old), 'current_rows': len(new),
    'actual_RAD720_compile_inventory': before['actual_RAD720_compile_inventory'], 'inherited_RAD_registration_rows': rad_added,
    'new_ZON_rows': zon_added, 'new_rows': [row for row in new if target_row(row, 'rad01_unit_helper') or target_row(row, 'zon05_unit_helper')],
    'all_prior_rows_unchanged_in_relative_order': True, 'inherited_RAD_registration_rows_byte_equal_actual720': True,
    'actual_compile_stdout': compile['stdout'], 'actual_one_new_TU_compile_commands': compiled,
    'new_rows_selected_by_target_output_and_exact_source_set': True, 'no_prior_core_or_RAD_object_compile_command_observed': True})
prior_path, prior = bound(a.prior_derivation_execution); good(prior)
original = directory / 'Products/zon05_unit_helper.exe'; original_ref = ref(original)
args = prior['command'][:]
assert args[:5] == ['python', '-X', 'utf8', '-B', 'tools/porting/derive_native_helper.py']
derivation = OUT / 'derivation'; assert not derivation.exists()
for flag, value in [('--original', original.relative_to(ROOT).as_posix()), ('--original-sha256', original_ref['sha256']), ('--output-dir', derivation.relative_to(ROOT).as_posix())]:
    assert args.count(flag) == 1; args[args.index(flag) + 1] = value
env = dict(os.environ); env['PATH'] = str(ROOT / '.runtime/reference-tools/winlibs-gcc13.2.0-ucrt-r3/mingw64/bin') + os.pathsep + env['PATH']
subprocess.run(['python', '-X', 'utf8', '-B', 'tools/porting/record_command.py', '--output-dir', (OUT / 'native-unit-derive-command-01').relative_to(ROOT).as_posix(), '--', *args], cwd=ROOT, check=True, env=env)
receipt = read(OUT / 'native-unit-derive-command-01/receipt.json'); good(receipt); assert receipt['source_snapshot'] == before['source_snapshot']
write(after / 'derivation-command-authority.json', {'schema': 'zon05-actual-derivation-command-authority.v1',
    'prior_derivation_execution': ref(prior_path), 'linked_original': original_ref, 'scientific_execution_performed': False})
print(json.dumps({'compile_correspondence': ref(after / 'compile-row-correspondence.json'), 'derivation_execution': ref(OUT / 'native-unit-derive-command-01/receipt.json')}), flush=True)


"""Freeze literal ZON05 direct-member inputs and sidecar contracts; Root only."""
import argparse
import hashlib
import importlib.util
import json
import re
from datetime import datetime, timezone
from pathlib import Path

IO_SHA = "4b791c0327e258597df5475a8b9f79de21fa2ca41c15a52111658a0631b3c948"
io_path = Path(__file__).resolve().with_name("packet_io.py")
if hashlib.sha256(io_path.read_bytes()).hexdigest() != IO_SHA:
    raise ValueError("Reviewed stdlib input/source helper differs")
spec = importlib.util.spec_from_file_location("zon05_packet_io", io_path)
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)

COMMIT = "6f2e40d10250a105b49966baa24d843711e61048"
NATIVE = {"path": ".runtime/porting/ZON-05/native-helper-prep-01/manifest.json",
          "sha256": "5f3d3fcaade1e95e434ff71e2636fe039e4e16758018d4b939aa193a82fd22e1"}
NATIVE_NAMES = ["zon05_reference_helper.cpp", "zon05_reference_fields.hh",
                "zon01_reference_fields.hh", "zon05_reference.cmake"]
FLAGS = {"frozen_before_this_ZON05_helper_execution": True,
         "frozen_before_numerical_execution": True, "expected_values_supplied": False,
         "expected_exits_supplied": False, "scientific_execution_performed": False,
         "full_engine_production_geometry_supplied": False}


def validate_inputs(fixture, policy):
    m.require(set(fixture) == {"schema", "card", "expected_values_supplied", "source_scope", "cases"} and
              fixture["schema"] == "zon05-native-unit-request.v1" and fixture["card"] == "ZON-05" and
              fixture["expected_values_supplied"] is False and fixture["source_scope"] ==
              "zone-only-mixed-noOA-noLatent-ThirdOrder-direct-member", "Exact five-key literal request required")
    m.require(policy["schema"] == "zon05-direct-member-observation-policy-proposal.v1" and
              policy["card"] == "ZON-05" and policy["production_admission_expanded"] is False and
              policy["no_local_or_expected_answer_recomputation"] is True and policy["gate_updates"] is False,
              "Accepted hash-bound pre-output Source policy required")
    cases = fixture["cases"]
    m.require(type(cases) is list and len(cases) == 21 and len({row["case_id"] for row in cases}) == len(cases),
              "All21 independently declared literal cases required")
    for case in cases:
        m.require(set(case) == {"case_id", "purpose", "admission_lane", "initial", "operations"} and
                  type(case["operations"]) is list and bool(case["operations"]) and
                  len({row["operation_id"] for row in case["operations"]}) == len(case["operations"]),
                  "Exact ordered case/operation identities required")
        for operation in case["operations"]:
            m.require(set(operation) == {"operation_id", "operation"} and operation["operation"] == "correctHumRat",
                      "Only literal direct-member requests admitted; no expected outcomes")
    counts = {"cases": len(cases), "correctHumRat": sum(len(case["operations"]) for case in cases)}
    m.require(counts == {"cases": 21, "correctHumRat": 43}, "Declared counts derive only from input arrays")
    return cases, counts


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ["approved-source-sha256", "source-manifest", "current-card", "actual-scope-amendment",
                 "actual-scope-amendment-execution", "output-dir"]:
        parser.add_argument("--" + name, required=True)
    args = parser.parse_args(); started = datetime.now(timezone.utc).isoformat()
    writer = m.identity(__file__)
    m.require(writer["sha256"] == args.approved_source_sha256 and Path.cwd().resolve() == m.ROOT, "Reviewed writer/cwd required")
    own_ref = m.argument(args.source_manifest); own = m.load(own_ref)
    m.require(own["schema"] == "zon05-input-writer-source-preparation.v1", "Reviewed writer preparation required")
    own_sources = [m.bind(row) for row in own["own_sources"]]
    m.require(own_sources == [writer, m.identity(io_path)], "Exact two writer sources required")
    native_ref = m.bind(NATIVE); native = m.load(native_ref)
    m.require(native["schema"] == "zon05-native-direct-member-source-preparation.v1" and native["energyplus_commit"] == COMMIT,
              "Exact reviewed Native direct-unit preparation required")
    fixture_ref = m.bind(native["input_fixture_proposal"]); policy_ref = m.bind(native["observation_policy_proposal"])
    fixture, policy = m.load(fixture_ref), m.load(policy_ref)
    cases_input, counts = validate_inputs(fixture, policy)
    native_sources = [m.bind(row) for row in native["own_sources"]]
    m.require([Path(row["path"]).name for row in native_sources] == NATIVE_NAMES, "Exact four Native source identities/order required")
    original_sources = [m.bind(row) for row in native["whole_source_and_metadata_identities"] if row["path"].startswith(".reference/energyplus-src/26.1.0/")]
    for row in native["source_ranges"]:
        raw = b"".join(m.contained(row["path"]).read_bytes().splitlines(keepends=True)[row["first_line"] - 1:row["last_line"]])
        m.require(hashlib.sha256(raw).hexdigest() == row["sha256"] and len(raw) == row["size_bytes"], "Actual pinned source range differs")
    card_ref = m.argument(args.current_card)
    m.require(card_ref["path"] == "energyplus_porting_plan/cards/ZON-05.md", "Actual current ZON05 card required")
    amendment_ref = m.argument(args.actual_scope_amendment); amendment = m.load(amendment_ref)
    execution_ref = m.argument(args.actual_scope_amendment_execution); execution = m.load(execution_ref)
    inventory = {"native_helper": native_ref, "input_fixture": fixture_ref, "observation_policy": policy_ref, "input_writer": own_ref}
    m.require(amendment["schema"] == "zon05-source-scope-amendment.v1" and amendment["cards"] == ["ZON-05"] and
              amendment["zon05_policy_source_inventory"] == inventory and amendment["strict_profiles_settled_before_outputs"] is True and
              amendment["all_other_gates_pending"] is True and amendment["actual_ZON05_successful_build_or_engine_execution_performed"] is False and
              amendment["requested_counts"] == counts, "Actual pre-output scope authority required")
    before = [m.bind(row) for row in amendment["before_documents"]]
    after = [m.bind(row) for row in amendment["after_documents"]]
    m.require(card_ref in after, "True current card must be an actual after-document")
    m.require(execution["schema"] == "recorded-porting-command.v1" and type(execution["exit_code"]) is int and
              execution["exit_code"] == 0 and execution["launch_error"] is None and execution["source_bytes_match_before_and_after"] is True and
              Path(execution["cwd"]).resolve() == m.ROOT and execution["command"] ==
              ["python", "-X", "utf8", "-B", "tools/porting/check_plan.py", "--check", "--card", "ZON-05"], "Actual scope check0 recorder required")
    for key in ["stdout", "stderr"]: m.bind(execution[key])
    m.require(execution["executed_launcher"]["historical_path"] == "tools/porting/record_command.py", "Real recorder source required")
    m.bind(execution["executed_launcher"]["archive"])
    output = m.contained(args.output_dir, existing=False)
    m.require(output.is_relative_to(m.BASE) and output != m.BASE and not output.exists(), "Fresh contained ZON05 packet directory required")
    m.recheck(); output.mkdir(parents=True, exist_ok=False)
    archive_dir = output / "source-archives"; archive_dir.mkdir()
    sources = own_sources + [native_ref, fixture_ref, policy_ref, own_ref] + original_sources + native_sources + after
    archives = [m.archive(row, archive_dir, index) for index, row in enumerate(sources)]
    authority = {"native_helper_source_manifest": native_ref, "input_fixture_proposal": fixture_ref, "observation_policy_proposal": policy_ref,
                 "writer_source_manifest": own_ref, "current_card": card_ref, "actual_scope_amendment": amendment_ref,
                 "actual_scope_amendment_execution": execution_ref, "actual_scope_check_role": "real-ZON-05-check-only",
                 "historical_before_documents": before, "current_after_documents": after,
                 "scope_recorder_role": "validated-already-Root-authored-documents; did-not-author-amendment"}
    source = m.emit(output / "source.json", {"schema": "zon05-source-contract.v1", **FLAGS, "energyplus_commit": COMMIT,
        "source_files": original_sources, "primary_source_ranges": native["source_ranges"], "source_authorities": authority})
    tolerances = m.emit(output / "tolerances.json", {"schema": "zon05-tolerances-contract.v1", **FLAGS,
        "observation_policy": policy, "source_proposal": policy_ref})
    common = {**FLAGS, "energyplus_commit": COMMIT, "actual_scope_amendment": amendment_ref,
              "actual_scope_amendment_execution": execution_ref, "observation_policy": policy}
    request_path = output / "helper-request.json"
    with request_path.open("xb") as stream:
        stream.write(m.contained(fixture_ref["path"]).read_bytes())
    request = m.identity(request_path)
    m.require(request["sha256"] == fixture_ref["sha256"] and request["size_bytes"] == fixture_ref["size_bytes"],
              "Actual helper request must be a byte-exact fixture copy; contracts stay sidecars")
    cases = m.emit(output / "cases.json", {"schema": "zon05-cases-contract.v1", **FLAGS, "helper_request": request,
        "source": source, "tolerances": tolerances, "requested_counts": counts, "literal_input_fixture": fixture_ref,
        "direct_member_only_parser_history_and_production_invoked": False})
    contracts = {"source": source, "cases": cases, "tolerances": tolerances}
    projection = m.emit(output / "projection.json", {"schema": "zon05-observation-projection.v1", **common,
        "helper_request": request, "contracts": contracts, "source_authorities": authority, "scientific_values_compared_or_PASS_claimed": False})
    admission = m.emit(output / "native-admission-contract.json", {"schema": "zon05-native-admission-contract.v1", **common,
        "helper_request": request, "projection": projection, "contracts": contracts, "native_source_files": native_sources, "requested_counts": counts})
    m.recheck()
    receipt = {"schema": "zon05-frozen-packet.v1", "status": "frozen-literal-input-and-policy-before-numerical-execution", **FLAGS,
        "started_utc": started, "finished_utc": datetime.now(timezone.utc).isoformat(), "source_authorities": authority,
        "source_preparation_approval": {"approved_writer_sha256": writer["sha256"], "source_manifest": own_ref, "reviewed_sources": own_sources},
        "helper_request": request, "native_admission_contract": admission, "projection": projection, "contracts": contracts,
        "requested_counts": counts, "native_source_manifest": native_ref, "observation_policy": policy, "executed_writer_sources": archives[:2], "reviewed_source_archives": archives,
        "scope_execution_exit_zero_source_guard_verified": True, "scientific_operands_evaluated": False,
        "expected_arrays_or_method_outcomes_generated": False, "numerical_PASS_claimed": False,
        "canonical_files_updated": False, "gates_updated": False, "production_geometry_certified": False}
    m.emit(output / "freeze-receipt.json", receipt); m.recheck()
    print(json.dumps(receipt, ensure_ascii=False, allow_nan=False, indent=2))


if __name__ == "__main__":
    main()

# Add one direct-member TU; retain all accepted RAD/CTF/earlier targets and options.
if(NOT DEFINED CLK03_REPOSITORY_ROOT OR NOT DEFINED ZON05_SOURCE_DIR)
  message(FATAL_ERROR "ZON05 requires explicit repository and reviewed helper-source directories")
endif()
include("${CLK03_REPOSITORY_ROOT}/.runtime/porting/RAD-01/native-helper-prep-02/rad01_reference.cmake")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_zon05_scheduled GLOBAL PROPERTY ZON05_REFERENCE_SCHEDULED)
  if(NOT _zon05_scheduled)
    set_property(GLOBAL PROPERTY ZON05_REFERENCE_SCHEDULED TRUE)
    function(zon05_add_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "ZON05 requires the verified unchanged Original GNU core archive")
      endif()
      get_target_property(_zon05_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_zon05_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      list(APPEND _zon05_defs ${_zon05_directory_defs})
      list(FILTER _zon05_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _zon05_defs)
      add_executable(zon05_unit_helper "${ZON05_SOURCE_DIR}/zon05_reference_helper.cpp")
      target_include_directories(zon05_unit_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${ZON05_SOURCE_DIR}")
      target_compile_definitions(zon05_unit_helper PRIVATE ${_zon05_defs})
      target_link_libraries(zon05_unit_helper PRIVATE energypluslib project_options project_fp_options project_warnings)
      target_compile_features(zon05_unit_helper PRIVATE cxx_std_20)
      target_link_options(zon05_unit_helper PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/zon05_unit_helper.map")
    endfunction()
    cmake_language(DEFER CALL zon05_add_reference)
  endif()
endif()

def require(ok, message):
    if not ok:
        raise ValueError(message)


def now():
    return datetime.now(timezone.utc).isoformat()


def time_of(value):
    stamp = datetime.fromisoformat(value)
    require(stamp.tzinfo is not None and stamp.utcoffset().total_seconds() == 0, 'Actual UTC timestamp required')
    return stamp


def raw_path(value):
    require(isinstance(value, (str, Path)), 'Typed path required')
    text = str(value)
    if text.startswith('\\\\?\\'):
        require(re.match(r'^\\\\\?\\[A-Za-z]:\\', text) is not None, 'Only verbatim drive paths admitted')
        text = text[4:]
    require(not text.startswith(('\\\\', '//')), 'UNC and device paths are outside this scope')
    raw = Path(text)
    raw = raw if raw.is_absolute() else ROOT / raw
    require(raw.is_relative_to(ROOT) and raw != ROOT and '..' not in raw.parts, 'Literal contained path required')
    return raw


def path_of(value, exists=True):
    raw = raw_path(value)
    current = ROOT
    for part in raw.relative_to(ROOT).parts:
        current /= part
        try:
            info = current.lstat()
        except FileNotFoundError:
            require(not exists, 'Required path is absent: ' + str(value))
            break
        require(not getattr(info, 'st_file_attributes', 0) & 0x400 and not stat.S_ISLNK(info.st_mode),
                'Reparse paths are not admitted: ' + str(value))
    path = raw.resolve(strict=exists)
    require(path.is_relative_to(ROOT) and path != ROOT, 'Path escapes repository')
    return path


def absent(value):
    raw = path_of(value, exists=False)
    try:
        raw.lstat()
    except FileNotFoundError:
        return True
    return False


def regular(value):
    path = path_of(value)
    require(stat.S_ISREG(path.lstat().st_mode), 'Regular non-reparse file required: ' + str(value))
    return path


def digest(path, algorithm='sha256', prefix=b''):
    before = path.stat()
    hasher = hashlib.new(algorithm)
    hasher.update(prefix)
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            hasher.update(block)
    after = path.stat()
    require((before.st_size, before.st_mtime_ns, before.st_ctime_ns)
            == (after.st_size, after.st_mtime_ns, after.st_ctime_ns), 'Bytes changed while hashing')
    return hasher.hexdigest()


def ref(value, expected=None, size=None, remember=True):
    path = regular(value)
    sha = digest(path)
    require(expected is None or sha == expected, 'Bound SHA differs: ' + str(value))
    require(size is None or type(size) is int and path.stat().st_size == size, 'Bound size differs')
    if remember:
        require(path not in SEEN or SEEN[path] == sha, 'Previously read bytes changed')
        SEEN[path] = sha
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha}


def bound(value, remember=True):
    require(type(value) is dict and {'path', 'sha256'} <= set(value)
            and set(value) <= {'path', 'sha256', 'size_bytes', 'line_count'}, 'Exact file identity required')
    result = ref(value['path'], value['sha256'], value.get('size_bytes'), remember)
    require(result['path'] == value['path'], 'Literal repository-relative file identity required')
    return result


def same(left, right):
    require(bound(left) == bound(right), 'Actual file identities differ')


def pin(value):
    path, separator, sha = str(value).rpartition('#')
    require(separator and re.fullmatch(r'[0-9a-f]{64}', sha), 'Required actual path#SHA256 input')
    return ref(path, sha)


def read(value, expected=None):
    binding = bound(value) if type(value) is dict else ref(value, expected)
    path = regular(binding['path'])
    require(path.stat().st_size <= 32 * 1024 * 1024, 'Only bounded metadata JSON is parsed')
    def pairs(rows):
        out = {}
        for key, item in rows:
            require(key not in out, 'Duplicate JSON key')
            out[key] = item
        return out
    def invalid(token):
        raise ValueError('Nonstandard JSON token: ' + token)
    return json.loads(path.read_text(encoding='utf8'), object_pairs_hook=pairs, parse_constant=invalid)


def recorded(value):
    item = read(value)
    require(item['schema'] == 'recorded-porting-command.v1' and type(item['exit_code']) is int
            and item['exit_code'] == 0 and item['launch_error'] is None
            and item['source_bytes_match_before_and_after'] is True
            and item['recorder_updates_gates'] is False and item['recorder_supplies_reference_answers'] is False,
            'Actual successful guarded recorded command required')
    require(Path(item['cwd']).resolve() == ROOT, 'Actual repository cwd required')
    require(item['repository_before']['head'] == item['repository_after']['head'], 'Recorded HEAD changed')
    for key in ['stdout', 'stderr', 'source_snapshot']:
        bound(item[key])
    bound(item['executed_launcher']['archive'])
    require(time_of(item['started_utc']) <= time_of(item['finished_utc']), 'Actual command interval differs')
    return item


def unchanged():
    for path, sha in SEEN.items():
        require(regular(path) == path and digest(path) == sha, 'Retained proof bytes changed: ' + str(path))


def fresh_output(value):
    output = path_of(value, exists=False)
    require(output.is_relative_to(ROOT / BASE) and output != ROOT / BASE and not output.exists(), 'Fresh ignored output required')
    return output


def encoded(value):
    return (json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode('utf8')


def write(output, name, value):
    with (output / name).open('xb') as stream:
        stream.write(encoded(value))
    return ref(output / name)


def approved_sources(manifest_ref, approved_sha, entry):
    manifest = read(manifest_ref)
    require(manifest['schema'] == 'ctf06-two-original-retention-source-proposal.v1', 'Reviewed exact source manifest required')
    rows = manifest['own_sources']
    require([Path(row['path']).name for row in rows] == NAMES, 'Exactly four ordered source files required')
    for name, row in zip(NAMES, rows):
        require(regular(row['path']) == Path(__file__).parent / name, 'Approved source owner differs')
        bound(row)
    require(ref(Path(__file__).parent / entry)['sha256'] == approved_sha, 'Explicit Root-approved executed source SHA differs')
    return bound(manifest_ref)

    assert row['opaque_reason']
for row in m['own_sources']:
    if row['path'].endswith('.py'):ast.parse(checked(row))
failed=json.loads(checked(m['retained_failed_publication_execution']))
assert failed['exit_code']==1 and failed['source_bytes_match_before_and_after'] is True
report=dict(schema='src05-production-publication-Root-narrow-Source-review.v1',Source_preparation=manifest,accepted=True,FULL_prior_review=ref(BASE/'ordinary-main-publication-prep-02/Root-FULL-Source-review-02.json'),all_narrow_diff_README21_author84_read=True,complete_descriptor_checks=checks,unique_identities=len(seen),exact_narrow_diffs=2,finite_exact_opaque_boundaries=16,all_other_functions_AST_exact02=True,mandatory_actual_custody_loads_unchanged=True,closed_log_guard_retained=True,prior_failed_publication_preserved=True,no_publisher_or_target_execution=True,scientific_values_read=False,gates_updated=False,review_Source=ref(Path(__file__)))

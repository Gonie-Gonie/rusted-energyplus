"""Source-byte audit after full human-model reading; no publisher import or execution."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
BASE = ROOT / '.runtime/porting/SRC-05'
seen = set()
checks = 0
def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw))
def checked(row):
    global checks
    raw = (ROOT / row['path']).read_bytes()
    assert hashlib.sha256(raw).hexdigest() == row['sha256'], row['path']
    assert 'size_bytes' not in row or len(raw) == row['size_bytes']
    assert 'line_count' not in row or len(raw.splitlines()) == row['line_count']
    checks += 1; seen.add((row['path'], row['sha256']))
    return raw
def collect(value):
    if isinstance(value, dict):
        if {'path', 'sha256'} <= value.keys() and 'start_line' not in value: checked(value)
        for key, child in value.items():
            if key != 'historical_source': collect(child)
    elif isinstance(value, list):
        for child in value: collect(child)
def delta(row):
    before = checked(row['before']) if row['before'] else b''
    proposed = checked(row['proposal'])
    actual = checked(row['exact_diff'])
    lines = actual.decode().splitlines(True)
    assert ''.join(difflib.unified_diff(before.decode().splitlines(True), proposed.decode().splitlines(True), fromfile=lines[0][4:].rstrip('\r\n'), tofile=lines[1][4:].rstrip('\r\n'))).encode() == actual
def dump(path, value):
    with path.open('x', encoding='utf8', newline='\n') as stream:
        json.dump(value, stream, indent=2); stream.write('\n')
    return ref(path)

first = BASE/'ordinary-main-publication-prep-01/manifest.json'
last = BASE/'ordinary-main-publication-prep-02/manifest.json'
assert ref(first)['sha256'] == 'bb5c1c20f6fa42721662c0ba09923de263217405e723bfb8affc2475a4d2fca7'
assert ref(last)['sha256'] == 'e91db61dd7cfd78ef06628652f7a23c324799753070cb417f8d6511b900a4d37'
m1, m2 = [json.loads(p.read_bytes()) for p in (first,last)]
collect(m1); collect(m2)
for row in m1['Source_ranges']:
    assert b''.join(checked(row['source']).splitlines(True)[row['start_line']-1:row['end_line']]) == checked(row['literal_archive'])
for row in m1['source_correspondence'] + m2['narrow_source_correspondence']: delta(row)
assert checked(m1['authentic_before_source']['actual_template']) == checked(m1['authentic_before_source']['actual_before_archive'])
old, new = [ast.parse(checked(m['own_sources'][0])) for m in (m1,m2)]
functions = lambda tree: {node.name:ast.dump(node, include_attributes=False) for node in tree.body if isinstance(node,ast.FunctionDef)}
f1,f2 = functions(old),functions(new)
assert set(f1)==set(f2) and {key for key in f1 if f1[key]!=f2[key]} == {'checked'}
for m in (m1,m2):
    for row in m['own_sources']:
        if row['path'].endswith('.py'): ast.parse(checked(row))
qa = dict(schema='src05-production-publication-Root-FULL-Source-review.v1', Source_preparation=ref(last), accepted=True, complete_descriptor_checks=checks, unique_identities=len(seen), literal_ranges=10, exact_full_and_narrow_diffs=4, full_publisher01_289_README17_author71_and02_delta_README19_author43_read=True, closed_log_guard_accepted=True, all_other_functions_byte_AST_exact=True, selected_four_Source_and_metadata_only_external_payload_scope_accepted=True, no_target_or_publisher_execution=True, no_scientific_event_values_read=True, gates_updated=False, prior_metadata_erratum='Application Root03 review boolean label says author53; actual sealed and fully read author is51 lines. No Source identity or protocol change.', review_Source=ref(Path(__file__)))
print(json.dumps(dump(last.parent/'Root-FULL-Source-review-02.json',qa)))

"""Join actual Root and independent formatter correspondence reviews."""
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
BASE = ROOT / '.runtime/porting/SRC-05'
def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw))
def load(name, sha):
    path = BASE / name; row = ref(path)
    assert row['sha256'] == sha
    return row, json.loads(path.read_bytes())
root_ref, root = load('ordinary-main-thread-applied-01/Root-actual-formatter-factual-review.json', '27c0f3801049eec797d327eb9df3c0eec9afd14bf067da0c3b8d047e4b81c617')
peer_ref, peer = load('Header-ordinary-main-thread-actual-formatter-review-01/review.json', '4dda08a9dffb3495d74a3c31d5005f6c27c3de14e5160107e9c7f56c52fc841f')
assert root['Root_FULL_formatter_correspondence_accepted'] and peer['independent_FULL_formatter_correspondence_accepted']
assert root['actual_application'] == peer['actual_application'] and root['Source_snapshot'] == peer['Source_snapshot']
review = dict(schema='src05-ordinary-main-thread-actual-formatter-review.v1', actual_application=root['actual_application'], Source_snapshot=root['Source_snapshot'], Root_FULL_formatter_correspondence_accepted=True, independent_FULL_formatter_correspondence_accepted=True, Root_factual_review=root_ref, independent_factual_review=peer_ref, review_Source=ref(Path(__file__).resolve()), scientific_PASS_claimed=False, gates_updated=False)
out = BASE / 'ordinary-main-thread-applied-01/Root-formatter-acceptance.json'
with out.open('x', encoding='utf8', newline='\n') as stream:
    json.dump(review, stream, indent=2); stream.write('\n')
print(json.dumps(ref(out)))

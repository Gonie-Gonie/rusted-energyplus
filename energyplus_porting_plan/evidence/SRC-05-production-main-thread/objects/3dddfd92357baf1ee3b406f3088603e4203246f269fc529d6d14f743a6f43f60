"""Apply four reviewed SRC06 rows after genuine Native factual release; record formatting."""
import difflib
import hashlib
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
BASE = ROOT / '.runtime/porting/SRC-06'
OUT = BASE / 'tarp-inside-applied-01'

def ref(path):
    data = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data))

def checked(row):
    path = ROOT / row['path']
    assert ref(path)['sha256'] == row['sha256'] and ('size_bytes' not in row or path.stat().st_size == row['size_bytes'])
    return path

def load(row): return json.loads(checked(row).read_bytes())
def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(data)
    return ref(path)

spec = importlib.util.spec_from_file_location('record_command', ROOT/'tools/porting/record_command.py')
recorder = importlib.util.module_from_spec(spec); spec.loader.exec_module(recorder)
assert ref(ROOT/'tools/porting/record_command.py')['sha256'] == '5745ad9809e196af00b858fcdc0d3d783531628fa2abf1e086f75c7d293514ba'
prep_ref = ref(BASE/'tarp-inside-getter-prep-01/manifest.json')
assert prep_ref['sha256'] == '7eb308271196d36cbcbf58f17cec8599ddd3c396a84c5c52fcab958933f99963'
prep = load(prep_ref)
root_review_ref = ref(BASE/'tarp-inside-getter-prep-01/Root-full-Source-review.json')
review = load(root_review_ref)
assert review['Root_FULL_Source_review_accepted'] and review['independent_Header_cumulative_Source_review_accepted']
baseline = load(review['genuine_Native_factual_baseline_released_before_math_application'])
assert baseline['Header_FULL_Native_input_owner_and_custody_factual_review_accepted'] and baseline['genuine_source_invocations'] == 60
actual_native = load(baseline['actual_Native_execution'])
assert actual_native['exit_code'] == 0 and actual_native['source_bytes_match_before_and_after']
assert not OUT.exists()
source_before = recorder.source_snapshot()
assert source_before['sha256'] == 'd34a84b7f0fad57ae1a46799a8b9b8b31247239206556ce342bb4e17287775c4'
for row in prep['application']:
    canonical = ROOT / row['canonical_path']
    checked(row['before_archive']); checked(row['proposal']); checked(row['exact_diff'])
    if row['actual_before'] is None: assert not canonical.exists()
    else: assert checked(row['actual_before']).read_bytes() == checked(row['before_archive']).read_bytes()
OUT.mkdir()
for row in prep['application']:
    canonical = ROOT / row['canonical_path']
    canonical.parent.mkdir(parents=True, exist_ok=True)
    canonical.write_bytes(checked(row['proposal']).read_bytes())
source_literal = recorder.source_snapshot()
result = subprocess.run([sys.executable, '-X','utf8','-B',str(ROOT/'tools/porting/record_command.py'),'--output-dir',str(OUT/'fmt-command'),'--','cargo','fmt','--all'],cwd=ROOT)
assert result.returncode == 0
fmt_ref = ref(OUT/'fmt-command/receipt.json')
fmt = load(fmt_ref)
source_final = recorder.source_snapshot()
assert fmt['source_snapshot'] == source_literal and fmt['exit_code'] == 0
rows = []
for row in prep['application']:
    canonical = ROOT / row['canonical_path']; proposal = checked(row['proposal'])
    final_archive = write(OUT/'formatted'/row['canonical_path'],canonical.read_bytes())
    delta = ''.join(difflib.unified_diff(proposal.read_text(encoding='utf8').splitlines(True),canonical.read_text(encoding='utf8').splitlines(True),fromfile=row['proposal']['path'],tofile=row['canonical_path']))
    diff_ref = write(OUT/'diffs'/(row['canonical_path'].replace('/','__')+'.formatter.diff'),delta.encode('utf8'))
    rows.append(dict(**row, actual_final=ref(canonical),actual_final_archive=final_archive,actual_formatter_diff=diff_ref))
old = {r['historical_path']:r for r in load(source_before)['files']}
new = {r['historical_path']:r for r in load(source_final)['files']}
allowed = {r['canonical_path'] for r in rows if r['canonical_path'].endswith('.rs')}
assert len(old) == 3928 and len(new) == 3929
assert set(new)-set(old) == {r['canonical_path'] for r in rows if r['new_destination_absent']}
unchanged = [name for name in old if name not in allowed]
assert len(unchanged) == 3926 and all(old[name] == new[name] for name in unchanged)
record = dict(schema='src06-tarp-inside-actual-application.v1',accepted_math_preparation=prep_ref,Root_full_Source_review=root_review_ref,
    genuine_Native_factual_baseline_before_application=review['genuine_Native_factual_baseline_released_before_math_application'],
    source_before=source_before,source_literal=source_literal,source_final=source_final,actual_formatter_execution=fmt_ref,
    unchanged_unrelated_Source_members=3926,application=rows,formatter_correspondence_review_pending=True,
    numerical_PASS_claimed=False,ordinary_traversal_or_handoff_verified=False,gates_updated=False)
record_ref=write(OUT/'record.json',(json.dumps(record,ensure_ascii=False,allow_nan=False,indent=2)+'\n').encode('utf8'))
print(json.dumps(dict(record=record_ref,source_final=source_final,unrelated=3926)))

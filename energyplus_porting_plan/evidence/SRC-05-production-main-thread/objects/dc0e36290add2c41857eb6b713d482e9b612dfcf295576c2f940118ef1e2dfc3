"""Release only the fully reviewed actual Native dispatcher baseline."""
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
BASE = ROOT / '.runtime/porting/SRC-06'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw))


def load(name, expected=None):
    path = BASE / name
    row = ref(path)
    assert expected is None or row['sha256'] == expected
    return row, json.loads(path.read_bytes())



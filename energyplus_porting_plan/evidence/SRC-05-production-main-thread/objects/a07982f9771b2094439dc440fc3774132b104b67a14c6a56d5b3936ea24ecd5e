def ref(path):
    path = path.resolve()
    with path.open('rb') as stream: digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else path.as_posix(), sha256=digest, size_bytes=path.stat().st_size)


def same(left, right):
    assert left['path'] == right['path'] and left['sha256'] == right['sha256']
    if 'size_bytes' in left and 'size_bytes' in right: assert left['size_bytes'] == right['size_bytes']


def checked(row, retain=True):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT), row['path']
    actual = ref(path)
    assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes']), row['path']
    VERIFIED[path] = actual
    if retain:
        assert path.suffix.lower() not in EXCLUDED
        if path.name in ('stdout.log', 'stderr.log'):
            closed_path = path.with_name('receipt.json')
            assert closed_path.is_file(), 'Unfinished command log cannot be published: ' + str(path)
            closed = json.loads(closed_path.read_bytes())
            assert closed['schema'] == 'recorded-porting-command.v1' and closed['finished_utc'] and closed['launch_error'] is None
            assert closed['executed_launcher']['archive']['sha256'] == RECORDER_SHA
            declared = closed['stdout' if path.name == 'stdout.log' else 'stderr']
            assert (ROOT / declared['path']).resolve() == path and declared['sha256'] == actual['sha256']
            assert declared.get('size_bytes', actual['size_bytes']) == actual['size_bytes']
            checked(ref(closed_path)); checked(closed['executed_launcher']['archive'])
        SELECTED[path] = actual
    return path


def load(row):
    return json.loads(checked(row).read_bytes())


def operand(value):
    path, digest = value.rsplit('#', 1)
    return ref(checked(dict(path=path, sha256=digest)))


def snapshot(row, current=False):
    path = checked(row)
    if path not in SNAPSHOTS:
        value = json.loads(path.read_bytes())
        assert value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False
        rows = {item['historical_path']: item for item in value['files']}
        assert len(rows) == len(value['files'])
        for item in rows.values(): assert checked(item['archive'], False).stat().st_size == item['size_bytes']
        SNAPSHOTS[path] = rows
    rows = SNAPSHOTS[path]
    if current:
        assert len(rows) == 3931
        for name, item in rows.items():
            checked(dict(path=name, sha256=item['archive']['sha256'], size_bytes=item['size_bytes']), name in CHANGED)
        actual_paths = {path.relative_to(ROOT).as_posix() for path in (ROOT / 'crates').rglob('*.rs')}
        actual_paths |= {path.relative_to(ROOT).as_posix() for path in (ROOT / 'crates').rglob('Cargo.toml')}
        actual_paths |= {name for name in ('Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml') if (ROOT / name).is_file()}
        assert actual_paths == set(rows)
    return rows


def receipt(row, source=None, code=None):
    value = load(row)
    assert value['schema'] == 'recorded-porting-command.v1' and value['finished_utc'] and value['launch_error'] is None
    assert value['executed_launcher']['archive']['sha256'] == RECORDER_SHA
    for key in ('stdout', 'stderr'): checked(value[key])
    checked(value['executed_launcher']['archive']); snapshot(value['source_snapshot'])
    if source is not None:
        same(value['source_snapshot'], source); assert value['source_bytes_match_before_and_after'] is True
    if code is not None: assert value['exit_code'] == code
    return value


def walk(value):
    """Selected proof closure; historical Source aliases and omitted payloads stay explicit."""
    if isinstance(value, list):
        for child in value: walk(child)
    elif isinstance(value, dict):
        if {'start_line', 'end_line', 'literal_archive'} <= value.keys():
            literal = checked(value['literal_archive']).read_bytes()
            assert hashlib.sha256(literal).hexdigest() == value['sha256'] and len(literal) == value['size_bytes']
            source = value.get('source')
            if source is not None:
                alias = ALIASES.get((source['path'], source['sha256']), source)
                path = checked(alias, alias['path'].endswith(tuple(CHANGED))) if not Path(alias['path']).is_absolute() else Path(alias['path'])
                actual = ref(path); assert actual['sha256'] == alias['sha256'] and actual['size_bytes'] == alias['size_bytes']
                lines = path.read_bytes().splitlines(True)
                assert b''.join(lines[value['start_line'] - 1:value['end_line']]) == literal
            return
        if {'path', 'sha256'} <= value.keys():
            name = value['path']; path = Path(name)
            if path.is_absolute() or path.suffix.lower() in EXCLUDED: return
            alias = ALIASES.get((name, value['sha256']))
            if alias is not None: checked(alias); return
            if path.suffix == '.rs' and not name.endswith(tuple(CHANGED)): return
            if name.startswith('crates/'):
                if name in CHANGED: checked(value)
                return
            if name.startswith('.runtime/porting/source-objects/'):
                if name.rsplit('/', 1)[-1] == value['sha256']:
                    # Snapshot descriptors are handled explicitly; raw unrelated sources are not selected.
                    return
            if not name.startswith(('.runtime/porting/', '.reference/', 'tools/porting/', 'energyplus_porting_plan/evidence/')): return
            actual = checked(value)
            opaque = OPAQUE_RECURSIVE_JSON.get(name)
            if opaque is not None:
                same(ref(actual), opaque['reference']); return
            if actual.suffix == '.json' and actual not in PARSED:
                PARSED.add(actual); body = json.loads(actual.read_bytes())
                if body.get('schema') == 'recorded-porting-command.v1': receipt(value)
                walk(body)
            return
        for key, child in value.items():
            if key not in SKIP_KEYS: walk(child)


def diff(before, after, declared, old_label, new_label):
    expected = ''.join(difflib.unified_diff(before.decode('utf8').splitlines(True), after.decode('utf8').splitlines(True), fromfile=old_label, tofile=new_label)).encode('utf8')
    assert checked(declared).read_bytes() == expected


def external(row, base=DATA):
    path = Path(row['path']).resolve()
    assert path.is_relative_to(base) and path.is_file()
    actual = ref(path)
    same(actual, row)
    assert actual['size_bytes'] == row['size_bytes']
    return dict(actual_full_file=actual, storage_available_at_publication=True, payload_published=False, encoding='unmodified-external-file')


def store():
    prior = {}
    for directory in (ROOT / 'energyplus_porting_plan/evidence').glob('*/objects'):
        for path in directory.iterdir():
            if path.is_file() and re.fullmatch('[0-9a-f]{64}', path.name): prior.setdefault(path.name, path)
    OUT.mkdir(); (OUT / 'objects').mkdir(); (OUT / 'observations').mkdir()
    objects = []
    for path, original in sorted(SELECTED.items()):
        assert ref(path) == original
        if original['size_bytes'] >= 512 * 1024:
            matches = sorted((ROOT / 'energyplus_porting_plan/evidence').glob('*/observations/' + original['sha256'] + '.json.gz'))
            target = matches[0] if matches else OUT / 'observations' / (original['sha256'] + '.json.gz')
            if not matches:
                with path.open('rb') as source, target.open('xb') as output:
                    with gzip.GzipFile(filename='', fileobj=output, mode='wb', mtime=0) as compressed: shutil.copyfileobj(source, compressed)
            digest = hashlib.sha256(); size = 0
            with gzip.open(target, 'rb') as stream:
                for chunk in iter(lambda: stream.read(1024 * 1024), b''): digest.update(chunk); size += len(chunk)
            assert digest.hexdigest() == original['sha256'] and size == original['size_bytes']
            objects.append(dict(original=original, stored=ref(target), encoding='gzip', complete_original_bytes_verified=True, reused=bool(matches)))
        else:
            target = prior.get(original['sha256'], OUT / 'objects' / original['sha256'])
            if not target.exists(): shutil.copyfile(path, target)
            actual = ref(target); assert actual['sha256'] == original['sha256'] and actual['size_bytes'] == original['size_bytes']
            prior[original['sha256']] = target
            objects.append(dict(original=original, stored=actual, encoding='raw', complete_original_bytes_verified=True, reused=not target.is_relative_to(OUT)))
    return objects



"""Narrow Source-only curve/model shape completion; no target commands."""
from pathlib import Path
import ast
import copy
import difflib
import hashlib
import json

ROOT = Path(__file__).resolve().parents[3]
OLD = ROOT / ".runtime/porting/SRC-06/native-tarp-dispatcher-prep-01"
OUT = ROOT / ".runtime/porting/SRC-06/native-tarp-dispatcher-prep-02"
assert hashlib.sha256((OLD / "manifest.json").read_bytes()).hexdigest() == "bde6fde556f907b930416942cd28f4a05aeabc3b42fa148ebad290700b5444c1"
OUT.mkdir(exist_ok=False)
(OUT / "before").mkdir()
(OUT / "diffs").mkdir()

def ref(path):
    data = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data), line_count=len(data.splitlines()))

def change(text, before, after):
    assert text.count(before) == 1
    return text.replace(before, after, 1)

fields = (OLD / "tarp_dispatcher_fields.hh").read_text(encoding="utf-8")
fields = change(fields, "json empty_family(Array const &owner)", "json empty_vector_family(Array const &owner)")
fields = change(fields, '{"nonempty_rows_available", false}};', '{"nonempty_rows_available", false}, {"indexing", "EPVector one-based"}};')
fields = change(fields, 'empty_family(d.userIntConvModels)', 'empty_vector_family(d.userIntConvModels)')
fields = change(fields, 'empty_family(d.userExtConvModels)', 'empty_vector_family(d.userExtConvModels)')
fields = change(fields,
    '{"hcIntUserCurve", empty_family(c.hcIntUserCurve)}, {"hcExtUserCurve", empty_family(c.hcExtUserCurve)},',
    '{"hcIntUserCurve", Src06::array1(c.hcIntUserCurve, [](auto const &) -> json { return nullptr; }, c.hcIntUserCurve.size() == 0)},\n'
    '            {"hcExtUserCurve", Src06::array1(c.hcExtUserCurve, [](auto const &) -> json { return nullptr; }, c.hcExtUserCurve.size() == 0)},')
readme = (OLD / "README.md").read_text(encoding="utf-8") + "\nThe narrow02 successor distinguishes actual container shapes: both zero-user curve families are Objexx Array1D and now retain allocation, size, lower and upper bounds through the existing array copier. The two user-model EPVectors retain their real one-based indexing shape. Unexpected nonempty unread families expose unavailable rows, never fabricated values. All inputs, calls, selected equations, other owners and policy bytes are literal01.\n"
files = {"tarp_dispatcher_helper.cpp": (OLD / "tarp_dispatcher_helper.cpp").read_bytes(),
         "tarp_dispatcher_fields.hh": fields.encode(), "tarp_dispatcher.cmake": (OLD / "tarp_dispatcher.cmake").read_bytes(),
         "README.md": readme.encode()}
before = []
diffs = []
for name, data in files.items():
    source = OLD / name
    archive = OUT / "before" / name
    archive.write_bytes(source.read_bytes())
    proposal = OUT / name
    proposal.write_bytes(data)
    delta = OUT / "diffs" / (name + ".from01.diff")
    delta.write_text("".join(difflib.unified_diff(archive.read_text().splitlines(True), proposal.read_text().splitlines(True),
                     fromfile=archive.relative_to(ROOT).as_posix(), tofile=proposal.relative_to(ROOT).as_posix())), encoding="utf-8", newline="\n")
    before.append(dict(original=ref(source), archive=ref(archive)))
    diffs.append(dict(before=ref(archive), proposal=ref(proposal), exact_diff=ref(delta)))
(OUT / "before/manifest.json").write_bytes((OLD / "manifest.json").read_bytes())
manifest = copy.deepcopy(json.loads((OLD / "manifest.json").read_bytes()))
manifest["predecessor_source_preparation"] = ref(OLD / "manifest.json")
manifest["predecessor_manifest_archive"] = ref(OUT / "before/manifest.json")
replacement = {row["path"]: ref(OUT / Path(row["path"]).name) for row in manifest["own_sources"] if Path(row["path"]).name in files}
manifest["own_sources"] = [replacement.get(row["path"], row) for row in manifest["own_sources"]] + [ref(Path(__file__).resolve())]
manifest["Native_source_files"] = [replacement.get(row["path"], row) for row in manifest["Native_source_files"]]
manifest["compiled_source_files"] = [ref(OUT / "tarp_dispatcher_helper.cpp")]
manifest["README"] = ref(OUT / "README.md")
manifest["authors"].append(ref(Path(__file__).resolve()))
manifest["before_archives"] = before
manifest["narrow_exact_diffs"] = diffs
manifest["narrow_scope"] = "Only complete zero-user-family container shape capture; no input/call/arithmetic/policy change"
assert (OUT / "tarp_dispatcher_helper.cpp").read_bytes() == (OLD / "tarp_dispatcher_helper.cpp").read_bytes()
assert (OUT / "tarp_dispatcher.cmake").read_bytes() == (OLD / "tarp_dispatcher.cmake").read_bytes()
ast.parse(Path(__file__).read_text())
(OUT / "manifest.json").write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8", newline="\n")
print(json.dumps(ref(OUT / "manifest.json")))

"""Review the actual four-file formatter closure without target execution."""
import hashlib
import importlib.util
import json
from pathlib import Path

ROOT = Path.cwd()
path = ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-application-prep-03/apply.py'
assert hashlib.sha256(path.read_bytes()).hexdigest() == 'f156146347a42f0f9ee0d13a6e180ab82773c7a9387c5200e85f464b95ba21c5'
spec = importlib.util.spec_from_file_location('FULL_reviewed_apply', path)
A = importlib.util.module_from_spec(spec); spec.loader.exec_module(A)
record_ref = A.operand('.runtime/porting/SRC-05/ordinary-main-thread-applied-01/record.json#b979f8ce4ab5b78ef3a71157917f9e24260ac18a4d7d6b0ae3ceda2d5b7c8afe')
actual = A.load(record_ref)
assert actual['schema'] == 'src05-ordinary-main-thread-actual-application.v1'
old = A.members(actual['source_before'])
current = A.members(actual['source_final'], current=True)
assert actual['source_before'] == A.BEFORE and actual['source_literal'] == actual['source_final']
assert len(old) == 3929 and len(current) == 3931
assert set(current) == set(old) | set(A.PATHS[-2:])
assert all(old[n] == current[n] for n in set(old)-set(A.PATHS))
held = A.load(A.PREP)['application']
assert [r['canonical_path'] for r in actual['application']] == A.PATHS
for row, original in zip(actual['application'], held):
    assert all(row[k] == v for k,v in original.items())
    before, literal, final = [A.bind(row[k]).read_bytes() for k in ['actual_before_archive', 'actual_literal_archive', 'actual_final_archive']]
    assert before == A.bind(original['before_archive']).read_bytes()
    assert literal == A.bind(original['proposal']).read_bytes() == final == A.bind(row['actual_final']).read_bytes()
    A.check_diff(before, literal, row['actual_semantic_diff'])
    A.check_diff(literal, final, row['actual_formatter_diff'])
    assert A.bind(row['actual_formatter_diff']).read_bytes() == b''
fmt = A.recorded(actual['actual_formatter_execution'], actual['source_literal'], ['cargo','fmt','--all'], stable=True)
outer_ref = A.ref(ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-application-command-01/receipt.json')
outer = A.load(outer_ref)
assert outer['exit_code'] == 0 and outer['launch_error'] is None and outer['source_bytes_match_before_and_after'] is False
assert outer['source_snapshot'] == A.BEFORE
baseline = A.load(actual['Native_baseline_acceptance'])
assert A.load(baseline['actual_Native_execution'])['finished_utc'] <= outer['started_utc'] <= fmt['started_utc']
report = dict(schema='src05-ordinary-main-thread-Root-actual-formatter-factual-review.v1', actual_application=record_ref, Source_snapshot=actual['source_final'], actual_outer_application=outer_ref, all_four_full_actual_semantic_diffs_and_empty_formatter_diffs_read=True, all_four_proposals_formatted_bytes_and_current_members_joined=True, full_before_source_count=3929, full_current_source_count=3931, unrelated_files_byte_exact=3927, Root_FULL_formatter_correspondence_accepted=True, genuine_Native_capture_precedes_actual_application=True, review_Source=A.ref(Path(__file__).resolve()), target_execution_performed=False, numerical_PASS_claimed=False)
print(json.dumps(A.dump(ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-applied-01/Root-actual-formatter-factual-review.json', report)))

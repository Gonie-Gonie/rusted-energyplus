TEMPLATE = ROOT / '.runtime/porting/SRC-06/native-dispatcher-observation-prep-01/run_execution.py'


def ref(path):
    raw = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(raw).hexdigest(), 'size_bytes': len(raw), 'line_count': len(raw.splitlines())}


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)
    return ref(path)


def bind(row):
    path = ROOT / row['path']; raw = path.read_bytes()
    assert hashlib.sha256(raw).hexdigest() == row['sha256'] and ('size_bytes' not in row or len(raw) == row['size_bytes'])
    return path


assert not (OUT / 'manifest.json').exists()
assert ref(APP)['sha256'] == 'e67df8b315cde068743aea3c542b30257e7156cc50588732a0c83d363877c5de'
assert ref(ACTUAL)['sha256'] == 'b979f8ce4ab5b78ef3a71157917f9e24260ac18a4d7d6b0ae3ceda2d5b7c8afe'
assert ref(SOURCE)['sha256'] == SOURCE.name
application = json.loads(ACTUAL.read_bytes()); assert application['source_final']['sha256'] == SOURCE.name
snapshot = json.loads(SOURCE.read_bytes()); assert len(snapshot['files']) == 3931
for row in snapshot['files']:
    assert bind(row['archive']).read_bytes() == (ROOT / row['historical_path']).read_bytes()
request = json.loads(REQUEST.read_bytes())
assert request['schema'] == 'ctf10-persistent-ordinary-history-invocation-request.v1' and request['selected_case_id'] == 'A-24H' and len(request['all45_fixed_input_guards']) == 45
keys = ['all45_fixed_input_guards', 'selected_input', 'selected_weather', 'selected_metadata', 'selected_idd', 'fixed_scope']
contract = {'schema': 'src05-ordinary-main-production-input-only-contract.v1', 'selected_case_id': 'A-24H', 'historical_actual_input_authority': ref(REQUEST), **{k: request[k] for k in keys}, 'expected_values_supplied': False, 'Native_results_supplied': False}
for row in contract['all45_fixed_input_guards']:
    bind(row['actual'])
for name in keys[1:]:
    bind(contract[name])
contract_ref = write(OUT / 'input-only-contract.json', (json.dumps(contract, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())
driver = OUT / 'run_execution.py'; ast.parse(driver.read_text(encoding='utf-8')); ast.parse(TEMPLATE.read_text(encoding='utf-8'))
assert ref(TEMPLATE)['sha256'] == 'd1cb3c42f68bea7e037269b3c9acb0bb20f2304244fbf25ad67915a6f5cc6b2d'
before = write(OUT / 'before/run_execution.py', TEMPLATE.read_bytes())
delta = ''.join(difflib.unified_diff(TEMPLATE.read_bytes().decode().splitlines(True), driver.read_bytes().decode().splitlines(True), fromfile=before['path'], tofile=ref(driver)['path'])).encode()
difference = write(OUT / 'run_execution.py.diff', delta)
app_manifest = json.loads(APP.read_bytes())
manifest = {'schema': 'src05-ordinary-main-production-execution-Source-preparation.v1', 'status': 'HELD_SOURCE_ONLY',
    'accepted_application_preparation': ref(APP), 'actual_application': ref(ACTUAL), 'required_Source_snapshot': application['source_final'],
    'own_sources': [ref(driver), ref(OUT / 'README.md'), contract_ref, ref(Path(__file__).resolve())],
    'input_only_contract': contract_ref, 'prior_actual_CLI_command': ref(CLI), 'prior_actual_observer_command': ref(OBSERVER),
    'authentic_before_source': {'actual_template': ref(TEMPLATE), 'authentic_before_archive': before},
    'source_correspondence': [{'before': before, 'proposal': ref(driver), 'exact_diff': difference}],
    'source_dependencies': [ref(ROOT / 'tools/porting/record_command.py')] + app_manifest['own_sources'] + [ref(REQUEST)],
    'Source_ranges': app_manifest['Source_ranges'],
    'runtime_interfaces': {'driver': ref(driver), 'options': ['--source-preparation', '--validation', '--Root-PE-acceptance', '--output-dir'], 'Root_PE_acceptance_schema': 'src05-ordinary-main-thread-Root-PE-acceptance.v1', 'before_schema': 'src05-ordinary-main-production-before.v1', 'custody_schema': 'src05-ordinary-main-production-execution-custody.v1'},
    'declared_scope': {'data_output_root': 'D:/CodexBuild/rusted-energyplus/SRC-05/ordinary-main-production-01', 'minimum_initial_D_free_bytes': 40 * 1024 ** 3, 'current_Source_members': 3931, 'actual_Cargo_artifacts_required': ['CLI', 'ordinary_observer'], 'observer_operand_count': 4, 'all45_fixed_input_guards_retained': True, 'whole_stream_and_all_output_files_hashed': True, 'event_values_parsed_or_filtered': False, 'floating_point_controls_written': False, 'canonical_mutated': False, 'targets_executed': False, 'numerical_results_read': False, 'gates_updated': False}}

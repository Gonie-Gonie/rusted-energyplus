import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-05/ordinary-main-execution-prep-01'
APP = ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-application-prep-03/manifest.json'
ACTUAL = ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-applied-01/record.json'
SOURCE = ROOT / '.runtime/porting/source-objects/00/00bfa56db38bf31ce1f11772b0c0d5cd0479d707fa80c6b3e20a54252db1fd0a'
REQUEST = ROOT / '.runtime/porting/CTF-10/ordinary-history-invocation-03/request.json'

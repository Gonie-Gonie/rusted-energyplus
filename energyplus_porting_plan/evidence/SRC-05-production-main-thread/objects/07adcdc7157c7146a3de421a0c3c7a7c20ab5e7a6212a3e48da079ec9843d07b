#[inline(never)]
fn controls() -> Value {
    let mut cw: u16 = 0;
    let mut mxcsr: u32 = 0;
    // SAFETY: both pointers address live, correctly sized writable locals.
    // FNSTCW and STMXCSR only read controls; they never load or modify controls.
    unsafe {
        std::arch::asm!("fnstcw [{address}]", address = in(reg) &mut cw, options(nostack, preserves_flags));
        std::arch::asm!("stmxcsr [{address}]", address = in(reg) &mut mxcsr, options(nostack, preserves_flags));
    }
    // SAFETY: genuine C fenv getter has no arguments and only reads thread state.
    let round = unsafe { fegetround() };
    json!({"x87_control_word":cw,"MXCSR":mxcsr,"c_fegetround":round,
        "x87_rounding_control_bits":(cw >> 10) & 3,"SSE_rounding_control_bits":(mxcsr >> 13) & 3})

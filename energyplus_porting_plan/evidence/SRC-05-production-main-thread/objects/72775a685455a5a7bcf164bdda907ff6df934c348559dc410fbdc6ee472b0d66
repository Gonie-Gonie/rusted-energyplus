--- /dev/null
+++ .runtime/porting/SRC-06/native-tarp-dispatcher-prep-01/tarp_dispatcher_fields.hh
@@ -0,0 +1,117 @@
+// Pure copies of relevant caller and retained setup owners; no convection equations.
+#ifndef SRC06_TARP_DISPATCHER_FIELDS_HH
+#define SRC06_TARP_DISPATCHER_FIELDS_HH
+#include "../native-tarp-inside-prep-02/tarp_inside_reference_fields.hh"
+#include "../../CTF-10/report-input-scan-native-prep-01/scan_unit_fields.hh"
+#include "../../CTF-01/native-production-prep-02/ctf01_reference_metadata.hh"
+#include <EnergyPlus/Construction.hh>
+#include <EnergyPlus/DataLoopNode.hh>
+#include <EnergyPlus/DataZoneEquipment.hh>
+#include <EnergyPlus/ZoneTempPredictorCorrector.hh>
+
+namespace Dispatcher {
+using Src06::json;
+using Src06::scalar;
+template<class Array, class Copy> json vector_owner(Array const &owner, Copy const &copy)
+{
+    json rows = json::array();
+    for (std::size_t i = 1; i <= owner.size(); ++i) { rows.push_back({{"actual_array_index", i}, {"value", copy(owner(i))}}); }
+    return {{"allocated", owner.allocated()}, {"size", owner.size()}, {"indexing", "EPVector one-based"}, {"rows", rows}};
+}
+inline json int_conv(EnergyPlus::DataSurfaces::SurfIntConv const &v)
+{
+    return {{"convClass", static_cast<int>(v.convClass)}, {"convClassRpt", v.convClassRpt}, {"model", static_cast<int>(v.model)},
+            {"userModelNum", v.userModelNum}, {"hcModelEq", static_cast<int>(v.hcModelEq)}, {"hcModelEqRpt", v.hcModelEqRpt},
+            {"hcUserCurveNum", v.hcUserCurveNum}, {"zoneWallHeight", scalar(v.zoneWallHeight)},
+            {"zonePerimLength", scalar(v.zonePerimLength)}, {"zoneHorizHydrDiam", scalar(v.zoneHorizHydrDiam)},
+            {"windowWallRatio", scalar(v.windowWallRatio)}, {"windowLocation", static_cast<int>(v.windowLocation)},
+            {"getsRadiantHeat", v.getsRadiantHeat}, {"hasActiveInIt", v.hasActiveInIt}};
+}
+inline json ext_conv(EnergyPlus::DataSurfaces::SurfExtConv const &v)
+{
+    return {{"convClass", static_cast<int>(v.convClass)}, {"convClassRpt", v.convClassRpt}, {"model", static_cast<int>(v.model)},
+            {"userModelNum", v.userModelNum}, {"hfModelEq", static_cast<int>(v.hfModelEq)}, {"hfModelEqRpt", v.hfModelEqRpt},
+            {"hfUserCurveNum", v.hfUserCurveNum}, {"hnModelEq", static_cast<int>(v.hnModelEq)}, {"hnModelEqRpt", v.hnModelEqRpt},
+            {"hnUserCurveNum", v.hnUserCurveNum}, {"faceArea", scalar(v.faceArea)},
+            {"facePerimeter", scalar(v.facePerimeter)}, {"faceHeight", scalar(v.faceHeight)}};
+}
+template<class Array> json empty_family(Array const &owner)
+{
+    // Only the absent-user domain is admitted. No nonempty unread row is disguised as captured.
+    return {{"allocated", owner.allocated()}, {"size", owner.size()}, {"rows", owner.size() == 0 ? json::array() : json(nullptr)},
+            {"nonempty_rows_available", false}};
+}
+inline json owners(EnergyPlus::EnergyPlusData const &s)
+{
+    auto const &d = *s.dataSurface;
+    auto const &h = *s.dataHeatBal;
+    auto const &c = *s.dataConvect;
+    json zones = json::array(), spaces = json::array();
+    for (std::size_t i = 1; i <= h.Zone.size(); ++i) {
+        auto const &v = h.Zone(i);
+        json order = json::array(); for (int index : v.spaceIndexes) { order.push_back(index); }
+        zones.push_back({{"actual_array_index", i}, {"Name", v.Name}, {"IntConvAlgo", static_cast<int>(v.IntConvAlgo)},
+                        {"ExtConvAlgo", static_cast<int>(v.ExtConvAlgo)}, {"spaceIndexes", order}, {"numSpaces", v.numSpaces},
+                        {"SystemZoneNodeNumber", v.SystemZoneNodeNumber}, {"CeilingHeight", scalar(v.CeilingHeight)},
+                        {"Volume", scalar(v.Volume)}, {"Multiplier", v.Multiplier}, {"ListMultiplier", v.ListMultiplier},
+                        {"FloorArea", scalar(v.FloorArea)}, {"MinimumX", scalar(v.MinimumX)}, {"MaximumX", scalar(v.MaximumX)},
+                        {"MinimumY", scalar(v.MinimumY)}, {"MaximumY", scalar(v.MaximumY)},
+                        {"ExtGrossWallArea", scalar(v.ExtGrossWallArea)}, {"ExtWindowArea", scalar(v.ExtWindowArea)}});
+    }
+    for (std::size_t i = 1; i <= h.space.size(); ++i) {
+        auto const &v = h.space(i);
+        spaces.push_back({{"actual_array_index", i}, {"Name", v.Name}, {"zoneNum", v.zoneNum},
+                         {"HTSurfaceFirst", v.HTSurfaceFirst}, {"HTSurfaceLast", v.HTSurfaceLast},
+                         {"WindowSurfaceFirst", v.WindowSurfaceFirst}, {"WindowSurfaceLast", v.WindowSurfaceLast}});
+    }
+    auto const hb = [](auto const &v) -> json { return {{"MAT", scalar(v.MAT)}, {"ZT", scalar(v.ZT)}, {"ZTAV", scalar(v.ZTAV)}}; };
+    auto const point = [](auto const &v) -> json { return {{"x", scalar(v.x)}, {"y", scalar(v.y)}, {"z", scalar(v.z)}}; };
+    auto const surf = [&](auto const &v) -> json {
+        return {{"Name", v.Name}, {"Zone", v.Zone}, {"spaceNum", v.spaceNum}, {"Construction", v.Construction},
+                {"Class", static_cast<int>(v.Class)}, {"OriginalClass", static_cast<int>(v.OriginalClass)},
+                {"HeatTransSurf", v.HeatTransSurf}, {"ExtBoundCond", v.ExtBoundCond},
+                {"RepresentativeCalcSurfNum", v.RepresentativeCalcSurfNum}, {"CosTilt", scalar(v.CosTilt)},
+                {"Tilt", scalar(v.Tilt)}, {"Azimuth", scalar(v.Azimuth)}, {"Area", scalar(v.Area)}, {"GrossArea", scalar(v.GrossArea)},
+                {"Width", scalar(v.Width)}, {"Height", scalar(v.Height)}, {"Perimeter", scalar(v.Perimeter)}, {"Sides", v.Sides},
+                {"Vertex", Src06::array1(v.Vertex, point)}};
+    };
+    auto const equip = [](auto const &v) -> json {
+        return {{"InWallActiveElement", v.InWallActiveElement}, {"InCeilingActiveElement", v.InCeilingActiveElement},
+                {"InFloorActiveElement", v.InFloorActiveElement}};
+    };
+    return {{"NumOfZones", s.dataGlobal->NumOfZones}, {"numSpaces", s.dataGlobal->numSpaces}, {"TotSurfaces", d.TotSurfaces},
+            {"BeginEnvrnFlag", s.dataGlobal->BeginEnvrnFlag}, {"SysSizingCalc", s.dataGlobal->SysSizingCalc},
+            {"ZoneSizingCalc", s.dataGlobal->ZoneSizingCalc}, {"UseRepresentativeSurfaceCalculations", d.UseRepresentativeSurfaceCalculations},
+            {"ZoneEquipInputsFilled", s.dataZoneEquip->ZoneEquipInputsFilled}, {"ZoneEquipSimulatedOnce", s.dataZoneEquip->ZoneEquipSimulatedOnce},
+            {"Zone", {{"allocated", h.Zone.allocated()}, {"size", h.Zone.size()}, {"rows", zones}}},
+            {"space", {{"allocated", h.space.allocated()}, {"size", h.space.size()}, {"rows", spaces}}},
+            {"zoneHeatBalance", vector_owner(s.dataZoneTempPredictorCorrector->zoneHeatBalance, hb)},
+            {"spaceHeatBalance", vector_owner(s.dataZoneTempPredictorCorrector->spaceHeatBalance, hb)},
+            {"ZoneEquipConfig_selected_members", Src06::array1(s.dataZoneEquip->ZoneEquipConfig, equip)},
+            {"Surface", vector_owner(d.Surface, surf)}, {"surfIntConv", vector_owner(d.surfIntConv, int_conv)},
+            {"surfExtConv", vector_owner(d.surfExtConv, ext_conv)},
+            {"Construct_TypeIsWindow", Src06::array1(s.dataConstruction->Construct, [](auto const &v) -> json { return v.TypeIsWindow; })},
+            {"SurfTempIn", Src06::array1(s.dataHeatBalSurf->SurfTempIn, scalar)},
+            {"SurfTempInTmp", Src06::array1(s.dataHeatBalSurf->SurfTempInTmp, scalar)},
+            {"SurfHConvInt", Src06::array1(s.dataHeatBalSurf->SurfHConvInt, scalar)},
+            {"SurfTAirRef", Src06::array1(d.SurfTAirRef, [](int v) -> json { return v; })},
+            {"SurfTAirRefRpt", Src06::array1(d.SurfTAirRefRpt, [](int v) -> json { return v; })},
+            {"SurfAdjacentZone", Src06::array1(d.SurfAdjacentZone, [](int v) -> json { return v; })},
+            {"SurfEMSOverrideIntConvCoef", Src06::array1(d.SurfEMSOverrideIntConvCoef, [](bool v) -> json { return v; })},
+            {"SurfEMSValueForIntConvCoef", Src06::array1(d.SurfEMSValueForIntConvCoef, scalar)},
+            {"LowHConvLimit", scalar(h.LowHConvLimit)}, {"HighHConvLimit_unread", scalar(h.HighHConvLimit)},
+            {"GetUserSuppliedConvectionCoeffs", c.GetUserSuppliedConvectionCoeffs}, {"NodeCheck", c.NodeCheck},
+            {"ActiveSurfaceCheck", c.ActiveSurfaceCheck}, {"MyEnvirnFlag", c.MyEnvirnFlag}, {"FirstRoofSurf", c.FirstRoofSurf},
+            {"CubeRootOfOverallBuildingVolume", scalar(c.CubeRootOfOverallBuildingVolume)},
+            {"RoofLongAxisOutwardAzimuth", scalar(c.RoofLongAxisOutwardAzimuth)},
+            {"TotUserIntConvModels", d.TotUserIntConvModels}, {"TotUserExtConvModels", d.TotUserExtConvModels},
+            {"userIntConvModels", empty_family(d.userIntConvModels)}, {"userExtConvModels", empty_family(d.userExtConvModels)},
+            {"hcIntUserCurve", empty_family(c.hcIntUserCurve)}, {"hcExtUserCurve", empty_family(c.hcExtUserCurve)},
+            {"NumOfNodes", s.dataLoopNodes->NumOfNodes},
+            {"Node_selected_members", Src06::array1(s.dataLoopNodes->Node, [](auto const &v) -> json {
+                return {{"Temp", scalar(v.Temp)}, {"MassFlowRate", scalar(v.MassFlowRate)}};
+            })},
+            {"Scan_cache", ScanUnit::cache(s)}, {"backend", Src06::backend(s)}};
+}
+} // namespace Dispatcher
+#endif

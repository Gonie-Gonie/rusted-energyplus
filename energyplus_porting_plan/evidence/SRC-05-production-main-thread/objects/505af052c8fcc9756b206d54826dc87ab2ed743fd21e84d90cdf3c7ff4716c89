"""Seal publisher02 closed-log selection guard; no publication or target action."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
OUT = ROOT / '.runtime/porting/SRC-05/ordinary-main-publication-prep-02'
OLD = ROOT / '.runtime/porting/SRC-05/ordinary-main-publication-prep-01'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


assert not (OUT / 'manifest.json').exists()
old_manifest = ref(OLD / 'manifest.json')
assert old_manifest['sha256'] == 'bb5c1c20f6fa42721662c0ba09923de263217405e723bfb8affc2475a4d2fca7'
manifest = json.loads((OLD / 'manifest.json').read_bytes())
assert (OUT / 'before-01/manifest.json').read_bytes() == (OLD / 'manifest.json').read_bytes()
narrow = []
for name in ('publish.py', 'README.md'):
    before = OUT / 'before-01' / name; proposed = OUT / name
    assert before.read_bytes() == (OLD / name).read_bytes()
    delta = ''.join(difflib.unified_diff(before.read_text(encoding='utf8').splitlines(True), proposed.read_text(encoding='utf8').splitlines(True), fromfile='before-01/' + name, tofile=name))
    path = OUT / (name + '.diff'); path.write_text(delta, encoding='utf8', newline='\n')
    narrow.append(dict(before=ref(before), proposal=ref(proposed), exact_diff=ref(path)))
old_ast = ast.parse((OLD / 'publish.py').read_bytes()); new_ast = ast.parse((OUT / 'publish.py').read_bytes())
old_functions = {node.name: ast.dump(node, include_attributes=False) for node in old_ast.body if isinstance(node, ast.FunctionDef)}
new_functions = {node.name: ast.dump(node, include_attributes=False) for node in new_ast.body if isinstance(node, ast.FunctionDef)}
assert set(old_functions) == set(new_functions) and {name for name in old_functions if old_functions[name] != new_functions[name]} == {'checked'}
manifest['own_sources'] = [ref(OUT / name) for name in ('publish.py', 'README.md')] + [ref(Path(__file__))]
manifest['prior_Source_preparation'] = old_manifest
manifest['preserved_prior_manifest'] = ref(OUT / 'before-01/manifest.json')
manifest['narrow_source_correspondence'] = narrow
manifest['fixed_evidence'] = manifest['fixed_evidence'] + [old_manifest]
manifest['runtime_interfaces']['publisher'] = ref(OUT / 'publish.py')
manifest['selected_scope']['selected_standard_logs_require_closed_matching_sibling_receipt'] = True
ast.parse(Path(__file__).read_bytes())
(OUT / 'manifest.json').write_text(json.dumps(manifest, ensure_ascii=False, allow_nan=False, indent=2) + '\n', encoding='utf8', newline='\n')
print(json.dumps(ref(OUT / 'manifest.json')))

"""Author independent literal caller operands, never expected coefficients."""
from pathlib import Path
import copy
import json
import struct

HERE = Path(__file__).resolve().parent

def real(value):
    return {"bits": struct.pack(">d", value).hex()}

def surface(index, space=1, cls="Wall", cosine=0.0, tilt=90.0, explicit=False):
    # Literal geometry is an exogenous unit owner, not generated by a model loader.
    vertices = [(0, 0, 0), (4, 0, 0), (4, 0, 3), (0, 0, 3)]
    if cls == "Roof":
        vertices = [(0, 0, 3), (4, 0, 3), (4, 4, 3), (0, 4, 3)]
    elif cls == "Floor":
        vertices = [(0, 0, 0), (0, 4, 0), (4, 4, 0), (4, 0, 0)]
    return {"actual_array_index": index, "Name": f"Surface-{index}", "spaceNum": space,
            "Class": cls, "model": "ASHRAETARP" if explicit else "SetByZone",
            "CosTilt": real(cosine), "Tilt": real(tilt), "Azimuth": real((index - 1) * 45 % 360),
            "Area": real(16 if cls != "Wall" else 12), "GrossArea": real(16 if cls != "Wall" else 12),
            "Width": real(4), "Height": real(3), "Perimeter": real(16 if cls != "Wall" else 14),
            "Vertex": [{axis: real(value) for axis, value in zip(("x", "y", "z"), point)} for point in vertices],
            "SurfTempIn": real(24), "SurfTempInTmp": real(22), "SurfHConvInt": real(7.25),
            "SurfTAirRef": 0, "SurfTAirRefRpt": 1}

def initial(rows, split=None, reverse=False, node=False, stale=False):
    split = split if split is not None else [len(rows)]
    spaces = []
    cursor = 1
    for index, count in enumerate(split, 1):
        first, last = (cursor, cursor + count - 1) if count else (1, 0)
        spaces.append({"actual_array_index": index, "Name": f"Space-{index}", "HTSurfaceFirst": first,
                       "HTSurfaceLast": last, "MAT": real(18 if index == 1 else 26)})
        cursor += count
    order = list(range(1, len(spaces) + 1))
    if reverse:
        order.reverse()
    return {"zone": {"Name": "One-Zone", "spaceIndexes": order, "MAT": real(20),
                     "CeilingHeight": real(3), "Volume": real(48), "FloorArea": real(16),
                     "MinimumX": real(0), "MaximumX": real(4), "MinimumY": real(0), "MaximumY": real(4),
                     "ExtGrossWallArea": real(48), "ExtWindowArea": real(0), "Multiplier": 1, "ListMultiplier": 1},
            "spaces": spaces, "surfaces": rows, "node_allocated": node,
            "zone_equipment_active_elements": {"wall": stale, "ceiling": stale, "floor": stale}}

def operation(index, init, owner="SurfTempInTmp", begin=True, sizing=False, filled=False, simulated=False, delta=0):
    return {"operation_id": f"call-{index}", "temperature_owner": owner, "BeginEnvrnFlag": begin,
            "SysSizingCalc": sizing, "ZoneSizingCalc": False, "ZoneEquipInputsFilled": filled,
            "ZoneEquipSimulatedOnce": simulated, "zone_MAT": real(20 + delta),
            "space_MAT": [copy.deepcopy(s["MAT"]) for s in init["spaces"]],
            "SurfTempIn": [copy.deepcopy(s["SurfTempIn"]) for s in init["surfaces"]],
            "SurfTempInTmp": [copy.deepcopy(s["SurfTempInTmp"]) for s in init["surfaces"]]}

cases = []

def add(name, purpose, init, ops):
    cases.append({"case_id": name, "purpose": purpose, "initial": init, "operations": ops})

v = initial([surface(i) for i in range(1, 5)] + [surface(5, cls="Roof", cosine=1, tilt=0), surface(6, cls="Floor", cosine=-1, tilt=180)])
add("first-repeat-environment", "Real first GetUser/static/report setup, repeat call and environment flag reset; no manager cadence claim", v,
    [operation(1, v), operation(2, v, owner="SurfTempIn", begin=False), operation(3, v, begin=True)])
v = initial([surface(1), surface(2), surface(3, 2, cosine=0.5, tilt=60), surface(4, 2, cosine=-0.5, tilt=120)], [2, 2], reverse=True)
add("reverse-space-order", "One Zone traverses actual spaceIndexes [2,1]; space MAT18/26 differs from zone MAT20", v,
    [operation(1, v), operation(2, v, owner="SurfTempIn"), operation(3, v, begin=False, delta=10)])
v = initial([surface(1, cosine=0.0), surface(2, cosine=-0.0)])
add("signed-zero-cosine", "Both stored signed-zero cosine owners, retained reference-air flags and nonzero incoming coefficients", v,
    [operation(1, v), operation(2, v, owner="SurfTempIn")])
v = initial([surface(1), surface(2, cls="Roof", cosine=1, tilt=0)])
for row in v["surfaces"]:
    row["SurfTempIn"] = row["SurfTempInTmp"] = real(18)
add("zero-delta-default-lower", "Equal actual space MAT and temperature operand, genuine default LowHConvLimit constructor owner", v,
    [operation(1, v), operation(2, v, begin=False)])
v = initial([surface(1, cosine=0.5, tilt=60), surface(2, cosine=-0.5, tilt=120)])
v["surfaces"][0]["SurfTempInTmp"] = real(18 + 2 ** -20)
v["surfaces"][1]["SurfTempInTmp"] = real(18 - 2 ** -20)
v["surfaces"][0]["SurfTempIn"] = real(30)
v["surfaces"][1]["SurfTempIn"] = real(5)
add("small-delta-two-sided", "Small nonzero and opposite signed deltas with exact selected temp-array identity", v,
    [operation(1, v), operation(2, v, owner="SurfTempIn")])
v = initial([surface(1), surface(2)], node=True, stale=True)
add("readiness-transitions", "NodeCheck and ActiveSurfaceCheck remain genuine until actual declared readiness; inactive surfaces overwrite stale equipment markers", v,
    [operation(1, v, sizing=True), operation(2, v, filled=True),
     operation(3, v, filled=True, simulated=True), operation(4, v, begin=False, filled=True, simulated=True)])
v = initial([], [0])
add("empty-HT-range", "Positive zone geometry with genuine empty space HT range; first-call setup still executes", v,
    [operation(1, v), operation(2, v, begin=False, simulated=True)])
v = initial([surface(1, explicit=True), surface(2, cls="Floor", cosine=-1, tilt=180)])
add("explicit-and-zone-TARP", "Actual explicit surface ASHRAETARP and genuine SetByZone resolution in the same nonwindow owner", v,
    [operation(1, v), operation(2, v, owner="SurfTempIn", begin=False)])

literal_idf = ("Version,26.1;\nTimestep,4;\n"
               "Building,DISPATCHER UNIT INPUT,0,Suburbs,0.04,0.4,FullExterior,25,6;\n"
               "GlobalGeometryRules,UpperLeftCorner,CounterClockWise,Relative;\n")
request = {"schema": "src06-tarp-dispatcher-direct-request.v1", "expected_values_supplied": False,
           "ordinary_production_prestate_supplied": False, "literal_IDF": literal_idf, "cases": cases}
HERE.joinpath("literal-no-user.idf").write_bytes(literal_idf.encode())
HERE.joinpath("input-only-cases.json").write_text(json.dumps(request, indent=2) + "\n", encoding="utf-8", newline="\n")
print(json.dumps({"cases": len(cases), "dispatcher_calls": sum(len(c["operations"]) for c in cases),
                  "literal_IDF_bytes": len(literal_idf.encode()), "expected_values_supplied": False}))

"""Review complete genuine input/owner/call/file custody; no equation evaluation."""
import ast
import hashlib
import json
from pathlib import Path
import struct

ROOT = Path.cwd()
BASE = ROOT / '.runtime/porting/SRC-06'
HERE = BASE / 'tarp-dispatcher-Native-observation-01'
helper = ast.parse((BASE / 'accept-native-provider-Root-01.py').read_text())
namespace = dict(ROOT=ROOT, hashlib=hashlib, json=json)
definitions = ast.Module(body=[n for n in helper.body if isinstance(n, ast.FunctionDef) and n.name in ('ref', 'dump')], type_ignores=[])
exec(compile(definitions, '<Root-authored-full-byte-helpers>', 'exec'), namespace)
ref, dump = namespace['ref'], namespace['dump']
seen = {}
def check(row):
    path = (ROOT / row['path']).resolve()
    if path not in seen:
        seen[path] = ref(path)
    actual = seen[path]
    assert actual['sha256'] == row['sha256'], row['path']
    assert all(row[k] == actual['size_bytes'] for k in ('size_bytes', 'bytes') if k in row)
    return path
def load(row):
    return json.loads(check(row).read_bytes())
def receipt(row):
    value = load(row)
    assert value['schema'] == 'recorded-porting-command.v1' and value['launch_error'] is None and value['source_bytes_match_before_and_after'] is True
    check(value['stdout']); check(value['stderr'])
    check(value['executed_launcher']['archive'])
    return value
custody_ref = ref(HERE / 'custody.json')
guard = load(custody_ref)
before_ref = guard['actual_before']
before = load(before_ref)
assert guard['schema'] == 'src06-tarp-dispatcher-execution-custody.v1' and before['schema'] == 'src06-tarp-dispatcher-execution-before.v1'
assert guard['all_frozen_artifacts_unchanged'] is True and guard['FP_controls_modified'] is False
assert guard['actual_target_exit_code'] == guard['actual_recorder_exit_code'] == 0
assert len(before['frozen_artifacts']) == len(guard['frozen_artifacts_after'])
for a, b in zip(before['frozen_artifacts'], guard['frozen_artifacts_after']):
    assert b['available'] is True and all(a[k] == b[k] for k in ('path', 'sha256', 'size_bytes'))
    check(a)
target_ref = guard['actual_command_receipt']
target = receipt(target_ref)
assert target['exit_code'] == 0 and target['command'] == before['actual_argv'] and len(target['command']) == 3
assert target['source_snapshot']['sha256'] == before['Source_snapshot']['sha256'] == '8aa752f4b95a86a2f49f243447fa8ea905761c37bea9d30b614c150df3a61934'
assert check(before['actual_binary']) == Path(target['command'][0]).resolve() and check(before['actual_input']) == Path(target['command'][1]).resolve()
for role in ('stdout', 'stderr'):
    assert check(guard['actual_full_output_logs'][role]) == check(target[role])
assert check(target['stderr']).stat().st_size == 0
result = load(target['stdout'])
request = load(before['actual_input'])
idf = check(before['literal_IDF']).read_bytes()
assert idf == request['literal_IDF'].encode() and len(idf) == 158
assert result['schema'] == 'src06-tarp-dispatcher-direct-results.v1' and result['requested_case_count'] == result['recorded_case_count'] == 8
assert result['Original_bodies_modified'] is False and result['inner_surface_visit_trace_available'] is False and result['scientific_PASS_claimed'] is False
assert check(result['request_before']) == check(before['actual_input']) == check(result['request_after'])
cases = {r['case_id']: r for r in result['cases']}
assert len(cases) == len(result['cases']) == len(request['cases']) == 8
literal_bits_checked = 0
def same_real(actual, literal):
    global literal_bits_checked
    assert set(literal) == {'bits'} and actual['value_bits'] == literal['bits']
    assert actual['value_class'] in ('finite', 'positive_zero', 'negative_zero')
    literal_bits_checked += 1
def vector_values(owner):
    assert owner['size'] == len(owner['rows'])
    assert [r['actual_array_index'] for r in owner['rows']] == list(range(1, owner['size'] + 1))
    return [r['value'] for r in owner['rows']]
def snapshot(value):
    assert value['callback_integrity_failed'] is False
    assert value['actual_callback_count'] == len(value['callbacks'])
    assert [r['actual_ordinal'] for r in value['callbacks']] == list(range(1, len(value['callbacks']) + 1))
def written(owner, op):
    for name in ('BeginEnvrnFlag', 'SysSizingCalc', 'ZoneSizingCalc', 'ZoneEquipInputsFilled', 'ZoneEquipSimulatedOnce'):
        assert owner[name] == op[name]
    same_real(vector_values(owner['zoneHeatBalance'])[0]['MAT'], op['zone_MAT'])
    for actual, literal in zip(vector_values(owner['spaceHeatBalance']), op['space_MAT'], strict=True):
        same_real(actual['MAT'], literal)
    for name in ('SurfTempIn', 'SurfTempInTmp'):
        for actual, literal in zip(vector_values(owner[name]), op[name], strict=True):
            same_real(actual, literal)
calls_count = input_write_count = complete_snapshot_count = 0
produced = []
for item in request['cases']:
    case = cases[item['case_id']]
    assert case['literal_input'] == item and case['physical_IDF_bytes_unchanged'] is True
    assert check(case['physical_IDF_before']).read_bytes() == check(case['physical_IDF_after']).read_bytes() == idf
    assert case['actual_source_stopped'] is False and case['unreached_operations'] == [] and case['inner_surface_visit_trace_available'] is False
    assert len(case['actual_no_user_object_counts']) == 6
    assert [r['actual_validation_getter_ordinal'] for r in case['actual_no_user_object_counts']] == list(range(1, 7))
    assert all(r['actual_count'] == 0 for r in case['actual_no_user_object_counts'])
    actual_calls = case['actual_calls']
    assert len(actual_calls) == case['actual_recorded_outer_call_count'] == len(item['operations']) + 1
    assert [r['actual_call_ordinal'] for r in actual_calls] == list(range(1, len(actual_calls) + 1))
    assert actual_calls[0]['api'] == 'InputProcessor::processInput' and actual_calls[0]['operation_id'] == 'process-input'
    assert actual_calls[0]['before'] == case['fresh_constructor_state']
    assert all(r['actual_source_invoked'] is True and r['actual_source_return_observed'] is True and r['source_exception'] is None for r in actual_calls)
    calls = {r['operation_id']: r for r in actual_calls[1:]}
    writes = {r['operation_id']: r for r in case['actual_operation_input_writes']}
    assert len(calls) == len(writes) == len(item['operations'])
    previous = case['prepared_literal_owners']
    for op in item['operations']:
        call, write = calls[op['operation_id']], writes[op['operation_id']]
        assert call['api'] == 'Convect::InitIntConvCoeff' and write['literal_input'] == op
        assert write['before_declared_writes'] == previous and write['after_declared_writes'] == call['before']
        written(call['before']['owner'], op)
        for observed in (write['before_declared_writes'], write['after_declared_writes'], call['before'], call['after']):
            snapshot(observed)
            complete_snapshot_count += 1
        previous = call['after']
        input_write_count += 1
    assert previous == case['final']
    assert case['post_owner_disposal_transport']['callback_integrity_failed'] is False
    for row in case['produced_files_full_SHA_inventory']:
        check(row); produced.append(dict(path=str(check(row)), sha256=row['sha256'], size_bytes=row['size_bytes']))
    calls_count += len(actual_calls)
assert calls_count == 28 and input_write_count == 20
actual_files = [dict(path=str(check(row)), sha256=row['sha256'], size_bytes=row['size_bytes']) for row in guard['produced_case_files_full_SHA_inventory']]
assert sorted(produced, key=lambda r: r['path']) == sorted(actual_files, key=lambda r: r['path'])
report = dict(schema='src06-tarp-dispatcher-Root-factual-baseline-review.v1', actual_Native_custody=custody_ref, actual_Native_execution=target_ref, actual_before=before_ref, complete_cases=8, actual_processInput_calls=8, actual_Init_calls=20, total_actual_returned_calls=28, complete_input_write_prefixes=20, literal_operation_real_owner_joins=literal_bits_checked, complete_operation_snapshots=complete_snapshot_count, full_frozen_file_identities=len(seen), produced_file_inventory_rows=len(produced), input_owner_prefix_and_custody_accepted=True, equations_recomputed=False, numerical_PASS_claimed=False, inner_trace_inferred=False, current_Source_unchanged=True, review_Source=ref(Path(__file__)))
dump(HERE / 'Root-factual-review-01.json', report)
print(json.dumps(report))

"""Independently authenticate actual ten-provider map and full PE custody."""
import ast
import hashlib
import json
import mmap
from pathlib import Path
import re
import sys

ROOT = Path.cwd()
BASE = ROOT / '.runtime/porting/SRC-06/native-dispatcher-provider-review-01'
SEEN = {}
helpers = ast.parse((ROOT / '.runtime/porting/SRC-06/accept-native-provider-Root-01.py').read_text())
namespace = dict(ROOT=ROOT, hashlib=hashlib, json=json, SEEN=SEEN)
definitions = ast.Module(body=[n for n in helpers.body if isinstance(n, ast.FunctionDef) and n.name in ('ref', 'load', 'collect', 'receipt', 'dump')], type_ignores=[])
exec(compile(definitions, '<Root-authored-accepted-provider-helpers>', 'exec'), namespace)
ref = namespace['ref']
def exact(row):
    path = (ROOT / row['path']).resolve()
    key = (path, row['sha256'])
    if key not in SEEN:
        actual = ref(path)
        assert actual['sha256'] == row['sha256'], row['path']
        assert all(actual['size_bytes'] == row[k] for k in ('size_bytes', 'bytes') if k in row)
        SEEN[key] = path
    return SEEN[key]
namespace['exact'] = exact
load, collect, receipt, dump = (namespace[n] for n in ('load', 'collect', 'receipt', 'dump'))
inventory_ref = ref(BASE / 'linked-provider-and-PE-inventory.json')
assert inventory_ref['sha256'] == sys.argv[1]
v = load(inventory_ref)
assert v['schema'] == 'src06-tarp-dispatcher-actual-linked-provider-and-PE-inventory.v1'
collect({k: value for k, value in v.items() if k != 'authenticated_inherited_historical_BUILD_Source_aliases'})
freeze, review = load(v['frozen_build_inputs']), load(v['configure_review'])
collect({k: value for k, value in freeze.items() if k != 'inherited_historical_BUILD_Source_aliases'})
collect(review)
previous = load(freeze['inherited_frozen_build_inputs'])
old_snapshot = load(previous['Source_snapshot'])
old_members = {r['historical_path']: r for r in old_snapshot['files']}
assert len(old_members) == len(old_snapshot['files']) == 3928
aliases = []
for row in previous['frozen_Source_and_input']:
    if row['path'] in old_members:
        old = old_members[row['path']]
        assert row['sha256'] == old['archive']['sha256'] and row['size_bytes'] == old['size_bytes']
        exact(old['archive'])
        aliases.append(dict(historical=row, actual_archive=old['archive']))
    else:
        exact(row)
assert len(aliases) == 3928 and {r['historical']['path'] for r in aliases} == set(old_members)
assert aliases == freeze['inherited_historical_BUILD_Source_aliases'] == v['authenticated_inherited_historical_BUILD_Source_aliases']
collect({k: value for k, value in previous.items() if k != 'frozen_Source_and_input'})
snapshot = load(v['Source_snapshot'])
assert len(snapshot['files']) == 3929 and snapshot['bytes_normalized'] is False
collect(snapshot)
for row in snapshot['files']:
    exact(dict(path=row['historical_path'], sha256=row['archive']['sha256'], size_bytes=row['size_bytes']))
build = receipt(v['actual_build_execution'], v['Source_snapshot'])
dry = receipt(review['dry_execution'], v['Source_snapshot'])
steps = lambda r: [line for line in exact(r['stdout']).read_text(encoding='utf8').splitlines() if re.match(r'^\[\d+/\d+\]', line)]
assert len(steps(build)) == 2 and steps(build) == steps(dry) == review['dry_steps']
assert build['command'] == v['actual_build_argv'] and v['dry_and_actual_compile_link_commands_byte_exact'] is True
assert review['declared_SHA_transport_link_token'] == '-lbcrypt' and review['declared_SHA_transport_immediately_after_core'] is True
assert review['exact_prior_core_link_suffix_preserved_after_declared_SHA_transport'] is True
post = receipt(v['actual_post_build_core_execution'], v['Source_snapshot'])
assert build['finished_utc'] <= post['started_utc'] and b'13534 byte-identical official blobs' in exact(post['stdout']).read_bytes()
core = load(freeze['original_core_receipt'])
collect(core)
assert core['checks_passed'] is True and core['scientific_source_patches'] is False
sys.path.insert(0, str(ROOT / 'tools/porting'))
import native_pe
pe = native_pe.inspect(exact(v['actual_Native_binary']))
assert pe == v['actual_PE']
lines = exact(v['actual_full_link_map']).read_text(encoding='utf8').splitlines()
contract = load(v['provider_contract'])
providers = v['actual_address_bound_providers']
assert len(providers) == 10 and [r['symbol'] for r in providers] == [r['symbol'] for r in contract['providers']]
resolved = exact(receipt(v['actual_addr2line_execution'], v['Source_snapshot'])['stdout']).read_text(encoding='utf8').splitlines()
assert len(resolved) == 20
byte_count = instruction_count = 0
with exact(v['actual_Native_binary']).open('rb') as stream, mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ) as payload:
    for i, row in enumerate(providers):
        spec = contract['providers'][i]
        section = row['owning_text_section']
        start, end = row['address_integer'], int(row['actual_code_extent_end'], 16)
        assert section['owner'] == spec['core_owner']
        assert lines[row['line_number'] - 1] == row['literal_line'] and lines[section['line_number'] - 1] == section['literal_line']
        if 'name_line' in section:
            assert lines[section['name_line_number'] - 1] == section['name_line']
        assert section['start'] <= start < end <= section['start'] + section['size']
        following = []
        for line in lines[row['line_number']:]:
            if re.match(r'^\s+\.text', line):
                break
            match = re.match(r'^\s+(0x[0-9a-fA-F]+)\s+(.+?)\s*$', line)
            if match and start < int(match[1], 16) < section['start'] + section['size']:
                following.append(int(match[1], 16))
        assert end == min(following, default=section['start'] + section['size'])
        assert resolved[2 * i] == row['symbol'] == row['actual_addr2line_function'] and resolved[2 * i + 1] == row['actual_addr2line_location']
        match = re.search('/' + re.escape(spec['Original_relative_source']) + r':(\d+)(?: \(discriminator \d+\))?$', resolved[2 * i + 1].replace('\\', '/'))
        assert match and spec['start_line'] <= int(match[1]) <= spec['end_line']
        rva = start - pe['image_base']
        mapped, = [s for s in pe['sections'] if not s['debug'] and s['characteristics'] & 0x20000000 and s['rva'] <= rva and end - pe['image_base'] <= s['rva'] + s['raw_size']]
        offset = mapped['raw_offset'] + rva - mapped['rva']
        code = payload[offset:offset + end - start]
        assert len(code) == row['actual_code_byte_count'] and code.hex() == row['actual_code_bytes_hex'] and hashlib.sha256(code).hexdigest() == row['actual_code_bytes_sha256']
        execution = receipt(row['actual_disassembly_execution'], v['Source_snapshot'])
        assert exact(execution['stderr']).stat().st_size == 0
        cursor = start
        for line in exact(execution['stdout']).read_text(encoding='utf8').splitlines():
            match = re.match(r'^[ \t]*([0-9a-fA-F]+):[ \t]*((?:[0-9a-fA-F]{2}(?:[ \t]+|$))+)', line)
            if match:
                address, data = int(match[1], 16), bytes.fromhex(match[2])
                assert address == cursor and code[address - start:address - start + len(data)] == data
                cursor += len(data)
                instruction_count += 1
        assert cursor == end
        byte_count += len(code)
for row in v['actual_target_and_core_LOAD_rows']:
    assert lines[row['line_number'] - 1] == row['literal_line']
assert all(v[k] is False for k in ('helper_executed', 'numerical_results_read', 'production_math_changed', 'gates_updated'))
actual_review = dict(schema='src06-tarp-dispatcher-Root-full-actual-provider-review.v1', provider_inventory=inventory_ref, full_PE_independently_recomputed_equal=True, full_map_literal_ownership_and_next_symbol_extents_verified=True, all_ten_provider_bytes_compared_to_actual_PE=byte_count, complete_instruction_rows=instruction_count, historical_BUILD_aliases_explicitly_joined_to_archives=3928, current_Source_members_full_checked=3929, unique_full_identities_verified=len(SEEN), map_intervals_can_include_adjacent_code=True, helper_executed=False, numerical_results_read=False, review_Source=ref(Path(__file__)))
dump(BASE / 'Root-full-provider-review.json', actual_review)
acceptance = dict(schema='src06-tarp-dispatcher-Root-provider-acceptance.v1', accepted=True, provider_inventory=inventory_ref, provider_collection_preparation=ref(ROOT / '.runtime/porting/SRC-06/native-dispatcher-observation-prep-01/manifest.json'), actual_evidence_collector=v['actual_evidence_collector'], all_ten_Original_providers_accepted=True, full_PE_and_core_proof_accepted=True, dry_and_actual_compile_link_commands_byte_exact=True, Root_FULL_actual_provider_review=ref(BASE / 'Root-full-provider-review.json'), helper_executed=False, numerical_results_read=False, gates_updated=False)
for key in ('reviewed_Source_preparation', 'actual_Native_binary', 'actual_full_link_map', 'actual_helper_object', 'actual_build_execution', 'Source_snapshot'):
    acceptance[key] = v[key]
dump(BASE / 'Root-provider-acceptance.json', acceptance)
print(json.dumps(actual_review))
print(json.dumps(ref(BASE / 'Root-provider-acceptance.json')))

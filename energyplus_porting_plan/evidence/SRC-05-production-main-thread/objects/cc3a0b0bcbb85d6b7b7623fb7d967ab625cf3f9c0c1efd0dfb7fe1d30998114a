"""Seal the held Native02 pin and one declared SHA transport link token."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
BASE = ROOT / '.runtime/porting/SRC-06'
OLD = BASE / 'native-dispatcher-build-prep-01'
OUT = BASE / 'native-dispatcher-build-prep-02'


def ref(path):
    data = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data), line_count=len(data.splitlines()))


assert ref(OLD / 'manifest.json')['sha256'] == 'a655ee9b5e16ce74272ac520f418e6deccbcc61e786409e6ef092a4e7e5aff34'
parent = json.loads((OLD / 'manifest.json').read_bytes())
native = BASE / 'native-tarp-dispatcher-prep-02/manifest.json'
assert ref(native)['sha256'] == '954a7779868d3ac65d88c553aab324f5e5e0a88d5d455a3126aecc5012ca3d50'
source = (OLD / 'prepare_native.py').read_text(encoding='utf8')
replacements = [
    ("CODE = ROOT / '.runtime/porting/SRC-06/native-tarp-dispatcher-prep-01'", "CODE = ROOT / '.runtime/porting/SRC-06/native-tarp-dispatcher-prep-02'"),
    ('bde6fde556f907b930416942cd28f4a05aeabc3b42fa148ebad290700b5444c1', '954a7779868d3ac65d88c553aab324f5e5e0a88d5d455a3126aecc5012ca3d50'),
    ("assert steps[1].split('Products/libenergypluslib.a', 1)[1] == review['dry_steps'][1].split('Products/libenergypluslib.a', 1)[1]", "link_suffix = steps[1].split('Products/libenergypluslib.a', 1)[1]\nprior_link_suffix = review['dry_steps'][1].split('Products/libenergypluslib.a', 1)[1]\nassert link_suffix.split().count('-lbcrypt') == 1\nassert link_suffix == '  -lbcrypt' + prior_link_suffix"),
    ('exact_prior_core_link_suffix_preserved=True', "declared_SHA_transport_link_token='-lbcrypt', declared_SHA_transport_immediately_after_core=True, exact_prior_core_link_suffix_preserved_after_declared_SHA_transport=True"),
]
for before, after in replacements:
    assert source.count(before) == 1
    source = source.replace(before, after, 1)
inverse = source
for before, after in reversed(replacements):
    assert inverse.count(after) == 1
    inverse = inverse.replace(after, before, 1)
assert inverse == (OLD / 'prepare_native.py').read_text(encoding='utf8')
old_functions = {n.name: ast.dump(n, include_attributes=False) for n in ast.parse(inverse).body if isinstance(n, ast.FunctionDef)}
new_functions = {n.name: ast.dump(n, include_attributes=False) for n in ast.parse(source).body if isinstance(n, ast.FunctionDef)}
assert old_functions == new_functions
OUT.mkdir(exist_ok=False)
(OUT / 'before').mkdir()
readme = (OLD / 'README.md').read_text(encoding='utf8') + '\nThe bounded02 resolves the prospective01 guard blocker: it selects Native02, requires exactly one direct `-lbcrypt` immediately after the core, and preserves the full prior suffix byte-for-byte after removing only that declared token. All nine Python functions and every remaining guard are AST-exact. This preparation remains unexecuted and requires final independent Source review.\n'
contents = {'prepare_native.py': source.encode('utf8'), 'additive-reference.cmake': (OLD / 'additive-reference.cmake').read_bytes(), 'README.md': readme.encode('utf8')}
diffs = []
for name, after in contents.items():
    before = (OLD / name).read_bytes()
    (OUT / 'before' / name).write_bytes(before)
    (OUT / name).write_bytes(after)
    delta = ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile='before/' + name, tofile=name))
    (OUT / (name + '.diff')).write_bytes(delta.encode())
    diffs.append(dict(before=ref(OUT / 'before' / name), proposal=ref(OUT / name), exact_diff=ref(OUT / (name + '.diff'))))
manifest = copy.deepcopy(parent)
manifest.update(status='HELD-unexecuted-bounded-successor', parent=ref(OLD / 'manifest.json'), own_sources=[ref(OUT / name) for name in contents], author=ref(Path(__file__)), before_archives=[dict(original=ref(OLD / name), archive=ref(OUT / 'before' / name)) for name in contents], exact_diffs=diffs, independent_review_finding='Native02 shape pin and exact declared direct BCrypt token guard resolved; final peer pending', bounded_inverse_to01_exact=True, all_nine_functions_AST_exact_to01=True)
manifest['Source_authorities'] += [ref(native)]
with (OUT / 'manifest.json').open('x', encoding='utf8', newline='\n') as output:
    json.dump(manifest, output, indent=2)
    output.write('\n')
print(json.dumps(ref(OUT / 'manifest.json')))

"""Seal the sole ignored-test roster correction; execute no held workflow."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OLD = ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-application-prep-01'
OUT = ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-application-prep-02'


def ref(path):
    raw = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(raw).hexdigest(), 'size_bytes': len(raw), 'line_count': len(raw.splitlines())}


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)
    return ref(path)


assert not OUT.exists()
parent_ref = ref(OLD / 'manifest.json')
assert parent_ref['sha256'] == 'a6ee787d1003bc701e863a8e0facd655b0050d6940ae2178ff9faab828bc5293'
manifest = copy.deepcopy(json.loads((OLD / 'manifest.json').read_bytes()))
old_block = """                rows = [tuple(map(int, r)) for r in re.findall(r'test result: ok\\. (\\d+) passed; (\\d+) failed; (\\d+) ignored;', A.bind(actual['stdout']).read_text(encoding='utf-8'))]
                A.need(rows and all(failed == ignored == 0 for _, failed, ignored in rows), 'actual test groups must report zero failed/ignored')
                totals[role] = {'groups': len(rows), 'passed': sum(r[0] for r in rows), 'failed': 0, 'ignored': 0}
"""
new_block = """                stdout = A.bind(actual['stdout']).read_text(encoding='utf-8')
                rows = [tuple(map(int, r)) for r in re.findall(r'test result: ok\\. (\\d+) passed; (\\d+) failed; (\\d+) ignored;', stdout)]
                ignored = [{'name': m.group(1), 'actual_line': m.group(0)} for m in re.finditer(r'^test (\\S+) \\.\\.\\. ignored(?:,.*)?$', stdout, re.MULTILINE)]
                expected_ignored = ['heat_balance::convection::surface_environment::selected_reference::observe_literal_surface_environment_setters', 'heat_balance::warmup::selected_reference::observe_literal_selected_warmup_methods']
                A.need(rows and all(failed == 0 for _, failed, _ in rows), 'actual test groups must report zero failed')
                A.need(sorted(r['name'] for r in ignored) == expected_ignored and sum(r[2] for r in rows) == len(ignored), 'exact existing Root-only ignored roster/count required')
                totals[role] = {'groups': len(rows), 'passed': sum(r[0] for r in rows), 'failed': sum(r[1] for r in rows), 'ignored': sum(r[2] for r in rows), 'actual_ignored_tests': ignored}
"""
changes = []
for name in ['apply.py', 'validate.py', 'README.md']:
    raw = (OLD / name).read_bytes()
    if name == 'validate.py':
        text = raw.decode(); newline = '\r\n' if b'\r\n' in raw else '\n'
        before, after = old_block.replace('\n', newline), new_block.replace('\n', newline)
        assert text.count(before) == 1
        raw = text.replace(before, after).encode()
    elif name == 'README.md':
        raw += b'\nThe narrow second preparation preserves both existing Root-only ignored observation tests. Full routine stdout must contain exactly their two Source-owned test names; every failed count must be zero, and aggregate ignored counts must equal the retained full ignored rows. Actual passed/group totals remain derived. The first preparation is preserved unexecuted; its zero-ignored guard was a Source review defect, not a test result.\n'
    proposed = write(OUT / name, raw)
    archived = write(OUT / 'before-01' / name, (OLD / name).read_bytes())
    delta = ''.join(difflib.unified_diff((OLD / name).read_bytes().decode().splitlines(True), raw.decode().splitlines(True), fromfile=archived['path'], tofile=proposed['path'])).encode()
    changes.append({'before': archived, 'proposal': proposed, 'exact_diff': write(OUT / 'narrow-diffs' / (name + '.diff'), delta)})
    if name.endswith('.py'):
        ast.parse(raw.decode())
assert (OUT / 'apply.py').read_bytes() == (OLD / 'apply.py').read_bytes()
manifest['prior_Source_preparation'] = parent_ref
manifest['own_sources'] = [ref(OUT / n) for n in ['apply.py', 'validate.py', 'README.md']] + [ref(Path(__file__).resolve())]
manifest['narrow_source_correspondence'] = changes
manifest['source_correspondence'] = []
for row in json.loads((OLD / 'manifest.json').read_bytes())['source_correspondence']:
    proposed = ref(OUT / Path(row['proposal']['path']).name)
    raw = ''.join(difflib.unified_diff((ROOT / row['before']['path']).read_bytes().decode().splitlines(True), (ROOT / proposed['path']).read_bytes().decode().splitlines(True), fromfile=row['before']['path'], tofile=proposed['path'])).encode()
    manifest['source_correspondence'].append({'before': row['before'], 'proposal': proposed, 'exact_diff': write(OUT / 'diffs' / (Path(proposed['path']).name + '.diff'), raw)})
for name, first, last in [('crates/ep_runtime/src/heat_balance/convection/surface_environment_selected_reference.rs', 367, 371), ('crates/ep_runtime/src/heat_balance/warmup_selected_reference.rs', 392, 396)]:
    path = ROOT / name; selected = b''.join(path.read_bytes().splitlines(True)[first-1:last])
    archive = write(OUT / 'Source-ranges' / (path.stem + '.txt'), selected)
    manifest['Source_ranges'].append({'source': ref(path), 'start_line': first, 'end_line': last, 'sha256': archive['sha256'], 'size_bytes': archive['size_bytes'], 'literal_archive': archive, 'purpose': 'existing Source-owned Root-only ignored observation test; no added ignored test'})
manifest['source_dependencies'] += [ref(ROOT / '.runtime/porting/SRC-06/tarp-inside-quality-01' / role / name) for role in ['focused-command', 'workspace-command'] for name in ['receipt.json', 'stdout.log']]
manifest['runtime_interfaces']['apply'] = ref(OUT / 'apply.py')
manifest['runtime_interfaces']['validate'] = ref(OUT / 'validate.py')
manifest['declared_scope']['preserved_existing_ignored_test_names'] = ['heat_balance::convection::surface_environment::selected_reference::observe_literal_surface_environment_setters', 'heat_balance::warmup::selected_reference::observe_literal_selected_warmup_methods']
print(json.dumps({'manifest': write(OUT / 'manifest.json', (json.dumps(manifest, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode()), 'Source_only': True}))

+def ref(path):
+    data = path.read_bytes()
+    return {"path": rel(path), "sha256": hashlib.sha256(data).hexdigest(), "size_bytes": len(data), "line_count": len(data.splitlines())}
+
+def dump(path, value):
+    path.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n", encoding="utf-8", newline="\n")
+
+def difference(before, after, output):
+    old = before.read_text(encoding="utf-8") if before else ""
+    new = after.read_text(encoding="utf-8")
+    output.write_text("".join(difflib.unified_diff(old.splitlines(True), new.splitlines(True),
+                      fromfile=rel(before) if before else "/dev/null", tofile=rel(after))), encoding="utf-8", newline="\n")
+    return {"before": ref(before) if before else {"absent": True}, "after": ref(after), "exact_diff": ref(output)}
+
+for directory in ("before", "diffs", "source-ranges"):

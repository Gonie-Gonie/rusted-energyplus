"""Seal README invocation-path correction only; execute no held workflow."""
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OLD = ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-application-prep-02'
OUT = ROOT / '.runtime/porting/SRC-05/ordinary-main-thread-application-prep-03'


def ref(path):
    raw = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(raw).hexdigest(), 'size_bytes': len(raw), 'line_count': len(raw.splitlines())}


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)
    return ref(path)


assert not OUT.exists()
parent = ref(OLD / 'manifest.json')
assert parent['sha256'] == '05a6076cfc96a820444334f7da5a3905a26ba98c890995e420fe2b377e689aea'
manifest = copy.deepcopy(json.loads((OLD / 'manifest.json').read_bytes()))
changes = []
for name in ['apply.py', 'validate.py', 'README.md']:
    raw = (OLD / name).read_bytes()
    if name == 'README.md':
        assert raw.count(b'ordinary-main-thread-application-prep-01/apply.py') == 1
        assert raw.count(b'ordinary-main-thread-application-prep-01/validate.py') == 1
        raw = raw.replace(b'ordinary-main-thread-application-prep-01/apply.py', b'ordinary-main-thread-application-prep-03/apply.py').replace(b'ordinary-main-thread-application-prep-01/validate.py', b'ordinary-main-thread-application-prep-03/validate.py')
    proposal = write(OUT / name, raw)
    before = write(OUT / 'before-02' / name, (OLD / name).read_bytes())
    delta = ''.join(difflib.unified_diff((OLD / name).read_bytes().decode().splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=proposal['path'])).encode()
    changes.append({'before': before, 'proposal': proposal, 'exact_diff': write(OUT / 'narrow-diffs' / (name + '.diff'), delta)})
manifest['prior_Source_preparation'] = parent
manifest['own_sources'] = [ref(OUT / n) for n in ['apply.py', 'validate.py', 'README.md']] + [ref(Path(__file__).resolve())]
manifest['narrow_source_correspondence'] = changes
for name in ['apply', 'validate']:
    manifest['runtime_interfaces'][name] = ref(OUT / (name + '.py'))
manifest['source_correspondence'] = []
for row in json.loads((OLD / 'manifest.json').read_bytes())['source_correspondence']:
    proposal = ref(OUT / Path(row['proposal']['path']).name)
    delta = ''.join(difflib.unified_diff((ROOT / row['before']['path']).read_bytes().decode().splitlines(True), (ROOT / proposal['path']).read_bytes().decode().splitlines(True), fromfile=row['before']['path'], tofile=proposal['path'])).encode()
    manifest['source_correspondence'].append({'before': row['before'], 'proposal': proposal, 'exact_diff': write(OUT / 'diffs' / (Path(proposal['path']).name + '.diff'), delta)})
assert all((OUT / n).read_bytes() == (OLD / n).read_bytes() for n in ['apply.py', 'validate.py'])
print(json.dumps({'manifest': write(OUT / 'manifest.json', (json.dumps(manifest, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode()), 'Source_only': True}))

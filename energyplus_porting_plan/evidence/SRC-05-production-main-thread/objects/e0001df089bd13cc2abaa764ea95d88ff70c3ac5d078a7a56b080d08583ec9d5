def sha(path):
    key = str(path.resolve()).lower()
    if key not in cache:
        with path.open('rb') as stream:
            cache[key] = hashlib.file_digest(stream, 'sha256').hexdigest()
    return cache[key]

def ref(path):
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha(path), 'size_bytes': path.stat().st_size}


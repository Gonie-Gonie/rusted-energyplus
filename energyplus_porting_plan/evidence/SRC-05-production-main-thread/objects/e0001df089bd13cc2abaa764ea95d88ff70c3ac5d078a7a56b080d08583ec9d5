def scalar(row):
    global scalar_cells
    assert set(row) == {'value', 'value_bits', 'value_class'}
    bits = row['value_bits']; assert isinstance(bits, str) and len(bits) == 16 and bits == bits.lower()
    number = struct.unpack('>d', bytes.fromhex(bits))[0]
    category = 'nan' if math.isnan(number) else 'positive_infinity' if number == math.inf else 'negative_infinity' if number == -math.inf else 'negative_zero' if number == 0 and bits.startswith('8') else 'positive_zero' if number == 0 else 'finite'
    assert row['value_class'] == category
    if math.isfinite(number):
        assert struct.pack('>d', row['value']).hex() == bits
    else:
        assert row['value'] is None
    scalar_cells += 1

def dto(value):
    global array_views
    if isinstance(value, dict):
        if 'value_bits' in value:
            scalar(value); return
        if {'allocated', 'size', 'rows'} <= set(value):
            array_views += 1
            assert isinstance(value['allocated'], bool) and isinstance(value['size'], int) and value['size'] >= 0
            rows = value['rows']; assert isinstance(rows, list) and len(rows) == value['size']
            if 'lower' in value:
                if value['allocated']:
                    assert value['lower'] == 1 and value['upper'] == value['size']
                else:
                    assert value['size'] == 0 and value['lower'] is None and value['upper'] is None
            if not value['allocated']:
                assert value['size'] == 0
            assert [x['actual_array_index'] for x in rows] == list(range(1, len(rows) + 1))
        for child in value.values():
            dto(child)
    elif isinstance(value, list):
        for child in value:
            dto(child)

def snapshot(item):

def ref(path):
    path = Path(path).resolve()
    data = path.read_bytes()
    try:
        name = path.relative_to(ROOT).as_posix()
    except ValueError:
        name = path.as_posix()
    result = {'path': name, 'sha256': hashlib.sha256(data).hexdigest(), 'size_bytes': len(data)}
    if path.suffix in {'.rs', '.py', '.toml', '.md'}:
        result['line_count'] = len(data.splitlines())
    return result


def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data)
    return ref(path)


def delta(before, after, name):
    return ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True),
                                        fromfile='a/' + name, tofile='b/' + name)).encode()



"""Freeze this source-only hold with stdlib SHA, exact diffs and AST metadata."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
PREP = Path(__file__).resolve().parent
OLD = ROOT / ".runtime/porting/CTF-09/comparer-prep-04"
QA = ROOT / ".runtime/porting/CTF-10/original-data-review-prep-01"
OBS = ROOT / ".runtime/porting/CTF-10/rust-observer-prep-01"
OWN = ["compare_unit.py", "compare_production.py", "packet_io.py", "method_compare.py",
       "initial_shape.py", "method_shape.py", "gamma_shape.py", "coefficient_shape.py",
       "retry_shape.py", "retry_compare.py", "public_shape.py", "public_compare.py"]


def identity(path):
    raw = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(raw).hexdigest(),
            "size_bytes": len(raw), "line_count": len(raw.splitlines())}


def document(path):
    return json.loads(path.read_text(encoding="utf-8"))


def functions(path):
    return {node.name: node for node in ast.parse(path.read_text(encoding="utf-8")).body
            if isinstance(node, (ast.FunctionDef, ast.ClassDef))}


def dump(node):
    return ast.dump(node, include_attributes=False)


def literal(path, key):
    return next(ast.literal_eval(node.value) for node in ast.parse(path.read_text(encoding="utf-8")).body
                if isinstance(node, ast.Assign) and any(isinstance(target, ast.Name) and target.id == key for target in node.targets))


def main():
    assert not (PREP / "manifest.json").exists(), "Held source is immutable"
    rows, correspondence = [], {}
    for name in OWN:
        source, old, before = PREP / name, OLD / name, PREP / "before" / name
        ast.parse(source.read_text(encoding="utf-8"))
        a = old.read_text(encoding="utf-8") if old.exists() else ""
        b = source.read_text(encoding="utf-8")
        exact = "".join(difflib.unified_diff(a.splitlines(True), b.splitlines(True),
            fromfile="accepted09/" + name if old.exists() else "/dev/null", tofile="proposed10/" + name))
        delta = PREP / "diffs" / (name + ".from-09.diff")
        assert delta.read_text(encoding="utf-8") == exact
        row = {"source": identity(source), "exact_diff": identity(delta), "new_source": not old.exists()}
        if old.exists():
            assert before.read_bytes() == old.read_bytes()
            row.update(accepted_CTF09_source=identity(old), before_archive=identity(before))
        rows.append(row)
    structural = ["initial_shape.py", "method_shape.py", "gamma_shape.py", "coefficient_shape.py", "retry_shape.py", "public_shape.py"]
    for name in structural:
        assert (PREP / name).read_bytes() == (QA / name).read_bytes()
    assert (PREP / "method_compare.py").read_bytes() == (OLD / "method_compare.py").read_bytes()
    assert (PREP / "packet_io.py").read_bytes() == (OLD / "packet_io.py").read_bytes().replace(b'porting/CTF-09', b'porting/CTF-10')
    before_retry, after_retry = functions(OLD / "retry_compare.py"), functions(PREP / "retry_compare.py")
    unchanged_retry = [key for key in before_retry if key != "validate_all"]
    assert all(dump(before_retry[key]) == dump(after_retry[key]) for key in unchanged_retry)
    a = (OLD / "retry_compare.py").read_text(encoding="utf-8")
    b = (PREP / "retry_compare.py").read_text(encoding="utf-8")
    assert b == a.replace('owner = operation["after"]["snapshot"] if production else operation["after"]',
                          'owner = model["initialized_owners"]["snapshot"] if production else operation["after"]')
    obs = document(OBS / "manifest.json")
    for lane in ["unit", "production"]:
        name = "compare_" + lane + ".py"
        before, after = functions(OLD / name), functions(PREP / name)
        a = {node.name: node for node in before["Comparison"].body if isinstance(node, ast.FunctionDef)}
        b = {node.name: node for node in after["Comparison"].body if isinstance(node, ast.FunctionDef)}
        assert a.keys() == b.keys()
        unchanged = [key for key in a if key != "__init__"]
        assert all(dump(a[key]) == dump(b[key]) for key in unchanged)
        assert ast.get_source_segment((OLD / name).read_text(encoding="utf-8"), a["number"]) == ast.get_source_segment(
            (PREP / name).read_text(encoding="utf-8"), b["number"])
        unchanged_functions = [key for key in before if key not in ["Comparison", "packet_policy", "run",
            "compare_models" if lane == "production" else "", "compare_initial_models" if lane == "production" else ""]]
        assert all(dump(before[key]) == dump(after[key]) for key in unchanged_functions)
        for key, field in [("OBSERVER_PATHS", "ordered_own_paths"), ("API_PATHS", "ordered_API_paths")]:
            assert literal(PREP / name, key) == obs["runtime_source_closures"][lane][field]
        assert literal(PREP / name, "RETENTION_INTENT") == literal(QA / "initial_shape.py", "RETENTION_INTENT")
        correspondence[lane] = {"Comparison_methods_except_metric_inventory_AST_exact": unchanged,
            "Comparison_number_text_exact": True, "unchanged_top_level_functions_AST_exact": unchanged_functions}
    assert dump(functions(PREP / "compare_unit.py")["packet_policy"]) == dump(functions(PREP / "compare_production.py")["packet_policy"])
    native = document(ROOT / ".runtime/porting/CTF-10/native-helper-prep-01/manifest.json")
    qa = document(QA / "manifest.json")
    direct = [row["proposed"] for row in obs["own_sources"]] + [row["source"] for row in native["own_sources"]] + qa["own_sources"]
    for ref in direct: assert identity(ROOT / ref["path"]) == ref
    ranges, seen = [], set()
    for row in obs["selected_source_ranges"] + qa["selected_primary_ranges"]:
        first, last = row.get("start_line", row.get("first_line")), row.get("end_line", row.get("last_line"))
        key = (row["path"], first, last)
        if key in seen: continue
        seen.add(key)
        lines = (ROOT / row["path"]).read_bytes().splitlines(True)
        assert 1 <= first <= last <= len(lines)
        raw = b"".join(lines[first - 1:last])
        assert hashlib.sha256(raw).hexdigest() == row["sha256"] and len(raw) == row["size_bytes"]
        ranges.append(row)
    dependencies = [OLD / "manifest.json", OBS / "manifest.json", QA / "manifest.json"] + [ROOT / (".runtime/porting/CTF-10/" + name + "/manifest.json") for name in
        ["native-helper-prep-01", "native-observer-prep-01", "input-writer-prep-01", "native-build-review-prep-01", "public-initialization-prep-03", "readiness-audit-01"]]
    for name in ["manifest.json", "README.md"]:
        target = PREP / "before" / name
        target.write_bytes((OLD / name).read_bytes())
    for name in ["prepare_sources.py", "prepare_manifest.py"]: ast.parse((PREP / name).read_text(encoding="utf-8"))
    report = {"schema": "ctf10-strict-public-storage-comparer-source-preparation.v1", "status": "SOURCE-READY-HELD-NOT-EXECUTED",
        "own_sources": rows, "owned_Python_body_count": len(OWN), "executed_sources_per_lane": 11,
        "predecessor_manifest": identity(OLD / "manifest.json"), "before_manifest": identity(PREP / "before/manifest.json"),
        "before_README": identity(PREP / "before/README.md"), "README": identity(PREP / "README.md"),
        "authoring_sources": [identity(PREP / name) for name in ["prepare_sources.py", "prepare_manifest.py"]],
        "accepted_dependency_manifests": [identity(path) for path in dependencies], "producer_interface_sources": direct,
        "selected_source_ranges": ranges, "source_correspondence": {**correspondence,
            "method_compare_byte_exact_CTF09": True, "only_method_compare_functions_called": ["copied", "values", "matrix_map"],
            "structural_validator_files_byte_exact_final_OriginalDataQA10": structural,
            "packet_io_only_CTF_root_literal_changed": True, "retry_pairing_functions_AST_exact_CTF09": unchanged_retry,
            "retry_validate_all_only_real_production_initialized_owner_handoff_changed": True,
            "lane_packet_policy_AST_identical": True},
        "runtime_interfaces": {"common_required_CLI": ["approved-source-sha256", "original-data-review", "original-data-review-execution",
            "Rust-build-execution", "Rust-execution", "Rust-results", "output-dir"],
            "production_extra_CLI": ["conversion-ledger", "conversion-execution"],
            "runtime_reference_syntax": "actual path#SHA256 supplied by Root; no future identities",
            "actual_Cargo_full_SourceSnapshot_unique_artifact_and_executed_binary_required": True,
            "observer_runtime_source_closures": obs["runtime_source_closures"], "actual_QA_executed_source_archives_per_lane": 9,
            "observation_file_bound_bytes": 1024 * 1024 * 1024, "metadata_file_bound_bytes": 16000000,
            "unit_schema": "ctf10-unit-comparison.v1", "unit_pass_status": "pass-selected-public-storage",
            "unit_selected_flag": "selected_unit_public_storage_PASS_claimed", "production_schema": "ctf10-production-comparison.v1",
            "production_pass_status": "pass-selected-loader-to-public-storage", "production_selected_flag": "selected_fixed15_public_storage_PASS_claimed",
            "new_report_ledger_keys": ["actual_public_storage_owner_ledger", "actual_public_Init_prefix_ledger", "actual_public_storage_count_proof"],
            "complete_CTF10_PASS_claimed": False, "whole_Init_reporting_final_fatal_backend_or_surface_handoff_certified": False},
        "selected_pairing": {"policy_authority": identity(ROOT / ".runtime/porting/CTF-10/readiness-audit-01/profiles.proposed.json"),
            "new_primary_profile_group": "ctf10_public_profiles", "new_primary_profile_count": 6,
            "all12_fixed19_arrays_copied": True, "reset8_positive_zero_bits_class_required_without_new_numeric_profiles": True,
            "eligible_returned_no_source_1D_NumCTFTerms_0_through18_required": True,
            "missing_required_one_or_both_sides_fails": True, "actual_nonreturned_fatal_outcapacity_scope_unavailable_noPASS": True,
            "required_nonfinite_noPASS": True, "production_before_after_null_preserved": True,
            "production_join": "actual initialized_owners + PublicStorage.before_reset + real Init ConstructionEntry caller/flags",
            "reverse_provider_earlier_real_stored_owner_required": True,
            "actual_aggregate_order_and_final_matching_prefix_only_paired": True,
            "intermediate_aggregate_snapshots_whole_Init_reports_fatal_backend_and_surface_unpaired_noPASS": True,
            "old_retry_all_visit_handoffs_and_first_wrapper_meanings_unchanged": True,
            "current10_authority_separate_from_historical09_and_nested08_07_05_06": True,
            "historical_after_documents_not_replayed_as_current_live_files": True,
            "selected_PASS_requires_zero_mismatches_and_at_least_one_actual_returned_public_owner_pair": True},
        "preparation_boundary": {"targets_imported_or_executed": False, "scientific_weather_binary_payloads_read": False,
            "canonical_or_Git_modified": False, "new_QA_proof_or_execution_framework": False,
            "arithmetic_store_or_aggregate_evaluator": False, "numerical_PASS_claimed": False, "gates_updated": False},
        "authorship_limits": "Raw authored Native10 passive/helper, Rust10 observer/comparer and prior retry/pure code; Header public10 owner/freezer/DataQA. Source/provenance pairing does not independently certify authors' formulas."}
    (PREP / "manifest.json").write_text(json.dumps(report, ensure_ascii=False, allow_nan=False, indent=2) + "\n", encoding="utf-8", newline="\n")
    print(json.dumps({"manifest": identity(PREP / "manifest.json"), "own_sources": [row["source"] for row in rows],
                      "range_count": len(ranges)}, indent=2))


if __name__ == "__main__":
    main()

"""Source-only CTF03 observer forks. Imports no project/target modules."""
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent
OLD = ROOT / ".runtime/porting/CTF-02/candidate-observer-prep-02"
INGRESS = ROOT / ".runtime/porting/CTF-03/cache-ingress-prep-01"


def ref(path):
    raw = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(raw).hexdigest(),
            "size_bytes": len(raw), "line_count": len(raw.splitlines())}


def once(text, old, new):
    if text.count(old) != 1:
        raise ValueError(("unique literal replacement required", old[:120], text.count(old)))
    return text.replace(old, new, 1)


def renamed(text):
    return text.replace("ctf02", "ctf03").replace("CTF02", "CTF03").replace("CTF-02", "CTF-03")


INITIAL_SERIALIZER = r'''pub(super) fn initial(
    source: &ConstructionCtfInitialDiscretization,
    preprocessing: Option<&ConstructionCtfLayerPreprocessing>,
) -> Value {
    let phases = preprocessing.and_then(|owner| owner.result.as_ref().ok());
    let converted = phases.and_then(|owner| owner.after_conversion.as_ref());
    let context = json!({"is_used_ctf":source.context.is_used_ctf,
        "errors_found":source.context.errors_found,
        "source_sink_present":source.context.source_sink_present,
        "solution_dimensions":source.context.solution_dimensions});
    let (available, route, reverse_id, reason, snapshot) = match &source.result {
        Err(reason) => {
            let (route, reverse_id) = match reason {
                CtfInitialUnavailable::PreprocessingScope(_) => ("PreprocessingScope",None),
                CtfInitialUnavailable::UnusedConstruction => ("UnusedConstruction",None),
                CtfInitialUnavailable::PreprocessingErrorReturn => ("PreprocessingErrorReturn",None),
                CtfInitialUnavailable::PostConversionUnavailable => ("PostConversionUnavailable",None),
                CtfInitialUnavailable::AllResistiveBranch => ("AllResistiveBranch",None),
                CtfInitialUnavailable::ReverseConstruction{construction_id} => ("ReverseConstruction",Some(construction_id.0)),
                CtfInitialUnavailable::InitialScope(_) => ("InitialScope",None),
            };
            (false,route,reverse_id,Some(format!("{reason:?}")),Value::Null)
        }
        Ok(actual) => (true,"InitialOwnerReturned",None,None,json!({
            "LayersInConstruct":converted.map(|owner|owner.active.layers.len()),
            "NumResLayers":converted.map(|owner|owner.active.num_res_layers),
            "ErrorsFound":phases.map(|owner|owner.errors_found),
            "DoCTFErrorReport":null,"DoCTFErrorReport_paired":false,
            "active_prefix_available":true,"copied_layer_count":actual.active.len(),
            "active_prefix":actual.active.iter().map(|layer|json!({"Nodes":layer.nodes,"dx":scalar(layer.dx)})).collect::<Vec<_>>(),
            "rcmax":actual.rcmax,"NodeSource":actual.node_source,"NodeUserTemp":actual.node_user_temp,
            "CTFTimeStep":scalar(actual.initial_ctf_time_step_hours),
            "NumHistories":actual.initial_num_histories,"TimeStepZone":scalar(actual.time_step_zone_hours)})),
    };
    json!({"protocol":"ctf03-initial-discretization.v1","owner_available":available,
        "selected_initial_operands":available,"actual_source_route":route,
        "actual_reverse_construction_id":reverse_id,"unavailable_reason":reason,"snapshot":snapshot,
        "construction_id":source.construction_id.0,"actual_context":context,
        "actual_wrapper_TimeStepZone":scalar(source.time_step_zone_hours),
        "same_preprocessing_owner_available":preprocessing.is_some(),
        "same_post_conversion_handoff_available":converted.is_some(),
        "same_preprocessing_construction_id":preprocessing.map(|owner|owner.construction_id.0),
        "initial_state_distinct_from_retry_and_whole_return":true,
        "observer_nodal_or_route_arithmetic_performed":false,
        "Native_whole_method_flags_or_callback_reachability_inferred":false,"counted_as_PASS":false})
}

'''

UNIT_MODEL_CASE = r'''fn model_case(model: &Value) -> Result<Value> {
    require(model["lane"] == "explicit-member-unit", "explicit member lane required")?;
    let mut association = BTreeMap::new(); let mut typed = Vec::new();
    for (index, material) in rows(&model["materials"])?.iter().enumerate() {
        let id = text(&material["id"])?;
        require(association.insert(id, index).is_none(), "duplicate logical material ID")?;
        typed.push(CtfLayerInput { material_id:MaterialId(u32::try_from(index)?),
            thickness:scalar(&material["Thickness"])?,conductivity:scalar(&material["Conductivity"])?,
            density:scalar(&material["Density"])?,specific_heat:scalar(&material["SpecHeat"])?,
            resistance:scalar(&material["Resistance"])?,resistance_only:flag(&material["ROnly"])? });
    }
    let declarations = rows(&model["constructions"])?; let operations = rows(&model["operations"])?;
    require(declarations.len() == operations.len(), "ordered construction/call ledger differs")?;
    // These real typed owners carry the explicit lane's original identities/stack,
    // not a compiler/Material-loader observation or a reconstructed normalized stack.
    let mut constructions = Vec::new(); let mut used = BTreeSet::new();
    for (index, declaration) in declarations.iter().enumerate() {
        let layers = rows(&declaration["layer_material_ids"])?.iter().map(|id| {
            let index = *association.get(text(id)?).ok_or("undeclared material reference")?;
            Ok(typed[index].material_id)
        }).collect::<Result<Vec<_>>>()?;
        let id = ConstructionId(u32::try_from(index)?);
        if flag(&declaration["IsUsedCTF"])? { used.insert(id.0); }
        constructions.push(Construction { id,name:NormalizedName(text(&declaration["Name"])?.to_owned()),
            kind:ConstructionKind::Opaque,outside_layer:layers.first().copied(),layers,
            thermochromic_master:None,ground_factor:None,air_boundary:None,complex_fenestration:None,
            window_equivalent_layer:None,internal_heat_source:None });
    }
    let mut selected_errors = flag(&model["caller"]["ErrorsFound"])?;
    let mut observed = Vec::new();
    for (index, ((declaration, construction), operation)) in declarations.iter().zip(&constructions).zip(operations).enumerate() {
        require(operation["kind"] == "calculateTransferFunction" && operation["construction_id"] == declaration["id"],
            "declared Native call/construction order differs")?;
        let layers = construction.effective_layers().iter().map(|id| {
            let index = usize::try_from(id.0)?;
            typed.get(index).copied().ok_or_else(|| "typed material association absent".into())
        }).collect::<Result<Vec<_>>>()?;
        let before = selected_errors;
        // Actual selected context is supplied separately. The typed stack above
        // does not fabricate an internal-source declaration for rejected lanes.
        let context = CtfLayerContext { is_used_ctf:flag(&declaration["IsUsedCTF"])?, errors_found:before,
            source_sink_present:flag(&declaration["SourceSinkPresent"])?,
            solution_dimensions:i32::try_from(declaration["SolutionDimensions"].as_i64().ok_or("typed dimensions required")?)? };
        let result = preprocess_ctf_layers(&layers,context);
        let preprocessing = ConstructionCtfLayerPreprocessing { construction_id:construction.id,
            is_used_ctf:context.is_used_ctf,result };
        let time_step_zone = scalar(&model["caller"]["TimeStepZone"])?;
        let initial = initialize_construction_ctf_initial(construction,&constructions[..index],&used,
            &preprocessing,context,time_step_zone);
        if let Ok(actual) = &preprocessing.result { selected_errors = actual.errors_found; }
        observed.push(json!({"id":operation["id"],"declared_native_operation_kind":operation["kind"],
            "logical_construction_id":declaration["id"],"actual_Rust_API":"preprocess_ctf_layers",
            "actual_source_invoked":true,"selected_ErrorsFound_before":before,
            "selected_ErrorsFound_after":selected_errors,"actual_layer_material_ids":layers.iter().map(|v|v.material_id.0).collect::<Vec<_>>(),
            "original_layer_membership":declaration["layer_material_ids"],"result":fields::result(&preprocessing.result),
            "CTF03_initial":fields::initial(&initial,Some(&preprocessing)),
            "actual_Rust_CTF03_API":"initialize_construction_ctf_initial","actual_Rust_CTF03_API_invoked":true,
            "actual_initial_discretization_owner_available":initial.result.is_ok(),
            "actual_construction_id":construction.id.0,
            "actual_ordered_prior_construction_ids":constructions[..index].iter().map(|owner|owner.id.0).collect::<Vec<_>>(),
            "actual_used_construction_ids":used.iter().copied().collect::<Vec<_>>(),
            "actual_caller_TimeStepZone":fields::scalar(time_step_zone),
            "preprocessing_reexecuted_for_initial_owner":false,"observer_reverse_classifier_duplicated":false,
            "Native_whole_method_outcome_or_later_flags_inferred":false}));
    }
    Ok(json!({"id":model["id"],"lane":model["lane"],"declared_caller":model["caller"],
        "materials":rows(&model["materials"])?.iter().zip(&typed).map(|(declared,actual)|json!({
            "logical_id":declared["id"],"declared_name":declared["Name"],"actual_typed_input":fields::input(actual)
        })).collect::<Vec<_>>(),"declared_constructions":model["constructions"],"operations":observed,
        "final_selected_ErrorsFound":selected_errors,"DoCTFErrorReport":fields::unpaired_later_flag(),
        "explicit_member_input_not_Material_loader_observation":true}))
}
'''

PRODUCTION_SERIALIZER = r'''pub(super) fn ctf03_unavailable() -> Value {
    json!({"owner_available":false,"construction_initial":null,
        "unavailable_reason":"initializer has not returned an actual HeatBalanceState owner","counted_as_PASS":false})
}
pub(super) fn ctf03_selected(source: &HeatBalanceState) -> Value {
    json!({"owner_available":true,"construction_initial":source.construction_ctf03_initial.iter()
        .enumerate().map(|(index,actual)| {
            let preprocessing = source.construction_ctf01_layers.iter()
                .find(|owner|owner.construction_id == actual.construction_id);
            json!({"state_vector_index":index,"construction_id":actual.construction_id.0,
                "result":unit_fields::initial(actual,preprocessing)})
        }).collect::<Vec<_>>(),
        "actual_owner_count":source.construction_ctf03_initial.len(),
        "preprocessing_or_initial_discretization_reexecuted_by_observer":false,
        "observer_reverse_classifier_duplicated":false,"external_CTF_rows_supplied_to_initializer":false,
        "initial_state_distinct_from_retry_and_whole_return":true,
        "Native_whole_solver_flags_unpaired":true,"numerical_PASS_claimed":false})
}
'''


def main():
    if (OUT / "manifest.json").exists():
        raise ValueError("Held source directory must not be regenerated")
    ingress_manifest = INGRESS / "manifest.json"
    if not ingress_manifest.is_file():
        raise ValueError("Await concrete held ingress API before preparing final source inventory")
    owner = (INGRESS / "new/ctf_initial_owner.rs").read_text(encoding="utf-8")
    if "pub fn initialize_construction_ctf_initial(" not in owner:
        raise ValueError("The genuine route API must be public for the literal unit lane")
    sources = {}
    old_unit = (OLD / "ctf02_candidate_unit_observer.rs").read_text(encoding="utf-8")
    unit = renamed(old_unit)
    unit = once(unit, "use ep_model::MaterialId;", "use ep_model::{Construction, ConstructionId, ConstructionKind, MaterialId, NormalizedName};")
    unit = once(unit, "CtfLayerContext, CtfLayerInput, preprocess_ctf_layers,", "ConstructionCtfLayerPreprocessing, CtfLayerContext, CtfLayerInput, preprocess_ctf_layers,")
    unit = once(unit, "use ep_runtime::heat_balance::surface_manager::ctf_all_resistive::{\n    CtfAllResistiveUnavailable, generate_all_resistive_ctf,\n};", "use ep_runtime::heat_balance::ctf_initial_owner::initialize_construction_ctf_initial;")
    unit = once(unit, "use std::collections::BTreeMap;", "use std::collections::{BTreeMap, BTreeSet};")
    start, stop = unit.index("fn model_case("), unit.index("fn main()")
    unit = unit[:start] + UNIT_MODEL_CASE + unit[stop:]
    unit = unit.replace("coefficient_calls", "initial_calls").replace("coefficients", "initial operands")
    unit = once(unit, '"ctf03_public_observation_policy":request["ctf03_public_observation_policy"]',
        '"ctf03_initial_observation_policy":request["ctf03_initial_observation_policy"]')
    unit = once(unit, '"CTF03_through_CTF10_certified":false', '"CTF04_through_CTF10_certified":false')
    unit = once(unit, "//! Explicit-member unit calls to the actual public CTF-01 prefix and CTF-03 all-resistive API.",
        "//! Actual explicit-member preprocessing and source-owned initial CTF03 route; no solver answers.")
    sources["ctf03_candidate_unit_observer.rs"] = ("ctf02_candidate_unit_observer.rs", unit)

    fields = renamed((OLD / "unit_fields.rs").read_text(encoding="utf-8"))
    fields = once(fields, "CtfLayerCheckpoint, CtfLayerInput, CtfLayerPreprocessing, CtfLayerScopeError,",
        "ConstructionCtfLayerPreprocessing, CtfLayerCheckpoint, CtfLayerInput, CtfLayerPreprocessing, CtfLayerScopeError,")
    fields = once(fields, "use ep_runtime::heat_balance::surface_manager::ctf_all_resistive::{\n    CtfAllResistiveCoefficients, CtfAllResistiveUnavailable,\n};",
        "use ep_runtime::heat_balance::ctf_initial_owner::{\n    ConstructionCtfInitialDiscretization, CtfInitialUnavailable,\n};")
    start, stop = fields.index("pub(super) fn coefficients("), fields.index("pub(super) const OBSERVER_PATHS")
    fields = fields[:start] + INITIAL_SERIALIZER + fields[stop:]
    fields = once(fields, '    "crates/ep_runtime/src/heat_balance/surface_manager/ctf_all_resistive.rs",',
        '    "crates/ep_runtime/src/heat_balance/surface_manager/ctf_initial_discretization.rs",\n    "crates/ep_runtime/src/heat_balance/ctf_initial_owner.rs",\n    "crates/ep_model/src/objects/construction.rs",')
    sources["unit_fields.rs"] = ("unit_fields.rs", fields)
    sources["production_unit_fields.rs"] = ("production_unit_fields.rs", fields)

    prod = renamed((OLD / "ctf02_candidate_production_observer.rs").read_text(encoding="utf-8"))
    prod = prod.replace("ctf03_public_observation_policy", "ctf03_initial_observation_policy")
    prod = once(prod, '"CTF03_through_CTF10_certified":false', '"CTF04_through_CTF10_certified":false')
    sources["ctf03_candidate_production_observer.rs"] = ("ctf02_candidate_production_observer.rs", prod)
    prod_fields = renamed((OLD / "production_fields.rs").read_text(encoding="utf-8"))
    start, stop = prod_fields.index("pub(super) fn ctf03_unavailable()"), prod_fields.index("pub(super) fn typed(")
    prod_fields = prod_fields[:start] + PRODUCTION_SERIALIZER + prod_fields[stop:]
    prod_fields = once(prod_fields, '    "crates/ep_runtime/src/heat_balance/surface_manager/ctf_all_resistive.rs",',
        '    "crates/ep_runtime/src/heat_balance/surface_manager/ctf_all_resistive.rs",\n    "crates/ep_runtime/src/heat_balance/surface_manager/ctf_initial_discretization.rs",\n    "crates/ep_runtime/src/heat_balance/ctf_initial_owner.rs",')
    sources["production_fields.rs"] = ("production_fields.rs", prod_fields)

    (OUT / "before").mkdir(parents=True, exist_ok=True)
    rows = []
    canonical = {
        "ctf03_candidate_unit_observer.rs": "crates/ep_run/examples/ctf03_candidate_unit_observer.rs",
        "unit_fields.rs": "crates/ep_run/examples/ctf03_candidate_unit_support/fields.rs",
        "ctf03_candidate_production_observer.rs": "crates/ep_run/examples/ctf03_candidate_production_observer.rs",
        "production_fields.rs": "crates/ep_run/examples/ctf03_candidate_production_support/fields.rs",
        "production_unit_fields.rs": "crates/ep_run/examples/ctf03_candidate_production_support/unit_fields.rs",
    }
    for name, (old_name, text) in sources.items():
        before = OUT / "before" / old_name
        before.write_bytes((OLD / old_name).read_bytes())
        (OUT / name).write_text(text, encoding="utf-8", newline="\n")
        diff = "".join(difflib.unified_diff(before.read_text(encoding="utf-8").splitlines(keepends=True),
            text.splitlines(keepends=True), fromfile=ref(before)["path"], tofile=canonical[name]))
        patch = OUT / (name + ".from-CTF02.diff")
        patch.write_text(diff, encoding="utf-8", newline="\n")
        rows.append({"proposed_canonical_path": canonical[name], "source": ref(OUT / name),
                     "before": ref(before), "exact_diff": ref(patch)})

    api_lists = {}
    for lane, text in [("unit", fields), ("production", prod_fields)]:
        tail = text.split("pub(super) const API_PATHS: &[&str] = &[", 1)[1].split("];", 1)[0]
        paths = [line.strip().strip(',').strip('"') for line in tail.splitlines() if line.strip()]
        api_lists[lane] = paths
    proposal_by_owner = {
        "crates/ep_runtime/src/heat_balance/surface_manager/ctf_initial_discretization.rs": ROOT / ".runtime/porting/CTF-03/readiness-audit-02/new/ctf_initial_discretization.rs",
        "crates/ep_runtime/src/heat_balance/surface_manager.rs": ROOT / ".runtime/porting/CTF-03/readiness-audit-02/proposed/surface_manager.rs",
        "crates/ep_runtime/src/heat_balance/ctf_initial_owner.rs": INGRESS / "new/ctf_initial_owner.rs",
        "crates/ep_runtime/src/heat_balance/mod.rs": INGRESS / "proposed/mod.rs",
        "crates/ep_runtime/src/heat_balance/surface_manager/construction_cache.rs": INGRESS / "proposed/construction_cache.rs",
        "crates/ep_runtime/src/heat_balance/initialization/state_shell.rs": INGRESS / "proposed/state_shell.rs",
        "crates/ep_runtime/src/heat_balance/state.rs": INGRESS / "proposed/state.rs",
    }
    api_rows = []
    for path in dict.fromkeys(api_lists["unit"] + api_lists["production"]):
        row = {"canonical_path": path, "current_source": ref(ROOT / path) if (ROOT / path).is_file() else None}
        if path in proposal_by_owner:
            row["held_proposed_owner"] = ref(proposal_by_owner[path])
        row["actual_applied_formatted_identity_required_at_runtime"] = True
        api_rows.append(row)
    readme = '''# CTF03 candidate observers: source hold

SOURCE ONLY; unapplied/unexecuted. Five observer files fork accepted CTF02
observer02: own unit2 and production3 inventories, with runtime exact formatted
hashes/public API source inventories and authentic whole Cargo SourceSnapshot.
No future formatted source identity, result or outcome is supplied.

Unit reads the unchanged input-only39/42 member lane. It constructs actual typed
MaterialId/ConstructionId associations and original ordered stacks from literal
members, preserving declared caller flags separately. It calls preprocessing
once, then the genuine public initialize_construction_ctf_initial on that same
owner, original ordered prior constructions and actual declared used IDs. No
observer reverse classifier or numerical equality substitute is introduced.
This explicit member lane does not claim compiler/Material loader observations.

Production retains the fixed15 actual IDF/conversion/compiler/ordinary initializer
route and copies construction_ctf03_initial in actual state-vector order. It
associates each row with its actual construction_ctf01_layers owner by ID. The
serializer never reexecutes preprocessing, route selection or discretization and
supplies no external coefficient rows. Actual typed material/construction/surface
and timestep context remains copied; CTF02 surface coefficient copies are outside
this initial-state projection.

Each available CTF03 Result copies actual active Nodes/dx, rcmax, node selectors,
initial timestep/history and caller timestep; counts/ErrorsFound are copied from
the same preceding converted owner. Missing handoff stays null/unavailable, never
fabricated. Seven distinct unavailable variants retain actual reason and reverse
construction ID when present. No route is selected from Native output.

Initial619 is separate from later whole return/retry state. No caller==initial
CTFTimeStep assertion is introduced. Only selected preprocessing ErrorsFound
carry is shared; Native solver flags/whole outcomes are unpaired. Nonfinite values
retain exact bits/class and JSON null numeric value. Required selected absence on
either or both sides remains a future comparer failure, not numeric PASS.

Unit API12 and production API25 paths include the real pure initial module and
public route owner; production retains its real all-resistive dependency. Before
copies/exact patches bind the accepted historical sources. Held proposed API
identities are preparation only; Root must apply/format and provide actual current
bindings matched to the genuine Cargo capture before admitting execution.

CLI remains unit five input-only arguments (Native request+SHA, admission+SHA,
runtime source bindings); production request+SHA. Metadata schemas are ctf03-
candidate-unit-runtime-source-bindings.v1, ctf03-candidate-unit-observer-results.v1,
ctf03-candidate-production-observer-request.v1 and ctf03-candidate-production-
observer-results.v1. Native request/admission/policy use the fresh CTF03 packet.
No new SourceQA framework or execution stage is introduced. Root alone executes.
'''
    (OUT / "README.md").write_text(readme, encoding="utf-8", newline="\n")
    bindings = [ref(OLD / "manifest.json"), ref(INGRESS / "manifest.json"),
        ref(ROOT / ".runtime/porting/CTF-03/readiness-audit-02/manifest.json"),
        ref(ROOT / ".runtime/porting/CTF-03/native-helper-prep-01/ctf03_initial_fields.hh"),
        ref(ROOT / ".runtime/porting/CTF-03/original-data-review-prep-01/initial_shape.py")]
    manifest = {"schema": "ctf03-candidate-observer-source-inventory.v1", "status": "SOURCE-READY-HELD-unapplied-unexecuted",
        "own_source_rows": rows, "observer_source_counts": {"unit":2,"production":3},
        "API_paths": api_lists, "API_source_counts": {lane:len(paths) for lane,paths in api_lists.items()},
        "API_source_identities": api_rows,"source_preparation_bindings":bindings,
        "own_preparation_source":ref(Path(__file__).resolve()), "README":ref(OUT / "README.md"),
        "scalar_serializer_byte_identical_in_both_lanes": (OUT/"unit_fields.rs").read_bytes() == (OUT/"production_unit_fields.rs").read_bytes(),
        "target_imported_or_executed":False,"scientific_or_binary_payloads_read":False,
        "canonical_sources_written":False,"new_QA_execution_stage":False}
    (OUT / "manifest.json").write_text(json.dumps(manifest,indent=2)+"\n",encoding="utf-8",newline="\n")
    print(json.dumps({"manifest":ref(OUT / "manifest.json"),"sources":[row["source"] for row in rows],
                      "API_source_counts":manifest["API_source_counts"]}))


if __name__ == "__main__":
    main()

def ref(path):
    raw = path.read_bytes()
    return {"path":path.relative_to(ROOT).as_posix(),"sha256":hashlib.sha256(raw).hexdigest(),
            "size_bytes":len(raw),"line_count":len(raw.splitlines())}


def once(source, old, new):
    if source.count(old) != 1:
        raise ValueError(("unique literal required", old[:100], source.count(old)))
    return source.replace(old,new,1)


def assignment(source, name):
    for item in ast.parse(source).body:
        if isinstance(item,ast.Assign) and any(isinstance(target,ast.Name) and target.id==name for target in item.targets):
            return ast.literal_eval(item.value)
    raise ValueError(name)


def replace_assignment(source, name, value):
    lines=source.splitlines(keepends=True)
    for item in ast.parse(source).body:
        if isinstance(item,ast.Assign) and any(isinstance(target,ast.Name) and target.id==name for target in item.targets):
            return ''.join(lines[:item.lineno-1])+name+' = '+repr(value)+'\n'+''.join(lines[item.end_lineno:])
    raise ValueError(name)



class Comparison:
    def __init__(self, need):
        self.need = need
        self.counts = Counter()
        self.samples = []
        self.unavailable = []
        self.metrics = {key: {"count": 0, "maximum_absolute_error": 0.0, "norm": 0.0,
                              "nonfinite_error_count": 0} for key in VARIABLES}

    def failure(self, path, category, native, rust):
        self.counts["mismatches"] += 1
        self.counts[category] += 1
        if len(self.samples) < 1000:
            self.samples.append({"path": path, "category": category, "Native": native, "Rust": rust})

    def exact(self, path, native, rust):
        self.counts["discrete_comparisons"] += 1
        if type(native) is not type(rust) or native != rust:
            self.failure(path, "discrete_mismatches", native, rust)

    def absence(self, path, native_available, rust_available, required, reason):
        self.unavailable.append({"path": path, "Native_available": native_available, "Rust_available": rust_available,
                                 "required": required, "reason": reason, "counted_as_PASS": False})
        if required:
            self.failure(path, "availability_failures", native_available, rust_available)

    def dto(self, row):
        self.need(isinstance(row, dict) and set(row) == {"value", "value_bits", "value_class"}, "Actual complete binary64 DTO required")
        bits = row["value_bits"]
        self.need(isinstance(bits, str) and len(bits) == 16 and all(c in "0123456789abcdef" for c in bits), "Actual binary64 bits required")
        word = int(bits, 16)
        value = struct.unpack(">d", word.to_bytes(8, "big"))[0]
        kind = "nan" if math.isnan(value) else ("negative_infinity" if word >> 63 else "positive_infinity") if math.isinf(value) else (
            "negative_zero" if word >> 63 else "positive_zero") if value == 0 else "finite"
        self.need(row["value_class"] == kind, "Actual binary64 class differs from its bits")
        if math.isfinite(value):
            self.need(type(row["value"]) in (int, float) and struct.pack(">d", float(row["value"])).hex() == bits,
                      "Actual JSON scalar differs from its bits")
        else:
            self.need(row["value"] is None, "Observed nonfinite must retain bits/class and null JSON decimal")
        return value

    def number(self, path, profile, native, rust):
        left, right = self.dto(native), self.dto(rust)
        self.exact(path + "/class", native["value_class"], rust["value_class"])
        self.exact(path + "/bits", native["value_bits"], rust["value_bits"])
        if not (math.isfinite(left) and math.isfinite(right)):
            self.absence(path, True, True, True, "actual nonfinite remains available; frozen policy supplies no nonfinite numerical PASS")
            return
        metric = self.metrics[profile]
        error = abs(left - right)
        metric["count"] += 1
        self.counts["numeric_comparisons"] += 1
        if not math.isfinite(error):
            metric["nonfinite_error_count"] += 1
        else:
            metric["maximum_absolute_error"] = max(metric["maximum_absolute_error"], error)
            metric["norm"] = math.hypot(metric["norm"], error)
        if error != 0.0:
            self.failure(path, "numeric_mismatches", native, rust)

    def handoff(self, path, profile, native, rust):
        # Inherited preprocessing copies are a separate handoff, not CTF03 metrics.
        self.need(profile in PREFIX_VARIABLES, "Inherited18 handoff profile required")
        left, right = self.dto(native), self.dto(rust)
        self.exact(path + "/class", native["value_class"], rust["value_class"])
        self.exact(path + "/bits", native["value_bits"], rust["value_bits"])
        self.counts["preprocessing_handoff_scalar_copies"] += 1
        if not (math.isfinite(left) and math.isfinite(right)):
            self.absence(path, True, True, True, "inherited required nonfinite handoff has no numerical PASS")

    def report(self):
        metrics = {}
        for key, metric in self.metrics.items():
            available = metric["count"] > 0 and metric["nonfinite_error_count"] == 0 and math.isfinite(metric["norm"])
            if metric["count"] == 0:
                self.absence("metrics/" + key, False, False, True, "no finite actual observations for this frozen profile")
            metrics[key] = {"count": metric["count"], "finite_metric_available": available,
                            "maximum_absolute_error": metric["maximum_absolute_error"] if available else None,
                            "RMSE": metric["norm"] / math.sqrt(metric["count"]) if available else None,
                            "nonfinite_error_count": metric["nonfinite_error_count"]}
        return {"numeric_comparisons": self.counts["numeric_comparisons"], "discrete_comparisons": self.counts["discrete_comparisons"],
                "mismatch_count": self.counts["mismatches"], "mismatch_categories": dict(self.counts), "metrics": metrics,
                "mismatch_samples": self.samples, "mismatch_samples_omitted": max(0, self.counts["mismatches"] - len(self.samples)),
                "unavailable_observations": self.unavailable, "unavailable_counted_as_PASS": False}


def compare_models(native, rust, request, c):
    c.need(len(native["model_cases"]) == len(rust["model_cases"]) == len(request["model_cases"]), "Exact complete model ledger required")
    for expected, left, right in zip(request["model_cases"], native["model_cases"], rust["model_cases"]):
        path = expected["id"]
        for key in ["id", "lane"]:
            c.exact(path + "/" + key, expected[key], left[key]); c.exact(path + "/Rust/" + key, expected[key], right[key])
        c.exact(path + "/declared_caller", left["declared_caller"], right["declared_caller"])
        c.exact(path + "/declared_constructions", expected["constructions"], right["declared_constructions"])
        c.need(len(right["materials"]) == len(expected["materials"]), "Exact actual typed material association required")
        for index, (declared, copied) in enumerate(zip(expected["materials"], right["materials"])):
            actual = copied["actual_typed_input"]
            c.exact(path + "/material/logical_id", declared["id"], copied["logical_id"])
            c.exact(path + "/material/name", declared["Name"], copied["declared_name"])
            c.exact(path + "/material/actual_typed_id", index, actual["material_id"])
            for key in ["Thickness", "Conductivity", "Density", "SpecHeat", "Resistance"]:
                c.dto(actual[key]); c.exact(path + "/material/" + declared["id"] + "/" + key, declared[key]["bits"], actual[key]["value_bits"])
            c.exact(path + "/material/" + declared["id"] + "/ROnly", declared["ROnly"], actual["ROnly"])
        association = {material["id"]: index for index, material in enumerate(expected["materials"])}
        c.need(len(left["operations"]) == len(right["operations"]) == len(expected["operations"]), "Exact complete ordered call ledger required")
        for declared, construction, n, r in zip(expected["operations"], expected["constructions"], left["operations"], right["operations"]):
            op = path + "/" + declared["id"]
            c.exact(op + "/id", declared["id"], n["id"]); c.exact(op + "/Rust/id", declared["id"], r["id"])
            c.exact(op + "/logical_construction_id", n["logical_construction_id"], r["logical_construction_id"])
            c.exact(op + "/native_operation_kind", n["kind"], r["declared_native_operation_kind"])
            c.exact(op + "/Rust/API", "preprocess_ctf_layers", r["actual_Rust_API"])
            c.exact(op + "/original_membership", construction["layer_material_ids"], r["original_layer_membership"])
            c.exact(op + "/actual_typed_membership", [association[x] for x in construction["layer_material_ids"]], r["actual_layer_material_ids"])
            c.need(type(n["actual_source_invoked"]) is bool and type(r["actual_source_invoked"]) is bool, "Typed actual invocation availability required")
            if not n["actual_source_invoked"]:
                c.need(n.get("observations") is None,"Uninvoked Native whole call cannot invent checkpoints")
                c.absence(op,False,r["actual_source_invoked"],False,"actual Native whole-source stop leaves this call unknown/noPASS")
                continue
            if not r["actual_source_invoked"]:
                c.absence(op,True,False,True,"required independently invoked Rust preprocessing absent")
                continue
            c.exact(op + "/selected_ErrorsFound_before", n["before"]["ErrorsFound"], r["selected_ErrorsFound_before"])
            if r["result"]["status"] != "source-returned":
                c.need(r["result"]["status"] == "scope-error-returned" and r["result"]["observations"] is None, "Actual Rust return/scope-error ledger required")
                c.absence(op + "/Rust_return_owner", True, False, True, "actual Rust scope error has no selected return owner")
                continue
            if n.get("observations") is None:
                c.absence(op+"/preprocessing_handoff",False,True,False,"actual Native whole-call stop leaves checkpoints unknown/noPASS")
                continue
            for phase in PHASES:
                a, b = n["observations"][phase], r["result"]["observations"][phase]
                for item in [a, b]:
                    c.need(type(item["reached"]) is bool and type(item["available"]) is bool, "Typed actual phase availability required")
                    c.need(item["reached"] or (not item["available"] and item["snapshot"] is None), "Unreached phase cannot contain an owner")
                c.exact(op + "/" + phase + "/reached", a["reached"], b["reached"])
                if not a["reached"] and not b["reached"]:
                    c.absence(op + "/" + phase, False, False, False, "both actual phases unreached; no comparisons or PASS")
                    continue
                if not a["available"] or not b["available"]:
                    c.absence(op + "/" + phase, a["available"], b["available"], True, "required reached phase owner absent")
                    continue
                x, y = a["snapshot"], b["snapshot"]
                for key in ["LayersInConstruct", "NumResLayers", "copied_layer_count", "ErrorsFound", "active_prefix_available"]:
                    c.exact(op + "/" + phase + "/" + key, x[key], y[key])
                c.need(type(y["LayersInConstruct"]) is int and 1 <= y["LayersInConstruct"] <= 11 and
                       y["copied_layer_count"] == y["LayersInConstruct"] == len(y["active_prefix"]), "Actual Rust active-prefix shape required")
                if len(x["active_prefix"]) != len(y["active_prefix"]):
                    c.absence(op + "/" + phase + "/active_prefix_shape", True, True, True, "actual active-prefix shapes differ")
                    continue
                for index, (nl, rl) in enumerate(zip(x["active_prefix"], y["active_prefix"])):
                    c.exact(op + "/" + phase + "/" + str(index) + "/ResLayer", nl["ResLayer"], rl["ResLayer"])
                    for key in ["dl", "rk", "rho", "cp", "lr"]:
                        c.handoff(op + "/" + phase + "/" + str(index) + "/" + key, phase + "." + key, nl[key], rl[key])
                for key in ["dyn", "rs", "cnd"]:
                    if phase == "PostConversion":
                        c.handoff(op + "/" + phase + "/" + key, phase + "." + key, x[key], y[key])
                    else:
                        c.need(x[key] is None and y[key] is None, "Preconversion scalar must remain unavailable")


def initial_storage(c, path, operation, rust, preprocessing, caller, construction_id, context):
    """Compare actual copied initial owners; no route or discretization evaluator."""
    if not isinstance(rust, dict):
        c.absence(path + "/Rust_route_record", True, False, True, "required actual Rust Result route record absent")
        return False
    c.need(rust.get("protocol") == "ctf03-initial-discretization.v1" and
           type(rust.get("owner_available")) is bool and type(rust.get("selected_initial_operands")) is bool and
           rust.get("counted_as_PASS") is False and rust.get("initial_state_distinct_from_retry_and_whole_return") is True and
           rust.get("observer_nodal_or_route_arithmetic_performed") is False and
           rust.get("Native_whole_method_flags_or_callback_reachability_inferred") is False,
           "Actual initial Result protocol and honest copy boundary required")
    available = rust["owner_available"]
    c.exact(path + "/Rust_Result_selection", available, rust["selected_initial_operands"])
    c.exact(path + "/construction_id", construction_id, rust.get("construction_id"))
    c.exact(path + "/same_preprocessing_construction_id", construction_id, rust.get("same_preprocessing_construction_id"))
    routes = ["PreprocessingScope", "UnusedConstruction", "PreprocessingErrorReturn", "PostConversionUnavailable",
              "AllResistiveBranch", "ReverseConstruction", "InitialScope"]
    if available:
        c.need(rust.get("actual_source_route") == "InitialOwnerReturned" and rust.get("unavailable_reason") is None and
               rust.get("actual_reverse_construction_id") is None and isinstance(rust.get("snapshot"), dict),
               "Actual successful initial Result fields required")
    else:
        c.need(rust.get("actual_source_route") in routes and isinstance(rust.get("unavailable_reason"),str) and
               rust["unavailable_reason"] and rust.get("snapshot") is None,
               "Actual unavailable route must retain reason/null/noPASS")
        if rust["actual_source_route"] == "ReverseConstruction":
            c.need(type(rust.get("actual_reverse_construction_id")) is int and rust["actual_reverse_construction_id"] >= 0,
                   "Actual prior reverse owner ID required; no reverse coefficients inferred")
        else:
            c.need(rust.get("actual_reverse_construction_id") is None, "Nonreverse route cannot invent reverse owner")
    c.need(type(operation.get("actual_source_invoked")) is bool, "Actual Native invocation flag required")
    if not operation["actual_source_invoked"]:
        c.need(operation.get("observations") is None, "Uninvoked Native call cannot have invented checkpoints")
        c.absence(path,False,available,False,"whole source stopped before this call; initial observations unknown/noPASS")
        return False
    observed = operation.get("observations")
    c.need(isinstance(observed,dict) and observed.get("observer_failure") is False,
           "Actual Native initial observations require an intact source capture")
    native = observed.get("InitialDiscretization")
    c.need(isinstance(native,dict) and type(native.get("reached")) is bool and type(native.get("available")) is bool,
           "Actual Native initial callback record required")
    for name in ["is_used_ctf", "errors_found", "source_sink_present", "solution_dimensions"]:
        c.exact(path + "/context/" + name, context[name], rust.get("actual_context",{}).get(name))
    selected_context = context["source_sink_present"] is False and context["solution_dimensions"] == 1
    native_available = native["reached"] and native["available"] and selected_context
    c.exact(path + "/actual_initial_selection", native_available, available)
    required = native_available or available
    if not required:
        c.need(not native["reached"] or not selected_context,
               "Reached required initial prefix cannot disappear behind optional absence")
        c.absence(path,False,False,False,"actual initial phase unselected/unreached or explicit Rust unavailable route; no numeric PASS")
        return False
    if not native_available or not available:
        c.absence(path,native_available,available,True,"required selected initial owner missing on one or both sides")
        return False
    left, right = native.get("snapshot"),rust.get("snapshot")
    if not isinstance(left,dict) or not isinstance(right,dict):
        c.absence(path+"/snapshot",isinstance(left,dict),isinstance(right,dict),True,"required reached initial snapshot absent")
        return False
    c.need(rust.get("same_preprocessing_owner_available") is True and
           rust.get("same_post_conversion_handoff_available") is True and isinstance(preprocessing,dict) and
           preprocessing.get("status") == "source-returned", "Same actual preceding preprocessing owner required")
    converted = preprocessing.get("observations",{}).get("PostConversion",{})
    c.need(converted.get("reached") is True and converted.get("available") is True and
           isinstance(converted.get("snapshot"),dict), "Selected initial owner needs its actual converted handoff")
    prefix = converted["snapshot"]
    for name in ["LayersInConstruct", "NumResLayers", "copied_layer_count", "rcmax", "NodeSource", "NodeUserTemp", "NumHistories"]:
        a,b=left.get(name),right.get(name)
        if type(a) is not int or type(b) is not int:
            c.absence(path+"/"+name,type(a) is int,type(b) is int,True,"required actual initial integer absent")
        else:
            c.exact(path+"/"+name,a,b)
    for name in ["LayersInConstruct", "NumResLayers", "copied_layer_count", "ErrorsFound"]:
        c.exact(path+"/same_converted_handoff/"+name,prefix.get(name),right.get(name))
    for name in ["ErrorsFound", "active_prefix_available"]:
        if type(left.get(name)) is not bool or type(right.get(name)) is not bool:
            c.absence(path+"/"+name,type(left.get(name)) is bool,type(right.get(name)) is bool,True,"required actual initial flag absent")
        else:
            c.exact(path+"/"+name,left[name],right[name])
    a,b=left.get("active_prefix"),right.get("active_prefix")
    shape_a=isinstance(a,list) and type(left.get("LayersInConstruct")) is int and 1 <= left["LayersInConstruct"] <= 11 and len(a)==left["LayersInConstruct"]==left.get("copied_layer_count")
    shape_b=isinstance(b,list) and type(right.get("LayersInConstruct")) is int and 1 <= right["LayersInConstruct"] <= 11 and len(b)==right["LayersInConstruct"]==right.get("copied_layer_count")
    if not shape_a or not shape_b or len(a)!=len(b):
        c.absence(path+"/active_prefix_shape",shape_a,shape_b,True,"both exact actual active-prefix shapes required")
        return False
    for index,(x,y) in enumerate(zip(a,b)):
        p=path+"/active_prefix/"+str(index)
        c.need(isinstance(x,dict) and isinstance(y,dict) and set(x)==set(y)=={"Nodes","dx"},"Actual Nodes/dx row shape required")
        if type(x.get("Nodes")) is not int or type(y.get("Nodes")) is not int:
            c.absence(p+"/Nodes",type(x.get("Nodes")) is int,type(y.get("Nodes")) is int,True,"required actual Nodes absent")
        else: c.exact(p+"/Nodes",x["Nodes"],y["Nodes"])
        if x.get("dx") is None or y.get("dx") is None:
            c.absence(p+"/dx",x.get("dx") is not None,y.get("dx") is not None,True,"required actual dx absent")
        else: c.number(p+"/dx","dx",x["dx"],y["dx"])
    for key,profile in [("CTFTimeStep","initial_CTFTimeStep"),("TimeStepZone","caller_TimeStepZone")]:
        if left.get(key) is None or right.get(key) is None:
            c.absence(path+"/"+key,left.get(key) is not None,right.get(key) is not None,True,"required actual initial scalar absent")
        else: c.number(path+"/"+key,profile,left[key],right[key])
    for key in ["TimeStepZone"]:
        for label,value in [("Native",left.get(key)),("Rust",right.get(key)),("wrapper",rust.get("actual_wrapper_TimeStepZone"))]:
            if value is None or caller is None:
                c.absence(path+"/caller/"+label,value is not None,caller is not None,True,"required actual caller copy absent")
            else:
                c.dto(value);c.dto(caller);c.exact(path+"/caller/"+label+"/bits",caller["value_bits"],value["value_bits"])
    return True


def packet_policy(m, qa, request, policy, same, recorded, lane):
    prefix = "ctf03-" + ("production-" if lane == "production" else "")
    m.require(request["schema"] == prefix + "helper-cases.v1" and
              request["frozen_before_this_CTF03_helper_execution"] is True and
              request["expected_values_supplied"] is False and request["expected_exits_supplied"] is False and
              request["scientific_execution_performed"] is False, "Genuine input-only CTF03 request required")
    freeze, execution = m.load(qa["actual_packet_freeze"]), recorded(qa["actual_packet_freeze_execution"])
    m.require(freeze["schema"] == prefix + "frozen-packet.v1" and freeze["lane"] == lane and
              freeze["status"] == "frozen-inherited-input-and-fresh-CTF03-policy-before-helper" and
              m.load(execution["stdout"]) == freeze and m.contained(execution["stderr"]["path"]).stat().st_size == 0,
              "Actual successful fresh CTF03 freeze/full stdout required")
    for key, binding in [("helper_request",qa["reviewed_request"]),("native_admission_contract",qa["reviewed_native_admission_contract"]),
                         ("projection",qa["reviewed_projection"])]: same(freeze[key],binding)
    for key in ["source","cases","tolerances"]: same(freeze["contracts"][key],qa["reviewed_contracts"][key])
    admission, projection, cases, source = [m.load(binding) for binding in [qa["reviewed_native_admission_contract"],
        qa["reviewed_projection"],qa["reviewed_contracts"]["cases"],qa["reviewed_contracts"]["source"]]]
    m.require(admission["schema"] == prefix + "native-admission-contract.v1" and
              projection["schema"] == prefix + "observation-projection.v1" and
              cases["schema"] == prefix + "cases-contract.v1" and source["schema"] == prefix + "source-contract.v1" and
              policy["schema"] == prefix + "tolerances-contract.v1", "Actual six-DAG schemas differ")
    for owner in [admission,projection,cases]: same(owner["helper_request"],qa["reviewed_request"])
    for owner in [admission,projection]:
        for key in ["source","cases","tolerances"]: same(owner["contracts"][key],qa["reviewed_contracts"][key])
    for key in ["source","tolerances"]: same(cases[key],qa["reviewed_contracts"][key])
    same(qa["reviewed_initial_policy_contract"],qa["reviewed_contracts"]["tolerances"])
    initial_policy=qa["reviewed_initial_observation_policy"]
    m.require(initial_policy == INITIAL_POLICY == request["ctf03_initial_observation_policy"] ==
              admission["ctf03_initial_observation_policy"] == policy["ctf03_initial_observation_policy"] ==
              projection["ctf03_initial_observation_policy"], "Exact reviewed source-defined initial policy required")
    profiles=policy["arithmetic_profiles_by_variable"]
    m.require([row["variable"] for row in profiles]==INITIAL_VARIABLES and all(
        type(row["atol"]) is float and type(row["rtol"]) is float and row["atol"]==row["rtol"]==0.0 and
        row["class_exact"] is True and row["shape_exact"] is True and row["signed_zero_exact"] is True and
        row["required_shape"]==("actual_LayersInConstruct_active_prefix" if index==0 else "scalar")
        for index,row in enumerate(profiles)), "Three frozen initial zero/class/shape/signedzero profiles required")
    inherited = policy["ctf01_preprocessing_profiles"]
    prior = m.load(policy["inherited_ctf01_tolerances"])
    m.require(inherited == prior["arithmetic_profiles_by_variable"] and [r["variable"] for r in inherited] == PREFIX_VARIABLES and
              all(r["atol"] == r["rtol"] == 0.0 and r["class_exact"] is True and r["shape_exact"] is True for r in inherited),
              "Unchanged inherited18 handoff profiles required separately")
    m.require(freeze["requested_counts"] == request["requested_counts"] == admission["requested_counts"] ==
              cases["requested_counts"] == qa["requested_counts"], "Actual packet/count associations differ")
    scope = m.load(request["fixed_scope"])
    guards = [row[key] for row in scope["cases"] for key in ["input","weather","metadata"]]
    m.require(len(scope["cases"]) == 15 and len(guards) == 45 and guards == request["all_45_guard_refs"] ==
              admission["all_45_guard_refs"] == freeze["all_45_guard_refs"], "Exact fixed15 ordered45 guards required")
    for binding in guards: m.bind(binding)
    for key in ["actual_scope_amendment","actual_scope_amendment_execution"]:
        m.require(request[key] == admission[key] == projection[key], "Actual pre-output scope pair differs"); m.bind(request[key])
    m.require(len(admission["native_source_files"]) == 8, "Exact lane Native8 source inventory required")
    for binding in admission["native_source_files"]: m.bind(binding)
    return profiles,inherited,initial_policy


def compare_initial_models(native, rust, request, c):
    ledger=[]
    for expected,n,r in zip(request["model_cases"],native["model_cases"],rust["model_cases"]):
        used=[index for index,row in enumerate(expected["constructions"]) if row["IsUsedCTF"] is True]
        for index,(declared,construction,left,right) in enumerate(zip(expected["operations"],expected["constructions"],n["operations"],r["operations"])):
            path=expected["id"]+"/"+declared["id"]+"/CTF03"
            c.exact(path+"/actual_API","initialize_construction_ctf_initial",right["actual_Rust_CTF03_API"])
            c.exact(path+"/actual_API_invoked",True,right["actual_Rust_CTF03_API_invoked"])
            c.exact(path+"/construction_id",index,right["actual_construction_id"])
            c.exact(path+"/ordered_prior_ids",list(range(index)),right["actual_ordered_prior_construction_ids"])
            c.exact(path+"/used_ids",used,right["actual_used_construction_ids"])
            c.need(right["preprocessing_reexecuted_for_initial_owner"] is False and
                   right["observer_reverse_classifier_duplicated"] is False,"Actual same-prefix source-owned route required")
            c.dto(right["actual_caller_TimeStepZone"])
            c.exact(path+"/literal_caller_bits",expected["caller"]["TimeStepZone"]["bits"],right["actual_caller_TimeStepZone"]["value_bits"])
            context=None
            if left["actual_source_invoked"]:
                c.need(isinstance(left.get("before"),dict),"Actual invoked Native before owner required")
                context={"is_used_ctf":construction["IsUsedCTF"],"errors_found":left["before"]["ErrorsFound"],
                         "source_sink_present":construction["SourceSinkPresent"],"solution_dimensions":construction["SolutionDimensions"]}
            paired=initial_storage(c,path,left,right.get("CTF03_initial"),right["result"],right["actual_caller_TimeStepZone"],index,context)
            c.exact(path+"/initial_owner_availability_copy",right["CTF03_initial"]["owner_available"],right["actual_initial_discretization_owner_available"])
            ledger.append({"model_id":expected["id"],"operation_id":declared["id"],
                "Native_initial_capture":left.get("observations",{}).get("InitialDiscretization") if left.get("observations") else None,
                "Rust_initial_Result":right.get("CTF03_initial"),"selected_operands_paired":paired,
                "Native_whole_outcome_context_only":left["call_outcome"],"unselected_or_unknown_counted_as_PASS":False})
    return ledger


def run(args):
    path = PREP / "packet_io.py"
    if hashlib.sha256(path.read_bytes()).hexdigest() != IO_SHA:
        raise ValueError("Reviewed stdlib byte helper differs before import")
    spec = importlib.util.spec_from_file_location("ctf03_unit_io", path)
    m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
    own = m.bind(m.identity(__file__)); m.bind(m.identity(path))
    m.require(Path.cwd().resolve() == m.ROOT and own["sha256"] == args.approved_source_sha256, "Root-reviewed source and repository cwd required")
    started = datetime.now(timezone.utc).isoformat()

    def same(a, b):
        m.require(m.contained(a["path"], existing=False) == m.contained(b["path"], existing=False) and a["sha256"] == b["sha256"], "Actual direct identities differ")

    def instant(text):
        value = datetime.fromisoformat(text.replace("Z", "+00:00")); m.require(value.tzinfo is not None, "Aware actual UTC required"); return value

    def recorded(ref):
        record = m.load(ref)
        m.require(record["schema"] == "recorded-porting-command.v1" and type(record["exit_code"]) is int and record["exit_code"] == 0 and
                  record["launch_error"] is None and record["source_bytes_match_before_and_after"] is True and Path(record["cwd"]).resolve() == m.ROOT,
                  "Actual successful source-preserving repository command required")
        m.require(instant(record["started_utc"]) <= instant(record["finished_utc"]) <= instant(started), "Actual preceding command interval required")
        for key in ["stdout", "stderr"]: m.bind(record[key])
        m.require(record["executed_launcher"]["historical_path"] == "tools/porting/record_command.py", "Actual recorder owner differs")
        m.bind(record["executed_launcher"]["archive"])
        return record

    refs = {name: m.argument(getattr(args, name.replace("-", "_"))) for name in [
        "original-data-review", "original-data-review-execution", "Rust-build-execution", "Rust-execution", "Rust-results"]}
    qa, qc = m.load(refs["original-data-review"]), recorded(refs["original-data-review-execution"])
    m.require(qa["schema"] == "ctf03-independent-original-data-review.v1" and qa["status"] == "pass-actual-original-data-and-provenance-before-Rust"
              and qa["Rust_baseline_released"] is True and qa["complete_requested_record_ledger_validated"] is True and
              qa["actual_native_process_exit_code"] == 0 and qa["actual_native_launch_error"] is None and not qa["observation_integrity_failures"] and
              qa["numerical_PASS_claimed"] is False and m.load(qc["stdout"]) == qa, "Genuine preceding Original DataQA0/full stdout required")
    for row in qa["executed_reader_sources"]: m.bind(row["archive"])
    first = qa["executed_reader_sources"][0]
    m.require(m.contained(qc["stderr"]["path"]).stat().st_size == 0, "Actual DataQA stderr must be empty")
    m.require(qc["command"][:4] == ["python","-X","utf8","-B"] and len(qc["command"]) > 4 and
              m.contained(qc["command"][4]) == m.contained(first["historical_path"]), "Actual DataQA Python/source argv differs")
    m.require(any(m.contained(value, existing=False) == m.contained(first["historical_path"], existing=False)
                  for value in qc["command"] if value.endswith("review_unit.py")), "Actual DataQA source command differs")
    m.require("--approved-source-sha256" in qc["command"] and qc["command"][qc["command"].index("--approved-source-sha256") + 1] == first["archive"]["sha256"], "Actual DataQA approved source differs")
    request = m.load(qa["reviewed_request"]); native = m.load(qa["reviewed_results"]); rust = m.load(refs["Rust-results"])
    policy = m.load(qa["reviewed_contracts"]["tolerances"])
    profiles,inherited,initial_policy = packet_policy(m,qa,request,policy,same,recorded,"unit")
    m.require(native["schema"] == "ctf03-helper-results.v1" and native["complete_requested_record_ledger"] is True, "Complete actual Native unit ledger required")
    m.require(rust["schema"] == "ctf03-candidate-unit-observer-results.v1" and rust["all_bound_inputs_and_sources_unchanged"] is True and
              rust["numerical_PASS_claimed"] is False and rust["Native_result_or_expected_values_read"] is False, "Actual candidate-only source results required")
    for key, binding in [("actual_request", qa["reviewed_request"]), ("actual_native_admission", qa["reviewed_native_admission_contract"]), ("projection", qa["reviewed_projection"])]: same(rust[key], binding)
    for key in ["source", "cases", "tolerances"]: same(rust["contracts"][key], qa["reviewed_contracts"][key])
    build, executed = recorded(refs["Rust-build-execution"]), recorded(refs["Rust-execution"])
    m.require(instant(qc["finished_utc"]) <= instant(build["started_utc"]) and instant(build["finished_utc"]) <= instant(executed["started_utc"]), "OriginalDataQA must precede actual Cargo then Rust execution")
    m.require(m.load(executed["stdout"]) == rust and m.contained(executed["stderr"]["path"]).stat().st_size == 0, "Actual Rust full stdout and empty stderr required")
    capture = build["cargo_compiler_artifacts_capture"]
    m.require(build["command"][:2] == ["cargo", "build"] and capture["requested"] is True and capture["status"] == "pass" and capture["error"] is None, "Actual Cargo compiler-artifact capture required")
    m.require(instant(build["finished_utc"]) <= instant(capture["captured_utc"]) <= instant(executed["started_utc"]), "Actual captured artifact must precede Rust execution")
    rows = [row for row in capture["rows"] if row["cargo_message"]["target"]["name"] == "ctf03_candidate_unit_observer" and "example" in row["cargo_message"]["target"]["kind"]]
    m.require(len(rows) == 1, "Unique actual candidate example artifact required")
    artifact = rows[0]; binary = artifact["executable"]
    binary_path = m.contained(binary["historical_path"])
    def binary_sha():
        digest = hashlib.sha256()
        with binary_path.open("rb") as handle:
            for block in iter(lambda: handle.read(1024 * 1024), b""): digest.update(block)
        return digest.hexdigest()
    m.require(binary_sha() == binary["sha256"] and len(executed["command"]) == 6 and
              m.contained(executed["command"][0]) == binary_path, "Actual executed Rust binary differs from Cargo artifact")
    same(build["source_snapshot"], executed["source_snapshot"])
    snapshot = m.load(build["source_snapshot"])
    m.require(snapshot["schema"] == "rust-command-source-snapshot.v1" and snapshot["bytes_normalized"] is False, "Actual full Cargo/Rust source capture required")
    available = {row["historical_path"]: row["archive"] for row in snapshot["files"]}
    m.require(len(available) == len(snapshot["files"]), "Complete source snapshot must not contain duplicate owners")
    inventory = m.load(rust["runtime_source_bindings"])
    m.require(inventory == rust["authenticated_source_inventory"] and inventory["schema"] == "ctf03-candidate-unit-runtime-source-bindings.v1", "Actual runtime source inventory differs")
    for key, paths in [("observer_sources", OBSERVER_PATHS), ("actual_public_API_sources", API_PATHS)]:
        m.require([row["path"] for row in inventory[key]] == paths, "Actual source inventory paths/order differ")
        for binding in inventory[key]:
            m.bind(binding); m.bind(available[binding["path"]])
            m.require(binding["sha256"] == available[binding["path"]]["sha256"], "Actual compiled/captured source bytes differ from observer source binding")
    m.require(m.contained(artifact["cargo_message"]["target"]["src_path"]) == m.contained(OBSERVER_PATHS[0]), "Actual Cargo target source differs")
    m.require(m.contained(artifact["cargo_message"]["manifest_path"]) == m.contained(API_PATHS[0]), "Actual Cargo package manifest differs")
    for value, binding in zip([executed["command"][1],executed["command"][3],executed["command"][5]], [qa["reviewed_request"], qa["reviewed_native_admission_contract"], rust["runtime_source_bindings"]]):
        m.require(m.contained(value) == m.contained(binding["path"]), "Actual Rust input-only argv differs")
    m.require(executed["command"][2] == qa["reviewed_request"]["sha256"] and
              executed["command"][4] == qa["reviewed_native_admission_contract"]["sha256"], "Actual runtime input SHA arguments differ")
    calls = sum(len(row["operations"]) for row in request["model_cases"])
    m.require(type(rust["actual_Rust_preprocess_invocations"]) is int and rust["actual_Rust_preprocess_invocations"] == calls and
              rust["requested_counts"] == request["requested_counts"] == qa["requested_counts"], "Actual candidate call/count ledger differs")
    m.require(rust["ctf03_initial_observation_policy"] == initial_policy and native["CTF03_initial_observation_policy"] == initial_policy,
              "Observed policy differs from actual frozen QA")
    actual_calls=sum(op["actual_Rust_CTF03_API_invoked"] is True for model in rust["model_cases"] for op in model["operations"])
    m.require(type(rust["actual_Rust_CTF03_API_invocations"]) is int and rust["actual_Rust_CTF03_API_invocations"] == actual_calls,
              "Actual CTF03 invocation count differs")
    comparison = Comparison(m.require); compare_models(native, rust, request, comparison)
    initial_ledger=compare_initial_models(native,rust,request,comparison); result = comparison.report()
    passed = result["mismatch_count"] == 0
    m.recheck(); m.require(binary_sha() == binary["sha256"], "Actual Rust binary changed during comparison")
    output = m.contained(args.output_dir, existing=False)
    m.require(output.is_relative_to(m.CTF) and output != m.CTF and not output.exists(), "Fresh contained unit comparison output required")
    output.mkdir(parents=True, exist_ok=False)
    sources = [m.archive(m.identity(path), output, index) for index, path in enumerate([Path(__file__), PREP / "packet_io.py"])]
    report = {"schema": "ctf03-unit-comparison.v1", "status": "pass-selected-initial-discretization" if passed else "fail-selected-initial-discretization",
              "started_utc": started, "finished_utc": datetime.now(timezone.utc).isoformat(), "reviewed_Original_data_review": refs["original-data-review"],
              "reviewed_Original_data_review_execution": refs["original-data-review-execution"], "reviewed_Native_results": qa["reviewed_results"],
              "reviewed_Native_execution": qa["reviewed_native_execution"], "reviewed_request": qa["reviewed_request"], "reviewed_projection": qa["reviewed_projection"],
              "reviewed_contracts": qa["reviewed_contracts"], "Rust_results": refs["Rust-results"], "Rust_execution": refs["Rust-execution"],
              "Rust_build_execution": refs["Rust-build-execution"], "actual_Rust_binary": binary, "actual_source_snapshot": build["source_snapshot"],
              "actual_source_inventory": inventory, "requested_counts": request["requested_counts"], "frozen_numeric_profiles": profiles, "inherited_preprocessing_handoff_profiles": inherited,
              "reviewed_initial_observation_policy":initial_policy,"actual_initial_owner_ledger":initial_ledger,
              "actual_Native_observation_counts": qa["actual_observation_counts"], "actual_Rust_preprocess_invocations": rust["actual_Rust_preprocess_invocations"],
              "Native_whole_method_outcome_context_only": [{"model_id": model["id"], "operations": [
                  {"id": operation["id"], "actual_source_invoked": operation["actual_source_invoked"], "call_outcome": operation["call_outcome"]}
                  for operation in model["operations"]]} for model in native["model_cases"]],
              "comparison": result, "executed_reader_sources": sources, "executed_reader_source_archive": sources[0]["archive"],
              "selected_unit_PASS_claimed": passed, "complete_CTF03_PASS_claimed": False, "production_fixed15_loader_lane_certified": False,
              "Native_whole_method_outcomes_DoCTFErrorReport_and_massive_coefficients_paired": False, "CTF04_through_CTF10_certified": False,
              "Native_flags_injected_into_Rust_or_missing_phases_masked": False, "scientific_engine_or_layer_evaluator_invoked": False,
              "Rust_binary_payload_rehashed": True, "Native_binary_payloads_read_or_rehashed": False,
              "declared_caller_and_construction_metadata_not_claimed_as_additional_Rust_owner_fields": True,
              "gates_updated": False, "authorship_limits": "Raw authored the candidate preprocessing API and observer; this is actual data comparison, not an independent formula certificate."}
    m.recheck(); m.emit(output / "comparison.json", report); m.recheck()
    print(json.dumps(report, allow_nan=False, indent=2))
    return 0 if passed else 1


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ["approved-source-sha256", "original-data-review", "original-data-review-execution", "Rust-build-execution", "Rust-execution", "Rust-results", "output-dir"]:
        parser.add_argument("--" + name, required=True)
    raise SystemExit(run(parser.parse_args()))

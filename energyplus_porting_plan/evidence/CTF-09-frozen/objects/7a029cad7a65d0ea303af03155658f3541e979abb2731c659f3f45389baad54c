def range_guard(source, row):
    raw = m.contained(m.bind(source)["path"]).read_bytes().splitlines(keepends=True)
    lo, hi = row.get("start_line", row.get("first_line")), row.get("end_line", row.get("last_line"))
    m.require(type(lo) is int and type(hi) is int and 1 <= lo <= hi <= len(raw), "Bounded source range required")
    selected = b"".join(raw[lo - 1:hi])
    m.require(hashlib.sha256(selected).hexdigest() == row.get("range_sha256", row.get("sha256")) and
              len(selected) == row.get("range_size_bytes", row.get("size_bytes")), "Selected source range differs")


def scope_check(ref, name):
    execution = m.load(ref)
    m.require(execution["schema"] == "recorded-porting-command.v1" and
              type(execution["exit_code"]) is int and execution["exit_code"] == 0 and
              execution["launch_error"] is None and execution["source_bytes_match_before_and_after"] is True and
              execution["command"] == ["python", "-X", "utf8", "-B", "tools/porting/check_plan.py",
                                       "--check", "--card", name], "Actual source-preserving card check required")
    m.require(Path(execution["cwd"]).resolve() == m.ROOT and
              execution["executed_launcher"]["historical_path"] == "tools/porting/record_command.py",
              "Actual scope check working directory/recorder source required")
    m.bind(execution["executed_launcher"]["archive"])
    for key in ["stdout", "stderr"]:
        m.bind(execution[key])
    m.require(m.contained(execution["stderr"]["path"]).read_bytes() == b"", "Scope check stderr must be empty")



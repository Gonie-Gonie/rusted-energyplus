    m.require(amendment["schema"] == "ctf09-source-scope-amendment.v1" and
              amendment["cards"] == ["CTF-09"] and amendment["scope_review_passed"] is True and
              amendment["all_other_gates_pending"] is True and amendment["strict_profiles_settled_before_outputs"] is True and
              amendment["actual_CTF09_build_or_engine_execution_performed"] is False,
              "Actual pre-output CTF09 source scope authority required")

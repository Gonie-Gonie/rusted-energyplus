+inline bool retry_copy_failed(MethodObservation::RetryCapture const &source)
+{
+    if (source.observer_failure || source.counter_overflow || source.first_failure || source.last_failure ||
+        source.pre_assignment_records_omitted != 0 || source.diagnostic_records_omitted != 0 ||
+        source.actual_pre_assignment_count != source.pre_assignments.size() ||
+        source.actual_caller_event_count != source.caller_events.size() ||
+        source.actual_diagnostic_count != source.diagnostics.size()) return true;
+    for (auto count : source.failure_event_counts) if (count != 0) return true;
+    for (auto count : source.caller_records_omitted) if (count != 0) return true;
+    for (std::size_t index = 0; index < source.pre_assignments.size(); ++index) {
+        auto const &copy = source.pre_assignments[index];
+        if (copy.observed_pre_assignment_ordinal != index + 1 || !copy.reached || !copy.association_available ||
+            !copy.active_prefix_available || !copy.matrices_available || !copy.AMat_available || !copy.IdenMatrix_available ||
+            !copy.BMat3_after_reset || !copy.AMat_bounds || !copy.IdenMatrix_bounds ||
+            copy.copied_layer_count > copy.active_prefix.size()) return true;
+        for (bool failed : copy.failure_kinds) if (failed) return true;
+    }
+    std::array<std::size_t, 9> retained{};
+    for (std::size_t index = 0; index < source.caller_events.size(); ++index) {
+        auto const &copy = source.caller_events[index]; auto const kind = static_cast<std::size_t>(copy.event);
+        if (kind >= retained.size() || copy.observed_event_ordinal != index + 1 || !copy.reached || !copy.association_available ||
+            (copy.event == MethodObservation::RetryEvent::AssignedSums) != copy.assigned_sums.has_value()) return true;
+        ++retained[kind];
+        for (bool failed : copy.failure_kinds) if (failed) return true;
+    }
+    if (retained != source.actual_caller_event_counts) return true;
+    for (std::size_t index = 0; index < source.diagnostics.size(); ++index) {
+        auto const &copy = source.diagnostics[index];
+        if (copy.observed_diagnostic_ordinal != index + 1 || !copy.copy_available || !copy.temporal_association_only ||
+            (index != 0 && copy.actual_global_message_index <= source.diagnostics[index - 1].actual_global_message_index)) return true;

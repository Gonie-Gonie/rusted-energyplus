+inline void add_retry_totals(RetryTotals &total, json const &ledger)
+{
+    total.pre += ledger.at("actual_pre_assignment_count").get<std::size_t>();
+    total.retained_pre += ledger.at("actual_retained_pre_assignment_count").get<std::size_t>();
+    total.events += ledger.at("actual_caller_event_count").get<std::size_t>();
+    total.retained_events += ledger.at("actual_retained_caller_event_count").get<std::size_t>();
+    total.diagnostics += ledger.at("actual_diagnostic_count").get<std::size_t>();
+    total.retained_diagnostics += ledger.at("actual_retained_diagnostic_count").get<std::size_t>();
+    total.omitted_pre += ledger.at("pre_assignment_records_omitted").get<std::size_t>();
+    total.omitted_diagnostics += ledger.at("diagnostic_records_omitted").get<std::size_t>();
+    total.integrity_failed = total.integrity_failed || ledger.at("retry_copy_integrity_failed").get<bool>();
+    for (std::size_t index = 0; index < total.event_counts.size(); ++index) {
+        total.event_counts[index] += ledger.at("actual_caller_event_counts").at(index).get<std::size_t>();
+        total.omitted_events[index] += ledger.at("caller_records_omitted").at(index).get<std::size_t>();
+    }
+    for (std::size_t index = 0; index < total.failures.size(); ++index)

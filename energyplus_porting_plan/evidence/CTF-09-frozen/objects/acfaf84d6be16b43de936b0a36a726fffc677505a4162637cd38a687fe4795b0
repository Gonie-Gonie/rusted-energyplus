+inline bool retry_diagnostic_join_valid(MethodObservation::RetryCapture const &source, json const &messages)
+{
+    if (!messages.is_array()) return false;
+    for (auto const &copy : source.diagnostics) {
+        if (!copy.copy_available || copy.actual_global_message_index >= messages.size()) return false;
+        auto const &message = messages.at(copy.actual_global_message_index);
+        if (message.at("level") != copy.actual_level || message.at("message") != copy.actual_message) return false;
+    }
+    return true;
+}

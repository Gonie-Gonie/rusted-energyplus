"""Root-only one-file historical-card correction; retain all prior Source ancestry."""
import argparse
from datetime import datetime
import difflib
import hashlib
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd().resolve()
BASE = ROOT / '.runtime/porting/CTF-10'
RECORDER = ROOT / 'tools/porting/record_command.py'
RECORDER_SHA = '5745ad9809e196af00b858fcdc0d3d783531628fa2abf1e086f75c7d293514ba'
CONFIG = ['--config', 'profile.dev.debug=0', '--config', 'profile.test.debug=0', '--config', 'build.incremental=false']
QUALITY = [('fmt-check', ['cargo', 'fmt', '--all', '--', '--check']),
           ('clippy', ['cargo', 'clippy', *CONFIG, '--locked', '--workspace', '--all-targets', '--', '-D', 'warnings']),
           ('focused', ['cargo', 'test', *CONFIG, '--locked', '-p', 'ep_runtime', '--lib', 'heat_balance::']),
           ('workspace', ['cargo', 'test', *CONFIG, '--locked', '--workspace'])]
EXAMPLE_TEST = ['cargo', 'test', *CONFIG, '--locked', '-p', 'ep_run', '--example', 'ctf10_init_postlude_candidate_direct_observer']

def need(ok, message):
    if not ok: raise ValueError(message)

def sha(p):
    with p.open('rb') as stream: return hashlib.file_digest(stream, 'sha256').hexdigest()

def path(name):
    p = (ROOT / name).resolve(); need(p.is_relative_to(ROOT) and p != ROOT, 'Contained repository path required'); return p

def ref(p): return dict(path=p.relative_to(ROOT).as_posix(), sha256=sha(p), size_bytes=p.stat().st_size)

def exact(r):
    p = path(r['path']); need(p.is_file() and sha(p) == r['sha256'] and ('size_bytes' not in r or type(r['size_bytes']) is int and p.stat().st_size == r['size_bytes']), 'Exact identity differs: ' + r['path']); return p

def operand(value):
    name, digest = value.rsplit('#', 1); return ref(exact(dict(path=name, sha256=digest)))

def pairs(rows):
    out = {}
    for key, value in rows: need(key not in out, 'Duplicate JSON key'); out[key] = value
    return out

def load(r): return json.loads(exact(r).read_bytes(), object_pairs_hook=pairs, parse_constant=lambda value: need(False, 'Nonfinite JSON token: ' + value))

def write(p, value):
    with p.open('x', encoding='utf8', newline='\n') as stream: json.dump(value, stream, indent=2, allow_nan=False); stream.write('\n')

def delta(before, after, left, right):
    return ''.join(difflib.unified_diff(before.decode('utf8').splitlines(True), after.decode('utf8').splitlines(True), fromfile=left, tofile=right)).encode('utf8')

def receipt(r, *, preserved=True):
    v = load(r); need(v['schema'] == 'recorded-porting-command.v1' and type(v['exit_code']) is int and v['launch_error'] is None and Path(v['cwd']).resolve() == ROOT, 'Genuine recorded command required')
    need(not preserved or v['source_bytes_match_before_and_after'] is True, 'Actual Source preservation required')
    for key in ['stdout', 'stderr', 'source_snapshot']: exact(v[key])
    need(v['executed_launcher']['historical_path'] == 'tools/porting/record_command.py' and sha(exact(v['executed_launcher']['archive'])) == RECORDER_SHA, 'Current reviewed recorder required')
    need(datetime.fromisoformat(v['started_utc']) <= datetime.fromisoformat(v['finished_utc']), 'Actual command timestamps differ'); return v

def source_files():
    files = set((ROOT / 'crates').rglob('*.rs')) | set((ROOT / 'crates').rglob('Cargo.toml'))
    files.update(ROOT / name for name in ['Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml'] if (ROOT / name).is_file())
    return {p.relative_to(ROOT).as_posix(): p for p in files}

def source_matches(r):
    snapshot = load(r); files = source_files()
    need(snapshot['schema'] == 'rust-command-source-snapshot.v1' and snapshot['bytes_normalized'] is False and len(snapshot['files']) == len(files) and {row['historical_path'] for row in snapshot['files']} == set(files), 'Full raw Source membership differs')
    for row in snapshot['files']:
        exact(row['archive']); need(sha(files[row['historical_path']]) == row['archive']['sha256'] and files[row['historical_path']].stat().st_size == row['size_bytes'], 'Current Source differs from actual snapshot')
    return snapshot

def invoke(out, role, command, *, preserved=True):
    directory = out / (role + '-command'); need(not directory.exists(), 'Fresh recorded command required')
    result = subprocess.run([sys.executable, '-X', 'utf8', '-B', str(RECORDER), '--output-dir', str(directory.relative_to(ROOT)), '--', *command], cwd=ROOT, stdout=subprocess.DEVNULL, check=False)
    r = ref(directory / 'receipt.json'); v = receipt(r, preserved=preserved)
    need(v['command'] == command and result.returncode == v['exit_code'], 'Actual argv/exit differs'); return r, v

def check_diff(before, after, declared):
    data = exact(declared).read_bytes(); labels = data.decode('utf8').splitlines()
    need(len(labels) >= 2 and labels[0].startswith('--- ') and labels[1].startswith('+++ ') and delta(before, after, labels[0][4:], labels[1][4:]) == data, 'Exact separate semantic/formatter diff differs')

def apply(out, prep, prep_ref):
    parent_ref = prep['accepted_parent_inventory']; record = load(parent_ref)
    need(record['schema'] == 'ctf10-Init-postlude-actual-formatted-source-inventory.v1' and len(record['actual_sources']) == 12 and len(record['correction_application_sources']) == 11 and 'post_application_corrections' not in record, 'Exact initial twelve plus eleven correction ancestry required')
    need(record['correction_workflow_source_manifest'] == prep['reused_quality_source_preparation'] and record['actual_correction_Root_source'] == prep['reused_quality_executor'], 'Actual original correction/reused quality Source must remain unchanged')
    exact(prep['reused_quality_source_preparation']); exact(prep['reused_quality_executor'])
    current = {}
    for row in record['actual_sources'] + record['correction_application_sources']:
        name = row['canonical_path']; final = exact(row['actual_final_source']).read_bytes()
        need(path(name).read_bytes() == final and (name not in current or current[name] == final), 'Canonical/parent final archive differs')
        current[name] = final
    for row in record['correction_application_sources']:
        check_diff(b'' if row['new_destination_absent'] else exact(row['actual_before_archive']).read_bytes(), exact(row['actual_corrected_literal']).read_bytes(), row['actual_semantic_correction_diff'])
        check_diff(exact(row['actual_corrected_literal']).read_bytes(), exact(row['actual_final_source']).read_bytes(), row['actual_correction_formatter_diff'])
    failed = receipt(prep['retained_preflight_failure'])
    need(failed['exit_code'] == 2 and exact(failed['stdout']).stat().st_size == 0 and failed['source_snapshot'] == prep['held_before_Source_snapshot'] and len(failed['command']) == 3, 'Genuine empty-stdout preflight failure required')
    workflow = load(prep['retained_failed_candidate_workflow']); outer = receipt(prep['retained_failed_candidate_outer_execution'])
    need(workflow['schema'] == 'ctf10-Init-postlude-actual-candidate-execution-workflow.v1' and workflow['accepted_formatted_inventory'] == parent_ref and workflow['actual_Source_snapshot'] == prep['held_before_Source_snapshot'] and workflow['actual_candidate_commands_returned_zero'] is False and workflow['all_bound_inputs_and_sources_unchanged'] is True and workflow['Native_results_read'] is False and workflow['numerical_PASS_claimed'] is False and workflow['gates_updated'] is False and outer['exit_code'] == 2 and outer['source_snapshot'] == prep['held_before_Source_snapshot'], 'Retained honest failed candidate workflow required')
    need([r['lane'] for r in workflow['actual_candidate_executions']] == ['production', 'direct'] and workflow['actual_candidate_executions'][0]['execution'] == prep['retained_preflight_failure'] and workflow['actual_candidate_executions'][0]['actual_exit_code'] == 2 and workflow['actual_candidate_executions'][1]['actual_exit_code'] == 0, 'Actual production preflight failure/direct return lineage differs')
    direct = receipt(workflow['actual_candidate_executions'][1]['execution']); need(direct['exit_code'] == 0 and direct['source_snapshot'] == prep['held_before_Source_snapshot'], 'Actual same-Source direct command return required; no result payload is read')
    snapshot = source_matches(prep['held_before_Source_snapshot'])
    authority = prep['reviewed_post_application_preparation']; manifest = load(authority)
    need(len(manifest['application']) == 1 and manifest['application'] == manifest['application_sources'], 'Exact one-file reviewed correction required')
    held = manifest['application'][0]; name = held['canonical_path']
    need(name == prep['only_correction_path'] and name in current and held['absent'] is False, 'Existing exact production observer path required')
    before = exact(held['before_archive']).read_bytes(); literal = exact(held['proposal']).read_bytes()
    need(exact(held['actual_before']).read_bytes() == before == current[name], 'Held actual before/parent Source differs')
    check_diff(before, literal, held['exact_diff'])
    for lane, paths in prep['runtime_paths'].items():
        packet = load(record['runtime_source_bindings'][lane]); need(packet['schema'] == paths['schema'], 'Parent runtime schema differs')
        for key in ['observer_sources', 'actual_public_API_sources']:
            need([row['path'] for row in packet[key]] == paths[key], 'Ordered parent runtime Source paths differ')
            for row in packet[key]: exact(row)
    need(not out.exists(), 'Fresh CTF10 output directory required'); out.mkdir()
    for directory in ['before', 'literal', 'formatted', 'source-diffs', 'formatter-diffs']: (out / directory).mkdir()
    flat = name.replace('/', '__'); p = out / 'before' / flat; p.write_bytes(before); before_ref = ref(p)
    p = out / 'literal' / flat; p.write_bytes(literal); literal_ref = ref(p)
    p = out / 'source-diffs' / (flat + '.diff'); p.write_bytes(delta(before, literal, name, name))
    row = dict(canonical_path=name, source_preparation=authority, reviewed_source_authority=held['proposal'], held_before_archive=held['before_archive'], held_exact_diff=held['exact_diff'], new_destination_absent=False, actual_before_archive=before_ref, actual_corrected_literal=literal_ref, actual_semantic_correction_diff=ref(p))
    write(out / 'literal-correction.json', dict(schema='ctf10-Init-postlude-actual-post-application-correction.v1', accepted_parent_inventory=parent_ref, actual_sources=[row], source_correction_is_formatter_only=False, scientific_PASS_claimed=False, gates_updated=False))
    path(name).write_bytes(literal)
    fmt_ref, fmt = invoke(out, 'format', ['cargo', 'fmt', '--all'], preserved=False)
    need(fmt['exit_code'] == 0 and datetime.fromisoformat(failed['finished_utc']) <= datetime.fromisoformat(fmt['started_utc']), 'Actual formatter must follow retained preflight failure; preserve artifacts on failure')
    files = source_files(); need(set(files) == {r['historical_path'] for r in snapshot['files']}, 'No Source member additions/removals allowed')
    for old in snapshot['files']:
        if old['historical_path'] != name: need(sha(files[old['historical_path']]) == old['archive']['sha256'] and files[old['historical_path']].stat().st_size == old['size_bytes'], 'Unrelated full Source member changed')
    p = out / 'formatted' / flat; p.write_bytes(path(name).read_bytes()); final_ref = ref(p)
    p = out / 'formatter-diffs' / (flat + '.diff'); p.write_bytes(delta(literal, path(name).read_bytes(), literal_ref['path'], name))
    row.update(actual_final_source=final_ref, actual_correction_formatter_diff=ref(p))
    for group in ['actual_sources', 'correction_application_sources']:
        touched = [r for r in record[group] if r['canonical_path'] == name]; need(len(touched) == 1, 'Exactly one touched row in each prior inventory required')
        touched[0]['initial_correction_actual_final_source'] = touched[0]['actual_final_source']; touched[0]['actual_final_source'] = final_ref
    bindings = {}
    for lane, paths in prep['runtime_paths'].items():
        p = out / (lane + '-runtime-sources.json'); write(p, dict(schema=paths['schema'], observer_sources=[ref(path(n)) for n in paths['observer_sources']], actual_public_API_sources=[ref(path(n)) for n in paths['actual_public_API_sources']])); bindings[lane] = ref(p)
    record.update(post_application_parent_inventory=parent_ref, post_application_corrections=[row], post_application_workflow_source_manifest=prep_ref, actual_post_application_Root_source=ref(Path(__file__).resolve()), actual_post_application_format_execution=fmt_ref, post_application_before_Source_snapshot=prep['held_before_Source_snapshot'], retained_preflight_failure=prep['retained_preflight_failure'], retained_failed_candidate_workflow=prep['retained_failed_candidate_workflow'], retained_failed_candidate_outer_execution=prep['retained_failed_candidate_outer_execution'], post_application_literal_correction=ref(out / 'literal-correction.json'), runtime_source_bindings=bindings, formatter_correspondence_review_pending=True, source_correction_review_pending=True, quality_execution_performed=False)
    write(out / 'record.json', record); print(json.dumps(dict(record=ref(out / 'record.json'), correction_paths=1, independent_Source_and_formatter_review_required=True, quality_executor=prep['reused_quality_executor'])), flush=True)

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['approved-source-sha256', 'source-manifest', 'output-dir']: parser.add_argument('--' + name, required=True)
    args = parser.parse_args(); need(sha(Path(__file__).resolve()) == args.approved_source_sha256 and sha(RECORDER) == RECORDER_SHA, 'Approved executor/current recorder Source required')
    prep_ref = operand(args.source_manifest); prep = load(prep_ref); need(prep['workflow_source'] == ref(Path(__file__).resolve()) and exact(prep_ref).parent == Path(__file__).resolve().parent, 'Exact own held Source preparation required')
    out = path(args.output_dir); need(out.is_relative_to(BASE), 'Contained CTF10 output required'); apply(out, prep, prep_ref)

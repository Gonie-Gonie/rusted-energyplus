"""Create only this Source successor; no proposed applicator execution."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd().resolve()
BASE = ROOT / '.runtime/porting/CTF-10'
OLD = BASE / 'init-postlude-post-application-correction-prep-01'
OUT = BASE / 'init-postlude-post-application-correction-prep-02'

def ref(p):
    b = p.read_bytes()
    return dict(path=p.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(b).hexdigest(), size_bytes=len(b))

def write(p, value):
    p.write_text(json.dumps(value, indent=2) + '\n', encoding='utf8', newline='\n')

assert ref(OLD / 'manifest.json')['sha256'] == 'eba6f68630a9a9485dde8057c194dbc5d5b46648eedc54731e68f10629f560c6'
old = (OLD / 'run_post_correction.py').read_bytes()
needle = b"    data = exact(declared).read_bytes(); labels = data.decode('utf8').splitlines()\n"
assert old.count(needle) == 1
new = old.replace(needle, needle + b"    if not data:\n        need(before == after, 'Empty diff requires byte-exact before/after'); return\n")
ast.parse(new)
(OUT / 'run_post_correction.py').write_bytes(new)
(OUT / 'before').mkdir()
for name in ['run_post_correction.py', 'README.md', 'manifest.json']:
    (OUT / 'before' / name).write_bytes((OLD / name).read_bytes())
(OUT / 'source.diff').write_text(''.join(difflib.unified_diff(old.decode().splitlines(True), new.decode().splitlines(True), fromfile=(OLD / 'run_post_correction.py').relative_to(ROOT).as_posix(), tofile=(OUT / 'run_post_correction.py').relative_to(ROOT).as_posix())), encoding='utf8', newline='\n')
readme = (OLD / 'README.md').read_text() + '''

## Empty exact formatter delta repair

The recorded first applicator stopped during parent-diff preflight with exit1,
Source preserved, before creating an output directory or writing Rust. This
successor changes only check_diff: an empty declared diff succeeds only when
the complete before and after byte buffers are equal. Nonempty label/diff checks,
one-file action, prior lineage, full3910 guard and reused quality are unchanged.
The failed first receipt is retained as metadata, with all01 Source preserved.
Root must use a fresh apply command/output directory. No execution occurred here.
'''
(OUT / 'README.md').write_text(readme, encoding='utf8', newline='\n')
(OUT / 'README.diff').write_text(''.join(difflib.unified_diff((OLD / 'README.md').read_text().splitlines(True), readme.splitlines(True), fromfile=(OLD / 'README.md').relative_to(ROOT).as_posix(), tofile=(OUT / 'README.md').relative_to(ROOT).as_posix())), encoding='utf8', newline='\n')
manifest = json.loads((OLD / 'manifest.json').read_bytes())
manifest.update(workflow_source=ref(OUT / 'run_post_correction.py'), predecessor_manifest=ref(OLD / 'manifest.json'), retained_failed_apply_execution=ref(BASE / 'init-postlude-historical-card-apply-command-01/receipt.json'), before=[ref(OUT / 'before' / n) for n in ['run_post_correction.py', 'README.md', 'manifest.json']], source_diff=ref(OUT / 'source.diff'), README_diff=ref(OUT / 'README.diff'), own_sources=[ref(OUT / n) for n in ['run_post_correction.py', 'README.md', 'seal_source.py']], empty_diff_requires_complete_before_after_byte_equality=True)
write(OUT / 'manifest.json', manifest)
print(json.dumps(dict(manifest=ref(OUT / 'manifest.json'), source=ref(OUT / 'run_post_correction.py'), source_lines=len(new.splitlines()))))

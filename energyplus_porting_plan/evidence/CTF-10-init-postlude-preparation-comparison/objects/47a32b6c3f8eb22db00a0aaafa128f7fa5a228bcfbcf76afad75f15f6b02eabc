+#[test]
+fn early_report_scan_is_shared_and_prescanned_owner_is_not_replayed() -> Result<(), String> {
+    use ep_model::{ReportInputObject, ReportInputObjectType, ReportInputs};
+    let input = ReportInputs { objects: vec![ReportInputObject {
+        object_name: "authored report input".into(), object_type: ReportInputObjectType::Constructions,
+        alphas: ["CONSTRUCTIONS".into(), String::new(), String::new()], alpha_blank: [false, true, true],
+        default_applied: [false; 3], num_alphas: 1, is_epjson: true,
+    }], legacy_variable_dictionary_sections: -1 };
+    let mut reports = CtfInitializationReports::default();
+    let mut state = SourceErrorState {
+        output_error_header: true, version_string: "authored test version".into(),
+        idd_version_string: "authored test IDD".into(), doing_input_processing: false,
+        print_console_output: false, kickoff_simulation: false, developer_flag: false,
+        warmup_flag: false, doing_sizing: false,
+        tracking: SourceErrorTracking {
+            match_counts: [0; 20], abort_processing: false, total_severe_errors: 0,
+            total_severe_errors_during_warmup: 0, total_severe_errors_during_sizing: 0,
+            last_severe_error: String::new(), total_warning_errors: 0,
+            total_warning_errors_during_warmup: 0, total_warning_errors_during_sizing: 0,
+        },
+    };
+    let mut eio = Vec::new(); let mut console = Vec::new(); let mut error = Vec::new();
+    let mut context = CtfInitializationContext {
+        reports: &mut reports, eio: &mut eio,
+        backend: SourceErrorBackend { state: &mut state, error_stream: Some(&mut error), console: &mut console,
+            out_unit1: None, out_unit2: None, f_message: None, message_callback: None, error_callback: None, sqlite: None },
+    };
+    context.prepare_report_input_cache(&input).map_err(|error| error.to_string())?;
+    assert!(!context.reports.scan.get_report_input);
+    assert!(context.reports.scan.constructions);
+    assert!(context.reports.registry.reports.is_none());
+    let reached = context.reports.scan.clone();
+    // A separately supplied prescanned owner remains authoritative. Repeating
+    // ordinary preparation cannot reread changed input or invent a new query.
+    context.prepare_report_input_cache(&ReportInputs::default()).map_err(|error| error.to_string())?;
+    assert_eq!(context.reports.scan, reached);
+    assert_eq!(context.backend.state.tracking.total_warning_errors, 0);
+    Ok(())
+}

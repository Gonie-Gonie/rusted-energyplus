+#[test]
+fn actual_space_class_order_and_existing_full_table_are_retained() -> Result<(), CtfReportUnavailable> {
+    let mut model = model();
+    let mut second_space = model.spaces[0].clone();
+    second_space.id = SpaceId(4);
+    model.spaces.push(second_space);
+    model.zones[0].spaces.push(SpaceId(4));
+    let mut floor = model.surfaces[0].clone();
+    floor.id = SurfaceId(501); floor.name = NormalizedName::new("F501"); floor.surface_type = SurfaceType::Floor;
+    let mut second_wall = model.surfaces[0].clone();
+    second_wall.id = SurfaceId(502); second_wall.name = NormalizedName::new("W502"); second_wall.space = SpaceId(4);
+    // Input Vec order is deliberately different from native registration/report order.
+    model.surfaces.insert(0, floor);
+    model.surfaces.insert(0, second_wall);
+    let mut table = PredefinedStringTable::default();
+    table.string_entry(91, "retained", "prefix")?;
+    let rows = table.entries.as_mut().ok_or(CtfReportUnavailable::TableOwner)?;
+    rows[1].sub_table_index = 55; rows[1].unique_object_name = 56;
+    rows[99].sub_table_index = 123; rows[99].original_real_entry = -0.0;
+    let tail = rows[99].clone();
+    let prefix = rows[0].clone();
+    report_ordinary_surface_nominal_u(&model, &registry()?, &mut table)?;
+    let rows = table.entries.as_ref().ok_or(CtfReportUnavailable::TableOwner)?;
+    assert_eq!((table.num_table_entry, table.size_table_entry, rows.len()), (4, 100, 100));
+    assert_eq!(rows[0], prefix);
+    assert_eq!((rows[1].sub_table_index, rows[1].unique_object_name), (55, 56));
+    assert_eq!((&*rows[1].object_name, &*rows[2].object_name, &*rows[3].object_name), ("W500", "F501", "W502"));
+    assert_eq!(rows[99], tail);
+    assert_eq!(rows[99].original_real_entry.to_bits(), (-0.0_f64).to_bits());
+    Ok(())
+}

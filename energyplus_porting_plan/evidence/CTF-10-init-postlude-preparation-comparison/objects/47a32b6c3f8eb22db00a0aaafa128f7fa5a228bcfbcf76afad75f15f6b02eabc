+#[test]
+fn source_class_and_adiabatic_films_use_real_columns() -> Result<(), CtfReportUnavailable> {
+    let mut model = model();
+    let mut floor = model.surfaces[0].clone(); floor.surface_type = SurfaceType::Floor;
+    let mut roof = model.surfaces[0].clone(); roof.surface_type = SurfaceType::Roof;
+    let mut ceiling = roof.clone(); ceiling.surface_type = SurfaceType::Ceiling;
+    let wall_u = film_u(&model, &model.surfaces[0])?.1;
+    assert!(film_u(&model, &roof)?.1 > wall_u);
+    assert!(wall_u > film_u(&model, &floor)?.1);
+    assert_eq!(film_u(&model, &ceiling)?.1.to_bits(), film_u(&model, &roof)?.1.to_bits());
+    model.surfaces[0].outside_boundary_condition = OutsideBoundaryCondition::Adiabatic;
+    let interior_u = film_u(&model, &model.surfaces[0])?.1;
+    assert!(interior_u < wall_u);
+    let registry = registry()?;
+    let mut table = PredefinedStringTable::default();
+    report_ordinary_surface_nominal_u(&model, &registry, &mut table)?;
+    let rows = table.entries.as_ref().ok_or(CtfReportUnavailable::TableOwner)?;
+    assert_eq!(rows[0].index_column, registry.named_indices["pdchIntOpUfactFilm"]);
+    assert_eq!(rows[0].original_real_entry.to_bits(), interior_u.to_bits());
+    assert_eq!((rows[0].significant_digits, rows[0].original_entry_is_real), (3, true));
+    assert_eq!((rows[0].sub_table_index, rows[0].unique_object_name), (0, 0));
+    Ok(())
+}

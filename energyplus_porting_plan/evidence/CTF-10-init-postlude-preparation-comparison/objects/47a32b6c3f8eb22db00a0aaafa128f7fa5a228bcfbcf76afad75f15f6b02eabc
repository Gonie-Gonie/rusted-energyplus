+#[test]
+fn genuine_loader_resistance_and_zero_nominal_u_are_not_replaced() -> Result<(), CtfReportUnavailable> {
+    let mut model = model();
+    let MaterialDefinition::NoMass(mut value) = model.materials[0].definition else { return Err(CtfReportUnavailable::Association); };
+    model.materials[0].definition = MaterialDefinition::Regular(ep_model::RegularMaterial {
+        roughness: value.roughness, thickness_m: 0.25, conductivity_w_per_m_k: 1.0,
+        density_kg_per_m3: 1000.0, specific_heat_j_per_kg_k: 1000.0,
+        thermal_resistance_m2_k_per_w: value.thermal_resistance_m2_k_per_w, surface: value.surface,
+    });
+    // Stored loader NominalR is an independent owner; it is not recomputed here
+    // from deliberately different direct-test thickness/conductivity operands.
+    assert_eq!(nominal_u(&model, &model.surfaces[0])?, 0.5);
+    value.thermal_resistance_m2_k_per_w = 0.0;
+    model.materials[0].definition = MaterialDefinition::NoMass(value);
+    let mut table = PredefinedStringTable::default();
+    report_ordinary_surface_nominal_u(&model, &registry()?, &mut table)?;
+    let rows = table.entries.as_ref().ok_or(CtfReportUnavailable::TableOwner)?;
+    assert_eq!(rows[0].original_real_entry.to_bits(), 0.0_f64.to_bits());
+    assert_eq!(rows[0].char_entry, "      0.000");
+    Ok(())
+}

def ref(path):
    path = Path(path)
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(),
                size_bytes=len(raw), line_count=len(raw.splitlines()))

def read(path):
    return json.loads(Path(path).read_bytes())

def typed(path, start, end, purpose):
    path = ROOT / path
    lines = path.read_bytes().splitlines(keepends=True)
    assert 1 <= start <= end <= len(lines)
    raw = b''.join(lines[start - 1:end])
    return dict(path=path.relative_to(ROOT).as_posix(), first_line=start, last_line=end,
                sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), purpose=purpose)


(BASE / 'diffs').mkdir()
application = []
for name in paths:
    destination = ROOT / name
    proposal = BASE / 'proposed' / Path(name).name
    before = BASE / 'before' / Path(name).name
    is_new = not before.exists()
    assert proposal.is_file()
    assert not destination.exists() if is_new else destination.read_bytes() == before.read_bytes()
    previous = b'' if is_new else before.read_bytes()
    change = ''.join(difflib.unified_diff(previous.decode('utf-8').splitlines(keepends=True),
                    proposal.read_text(encoding='utf-8').splitlines(keepends=True),
                    fromfile='/dev/null' if is_new else name,
                    tofile=proposal.relative_to(ROOT).as_posix()))
    diff = BASE / 'diffs' / (Path(name).name + '.diff')
    diff.write_text(change, encoding='utf-8', newline='\n')
    row = dict(canonical_path=name, proposal=ref(proposal), exact_diff=ref(diff), absent=is_new)
    if not is_new:
        row.update(actual_before=ref(destination), before_archive=ref(before))
    application.append(row)


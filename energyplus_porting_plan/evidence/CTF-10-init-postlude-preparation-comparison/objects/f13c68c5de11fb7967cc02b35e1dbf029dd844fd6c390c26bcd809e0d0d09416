def need(ok, message):
    if not ok: raise ValueError(message)

def path(name):
    p = (ROOT / name).resolve(); need(p.is_relative_to(ROOT) and p != ROOT, 'Contained repository path required'); return p

def sha(p):
    with p.open('rb') as stream: return hashlib.file_digest(stream, 'sha256').hexdigest()

def ref(p): return dict(path=p.relative_to(ROOT).as_posix(), sha256=sha(p), size_bytes=p.stat().st_size)
def pin(r): return r['path'] + '#' + r['sha256']
def same(a, b): return path(a['path']) == path(b['path']) and a['sha256'] == b['sha256']

def exact(r):
    p = path(r['path']); need(p.is_file() and sha(p) == r['sha256'], 'Exact SHA differs: ' + r['path'])
    need('size_bytes' not in r or type(r['size_bytes']) is int and p.stat().st_size == r['size_bytes'], 'Provided size differs')
    current = ref(p); need(current['path'] not in GUARDS or GUARDS[current['path']] == current, 'Conflicting identity')
    GUARDS[current['path']] = current; return p

def operand(value):
    n, h = value.rsplit('#', 1); return ref(exact(dict(path=n, sha256=h)))

def pairs(rows):
    value = {}
    for key, item in rows: need(key not in value, 'Duplicate JSON key'); value[key] = item
    return value

def read(r): return json.loads(exact(r).read_bytes(), object_pairs_hook=pairs, parse_constant=lambda v: need(False, 'Nonfinite JSON token: ' + v))

def write(p, value):
    with p.open('x', encoding='utf8', newline='\n') as stream: json.dump(value, stream, indent=2, allow_nan=False); stream.write('\n')

def unchanged():
    for row in list(GUARDS.values()): exact(row)

def receipt(r, allowed=(0,), *, preserved=True):
    v = read(r); need(v['schema'] == 'recorded-porting-command.v1' and type(v['exit_code']) is int and v['exit_code'] in allowed and v['launch_error'] is None and Path(v['cwd']).resolve() == ROOT and (not preserved or v['source_bytes_match_before_and_after'] is True), 'Actual successful/preserved recorded command required')
    for key in ['stdout', 'stderr', 'source_snapshot']: exact(v[key])
    need(v['executed_launcher']['historical_path'] == 'tools/porting/record_command.py' and v['executed_launcher']['archive']['sha256'] == RECORDER_SHA, 'Current recorder identity required'); exact(v['executed_launcher']['archive'])
    need(datetime.fromisoformat(v['started_utc']) <= datetime.fromisoformat(v['finished_utc']), 'Actual command timestamps differ'); return v

def source_matches(r):
    v = read(r); need(v['schema'] == 'rust-command-source-snapshot.v1' and v['bytes_normalized'] is False, 'Full raw Source snapshot required')
    paths = set((ROOT / 'crates').rglob('*.rs')) | set((ROOT / 'crates').rglob('Cargo.toml'))
    paths.update(ROOT / n for n in ['Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml'] if (ROOT / n).is_file())
    files = {row['historical_path']: row for row in v['files']}
    need(len(files) == len(v['files']) and set(files) == {p.relative_to(ROOT).as_posix() for p in paths}, 'Full Source membership differs')
    for n, row in files.items():
        exact(row['archive']); exact(dict(path=n, sha256=row['archive']['sha256'], size_bytes=row['size_bytes']))
    return files


"""Author a narrow held Source successor; no project import or execution."""
from pathlib import Path
import ast
import copy
import difflib
import hashlib
import json

ROOT = Path.cwd()
OUT = ROOT / '.runtime/porting/CTF-10/init-postlude-direct-preparation-correction-prep-03'
PRIOR = ROOT / '.runtime/porting/CTF-10/init-postlude-direct-preparation-correction-prep-02'

def ref(path):
    path = Path(path)
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}

def exact(descriptor):
    actual = ref(ROOT / descriptor['path'])
    assert all(actual[key] == value for key, value in descriptor.items() if key in actual), descriptor['path']

def difference(before, after, destination, from_label, to_label):
    data = ''.join(difflib.unified_diff(before.decode().splitlines(keepends=True),
        after.decode().splitlines(keepends=True), fromfile=from_label, tofile=to_label)).encode()
    destination.parent.mkdir(exist_ok=True)
    destination.write_bytes(data)
    return ref(destination)

prior = json.loads((PRIOR / 'manifest.json').read_bytes())
manifest = copy.deepcopy(prior)
rows, narrow, old_proposals = [], [], []
for old in prior['application']:
    for key in ('actual_before', 'before_archive', 'proposal', 'exact_diff'):
        exact(old[key])
    canonical = old['canonical_path']
    name = Path(canonical).name
    current = (ROOT / canonical).read_bytes()
    assert current == (ROOT / old['before_archive']['path']).read_bytes()
    prior_body = (ROOT / old['proposal']['path']).read_bytes()
    new_body = prior_body
    if name == 'compile_report_inputs.rs':
        old_text = b'60 % input.time_steps_in_hour != 0'
        new_text = b'!60_u32.is_multiple_of(input.time_steps_in_hour)'
        assert prior_body.count(old_text) == 1
        new_body = prior_body.replace(old_text, new_text)
        assert new_body.replace(new_text, old_text) == prior_body
    elif name == 'ctf10_init_postlude_candidate_direct_observer.rs':
        old_text = b'"only_ReportInputs_moved_out":false,"typed_simulation_geometry_used":false'
        new_text = b'"only_ReportInputs_moved_out":false,"typed_simulation_geometry_or_timestep_used":true,"typed_simulation_geometry_used":false'
        assert prior_body.count(old_text) == 1
        new_body = prior_body.replace(old_text, new_text)
        assert new_body.replace(new_text, old_text) == prior_body
    else:
        assert name == 'fields.rs' and new_body == prior_body
    proposal = OUT / name
    proposal.write_bytes(new_body)
    before = OUT / 'before' / name
    before.parent.mkdir(exist_ok=True)
    before.write_bytes(current)
    before02 = OUT / 'before-02' / name
    before02.parent.mkdir(exist_ok=True)
    before02.write_bytes(prior_body)
    cumulative = difference(current, new_body, OUT / 'diffs' / (name + '.diff'),
        'before/' + canonical, 'proposed/' + canonical)
    changed = difference(prior_body, new_body, OUT / 'from-02-diffs' / (name + '.diff'),
        'held02/' + canonical, 'held03/' + canonical)
    rows.append({'canonical_path': canonical, 'actual_before': ref(ROOT / canonical),
        'before_archive': ref(before), 'proposal': ref(proposal), 'exact_diff': cumulative,
        'new_destination_absent': False})
    narrow.append({'canonical_path': canonical, 'before02_archive': ref(before02),
        'proposal': ref(proposal), 'exact_diff': changed})
    old_proposals.append(copy.deepcopy(old['proposal']))

readme = '''# Direct preparation narrow Source successor03

Cumulative01/02 was FULL reviewed by Root and Base. This fresh successor makes
only two changes: the genuine timestep-divisor admission uses
`!60_u32.is_multiple_of(input.time_steps_in_hour)` under the unchanged preceding
range guard, and the existing compiler metadata key
`typed_simulation_geometry_or_timestep_used` is retained truthfully as `true`.
The separate geometry-false and actual-timestep-true keys remain unchanged.

The divisor guard still short-circuits before a zero/out-of-range operand; it
admits exactly the same declared inputs. No calculation, literal request, policy,
caller preparation order, coefficient, EIO formatter or diagnostic changed.
Fields are byte-exact02, and the two changed sources restore02 under the exact
declared inverse. All four proposed tests remain unexecuted and byte-unchanged.

The three application rows bind actual current canonical bytes at the Root-
reported clean commit8f910751, authentic before archives, fresh proposals and
cumulative diffs. Narrow from02 archives/diffs separately retain the reviewed
predecessor. Own-source paths remain disjoint from Raw's production correction.
Native capture is reused. No canonical/Git mutation, project import, formatter,
target/test/engine execution, expected-answer injection or PASS claim occurred.
'''
(OUT / 'README.md').write_bytes(readme.encode())
manifest['predecessor'] = ref(PRIOR / 'manifest.json')
manifest['predecessor_README'] = ref(PRIOR / 'README.md')
manifest['prior_source_author'] = prior['Source_author']
manifest['initial_source_README'] = prior['README']
manifest['application'] = rows
manifest['application_sources'] = [{key: value for key, value in row.items() if key != 'actual_before'} for row in rows]
manifest['from02_sources'] = narrow
manifest['predecessor_proposals'] = old_proposals
manifest['README'] = ref(OUT / 'README.md')
manifest['Source_author'] = ref(Path(__file__).resolve())
manifest['own_sources'] = [row['proposal'] for row in rows] + [manifest['Source_author'], manifest['README']]
manifest['source_bodies_byte_exact_01'] = False
manifest['metadata_successor_README'] = ref(PRIOR / 'README.md')
manifest['narrow_source_changes'] = ['manual_is_multiple_of idiom; same short-circuit predicate',
    'restore existing truthful compiler metadata key; no preparation or math change']
manifest['narrow_inverse_to02_verified'] = True
manifest['fields_byte_exact02'] = True
manifest['all_four_proposed_tests_unchanged_and_unexecuted'] = True
manifest['metadata_delta_path'] = (OUT / 'manifest.diff').relative_to(ROOT).as_posix()
ast.parse(Path(__file__).read_bytes())
(OUT / 'manifest.json').write_bytes((json.dumps(manifest, ensure_ascii=False, indent=2) + '\n').encode())
difference((PRIOR / 'manifest.json').read_bytes(), (OUT / 'manifest.json').read_bytes(),
    OUT / 'manifest.diff', 'held02/manifest.json', 'held03/manifest.json')
print(json.dumps({'manifest': ref(OUT / 'manifest.json'), 'narrow_diffs': [row['exact_diff'] for row in narrow]}))

+/// Decline project-control branches not represented by this fixed direct lane.
+/// These are input-only Source admissions, never tests of an observed answer.
+pub fn admit_project_defaults(raw: &RawModel, input: &DirectReportInputs) -> Result<(), String> {
+    let allowed = ["Version", "Timestep", "Building", "GlobalGeometryRules", "Output:Constructions"];
+    if raw.objects.iter().any(|(kind, rows)| !allowed.contains(&kind.0.as_str()) || rows.len() != 1) {
+        return Err("direct project preparation requires the declared no-extra-project-control input domain".into());
+    }
+    if input.version_id != "26.1" {
+        return Err("direct project preparation does not represent Version warning/error branches".into());
+    }
+    let timestep = raw.objects.get(&ObjectType("Timestep".into()))
+        .and_then(|rows| rows.values().next())
+        .and_then(|row| row.fields.get(&FieldName("number_of_timesteps_per_hour".into())))
+        .and_then(|value| match value { RawValue::Number(value) => value.parse::<u32>().ok(), _ => None });
+    if timestep != Some(input.time_steps_in_hour) || !(4..=60).contains(&input.time_steps_in_hour)
+        || !60_u32.is_multiple_of(input.time_steps_in_hour) {
+        return Err("direct project preparation requires a genuine warning-free declared Timestep divisor".into());
+    }
+    Ok(())
+}

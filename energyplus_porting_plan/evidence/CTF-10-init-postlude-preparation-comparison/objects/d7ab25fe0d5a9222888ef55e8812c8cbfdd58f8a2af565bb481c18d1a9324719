+/// Selected actual OpenOutputFiles then GetProjectData writes, in Source order.
+/// Constructor defaults are applicable only after admit_project_defaults succeeds.
+/// Program version is the actual caller text, not the IDF Version object.
+pub fn write_project_eio(input: &DirectReportInputs, program_version: &str, sink: &mut dyn Write) -> io::Result<()> {
+    writeln!(sink, "Program Version,{program_version}")?;
+    writeln!(sink, "! <Version>, Version ID")?;
+    writeln!(sink, " Version, {}", input.version_id)?;
+    writeln!(sink, "! <Timesteps per Hour>, #TimeSteps, Minutes per TimeStep {{minutes}}")?;
+    let minutes = input.time_step_zone() * 60.0;
+    writeln!(sink, " Timesteps per Hour, {:>2}, {:>2}", input.time_steps_in_hour, minutes)?;
+    writeln!(sink, "! <System Convergence Limits>, Minimum System TimeStep {{minutes}}, Max HVAC Iterations, Minimum Plant Iterations, Maximum Plant Iterations")?;
+    let min_time_step_sys: f64 = 1.0 / 60.0;
+    let min_int = (min_time_step_sys * 60.0) as i32;
+    writeln!(sink, " System Convergence Limits, {min_int}, {}, {}, {}", 20, 2, 8)?;
+    writeln!(sink, "! <Simulation Control>, Do Zone Sizing, Do System Sizing, Do Plant Sizing, Do Design Days, Do Weather Simulation, Do HVAC Sizing Simulation")?;
+    writeln!(sink, " Simulation Control, No, No, No, Yes, Yes, No")?;
+    writeln!(sink, "! <Performance Precision Tradeoffs>, Use Coil Direct Simulation, Zone Radiant Exchange Algorithm, Override Mode, Number of Timestep In Hour, Force Euler Method, Minimum Number of Warmup Days, Force Suppress All Begin Environment Resets, Minimum System Timestep, MaxZoneTempDiff, MaxAllowedDelTemp")?;
+    writeln!(sink, " Performance Precision Tradeoffs, No, ScriptF, Normal, {}, No, {}, No, {}, {}, {}",
+        input.time_steps_in_hour, 1, round_default(min_time_step_sys * 60.0, 1)?,
+        round_default(0.3, 3)?, round_default(0.002, 4)?)?;
+    writeln!(sink, "! <Output Reporting Tolerances>, Tolerance for Time Heating Setpoint Not Met, Tolerance for Zone Cooling Setpoint Not Met Time")?;
+    writeln!(sink, " Output Reporting Tolerances, {}, {}, ", round_default(0.2, 3)?, round_default(0.2, 3)?)?;
+    Ok(())
 }
 

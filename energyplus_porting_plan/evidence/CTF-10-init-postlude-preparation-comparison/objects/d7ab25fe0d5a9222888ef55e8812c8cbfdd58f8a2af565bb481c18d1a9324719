+// Selected IOFiles.hh R formatting for the finite constructor defaults below.
+// Same threshold, three outward nextafter nudges for fixed, one for exponential.
+fn round_default(value: f64, precision: usize) -> io::Result<String> {
+    if !value.is_finite() || value.abs() > 100000.0 {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, "non-default project R operand"));
+    }
+    let threshold = f64::from_bits(0x3fb9_9999_9999_9999);
+    let next = |v: f64| if v == 0.0 { v } else { f64::from_bits(v.to_bits() + 1) };
+    if value >= threshold || value <= -threshold || value == 0.0 {
+        let nudged = if value == 0.0 { 0.0 } else { next(next(next(value))) };
+        return Ok(format!("{nudged:.precision$}"));
+    }
+    let text = format!("{:.precision$E}", next(value));
+    let (mantissa, exponent) = text.split_once('E')
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "project R exponent"))?;
+    let exponent = exponent.parse::<i32>()
+        .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?;
+    Ok(format!("{mantissa}E{exponent:+04}"))
+}

"""Install reviewed literal failed-comparison documents; no gate or Source changes."""
import argparse
import copy
import hashlib
import json
from pathlib import Path
import re

ROOT = Path.cwd().resolve()
GATES = ('scope_review', 'unit_gate', 'integration_gate', 'production_gate')
PLAN_SCRIPT = re.compile(r'(<script id="plan" type="application/json">)(.*?)(</script>)', re.S)

def exact(row):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT) and path.is_file()
    data = path.read_bytes()
    assert hashlib.sha256(data).hexdigest() == row['sha256'] and len(data) == row['size_bytes']
    return path, data

def totals(plan):
    result = {}
    for scope in ('A', 'B'):
        selected = [task for task in plan['tasks'] if scope in task['applicability'].split('/')]
        def complete(task):
            scoped = task.get('scope_gates')
            values = scoped.get(scope) if isinstance(scoped, dict) else None
            if not isinstance(values, dict): values = {key: task.get(key) for key in GATES}
            return set(values) == set(GATES) and all(value == '\uD1B5\uACFC' for value in values.values())
        result[scope] = [sum(complete(task) for task in selected), len(selected)]
    return result

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source-manifest', required=True)
    args = parser.parse_args()
    name, digest = args.source_manifest.rsplit('#', 1)
    manifest_path = (ROOT / name).resolve()
    assert manifest_path.is_relative_to(ROOT) and manifest_path.is_file()
    manifest_bytes = manifest_path.read_bytes(); assert hashlib.sha256(manifest_bytes).hexdigest() == digest
    manifest = json.loads(manifest_bytes)
    assert manifest['schema'] == 'ctf10-Init-postlude-failed-milestone-documents-source.v1'
    own_path, _ = exact(manifest['workflow_source']); assert own_path == Path(__file__).resolve()
    _, summary_bytes = exact(manifest['actual_summary']); summary = json.loads(summary_bytes)
    assert summary['schema'] == 'ctf10-Init-postlude-actual-selected-comparison-milestone.v1'
    assert summary['status'] == 'fail-selected-paired-Init-owner-fields' and summary['selected_paired_owner_fields_passed'] is False
    assert summary['actual_case_counts'] == {'model_cases': 15, 'direct_unit_cases': 6}
    assert summary['comparison']['mismatch_count'] == 829 and summary['comparison']['numeric_comparisons'] == 2106 and summary['comparison']['discrete_comparisons'] == 696389
    assert summary['comparison']['mismatch_records_dropped'] == 0 and summary['comparison']['unavailable_counted_as_PASS'] is False
    assert all(summary[key] is False for key in ['whole_Init_equivalence_claimed', 'ordinary_persistent_integration_PASS_claimed', 'complete_CTF10_PASS_claimed', 'card_gates_promoted', 'A_and_B_gate_counts_changed', 'gates_updated'])
    assert set(summary['actual_quality']) == {'fmt-check', 'clippy', 'focused', 'workspace'}
    assert all(row['actual_exit_code'] == 0 and row['failed'] == 0 for row in summary['actual_quality'].values())
    assert summary['actual_quality']['focused']['passed'] == 306 and summary['actual_quality']['workspace']['passed'] == 4926 and summary['actual_quality']['workspace']['test_groups'] == 21
    assert summary['actual_Source_snapshot']['sha256'] == '7222438fc3281d590c1fc044121314464c3c965150d9e1b03eef2a5e9f79cab9'
    assert len(summary['comparison']['unavailable_observations']) == 132
    originals = {}; proposals = {}; destinations = []
    assert len(manifest['documents']) == 4
    for row in manifest['documents']:
        path, before = exact(row['actual_before']); _, proposal = exact(row['proposal']); exact(row['exact_diff'])
        assert row['canonical_path'] == path.relative_to(ROOT).as_posix() and path not in destinations
        destinations.append(path); originals[path.name] = before.decode('utf8'); proposals[path.name] = proposal.decode('utf8')
    before = json.loads(originals['plan.json']); after = json.loads(proposals['plan.json']); restored = copy.deepcopy(after)
    task = next(task for task in restored['tasks'] if task['id'] == 'CTF-10')
    assert task.pop('actual_selected_Init_postlude_owner_comparison') == manifest['actual_summary'] and restored == before
    assert totals(before) == totals(after) == {'A': [14, 54], 'B': [14, 64]}
    tables = lambda text: [line for line in text.splitlines() if line.startswith('|')]
    assert len(tables(originals['CHECKLIST.md'])) == 86 and tables(originals['CHECKLIST.md']) == tables(proposals['CHECKLIST.md'])
    assert tables(originals['CTF-10.md']) == tables(proposals['CTF-10.md'])
    assert originals['CTF-10.md'].splitlines()[:8] == proposals['CTF-10.md'].splitlines()[:8]
    old_html = originals['energyplus_porting_checklist.html']; new_html = proposals['energyplus_porting_checklist.html']
    assert len(PLAN_SCRIPT.findall(old_html)) == len(PLAN_SCRIPT.findall(new_html)) == 1
    assert json.loads(PLAN_SCRIPT.search(old_html)[2]) == before and json.loads(PLAN_SCRIPT.search(new_html)[2]) == after
    assert PLAN_SCRIPT.sub(r'\1\3', old_html) == PLAN_SCRIPT.sub(r'\1\3', new_html)
    for row in manifest['documents']: exact(row['actual_before']); exact(row['proposal'])
    exact(manifest['actual_summary'])
    for row, destination in zip(manifest['documents'], destinations, strict=True): destination.write_bytes(exact(row['proposal'])[1])
    print(json.dumps({'status': 'recorded-failed-selected-comparison-documents', 'mismatches': 829, 'gates_updated': False, 'A': [14, 54], 'B': [14, 64]}), flush=True)

if __name__ == '__main__': main()

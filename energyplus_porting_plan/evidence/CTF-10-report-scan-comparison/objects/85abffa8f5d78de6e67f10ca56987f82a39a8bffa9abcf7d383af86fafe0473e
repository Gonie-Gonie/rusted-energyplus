def boot(name, filename, digest):
    path = PREP / filename
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest: raise ValueError("Reviewed stdlib dependency differs before import")
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    return module


def modules():
    m = boot("scan_packet_io", "packet_io.py", IO_SHA)
    return m


def full(m, row):
    """Unbounded streamed binary/core identity; never load binary bytes as JSON."""
    path = m.contained(row["path"]); digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1048576), b""): digest.update(block)
    actual = {"path": path.relative_to(m.ROOT).as_posix(), "sha256": digest.hexdigest(), "size_bytes": path.stat().st_size}
    m.require(actual["sha256"] == row["sha256"] and ("size_bytes" not in row or (type(row["size_bytes"]) is int and row["size_bytes"] == actual["size_bytes"])), "Full binary/core identity differs")
    LARGE[actual["path"]] = actual
    return actual


def recheck(m):
    m.recheck()
    for row in list(LARGE.values()): m.require(full(m, row) == row, "Full binary/core file changed during stage")


def same(m, left, right):
    m.require(m.contained(left["path"], existing=False) == m.contained(right["path"], existing=False) and left["sha256"] == right["sha256"], "Actual artifact path/SHA identities differ")
    if "size_bytes" in left and "size_bytes" in right: m.require(type(left["size_bytes"]) is int and left["size_bytes"] == right["size_bytes"], "Actual artifact sizes differ")


def instant(value, need):
    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    need(parsed.tzinfo is not None, "Aware actual command interval required")
    return parsed


def recorded(m, ref, allowed=(0,), allow_failure=False):
    value = m.load(ref)
    known = type(value["exit_code"]) is int
    unknown = value["exit_code"] is None and type(value["launch_error"]) is str and bool(value["launch_error"])
    m.require(value["schema"] == "recorded-porting-command.v1" and (known or (allow_failure and unknown)) and
              value["source_bytes_match_before_and_after"] is True and Path(value["cwd"]).resolve() == m.ROOT,
              "Genuine source-preserving repository recorder required")
    if not allow_failure: m.require(value["exit_code"] in allowed and value["launch_error"] is None, "Actual required recorded command exit differs")
    m.require(instant(value["started_utc"], m.require) <= instant(value["finished_utc"], m.require) <= datetime.now(timezone.utc), "Actual preceding command interval required")
    for key in ["stdout", "stderr", "source_snapshot"]: m.bind(value[key])
    m.require(value["executed_launcher"]["historical_path"] == "tools/porting/record_command.py", "Actual recorder owner differs")
    m.bind(value["executed_launcher"]["archive"])
    return value


def before(m, earlier, later):
    m.require(instant(earlier["finished_utc"], m.require) <= instant(later["started_utc"], m.require), "Required predecessor completed after dependent invocation")


def python_cli(m, command, source, names):
    m.require(len(command) == 5 + 2 * len(names) and Path(command[0]).name.lower() in ["python", "python.exe"] and command[1:4] == ["-X", "utf8", "-B"] and m.contained(command[4]) == m.contained(source["path"]), "Actual reviewed Python CLI differs")
    pairs = list(zip(command[5::2], command[6::2])); options = dict(pairs)
    m.require(len(options) == len(pairs) and set(options) == {"--" + name for name in names}, "Exact recorded options required")
    return options


def own(m, args, path):
    manifest_ref = m.argument(args.source_manifest); manifest = m.load(manifest_ref)
    m.require(Path.cwd().resolve() == m.ROOT and m.identity(path)["sha256"] == args.approved_source_sha256 and manifest["schema"] == "ctf10-scan-unit-validation-source-preparation.v1", "Root-reviewed stage Source/cwd required")
    paths = [PREP / name for name in FILES]
    m.require([m.bind(row) for row in manifest["own_sources"]] == [m.identity(path) for path in paths], "Exact seven-source held inventory required")
    return manifest_ref, manifest, paths


def frozen(m, freeze_ref, execution_ref, shape):
    packet = m.load(freeze_ref); command = recorded(m, execution_ref)
    shape.keys(packet, ["schema", "source_preparation", "literal_request_source", "request", "inputs", "policies", "input_counts", "expected_values_supplied", "numeric_profiles", "scientific_execution_performed", "Root_freezer_source"], m.require, "freeze")
    m.require(packet["schema"] == "ctf10-scan-unit-frozen-inputs.v1" and packet["expected_values_supplied"] is False and packet["scientific_execution_performed"] is False and packet["numeric_profiles"] == [], "Actual input-only freeze schema/claims differ")
    same(m, packet["source_preparation"], NATIVE); same(m, packet["Root_freezer_source"], WRITER)
    native = m.load(NATIVE); writer = m.bind(WRITER)
    m.require(command["command"] == ["python", "-X", "utf8", "-B", writer["path"]], "Actual Root literal freezer CLI differs")
    printed = ast.literal_eval(m.contained(command["stdout"]["path"]).read_text(encoding="utf-8").strip())
    m.require(printed == m.bind(freeze_ref), "Exact compact actual freeze reference stdout required")
    request = m.load(packet["request"]); literal = m.load(packet["literal_request_source"])
    same(m, packet["literal_request_source"], native["input_fixture_proposal"])
    m.require(shape.equal(request, literal) and m.bind(packet["request"])["sha256"] == m.bind(packet["literal_request_source"])["sha256"], "Frozen request must retain exact literal Source bytes")
    m.require(shape.request(request, m.require) == packet["input_counts"] == {"cases": 12, "queries": 264}, "Exact12/264 input declarations required")
    m.require(type(packet["inputs"]) is list and len(packet["inputs"]) == 12, "Every declared frozen input authority required")
    for row, case, original in zip(packet["inputs"], request["cases"], native["resolved_case_input_sources"], strict=True):
        shape.keys(row, ["case_id", "input_mode", "original_input", "actual_input"], m.require, "frozen input")
        m.require((row["case_id"], row["input_mode"]) == (case["case_id"], case["input_mode"]), "Frozen case identity/order differs")
        same(m, row["original_input"], original)
        old, actual = m.bind(original), m.bind(row["actual_input"])
        m.require(old["sha256"] == actual["sha256"] and old["size_bytes"] == actual["size_bytes"] and (m.contained(packet["request"]["path"]).parent / case["input_file"]).resolve() == m.contained(actual["path"]), "Actual helper input location/bytecopy differs")
    shape.keys(packet["policies"], ["observation_policy_proposal", "input_projection_contract_proposal"], m.require, "frozen policies")
    for key, ref in packet["policies"].items():
        actual, source = m.bind(ref), m.bind(native[key])
        m.require(actual["sha256"] == source["sha256"] and actual["size_bytes"] == source["size_bytes"], "Literal pre-output policy/projection bytes differ")
    for row in native["runtime_interfaces"]["native_source_files"]: m.bind(row)
    for row in native["source_contexts"]:
        if row["path"].startswith(".reference/"): m.bind(row)
    for row in native["selected_source_ranges"]:
        raw = b"".join(m.contained(row["path"]).read_bytes().splitlines(keepends=True)[row["start_line"] - 1:row["end_line"]])
        m.require(hashlib.sha256(raw).hexdigest() == row["sha256"] and len(raw) == row["size_bytes"], "Actual selected Source range differs")
    return packet, request, native, command


def original(m, args, shape, manifest_ref, manifest):
    refs = {name: m.argument(getattr(args, name.replace("-", "_"))) for name in ["original-data-review", "original-data-review-execution"]}
    qa, execution = m.load(refs["original-data-review"]), recorded(m, refs["original-data-review-execution"])
    m.require(qa["schema"] == "ctf10-scan-unit-independent-original-data-review.v1" and qa["status"] == "pass-actual-Scan-custody-before-Rust" and qa["Original_capture_custody_released"] is True and qa["actual_counts_unknown"] is False and not qa["observation_integrity_failures"] and qa["numerical_PASS_claimed"] is False and shape.equal(m.load(execution["stdout"]), qa), "Actual complete OriginalQA0/full stdout/release required")
    same(m, qa["reviewed_reader_source_preparation"], manifest_ref)
    sources = [m.bind(row) for row in manifest["own_sources"]]
    archives = qa["executed_reader_sources"]
    m.require(len(archives) == len(sources), "Every executed reader Source archive required")
    for source, archived in zip(sources, archives, strict=True):
        copied = m.bind(archived["archive"])
        m.require(archived["historical_path"] == source["path"] and copied["sha256"] == source["sha256"] and copied["size_bytes"] == source["size_bytes"], "Actual executed reader archive differs")
    options = python_cli(m, execution["command"], sources[0], QA_OPTIONS)
    m.require(options["--approved-source-sha256"] == sources[0]["sha256"], "Actual approved reader Source differs")
    same(m, m.argument(options["--source-manifest"]), manifest_ref)
    for name, key in [("native-execution", "actual_native_execution"), ("results", "actual_native_results"), ("freeze-receipt", "actual_packet_freeze"), ("freeze-execution", "actual_freeze_execution"), ("build-review", "actual_build_review"), ("build-review-execution", "actual_build_review_execution")]: same(m, m.argument(options["--" + name]), qa[key])
    m.require(m.contained(options["--output-dir"], existing=False) == m.contained(refs["original-data-review"]["path"]).parent, "Actual QA output owner differs")
    packet, request, native, frozen_command = frozen(m, qa["actual_packet_freeze"], qa["actual_freeze_execution"], shape)
    actual = recorded(m, qa["actual_native_execution"]); before(m, frozen_command, actual); before(m, actual, execution)
    same(m, actual["stdout"], qa["actual_native_results"])
    result = m.load(qa["actual_native_results"])
    m.require(shape.review(result, request, m.require) == qa["actual_observation_counts"], "Complete actual Original ledger/count revalidation differs")
    return refs, qa, execution, packet, request, result


def projection_value(m, refs, qa, packet, request, original):
    authorities = {"actual_packet_freeze": qa["actual_packet_freeze"], "actual_freeze_execution": qa["actual_freeze_execution"], "reviewed_original_data": refs["original-data-review"], "reviewed_original_data_execution": refs["original-data-review-execution"], "actual_native_execution": qa["actual_native_execution"], "actual_native_results": qa["actual_native_results"], "frozen_input_sources": packet["inputs"], "frozen_policies": packet["policies"]}
    cases = []
    for supplied, source, observed in zip(request["cases"], packet["inputs"], original["cases"], strict=True):
        text = m.contained(source["actual_input"]["path"]).read_bytes().decode("utf-8") if supplied["input_mode"] == "process_input_idf" else None
        cases.append({"case_id": supplied["case_id"], "input_mode": supplied["input_mode"], "input_only_epjson": observed["input_owner"]["epJSON"], "idf_text": text, "initial_cache": supplied["initial_cache"], "queries": supplied["queries"]})
    return {"schema": "ctf10-scan-unit-input-projection.v1", "expected_values_supplied": False, "actual_input_authorities": authorities, "cases": cases}

"""Actual Scan owner and complete declared ledger validation, without a Scan evaluator."""
FAMILIES = ["Output:Surfaces:List", "Output:Surfaces:Drawing", "Output:VariableDictionary", "Output:Constructions", "Output:EnergyManagementSystem"]
GENERAL_BOOL = "GetReportInput SurfVert SurfDet SurfDetWVert DXFReport DXFWFReport VRMLReport CostInfo ViewFactorInfo Constructions Materials LineRpt VarDict EMSoutput".split()
GENERAL_TEXT = "DXFOption1 DXFOption2 DXFWFOption1 DXFWFOption2 VRMLOption1 VRMLOption2 ViewRptOption1 LineRptOption1 VarDictOption1 VarDictOption2".split()
EMS_BOOL = "OutputEMSActuatorAvailSmall OutputEMSActuatorAvailFull OutputEMSInternalVarsSmall OutputEMSInternalVarsFull OutputEMSErrors OutputFullEMSTrace".split()
BOOLS = GENERAL_BOOL + EMS_BOOL + ["ShowDecayCurvesInEIO"]
BACKEND_BOOL = "WarmupFlag DoingSizing KickOffSimulation DoingInputProcessing printConsoleOutput".split()
BACKEND_INT = "TotalWarningErrors TotalWarningErrorsDuringWarmup TotalWarningErrorsDuringSizing TotalSevereErrors".split()


def keys(value, names, need, label):
    need(type(value) is dict and set(value) == set(names), label + " exact owner keys differ")


def equal(left, right):
    if type(left) is not type(right): return False
    if type(left) is dict: return set(left) == set(right) and all(equal(left[key], right[key]) for key in left)
    if type(left) is list: return len(left) == len(right) and all(equal(a, b) for a, b in zip(left, right))
    return left == right


def cache(value, need, label):
    keys(value, BOOLS + GENERAL_TEXT, need, label)
    need(all(type(value[key]) is bool for key in BOOLS), label + " Boolean cache owner differs")
    need(all(type(value[key]) is str for key in GENERAL_TEXT), label + " string cache owner differs")


def outcome(value, need, label):
    keys(value, ["status", "exception_type", "exception_message"], need, label)
    need(value["status"] == "source_returned" and value["exception_type"] is None and value["exception_message"] is None,
         label + " actual normal return required; actual stop is never released")


def observed(value, need, label):
    keys(value, ["available", "snapshot", "backend_context", "copy_failure"], need, label)
    need(value["available"] is True and value["copy_failure"] is None, label + " complete actual owner copy required")
    cache(value["snapshot"], need, label + "/snapshot")
    owner = value["backend_context"]
    keys(owner, BACKEND_BOOL + BACKEND_INT, need, label + "/backend")
    need(all(type(owner[key]) is bool for key in BACKEND_BOOL) and all(type(owner[key]) is int and owner[key] >= 0 for key in BACKEND_INT),
         label + " actual backend context types differ")


def request(value, need):
    keys(value, ["schema", "card", "expected_values_supplied", "cases"], need, "request")
    need(value["schema"] == "ctf10-scan-unit-request.v1" and value["card"] == "CTF-10" and value["expected_values_supplied"] is False, "Frozen input-only request differs")
    need(type(value["cases"]) is list and len(value["cases"]) == 12, "All12 declared cases required")
    ids = set(); queries = 0
    for case in value["cases"]:
        keys(case, ["case_id", "input_mode", "input_file", "initial_cache", "queries"], need, "input case")
        need(type(case["case_id"]) is str and case["case_id"] not in ids, "Unique declared case ID required"); ids.add(case["case_id"])
        need(case["input_mode"] in ["process_input_idf", "process_input_epjson", "direct_getter_epjson"] and type(case["input_file"]) is str, "Actual input mode/path required")
        if case["initial_cache"] is not None: cache(case["initial_cache"], need, "literal input seed")
        need(type(case["queries"]) is list and case["queries"], "Ordered declared queries required")
        for query in case["queries"]:
            keys(query, ["report_name", "report_key", "option1", "option2", "DoReport_before"], need, "input query")
            need(type(query["report_name"]) is str and type(query["DoReport_before"]) is bool and all(query[key] is None or type(query[key]) is str for key in ["report_key", "option1", "option2"]), "Typed actual query owners required")
            need(query["report_name"].upper() != "SURFACES" or query["report_key"] is not None, "Native unchecked absent key is not admitted")
        queries += len(case["queries"])
    need(queries == 264, "All264 input declarations required, not predicted returns")
    return {"cases": len(ids), "queries": queries}


def review(value, literal, need):
    requested = request(literal, need)
    keys(value, ["schema", "cases", "requested_case_count", "recorded_case_count", "actual_Original_body_modified", "expected_values_supplied", "complete_CTF10_PASS_claimed", "production_or_whole_Init_equivalence_claimed"], need, "result")
    need(value["schema"] == "ctf10-scan-unit-native-results.v1" and all(value[key] is False for key in ["actual_Original_body_modified", "expected_values_supplied", "complete_CTF10_PASS_claimed", "production_or_whole_Init_equivalence_claimed"]), "Actual bounded result schema/claims differ")
    need(type(value["cases"]) is list and len(value["cases"]) == requested["cases"] and type(value["requested_case_count"]) is int and type(value["recorded_case_count"]) is int and value["requested_case_count"] == value["recorded_case_count"] == requested["cases"], "Complete actual case ledger required")
    counts = {"cases": 0, "actual_queries": 0, "actual_getter_records": 0, "actual_diagnostics": 0, "actual_query_diagnostics": 0, "actual_preparation_diagnostics": 0}
    for case, supplied in zip(value["cases"], literal["cases"]):
        keys(case, ["case_id", "input_mode", "constructor", "preparation", "ordinary_processInput_admission_claimed", "input_owner", "queries", "getter_records_after_queries", "getter_copy_outcome", "final", "diagnostics", "error_stream", "audit_stream", "captured_console_stdout", "captured_console_stderr", "observer_copy_failures", "sqlite_backend_present", "complete_report_or_fatal_backend_equivalence_claimed"], need, "actual case")
        label = supplied["case_id"]
        need(case["case_id"] == label and case["input_mode"] == supplied["input_mode"], "Actual declared case identity/order differs")
        for key in ["constructor", "preparation", "getter_copy_outcome"]: outcome(case[key], need, label + "/" + key)
        need(case["ordinary_processInput_admission_claimed"] is (supplied["input_mode"] != "direct_getter_epjson"), "Getter-domain/ordinary input admission must remain separate")
        keys(case["input_owner"], ["epJSON", "isEpJSON", "preserveIDFOrder", "legacy_section_count"], need, "actual parser input")
        owner = case["input_owner"]
        need(type(owner["epJSON"]) is dict and type(owner["isEpJSON"]) is bool and type(owner["preserveIDFOrder"]) is bool and type(owner["legacy_section_count"]) is int, "Actual parser owner types differ")
        need(owner["isEpJSON"] is (supplied["input_mode"] != "process_input_idf"), "Actual parser input mode differs")
        need(type(case["observer_copy_failures"]) is int and case["observer_copy_failures"] == 0 and type(case["sqlite_backend_present"]) is bool and case["complete_report_or_fatal_backend_equivalence_claimed"] is False, "Actual copy failures/backend boundary differs")
        need(all(type(case[key]) is str for key in ["error_stream", "audit_stream", "captured_console_stdout", "captured_console_stderr"]), "Actual complete stream owners required")
        messages = case["diagnostics"]; need(type(messages) is list, "Full actual diagnostic ledger required")
        for index, message in enumerate(messages, 1):
            keys(message, ["ordinal", "query_ordinal", "kind", "actual_level", "argument"], need, "actual diagnostic")
            need(type(message["ordinal"]) is int and message["ordinal"] == index and type(message["query_ordinal"]) is int and 0 <= message["query_ordinal"] <= len(supplied["queries"]) and message["kind"] in ["Warning", "Continue", "other"] and type(message["actual_level"]) is int and type(message["argument"]) is str, "Actual diagnostic identity/order/association differs")
        queries = case["queries"]; need(type(queries) is list and len(queries) == len(supplied["queries"]), "All declared query records required")
        previous = None; previous_diagnostic_end = sum(message["query_ordinal"] == 0 for message in messages)
        for index, (query, source) in enumerate(zip(queries, supplied["queries"]), 1):
            keys(query, ["ordinal", "actual_source_invoked", "input", "outcome", "before", "after", "DoReport_after", "option1_after", "option2_after", "diagnostic_begin", "diagnostic_end"], need, "actual query")
            need(type(query["ordinal"]) is int and query["ordinal"] == index and query["actual_source_invoked"] is True and equal(query["input"], source), "Actual ordered invocation/input differs")
            outcome(query["outcome"], need, label + "/query return")
            for key in ["before", "after"]: observed(query[key], need, label + "/" + key)
            if previous is not None: need(query["before"]["snapshot"] == previous, "Same actual cache lifetime must persist across query boundary")
            elif supplied["initial_cache"] is not None: need(query["before"]["snapshot"] == supplied["initial_cache"], "Literal independently supplied cache seed differs")
            previous = query["after"]["snapshot"]
            need(type(query["DoReport_after"]) is bool, "Actual returned DoReport required")
            for key in ["option1", "option2"]: need((query[key + "_after"] is None) if source[key] is None else type(query[key + "_after"]) is str, "Actual optional argument presence/owner differs")
            begin, end = query["diagnostic_begin"], query["diagnostic_end"]
            need(type(begin) is int and type(end) is int and begin == previous_diagnostic_end and begin <= end <= len(messages), "Actual contiguous diagnostic spans required")
            need(all(message["query_ordinal"] == index and message["kind"] in ["Warning", "Continue"] for message in messages[begin:end]), "Query diagnostic must bind actual retained query")
            previous_diagnostic_end = end; counts["actual_queries"] += 1
        need(previous_diagnostic_end == len(messages), "Unassociated later diagnostics cannot be silently dropped")
        observed(case["final"], need, label + "/final"); need(case["final"]["snapshot"] == previous, "Actual final cache retention differs")
        getters = case["getter_records_after_queries"]; need(type(getters) is list, "Actual full getter records required")
        need(all(type(owner["epJSON"].get(family, {})) is dict for family in FAMILIES), "Actual report-family object maps required")
        expected = [(family, index + 1) for family in FAMILIES for index in range(len(owner["epJSON"].get(family, {})))]
        need(len(getters) == len(expected), "Complete actual getter object ledger required")
        getter_ids = set(); getter_json_ordinals = set()
        for getter, (family, ordinal) in zip(getters, expected):
            keys(getter, ["family", "source_ordinal", "json_ordinal", "object_name", "NumAlphas", "NumNumbers", "Status", "alphas", "alpha_blanks", "alpha_field_names"], need, "actual getter")
            width = 3 if family in [FAMILIES[1], FAMILIES[4]] else 2
            need(getter["family"] == family and type(getter["source_ordinal"]) is int and getter["source_ordinal"] == ordinal and type(getter["json_ordinal"]) is int and 1 <= getter["json_ordinal"] <= len(owner["epJSON"][family]) and type(getter["object_name"]) is str and getter["object_name"] in owner["epJSON"][family], "Actual getter identity/source order differs")
            need((family, getter["object_name"]) not in getter_ids and (family, getter["json_ordinal"]) not in getter_json_ordinals, "Duplicate actual getter object/JSON ordinal cannot replace missing owner")
            getter_ids.add((family, getter["object_name"])); getter_json_ordinals.add((family, getter["json_ordinal"]))
            need(type(getter["NumAlphas"]) is int and 0 <= getter["NumAlphas"] <= width and type(getter["NumNumbers"]) is int and getter["NumNumbers"] == 0 and type(getter["Status"]) is int and getter["Status"] == 1, "Actual returned getter status/count differs")
            for key, kind in [("alphas", str), ("alpha_blanks", bool), ("alpha_field_names", str)]: need(type(getter[key]) is list and len(getter[key]) == width and all(type(item) is kind for item in getter[key]), "Full actual two/three-field getter owner required")
        counts["cases"] += 1; counts["actual_getter_records"] += len(getters); counts["actual_diagnostics"] += len(messages)
        counts["actual_preparation_diagnostics"] += sum(message["query_ordinal"] == 0 for message in messages)
        counts["actual_query_diagnostics"] += sum(message["query_ordinal"] != 0 for message in messages)
    need(counts["actual_queries"] == requested["queries"], "Complete actual264 calls required before release")
    return counts

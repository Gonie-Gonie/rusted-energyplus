"""Verify plan and complete indexed evidence, then commit and push the Scan milestone."""
import hashlib
import io
import json
import shutil
import subprocess
from pathlib import Path
ROOT = Path.cwd().resolve()
BASE = ROOT / '.runtime/porting/CTF-10'
OUT = ROOT / 'energyplus_porting_plan/evidence/CTF-10-report-scan-comparison'
def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(), 'size_bytes': len(data)}
def read(path): return json.loads(path.read_bytes())
docs = ['energyplus_porting_plan/' + name for name in ['plan.json', 'cards/CTF-10.md', 'CHECKLIST.md', 'energyplus_porting_checklist.html']]
validation_path = BASE / 'report-scan-comparison-plan-check-command-01/receipt.json'
validation = read(validation_path)
assert validation['exit_code'] == 0 and validation['source_bytes_match_before_and_after'] is True
assert validation['command'] == ['python', '-X', 'utf8', '-B', 'tools/porting/check_plan.py', '--check']
assert validation['source_snapshot']['sha256'] == '3f7582828a91af70bfca8aa3c0094cbaa5d8075ff5ee0a89c020d50fb48c3811'
files = [Path(__file__).resolve()]
for name in ['report-scan-comparison-finalize-command-01', 'report-scan-comparison-plan-check-command-01']:
    path = BASE / name / 'receipt.json'
    receipt = read(path)
    assert receipt['exit_code'] == 0 and receipt['source_snapshot'] == validation['source_snapshot'] and receipt['source_bytes_match_before_and_after'] is True
    files.extend([path, *[ROOT / receipt[key]['path'] for key in ['stdout', 'stderr', 'source_snapshot']]])
rows = []
for path in files:
    original = ref(path)
    stored = OUT / 'objects' / original['sha256']
    if not stored.exists(): shutil.copyfile(path, stored)
    assert stored.read_bytes() == path.read_bytes()
    rows.append({'original': original, 'stored': ref(stored)})
(OUT / 'validation.json').write_bytes((json.dumps({'schema': 'ctf10-scan-actual-plan-validation.v1',
    'actual_execution': ref(validation_path), 'selected_files': rows, 'validated_documents': [ref(ROOT / name) for name in docs],
    'gates_updated': False}, indent=2) + '\n').encode())
prefix = OUT.relative_to(ROOT).as_posix() + '/'
def staged(): return set(subprocess.check_output(['git', 'diff', '--cached', '--name-only', '--no-renames', '-z']).decode().split('\0')[:-1])
def allowed(name): return name in docs or name.startswith(prefix)
assert all(allowed(name) for name in staged())
subprocess.run(['git', 'diff', '--check'], check=True)
subprocess.run(['git', 'add', '--', *docs, OUT.relative_to(ROOT).as_posix()], check=True)
names = sorted(staged())
assert names and all(allowed(name) for name in names)
stream = io.BytesIO(subprocess.check_output(['git', 'cat-file', '--batch'], input=('\n'.join(':' + name for name in names) + '\n').encode()))
for name in names:
    header = stream.readline().decode().strip().split()
    assert len(header) == 3 and header[1] == 'blob'
    body = stream.read(int(header[2]))
    assert stream.read(1) == b'\n' and body == (ROOT / name).read_bytes()
assert stream.read() == b''
print('Verified complete indexed files:', len(names), flush=True)
subprocess.run(['git', 'commit', '--quiet', '-m', 'test(ctf): verify native report scan and getter equivalence'], check=True)
subprocess.run(['git', 'push', 'origin', 'main'], check=True)
assert not subprocess.check_output(['git', 'status', '--porcelain'])
assert subprocess.check_output(['git', 'rev-list', '--left-right', '--count', 'HEAD...origin/main']).decode().strip() == '0\t0'
print('Committed and pushed clean Scan comparison:', subprocess.check_output(['git', 'rev-parse', 'HEAD']).decode().strip(), flush=True)

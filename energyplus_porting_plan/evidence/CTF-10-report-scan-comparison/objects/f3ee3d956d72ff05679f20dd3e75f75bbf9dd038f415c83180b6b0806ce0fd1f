//! Direct report Scan API over independently projected input, never Native scan outputs.
#![recursion_limit = "256"]
#[path = "../../ep_runtime/examples/clk02_probe_support/digest.rs"]
mod digest;

use ep_compiler::compile_raw_model;
use ep_raw_model::{parse_epjson_str, parse_epjson_str_with_idf_order};
use ep_runtime::heat_balance::report_scan::{ReportScanDiagnostic, ReportScanState, scan_for_reports};
use serde_json::{Value, json};
use std::collections::BTreeSet;
use std::path::PathBuf;
type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;

fn require(ok: bool, message: &str) -> Result<()> {
    if ok { Ok(()) } else { Err(message.to_owned().into()) }
}
fn keys(value: &Value, names: &[&str]) -> Result<()> {
    require(value.as_object().is_some_and(|object| object.len() == names.len() && names.iter().all(|name| object.contains_key(*name))), "exact input-only object required")
}
fn text(value: &Value) -> Result<&str> { value.as_str().ok_or_else(|| "string input required".into()) }
fn boolean(value: &Value) -> Result<bool> { value.as_bool().ok_or_else(|| "Boolean input required".into()) }
fn rows(value: &Value) -> Result<&[Value]> { value.as_array().map(Vec::as_slice).ok_or_else(|| "array input required".into()) }
fn optional(value: &Value) -> Result<Option<String>> {
    if value.is_null() { Ok(None) } else { Ok(Some(text(value)?.to_owned())) }
}
fn cache(state: &ReportScanState) -> Value {
    json!({"GetReportInput":state.get_report_input,"SurfVert":state.surface_vertices,"SurfDet":state.surface_details,
        "SurfDetWVert":state.surface_details_with_vertices,"DXFReport":state.dxf,"DXFWFReport":state.dxf_wireframe,
        "VRMLReport":state.vrml,"CostInfo":state.cost_info,"ViewFactorInfo":state.view_factor_info,
        "Constructions":state.constructions,"Materials":state.materials,"LineRpt":state.lines,"VarDict":state.variable_dictionary,
        "EMSoutput":state.ems_output,"DXFOption1":state.dxf_options[0],"DXFOption2":state.dxf_options[1],
        "DXFWFOption1":state.dxf_wireframe_options[0],"DXFWFOption2":state.dxf_wireframe_options[1],
        "VRMLOption1":state.vrml_options[0],"VRMLOption2":state.vrml_options[1],"ViewRptOption1":state.view_factor_option,
        "LineRptOption1":state.line_option,"VarDictOption1":state.variable_dictionary_options[0],"VarDictOption2":state.variable_dictionary_options[1],
        "ShowDecayCurvesInEIO":state.show_decay_curves_in_eio,
        "OutputEMSActuatorAvailSmall":state.ems_actuator_availability[0],"OutputEMSActuatorAvailFull":state.ems_actuator_availability[1],
        "OutputEMSInternalVarsSmall":state.ems_internal_variable_availability[0],"OutputEMSInternalVarsFull":state.ems_internal_variable_availability[1],
        "OutputEMSErrors":state.ems_errors,"OutputFullEMSTrace":state.ems_full_trace})
}
fn seed(state: &mut ReportScanState, input: &Value) -> Result<()> {
    if input.is_null() { return Ok(()); }
    let owner = cache(state);
    require(input.as_object().is_some_and(|values| owner.as_object().is_some_and(|original| values.len() == original.len() && original.keys().all(|key| values.contains_key(key)))), "complete literal input cache seed required")?;
    macro_rules! b { ($source:literal,$target:expr) => { $target = boolean(&input[$source])?; }; }
    macro_rules! s { ($source:literal,$target:expr) => { $target = text(&input[$source])?.to_owned(); }; }
    b!("GetReportInput",state.get_report_input); b!("SurfVert",state.surface_vertices); b!("SurfDet",state.surface_details);
    b!("SurfDetWVert",state.surface_details_with_vertices); b!("DXFReport",state.dxf); b!("DXFWFReport",state.dxf_wireframe);
    b!("VRMLReport",state.vrml); b!("CostInfo",state.cost_info); b!("ViewFactorInfo",state.view_factor_info);
    b!("Constructions",state.constructions); b!("Materials",state.materials); b!("LineRpt",state.lines);
    b!("VarDict",state.variable_dictionary); b!("EMSoutput",state.ems_output); b!("ShowDecayCurvesInEIO",state.show_decay_curves_in_eio);
    b!("OutputEMSActuatorAvailSmall",state.ems_actuator_availability[0]); b!("OutputEMSActuatorAvailFull",state.ems_actuator_availability[1]);
    b!("OutputEMSInternalVarsSmall",state.ems_internal_variable_availability[0]); b!("OutputEMSInternalVarsFull",state.ems_internal_variable_availability[1]);
    b!("OutputEMSErrors",state.ems_errors); b!("OutputFullEMSTrace",state.ems_full_trace);
    s!("DXFOption1",state.dxf_options[0]); s!("DXFOption2",state.dxf_options[1]); s!("DXFWFOption1",state.dxf_wireframe_options[0]); s!("DXFWFOption2",state.dxf_wireframe_options[1]);
    s!("VRMLOption1",state.vrml_options[0]); s!("VRMLOption2",state.vrml_options[1]); s!("ViewRptOption1",state.view_factor_option);
    s!("LineRptOption1",state.line_option); s!("VarDictOption1",state.variable_dictionary_options[0]); s!("VarDictOption2",state.variable_dictionary_options[1]);
    Ok(())
}
fn case(row: &Value, unavailable: &mut usize) -> Result<Value> {
    keys(row,&["case_id","input_mode","input_only_epjson","idf_text","initial_cache","queries"])?;
    let mode = text(&row["input_mode"])?;
    require(["process_input_idf","process_input_epjson","direct_getter_epjson"].contains(&mode),"admitted input mode required")?;
    let epjson = serde_json::to_string(&row["input_only_epjson"])?;
    let raw = if mode == "process_input_idf" {
        parse_epjson_str_with_idf_order(&epjson,text(&row["idf_text"])?)?
    } else {
        require(row["idf_text"].is_null(),"non-IDF input must not carry an IDF overlay")?;
        parse_epjson_str(&epjson)?
    };
    let compiled = compile_raw_model(&raw);
    let Some(model) = compiled.model else {
        *unavailable += 1;
        return Ok(json!({"case_id":row["case_id"],"status":"typed-input-unavailable","actual_API_invocations":0,"queries":[],"compiler_diagnostics":format!("{:?}",compiled.diagnostics)}));
    };
    let mut owner = ReportScanState::default();
    seed(&mut owner,&row["initial_cache"])?;
    let inputs: Vec<Value> = model.report_inputs.objects.iter().map(|object| json!({
        "family":object.object_type.source_name(),"object_name":object.object_name,"alphas":object.alphas,
        "alpha_blanks":object.alpha_blank,"default_applied":object.default_applied,"NumAlphas":object.num_alphas,"isEpJSON":object.is_epjson})).collect();
    let mut queries = Vec::new();
    let mut messages = Vec::new();
    for (index,query) in rows(&row["queries"])?.iter().enumerate() {
        keys(query,&["report_name","report_key","option1","option2","DoReport_before"])?;
        let name = text(&query["report_name"])?;
        let key = optional(&query["report_key"])?;
        require(!name.eq_ignore_ascii_case("Surfaces") || key.is_some(),"unchecked Native missing key is outside paired scope")?;
        let _caller_report_before = boolean(&query["DoReport_before"])?;
        let mut first = optional(&query["option1"])?;
        let mut second = optional(&query["option2"])?;
        let before = cache(&owner);
        let diagnostic_begin = messages.len();
        let returned = scan_for_reports(&model.report_inputs,&mut owner,name,key.as_deref(),first.as_mut(),second.as_mut(),|diagnostic| {
            let (kind,argument) = match diagnostic { ReportScanDiagnostic::Warning(argument) => ("Warning",argument), ReportScanDiagnostic::Continue(argument) => ("Continue",argument) };
            messages.push(json!({"ordinal":messages.len()+1,"query_ordinal":index+1,"kind":kind,"argument":argument}));
        });
        let result = match returned {
            Ok(report) => json!({"status":"available","DoReport_after":report}),
            Err(reason) => { *unavailable += 1; json!({"status":"unavailable","reason":format!("{reason:?}"),"DoReport_after":null}) }
        };
        queries.push(json!({"ordinal":index+1,"actual_API_invoked":true,"input":query,"before":before,"after":cache(&owner),"result":result,
            "option1_after":first,"option2_after":second,"diagnostic_begin":diagnostic_begin,"diagnostic_end":messages.len()}));
    }
    Ok(json!({"case_id":row["case_id"],"input_mode":mode,"status":"typed-input-available","input_objects":inputs,
        "legacy_section_count":model.report_inputs.legacy_variable_dictionary_sections,"queries":queries,"diagnostics":messages,"final":cache(&owner),
        "actual_API_invocations":queries.len(),"Native_backend_equivalence_claimed":false}))
}
fn run() -> Result<i32> {
    let args: Vec<String> = std::env::args().collect();
    require(args.len()==3,"usage: ctf10_report_scan_unit_observer <input-only-projection.json> <actual-SHA256>")?;
    let path = PathBuf::from(&args[1]);
    let bytes = std::fs::read(&path)?;
    require(digest::sha256(&bytes)==args[2],"complete actual input-only projection SHA differs")?;
    let input: Value = serde_json::from_slice(&bytes)?;
    keys(&input,&["schema","expected_values_supplied","actual_input_authorities","cases"])?;
    require(input["schema"]=="ctf10-scan-unit-input-projection.v1" && input["expected_values_supplied"]==false,"input-only projection contract required")?;
    let mut ids = BTreeSet::new();
    let mut unavailable = 0;
    let mut results = Vec::new();
    for row in rows(&input["cases"])? {
        require(ids.insert(text(&row["case_id"])?.to_owned()),"duplicate declared case identity")?;
        results.push(case(row,&mut unavailable)?);
    }
    let actual_calls = results.iter().try_fold(0_usize, |total, row| -> Result<usize> {
        let count = usize::try_from(row["actual_API_invocations"].as_u64().ok_or("actual invocation count unavailable")?)?;
        total.checked_add(count).ok_or_else(|| "actual invocation count overflow".into())
    })?;
    println!("{}",json!({"schema":"ctf10-scan-unit-candidate-results.v1","actual_input_projection_SHA256":args[2],"actual_input_authorities":input["actual_input_authorities"],
        "cases":results,"actual_case_count":results.len(),"actual_API_invocations":actual_calls,"unavailable_count":unavailable,
        "expected_values_supplied":false,"numerical_or_discrete_PASS_claimed":false,"complete_CTF10_PASS_claimed":false,"gates_updated":false}));
    Ok(if unavailable==0 {0} else {2})
}
fn main() {
    match run() { Ok(code) => std::process::exit(code), Err(error) => { eprintln!("{error}"); std::process::exit(1); } }
}

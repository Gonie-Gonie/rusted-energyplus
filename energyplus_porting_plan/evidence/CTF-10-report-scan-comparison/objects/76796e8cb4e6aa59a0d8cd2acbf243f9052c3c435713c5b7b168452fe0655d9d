# Add one direct Scan TU linked to unchanged core General/InputProcessor; no derived Original TU.
if(NOT DEFINED CLK03_REPOSITORY_ROOT OR NOT DEFINED SCAN_UNIT_SOURCE_DIR)
  message(FATAL_ERROR "SCAN_UNIT requires explicit repository and reviewed helper-source directories")
endif()
include("${CLK03_REPOSITORY_ROOT}/.runtime/porting/ZON-05/native-helper-prep-01/zon05_reference.cmake")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_ctf10_scan_scheduled GLOBAL PROPERTY SCAN_UNIT_REFERENCE_SCHEDULED)
  if(NOT _ctf10_scan_scheduled)
    set_property(GLOBAL PROPERTY SCAN_UNIT_REFERENCE_SCHEDULED TRUE)
    function(ctf10_scan_add_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "SCAN_UNIT requires the verified unchanged Original GNU core archive")
      endif()
      get_target_property(_ctf10_scan_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_ctf10_scan_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      list(APPEND _ctf10_scan_defs ${_ctf10_scan_directory_defs})
      list(FILTER _ctf10_scan_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _ctf10_scan_defs)
      add_executable(ctf10_scan_unit_helper "${SCAN_UNIT_SOURCE_DIR}/scan_unit_helper.cpp")
      target_include_directories(ctf10_scan_unit_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${SCAN_UNIT_SOURCE_DIR}")
      target_compile_definitions(ctf10_scan_unit_helper PRIVATE ${_ctf10_scan_defs})
      target_link_libraries(ctf10_scan_unit_helper PRIVATE energypluslib project_options project_fp_options project_warnings)
      target_compile_features(ctf10_scan_unit_helper PRIVATE cxx_std_20)
      target_link_options(ctf10_scan_unit_helper PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/ctf10_scan_unit_helper.map")
    endfunction()
    cmake_language(DEFER CALL ctf10_scan_add_reference)
  endif()
endif()

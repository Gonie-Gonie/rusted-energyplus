"""Project authenticated parser input and literal request only, never Scan/getter answers."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path

PREP = Path(__file__).resolve().parent
COMMON_SHA = "85abffa8f5d78de6e67f10ca56987f82a39a8bffa9abcf7d383af86fafe0473e"
SHAPE_SHA = "54dd3cf3ec618e6ff2d82475fe0d7d85e8aca5f88a3b2d8384ee96fa078caafa"


def run(args):
    path = PREP / "scan_common.py"
    if hashlib.sha256(path.read_bytes()).hexdigest() != COMMON_SHA: raise ValueError("Reviewed common Source differs before import")
    spec = importlib.util.spec_from_file_location("scan_projection_common", path)
    c = importlib.util.module_from_spec(spec); spec.loader.exec_module(c)
    m = c.modules(); shape = c.boot("scan_projection_shape", "scan_shape.py", SHAPE_SHA)
    own_ref, manifest, own_paths = c.own(m, args, Path(__file__))
    refs, qa, execution, freeze, request, original = c.original(m, args, shape, own_ref, manifest)
    value = c.projection_value(m, refs, qa, freeze, request, original)
    output = m.contained(args.output_dir, existing=False)
    m.require(output.is_relative_to(m.BASE) and output != m.BASE and not output.exists(), "Fresh contained input projection directory required")
    output.mkdir(parents=True, exist_ok=False)
    archives = [m.archive(m.identity(path), output, index) for index, path in enumerate(own_paths)]
    c.recheck(m); projection_ref = m.emit(output / "input-projection.json", value); c.recheck(m)
    report = {"schema": "ctf10-scan-unit-input-projection-review.v1", "status": "pass-actual-input-only-projection", "projection": projection_ref,
        "reviewed_original_data": refs["original-data-review"], "reviewed_original_data_execution": refs["original-data-review-execution"], "projector_source_preparation": own_ref, "executed_projector_source": m.identity(__file__), "executed_projector_sources": archives,
        "projected_counts": {"cases": len(value["cases"]), "queries": sum(len(row["queries"]) for row in value["cases"])}, "Native_expected_endpoint_values_supplied": False, "Scan_or_getter_answers_projected": False, "whole_Init_or_production_PASS_claimed": False}
    m.emit(output / "projection-review.json", report); c.recheck(m)
    print(json.dumps(report, ensure_ascii=False, allow_nan=False, indent=2))
    return 0


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ["approved-source-sha256", "source-manifest", "original-data-review", "original-data-review-execution", "output-dir"]: parser.add_argument("--" + name, required=True)
    raise SystemExit(run(parser.parse_args()))

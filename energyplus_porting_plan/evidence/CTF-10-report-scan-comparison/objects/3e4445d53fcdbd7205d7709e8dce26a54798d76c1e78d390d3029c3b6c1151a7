// Genuine direct calls into unchanged Original General and InputProcessor providers.
#include "scan_unit_fields.hh"
#include <iostream>
#include <memory>
#include <set>
#include <typeinfo>

namespace ScanUnit {
template<class Function> json invoke(Function &&function)
{
    try { function(); return {{"status", "source_returned"}, {"exception_type", nullptr}, {"exception_message", nullptr}}; }
    catch (EnergyPlus::FatalError const &error) { return {{"status", "source_fatal"}, {"exception_type", typeid(error).name()}, {"exception_message", error.what()}}; }
    catch (std::exception const &error) { return {{"status", "source_exception"}, {"exception_type", typeid(error).name()}, {"exception_message", error.what()}}; }
    catch (...) { return {{"status", "source_nonstandard_exception"}, {"exception_type", nullptr}, {"exception_message", nullptr}}; }
}
struct Redirect {
    std::ostringstream out, err;
    std::streambuf *old_out = std::cout.rdbuf(out.rdbuf()), *old_err = std::cerr.rdbuf(err.rdbuf());
    ~Redirect() { std::cout.rdbuf(old_out); std::cerr.rdbuf(old_err); }
};
struct Factory {
    std::unique_ptr<EnergyPlus::EnergyPlusData> state;
    std::ostringstream *error_text = nullptr;
    json messages = json::array();
    std::size_t copy_failures = 0;
    std::size_t query_ordinal = 0;
    json observed()
    {
        try { return {{"available", true}, {"snapshot", cache(*state)}, {"backend_context", backend_context(*state)}, {"copy_failure", nullptr}}; }
        catch (std::exception const &error) { ++copy_failures; return {{"available", false}, {"snapshot", nullptr}, {"backend_context", nullptr}, {"copy_failure", error.what()}}; }
    }
    void sinks()
    {
        auto sink = std::make_unique<std::ostringstream>(); error_text = sink.get(); state->files.err_stream = std::move(sink);
        state->files.audit.open_as_stringstream();
        state->dataGlobal->errorCallback = [this](EnergyPlus::Error level, std::string const &argument) {
            std::string kind = "other";
            if (level == EnergyPlus::Error::Warning) { kind = "Warning"; }
            if (level == EnergyPlus::Error::Continue) { kind = "Continue"; }
            messages.push_back({{"ordinal", messages.size() + 1}, {"query_ordinal", query_ordinal},
                {"kind", kind}, {"actual_level", static_cast<int>(level)}, {"argument", argument}});
        };
    }
};
void direct_getter_input(EnergyPlus::EnergyPlusData &state, json input)
{
    // Deliberate InputProcessor getter-domain unit, not accepted processInput/ordinary input.
    require(input.is_object(), "Direct getter input must be a JSON object");
    for (auto const &[name, value] : input.items()) {
        bool known = name == "Report Variable Dictionary";
        for (auto const *family : families) { known = known || name == family; }
        require(known && value.is_object(), "Only the five report families and literal legacy section are direct unit inputs");
    }
    auto &ip = *state.dataInputProcessing->inputProcessor;
    json legacy = nullptr;
    if (input.contains("Report Variable Dictionary")) { legacy = input.at("Report Variable Dictionary"); input.erase("Report Variable Dictionary"); }
    ip.epJSON = std::move(input);
    state.dataGlobal->isEpJSON = true;
    ip.initializeMaps();
    int max_args = 0, max_alpha = 0, max_numeric = 0;
    ip.getMaxSchemaArgs(max_args, max_alpha, max_numeric);
    state.dataIPShortCut->cAlphaFieldNames.allocate(max_alpha);
    state.dataIPShortCut->cAlphaArgs.allocate(max_alpha);
    state.dataIPShortCut->lAlphaFieldBlanks.dimension(max_alpha, false);
    state.dataIPShortCut->cNumericFieldNames.allocate(max_numeric);
    state.dataIPShortCut->rNumericArgs.dimension(max_numeric, 0.0);
    state.dataIPShortCut->lNumericFieldBlanks.dimension(max_numeric, false);
    // Legacy name is queried by getNumSectionsFound only; it has no schema/getObjectItem entry.
    if (!legacy.is_null()) { ip.epJSON["Report Variable Dictionary"] = std::move(legacy); }
}
json run_case(json const &row, fs::path const &directory, bool &any_failure)
{
    keys(row, {"case_id", "input_mode", "input_file", "initial_cache", "queries"});
    std::string const mode = row.at("input_mode").get<std::string>();
    require(mode == "process_input_idf" || mode == "process_input_epjson" || mode == "direct_getter_epjson", "Unadmitted input mode");
    require(row.at("queries").is_array() && !row.at("queries").empty(), "Ordered queries required");
    // Admission happens before Native calls, including the unchecked absent-key boundary.
    for (auto const &query : row.at("queries")) {
        keys(query, {"report_name", "report_key", "option1", "option2", "DoReport_before"});
        require(query.at("report_name").is_string() && query.at("DoReport_before").is_boolean(), "Typed caller owners required");
        for (auto const *name : {"report_key", "option1", "option2"}) { require(query.at(name).is_null() || query.at(name).is_string(), "String optional argument required"); }
        std::string upper = query.at("report_name").get<std::string>();
        for (char &character : upper) { if (character >= 'a' && character <= 'z') { character = static_cast<char>(character - 'a' + 'A'); } }
        require(upper != "SURFACES" || !query.at("report_key").is_null(), "Missing Surfaces ReportKey remains outside Native invocation scope");
    }
    Redirect redirected;
    Factory factory;
    auto constructor = invoke([&] { factory.state = std::make_unique<EnergyPlus::EnergyPlusData>(); });
    json preparation = {{"status", "source_not_invoked_after_constructor_stop"}};
    json input_owner = nullptr, records = nullptr, queries = json::array(), final = nullptr;
    json getter_outcome = {{"status", "source_not_invoked_after_preparation_stop"}};
    bool stopped = constructor.at("status") != "source_returned";
    if (!stopped) {
        preparation = invoke([&] {
            factory.sinks();
            factory.state->init_constant_state(*factory.state);
            fs::path const input_path = fs::weakly_canonical(directory / row.at("input_file").get<std::string>());
            require(fs::is_regular_file(input_path), "Actual input file unavailable");
            if (mode == "direct_getter_epjson") { direct_getter_input(*factory.state, read_json(input_path)); }
            else {
                factory.state->dataGlobal->isEpJSON = mode == "process_input_epjson";
                factory.state->dataStrGlobals->inputFilePath = input_path;
                factory.state->dataInputProcessing->inputProcessor->processInput(*factory.state);
            }
            input_owner = {{"epJSON", factory.state->dataInputProcessing->inputProcessor->epJSON},
                {"isEpJSON", factory.state->dataGlobal->isEpJSON}, {"preserveIDFOrder", factory.state->dataGlobal->preserveIDFOrder},
                {"legacy_section_count", factory.state->dataInputProcessing->inputProcessor->getNumSectionsFound("Report Variable Dictionary")}};
            seed_cache(*factory.state, row.at("initial_cache"));
        });
        stopped = preparation.at("status") != "source_returned";
    }
    for (auto const &query : row.at("queries")) {
        ++factory.query_ordinal;
        if (stopped) {
            queries.push_back({{"ordinal", factory.query_ordinal}, {"actual_source_invoked", false}, {"input", query},
                {"outcome", {{"status", "source_not_invoked_after_actual_stop"}}}, {"before", nullptr}, {"after", nullptr}});
            continue;
        }
        auto before = factory.observed();
        std::string name = query.at("report_name").get<std::string>(), key, option1, option2;
        ObjexxFCL::Optional_string_const actual_key;
        ObjexxFCL::Optional_string actual_option1, actual_option2;
        if (!query.at("report_key").is_null()) { key = query.at("report_key").get<std::string>(); actual_key = ObjexxFCL::Optional_string_const(key); }
        if (!query.at("option1").is_null()) { option1 = query.at("option1").get<std::string>(); actual_option1 = ObjexxFCL::Optional_string(option1); }
        if (!query.at("option2").is_null()) { option2 = query.at("option2").get<std::string>(); actual_option2 = ObjexxFCL::Optional_string(option2); }
        bool report = query.at("DoReport_before").get<bool>();
        auto const diagnostic_begin = factory.messages.size();
        auto outcome = invoke([&] { EnergyPlus::General::ScanForReports(*factory.state, name, report, actual_key, actual_option1, actual_option2); });
        auto after = factory.observed();
        queries.push_back({{"ordinal", factory.query_ordinal}, {"actual_source_invoked", true}, {"input", query},
            {"outcome", outcome}, {"before", before}, {"after", after}, {"DoReport_after", report},
            {"option1_after", query.at("option1").is_null() ? json(nullptr) : json(option1)},
            {"option2_after", query.at("option2").is_null() ? json(nullptr) : json(option2)},
            {"diagnostic_begin", diagnostic_begin}, {"diagnostic_end", factory.messages.size()}});
        stopped = outcome.at("status") != "source_returned";
    }
    if (!stopped && factory.state) {
        getter_outcome = invoke([&] { records = getter_records(*factory.state); });
        if (getter_outcome.at("status") != "source_returned") { ++factory.copy_failures; }
        final = factory.observed();
    }
    bool const failed = stopped || factory.copy_failures != 0;
    any_failure = any_failure || failed;
    return {{"case_id", row.at("case_id")}, {"input_mode", mode}, {"constructor", constructor},
        {"preparation", preparation}, {"ordinary_processInput_admission_claimed", mode != "direct_getter_epjson" && preparation.at("status") == "source_returned"},
        {"input_owner", input_owner}, {"queries", queries}, {"getter_records_after_queries", records}, {"getter_copy_outcome", getter_outcome},
        {"final", final}, {"diagnostics", factory.messages}, {"error_stream", factory.error_text ? json(factory.error_text->str()) : json(nullptr)},
        {"audit_stream", factory.state ? json(factory.state->files.audit.get_output()) : json(nullptr)},
        {"captured_console_stdout", redirected.out.str()}, {"captured_console_stderr", redirected.err.str()},
        {"observer_copy_failures", factory.copy_failures},
        {"sqlite_backend_present", factory.state && factory.state->dataSQLiteProcedures->sqlite != nullptr},
        {"complete_report_or_fatal_backend_equivalence_claimed", false}};
}
} // namespace ScanUnit

int main(int argc, char const *argv[])
{
    try {
        ScanUnit::require(argc == 2, "Usage: ctf10_scan_unit_helper <input-only-request.json>");
        fs::path const request_path = fs::weakly_canonical(fs::path(argv[1]));
        auto request = ScanUnit::read_json(request_path);
        ScanUnit::keys(request, {"schema", "card", "expected_values_supplied", "cases"});
        ScanUnit::require(request.at("schema") == "ctf10-scan-unit-request.v1" && request.at("card") == "CTF-10" && request.at("expected_values_supplied") == false, "Unadmitted request");
        ScanUnit::require(request.at("cases").is_array() && !request.at("cases").empty(), "Declared input-only cases required");
        bool failure = false;
        ScanUnit::json cases = ScanUnit::json::array();
        std::set<std::string> ids;
        for (auto const &row : request.at("cases")) {
            ScanUnit::require(ids.insert(row.at("case_id").get<std::string>()).second, "Unique declared case identity required");
            cases.push_back(ScanUnit::run_case(row, request_path.parent_path(), failure));
        }
        std::cout << ScanUnit::json({{"schema", "ctf10-scan-unit-native-results.v1"}, {"cases", cases},
            {"requested_case_count", request.at("cases").size()}, {"recorded_case_count", cases.size()},
            {"actual_Original_body_modified", false}, {"expected_values_supplied", false},
            {"complete_CTF10_PASS_claimed", false}, {"production_or_whole_Init_equivalence_claimed", false}}).dump() << '\n';
        return failure ? 2 : 0;
    } catch (std::exception const &error) { std::cerr << error.what() << '\n'; return 2; }
}

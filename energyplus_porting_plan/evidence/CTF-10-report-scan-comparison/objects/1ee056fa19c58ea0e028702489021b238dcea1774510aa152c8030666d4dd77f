"""Factual complete Original Scan custody review; no Scan evaluator or Rust comparison."""
import argparse
import ast
import hashlib
import importlib.util
import json
from pathlib import Path

PREP = Path(__file__).resolve().parent
COMMON_SHA = "85abffa8f5d78de6e67f10ca56987f82a39a8bffa9abcf7d383af86fafe0473e"
SHAPE_SHA = "54dd3cf3ec618e6ff2d82475fe0d7d85e8aca5f88a3b2d8384ee96fa078caafa"


def run(args):
    path = PREP / "scan_common.py"
    if hashlib.sha256(path.read_bytes()).hexdigest() != COMMON_SHA: raise ValueError("Reviewed common Source differs before import")
    spec = importlib.util.spec_from_file_location("scan_review_common", path)
    c = importlib.util.module_from_spec(spec); spec.loader.exec_module(c)
    m = c.modules(); shape = c.boot("scan_review_shape", "scan_shape.py", SHAPE_SHA)
    own_ref, manifest, own_paths = c.own(m, args, Path(__file__))
    refs = {name: m.argument(getattr(args, name.replace("-", "_"))) for name in ["native-execution", "results", "freeze-receipt", "freeze-execution", "build-review", "build-review-execution"]}
    native = c.recorded(m, refs["native-execution"], allow_failure=True)
    freeze, request, preparation, frozen_command = c.frozen(m, refs["freeze-receipt"], refs["freeze-execution"], shape)
    c.before(m, frozen_command, native)
    build = m.load(refs["build-review"]); completed = c.recorded(m, refs["build-review-execution"])
    c.before(m, completed, native)
    m.require(build["schema"] == "ctf10-report-scan-unit-native-build.v1" and build["status"] == "pass-actual-one-TU-and-core-provider" and build["scientific_execution_certified"] is False and build["gates_updated"] is False, "Actual bounded build completion required")
    c.same(m, build["native_source_manifest"], c.NATIVE); c.same(m, build["actual_Root_source"], c.COMPLETION)
    completion = m.bind(c.COMPLETION)
    m.require(completed["command"] == ["python", "-X", "utf8", "-B", completion["path"]] and ast.literal_eval(m.contained(completed["stdout"]["path"]).read_text(encoding="utf-8").strip()) == m.bind(refs["build-review"]), "Actual reviewed Root completion CLI/reference stdout differs")
    for key, expected in [("native_tu_count", 1), ("prior_compile_rows", 727), ("current_compile_rows", 732), ("protected_ref_count", 56), ("core_present_count", 631)]: m.require(type(build[key]) is int and build[key] == expected, "Exact admitted actual build ledger differs")
    m.require([m.bind(row) for row in build["native_source_files"]] == [m.bind(row) for row in preparation["runtime_interfaces"]["native_source_files"]], "Exact compiled Native three-file authority differs")
    m.bind(build["actual_additive_recipe"])
    previous = frozen_command
    for key in ["configure_execution", "dry_build_execution", "compile_execution"]:
        command = c.recorded(m, build[key]); c.before(m, previous, command); c.before(m, command, completed); previous = command
    derived_command = c.recorded(m, build["derivation_execution"])
    c.before(m, previous, derived_command)
    c.before(m, derived_command, completed)
    preservation = m.load(build["preservation"])
    m.require(all(preservation[key] is True for key in ["all56_protected_and631_core_unchanged", "all24_absences_unchanged", "all727_prior_compile_rows_retained"]) and preservation["actual_compile_rows_before"] == 727 and preservation["actual_compile_rows_after"] == 732 and len(preservation["protected_refs"]) == 56 and len(preservation["present_objects"]) == 631 and len(preservation["absent_paths"]) == 24, "Actual before/after preservation ledger differs")
    for row in preservation["protected_refs"] + preservation["present_objects"]: c.full(m, row)
    for name in preservation["absent_paths"]: m.require(not m.contained(name, existing=False).exists(), "Protected absent Original/object was recreated")
    c.same(m, preservation["actual_Source_preparation"], c.NATIVE); c.same(m, preservation["actual_linked_original"], build["linked_original"])
    c.same(m, preservation["actual_additive_recipe"], build["actual_additive_recipe"])
    provider = m.load(build["link_provider_verification"])
    c.same(m, provider["link_map"], preservation["actual_link_map"]); c.same(m, provider["actual_Root_source"], c.COMPLETION)
    prefixes = {"EnergyPlus::General::ScanForReports(": "General.cc.obj", "EnergyPlus::InputProcessor::getObjectItem(": "InputProcessor.cc.obj", "EnergyPlus::InputProcessor::getNumObjectsFound(": "InputProcessor.cc.obj"}
    m.require(provider["schema"] == "ctf10-report-scan-unit-address-bound-providers.v1" and provider["unchanged_core_archive_providers_verified"] is True and set(provider["address_bound_selected_providers"]) == set(prefixes), "All actual core address-bound providers required")
    link_map = c.full(m, provider["link_map"])
    selected_symbols = {prefix: [] for prefix in prefixes}; actual_loads = []; core_loads = []; latest_text = None
    with m.contained(link_map["path"]).open("r", encoding="utf-8") as handle:
        for number, raw in enumerate(handle, 1):
            line = raw.rstrip()
            if line.startswith(" .text "): latest_text = {"line": number, "text": line}
            fields = line.strip().split(None, 1)
            for prefix in prefixes:
                if len(fields) == 2 and fields[1].startswith(prefix): selected_symbols[prefix].append({"symbol_line": number, "symbol": line, "section_provider": latest_text})
            if line.startswith("LOAD ") and "CMakeFiles/ctf10_scan_unit_helper.dir/" in line: actual_loads.append({"line": number, "text": line})
            if line.strip() == "LOAD Products/libenergypluslib.a": core_loads.append(number)
    for prefix, owner in prefixes.items():
        row = provider["address_bound_selected_providers"][prefix]; section = row["section_provider"]
        m.require(type(row["symbol_line"]) is int and type(section["line"]) is int and len(selected_symbols[prefix]) == 1 and selected_symbols[prefix][0] == row and "Products/libenergypluslib.a(" + owner + ")" in section["text"], "Actual unique core symbol/latest text provider literal lines differ")
        symbol_address = int(row["symbol"].split()[0], 16); fields = section["text"].split()
        m.require(int(fields[1], 16) <= symbol_address < int(fields[1], 16) + int(fields[2], 16), "Actual symbol address is outside its provider section")
    loads = provider["actual_target_object_loads"]
    m.require(type(loads) is list and len(loads) == 1 and actual_loads == loads and "scan_unit_helper.cpp.obj" in loads[0]["text"] and type(provider["core_archive_load_line"]) is int and core_loads == [provider["core_archive_load_line"]] and loads[0]["line"] < provider["core_archive_load_line"], "Actual unique single target LOAD must precede actual core archive")
    derivation = m.load(build["validated_derivative"])
    m.require(derivation["schema"] == "validated-debug-derivative.v1" and derivation["status"] == "pass-exact-retained-runtime-sections-and-directories" and all(derivation[key] is True for key in ["original_bytes_unchanged", "source_bytes_match_before_and_after", "accepted_derivative_bytes_unchanged"]) and derivation["original_before"] == derivation["original_after"] and derivation["accepted_derivative"] == derivation["observed_derivative"], "Actual retained debug derivative required")
    for key, source in [("executed_driver", c.DERIVE), ("executed_PE_reader", c.PE)]:
        row = derivation[key]; copied = m.bind(row["matching_archive"])
        m.require(row["historical_path"] == source["path"] and copied["sha256"] == m.bind(source)["sha256"] == row["sha256"], "Actual derivation Source archives differ")
    c.same(m, {"path": derivation["original_before"]["historical_path"], "sha256": derivation["original_before"]["sha256"]}, build["linked_original"])
    c.same(m, derivation["accepted_derivative"], build["helper_binary"])
    original_binary, helper_binary = c.full(m, build["linked_original"]), c.full(m, build["helper_binary"])
    reader = m.contained(m.bind(c.PE)["path"])
    spec = importlib.util.spec_from_file_location("scan_actual_pe", reader)
    pe = importlib.util.module_from_spec(spec); spec.loader.exec_module(pe)
    original_map, helper_map = pe.inspect(m.contained(original_binary["path"])), pe.inspect(m.contained(helper_binary["path"]))
    comparison = pe.compare(original_map, helper_map)
    m.require(comparison["status"] == "pass-exact-retained-runtime-sections-and-directories" and original_map == m.load(derivation["maps"]["original_before"]) == m.load(derivation["maps"]["original_after"]) and helper_map == m.load(derivation["maps"]["derived"]) and comparison == derivation["comparison"] == m.load(derivation["maps"]["comparison"]), "Independent actual both-PE/maps/runtime equality required")
    m.require(len(native["command"]) == 2 and m.contained(native["command"][0]) == m.contained(helper_binary["path"]) and m.contained(native["command"][1]) == m.contained(freeze["request"]["path"]), "Actual unchanged helper argc2/request differs")
    c.same(m, native["stdout"], refs["results"])
    failures = []; counts = None
    if type(native["exit_code"]) is not int or native["exit_code"] != 0 or native["launch_error"] is not None: failures.append("Actual Native command did not return0 without launch error")
    try:
        result = m.load(refs["results"]); counts = shape.review(result, request, m.require)
    except (ValueError, KeyError, TypeError, IndexError, UnicodeError, OSError) as error:
        failures.append(type(error).__name__ + ": " + str(error)); counts = None
    output = m.contained(args.output_dir, existing=False)
    m.require(output.is_relative_to(m.BASE) and output != m.BASE and not output.exists(), "Fresh contained factual QA output required")
    output.mkdir(parents=True, exist_ok=False)
    archives = [m.archive(m.identity(path), output, index) for index, path in enumerate(own_paths)]
    sources = [*preparation["runtime_interfaces"]["native_source_files"], c.WRITER, c.COMPLETION, c.PE, c.DERIVE]
    sources += [row for row in preparation["source_contexts"] if row["path"].startswith(".reference/")]
    source_archives = [m.archive(row, output, 100 + index) for index, row in enumerate(sources)]
    maps = {name: m.emit(output / (name + "-pe.json"), value) for name, value in [("original", original_map), ("helper", helper_map), ("comparison", comparison)]}
    released = not failures and counts is not None
    report = {"schema": "ctf10-scan-unit-independent-original-data-review.v1", "status": "pass-actual-Scan-custody-before-Rust" if released else "fail-actual-Scan-custody-unreleased", "Original_capture_custody_released": released,
        "reviewed_reader_source_preparation": own_ref, "executed_reader_source": m.identity(__file__), "executed_reader_sources": archives, "reviewed_source_archives": source_archives,
        "actual_native_execution": refs["native-execution"], "actual_native_results": refs["results"], "actual_packet_freeze": refs["freeze-receipt"], "actual_freeze_execution": refs["freeze-execution"], "actual_build_review": refs["build-review"], "actual_build_review_execution": refs["build-review-execution"], "actual_native_process_exit_code": native["exit_code"], "actual_native_launch_error": native["launch_error"],
        "actual_observation_counts": counts, "actual_counts_unknown": counts is None, "observation_integrity_failures": failures, "actual_both_PE_maps": maps,
        "getter_domain_is_ordinary_input_admission": False, "Native_backend_equivalence_claimed": False, "numerical_PASS_claimed": False, "complete_CTF10_PASS_claimed": False, "gates_updated": False}
    c.recheck(m); m.emit(output / "review.json", report); c.recheck(m)
    print(json.dumps(report, ensure_ascii=False, allow_nan=False, indent=2))
    return 0 if released else 1


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ["approved-source-sha256", "source-manifest", "native-execution", "results", "freeze-receipt", "freeze-execution", "build-review", "build-review-execution", "output-dir"]: parser.add_argument("--" + name, required=True)
    raise SystemExit(run(parser.parse_args()))

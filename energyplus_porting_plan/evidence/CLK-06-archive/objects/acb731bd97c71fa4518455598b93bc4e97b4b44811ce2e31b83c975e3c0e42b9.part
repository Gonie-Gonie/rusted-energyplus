"""Explicit actual CLK04 retirement and live retained-file guard; no proof rewrite."""
from __future__ import annotations
from datetime import datetime
import hashlib
import importlib.util
import json
from pathlib import Path
import stat

ROOT = Path(__file__).resolve().parents[4]
REGISTRY_SHA = '27523fa971b49989935ba11f51a3afa249c5ffd77b229c0a6314d5edf8c9e378'
PREVIOUS = {'path': '.runtime/porting/CLK-03/retirement-01/registry-retired.json',
            'sha256': 'bfcbcc4f3b466372c9258ee013cff19a352c2c899532f7e5a5d045ab28c38547'}
RETIREMENT = {'path': '.runtime/porting/CLK-04/retirement-01/retirement.json',
              'sha256': 'b9ca376626a2503ecf77ef21cc4394331563fc1d0628d32f1849abcb2f23038c'}
OUTER = {'path': '.runtime/porting/CLK-04/retirement-command-01/receipt.json',
         'sha256': '4937e664fd7c509f77a8302c70b30bdd4d7aaf5d60d4894c406f643839ee1a38'}
OLD_GUARD = {'path': '.runtime/porting/CLK-04/native-builder-prep-03/registry.py',
             'sha256': 'aecc19aa99b9bec2c2e78134449ac53e8df75085f96e0f23ab6132175f8287ae'}
ORIGINAL = {'historical_path': '.runtime/ep261-gcc13-o0/Products/clk04_reference_helper.exe',
            'sha256': 'a36a1cccc6e1ddf26f15c4ba79c84fd60936d0039af6c711ec8f233875df376f', 'size_bytes': 1297205477}
DERIVATIVE = {'path': '.runtime/porting/CLK-04/native-build-02/derivation/derived-helper.exe',
              'sha256': 'ee4d5e41080664e68ccfb17e4bf2457b62e40a2780ed5843b43fa971e57669cb', 'size_bytes': 150539944}


def require(ok, message):
    if not ok:
        raise ValueError(message)


def timestamp(value):
    stamp = datetime.fromisoformat(value)
    require(stamp.tzinfo is not None and stamp.utcoffset().total_seconds() == 0, 'Aware actual UTC required')
    return stamp


def exact(left, right):
    if type(left) is not type(right):
        return False
    if type(left) is dict:
        return set(left) == set(right) and all(exact(left[key], right[key]) for key in left)
    if type(left) is list:
        return len(left) == len(right) and all(exact(a, b) for a, b in zip(left, right))
    if type(left) is float:
        return left.hex() == right.hex()
    return left == right


def path(value):
    raw = Path(value)
    item = (raw if raw.is_absolute() else ROOT / raw).resolve()
    require(item.is_relative_to(ROOT) and item != ROOT, 'Artifact escapes repository')
    return item


def sha(value):
    with Path(value).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def verify(binding):
    raw = Path(binding['path'])
    raw = raw if raw.is_absolute() else ROOT / raw
    info = raw.lstat()
    require(stat.S_ISREG(info.st_mode) and not getattr(info, 'st_file_attributes', 0) & 0x400, 'Regular non-reparse retained artifact required')
    result = path(raw)
    require(sha(result) == binding['sha256'], 'Bound retained bytes differ')
    for key in ['bytes', 'size_bytes']:
        if key in binding:
            require(type(binding[key]) is int and result.stat().st_size == binding[key], 'Retained size differs')
    return result


def ref(value):
    p = path(value)
    return {'path': p.relative_to(ROOT).as_posix(), 'sha256': sha(p)}


def read(value):
    def pairs(rows):
        result = {}
        for key, item in rows:
            require(key not in result, 'Duplicate JSON key')
            result[key] = item
        return result
    def invalid(value):
        raise ValueError('Nonstandard JSON ' + value)
    return json.loads(Path(value).read_text(encoding='utf8'), object_pairs_hook=pairs, parse_constant=invalid)


def old_guard():
    source = verify(OLD_GUARD)
    spec = importlib.util.spec_from_file_location('clk05_authenticated_v3_guard', source)
    require(spec is not None and spec.loader is not None, 'Authenticated predecessor metadata guard unavailable')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def guard(registry_path, retirement_path, retirement_execution):
    registry_ref, retirement_ref, outer_ref = ref(registry_path), ref(retirement_path), ref(retirement_execution)
    require(registry_ref['sha256'] == REGISTRY_SHA and retirement_ref == RETIREMENT and outer_ref == OUTER, 'Explicit accepted actual version4 retirement bindings required')
    registry, retirement, outer = read(verify(registry_ref)), read(verify(retirement_ref)), read(verify(outer_ref))
    prior_module = old_guard()
    _, previous, old_observations = prior_module.guard(verify(PREVIOUS))
    require(registry['schema'] == 'native-retained-artifact-registry.v4'
            and registry['admitted_by_Root_after_actual_card_closure'] is True and registry['admitted_by_this_plan'] is False, 'Actual admitted version4 required')
    admitted_ref = registry['predecessor']
    admitted = read(verify(admitted_ref))
    require(admitted['predecessor'] == PREVIOUS and admitted['schema'] == registry['schema'], 'Actual version4 predecessor/admission chain differs')
    for key in ['legacy_products', 'legacy_product_count', 'protected_core_API_and_container']:
        require(exact(registry[key], previous[key]) and exact(registry[key], admitted[key]), 'Fourteen legacy/library bindings changed')
    require(len(registry['new_targets']) == 4 and exact(registry['new_targets'][:3], previous['new_targets'])
            and exact(admitted['new_targets'][:3], previous['new_targets']), 'Prior three tombstones changed')
    entry = registry['new_targets'][3]
    require(entry['target'] == 'clk04_reference_helper' and exact(entry['original_link'], ORIGINAL)
            and exact(entry['retained_derivative'], DERIVATIVE) and entry['status'] == 'retained-derivative-original-retired'
            and entry['actual_removal_observed'] is True and prior_module.actual_absence(ORIGINAL['historical_path']), 'Sole CLK04 genuine tombstone/actual absence required')
    verify(DERIVATIVE)
    removal = read(verify(entry['removal_receipt']))
    require(removal['schema'] == 'native-new-target-removal-receipt.v1' and removal['target'] == entry['target']
            and type(removal['actual_command_exit_code']) is int and removal['actual_command_exit_code'] == 0
            and removal['actual_original_absence'] is True and removal['actual_retirement_accepted'] is True
            and removal['spawn_error'] is None and removal['preservation_guard_failure'] is None
            and exact(removal['protected_before'], removal['protected_after'])
            and removal['historical_original'] == ORIGINAL and removal['realized_removed_bytes'] == ORIGINAL['size_bytes'], 'Actual successful precise removal0 required')
    for key in ['stdout', 'stderr', 'executed_script']:
        verify(removal[key])
    require(entry['unstripped_original']['full_debug_bytes_available'] is False
            and entry['unstripped_original']['full_debug_archive_created'] is False
            and entry['unstripped_original']['hash_or_map_recovers_discarded_debug_bytes'] is False
            and entry['unstripped_original']['deterministic_relink_recovery_claimed'] is False, 'No discarded-debug recovery or copy claim is admitted')
    require(retirement['schema'] == 'clk04-single-target-native-helper-retirement.v1'
            and retirement['status'] == 'pass-precise-removal-and-retained-artifact-guards'
            and retirement['retired_registry'] == registry_ref and retirement['admitted_registry'] == admitted_ref
            and retirement['actual_removal_receipts'] == [entry['removal_receipt']]
            and retirement['sole_exact_new_original_absent'] is True and retirement['realized_removed_bytes'] == ORIGINAL['size_bytes']
            and retirement['historical_native_exit_code'] == 0 and retirement['historical_wrapper_exit_code'] == 1
            and retirement['metadata_recovery_exit_code'] == 0 and retirement['historical_failed_wrapper_relabelled_zero'] is False
            and retirement['historical_proofs_or_launchers_rewritten'] is False, 'Honest native0/wrapper1/recovery0 retirement proof required')
    require(outer['schema'] == 'recorded-porting-command.v1' and type(outer['exit_code']) is int and outer['exit_code'] == 0
            and outer['launch_error'] is None and outer['source_bytes_match_before_and_after'] is True, 'Actual guarded retirement recorder0 required')
    for key in ['stdout', 'stderr', 'source_snapshot']:
        verify(outer[key])
    require(exact(read(verify(outer['stdout'])), retirement)
            and timestamp(outer['started_utc']) <= timestamp(retirement['started_utc'])
            <= timestamp(retirement['completed_utc']) <= timestamp(outer['finished_utc']), 'Retirement full JSON stdout/UTC differs')
    live = old_observations['live_retained_bindings'] + [{'path': DERIVATIVE['path'], 'sha256': DERIVATIVE['sha256']}]
    require(len(live) == len({row['path'] for row in live}) == 20, 'Actual twenty protected/retained files required')
    protected = retirement['protected_and_retained_after']
    require(len(protected) == 20 and {row['binary']['path'] for row in protected} == {row['path'] for row in live}, 'Actual protected20 result identities differ')
    for row in protected:
        verify({**row['binary'], 'size_bytes': row['size_bytes']})
    for binding in [registry['actual_card_closure'], registry['admission_plan'], *retirement['source_review'].values()]:
        verify(binding)
    # Closure after-bindings are historical; CLK05 may legitimately edit plan.
    return registry_ref, registry, {'protected_and_retained_count': 20, 'live_retained_bindings': live,
        'actual_retirement': retirement_ref, 'actual_retirement_execution': outer_ref,
        'actual_removal_receipts': [entry['removal_receipt']], 'prior_retirement_registry': PREVIOUS}

                    //         Set possible missing values
                    if (ETHoriz < 0.0) {
                        ETHoriz = 9999.0;
                    }
                    if (ETDirect < 0.0) {
                        ETDirect = 9999.0;
                    }
                    if (IRHoriz <= 0.0) {
                        IRHoriz = 9999.0;
                    }

 from common import (v, ROOT, require, exact, read, ref, binding, recorded, archives,
     script, argument, path_of, timestamp)
 
-COUNTS = {'setup_cases': 3, 'weather_sequences': 36, 'GetNextEnvironment': 36,
-    'InitializeWeather': 550, 'weather_operations': 586, 'total_operations': 589}
+DECISION = {'path': '.runtime/porting/CLK-06/root-preoutput-decisions-01/decision.json',
+    'sha256': 'b12d5d633cf50d669054ce4c37dc231f8ecf3192971f1b7e12ae61d40c2b0a54'}
+
+
+def requested(request):
+    direct = len(request['emissivity_cases'])
+    counts = {'setup_cases': len(request['setup_cases']), 'emissivity_cases': direct,
+        'weather_sequences': len(request['weather_sequences']), 'CalcSkyEmissivity': direct,
+        **{kind: 0 for kind in ['GetNextEnvironment','InitializeWeather','SetCurrentWeather','calcSky']},
+        'weather_operations': 0, 'total_operations': len(request['setup_cases']) + direct}
+    for sequence in request['weather_sequences']:
+        for operation in sequence['operations']:
+            require(operation['kind'] in ['GetNextEnvironment','InitializeWeather','SetCurrentWeather','calcSky'],
+                'Closed source operation kind required')
+            for key in [operation['kind'], 'weather_operations','total_operations']:
+                counts[key] += 1
+    require(exact(request['requested_counts'], counts), 'Derived request cardinality differs')
+    return counts
 
 

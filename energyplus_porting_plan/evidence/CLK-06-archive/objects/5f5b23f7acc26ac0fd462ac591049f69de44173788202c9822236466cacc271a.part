+def structural_surface_id_unavailability(report, facts, executed, main_owner):
+    folder = Path(main_owner).parent.as_posix(); observation_ref = executed[folder + '/observations.py']
+    observation_source = m.check(observation_ref).read_text(encoding='utf8')
+    physical_guard = "if kind in KINDS[:5]:\n            require(surface is None, 'Non-surface event cannot invent surface identity')\n        else:\n            require(type(surface) is int and surface in surfaces and observed['caller_origin_inferred_from_TLS'] is False,\n                'Actual surface and explicit origin required')"
+    exact_events = "check.exact_value(sky_traces['Full']['events'], sky_traces['Summary']['events'], label + '/Full_Summary/all_actual_transport_occurrences')"
+    m.need(observation_source.count(physical_guard) == 1
+        and m.check(executed[main_owner]).read_text(encoding='utf8').count(exact_events) == 1,
+        'Actual archived comparer must require None only for non-surface kinds and real compiled surface IDs for physical kinds')
+    full = {row['case_id']: row for row in report['transport_observations'] if row['trace_level'] == 'Full'}
+    m.need(set(full) == set(CASES), 'Exact three Full kind ledgers required for structural unavailable IDs')
+    expected = {case: sum(full[case]['actual_event_counts'][kind] for kind in KINDS[:5]) for case in CASES}
+    indices = {case: set() for case in CASES}
+    for row in report['comparison']['unavailable_paths']:
+        if not row['required']: continue
+        parts = row['location'].split('/')
+        m.need(len(parts) == 5 and parts[0] in indices and parts[1:3] == ['Full_Summary', 'all_actual_transport_occurrences']
+            and parts[4] == 'surface_id' and parts[3].isascii() and parts[3].isdecimal()
+            and str(int(parts[3])) == parts[3] and row['actual_available'] is row['original_available'] is False
+            and row['counted_as_PASS'] is False, 'Any other required-unavailable operand must fail factual QA')
+        case, index = parts[0], int(parts[3])
+        m.need(index < full[case]['total_event_count'] and index not in indices[case],
+            'Structural unavailable surface ID must use a unique actual bounded event index')
+        indices[case].add(index)
+    actual = {case: len(indices[case]) for case in CASES}
+    m.need(m.exact(actual, expected) and sum(actual.values()) == facts['required_both_null_unavailable_count'],
+        'Structural unavailable surface-ID count must equal exactly the first-five non-surface kind ledgers')
+    return {'structural_non_surface_id_unavailable_counts': actual,
+        'structural_non_surface_id_source_guards': [observation_ref, executed[main_owner]],
+        'generic_required_flag_means_physical_surface_value_required': False,
+        'every_other_required_unavailable_rejected': True, 'structural_unavailable_counted_as_PASS': False}
 
 

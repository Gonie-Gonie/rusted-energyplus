+def compiled_origin_policy(available, checked):
+    text = {}
+    for row in SOURCE_ORIGIN_POLICY['source_bindings']:
+        owner = row['path']
+        require(owner in available and available[owner]['sha256'] == row['sha256'],
+            'Compiled source for exact origin/config policy differs: ' + owner)
+        text[owner] = checked.check(available[owner]).read_text(encoding='utf8')
+    markers = {
+        'crates/ep_run/src/pipeline.rs': ['HeatBalanceSimulationOptions::hourly_samples(sample_count)',
+            'DirectZonePurchasedAirCoupledOptions::hourly_samples(sample_count)'],

+        'crates/ep_runtime/src/heat_balance/weather_driver.rs': ['owned: Some(series.current_for(record_index, zone_timestep)?)']}
+    require(all(token in text[owner] for owner, tokens in markers.items() for token in tokens),
+        'Authenticated compiled A/B routing, config inheritance, early returns or propagated caller differs')
+    return SOURCE_ORIGIN_POLICY['cases']
 
 

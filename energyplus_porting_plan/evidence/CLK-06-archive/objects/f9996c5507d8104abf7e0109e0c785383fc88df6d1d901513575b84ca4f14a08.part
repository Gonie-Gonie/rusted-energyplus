# Add one CLK05 caller unit, inheriting the authenticated 658 registrations.
if(NOT DEFINED CLK03_REPOSITORY_ROOT)
  message(FATAL_ERROR "CLK05 helper requires explicit repository root")
endif()
include("${CLK03_REPOSITORY_ROOT}/.runtime/porting/CLK-04/native-builder-prep-03/clk04_reference.cmake")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_clk05_scheduled GLOBAL PROPERTY CLK05_REFERENCE_SCHEDULED)
  if(NOT _clk05_scheduled)
    set_property(GLOBAL PROPERTY CLK05_REFERENCE_SCHEDULED TRUE)
    function(clk05_add_original_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "CLK05 requires unchanged genuine GNU core")
      endif()
      get_target_property(_clk05_target_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_clk05_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      set(_clk05_defs ${_clk05_target_defs} ${_clk05_directory_defs})
      list(FILTER _clk05_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _clk05_defs)
      add_executable(clk05_reference_helper "${CLK03_REPOSITORY_ROOT}/.runtime/porting/CLK-05/native-prep-01/clk05_reference_helper.cpp")
      target_include_directories(clk05_reference_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${CLK03_REPOSITORY_ROOT}/tools/porting")
      target_compile_definitions(clk05_reference_helper PRIVATE ${_clk05_defs})
      target_link_libraries(clk05_reference_helper PRIVATE energypluslib project_options project_fp_options project_warnings bcrypt)
      target_compile_features(clk05_reference_helper PRIVATE cxx_std_20)
    endfunction()
    cmake_language(DEFER CALL clk05_add_original_reference)
  endif()
endif()

def compiled_origin_policy(available, checked):
    text = {}
    for row in SOURCE_ORIGIN_POLICY['source_bindings']:
        owner = row['path']
        require(owner in available and available[owner]['sha256'] == row['sha256'],
            'Compiled source for exact origin/config policy differs: ' + owner)
        text[owner] = checked.check(available[owner]).read_text(encoding='utf8')
    markers = {
        'crates/ep_run/src/pipeline.rs': ['HeatBalanceSimulationOptions::hourly_samples(sample_count)',
            'DirectZonePurchasedAirCoupledOptions::hourly_samples(sample_count)'],
        'crates/ep_runtime/src/heat_balance/state.rs': ['zone_air_algorithm: HeatBalanceZoneAirAlgorithm::SimplifiedAnalytical,'],
        'crates/ep_runtime/src/runtime.rs': ['options.zone_air_algorithm.runtime_config()'],
        'crates/ep_runtime/src/diagnostic_probes/heat_balance.rs': ['_ => diagnostic_runtime_config(self)',
            '_ => selector,', 'use_cached_exterior_report_terms: uses_cached_exterior_report_terms(feature)',
            'A::SimplifiedAnalytical\n            | A::EnergyPlusAnalyticalProbe', 'uses_quick_outside_conduction(selector)\n        && !matches!('],
        'crates/ep_runtime/src/heat_balance/algorithm.rs': ['use_quick_outside_conduction: true,',
            'use_cached_exterior_report_terms: true,', 'CompatibilityHeatBalanceAlgorithm::SourceOrder1ZoneOpaqueCompat.runtime_config();'],
        'crates/ep_runtime/src/ideal_loads/coupled_runtime.rs': ['let runtime_config = direct_zone_purchased_air_fixed_step_runtime_config();'],
        'crates/ep_runtime/src/heat_balance/surface_balance.rs': ['if runtime_config.timestep.use_quick_outside_conduction {\n        return surface_state.outside_face_temperature_c;',
            'if heat_balance_uses_cached_exterior_report_terms(runtime_config) {\n        return surface_state.outside_report_terms;',
            'runtime_config.use_cached_exterior_report_terms'],
        'crates/ep_runtime/src/heat_balance/weather_driver.rs': ['owned: Some(series.current_for(record_index, zone_timestep)?)']}
    require(all(token in text[owner] for owner, tokens in markers.items() for token in tokens),
        'Authenticated compiled A/B routing, config inheritance, early returns or propagated caller differs')
    return SOURCE_ORIGIN_POLICY['cases']


def load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    require(spec is not None and spec.loader is not None, 'Authenticated source loader unavailable')
    module = importlib.util.module_from_spec(spec); sys.modules[name] = module
    spec.loader.exec_module(module); return module


def sources():
    return [*[HERE / name for name in OWN_NAMES], *[UNIT / name for name in UNIT_NAMES],
        *[WORKFLOW / name for name in WORKFLOW_NAMES], ROOT / 'tools/porting/geo03_provenance.py']



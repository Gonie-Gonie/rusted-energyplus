    return {'numeric_profiles': tolerances['numeric_profiles'], 'numeric_rows': tolerances['rows'],
        'numeric_criterion': tolerances['criterion'], 'source_selection': native['source_selection'],
        'native_observation_policy': native['native_observation_policy'],
        'transport_mask': {'cases': ['A-24H', 'A-72H', 'B-BOTH-24H'], 'trace_levels': ['Full', 'Summary'],
            'native_direct_calls': {'GetNextEnvironment': 3, 'InitializeWeather': 480, 'SetCurrentWeather': 480, 'total': 963},
            'full_history': 'All direct before/after and nested day-read snapshots; full17 owned copy retained; sky4 generation paired',
            'native_operand': 'Actual same-civil-day/hour/timestep native Current.after selected_today_sky_slot, sky4 only',
            'array_DTO_path_mapping': 'native ROOT to CLI ROOT identity; storage owner state.weather',
            'all_eight_actual_kind_ledgers_required': True, 'both_Full_and_Summary_required': True,
            'source_stamp': 'Actual Current completion count carried with context; repeated seed/consumer retained',
            'owned_value_copies': 'SkyTemp/HorizIRSky use frozen same_owner_transport_copy bit/class profile',
            'cloud_copy': 'Both cloud drivers use frozen exact cloud profile',
            'physical_origins': ['surface_solve', 'report_outside_face_recomputation'],

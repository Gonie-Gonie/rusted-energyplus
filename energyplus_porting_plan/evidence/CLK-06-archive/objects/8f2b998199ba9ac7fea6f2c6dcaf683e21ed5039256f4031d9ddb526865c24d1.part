+def json_line(value):
+    def pairs(rows):
+        result = {}
+        for key, item in rows:
+            require(key not in result, 'Duplicate stdout JSON key'); result[key] = item
+        return result
+    return __import__('json').loads(value, object_pairs_hook=pairs,
+        parse_constant=lambda token: (_ for _ in ()).throw(ValueError('Nonfinite stdout token: ' + token)))
 
 

+def actual_run(item, case, level, evidence, freeze_finish):
+    bound, h = evidence['checked'], evidence['helper']; completed = evidence['completed']
+    finish = evidence['runner'].check_run(item, case, level, completed, evidence['plan_finish'], bound)
+    receipt = read(bound.check(item['command_receipt'])); start, _ = v.execution_interval(receipt, bound)
+    require(item['spawn_error'] is None and item['actual_recorder_exit_code'] == 0
+        and item['external_input_context_preserved'] is True and item['terminated_CLI_process_internal_ENV_observed'] is False,
+        'Actual successful child and honest external ENV context required')
+    for key in ['constructed_inherited_child_ENV', 'actual_parent_ENV_before_child', 'actual_parent_ENV_after_child',
+        'prospective_inherited_child_ENV_after_child']:
+        h.require_environment(item[key], case['captured_environment_inputs'])
+    require(evidence['matrix_start'] <= timestamp(item['started_utc']) <= start <= finish
+        <= timestamp(item['finished_utc']) <= evidence['matrix_finish'] and freeze_finish <= start,
+        'Actual child lies outside matrix or precedes frozen selection')
+    output = path_of(item['output_directory'])
+    command = [str(bound.check(completed['build']['binary'])), 'run', str(bound.check(case['input'])), '--weather',
+        str(bound.check(case['weather'])), '--output-dir', str(output), '--mode', 'compatibility', '--partial', 'deny',
+        '--trace-level', level.lower(), '--porting-scope', case['scope'].lower()]
+    require(exact(item['command'], command) and exact(receipt['command'], command), 'Actual exact six-run argv differs')
+    return output

+def input_context(snapshot, supplied):
+    m.need(m.exact(snapshot['clk06_observation']['caller_controls'], supplied['solar_controls']), 'Four declared controls not stored before read')
+    for group, fields in supplied.get('caller_owned_seed', {}).items():
+        for name, value in fields.items():
+            stored = snapshot[group][name]
+            m.need(stored['value_bits'] == value['bits'] if type(value) is dict else m.exact(stored, value), 'Literal caller-owned seed transport differs')
+    if 'stored_interpolation_override' in supplied:
+        m.need([row['value_bits'] for row in snapshot['Interpolation']] == [row['bits'] for row in supplied['stored_interpolation_override']],
+               'Literal stored linear interpolation override transport differs')
+
+
+def default_environment(snapshot, selected):
+    observed = snapshot['clk06_observation']['actual_sky_environment']
+    role = observed['selected_environment' if selected else 'resolved_candidate_before_GetNext']
+    m.need(observed['NumWPSkyTemperatures'] == 0 and role is not None, 'Genuine admitted default environment unavailable')
+    value = role['value']
+    m.need(type(value['WP_Type1']) is type(value['skyTempModel']) is int and value['WP_Type1'] == value['skyTempModel'] == 0
+           and value['UseWeatherFileHorizontalIR'] is True, 'Actual prepared/selected model differs from admitted ClarkAllen/useIRtrue')
+    if selected:
+        m.need(role['index'] == observed['Envrn'] > 0, 'Actual selected environment identity differs')
+

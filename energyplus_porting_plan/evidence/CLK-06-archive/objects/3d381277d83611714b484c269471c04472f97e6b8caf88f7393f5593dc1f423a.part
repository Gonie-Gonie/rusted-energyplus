+           and invoked is (status != 'not-invoked-after-prior-source-outcome')
+           and outcome['source_fatal'] is (True if status == 'source_fatal' else False if invoked else None),
+           'Actual invocation/fatal/skipped outcome types differ')
     statuses[status] += 1

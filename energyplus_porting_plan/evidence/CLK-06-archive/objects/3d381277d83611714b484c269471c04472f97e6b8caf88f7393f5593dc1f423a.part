+def identity(actual, declared, bytes_checked=True):
+    m.need(type(actual) is dict and type(declared) is dict and m.path(actual['path']) == m.path(declared['path'])
+           and actual['sha256'] == declared['sha256'], 'Contained path/hash binding differs')
+    for key in ['bytes', 'size_bytes']:
+        if key in actual:
+            m.need(type(actual[key]) is int, 'Actual optional size must be integer')
+        if key in declared:
+            m.need(type(declared[key]) is int, 'Declared optional size must be integer')
+    if bytes_checked:
+        m.verify(actual)
+        m.verify(declared)
+    else:
+        info = m.path(actual['path']).lstat()
+        m.need(stat.S_ISREG(info.st_mode) and not getattr(info, 'st_file_attributes', 0) & 0x400,
+               'Already PE-verified actual binary must remain a regular non-reparse file')
+        for owner in [actual, declared]:
+            for key in ['bytes', 'size_bytes']:
+                if key in owner:
+                    m.need(owner[key] == info.st_size, 'Already PE-verified actual binary size differs')
+
+
+def result_ref(value, expected, digest=None):
+    # Only the exact wrapper/result pair may exceed bounded metadata limits.
+    item = m.path(value)
+    info = item.lstat()
+    m.need(item == expected and stat.S_ISREG(info.st_mode) and not getattr(info, 'st_file_attributes', 0) & 0x400,
+           'Exact regular preserved Original wrapper/result required')
+    with item.open('rb') as stream:
+        actual = hashlib.file_digest(stream, 'sha256').hexdigest()
+    m.need(digest is None or actual == digest, 'Preserved Original bytes differ')
+    m.need(item not in LARGE_SEEN or LARGE_SEEN[item] == actual, 'Previously consumed Original bytes changed')
+    LARGE_SEEN[item] = actual
+    return {'path': item.relative_to(ROOT).as_posix(), 'sha256': actual}
+
+
+def result_read(binding, expected):
+    item = m.path(binding['path'])
+    info = item.lstat()
+    m.need(type(binding['sha256']) is str, 'Preserved result hash must be typed')
+    result_ref(item, expected, binding['sha256'])
+    for key in ['bytes', 'size_bytes']:
+        if key in binding:
+            m.need(type(binding[key]) is int and info.st_size == binding[key], 'Preserved result size differs')
+    def pairs(rows):
+        value = {}
+        for key, child in rows:
+            m.need(key not in value, 'Duplicate result JSON key')
+            value[key] = child
+        return value
+    with item.open(encoding='utf8') as stream:
+        return json.load(stream, object_pairs_hook=pairs,
+            parse_constant=lambda token: (_ for _ in ()).throw(ValueError('Nonstandard result JSON ' + token)))
+
+

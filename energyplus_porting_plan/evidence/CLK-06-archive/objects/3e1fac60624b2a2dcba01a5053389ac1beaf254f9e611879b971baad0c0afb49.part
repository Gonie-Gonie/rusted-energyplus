"""Draft input-only six-artifact freezer; Root executes only after independent source review."""
from __future__ import annotations
import argparse
import hashlib
import importlib.util
from pathlib import Path
import sys

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[3]
COMMON_SHA = '3c96ab0f566058ec3f0abd8658131592ec654c73cfd1990d1ece3f5f8b2ce1dd'
if hashlib.sha256((HERE / 'common.py').read_bytes()).hexdigest() != COMMON_SHA:
    raise ValueError('Held metadata utility changed before import')
from common import BASE, PIN, HISTORICAL_CONTROL_READER, exact, finish_guards, instant, path, put, put_json, read, recorded, ref, require, review_execution, unchanged, utc, verify

SCOPE = {'path': '.runtime/porting/CLK-06/scope-amendment-01/amendment.json',
         'sha256': '6d5a2816a14c2441c38140bed4b7d0a28cd358c6b940e7505a240f78a39f6184'}
SCOPE_EXECUTION = {'path': '.runtime/porting/CLK-06/scope-amendment-command-01/receipt.json',
                   'sha256': 'e0f6d14395694dc380de3852d716d6bae6f867e7b3104cb90785fe5310eea86b'}
V5_SHA = 'db48de3548d450a8402b0cf6412ffa0189fbe289f433e244b67d4b456d5798b6'
V4_SHA = '27523fa971b49989935ba11f51a3afa249c5ffd77b229c0a6314d5edf8c9e378'
DEPS = ['tools/porting/clk03_reference_helper.cpp', 'tools/porting/clk03_reference_fields.hh',
        'tools/porting/clk02_reference_fields.hh',
        '.runtime/porting/CLK-04/native-prep-03/clk04_reference_fields.hh']
TRANSPORT = {'path': '.runtime/porting/CLK-06/transport-observation-design-prep-01/manifest.json',
             'sha256': 'd05b4daf2d06fdf47e275632271d7deb0b0c7888c23900c80e3346c6aec3806c'}
GATES = ['scope_review', 'unit_gate', 'integration_gate', 'production_gate']


def source_review(args, started):
    review_ref = ref(args.source_review)
    review = read(verify(review_ref))
    require(review['schema'] == 'clk06-independent-preexecution-source-review.v1'
            and review['status'] == 'pass-source-input-policy-before-freeze'
            and review['scientific_execution_performed'] is False, 'Independent source/input review required')
    execution = review_execution(args.source_review_execution, review, started)
    catalogue = path(args.catalogue_directory)
    native = path(args.native_directory)
    require(catalogue.is_relative_to(BASE) and native.is_relative_to(BASE), 'Contained CLK06 source directories required')
    expected = [HERE / name for name in ['common.py', 'packet_policy.py', 'freeze_packet.py']]
    expected += [catalogue / name for name in ['catalog.py', 'write_inputs.py']]
    expected += [native / name for name in ['clk06_reference_helper.cpp', 'clk06_reference_fields.hh', 'clk06_reference_admission.hh']]
    expected += [ROOT / name for name in DEPS]
    wanted = {item.relative_to(ROOT).as_posix() for item in expected}
    rows = review['reviewed_sources']
    require(type(rows) is list and len(rows) == len(wanted)
            and {row['historical_path'] for row in rows} == wanted, 'Exact declared12 helper/writer/dependency sources required')
    unchanged(rows)
    for name, value in [('catalogue_manifest', args.catalogue_manifest), ('native_source_manifest', args.native_source_manifest)]:
        require(exact(review[name], ref(value)), 'Independent source review must bind actual source manifest: ' + name)
    catalogue_manifest, native_manifest = read(verify(ref(args.catalogue_manifest))), read(verify(ref(args.native_source_manifest)))
    require(catalogue_manifest['schema'] == 'clk06-input-catalogue-source-preparation.v1'
            and native_manifest['schema'] == 'clk06-native-helper-source-preparation.v1', 'Typed held source manifests required')
    for declared, expected_group in [(catalogue_manifest['own_sources'], expected[3:5]),
                                    (native_manifest['own_sources'], expected[5:8]),
                                    (native_manifest['included_sources'], expected[8:])]:
        require(len(declared) == len(expected_group)
                and {verify(row) for row in declared} == set(expected_group), 'Actual source manifest inventory differs')
    require(exact(review['reviewed_transport_source_inventory'], TRANSPORT), 'Independent review must bind held transport roles')
    return {'review': review_ref, 'execution': execution}, rows


def scope_amendment(args, started):
    require(ref(args.scope_amendment) == SCOPE and ref(args.scope_amendment_execution) == SCOPE_EXECUTION,
            'Explicit authentic scope amendment0 pair required')
    amendment = read(verify(SCOPE))
    _, command = recorded(args.scope_amendment_execution, amendment, started)
    require(amendment['schema'] == 'clk06-metadata-scope-amendment.v1'
            and amendment['status'] == 'scope-only-amended-four-gates-pending'
            and amendment['other_task_objects_unchanged'] == 63
            and amendment['only_CLK06_semantic_entry_and_card_written'] is True
            and amendment['all_four_CLK06_gates_remain_pending'] is True
            and all(amendment[key] is False for key in ['canonical_gates_updated',
                'actual_new_packet_projection_or_precision_freeze_claimed', 'input_scope_expanded',
                'scientific_execution_performed', 'numerical_PASS_claimed']), 'Actual scope-only amendment boundary differs')
    rows = amendment['archived_deltas']
    wanted = {'energyplus_porting_plan/plan.json', 'energyplus_porting_plan/cards/CLK-06.md'}
    require(len(rows) == len(amendment['after']) == 2 and {row['historical_path'] for row in rows} == wanted
            and {row['path'] for row in amendment['after']} == wanted, 'Exact two scope document identities required')
    for row in rows:
        after = next(item for item in amendment['after'] if item['path'] == row['historical_path'])
        verify(row['before']); verify(row['full_diff'])
        require(verify(row['proposed']).read_bytes() == verify(after).read_bytes(), 'Current scope successor differs')
    review = read(verify(amendment['source_review']))
    review_execution(verify(amendment['source_review_execution']), review, command['started_utc'])
    unchanged(review['reviewed_sources'])
    require(instant(command['started_utc']) <= instant(amendment['started_utc'])
            <= instant(amendment['finished_utc']) <= instant(command['finished_utc']), 'Actual scope writer interval differs')
    return {'report': SCOPE, 'execution': SCOPE_EXECUTION,
        'plan': next(row for row in amendment['after'] if row['path'].endswith('/plan.json')),
        'card': next(row for row in amendment['after'] if row['path'].endswith('/CLK-06.md'))}


def prerequisites(args, scope, started):
    closure_ref = ref(args.prerequisite_closure)
    closure = read(verify(closure_ref))
    closure_execution, _ = recorded(args.prerequisite_closure_execution, closure, started)
    require(closure['schema'] == 'clk05-metadata-card-closure.v1'
            and closure['only_CLK05_gates_updated'] is True and closure['other_63_tasks_unchanged'] is True
            and closure['all_four_actual_gates'] == '\uD1B5\uACFC', 'Actual completed CLK05 closure required')
    require(len(closure['after']) == 3 and {row['path'] for row in closure['after']} ==
            {'energyplus_porting_plan/plan.json', 'energyplus_porting_plan/cards/CLK-05.md',
             'energyplus_porting_plan/evidence/CLK-05.json'}, 'Historical CLK05 canonical-after identities differ')
    amendment = read(verify(scope['report']))
    old_plan = next(row for row in closure['after'] if row['path'].endswith('/plan.json'))
    require(next(row for row in amendment['before'] if row['path'] == old_plan['path']) == old_plan,
            'Scope actual plan.before must bind historical CLK05 closed plan')
    verify(next(row for row in closure['after'] if row['path'].endswith('/evidence/CLK-05.json')))
    plan = read(verify(scope['plan']))
    require(type(plan['tasks']) is list and len(plan['tasks']) == 64 and len({row['id'] for row in plan['tasks']}) == 64,
            'Exactly64 unique task objects required')
    tasks = {row['id']: row for row in plan['tasks']}
    for card in ['CLK-02', 'CLK-03', 'CLK-04', 'CLK-05']:
        require(all(tasks[card][gate] == '\uD1B5\uACFC' for gate in GATES), 'Actual declared prerequisite gates incomplete')
    require(all(tasks['CLK-06'][gate] == '\uBBF8\uD655\uC778' for gate in GATES), 'CLK06 gates must remain pending')
    registry_ref, retirement_ref = ref(args.registry), ref(args.retirement)
    registry, retirement = read(verify(registry_ref)), read(verify(retirement_ref))
    retirement_execution, _ = recorded(args.retirement_execution, retirement, started)
    require(registry_ref['sha256'] == V5_SHA and registry['schema'] == 'native-retained-artifact-registry.v5'
            and registry['admitted_by_Root_after_actual_card_closure'] is True
            and registry['admitted_by_this_plan'] is False and registry['actual_card_closure'] == closure_ref
            and retirement['retired_registry'] == registry_ref, 'Actual accepted v5/CLK05 identity required')
    admitted = read(verify(registry['predecessor']))
    previous_ref = admitted['predecessor']
    require(previous_ref['sha256'] == V4_SHA, 'Actual v4 predecessor differs')
    previous = read(verify(previous_ref))
    for key in ['legacy_products', 'legacy_product_count', 'protected_core_API_and_container']:
        require(exact(registry[key], admitted[key]) and exact(registry[key], previous[key]), 'Prior protected registry metadata differs')
    require(len(registry['new_targets']) == 5 and exact(registry['new_targets'][:4], previous['new_targets'])
            and registry['new_targets'][-1]['target'] == 'clk05_reference_helper'
            and registry['new_targets'][-1]['actual_removal_observed'] is True, 'Exactly prior4 plus genuine CLK05 tombstone required')
    require(retirement['schema'] == 'clk05-single-target-native-helper-retirement.v1'
            and retirement['status'] == 'pass-precise-removal-and-retained-artifact-guards'
            and retirement['sole_exact_new_original_absent'] is True
            and retirement['historical_native_exit_code'] == 0 and retirement['historical_wrapper_exit_code'] == 0
            and retirement['metadata_recovery_performed'] is False
            and retirement['historical_failed_wrapper_relabelled_zero'] is False
            and len(retirement['protected_and_retained_after']) == 21, 'Honest actual Native0/wrapper0 protected21 retirement required')
    for binding in retirement['source_review'].values():
        verify(binding)
    return {'closure': closure_ref, 'execution': closure_execution, 'historical_canonical_after': closure['after'],
        'registry': registry_ref, 'retirement': retirement_ref, 'retirement_execution': retirement_execution,
        'historical_plan_after_not_claimed_current': True,
        'large_retained_artifact_guard_is_separate_native_builder_prerequisite': True}


def controls(args, started):
    binding = ref(args.production_control_inputs)
    value = read(verify(binding))
    require(value['schema'] in ['clk05-production-control-inputs.v1', 'clk06-production-control-inputs.v1']
            and value['effective_controls_inferred_from_outputs'] is False, 'Source-derived actual captured input registration required')
    card = value['schema'].split('-')[0]
    review_ref = ref(args.control_review)
    review = read(verify(review_ref))
    require(review['schema'] == card + '-independent-production-control-input-review.v1'
            and review['status'] == 'pass-input-registration-and-captured-environment-before-original'
            and review['scientific_execution_performed'] is False and exact(review['reviewed_control_inputs'], binding),
            'Actual captured-input independent review required')
    execution = review_execution(args.control_review_execution, review, started)
    unchanged(review['reviewed_sources'])
    provenance = ({'historical_report_has_executed_reader_archive': False,
        'current_pinned_historical_reader_source': HISTORICAL_CONTROL_READER,
        'current_source_is_a_retroactive_executed_archive': False,
        'historical_report_or_receipt_rewritten': False}
        if card == 'clk05' else {'executed_reader_source_archive': review['executed_reader_source_archive']})
    return binding, {'review': review_ref, 'execution': execution, 'reviewer_source_provenance': provenance,
        'historical_capture_is_not_current_child_environment_observation': True,
        'recapture_and_equality_before_after_every_native_or_CLI_child_required': True}


def load(name, source):
    spec = importlib.util.spec_from_file_location(name, source)
    require(spec is not None and spec.loader is not None, 'Authenticated source module unavailable')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def requested_counts(request):
    counts = {'setup_cases': len(request['setup_cases']), 'emissivity_cases': len(request['emissivity_cases']),
        'weather_sequences': len(request['weather_sequences']),
        'CalcSkyEmissivity': len(request['emissivity_cases']), 'GetNextEnvironment': 0,
        'InitializeWeather': 0, 'SetCurrentWeather': 0, 'calcSky': 0, 'weather_operations': 0,
        'total_operations': len(request['setup_cases']) + len(request['emissivity_cases'])}
    ids = [row['id'] for row in request['setup_cases'] + request['emissivity_cases'] + request['weather_sequences']]
    require(len(ids) == len(set(ids)), 'Unique root operation/sequence identifiers required')
    for sequence in request['weather_sequences']:
        require(type(sequence['operations']) is list and sequence['operations'], 'Nonempty literal operation history required')
        require(len({row['id'] for row in sequence['operations']}) == len(sequence['operations']), 'Unique per-lane operation identifiers required')
        for operation in sequence['operations']:
            require(operation['kind'] in ['GetNextEnvironment', 'InitializeWeather', 'SetCurrentWeather', 'calcSky']
                    and type(operation['caller']) is dict, 'Bounded genuine whole-call input required')
            for key in [operation['kind'], 'weather_operations', 'total_operations']:
                counts[key] += 1
    return counts


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['source-review', 'source-review-execution', 'catalogue-directory', 'catalogue-manifest',
                 'native-directory', 'native-source-manifest', 'scope-amendment', 'scope-amendment-execution',
                 'prerequisite-closure', 'prerequisite-closure-execution', 'registry', 'retirement',
                 'retirement-execution', 'production-control-inputs', 'control-review', 'control-review-execution', 'output-dir']:
        parser.add_argument('--' + name, type=Path, required=True)
    args = parser.parse_args()
    require(Path.cwd().resolve() == ROOT, 'Repository cwd required')
    output = path(args.output_dir)
    require(output.is_relative_to(BASE) and output != BASE and not output.exists(), 'Fresh ignored CLK06 freeze output required')
    started = utc()
    reviewed, sources = source_review(args, started)
    scope = scope_amendment(args, started)
    prior = prerequisites(args, scope, started)
    control_ref, control_review = controls(args, started)
    catalogue_manifest, native_manifest = ref(args.catalogue_manifest), ref(args.native_source_manifest)
    policy = load('clk06_authenticated_policy', HERE / 'packet_policy.py')
    require('catalog' not in sys.modules, 'Unexpected preloaded catalogue rejected')
    catalogue = load('catalog', path(args.catalogue_directory) / 'catalog.py')
    sys.modules['catalog'] = catalogue
    try:
        inputs = load('clk06_authenticated_writer', path(args.catalogue_directory) / 'write_inputs.py')
    finally:
        del sys.modules['catalog']
    output.mkdir(parents=True)
    source = policy.source_contract(output, started, scope, prior, control_ref, reviewed, native_manifest)
    source['production_control_review'] = control_review
    source_ref = put_json(output, 'source.json', source)
    tolerance_ref = put_json(output, 'tolerances.json', policy.tolerance_contract(started))
    request = inputs.build_request(output, source_ref, tolerance_ref, control_ref)
    require(request['schema'] == 'clk06-helper-cases.draft.v1'
            and request['frozen_before_numerical_execution'] is False
            and exact(request['contracts'], {'source': source_ref, 'tolerances': tolerance_ref})
            and all(request[key] is False for key in ['expected_values_supplied', 'expected_exits_supplied',
                'scientific_execution_performed', 'numerical_PASS_claimed', 'gates_updated']), 'Input-only one-way draft request required')
    require(exact(request['observation_policy'], policy.NATIVE_OBSERVATION_POLICY), 'Reviewed catalogue mask must equal reviewed policy')
    counts = requested_counts(request)
    require(exact(counts, request['requested_counts']), 'Auto-derived literal requested counts differ')
    fixed_scope = read(verify(request['fixed_scope']))
    ordered = [row[key] for row in fixed_scope['cases'] for key in ['input', 'weather', 'metadata']]
    require(len(ordered) == 45 and exact(ordered, request['all_45_guard_refs']), 'Exactly45 ordered CON references required')
    for binding in ordered:
        verify(binding)
    production = [row for row in request['weather_sequences'] if row['lane'] == 'production-CON']
    require([row['id'] for row in production] == ['A-24H', 'A-72H', 'B-BOTH-24H'], 'Exactly unchanged three production lanes required')
    require(exact(requested_counts({'setup_cases': [], 'emissivity_cases': [], 'weather_sequences': production}),
        {'setup_cases': 0, 'emissivity_cases': 0, 'weather_sequences': 3, 'CalcSkyEmissivity': 0,
         'GetNextEnvironment': 3, 'InitializeWeather': 480, 'SetCurrentWeather': 480,
         'calcSky': 0, 'weather_operations': 963, 'total_operations': 963}),
        'Genuine unchanged production phase history must contain all963 direct calls')
    artifacts = []
    for sequence in request['weather_sequences']:
        require(type(sequence['time_steps_per_hour']) is int and sequence['time_steps_per_hour'] in [1, 3, 4], 'Admitted interval1 steps1/3/4 required')
        for key in ['input', 'weather', 'external_byte_map']:
            if key in sequence:
                verify(sequence[key]); artifacts.append(sequence[key])
    request.update({'schema': 'clk06-helper-cases.v1', 'status': 'frozen-input-only-before-numerical-execution',
        'created_utc': started, 'frozen_before_numerical_execution': True, 'root_preoutput_decision': policy.DECISION})
    request_ref = put_json(output, 'helper-request.json', request)
    cases = {'schema': 'clk06-cases-contract.v1', 'card': 'CLK-06', 'created_utc': started,
        'frozen_before_numerical_execution': True, 'scientific_execution_performed': False, 'gates_updated': False,
        'helper_request': request_ref, 'source': source_ref, 'tolerances': tolerance_ref,
        'fixed_CON_scope': request['fixed_scope'], 'all_45_guard_refs': ordered, 'input_artifacts': artifacts,
        'catalogue_manifest': catalogue_manifest, 'requested_counts': counts,
        'root_preoutput_decision': policy.DECISION,
        'original_initial_data_QA_required_before_Rust_baseline': True}
    contracts = {'source': source_ref, 'cases': put_json(output, 'cases.json', cases), 'tolerances': tolerance_ref}
    projection_ref = put_json(output, 'projection.json', policy.observation_projection(request_ref, request, contracts, started, catalogue_manifest))
    native = {'schema': 'clk06-native-admission-contract.v1', 'energyplus_commit': PIN, 'created_utc': started,
        'frozen_before_numerical_execution': True, 'contracts': contracts, 'helper_request': request_ref,
        'projection': projection_ref, 'fixed_scope': request['fixed_scope'], 'all_45_guard_refs': ordered,
        'requested_counts': counts, 'source_review': reviewed, 'actual_CLK05_prerequisite': prior,
        'actual_scope_amendment': scope['report'], 'actual_scope_amendment_execution': scope['execution'],
        'actual_CLK06_scope_amendment': scope, 'root_preoutput_decision': policy.DECISION,
        'production_transport_source_inventory': TRANSPORT,
        'source_files': source['source_files'],
        'required_retired_registry': prior['registry'], 'required_actual_retirement': prior['retirement'],
        'required_actual_retirement_execution': prior['retirement_execution'], 'production_control_review': control_review,
        'native_source_manifest': native_manifest, 'catalogue_manifest': catalogue_manifest,
        'expected_values_supplied': False, 'expected_exits_supplied': False,
        'scientific_execution_performed': False, 'gates_updated': False}
    native_ref = put_json(output, 'native-admission-contract.json', native)
    saved = []
    for index, row in enumerate(sources):
        archive = put(output, f'sources/{index:02}-{Path(row["historical_path"]).name}', verify(row['archive']).read_bytes())
        saved.append({'historical_path': row['historical_path'], 'archive': archive})
    unchanged(sources); finish_guards()
    receipt = {'schema': 'clk06-input-source-policy-freeze.v1', 'status': 'frozen-before-original-execution',
        'started_utc': started, 'completed_utc': utc(), 'actual_writer_argv': list(sys.orig_argv),
        'contracts': contracts, 'helper_request': request_ref, 'projection': projection_ref, 'native_admission_contract': native_ref,
        'source_review': reviewed, 'production_control_review': control_review, 'actual_CLK05_prerequisite': prior,
        'actual_CLK06_scope_amendment': scope, 'root_preoutput_decision': policy.DECISION,
        'production_transport_source_inventory': TRANSPORT,
        'executed_source_archives': saved, 'requested_counts': counts, 'actual_numerical_operation_count': 0,
        'all_45_CON_inputs_preserved': True, 'canonical_files_or_gates_written': False,
        'scientific_execution_performed': False, 'source_hash_cycle_present': False,
        'expected_values_or_exits_supplied': False}
    put_json(output, 'freeze-receipt.json', receipt)
    import json
    print(json.dumps(receipt, ensure_ascii=True, allow_nan=False))


if __name__ == '__main__':
    main()

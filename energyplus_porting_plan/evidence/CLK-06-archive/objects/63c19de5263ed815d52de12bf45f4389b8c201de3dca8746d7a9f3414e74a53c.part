// Authenticate the one-way input packet. No source functions or output values.
#ifndef CLK06_REFERENCE_ADMISSION_HH
#define CLK06_REFERENCE_ADMISSION_HH
namespace Clk06Admission {
struct Packet {
    json request, admission, contracts, requested_counts;
    fs::path projection_path;
};
inline Packet admit(fs::path const &root, fs::path const &request_path, fs::path const &admission_path)
{
    Packet packet; packet.request = read_json(request_path); packet.admission = read_json(admission_path);
    auto const &request = packet.request; auto const &admission = packet.admission;
    require(request.at("schema") == "clk06-helper-cases.v1" &&
            admission.at("schema") == "clk06-native-admission-contract.v1" &&
            request.at("energyplus_commit") == "6f2e40d10250a105b49966baa24d843711e61048" &&
            admission.at("energyplus_commit") == request.at("energyplus_commit"), "Frozen original input schema/pin differs");
    for (auto const *value : {&request, &admission}) require(value->at("frozen_before_numerical_execution") == true &&
        value->at("expected_values_supplied") == false && value->at("expected_exits_supplied") == false &&
        value->at("scientific_execution_performed") == false, "Input-only pre-execution policy required");
    require(bound_path(root, admission.at("helper_request")) == fs::weakly_canonical(request_path) &&
            request.at("fixed_scope") == admission.at("fixed_scope") &&
            request.at("all_45_guard_refs") == admission.at("all_45_guard_refs") &&
            request.at("all_45_guard_refs").is_array() && request.at("all_45_guard_refs").size() == 45 &&
            request.at("contracts").size() == 2 && admission.at("contracts").size() == 3 &&
            request.at("contracts").at("source") == admission.at("contracts").at("source") &&
            request.at("contracts").at("tolerances") == admission.at("contracts").at("tolerances"),
            "One-way input/scope/contracts differ");
    auto const scope_path = bound_path(root, request.at("fixed_scope")); auto const scope = read_json(scope_path);
    json literal_guards = json::array();
    for (auto const &row : scope.at("cases")) for (char const *name : {"input", "weather", "metadata"}) literal_guards.push_back(row.at(name));
    require(literal_guards.size() == 45 && literal_guards == request.at("all_45_guard_refs"), "Exact ordered45 input scope required; shared weather refs are not deduplicated");
    for (auto const &row : request.at("all_45_guard_refs")) bound_path(root, row);
    auto const decision_path = bound_path(root, request.at("root_preoutput_decision"));
    auto const decision = read_json(decision_path);
    require(request.at("root_preoutput_decision") == admission.at("root_preoutput_decision") &&
            request.at("root_preoutput_decision").at("sha256") == "b12d5d633cf50d669054ce4c37dc231f8ecf3192971f1b7e12ae61d40c2b0a54" &&
            decision.at("schema") == "clk06-root-preoutput-scope-decisions.v1" &&
            decision.at("selected_day_carriers") == json({"SkyTemp", "HorizIRSky", "TotalSkyCover", "OpaqueSkyCover"}) &&
            decision.at("Rust_current_global_owner_extension_authorized_for_this_card") == false &&
            decision.at("SkyTempKelvin_cross_engine_profile_admitted") == false &&
            decision.at("scientific_execution_performed") == false, "Actual pre-output Root decision differs");
    packet.contracts = json::object();
    for (char const *name : {"source", "cases", "tolerances"}) {
        auto const path = bound_path(root, admission.at("contracts").at(name)); auto const value = read_json(path);
        require(value.at("schema") == std::string("clk06-") + name + "-contract.v1" &&
                value.at("frozen_before_numerical_execution") == true, "Frozen contract schema differs");
        if (std::string(name) == "cases") require(value.at("helper_request") == admission.at("helper_request") &&
            value.at("source") == admission.at("contracts").at("source") &&
            value.at("tolerances") == admission.at("contracts").at("tolerances") &&
            value.at("fixed_CON_scope") == request.at("fixed_scope") &&
            value.at("all_45_guard_refs") == request.at("all_45_guard_refs"), "Frozen case DAG differs");
        require(value.at("root_preoutput_decision") == request.at("root_preoutput_decision"), "Contract decision binding differs");
        if (std::string(name) == "tolerances") require(value.at("numeric_profiles") == decision.at("numeric_profiles"), "No changed scientific profiles admitted");
        if (std::string(name) == "source") {
            require(value.at("energyplus_commit") == request.at("energyplus_commit"), "Wrong original source pin");
            auto const source_root = fs::weakly_canonical(root / ".reference/energyplus-src/26.1.0");
            for (auto const &row : value.at("source_files")) {
                fs::path const relative(row.at("path").get<std::string>());
                require(relative.is_relative(), "Original source path must be relative");
                auto const path = fs::weakly_canonical(source_root / relative); auto const inside = path.lexically_relative(source_root);
                require(!inside.empty() && *inside.begin() != ".." && fs::is_regular_file(path) &&
                        file_sha(path) == row.at("sha256").get<std::string>(), "Pinned original source bytes differ");
            }
        }
        packet.contracts[name] = file_ref(path);
    }
    packet.projection_path = bound_path(root, admission.at("projection")); auto const projection = read_json(packet.projection_path);
    require(projection.at("schema") == "clk06-observation-projection.v1" &&
            projection.at("frozen_before_numerical_execution") == true &&
            projection.at("helper_request") == admission.at("helper_request") &&
            projection.at("contracts") == admission.at("contracts") &&
            projection.at("native_observation_policy") == request.at("observation_policy") &&
            projection.at("root_preoutput_decision") == request.at("root_preoutput_decision"), "Frozen observation DAG differs");
    bound_path(root, request.at("production_control_inputs"));
    require(request.at("setup_cases").is_array() && request.at("emissivity_cases").is_array() && request.at("weather_sequences").is_array(), "Typed sequence arrays required");
    require(request.at("requested_counts").is_object(), "Typed requested counts required");
    for (auto const &row : request.at("requested_counts").items()) require(row.value().is_number_integer() &&
        !row.value().is_boolean() && row.value().get<std::int64_t>() >= 0, "Nonnegative integer requested count required");
    packet.requested_counts = {{"setup_cases", request.at("setup_cases").size()}, {"emissivity_cases", request.at("emissivity_cases").size()},
        {"weather_sequences", request.at("weather_sequences").size()}, {"CalcSkyEmissivity", request.at("emissivity_cases").size()},
        {"GetNextEnvironment", 0}, {"InitializeWeather", 0}, {"SetCurrentWeather", 0}, {"calcSky", 0},
        {"weather_operations", 0}, {"total_operations", request.at("setup_cases").size() + request.at("emissivity_cases").size()}};
    std::set<std::string> identifiers;
    for (char const *group : {"setup_cases", "emissivity_cases", "weather_sequences"}) for (auto const &row : request.at(group)) {
        check_identifier(row); require(identifiers.insert(row.at("id").get<std::string>()).second, "Unique root input case IDs required");
    }
    for (auto const &sequence : request.at("weather_sequences")) {
        require(sequence.at("operations").is_array(), "Ordered operations array required");
        for (auto const &item : sequence.at("operations")) {
            auto const kind = item.at("kind").get<std::string>();
            require(kind == "GetNextEnvironment" || kind == "InitializeWeather" || kind == "SetCurrentWeather" || kind == "calcSky", "Operation outside bounded whole-source history");
            for (auto const &key : {kind, std::string("weather_operations"), std::string("total_operations")})
                packet.requested_counts[key] = packet.requested_counts.at(key).get<std::size_t>() + 1;
        }
    }
    require(request.at("requested_counts").size() == packet.requested_counts.size() &&
            packet.requested_counts == request.at("requested_counts") &&
            packet.requested_counts == admission.at("requested_counts"), "Actual declared input counts differ");
    return packet;
}
} // namespace Clk06Admission
#endif

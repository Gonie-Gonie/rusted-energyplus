+def origin_policy(proof_literals, manifest, proof_text):
+    policy = proof_literals['SOURCE_ORIGIN_POLICY']
+    ordinary = {'runtime_route': 'hourly_samples_simplified_analytical',
+        'use_quick_outside_conduction': False, 'use_cached_exterior_report_terms': False,
+        'required_positive_ingress_origins': ['surface_solve', 'report_outside_face_recomputation'],
+        'required_zero_origin_keys': [], 'required_zero_event_kinds': [], 'uninvoked_origins_counted_as_PASS': False}
+    coupled = {'runtime_route': 'direct_zone_purchased_air_fixed_step',
+        'use_quick_outside_conduction': True, 'use_cached_exterior_report_terms': True,
+        'required_positive_ingress_origins': ['surface_solve'],
+        'required_zero_origin_keys': [KINDS[5] + '/report_outside_face_recomputation',
+            KINDS[6] + '/report_outside_face_recomputation', KINDS[7] + '/report_terms_recomputation'],
+        'required_zero_event_kinds': [KINDS[7]], 'uninvoked_origins_counted_as_PASS': False}
+    owners = ['crates/ep_run/src/pipeline.rs', 'crates/ep_runtime/src/heat_balance/state.rs',
+        'crates/ep_runtime/src/runtime.rs', 'crates/ep_runtime/src/diagnostic_probes/heat_balance.rs',
+        'crates/ep_runtime/src/heat_balance/algorithm.rs', 'crates/ep_runtime/src/ideal_loads/coupled_runtime.rs',
+        'crates/ep_runtime/src/heat_balance/surface_balance.rs', 'crates/ep_runtime/src/heat_balance/weather_driver.rs']
+    m.need(m.exact(policy, manifest['source_origin_policy']) and set(policy) == {'schema','source_bindings','cases'}
+        and policy['schema'] == 'clk06-production-origin-source-policy.v1'
+        and m.exact(policy['cases'], {'A-24H': ordinary, 'A-72H': ordinary, 'B-BOTH-24H': coupled})
+        and [row['path'] for row in policy['source_bindings']] == owners
+        and all(set(row) == {'path','sha256'} for row in policy['source_bindings']),
+        'Only exact A ordinary/B quick-cached source-derived origin branches admitted')
+    text = {row['path']: m.verify(row).read_text(encoding='utf8') for row in policy['source_bindings']}
+    function = next(node for node in ast.parse(proof_text).body if isinstance(node, ast.FunctionDef)
+        and node.name == 'compiled_origin_policy')
+    markers = next(ast.literal_eval(node.value) for node in function.body if isinstance(node, ast.Assign)
+        and any(isinstance(target, ast.Name) and target.id == 'markers' for target in node.targets))
+    m.need(set(markers) == set(owners) and all(token in text[owner]
+        for owner, required in markers.items() for token in required), 'Exact eight source/config/caller guards differ')
+    failure = manifest['preserved_first_metadata_failure']; receipt = m.read(failure['execution'])
+    m.need(failure['actual_exit_code'] == receipt['exit_code'] == 1 and failure['report_emitted'] is False
+        and failure['numerical_mismatch_outcome_available'] is False
+        and failure['SourceQA01_missed_propagated_caller_alias'] is True
+        and receipt['source_bytes_match_before_and_after'] is True and m.verify(receipt['stdout']).stat().st_size == 0,
+        'Actual first metadata failure/no report must remain honestly preserved')
+    m.verify(receipt['stderr'])
+    return policy, failure['execution']
 
 

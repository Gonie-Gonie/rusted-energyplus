# Add one CLK06 caller unit, inheriting the authenticated 659 registrations.
if(NOT DEFINED CLK03_REPOSITORY_ROOT)
  message(FATAL_ERROR "CLK06 helper requires explicit repository root")
endif()
include("${CLK03_REPOSITORY_ROOT}/.runtime/porting/CLK-05/builder-prep-02/clk05_reference.cmake")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_clk06_scheduled GLOBAL PROPERTY CLK06_REFERENCE_SCHEDULED)
  if(NOT _clk06_scheduled)
    set_property(GLOBAL PROPERTY CLK06_REFERENCE_SCHEDULED TRUE)
    function(clk06_add_original_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "CLK06 requires unchanged genuine GNU core")
      endif()
      get_target_property(_clk06_target_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_clk06_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      set(_clk06_defs ${_clk06_target_defs} ${_clk06_directory_defs})
      list(FILTER _clk06_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _clk06_defs)
      add_executable(clk06_reference_helper "${CLK03_REPOSITORY_ROOT}/.runtime/porting/CLK-06/native-prep-01/clk06_reference_helper.cpp")
      target_include_directories(clk06_reference_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${CLK03_REPOSITORY_ROOT}/tools/porting" "${CLK03_REPOSITORY_ROOT}/.runtime/porting/CLK-04/native-prep-03")
      target_compile_definitions(clk06_reference_helper PRIVATE ${_clk06_defs})
      target_link_libraries(clk06_reference_helper PRIVATE energypluslib project_options project_fp_options project_warnings bcrypt)
      target_compile_features(clk06_reference_helper PRIVATE cxx_std_20)
    endfunction()
    cmake_language(DEFER CALL clk06_add_original_reference)
  endif()
endif()

# Add one CLK04 caller unit, inheriting the authenticated 657 registrations.
if(NOT DEFINED CLK03_REPOSITORY_ROOT)
  message(FATAL_ERROR "CLK04 helper requires explicit repository root")
endif()
include("${CLK03_REPOSITORY_ROOT}/.runtime/porting/CLK-03/production-native-prep-01/clk03_production_reference.cmake")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_clk04_scheduled GLOBAL PROPERTY CLK04_REFERENCE_SCHEDULED)
  if(NOT _clk04_scheduled)
    set_property(GLOBAL PROPERTY CLK04_REFERENCE_SCHEDULED TRUE)
    function(clk04_add_original_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "CLK04 requires unchanged genuine GNU core")
      endif()
      get_target_property(_clk04_target_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_clk04_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      set(_clk04_defs ${_clk04_target_defs} ${_clk04_directory_defs})
      list(FILTER _clk04_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _clk04_defs)
      add_executable(clk04_reference_helper "${CLK03_REPOSITORY_ROOT}/.runtime/porting/CLK-04/native-prep-03/clk04_reference_helper.cpp")
      target_include_directories(clk04_reference_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${CLK03_REPOSITORY_ROOT}/tools/porting")
      target_compile_definitions(clk04_reference_helper PRIVATE ${_clk04_defs})
      target_link_libraries(clk04_reference_helper PRIVATE energypluslib project_options project_fp_options project_warnings bcrypt)
      target_compile_features(clk04_reference_helper PRIVATE cxx_std_20)
    endfunction()
    cmake_language(DEFER CALL clk04_add_original_reference)
  endif()
endif()

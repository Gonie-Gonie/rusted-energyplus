"""Seal reviewed geometry workflow only after genuine Native release and actual card/before facts."""
import argparse
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD = BASE / 'ordinary-geometry-workflow-draft-01'
OUT = BASE / 'ordinary-geometry-workflow-prep-01'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def checked(row):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT) and path.is_file()
    actual = ref(path)
    assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes'])
    return path


def operand(token):
    name, digest = token.rsplit('#', 1)
    return ref(checked(dict(path=name, sha256=digest)))


def load(row):
    return json.loads(checked(row).read_bytes())


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def dump(path, value):
    return write(path, (json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2)+'\n').encode())


def successor(old_name, new_name, raw):
    ast.parse(raw)
    before = write(OUT/'before'/old_name, (OLD/old_name).read_bytes())
    proposed = write(OUT/new_name, raw.encode())
    delta = write(OUT/(new_name+'.diff'), ''.join(difflib.unified_diff((OLD/old_name).read_text(encoding='utf8').splitlines(True),raw.splitlines(True),fromfile=before['path'],tofile=proposed['path'])).encode())
    return proposed, dict(before=before, proposal=proposed, exact_diff=delta)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for key in ('Source-before','Native-baseline-acceptance','bounded-card-acceptance','comparer-Source-preparation','Root-comparer-Source-review','independent-comparer-Source-review'):
        parser.add_argument('--'+key, required=True)
    args = parser.parse_args()
    assert not OUT.exists(), 'fresh immutable Source hold required'
    m = copy.deepcopy(load(ref(OLD/'draft-contract.json')))
    for row in m['own_sources']: checked(row)
    before_full = operand(args.Source_before); before = {k:before_full[k] for k in ('path','sha256')}
    source = load(before)
    assert source['schema'] == 'rust-command-source-snapshot.v1' and source['bytes_normalized'] is False
    members = {v['historical_path']:v for v in source['files']}; assert len(members) == len(source['files'])
    actual = set((ROOT/'crates').rglob('*.rs')) | set((ROOT/'crates').rglob('Cargo.toml'))
    actual |= {ROOT/n for n in ('Cargo.toml','Cargo.lock','rust-toolchain.toml','.cargo/config.toml') if (ROOT/n).is_file()}
    assert set(members) == {p.relative_to(ROOT).as_posix() for p in actual}
    for name,row in members.items():
        archive = checked(row['archive']); assert len(archive.read_bytes()) == row['size_bytes']
        assert checked(dict(path=name,sha256=row['archive']['sha256'],size_bytes=row['size_bytes'])).read_bytes() == archive.read_bytes()
    release_ref = operand(args.Native_baseline_acceptance); release = load(release_ref)
    assert release['schema'] == 'ordinary-geometry-Native-baseline-acceptance.v1' and release['accepted'] is True and release['complete_input_owner_prefix_and_custody_review_accepted'] is True
    assert release['whole_geometry_or_ordinary_PASS_claimed'] is False and release['gates_updated'] is False
    native = release['Native_Source_preparation']; assert native['sha256'] == '2bcb4620c0519b2c796f96242430651d5bd6e737a5e793db4c24a6c03d9ee21b'; checked(native)
    for key in ('Source_snapshot','actual_Native_execution','actual_custody','actual_before','actual_authoritative_result','actual_provider_acceptance','Root_factual_review','independent_FULL_factual_review'): checked(release[key])
    card_ref = operand(args.bounded_card_acceptance); card = load(card_ref)
    assert card['schema'] == 'ordinary-geometry-bounded-card-acceptance.v1' and card['accepted'] is True and card['gates_updated'] is False; checked(card['actual_card'])
    comparer_ref = operand(args.comparer_Source_preparation); comparer = load(comparer_ref)
    assert comparer['schema'] == 'src06-ordinary-geometry-comparison-Source-preparation.v1' and comparer['Native_Source_preparation']['sha256'] == native['sha256']
    reviews = [operand(args.Root_comparer_Source_review),operand(args.independent_comparer_Source_review)]
    for row in reviews:
        proof = load(row); assert proof['schema'] == 'src06-ordinary-geometry-comparison-Source-review.v1' and proof['accepted'] is True and checked(proof['reviewed_Source_preparation']) == checked(comparer_ref)
    held = []
    for role in ('geometry_Source_preparation','observer_Source_preparation'):
        for row in load(m[role])['application_sources']:
            item = dict(row,source_preparation=m[role]); checked(item['proposal']); checked(item['exact_diff'])
            if item['new_destination_absent']: assert item['canonical_path'] not in members and not (ROOT/item['canonical_path']).exists()
            else: assert checked(item['actual_before']).read_bytes() == checked(item['before_archive']).read_bytes() == checked(members[item['canonical_path']]['archive']).read_bytes()
            held.append(item)
    assert [v['canonical_path'] for v in held] == m['application_paths'] and sum(v['new_destination_absent'] for v in held) == 5
    checked(m['historical_card_archive']); checked(m['protected_prior_summary']); checked(m['protected_dispatcher_policy'])
    for row in load(m['protected_dispatcher_application'])['application']:
        assert row['canonical_path'] not in m['application_paths'] and checked(row['actual_final_archive']).read_bytes() == (ROOT/row['canonical_path']).read_bytes()
    apply = (OLD/'apply.draft.py').read_text(encoding='utf8')
    start = apply.index('def baseline(A, prep):'); end = apply.index('\n\ndef held_rows(',start)
    apply = apply[:start]+'''def baseline(A, prep):
    release = A.load(prep['Native_baseline_acceptance'])
    A.need(release['schema'] == 'ordinary-geometry-Native-baseline-acceptance.v1' and release['accepted'] is True and release['complete_input_owner_prefix_and_custody_review_accepted'] is True, 'genuine complete Native04 release required')
    A.need(release['whole_geometry_or_ordinary_PASS_claimed'] is False and release['gates_updated'] is False, 'factual release cannot claim whole geometry PASS')
    for key in ['Root_factual_review','independent_FULL_factual_review','actual_custody','actual_before','actual_authoritative_result','actual_provider_acceptance']:
        A.bind(release[key])
    actual = A.load(release['actual_Native_execution'])
    A.need(A.bind(actual['source_snapshot']) == A.bind(release['Source_snapshot']), 'actual Native Source identity differs')
    A.recorded(release['actual_Native_execution'], actual['source_snapshot'], actual['command'])
    A.need(actual['finished_utc'] is not None and actual['started_utc'] <= actual['finished_utc'], 'closed actual Native geometry required')
    A.need(A.bind(release['Native_Source_preparation']) == A.bind(prep['actual_Native_Source_preparation']), 'actual Native04 authority differs')
    return release, actual
'''+apply[end:]
    apply = apply.replace('UNSEALED Root-only geometry application draft; missing authority stops before mutation.','Root-only reviewed ten-path geometry application; genuine released Native baseline required.',1)
    validate = (OLD/'validate.draft.py').read_text(encoding='utf8').replace('UNSEALED Root-only geometry quality/artifact/capture draft; no Native replay.','Root-only reviewed geometry quality/artifact/capture; no Native replay.',1)
    needle = 'app_ref, review_ref, source = A.operand(args.application), A.operand(args.formatter_review), A.operand(args.Source_snapshot)'
    assert validate.count(needle) == 1
    validate = validate.replace(needle,needle+"\n    source = {key:source[key] for key in ('path','sha256')}",1)
    transport = (OLD/'compare.draft.py').read_text(encoding='utf8').replace('UNSEALED Root-only comparison transport draft; no equations or Native replay.','Root-only reviewed comparison transport; no equations or Native replay.',1)
    assert transport.count("review['reviewed_manifest']") == 1
    transport = transport.replace("review['reviewed_manifest']", "review['reviewed_Source_preparation']")
    needle = 'app_ref, review_ref, source = [A.operand(v) for v in [args.application, args.formatter_review, args.Source_snapshot]]'
    assert transport.count(needle) == 1
    transport = transport.replace(needle,needle+"\n    source = {key:source[key] for key in ('path','sha256')}",1)
    rows = [successor('apply.draft.py','apply.py',apply),successor('validate.draft.py','validate.py',validate),successor('compare.draft.py','compare.py',transport)]
    doc = write(OUT/'README.md',(OLD/'README.md').read_bytes()+b'\nThis sealed successor binds only the actual released Native04 and actual current card/before Source supplied to its sealer. Original reviewed geometry8 and observer2 proposals stay byte-exact. Source operands are authenticated in full then transported with the actual recorder path/SHA schema; optional size/line metadata is never mistaken for a different artifact. The historical53a card remains archive-only. No helper, Cargo, formatter, comparer or canonical action was executed by the sealer.\n')
    m.update(status='HELD-Source-only-unexecuted',application_authority_supplied=True,source_before=before,fresh_actual_before_rebase=dict(Source_snapshot=before,application_sources=held),Native_baseline_acceptance=release_ref,actual_Native_Source_preparation=native,bounded_card_acceptance=card_ref,reviewed_comparer_Source_preparation=comparer_ref,comparer_FULL_Source_reviews=reviews,own_sources=[v[0] for v in rows]+[doc,ref(Path(__file__))],authentic_before_contract=ref(OLD/'draft-contract.json'),source_correspondence=[v[1] for v in rows],actual_before_full_descriptor=before_full)
    m['runtime_interfaces'].update(apply=rows[0][0],validate=rows[1][0],compare=rows[2][0]); m['missing_application_prerequisites']=[]
    print(json.dumps(dump(OUT/'manifest.json',m)))


if __name__ == '__main__': main()

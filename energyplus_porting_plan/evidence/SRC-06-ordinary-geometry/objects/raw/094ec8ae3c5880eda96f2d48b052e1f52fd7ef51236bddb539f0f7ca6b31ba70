"""Root-only exact selected ordinary geometry comparison; no geometry equations or engine calls."""
import argparse
import gzip
import hashlib
import importlib.util
import json
from pathlib import Path
import struct
import sys

ROOT = Path(__file__).resolve().parents[4]
HERE = Path(__file__).resolve().parent


def sha(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def local_ref(path):
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha(path), 'size_bytes': path.stat().st_size}


def module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value)
    return value


def scalar(C, value):
    copied = dict(value)
    copied['value_class'] = {'NaN':'nan','+Infinity':'positive_infinity','-Infinity':'negative_infinity','-0':'negative_zero','+0':'positive_zero'}.get(copied['value_class'], copied['value_class'])
    return C.scalar(copied)


def validate_scalars(C, value):
    if isinstance(value, dict):
        if set(value) == {'value','value_bits','value_class'}:
            scalar(C, value)
        else:
            for child in value.values(): validate_scalars(C, child)
    elif isinstance(value, list):
        for child in value: validate_scalars(C, child)


def compare(C, left, right, path, phase):
    phase = {'input_join':'input_join_comparisons','pre_owner':'pre_owner_comparisons','selected_endpoint':'selected_endpoint_comparisons'}[phase]
    if isinstance(left, dict) and isinstance(right, dict):
        C.same(sorted(left), sorted(right), path + '/keys', phase)
        for key in sorted(set(left) & set(right)):
            compare(C, left[key], right[key], path + '/' + key, next(k for k,v in {'input_join':'input_join_comparisons','pre_owner':'pre_owner_comparisons','selected_endpoint':'selected_endpoint_comparisons'}.items() if v == phase))
    elif isinstance(left, list) and isinstance(right, list):
        C.same(len(left), len(right), path + '/length', phase)
        for index, (a,b) in enumerate(zip(left,right)):
            compare(C,a,b,path+'/'+str(index),next(k for k,v in {'input_join':'input_join_comparisons','pre_owner':'pre_owner_comparisons','selected_endpoint':'selected_endpoint_comparisons'}.items() if v == phase))
    elif type(left) is int and type(right) is int:
        C.same(left,right,path,phase)
    elif type(left) in (int,float) and type(right) in (int,float):
        # JSON numeric spelling is not a binary64 input identity. Integer fields remain exact.
        C.same(struct.pack('>d',float(left)).hex(),struct.pack('>d',float(right)).hex(),path,phase)
    else:
        C.same(left,right,path,phase)


def unavailable(C, path, reason, required, details=None):
    C.UNAVAILABLE.append({'path':path,'reason':reason,'required':required,'counted_as_PASS':False,'details':details})


def endpoint(C, left, right, path):
    if left is None or right is None:
        unavailable(C,path,'actual selected owner unavailable',True,{'Native':left,'Rust':right}); return
    if isinstance(left,dict) or isinstance(right,dict):
        C.need(isinstance(left,dict) and isinstance(right,dict),'selected scalar DTO kind differs')
        a,b=scalar(C,left),scalar(C,right)
        if a[1] in ('nan','positive_infinity','negative_infinity') or b[1] in ('nan','positive_infinity','negative_infinity'):
            unavailable(C,path,'actual nonfinite selected endpoint; never arithmetic PASS',True,{'Native':left,'Rust':right}); return
        C.same(a,b,path,'selected_endpoint_comparisons')
    else:
        C.same(left,right,path,'selected_endpoint_comparisons')


def prefixes(C, native, rust, request):
    C.need(native['schema']=='ordinary-geometry-public-loader-results.v1' and rust['schema']=='src06-ordinary-geometry-observer-results.v1','actual result schemas differ')
    C.need(native['EnergyPlusData_constructor']['status']=='source_returned' and native['read_only_observer_integrity_failed'] is False,'actual Native constructor/copy unavailable')
    rows=native['lifecycle']; C.need([r['kind'] for r in rows]==request['loader_phase_order'] and len(rows)==13,'complete thirteen actual outer loader boundaries required')
    callbacks=native['diagnostics']['callbacks']; C.need(native['diagnostics']['omitted_callback_records']==0 and native['diagnostics']['callback_copy_integrity_failed'] is False,'full actual callbacks required')
    C.need([r['ordinal'] for r in callbacks]==list(range(1,len(callbacks)+1)) and native['diagnostics']['actual_callback_count']==len(callbacks),'actual callback ordinals/count differ')
    previous=None
    for index,row in enumerate(rows):
        before,after=row['before'],row['after']
        C.need(before['available'] is True and after['available'] is True,'actual Native prefix owner unavailable')
        if previous is not None: C.need(before==previous,'Native outer owner/prefix chain broken')
        C.need(row['callback_count_before']==before['actual_callback_count'] and row['callback_count_after']==after['actual_callback_count'],'callback boundary custody differs')
        C.need(0 <= row['callback_count_before'] <= row['callback_count_after'] <= len(callbacks),'callback prefix range differs')
        for name in ('actual_error_prefix','actual_console_prefix','actual_EIO_prefix'):
            C.need(after[name].startswith(before[name]),'Native stream prefix was rewritten')
        previous=after
    C.need(native['final_prefix_and_counters']==previous,'Native final copy differs from final actual outer boundary')
    files=native['diagnostics']['actual_files']; C.need(set(files)=={'console','err','audit','eso','eio','mtr','bnd','debug','rdd','mdd','mtd','edd','dfs','shade'},'complete fourteen actual diagnostic streams required')
    for row in files.values(): C.exact(row)
    for name,prefix in [('err','actual_error_prefix'),('console','actual_console_prefix'),('eio','actual_EIO_prefix')]:
        C.need(C.exact(files[name]).read_bytes()==previous[prefix].encode('utf-8'),'Native physical final stream differs')
    C.need(native['actual_loader_ready'] is True and native['actual_caller_matches_source_timestep'] is True and native['selected_geometry_available'] is True
           and native['geometry_copy_failure']=='' and all(r['actual_source_invoked'] is True and r['call_outcome']['status']=='source_returned' and r['after']['owners']['loader_ErrorsFound'] is False for r in rows),'released complete actual Native return required')
    for flag in ('CTF_Init_or_solver_invoked','expected_values_read','numerical_comparison_performed','whole_SetupZoneGeometry_PASS_claimed','gates_updated'):
        C.need(native[flag] is False,'Native selected result scope changed')
    for flag in ('Native_intermediate_calls_reconstructed','geometry_producers_reexecuted_by_observer','Native_answers_or_results_supplied','numerical_PASS_claimed','whole_geometry_PASS_claimed','ordinary_convection_or_cadence_PASS_claimed','gates_updated'):
        C.need(rust[flag] is False,'Rust selected result scope changed')
    C.need(rust['case_id']=='A-24H','fixed A24 result required')
    before,after=rust['caller_before'],rust['caller_after']
    if before is None or after is None:
        unavailable(C,'Rust/initializer-call-boundary','actual Rust caller unavailable',True); return
    C.need(before['actual_Rust_caller_owner_copied'] is True and after['actual_Rust_caller_owner_copied'] is True and before['Native_intermediate_checkpoint_inferred'] is False and after['Native_intermediate_checkpoint_inferred'] is False,'actual Rust caller witness required')
    for name in ('error','console','eio'):
        def decode(row):
            raw=bytes.fromhex(row['hex']); C.need(len(raw)==row['size_bytes'] and (raw.decode('utf-8') if row['utf8'] is not None else None)==row['utf8'],'Rust full stream DTO differs'); return raw
        C.need(decode(after['prefixes'][name]).startswith(decode(before['prefixes'][name])),'Rust caller stream prefix was rewritten')
    C.need(rust['actual_calls']['initialize_heat_balance_state_with_initialization_context']==1,'one genuine Rust initializer boundary required')


def selected(C, maps, rust, policy, admitted):
    typed=rust['typed_geometry_inputs']; owners=rust['selected_owners']; available=admitted and maps is not None and owners['owner_available'] is True and rust['initializer_result'].get('returned') is True
    opaque=owners.get('opaque_setup') if available else None
    def by_id(rows,name):
        C.need(len({r[name] for r in rows})==len(rows),'duplicate retained owner ID'); return {r[name]:r for r in rows}
    dims=by_id(opaque['surface_dimensions'],'surface_id') if opaque and opaque['owner_available'] else {}
    bounds=by_id(opaque['zones'],'zone_id') if opaque and opaque['owner_available'] else {}
    returns=by_id(owners['zone_returns'],'zone_id') if available else {}
    if available:
        C.need(set(returns)=={r['id'] for r in typed['zones']},'complete retained GEO03 owner associations required')
        if opaque and opaque['owner_available']:
            C.need(set(dims)=={r['id'] for r in typed['surfaces']} and set(bounds)=={r['id'] for r in typed['zones']},'complete retained opaque owner associations required')
            C.need([r['surface_id'] for r in opaque['surface_dimensions']] == [r['id'] for r in typed['surfaces']] and [r['zone_id'] for r in opaque['zones']] == [r['id'] for r in typed['zones']],'actual retained opaque owner order differs')
        for values in (owners['zone_returns'],opaque['surface_dimensions'] if opaque and opaque['owner_available'] else [],opaque['zones'] if opaque and opaque['owner_available'] else []):
            C.need([r['vector_index'] for r in values] == list(range(len(values))),'retained owner vector indices differ')
        C.need(owners['producer_calls_reexecuted_by_observer'] is False and owners['actual_boundary']=='returned HeatBalanceState after one initializer call','actual retained owner boundary differs')
    for row in typed['surfaces']:
        name=row['name'].lower(); n=maps['Native_surfaces'].get(name) if maps else None; r=dims.get(row['id'])
        for field in policy['mandatory_selected_fields']['surface']:
            endpoint(C,n.get(field) if n and admitted else None,r.get(field) if r and admitted else None,'surface/'+name+'/'+field)
        C.PAIRS.append({'kind':'Surface','name':row['name'],'Native_id':n['id'] if n else None,'Rust_id':row['id'],'Rust_vector_index':row['vector_index'],'selected_owner_available':n is not None and r is not None and admitted})
    for row in typed['zones']:
        name=row['name'].lower(); n=maps['Native_zones'].get(name) if maps else None; b=bounds.get(row['id']); r=returns.get(row['id'])
        for index,field in enumerate(policy['mandatory_selected_fields']['zone_bounds']):
            endpoint(C,n['bounds_m'][index] if n and admitted else None,b['bounds_m'][index] if b and admitted else None,'zone/'+name+'/'+field)
        for field,rfield in [('ExtGrossWallArea','exterior_gross_wall_area_m2'),('ExtWindowArea','exterior_window_area_m2')]:
            endpoint(C,n['exterior_areas'][field] if n and admitted else None,b[rfield] if b and admitted else None,'zone/'+name+'/'+field)
        for field in policy['mandatory_selected_fields']['GEO03_return']:
            endpoint(C,n.get(field) if n and admitted else None,r['returned'].get(field) if r and admitted else None,'zone/'+name+'/GEO03/'+field)
        C.PAIRS.append({'kind':'Zone','name':row['name'],'Native_id':n['id'] if n else None,'Rust_id':row['id'],'Rust_vector_index':row['vector_index'],'selected_owner_available':n is not None and b is not None and r is not None and admitted})
    for family in policy['explicitly_unpaired']:
        unavailable(C,'unpaired-context/'+family,'frozen prospective policy explicitly unpaired',False)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    for name in ('source-preparation','custody','output-dir'): parser.add_argument('--'+name,required=True)
    args=parser.parse_args(); name, expected=args.source_preparation.rsplit('#',1); preparation=(ROOT/name).resolve()
    if not preparation.is_relative_to(ROOT) or sha(preparation)!=expected: raise ValueError('reviewed complete Source preparation differs')
    manifest=json.loads(preparation.read_bytes())
    if manifest['schema']!='src06-ordinary-geometry-comparison-Source-preparation.v1': raise ValueError('reviewed geometry comparer Source required')
    for row in manifest['own_sources']:
        path=(ROOT/row['path']).resolve()
        if not path.is_relative_to(ROOT) or sha(path)!=row['sha256'] or path.stat().st_size!=row['size_bytes']: raise ValueError('reviewed own Source differs')
    primitive=manifest['comparison_primitives_Source']; path=(ROOT/primitive['path']).resolve()
    if sha(path)!=primitive['sha256']: raise ValueError('accepted comparison primitive Source differs')
    C=module('geometry_comparison_primitives',path); K=module('geometry_custody',HERE/'custody.py'); I=module('geometry_input_joins',HERE/'input_joins.py')
    name,digest=args.custody.rsplit('#',1); packet_ref={'path':name,'sha256':digest}; packet=C.load(packet_ref)
    out=(ROOT/args.output_dir).resolve(); C.need(out.is_relative_to(ROOT/'.runtime/porting/SRC-06') and not out.exists(),'fresh ignored comparison output required'); out.mkdir(parents=True)
    status='integrity-failed'; failure=None; exit_code=2
    try:
        native,rust,context,request,before=K.authenticate(C,packet,manifest)
        policy=C.load(manifest['prospective_policy']); ledger=C.load(manifest['input_identity_ledger'])
        I.conversion(C,context,manifest)
        validate_scalars(C,native); validate_scalars(C,rust)
        prefixes(C,native,rust,request)
        maps=I.joins(C,lambda a,b,p,phase:compare(C,a,b,p,phase),native,rust,context,ledger)
        admitted=not C.MISMATCHES and maps is not None
        selected(C,maps,rust,policy,admitted)
        for path,digest in list(C.SEEN.items()): C.need(sha(path)==digest,'authenticated bytes changed during comparison')
        required=sum(v['required'] for v in C.UNAVAILABLE)
        passed=not C.MISMATCHES and required==0
        status='pass-available-selected-ordinary-geometry-only' if passed else 'failed-selected-ordinary-geometry'
        exit_code=0 if passed else 1
    except (Exception,) as error:
        failure={'type':type(error).__name__,'message':str(error)}
    facts={}
    for name,rows in [('mismatches',C.MISMATCHES),('unavailable',C.UNAVAILABLE),('paired_owners',C.PAIRS)]:
        raw=b''.join((json.dumps(row,ensure_ascii=False,separators=(',',':'),allow_nan=False)+'\n').encode() for row in rows)
        target=out/(name+'.jsonl.gz')
        with target.open('xb') as stream:
            with gzip.GzipFile(filename='',mode='wb',fileobj=stream,mtime=0) as zipped: zipped.write(raw)
        facts[name]={'artifact':local_ref(target),'rows':len(rows),'decoded_bytes':len(raw),'decoded_sha256':hashlib.sha256(raw).hexdigest()}
    report={'schema':'src06-ordinary-geometry-selected-comparison.v1','status':status,'actual_custody':packet_ref,'reviewed_Source_preparation':local_ref(preparation),
            'prospective_policy':manifest['prospective_policy'],'counts':C.COUNTS,'mismatch_count':len(C.MISMATCHES),'required_unavailable_count':sum(v['required'] for v in C.UNAVAILABLE),
            'optional_unpaired_count':sum(not v['required'] for v in C.UNAVAILABLE),'ledgers':facts,'integrity_failure':failure,
            'Native_and_Rust_intermediate_checkpoint_pairing_claimed':False,'all_differences_retained_without_cap':True,'all_unavailable_counted_as_PASS':False,
            'whole_geometry_PASS_claimed':False,'whole_SetupZoneGeometry_PASS_claimed':False,'ordinary_convection_or_cadence_PASS_claimed':False,'gates_updated':False}
    target=out/'comparison.json'; target.write_bytes((json.dumps(report,ensure_ascii=False,indent=2,allow_nan=False)+'\n').encode()); print(json.dumps({'comparison':local_ref(target),'actual_exit_code':exit_code})); return exit_code


if __name__=='__main__': sys.exit(main())

"""Seal finite prospective publisher Source only; never import or execute the publisher."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OUT = BASE / 'ordinary-geometry-publication-prep-01'


def ref(path):
    path = Path(path)
    data = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data))


def write(path, data):
    with path.open('xb') as stream: stream.write(data)
    return ref(path)


def load(path): return json.loads(Path(path).read_bytes())


def main():
    target = OUT / 'manifest.json'
    assert not target.exists(), 'immutable hold already sealed'
    publisher, document = OUT / 'publish.py', OUT / 'README.md'
    ast.parse(publisher.read_bytes()); ast.parse(Path(__file__).read_bytes())
    parent = BASE / 'tarp-dispatcher-publication-prep-03/publish.py'
    assert ref(parent)['sha256'] == 'a2a63cd85d3d3bc7d9c25e7ef458535b6b88dab76a3116beb894cfdbb0440671'
    before = write(OUT / 'dispatcher-publisher.before.py', parent.read_bytes())
    delta = ''.join(difflib.unified_diff(parent.read_text(encoding='utf8').splitlines(keepends=True), publisher.read_text(encoding='utf8').splitlines(keepends=True), fromfile=before['path'], tofile=ref(publisher)['path']))
    exact = write(OUT / 'publisher-adaptation.diff', delta.encode())
    historical_names = [
        'ordinary-geometry-native-prep-01', 'ordinary-geometry-native-prep-02', 'ordinary-geometry-native-prep-03',
        'ordinary-geometry-build-prep-01', 'ordinary-geometry-build-prep-02', 'ordinary-geometry-build-prep-03',
        'ordinary-geometry-provider-prep-01', 'ordinary-geometry-provider-prep-02',
        'ordinary-geometry-execution-prep-01', 'ordinary-geometry-execution-prep-02', 'ordinary-geometry-execution-prep-03', 'ordinary-geometry-execution-prep-04', 'ordinary-geometry-execution-prep-05',
        'ordinary-geometry-factual-checker-prep-01', 'ordinary-geometry-factual-checker-prep-02',
        'ordinary-geometry-owner-prep-01', 'ordinary-geometry-observer-prep-01',
        'ordinary-geometry-comparison-prep-01', 'ordinary-geometry-comparison-prep-02',
        'ordinary-geometry-Rust-factual-checker-prep-01',
    ]
    historical = [ref(BASE / name / 'manifest.json') for name in historical_names]
    fixed_names = [
        'ordinary-geometry-input-admission-preflight-01/record.json',
        'dispatcher-build-metadata-restore-01/record.json', 'geometry-build-metadata-restore-02/record.json',
        'ordinary-geometry-native-prep-02/Root-FULL-Source-review-02.json', 'ordinary-geometry-native-prep-03/Root-FULL-Source-review-03.json', 'ordinary-geometry-native-prep-04/Root-FULL-Source-review-04.json',
        'Header-geometry-native-Source-review-02/review.json', 'Header-geometry-native-Source-review-03/review.json', 'Header-geometry-Native-Source-review-04/review.json',
        'ordinary-geometry-build-prep-04/Root-FULL-Source-review-04-corrected.json', 'Base-geometry-configure-Source-review-04/review.json',
        'ordinary-geometry-provider-prep-03/Root-FULL-Source-review-03.json', 'Raw-geometry-provider-Source-review-03/review.json',
        'ordinary-geometry-execution-prep-06/Root-FULL-Source-review-06.json', 'Base-geometry-execution-Source-review-06/review.json',
        'Root-geometry-capture-checker-Source-review-02/review.json', 'Header-geometry-capture-checker-Source-review-02/review.json',
        'ordinary-geometry-owner-prep-02/Root-FULL-Source-review-02.json', 'Header-geometry-owner-Source-review-02/review.json',
        'ordinary-geometry-observer-prep-02/Root-FULL-Source-review-02.json', 'Header-ordinary-geometry-observer-Source-review-02/review.json',
        'Root-geometry-comparison-Source-review-02/review.json', 'Header-geometry-comparison-Source-review-02/review.json',
        'Header-geometry-null-admission-Source-review-01/review.json',
        'Root-geometry-Rust-factual-checker-Source-review-01/review.json', 'Header-geometry-Rust-factual-checker-Source-review-01/review.json',
    ]
    fixed = [ref(BASE / name) for name in fixed_names] + [before, exact]
    for name in ['ordinary-geometry-input-admission-preflight-01/record.json', 'dispatcher-build-metadata-restore-01/record.json', 'geometry-build-metadata-restore-02/record.json']:
        value = load(BASE / name)
        for key in ['record_Source', 'executed_restore_Source']:
            if key in value: fixed.append(value[key])
    null_review = load(BASE / 'Header-geometry-null-admission-Source-review-01/review.json')
    def literals(value):
        if isinstance(value, dict):
            if 'literal_archive' in value: fixed.append(value['literal_archive'])
            for child in value.values(): literals(child)
        elif isinstance(value, list):
            for child in value: literals(child)
    literals(null_review)
    fixed = list({(r['path'], r['sha256']):r for r in fixed}.values())
    for row in fixed:
        actual = ref(ROOT / row['path']); assert actual['sha256'] == row['sha256'] and actual['size_bytes'] == row['size_bytes']
    packet_keys = ['workflow_Source_preparation', 'comparer_Source_preparation', 'Root_comparer_Source_review', 'independent_comparer_Source_review', 'Native_baseline_acceptance', 'actual_build_record', 'actual_Rust_capture_custody', 'actual_Rust_launch_execution', 'Root_Rust_factual_review', 'independent_Rust_factual_review', 'actual_comparison_transport', 'actual_comparison', 'actual_comparison_execution', 'Root_comparison_factual_review', 'independent_comparison_factual_review']
    manifest = dict(schema='src06-ordinary-geometry-publication-Source-preparation.v1', status='HELD; Root and independent FULL Source review required before publication',
        own_sources=[ref(publisher), ref(document), ref(Path(__file__))], authentic_template=ref(parent),
        source_correspondence=[dict(before=before, proposal=ref(publisher), exact_diff=exact)],
        geometry_Source_preparation=ref(BASE / 'ordinary-geometry-owner-prep-02/manifest.json'), observer_Source_preparation=ref(BASE / 'ordinary-geometry-observer-prep-02/manifest.json'),
        Native_Source_preparation=ref(BASE / 'ordinary-geometry-native-prep-04/manifest.json'), prospective_policy=ref(BASE / 'ordinary-geometry-observer-prep-02/policy.proposed.json'),
        recorder_Source=ref(ROOT / 'tools/porting/record_command.py'), fixed_evidence=fixed, historical_Source_preparations=historical,
        retained_closed_failures=[ref(BASE / 'ordinary-geometry-compile-command-01/receipt.json')],
        runtime_interfaces=dict(publisher=ref(publisher), required_options=['--source-preparation', '--packet'], packet_schema='src06-ordinary-geometry-publication-inputs.v1', exact_packet_keys=['schema'] + packet_keys,
            output_directory='energyplus_porting_plan/evidence/SRC-06-ordinary-geometry', archive_schema='src06-ordinary-geometry-selected-archive.v1', summary_schema='src06-ordinary-geometry-evidence.v1',
            comparison_factual_review_schema='src06-ordinary-geometry-comparison-factual-review.v1', full_uncapped_ledger_names=['mismatches', 'unavailable', 'paired_owners']),
        strict_Native_release_rule='Both complete factual reviews and genuine release require all thirteen loader calls returned, all Total error counters zero, noErrors; no post-outcome relaxation',
        fixed_selection_boundary='Explicit current producers plus listed historical metadata/Source; no recursive ancestry. Empty new-file archives are opaque bytes.',
        numerical_results_or_ledger_values_read_by_author=False, publisher_imported_or_executed=False, future_actual_hashes_or_outcomes_supplied=False,
        canonical_Source_docs_or_Git_mutated=False, selected_closure_transitively_replayable=False, whole_geometry_or_ordinary_PASS_claimed=False, gates_updated=False)
    write(target, (json.dumps(manifest, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode())
    print(json.dumps(dict(manifest=ref(target), publisher=ref(publisher), fixed_evidence=len(fixed), historical_Source_preparations=len(historical))))


if __name__ == '__main__': main()

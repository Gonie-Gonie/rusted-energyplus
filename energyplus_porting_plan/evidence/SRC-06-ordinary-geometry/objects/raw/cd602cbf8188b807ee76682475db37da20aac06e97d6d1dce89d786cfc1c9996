"""Authenticate the recorder and driver stdout records separately, before any capture read."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT=Path(__file__).resolve().parents[3]
BASE=ROOT/'.runtime/porting/SRC-06'
OLD,OUT=BASE/'ordinary-geometry-factual-checker-prep-01',BASE/'ordinary-geometry-factual-checker-prep-02'

def ref(path):
    raw=path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(),sha256=hashlib.sha256(raw).hexdigest(),size_bytes=len(raw),line_count=len(raw.splitlines()))

def write(path,raw):
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('xb') as stream:stream.write(raw)
    return ref(path)

def body(name,raw):
    before=write(OUT/'before'/name,(OLD/name).read_bytes());proposal=write(OUT/name,raw)
    diff=write(OUT/(name+'.diff'),''.join(difflib.unified_diff((OLD/name).read_text(encoding='utf8').splitlines(True),raw.decode().splitlines(True),fromfile=before['path'],tofile=proposal['path'])).encode())
    return proposal,dict(before=before,proposal=proposal,exact_diff=diff)

assert ref(OLD/'manifest.json')['sha256']=='4115cb51f7f1252bb9a7c176f93bbf98daa222fa363f8780640fb4cbaa1d9efd'
raw=(OLD/'check.py').read_text(encoding='utf8')
needle="    summary = json.loads(bind(outer['stdout']).read_bytes()); same(summary['custody'],custody_ref); need(summary['actual_exit_code'] == inner['exit_code'] and summary['scientific_PASS_claimed'] is False, 'outer full stdout custody differs')"
replacement="""    transport_lines = bind(outer['stdout']).read_bytes().splitlines()
    need(len(transport_lines) == 2 and all(transport_lines), 'full outer stdout must contain exactly the recorder and driver transport records; unexpected stdio cannot be suppressed')
    transport, summary = [json.loads(line) for line in transport_lines]
    keys(transport, 'receipt exit_code source_bytes_match_before_and_after', 'inner recorder stdout transport')
    same(transport['receipt'],custody['actual_command_receipt'])
    need(transport['exit_code'] == inner['exit_code'] and transport['source_bytes_match_before_and_after'] is True, 'actual inner recorder transport exit/Source differs')
    keys(summary, 'custody actual_exit_code scientific_PASS_claimed', 'driver stdout transport')
    same(summary['custody'],custody_ref)
    need(summary['actual_exit_code'] == inner['exit_code'] and summary['scientific_PASS_claimed'] is False, 'outer full stdout custody differs')"""
assert raw.count(needle)==1
raw=raw.replace(needle,replacement,1)
ast.parse(raw)
script,source=body('check.py',raw.encode())
doc,document=body('README.md',(OLD/'README.md').read_bytes()+b'\nSuccessor02 repairs the Source-only stdout transport assumption before any helper/capture attempt: the actual recorder emits its closed inner receipt transport JSON, then the driver emits its custody transport JSON. Both complete actual records, exact field sets, bound full receipt/custody identities, exits and Source guard are authenticated in order. Extra/blank/non-JSON lines are not discarded or treated as success. All full stdout bytes remain hashed, and all numerical/owner/release checks are unchanged01.\n')
m=copy.deepcopy(json.loads((OLD/'manifest.json').read_bytes()))
m.update(accepted_predecessor=ref(OLD/'manifest.json'),predecessor_own_sources=m['own_sources'],own_sources=[script,doc,ref(Path(__file__))],initial_source_correspondence=m['source_correspondence'],source_correspondence=source,document_correspondence=document)
m['runtime_interfaces']['checker']=script
print(json.dumps(write(OUT/'manifest.json',(json.dumps(m,ensure_ascii=False,allow_nan=False,indent=2)+'\n').encode())))

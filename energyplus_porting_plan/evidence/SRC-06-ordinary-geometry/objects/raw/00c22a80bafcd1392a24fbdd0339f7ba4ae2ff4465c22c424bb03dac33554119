"""Preserve failed02; qualify the actual Vector type and append a distinct v3 target."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD, OUT = BASE / 'ordinary-geometry-native-prep-02', BASE / 'ordinary-geometry-native-prep-03'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def correspondence(name, raw):
    before = write(OUT / 'before-02' / name, (OLD / name).read_bytes())
    proposal = write(OUT / name, raw)
    diff = write(OUT / 'diffs' / (name + '.diff'), ''.join(difflib.unified_diff((OLD / name).read_text(encoding='utf8').splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=proposal['path'])).encode())
    return proposal, dict(before=before, proposal=proposal, exact_diff=diff, fromfile=before['path'], tofile=proposal['path'])


prior = ref(OLD / 'manifest.json'); assert prior['sha256'] == '4a172ac50b50fd2151baa818919b1a51b496488afe2a2bc80ea3ce3b984cf1f4'
old = json.loads((OLD / 'manifest.json').read_bytes())
failed = ref(BASE / 'ordinary-geometry-compile-command-01/receipt.json')
assert failed['sha256'] == 'fe57daf395aeb54ac7e2e238a854adcb64e90e97de06354b86f43585749a8950'
failure = json.loads((ROOT / failed['path']).read_bytes())
assert failure['exit_code'] == 1 and failure['launch_error'] is None and failure['finished_utc'] is not None and failure['source_bytes_match_before_and_after'] is True
sources, differences = [], []
for row in old['own_sources']:
    before = ROOT / row['path']; raw = before.read_bytes(); assert hashlib.sha256(raw).hexdigest() == row['sha256']
    if before.name == 'geo02_reference_fields.hh':
        assert raw.count(b'EnergyPlus::Vector const &v') == 1
        raw = raw.replace(b'#include <EnergyPlus/DataSurfaces.hh>', b'#include <EnergyPlus/DataSurfaces.hh>\n#include <EnergyPlus/DataVectorTypes.hh>', 1)
        raw = raw.replace(b'EnergyPlus::Vector const &v', b'EnergyPlus::DataVectorTypes::Vector const &v', 1)
    if before.name == 'geometry_loader.cmake':
        raw = raw.replace(b'GEOMETRY_LOADER_', b'GEOMETRY_LOADER_V3_').replace(b'_geometry_loader_', b'_geometry_loader_v3_').replace(b'geometry_loader_add_reference', b'geometry_loader_v3_add_reference').replace(b'geometry_loader_helper', b'geometry_loader_helper_v3')
        # The physical same-parent TU remains byte-exact; only the target is new.
        raw = raw.replace(b'/geometry_loader_helper_v3.cpp', b'/geometry_loader_helper.cpp')
    source, diff = correspondence(before.name, raw); sources.append(source); differences.append(diff)
request = json.loads((OLD / 'request.proposed.json').read_bytes()); request['native_source_files'] = sources
request_ref, request_diff = correspondence('request.proposed.json', (json.dumps(request, indent=2) + '\n').encode()); differences.append(request_diff)
readme = (OLD / 'README.md').read_text(encoding='utf8')
readme += '\nSuccessor03 preserves failed02 and the actual closed compile failure. The copied GEO02 vector copier now explicitly includes DataVectorTypes.hh and names the actual EnergyPlus::DataVectorTypes::Vector typedef; no copy fields, formulas, loader order, input literals or result schema changed. Working genuine GEO02 native-build02 used this qualified type already. The same-parent helper and four other headers remain byte exact02. Recipe03 appends only a unique geometry_loader_helper_v3 target, GEOMETRY_LOADER_V3 variables/global once guard and geometry_loader_v3_add_reference function, preserving the configured failed02 target and complete inherited graph. Its source basename remains geometry_loader_helper.cpp. Request changes only six same-parent Source descriptors. No configure, target, helper, result or canonical/Git action occurred during preparation.\n'
doc, doc_diff = correspondence('README.md', readme.encode()); differences.append(doc_diff)
whole = ref(ROOT / '.reference/energyplus-src/26.1.0/src/EnergyPlus/DataVectorTypes.hh')
raw_range = b''.join((ROOT / whole['path']).read_bytes().splitlines(keepends=True)[62:90])
literal = write(OUT / 'ranges/DataVectorTypes.hh.63-90.literal', raw_range)
new = copy.deepcopy(old)
new.update(own_sources=sources, authoring_source=ref(Path(__file__)), README=doc, prospective_request=request_ref, previous_preparation=prior, authentic_before_manifest=write(OUT / 'before-02/manifest.json', (OLD / 'manifest.json').read_bytes()), incremental_correspondence=differences, prior_incremental_correspondence=old['incremental_correspondence'], prior_authoring_source=old['authoring_source'], unchanged_helper_fields_and_copied_headers=False, unchanged_helper_primary_fields_and_other_two_copied_headers=True, declared_transport_only_type_correction=True, retained_failed_compile_execution=failed, retained_failed_compile_logs=[failure['stdout'], failure['stderr']], previous_configured_target_retained='geometry_loader_helper', independent_successor_target='geometry_loader_helper_v3', genuine_qualified_Vector_precedent=ref(ROOT / '.runtime/porting/GEO-02/native-build-02/source/geo02_reference_fields.hh'))
new['Source_ranges'].append(dict(path=whole['path'], whole_Source=whole, start_line=63, end_line=90, sha256=literal['sha256'], size_bytes=literal['size_bytes'], literal_archive=literal, purpose='actual nested namespace and Objexx Vector3<Real64> typedef used by read-only copier'))
new['whole_Original_sources'].append(whole)
new['runtime_interfaces'].update(target='geometry_loader_helper_v3', argv=['geometry_loader_helper_v3.exe', 'repository-root', 'request-path', 'fresh-contained-SRC06-output'], CMake_Source_directory_variable='GEOMETRY_LOADER_V3_SOURCE_DIR', inherited_recipe_variable='GEOMETRY_LOADER_V3_INHERITED_RECIPE')
for key in request:
    if key != 'native_source_files': assert request[key] == json.loads((OLD / 'request.proposed.json').read_bytes())[key]
assert sources[0]['sha256'] == old['own_sources'][0]['sha256']
ast.parse(Path(__file__).read_bytes())
print(json.dumps(write(OUT / 'manifest.json', (json.dumps(new, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())))

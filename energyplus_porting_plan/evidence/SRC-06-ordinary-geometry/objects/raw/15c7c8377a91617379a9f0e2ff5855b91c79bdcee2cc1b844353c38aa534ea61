ROOT = Path(__file__).resolve().parents[4]
OUT = ROOT / 'energyplus_porting_plan/evidence/SRC-06-ordinary-geometry'
SEEN, ROLES, PROVENANCE, CONVERTER_LOGS = {}, {}, [], {}


def need(value, message):
    if not value: raise ValueError(message)


def digest(path):
    with path.open('rb') as stream: return hashlib.file_digest(stream, 'sha256').hexdigest()


def full(path): return dict(path=path.relative_to(ROOT).as_posix(), sha256=digest(path), size_bytes=path.stat().st_size)


def checked(row, external=False):
    path = (ROOT / row['path']).resolve()
    need(path.is_file() and (path.is_relative_to(ROOT) or external and path.is_relative_to(Path('D:/CodexBuild/rusted-energyplus/SRC-06/ordinary-geometry-native-build-03/bin'))), 'contained selected artifact or declared v4 binary/map required')
    need(digest(path) == row['sha256'] and ('size_bytes' not in row or path.stat().st_size == row['size_bytes']), 'full actual SHA/size differs: ' + row['path'])
    SEEN[path] = (row['sha256'], path.stat().st_size); return path


def unique(pairs):
    value = {}
    for key, row in pairs: need(key not in value, 'duplicate metadata JSON key'); value[key] = row
    return value


def load(row): return json.loads(checked(row).read_bytes(), object_pairs_hook=unique)


def same(a, b): need(checked(a) == checked(b), 'artifact path/SHA/size identity differs')


def select(row, role):
    path = checked(row)
    if path in CONVERTER_LOGS: need(full(path) == CONVERTER_LOGS[path], 'exact closed input-converter child log differs')
    elif path.name in ['stdout.log', 'stderr.log']:
        sibling = path.parent / 'receipt.json'; need(sibling.is_file(), 'active/unrecorded standard log cannot be selected')
        value = load(full(sibling)); need(value['schema'] == 'recorded-porting-command.v1' and value['finished_utc'] is not None and value['launch_error'] is None, 'closed sibling recorder receipt required')
        same(value['stdout' if path.name == 'stdout.log' else 'stderr'], row)
    ROLES.setdefault(path, set()).add(role)


def receipt(row, role, source=None, allowed=(0,), argv=None, stable=True, recorder=None):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] in allowed and value['launch_error'] is None and value['finished_utc'] is not None and value['started_utc'] <= value['finished_utc'], 'closed genuine actual command required')
    need(value['source_bytes_match_before_and_after'] is stable and value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'actual command Source/scope guard differs')
    if source is not None: same(value['source_snapshot'], source)
    if argv is not None: need(value['command'] == argv, 'actual role argv differs')
    need(checked(value['executed_launcher']['archive']).read_bytes() == checked(recorder or PREP['recorder_Source']).read_bytes(), 'authentic archived recorder Source differs')
    for item in [row, value['stdout'], value['stderr'], value['executed_launcher']['archive']]: select(item, role)
    return value


def provenance(row, reason, metadata=False, current=False):
    if metadata or current: checked(row, external=current)
    PROVENANCE.append(dict(artifact=row, reason=reason, payload_published=False, current_payload_rehashed_by_publisher=current, metadata_file_rehashed_by_publisher=metadata, payload_availability='current-full-SHA-verified' if current else 'metadata-only-no-current-payload-claim'))


def snapshot(row, current=False):
    value = load(row); names = [r['historical_path'] for r in value['files']]
    need(len(names) == len(set(names)) and value['bytes_normalized'] is False, 'complete unique byte-exact Source snapshot required')
    for item in value['files']:
        archive = checked(item['archive']); need(archive.stat().st_size == item['size_bytes'], 'whole Source archive size differs')
        if current: checked(dict(path=item['historical_path'], sha256=item['archive']['sha256'], size_bytes=item['size_bytes']))
    provenance(row, 'whole-Source-snapshot-descriptor-only; all archived members authenticated', metadata=True)


def source_preparation(row, role):
    value = load(row); select(row, role)
    for item in value.get('own_sources', []): select(item, role + ':owned-Source')
    for key in ['README', 'author_source', 'authoring_Source', 'authoring_source']:
        if key in value: select(value[key], role + ':document')
    for item in value.get('application_sources', []):
        for key in ['proposal', 'exact_diff']: select(item[key], role + ':held-application')
        if not item['new_destination_absent']: select(item['before_archive'], role + ':held-before')
    for family, key in [('Source_ranges', 'literal_archive'), ('Source_context_ranges', 'literal_archive'), ('literal_Source_ranges', 'literal_archive'), ('Original_helper_ranges', 'literal_archive'), ('Original_provider_entry_ranges', 'archive'), ('Original_owner_ranges', 'literal_archive'), ('selected_source_ranges', 'archive')]:
        for item in value.get(family, []): select(item[key], role + ':literal-range')
    for family in ['source_correspondence', 'incremental_correspondence', 'prior_incremental_correspondence', 'inherited_source_correspondence', 'previous_source_correspondence', 'narrow_source_correspondence', 'previous_narrow_source_correspondence']:
        for item in value.get(family, []):
            for key in ['before', 'before_proposal', 'before_archive', 'proposal', 'exact_diff']:
                if isinstance(item.get(key), dict) and {'path', 'sha256'} <= set(item[key]): select(item[key], role + ':exact-Source-correspondence')
    return value



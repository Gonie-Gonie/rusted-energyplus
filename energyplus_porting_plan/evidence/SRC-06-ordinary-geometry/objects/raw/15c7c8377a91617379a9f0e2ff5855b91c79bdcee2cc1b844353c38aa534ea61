    proof = context['conversion_proof_bindings']; need(len(proof) == 6, 'complete input-only conversion proof required')
    ledger, child = load(proof[0]), load(proof[2]); outer = receipt(proof[1], 'historical-input-only-converter', recorder=comparer['historical_conversion_recorder_Source'])
    need(load(outer['stdout']) == ledger and child['schema'] == 'sch01-input-conversion-command.v1' and child['exit_code'] == 0 and child['launch_error'] is None and child['finished_utc'] is not None, 'authentic closed input-only conversion required')
    need(outer['started_utc'] <= child['started_utc'] <= child['finished_utc'] <= outer['finished_utc'] and all(child[k] is False for k in ['numerical_engine_executed', 'Native_scientific_outputs_used_as_inputs', 'expected_answers_supplied']), 'actual conversion chronology/input-only role differs')
    for key, expected in zip(['stdout', 'stderr'], proof[4:]):
        same(child[key], expected); need(child[key] in child['actual_output_inventory'], 'closed child log inventory differs'); CONVERTER_LOGS[checked(expected)] = full(checked(expected))
    for item in proof + child['actual_output_inventory'] + [context['input'], context['epjson_input'], context['Native_input_request']]: select(item, 'complete-input-only-conversion')
    for item in ledger['executed_runner_sources']: select(item['archive'], 'authentic-historical-conversion-Source')
    provenance(child['converter'], 'historical-converter-executable-hash-only')



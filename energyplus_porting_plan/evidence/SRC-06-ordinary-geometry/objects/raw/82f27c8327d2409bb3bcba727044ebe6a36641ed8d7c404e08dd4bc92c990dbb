"""Run the authenticated real input converter only, before scientific packet freeze."""
import argparse
from datetime import datetime, timezone
import hashlib
import importlib.util
import json
from pathlib import Path
import subprocess

PREP = Path(__file__).resolve().parent
COMMON_SHA = 'b38466a0dd8851935d0ef28c079220d7c48f2c05506926d1ad4e7fb463f6de77'


def utc():
    return datetime.now(timezone.utc).isoformat()


def common():
    file = PREP / 'input_common.py'
    if hashlib.sha256(file.read_bytes()).hexdigest() != COMMON_SHA:
        raise ValueError('Reviewed input-only metadata source differs')
    spec = importlib.util.spec_from_file_location('input_common', file)
    value = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(value)
    return value


def convert(m, row, converter, converter_ref, out):
    case = out / row['id']
    case.mkdir()
    original = m.checked(row['input'])
    staged = case / 'input.idf'
    raw = original.read_bytes()
    staged.write_bytes(raw)
    command = [str(converter), staged.name]
    started, launch_error, code = utc(), None, None
    try:
        process = subprocess.run(command, cwd=case, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 creationflags=subprocess.CREATE_NO_WINDOW)
        stdout, stderr, code = process.stdout, process.stderr, process.returncode
    except OSError as error:
        stdout, stderr, launch_error = b'', b'', str(error)
    finished = utc()
    (case / 'stdout.log').write_bytes(stdout)
    (case / 'stderr.log').write_bytes(stderr)
    m.need(staged.read_bytes() == raw and original.read_bytes() == raw, 'Actual original/staged IDF changed during conversion')
    output = case / 'input.epJSON'
    available, unavailable_reason, epjson = False, None, None
    if launch_error is not None:
        unavailable_reason = 'actual converter launch failed'
    elif code != 0:
        unavailable_reason = 'actual converter returned nonzero'
    elif not output.is_file():
        unavailable_reason = 'actual converter returned zero without epJSON output'
    else:
        # This is an input-document check, not an Original numerical operand.
        try:
            m.need(output.stat().st_size <= 16 * 1024 * 1024, 'Converted input exceeds declared bound')
            m.path(output)
            value = json.loads(output.read_text(encoding='utf-8'))
            m.need(type(value) is dict, 'Converted epJSON input must be an object')
        except (ValueError, UnicodeError) as error:
            unavailable_reason = 'actual converted input failed JSON admission: ' + str(error)
        else:
            available, epjson = True, m.ref(output)
    files = []
    for file in sorted(case.rglob('*')):
        m.path(file)
        if file.is_file():
            m.need(file.stat().st_size <= 16 * 1024 * 1024, 'Actual converter artifact exceeds declared bound')
            binding = m.ref(file)
            m.checked(binding)
            files.append(binding)
    execution = {'schema': 'sch01-input-conversion-command.v1', 'case_id': row['id'],
                 'command': command, 'cwd': case.relative_to(m.ROOT).as_posix(), 'started_utc': started,
                 'finished_utc': finished, 'exit_code': code, 'launch_error': launch_error,
                 'converter': converter_ref, 'source_input': row['input'], 'staged_input': m.ref(staged),
                 'stdout': m.ref(case / 'stdout.log'), 'stderr': m.ref(case / 'stderr.log'),
                 'available_epjson_input': epjson, 'epjson_available': available,
                 'unavailable_reason': unavailable_reason, 'actual_output_inventory': files,
                 'original_and_staged_IDF_preserved': True, 'numerical_engine_executed': False,
                 'Native_scientific_outputs_used_as_inputs': False, 'expected_answers_supplied': False}
    m.write_json(case / 'conversion.json', execution)
    execution_ref = m.ref(case / 'conversion.json')
    m.checked(execution_ref)
    return {'case_id': row['id'], 'input': row['input'], 'epjson_input': epjson, 'available': available,
            'actual_conversion_execution': execution_ref,
            'status': 'actual-converted-input-available' if available else 'actual-conversion-input-unavailable',
            'unavailable_reason': unavailable_reason}


def main():
    parser = argparse.ArgumentParser()
    for name in ['approved-source-sha256', 'input-cases', 'converter', 'output-dir']:
        parser.add_argument('--' + name, required=True)
    args = parser.parse_args()
    started, m = utc(), common()
    m.need(m.sha(Path(__file__).resolve()) == args.approved_source_sha256, 'Root-reviewed converter-runner source required')
    sources = [m.ref(PREP / name) for name in ['convert_inputs.py', 'input_common.py']]
    for row in sources:
        m.checked(row)
    input_ref, converter_ref = m.argument(args.input_cases), m.argument(args.converter)
    inputs = m.read(input_ref)
    m.need(inputs['schema'] == 'sch01-input-cases.v1' and inputs['scientific_execution_performed'] is False
           and inputs['expected_values_supplied'] is False and inputs['expected_exits_supplied'] is False
           and inputs['final_scientific_packet_frozen'] is False, 'Actual input-only pre-freeze cases required')
    models = inputs['model_cases']
    m.need(type(models) is list and models and len(models) <= 256
           and len({r['id'] for r in models}) == len(models), 'Bounded unique actual input cases required')
    converter = m.checked(converter_ref, maximum=512 * 1024 * 1024)
    m.need(converter == m.path('.runtime/energyplus/26.1.0/ConvertInputFormat.exe'), 'Actual existing production converter required')
    for row in models:
        m.need(type(row['id']) is str and row['id'] and len(row['id']) <= 80
               and all(c.isascii() and (c.isalnum() or c in '-_') for c in row['id']), 'Bounded safe model ID required')
        m.need(m.checked(row['input']).suffix == '.idf', 'Original raw IDF input required')
    m.unchanged()
    out = m.fresh_output(args.output_dir)
    (out / 'sources').mkdir()
    source_copies = []
    for binding in sources:
        target = out / 'sources' / Path(binding['path']).name
        target.write_bytes(m.checked(binding).read_bytes())
        source_copies.append({'historical_path': binding['path'], 'archive': m.ref(target)})
    conversions = []
    for row in models:
        conversions.append(convert(m, row, converter, converter_ref, out))
    m.unchanged()
    result = {'schema': 'sch01-converted-inputs.v1', 'started_utc': started, 'finished_utc': utc(),
              'input_cases': input_ref, 'converter': converter_ref, 'conversion_recipe':
              'actual ConvertInputFormat.exe input.idf in each fresh case directory, matching ep_run::oracle input-only route',
              'conversions': conversions, 'case_count': len(conversions),
              'available_converted_input_count': sum(r['available'] for r in conversions),
              'unavailable_converted_input_count': sum(not r['available'] for r in conversions),
              'executed_runner_sources': source_copies, 'scientific_execution_performed': False,
              'Native_scientific_outputs_used_as_inputs': False, 'expected_values_supplied': False,
              'expected_exits_supplied': False, 'failed_conversions_counted_as_PASS': False,
              'outer_zero_means_factual_input_conversion_ledger_complete': True,
              'all_conversions_successful_claimed': all(r['available'] for r in conversions),
              'final_scientific_packet_frozen': False, 'gates_updated': False}
    m.emit(out, 'converted-inputs.json', result)


if __name__ == '__main__':
    main()

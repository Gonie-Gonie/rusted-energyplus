namespace GeometryLoader {
using Ctf01::json;
using Ctf01::scalar;

template<class Array> json epvector_shape(Array const &array)
{
    return {{"container", "EnergyPlus::EPVector"}, {"allocated", array.allocated()}, {"size", array.size()},
            {"operator_parentheses_indexing", "one-based; zero is not an allocated member"}};
}
inline json counters(EnergyPlus::EnergyPlusData const &state, bool input_errors)
{
    auto const &error = *state.dataErrTracking;
    return {{"loader_ErrorsFound", input_errors}, {"AbortProcessing", error.AbortProcessing},
        {"TotalSevereErrors", error.TotalSevereErrors}, {"TotalWarningErrors", error.TotalWarningErrors},
        {"TotalSevereErrorsDuringWarmup", error.TotalSevereErrorsDuringWarmup},
        {"TotalWarningErrorsDuringWarmup", error.TotalWarningErrorsDuringWarmup},
        {"TotalSevereErrorsDuringSizing", error.TotalSevereErrorsDuringSizing},
        {"TotalWarningErrorsDuringSizing", error.TotalWarningErrorsDuringSizing},
        {"TotalCoincidentVertices", error.TotalCoincidentVertices}, {"TotalDegenerateSurfaces", error.TotalDegenerateSurfaces},
        {"LastSevereError", error.LastSevereError}, {"NumOfZones", state.dataGlobal->NumOfZones},
        {"numSpaces", state.dataGlobal->numSpaces}, {"TotSurfaces", state.dataSurface->TotSurfaces},
        {"Zone_allocation", epvector_shape(state.dataHeatBal->Zone)},
        {"space_allocation", epvector_shape(state.dataHeatBal->space)},
        {"Surface_allocation", epvector_shape(state.dataSurface->Surface)},
        {"TimeStepsInHour", state.dataGlobal->TimeStepsInHour}, {"MinutesInTimeStep", state.dataGlobal->MinutesInTimeStep},
        {"TimeStepZone", scalar(state.dataGlobal->TimeStepZone)}, {"TimeStepZoneSec", scalar(state.dataGlobal->TimeStepZoneSec)},
        {"isEpJSON", state.dataGlobal->isEpJSON}, {"preserveIDFOrder", state.dataGlobal->preserveIDFOrder},
        {"DoingInputProcessing", state.dataGlobal->DoingInputProcessing}, {"printConsoleOutput", state.dataGlobal->printConsoleOutput},
        {"outputErrorHeader", state.dataUtilityRoutines->outputErrorHeader}, {"VerStringVar", state.dataStrGlobals->VerStringVar},
        {"IDDVerString", state.dataStrGlobals->IDDVerString}, {"optional_SQLite_present", state.dataSQLiteProcedures->sqlite != nullptr}};
}
inline json family_counts(EnergyPlus::EnergyPlusData const &state)
{
    json counts = json::object();
    // Read the actual processInput output. Do not parse IDF or invoke extra getters.
    for (auto const &[name, values] : state.dataInputProcessing->inputProcessor->epJSON.items())
        counts[name] = {{"actual_json_type", values.type_name()}, {"actual_size", values.size()}};
    return counts;
}
inline json zone(EnergyPlus::DataHeatBalance::ZoneData const &owner, int index)
{
    auto row = Geo03::zone(owner, index);
    row["bounds_m"] = {scalar(owner.MinimumX), scalar(owner.MaximumX), scalar(owner.MinimumY),
                       scalar(owner.MaximumY), scalar(owner.MinimumZ), scalar(owner.MaximumZ)};
    row["exterior_areas"] = {{"ExtGrossWallArea", scalar(owner.ExtGrossWallArea)}, {"ExtNetWallArea", scalar(owner.ExtNetWallArea)},
        {"ExtWindowArea", scalar(owner.ExtWindowArea)}, {"ExtWindowArea_Multiplied", scalar(owner.ExtWindowArea_Multiplied)},
        {"ExtGrossWallArea_Multiplied", scalar(owner.ExtGrossWallArea_Multiplied)}, {"ExteriorTotalSurfArea", scalar(owner.ExteriorTotalSurfArea)},
        {"ExteriorTotalGroundSurfArea", scalar(owner.ExteriorTotalGroundSurfArea)}, {"ExtGrossGroundWallArea", scalar(owner.ExtGrossGroundWallArea)},
        {"ExtGrossGroundWallArea_Multiplied", scalar(owner.ExtGrossGroundWallArea_Multiplied)}, {"extPerimeter", scalar(owner.extPerimeter)},
        {"TotalSurfArea", scalar(owner.TotalSurfArea)}};
    row["HasWindow"] = owner.HasWindow; row["Multiplier"] = owner.Multiplier; row["ListMultiplier"] = owner.ListMultiplier;
    return row;
}
inline json space(EnergyPlus::DataHeatBalance::SpaceData const &owner, int index)
{
    auto row = Geo03::space(owner, index);
    row["surface_membership_allocation"] = epvector_shape(owner.surfaces);
    row["HTSurfaceFirst"] = owner.HTSurfaceFirst; row["HTSurfaceLast"] = owner.HTSurfaceLast;
    row["OpaqOrIntMassSurfaceFirst"] = owner.OpaqOrIntMassSurfaceFirst;
    row["OpaqOrIntMassSurfaceLast"] = owner.OpaqOrIntMassSurfaceLast;
    row["WindowSurfaceFirst"] = owner.WindowSurfaceFirst; row["WindowSurfaceLast"] = owner.WindowSurfaceLast;
    row["exterior_areas"] = {{"ExtGrossWallArea", scalar(owner.ExtGrossWallArea)}, {"ExteriorTotalSurfArea", scalar(owner.ExteriorTotalSurfArea)},
        {"extPerimeter", scalar(owner.extPerimeter)}, {"extWindowArea", scalar(owner.extWindowArea)}, {"totalSurfArea", scalar(owner.totalSurfArea)}};
    return row;
}
inline json surface(EnergyPlus::DataSurfaces::SurfaceData const &owner, int index)
{
    bool const written = owner.VerticesProcessed && owner.Sides > 2 && owner.Vertex.allocated() && owner.Vertex.isize() >= owner.Sides;
    json row = {{"id", index}, {"name", owner.Name}, {"zone_id", owner.Zone}, {"zone_name", owner.ZoneName}, {"space_id", owner.spaceNum},
        {"class", static_cast<int>(owner.Class)}, {"construction_id", owner.Construction}, {"base_surface", owner.BaseSurf},
        {"outside_boundary", owner.ExtBoundCond}, {"heat_transfer_surface", owner.HeatTransSurf}, {"air_boundary_surface", owner.IsAirBoundarySurf},
        {"sides", owner.Sides}, {"vertex_allocation", {{"allocated", owner.Vertex.allocated()}, {"size", owner.Vertex.size()},
            {"lower", owner.Vertex.allocated() ? json(owner.Vertex.l()) : json(nullptr)},
            {"upper", owner.Vertex.allocated() ? json(owner.Vertex.u()) : json(nullptr)}}}, {"vertices_processed", owner.VerticesProcessed},
        {"shape", static_cast<int>(owner.Shape)}, {"is_degenerate", owner.IsDegenerate}, {"is_convex", owner.IsConvex},
        {"perimeter_m", scalar(owner.Perimeter)}, {"width_m", scalar(owner.Width)}, {"height_m", scalar(owner.Height)},
        {"geometry_values_observed", written}, {"geometry", nullptr}, {"world_vertex_bits", nullptr},
        {"unavailable_reason", written ? json(nullptr) : json("actual_vertex_processing_or_complete_vertex_storage_not_available")}};
    // Non-debug Vector3 defaults can be unwritten: allocation is insufficient.
    if (written) { row["geometry"] = Geo02::geometry(owner); row["world_vertex_bits"] = Geo02::vertex_bits(owner); }
    return row;
}
inline json returned_geometry(EnergyPlus::EnergyPlusData const &state)
{
    json zones = json::array(), spaces = json::array(), surfaces = json::array();
    for (int i = 1; i <= state.dataHeatBal->Zone.isize(); ++i) zones.push_back(zone(state.dataHeatBal->Zone(i), i));
    for (int i = 1; i <= state.dataHeatBal->space.isize(); ++i) spaces.push_back(space(state.dataHeatBal->space(i), i));
    for (int i = 1; i <= state.dataSurface->Surface.isize(); ++i) surfaces.push_back(surface(state.dataSurface->Surface(i), i));
    return {{"capture_boundary", "returned HeatBalanceManager::GetBuildingData with actual loader_ErrorsFound false"},
        {"zones", zones}, {"spaces", spaces}, {"surfaces", surfaces}, {"actual_parsed_input_family_counts", family_counts(state)},
        {"geometry_context", Geo03::globals(state)}, {"floating_environment", Geo02::floating_environment()},
        {"internal_GetZoneData_SetupZoneGeometry_call_boundaries_individually_observed", false},
        {"values_reconstructed_from_vertices_or_Rust", false}};
}
} // namespace GeometryLoader
#endif

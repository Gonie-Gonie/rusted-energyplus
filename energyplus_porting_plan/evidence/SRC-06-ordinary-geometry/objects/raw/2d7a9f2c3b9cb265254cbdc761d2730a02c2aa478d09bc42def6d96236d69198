def ref(path):
    path = path.resolve()
    with path.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path), sha256=digest, size_bytes=path.stat().st_size)


def checked(row):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT) or any(path.is_relative_to(Path(name)) for name in ['D:/CodexBuild/rusted-energyplus/SRC-06/native-dispatcher-build-01/bin', 'D:/CodexBuild/rusted-energyplus/SRC-06/ordinary-geometry-native-build-03/bin'])
    actual = SEEN.get(path)
    if actual is None:
        actual = ref(path); SEEN[path] = actual
    assert actual['sha256'] == row['sha256'] and all(k not in row or row[k] == actual['size_bytes'] for k in ('size_bytes', 'bytes'))
    return path


def load(row):
    return json.loads(checked(row).read_bytes())


def operand(text):
    name, digest = text.rsplit('#', 1)
    path = checked(dict(path=name, sha256=digest))
    return ref(path)


def collect(value):
    if isinstance(value, dict):
        if 'path' in value and 'sha256' in value:
            checked(value)
        for child in value.values(): collect(child)
    elif isinstance(value, list):
        for child in value: collect(child)


def historical_configure(freeze):
    # Only these explicitly named aliases belong to the inherited8aa/3929 build, with explicit nested D362/3928 archives.
    previous = load(freeze['inherited_frozen_build_inputs'])
    old_source = load(previous['Source_snapshot'])
    assert old_source['schema'] == 'rust-command-source-snapshot.v1' and old_source['bytes_normalized'] is False
    rows = {r['historical_path']: r for r in old_source['files']}
    assert len(rows) == len(old_source['files']) == 3929
    aliases = []
    for row in previous['frozen_Source_and_input']:
        if row['path'] in rows:
            old = rows[row['path']]
            assert row['sha256'] == old['archive']['sha256'] and row['size_bytes'] == old['size_bytes']
            checked(old['archive']); aliases.append(dict(historical=row, actual_archive=old['archive']))
        else:
            checked(row)
    assert len(aliases) == len(rows) and {r['historical']['path'] for r in aliases} == set(rows)
    assert freeze['inherited_historical_BUILD_Source_aliases'] == aliases
    nested = previous['inherited_historical_BUILD_Source_aliases']
    assert freeze['prior_nested_historical_BUILD_Source_aliases'] == nested and len(nested) == 3928
    for row in nested:
        archive = checked(row['actual_archive'])
        assert row['historical']['sha256'] == row['actual_archive']['sha256'] and row['historical']['size_bytes'] == ref(archive)['size_bytes']
    collect({k: v for k, v in previous.items() if k not in ['frozen_Source_and_input', 'inherited_historical_BUILD_Source_aliases']})
    collect({k: v for k, v in freeze.items() if k not in ['inherited_historical_BUILD_Source_aliases', 'prior_nested_historical_BUILD_Source_aliases']})
    return aliases


def dump(path, value):
    with path.open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())


def receipt(row):
    value = load(row)
    assert value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] == 0 and value['launch_error'] is None
    assert value['source_bytes_match_before_and_after'] is True and value['source_snapshot'] == snapshot
    checked(value['stdout']); checked(value['stderr'])
    assert checked(value['executed_launcher']['archive']).read_bytes() == RECORDER.read_bytes()
    return value


def recorded(command, role):
    directory = output / role
    code = subprocess.run([sys.executable, '-X', 'utf8', '-B', str(RECORDER), '--output-dir', directory.relative_to(ROOT).as_posix(), '--', *command], cwd=ROOT).returncode
    row = ref(directory / 'receipt.json'); value = receipt(row)
    assert value['command'] == command and code == value['exit_code'] and checked(value['stderr']).stat().st_size == 0
    return row, value



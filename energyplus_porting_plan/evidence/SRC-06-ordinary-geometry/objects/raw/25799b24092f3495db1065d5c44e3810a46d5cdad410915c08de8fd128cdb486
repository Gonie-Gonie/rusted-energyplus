def full(path):
    with path.open('rb') as stream:
        sha = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path), sha256=sha, size_bytes=path.stat().st_size)


def checked(row):
    path = (ROOT / row['path']).resolve()
    assert (path.is_relative_to(ROOT) or path in PROTECTED_EXTERNAL) and path.is_file()
    actual = full(path)
    assert actual['sha256'] == row['sha256']
    assert all(key not in row or actual['size_bytes'] == row[key] for key in ('size_bytes', 'bytes'))
    PINS[path] = actual
    return path


def load(row):
    return json.loads(checked(row).read_bytes())


def collect(value):
    if isinstance(value, dict):
        if 'path' in value and 'sha256' in value:
            checked(value)
        for child in value.values():
            collect(child)
    elif isinstance(value, list):
        for child in value:
            collect(child)


def historical_configure(frozen):
    # These aliases belong to the actual inherited BUILD Source, not current Rust.
    snapshot = load(frozen['Source_snapshot'])
    assert snapshot['schema'] == 'rust-command-source-snapshot.v1' and snapshot['bytes_normalized'] is False
    rows = {r['historical_path']: r for r in snapshot['files']}
    assert len(rows) == len(snapshot['files']) == 3929
    aliases = []
    for row in frozen['frozen_Source_and_input']:
        if row['path'] in rows:
            archived = rows[row['path']]
            assert row['sha256'] == archived['archive']['sha256'] and row['size_bytes'] == archived['size_bytes']
            checked(archived['archive'])
            aliases.append(dict(historical=row, actual_archive=archived['archive']))
        else:
            checked(row)
    assert len(aliases) == len(rows) and {r['historical']['path'] for r in aliases} == set(rows)
    for alias in frozen['inherited_historical_BUILD_Source_aliases']:
        checked(alias['actual_archive'])
        assert alias['historical']['sha256'] == alias['actual_archive']['sha256'] and alias['historical']['size_bytes'] == full(checked(alias['actual_archive']))['size_bytes']
    collect({k: v for k, v in frozen.items() if k not in ['frozen_Source_and_input', 'inherited_historical_BUILD_Source_aliases']})
    return aliases


def dump(path, value):
    with path.open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode())


def source_current(snapshot):
    value = load(snapshot)
    assert value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False
    rows = {r['historical_path']: r for r in value['files']}
    paths = set((ROOT / 'crates').rglob('*.rs')) | set((ROOT / 'crates').rglob('Cargo.toml'))
    paths |= {ROOT / n for n in ('Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml') if (ROOT / n).is_file()}
    assert len(rows) == len(value['files']) and {p.relative_to(ROOT).as_posix() for p in paths} == set(rows)
    for name, row in rows.items():
        checked(row['archive'])
        checked(dict(path=name, sha256=row['archive']['sha256'], size_bytes=row['size_bytes']))


def recorded(command, role, snapshot):
    directory = RAW / role
    code = subprocess.run([sys.executable, '-X', 'utf8', '-B', str(RECORDER), '--output-dir', directory.relative_to(ROOT).as_posix(), '--', *command], cwd=ROOT).returncode
    row = full(directory / 'receipt.json'); value = load(row)
    assert value['command'] == command and value['exit_code'] == code == 0 and value['launch_error'] is None
    assert value['source_snapshot'] == snapshot and value['source_bytes_match_before_and_after'] is True
    checked(value['stdout']); checked(value['stderr'])
    assert checked(value['executed_launcher']['archive']).read_bytes() == RECORDER.read_bytes()
    return row, value



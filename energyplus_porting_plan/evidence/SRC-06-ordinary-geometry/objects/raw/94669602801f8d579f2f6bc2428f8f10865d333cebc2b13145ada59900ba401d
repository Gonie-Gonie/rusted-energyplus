include("${GEOMETRY_LOADER_V4_REFERENCE_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  function(geometry_loader_v4_place_reference)
    if(NOT TARGET geometry_loader_helper_v4 OR NOT IS_DIRECTORY "${GEOMETRY_LOADER_V4_OUTPUT_DIR}")
      message(FATAL_ERROR "Reviewed helper and prepared output directory required")
    endif()
    set_target_properties(geometry_loader_helper_v4 PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${GEOMETRY_LOADER_V4_OUTPUT_DIR}")
    get_target_property(_geometry_loader_v4_link_options geometry_loader_helper_v4 LINK_OPTIONS)
    list(REMOVE_ITEM _geometry_loader_v4_link_options "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/geometry_loader_helper_v4.map")
    set_property(TARGET geometry_loader_helper_v4 PROPERTY LINK_OPTIONS "${_geometry_loader_v4_link_options}")
    target_link_options(geometry_loader_helper_v4 PRIVATE "-Wl,-Map,${GEOMETRY_LOADER_V4_OUTPUT_DIR}/geometry_loader_helper_v4.map")
  endfunction()
  cmake_language(DEFER CALL geometry_loader_v4_place_reference)
endif()

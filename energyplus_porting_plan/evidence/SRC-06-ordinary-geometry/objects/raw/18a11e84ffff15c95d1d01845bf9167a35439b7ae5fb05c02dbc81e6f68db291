"""Release a genuine returned Native04 baseline only after both complete factual reviews."""
import argparse
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'

def ref(path):
    path = path.resolve()
    assert path.is_relative_to(ROOT) and path.is_file()
    with path.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=digest, size_bytes=path.stat().st_size)

def bind(row):
    path = (ROOT / row['path']).resolve()
    actual = ref(path)
    assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes'])
    return path

def load(row):
    return json.loads(bind(row).read_bytes())

def same(a, b):
    assert bind(a) == bind(b)

def operand(token):
    name, digest = token.rsplit('#', 1)
    return ref(bind(dict(path=name, sha256=digest)))

parser = argparse.ArgumentParser(description=__doc__)
for name in ('Root-review', 'independent-review', 'output-dir'):
    parser.add_argument('--' + name, required=True)
args = parser.parse_args()
proofs = [operand(args.Root_review), operand(args.independent_review)]
assert bind(proofs[0]) != bind(proofs[1]), 'two separate factual reviews required'
reviews = [load(row) for row in proofs]
first = reviews[0]
for review in reviews:
    assert review['schema'] == 'ordinary-geometry-Native-factual-review.v1'
    assert review['accepted'] is True and review['baseline_releasable'] is True
    assert review['actual_returned_loader_calls'] == review['lifecycle_records'] == 13 and review['actual_helper_exit_code'] == 0
    assert review['actual_Source_file_count'] == 3937 and review['full_input_guard_count'] == 45 and review['complete_diagnostic_file_count'] == 14
    assert review['all_full_SHA_and_frozen_before_after_accepted'] is True and review['full_physical_file_and_prefix_bytes_accepted'] is True
    assert all(review[k] is False for k in ('inner_invocation_trace_claimed', 'FP_controls_written', 'numerical_comparison_performed', 'scientific_PASS_claimed', 'whole_geometry_or_ordinary_PASS_claimed', 'gates_updated'))
    for key in ('actual_custody', 'actual_execution', 'actual_Root_provider_acceptance', 'actual_result', 'Source_snapshot'):
        same(review[key], first[key])
custody_ref = first['actual_custody']; custody = load(custody_ref)
before_ref = custody['actual_before']; before = load(before_ref)
assert custody['schema'] == 'ordinary-geometry-execution-custody.v1' and before['schema'] == 'ordinary-geometry-execution-before.v1'
assert custody['all_frozen_artifacts_unchanged'] is True and custody['actual_target_exit_code'] == custody['actual_recorder_exit_code'] == 0
assert custody['FP_controls_modified'] is False and custody['numerical_results_interpreted'] is False and custody['gates_updated'] is False
same(custody['actual_authoritative_result'], first['actual_result'])
same(before['Source_snapshot'], first['Source_snapshot'])
same(before['Root_provider_acceptance'], first['actual_Root_provider_acceptance'])
native = before['Source_preparation']
assert native['sha256'] == '2bcb4620c0519b2c796f96242430651d5bd6e737a5e793db4c24a6c03d9ee21b'; bind(native)
inner_ref = custody['actual_command_receipt']; inner = load(inner_ref)
assert inner['schema'] == 'recorded-porting-command.v1' and inner['exit_code'] == 0 and inner['source_bytes_match_before_and_after'] is True
assert inner['command'] == before['actual_argv'] and len(inner['command']) == 4
same(inner['source_snapshot'], before['Source_snapshot'])
result = dict(schema='ordinary-geometry-Native-baseline-acceptance.v1', accepted=True,
    complete_input_owner_prefix_and_custody_review_accepted=True, Native_Source_preparation=native, Source_snapshot=before['Source_snapshot'],
    actual_Native_execution=inner_ref, actual_custody=custody_ref, actual_before=before_ref, actual_authoritative_result=custody['actual_authoritative_result'],
    actual_provider_acceptance=before['Root_provider_acceptance'], Root_factual_review=proofs[0], independent_FULL_factual_review=proofs[1],
    actual_outer_capture_execution=first['actual_execution'], all_thirteen_actual_loader_calls_returned=True,
    whole_geometry_or_ordinary_PASS_claimed=False, gates_updated=False, release_Source=ref(Path(__file__)))
output = (ROOT / args.output_dir).resolve()
assert output.is_relative_to(BASE) and output != BASE and not output.exists()
output.mkdir(parents=True)
target = output / 'acceptance.json'
with target.open('xb') as stream:
    stream.write((json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode())
print(json.dumps(ref(target)))

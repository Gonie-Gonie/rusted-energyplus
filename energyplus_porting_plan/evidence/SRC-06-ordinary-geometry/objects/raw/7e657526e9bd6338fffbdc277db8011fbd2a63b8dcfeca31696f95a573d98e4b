# Append one unchanged-public-API caller; keep the complete inherited graph.
if(NOT DEFINED GEOMETRY_LOADER_SOURCE_DIR OR NOT DEFINED GEOMETRY_LOADER_INHERITED_RECIPE)
  message(FATAL_ERROR "Geometry loader requires reviewed Source and authentic inherited recipe")
endif()
include("${GEOMETRY_LOADER_INHERITED_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_geometry_loader_scheduled GLOBAL PROPERTY GEOMETRY_LOADER_REFERENCE_SCHEDULED)
  if(NOT _geometry_loader_scheduled)
    set_property(GLOBAL PROPERTY GEOMETRY_LOADER_REFERENCE_SCHEDULED TRUE)
    function(src06_add_dispatcher_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "Geometry loader requires unchanged Original energypluslib")
      endif()
      get_target_property(_geometry_loader_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_geometry_loader_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      list(APPEND _geometry_loader_defs ${_geometry_loader_directory_defs})
      list(FILTER _geometry_loader_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _geometry_loader_defs)
      add_executable(geometry_loader_helper "${GEOMETRY_LOADER_SOURCE_DIR}/geometry_loader_helper.cpp")
      target_include_directories(geometry_loader_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${GEOMETRY_LOADER_SOURCE_DIR}")
      target_compile_definitions(geometry_loader_helper PRIVATE ${_geometry_loader_defs})
      target_link_libraries(geometry_loader_helper PRIVATE energypluslib project_options project_fp_options project_warnings bcrypt)
      target_compile_features(geometry_loader_helper PRIVATE cxx_std_20)
      target_link_options(geometry_loader_helper PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/geometry_loader_helper.map")
    endfunction()
    cmake_language(DEFER CALL src06_add_dispatcher_reference)
  endif()
endif()

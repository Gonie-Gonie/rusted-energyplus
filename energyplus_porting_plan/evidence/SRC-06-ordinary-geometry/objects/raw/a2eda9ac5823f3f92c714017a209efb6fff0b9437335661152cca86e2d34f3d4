"""Seal v4 provider collector Source only, retaining the exact sixteen-provider contract."""
import argparse
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD, OUT = BASE / 'ordinary-geometry-provider-prep-02', BASE / 'ordinary-geometry-provider-prep-03'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def authenticated(text):
    name, digest = text.rsplit('#', 1)
    row = ref((ROOT / name).resolve()); assert row['sha256'] == digest
    return row


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def body(name, raw):
    before = write(OUT / 'before' / name, (OLD / name).read_bytes())
    after = write(OUT / name, raw)
    delta = write(OUT / (name + '.diff'), ''.join(difflib.unified_diff((OLD / name).read_text(encoding='utf8').splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=after['path'])).encode())
    return after, dict(before=before, proposal=after, exact_diff=delta)


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--Native-preparation', required=True)
parser.add_argument('--configure-preparation', required=True)
args = parser.parse_args()
prior = ref(OLD / 'manifest.json'); assert prior['sha256'] == '5804749eb0d18130331560741dd59be7849d113ca4c4602c318edc4ed655fe87'
native, configure = authenticated(args.Native_preparation), authenticated(args.configure_preparation)
assert native['path'] == '.runtime/porting/SRC-06/ordinary-geometry-native-prep-04/manifest.json'
assert configure['path'] == '.runtime/porting/SRC-06/ordinary-geometry-build-prep-04/manifest.json'
raw = (OLD / 'collect_providers.py').read_text(encoding='utf8')
replacements = [('ordinary-geometry-native-prep-03', 'ordinary-geometry-native-prep-04'), ('72f75c5242e2df7457fb9fc065b2cc1fc5922f6bb9673e6b785e145bb54f47a1', native['sha256']), ('ordinary-geometry-build-prep-03', 'ordinary-geometry-build-prep-04'), ('f5f7885c43eed8be89b558cc9b676fb4e7feeda54d6bc9b3735764336bc34fd4', configure['sha256']), ('ordinary-geometry-native-build-02', 'ordinary-geometry-native-build-03'), ('geometry_loader_helper_v3', 'geometry_loader_helper_v4')]
for before, after in replacements:
    assert before in raw, before
    raw = raw.replace(before, after)
ast.parse(raw)
script, script_diff = body('collect_providers.py', raw.encode())
contract, contract_diff = body('provider-contract.json', (OLD / 'provider-contract.json').read_bytes())
doc_text = '''# Geometry v4 provider collection - held Source

This successor changes only Native04/configure04 authority refs and the unique v4 target/fresh build03 output path. All sixteen provider roles, Original entry ranges, scalar transport, map interval selection, full PE/recorded tool byte checks, exact dry/actual two-step admission, official13534 post-build check, and current3937/inherited3929/nested3928 custody remain unchanged. The complete provider-contract.json bytes are identical to collector02.

Root supplies the actual closed configure04 freeze/review and actual v4 compile receipt through the same four options: --frozen-inputs path#SHA, --configure-review path#SHA, --build-execution path#SHA, --output-dir fresh ignored directory. This collector never executes the helper, reads numerical results, writes FP controls, or changes Source/math/policy. Static map intervals can contain adjacent local code/padding and never establish inner invocation traces.

    python -X utf8 -B .runtime/porting/SRC-06/ordinary-geometry-provider-prep-03/collect_providers.py --frozen-inputs <actual>#<SHA> --configure-review <actual>#<SHA> --build-execution <actual>#<SHA> --output-dir .runtime/porting/SRC-06/ordinary-geometry-providers-02

Successful v3 inventory and its Root/Header factual reviews remain historical proofs retained by configure04's frozen packet. They are not asserted to be the v4 artifact, and the new Constructor names/complete epJSON remain capture witnesses rather than expected numerical outputs. No collector/tool/helper has run during this Source author.
'''
doc, doc_diff = body('README.md', doc_text.encode())
m = copy.deepcopy(json.loads((OLD / 'manifest.json').read_bytes()))
m.update(accepted_predecessor=prior, predecessor_own_sources=m['own_sources'], own_sources=[script, contract, doc, ref(Path(__file__))], Native_Source_preparation=native, configure_Source_preparation=configure, previous_narrow_source_correspondence=m['narrow_source_correspondence'], narrow_source_correspondence=[script_diff, contract_diff, doc_diff])
m['dependencies'] += [prior, native, configure]
m['runtime_interfaces']['collector'] = script
for row in m['dependencies']:
    actual = ref(ROOT / row['path']); assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes'])
assert (OUT / 'provider-contract.json').read_bytes() == (OLD / 'provider-contract.json').read_bytes()
before_functions = {node.name: ast.dump(node, include_attributes=False) for node in ast.parse((OLD / 'collect_providers.py').read_text()).body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))}
after_functions = {node.name: ast.dump(node, include_attributes=False) for node in ast.parse(raw).body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))}
assert {k: v for k, v in before_functions.items() if k != 'checked'} == {k: v for k, v in after_functions.items() if k != 'checked'}
print(json.dumps(write(OUT / 'manifest.json', (json.dumps(m, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())))

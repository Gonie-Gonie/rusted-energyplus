def need(condition, message):
    if not condition:
        raise ValueError(message)


def full(path):
    path = path.resolve()
    with path.open('rb') as stream:
        sha = hashlib.file_digest(stream, 'sha256').hexdigest()
    return {'path': path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path),
            'sha256': sha, 'size_bytes': path.stat().st_size}


def bind(row):
    path = (ROOT / row['path']).resolve()
    need((path.is_relative_to(ROOT) or path.is_relative_to(EXTERNAL) or path.is_relative_to(Path('D:/CodexBuild/rusted-energyplus/SRC-06/native-dispatcher-build-01/bin'))) and path.is_file(), 'missing or out-of-scope artifact: ' + row['path'])
    actual = FROZEN.get(path)
    if actual is None:
        actual = full(path)
    need(actual['sha256'] == row['sha256'] and all(row[k] == actual['size_bytes'] for k in ('size_bytes', 'bytes') if k in row), 'bound bytes differ: ' + row['path'])
    FROZEN[path] = actual
    return path


def operand(token):
    name, sha = token.rsplit('#', 1)
    return full(bind({'path': name, 'sha256': sha}))


def load(row):
    return json.loads(bind(row).read_bytes())


def same(a, b):
    need(bind(a) == bind(b), 'artifact paths differ')


def collect(value):
    if isinstance(value, dict):
        if 'path' in value and 'sha256' in value:
            bind(value)
        for child in value.values(): collect(child)
    elif isinstance(value, list):
        for child in value: collect(child)


def historical_configure(freeze):
    # Only these explicitly named aliases belong to the inherited8aa/3929 build, with explicit nested D362/3928 archives.
    previous = load(freeze['inherited_frozen_build_inputs'])
    old_source = load(previous['Source_snapshot'])
    assert old_source['schema'] == 'rust-command-source-snapshot.v1' and old_source['bytes_normalized'] is False
    rows = {r['historical_path']: r for r in old_source['files']}
    assert len(rows) == len(old_source['files']) == 3929
    aliases = []
    for row in previous['frozen_Source_and_input']:
        if row['path'] in rows:
            old = rows[row['path']]
            assert row['sha256'] == old['archive']['sha256'] and row['size_bytes'] == old['size_bytes']
            bind(old['archive']); aliases.append(dict(historical=row, actual_archive=old['archive']))
        else:
            bind(row)
    assert len(aliases) == len(rows) and {r['historical']['path'] for r in aliases} == set(rows)
    assert freeze['inherited_historical_BUILD_Source_aliases'] == aliases
    nested = previous['inherited_historical_BUILD_Source_aliases']
    assert freeze['prior_nested_historical_BUILD_Source_aliases'] == nested and len(nested) == 3928
    for row in nested:
        archive = bind(row['actual_archive'])
        assert row['historical']['sha256'] == row['actual_archive']['sha256'] and row['historical']['size_bytes'] == full(archive)['size_bytes']
    collect({k: v for k, v in previous.items() if k not in ['frozen_Source_and_input', 'inherited_historical_BUILD_Source_aliases']})
    collect({k: v for k, v in freeze.items() if k not in ['inherited_historical_BUILD_Source_aliases', 'prior_nested_historical_BUILD_Source_aliases']})
    return aliases


def source_paths():
    paths = set((ROOT / 'crates').rglob('*.rs')) | set((ROOT / 'crates').rglob('Cargo.toml'))
    return paths | {ROOT / n for n in ('Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml') if (ROOT / n).is_file()}


def snapshot_members(row, current):
    value = load(row)
    need(value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False, 'literal complete Source snapshot required')
    members = {(ROOT / v['historical_path']).resolve(): v for v in value['files']}
    need(len(members) == len(value['files']) and all(p.is_relative_to(ROOT) for p in members), 'duplicate or escaped Source member')
    for path, member in members.items():
        bind(member['archive'])
        need(full(bind(member['archive']))['size_bytes'] == member['size_bytes'], 'Source archive size differs')
        if current:
            bind({'path': str(path), 'sha256': member['archive']['sha256'], 'size_bytes': member['size_bytes']})
    if current:
        need(set(members) == source_paths(), 'full current Source membership differs')
    return members


def recorded(row, source):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] == 0 and value['launch_error'] is None and value['source_bytes_match_before_and_after'] is True, 'closed successful guarded provenance command required')
    same(value['source_snapshot'], source)
    need(bind(value['executed_launcher']['archive']) == bind({'path': '.runtime/porting/source-objects/57/' + RECORDER_SHA, 'sha256': RECORDER_SHA}), 'authentic recorder required')
    bind(value['stdout']); bind(value['stderr'])
    need(value['finished_utc'] is not None, 'closed command required')
    return value


def write(path, value):
    with path.open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode('utf-8'))



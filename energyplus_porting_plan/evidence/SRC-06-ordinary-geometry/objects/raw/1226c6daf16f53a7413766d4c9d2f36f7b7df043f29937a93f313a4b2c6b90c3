def raw_input(I, rust, context, ledger):
    original, converted = exact(context['input']).read_bytes(), exact(context['epjson_input']).read_bytes()
    need(rust['complete_input']['original_IDF'] == original.decode('utf8') and rust['complete_input']['converted_epJSON'] == converted.decode('utf8'), 'complete actual original/converted input witness differs')
    epjson = json.loads(converted, object_pairs_hook=unique); raw = rust['complete_input']['RawModel']; keys(raw, ['version', 'object_count', 'object_type_counts', 'families'])
    need(ledger['original_IDF_sha256'] == context['input']['sha256'] and ledger['converted_epJSON_sha256'] == context['epjson_input']['sha256'], 'frozen literal identity ledger differs')
    need(raw['object_count'] == sum(len(v) for v in epjson.values()) and raw['object_type_counts'] == {k: len(v) for k, v in epjson.items()} and raw['version'] == next(iter(epjson['Version'].values()))['version_identifier'], 'complete Raw count/version differs')
    need([r['object_type'] for r in raw['families']] == sorted(epjson), 'complete actual Raw family order differs')
    for family in raw['families']:
        keys(family, ['object_type', 'has_IDF_declaration_order', 'actual_ordered_instances']); kind = family['object_type']; expected = ledger['effective_IDF_order'].get(kind); rows = family['actual_ordered_instances']
        need(family['has_IDF_declaration_order'] is (expected is not None) and [r['name'] for r in rows] == ([v['name'] for v in expected] if expected is not None else sorted(epjson[kind])), 'actual Raw effective IDF order differs')
        for index, row in enumerate(rows):
            keys(row, ['vector_index', 'name', 'source_span', 'fields']); need(row['vector_index'] == index and row['source_span'] is None, 'actual epJSON Raw index/span differs')
            fields = row['fields']; need([v['name'] for v in fields] == sorted({v['name'] for v in fields}), 'complete Raw field order/uniqueness differs')
            for field in fields: keys(field, ['name', 'value'])
            supplied = dict(epjson[kind][row['name']])
            if kind in ledger['unnamed_report_families']: supplied['idf_max_fields'] = next(v['max_fields'] for v in expected if v['name'] == row['name'])
            need(input_equal({v['name']: I.decode_raw(v['value']) for v in fields}, supplied), 'actual full Raw values differ from converted input')
            COUNTS['Raw_fields'] += len(fields)
    return epjson, raw



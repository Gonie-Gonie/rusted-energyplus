ROOT = Path(__file__).resolve().parents[4]
SEEN, COUNTS = {}, dict(scalar_DTOs=0, allocated_rows=0, Raw_fields=0)


def need(value, message):
    if not value: raise ValueError(message)


def unique(pairs):
    value = {}
    for key, row in pairs:
        need(key not in value, 'duplicate JSON key: ' + key); value[key] = row
    return value


def sha(path):
    with path.open('rb') as stream: return hashlib.file_digest(stream, 'sha256').hexdigest()


def full(path): return dict(path=path.relative_to(ROOT).as_posix(), sha256=sha(path), size_bytes=path.stat().st_size)


def exact(row, external_binary=False):
    path = (ROOT / row['path']).resolve()
    need(path.is_relative_to(ROOT) and path.is_file(), 'contained regular actual artifact required: ' + row['path'])
    need(sha(path) == row['sha256'] and ('size_bytes' not in row or path.stat().st_size == row['size_bytes']), 'full SHA/size differs: ' + row['path'])
    SEEN[path] = (row['sha256'], path.stat().st_size)
    return path


def load(row): return json.loads(exact(row).read_bytes(), object_pairs_hook=unique)


def operand(token):
    name, digest = token.rsplit('#', 1); return full(exact(dict(path=name, sha256=digest)))


def identity(a, b): need(exact(a) == exact(b), 'actual path/SHA/size identity differs')


def keys(value, names): need(type(value) is dict and set(value) == set(names), 'complete owner keys differ: ' + ','.join(names))


def module(row, name):
    spec = importlib.util.spec_from_file_location(name, exact(row)); value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value); return value


def receipt(row, recorder, allowed=(0,)):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] in allowed and value['launch_error'] is None, 'actual command outcome differs')
    need(value['finished_utc'] is not None and value['started_utc'] <= value['finished_utc'] and value['source_bytes_match_before_and_after'] is True, 'closed stable Source command required')
    need(value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'recorder scope differs')
    need(exact(value['executed_launcher']['archive']).read_bytes() == exact(recorder).read_bytes(), 'actual recorder Source differs')
    for key in ['stdout', 'stderr', 'source_snapshot']: exact(value[key])
    return value


def scalar(row):
    keys(row, ['value', 'value_bits', 'value_class']); bits = row['value_bits']
    need(type(bits) is str and re.fullmatch('[0-9a-f]{16}', bits), 'canonical binary64 bits required')
    value = struct.unpack('>d', bytes.fromhex(bits))[0]
    category = 'NaN' if math.isnan(value) else '+Infinity' if value == math.inf else '-Infinity' if value == -math.inf else '-0' if value == 0 and bits.startswith('8') else '+0' if value == 0 else 'finite'
    need(row['value_class'] == category, 'scalar class differs from actual bits')
    if math.isfinite(value): need(type(row['value']) in (int, float) and struct.pack('>d', row['value']).hex() == bits, 'scalar finite JSON witness differs')
    else: need(row['value'] is None, 'nonfinite JSON witness must be null')
    COUNTS['scalar_DTOs'] += 1


def scalars(value):
    if isinstance(value, dict):
        if set(value) == {'value', 'value_bits', 'value_class'}: scalar(value)
        else:
            for child in value.values(): scalars(child)
    elif isinstance(value, list):
        for child in value: scalars(child)


def vector(row, width=3): need(type(row) is list and len(row) == width, 'full vector width differs')


def ordered(rows, id_name, allowed=None):
    need(type(rows) is list and [r['vector_index'] for r in rows] == list(range(len(rows))), 'full actual vector order differs')
    ids = [r[id_name] for r in rows]; need(all(type(v) is int and v >= 0 for v in ids) and len(set(ids)) == len(ids), 'actual owner IDs duplicate or invalid')
    if allowed is not None: need(ids == allowed, 'complete actual retained owner ID order differs')
    return {r[id_name]: r for r in rows}


def allocated(row):
    keys(row, ['allocated', 'length', 'values']); need(type(row['allocated']) is bool, 'actual allocation bool required')
    if not row['allocated']: need(row['length'] is None and row['values'] is None, 'unallocated owner invented values'); return []
    need(type(row['length']) is int and row['length'] >= 0 and type(row['values']) is list and len(row['values']) == row['length'], 'complete allocated tail required')
    for i, value in enumerate(row['values']):
        keys(value, ['vector_index', 'source_one_based_index', 'value']); need(value['vector_index'] == i and value['source_one_based_index'] == i + 1, 'actual allocation index correspondence differs')
    COUNTS['allocated_rows'] += len(row['values']); return [r['value'] for r in row['values']]


def byte_owner(row):
    keys(row, ['size_bytes', 'hex', 'utf8']); need(type(row['hex']) is str and re.fullmatch('(?:[0-9a-f]{2})*', row['hex']), 'complete lowercase byte witness required')
    value = bytes.fromhex(row['hex']); need(type(row['size_bytes']) is int and len(value) == row['size_bytes'], 'actual stream size differs')
    try: decoded = value.decode('utf8')
    except UnicodeDecodeError: decoded = None
    need(decoded == row['utf8'], 'actual UTF8 stream witness differs'); return value


def input_equal(left, right):
    if isinstance(left, dict) and isinstance(right, dict): return set(left) == set(right) and all(input_equal(left[k], right[k]) for k in left)
    if isinstance(left, list) and isinstance(right, list): return len(left) == len(right) and all(input_equal(a, b) for a, b in zip(left, right))
    if type(left) in (int, float) and type(right) in (int, float): return struct.pack('>d', float(left)) == struct.pack('>d', float(right))
    return type(left) is type(right) and left == right



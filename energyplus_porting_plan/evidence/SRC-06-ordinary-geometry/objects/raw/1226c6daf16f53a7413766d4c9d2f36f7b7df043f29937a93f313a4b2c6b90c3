def pe_facts(artifact):
    binary = exact(artifact['executable']); size = binary.stat().st_size
    with binary.open('rb') as stream:
        dos = stream.read(64); need(len(dos) == 64 and dos[:2] == b'MZ', 'full actual DOS header required'); offset = struct.unpack_from('<I', dos, 60)[0]
        need(offset >= 64 and offset + 24 <= size, 'actual PE header offset invalid'); stream.seek(offset); coff = stream.read(24)
        need(coff[:4] == b'PE\0\0', 'actual PE signature differs'); machine, count = struct.unpack_from('<HH', coff, 4); optional_size, characteristics = struct.unpack_from('<HH', coff, 20)
        optional = stream.read(optional_size); sections = stream.read(40 * count)
    need(machine == 0x8664 and optional_size >= 240 and len(optional) == optional_size and struct.unpack_from('<H', optional)[0] == 0x20b and count > 0 and len(sections) == count * 40, 'complete x64 optional/section headers required')
    reserve, commit = struct.unpack_from('<QQ', optional, 72); need(reserve == 8388608 and commit == 4096, 'actual main-thread PE stack reserve/commit differs')
    directory_count = struct.unpack_from('<I', optional, 108)[0]; need(directory_count == 16 and 112 + 8 * directory_count <= optional_size, 'all sixteen actual standard directories required')
    directories = [dict(index=i, address=struct.unpack_from('<I', optional, 112 + 8 * i)[0], size=struct.unpack_from('<I', optional, 116 + 8 * i)[0]) for i in range(directory_count)]
    rows = []
    for i in range(count):
        value = sections[40 * i:40 * (i + 1)]; virtual_size, rva, raw_size, raw_offset = struct.unpack_from('<IIII', value, 8)
        need(raw_offset + raw_size <= size, 'actual PE section raw extent escapes binary')
        rows.append(dict(name_bytes_hex=value[:8].hex(), virtual_size=virtual_size, virtual_address=rva, raw_size=raw_size, raw_offset=raw_offset, characteristics=struct.unpack_from('<I', value, 36)[0]))
    entry = struct.unpack_from('<I', optional, 16)[0]; text = [r for r in rows if bytes.fromhex(r['name_bytes_hex']).rstrip(b'\0') == b'.text']
    need(len(text) == 1 and text[0]['virtual_address'] <= entry < text[0]['virtual_address'] + max(text[0]['virtual_size'], text[0]['raw_size']) and text[0]['characteristics'] & 0x20000000, 'actual entry must belong to executable .text')
    need(directories[4]['address'] + directories[4]['size'] <= size, 'actual security directory file extent invalid')
    for i, directory in enumerate(directories):
        if directory['size'] and i != 4: need(any(r['virtual_address'] <= directory['address'] and directory['address'] + directory['size'] <= r['virtual_address'] + max(r['virtual_size'], r['raw_size']) for r in rows), 'actual data directory RVA extent unbacked')
    inspection = artifact['PE_inspection']; identity(inspection['actual_binary'], artifact['executable'])
    need(exact(inspection['actual_PE_header_bytes']).read_bytes() == dos + coff + optional + sections, 'actual raw archived PE headers differ')
    expected = dict(PE_header_file_offset=offset, machine=machine, COFF_characteristics=characteristics, entry_point_RVA=entry, subsystem=struct.unpack_from('<H', optional, 68)[0], DLL_characteristics=struct.unpack_from('<H', optional, 70)[0], stack_reserve_bytes=reserve, stack_commit_bytes=commit, data_directories=directories, sections=rows, loader_or_security_equivalence_claimed=False, Root_full_PE_acceptance_required_before_target_execution=True)
    need(all(inspection[k] == v for k, v in expected.items()), 'full actual PE inspection fields differ')
    return expected



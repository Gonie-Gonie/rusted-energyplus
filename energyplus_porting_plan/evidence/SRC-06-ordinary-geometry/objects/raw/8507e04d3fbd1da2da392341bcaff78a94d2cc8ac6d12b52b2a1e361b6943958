"""Correct the sole inherited executable collector pin before any helper invocation."""
import ast
import difflib
import hashlib
import json
from pathlib import Path
ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD, OUT = BASE / 'ordinary-geometry-execution-prep-05', BASE / 'ordinary-geometry-execution-prep-06'

def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))

def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)

def body(name, raw):
    before=write(OUT/'before'/name,(OLD/name).read_bytes()); proposal=write(OUT/name,raw)
    delta=write(OUT/(name+'.diff'),''.join(difflib.unified_diff((OLD/name).read_text(encoding='utf8').splitlines(True),raw.decode().splitlines(True),fromfile=before['path'],tofile=proposal['path'])).encode())
    return proposal,dict(before=before,proposal=proposal,exact_diff=delta)

m=json.loads((OLD/'manifest.json').read_bytes())
assert ref(OLD/'manifest.json')['sha256']=='bb30bc77076cda9f6ddd04ba10d7009562a129d216eeb476dbb0f7060cb29fb7'
raw=(OLD/'run_execution.py').read_bytes()
needle=b"{'path': '.runtime/porting/SRC-06/ordinary-geometry-provider-prep-02/manifest.json', 'sha256': '5804749eb0d18130331560741dd59be7849d113ca4c4602c318edc4ed655fe87'}"
replacement=b"{'path': '.runtime/porting/SRC-06/ordinary-geometry-provider-prep-03/manifest.json', 'sha256': '05689d2f2a757258cc01932ef57b2b145115d741dc5e9766d98f4ef5c4deafcb'}"
assert raw.count(needle)==1
raw=raw.replace(needle,replacement,1); ast.parse(raw)
driver,code=body('run_execution.py',raw)
doc,document=body('README.md',(OLD/'README.md').read_bytes()+b'\nSuccessor06 corrects the sole inherited executable provider02 authority literal to exact accepted provider03. The05 manifest already declared03; this pre-execution Source preflight correction makes the executable guard agree with that declared v4 authority. All other driver bytes and scientific/input contracts remain literal05. No actual helper or driver attempt occurred.\n')
m.update(accepted_predecessor=ref(OLD/'manifest.json'),predecessor_own_sources=m['own_sources'],own_sources=[driver,doc,ref(Path(__file__))],predecessor_narrow_source_correspondence=m['narrow_source_correspondence'],predecessor_narrow_document_correspondence=m['narrow_document_correspondence'],narrow_source_correspondence=code,narrow_document_correspondence=document)
m['runtime_interfaces']['driver']=driver
print(json.dumps(write(OUT/'manifest.json',(json.dumps(m,ensure_ascii=False,allow_nan=False,indent=2)+'\n').encode())))

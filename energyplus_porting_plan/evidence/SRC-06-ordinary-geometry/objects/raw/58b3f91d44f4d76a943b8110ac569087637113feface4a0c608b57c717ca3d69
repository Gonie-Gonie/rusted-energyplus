        source_range('.reference/energyplus-src/26.1.0/src/EnergyPlus/InputProcessing/IdfParser.cc',348,357,'actual IDF order and count metadata'),source_range('.reference/energyplus-src/26.1.0/src/EnergyPlus/Construction.hh',132,141,'actual Construction Name owner'),source_range('.reference/energyplus-src/26.1.0/src/EnergyPlus/Construction.hh',362,368,'actual Objexx Construction owner'),source_range('crates/ep_model/src/names.rs',1,18,'actual ASCII trimmed normalized name owner')]
    manifest={'schema':'src06-ordinary-geometry-comparison-Source-preparation.v1','status':'HELD-prospective-Source-only-before-any-new-geometry-answer-read',
        'own_sources':sources+[ref(OUT/'README.md'),ref(Path(__file__))],'prospective_policy':policy,'input_context':context,'input_identity_ledger':ledger,
        'geometry_Source_preparation':owner,'observer_Source_preparation':observer,'Native_Source_preparation':native,'comparison_primitives_Source':primitive,
        'recorder_Source':bound('tools/porting/record_command.py','5745ad9809e196af00b858fcdc0d3d783531628fa2abf1e086f75c7d293514ba'),
        'historical_conversion_recorder_Source':bound('.runtime/porting/source-objects/84/8468072e78d90a17051c9eac4766bbcbe2e079c399981b9e00d23ff500ec7d3c','8468072e78d90a17051c9eac4766bbcbe2e079c399981b9e00d23ff500ec7d3c'),
        'historical_conversion_runner_Source':bound('.runtime/porting/SCH-01/converted-inputs-01/sources/convert_inputs.py','82f27c8327d2409bb3bcba727044ebe6a36641ed8d7c404e08dd4bc92c990dbb'),
        'historical_conversion_support_Source':bound('.runtime/porting/SCH-01/converted-inputs-01/sources/input_common.py','b38466a0dd8851935d0ef28c079220d7c48f2c05506926d1ad4e7fb463f6de77'),
        'historical_converter_SHA256':'04f1327fef7148118ea1d79d9e990fb2447b9731e9c1b28a9a8276b840d7cbfe',

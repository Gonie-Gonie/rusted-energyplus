        name=names[0] if len(names)==1 else kind+' '+str(counts[kind])
        assert name in epjson[kind] and name not in {v['name'] for v in complete.get(kind,[])}
        complete.setdefault(kind,[]).append({'name':name,'global_ordinal':ordinal,'max_fields':len(tokens)-1})
    assert set(complete)==set(epjson) and all({v['name'] for v in rows}==set(epjson[k]) for k,rows in complete.items())
    effective={kind:rows for kind,rows in complete.items() if kind in targets}
    surface_order=[v['name'] for v in sorted(effective['BuildingSurface:Detailed'],key=lambda v:{'Wall':0,'Floor':1,'Roof':2}[epjson['BuildingSurface:Detailed'][v['name']]['surface_type']])]
    ledger=dump(OUT/'input-identity-ledger.json',{'schema':'src06-ordinary-geometry-input-identity-ledger.v1','input':ctx['input'],
        'original_IDF_sha256':ctx['input']['sha256'],'converted_epJSON_sha256':ctx['epjson_input']['sha256'],

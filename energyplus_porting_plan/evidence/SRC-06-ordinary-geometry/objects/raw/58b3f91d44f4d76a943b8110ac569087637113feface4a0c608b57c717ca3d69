        'literal_input_only':True,'Native_or_Rust_result_values_used':False,'scientific_expected_values_supplied':False})
    sources=[ref(OUT/name) for name in ('compare.py','custody.py','input_joins.py')]
    diffs=[]
    for row in sources:
        raw=(ROOT/row['path']).read_bytes(); ast.parse(raw)
        diffs.append(write(OUT/(Path(row['path']).name+'.diff'),''.join(difflib.unified_diff([],raw.decode().splitlines(True),fromfile='/dev/null',tofile=row['path'])).encode()))
    primitive=bound('.runtime/porting/SRC-05/surface-environment-selected-comparison-prep-05/compare.py','0ee054e8be751fecf912dd300c0c71285c9a8e979612d05e5478413032931464')
    validator=bound('.runtime/porting/SRC-05/ordinary-main-thread-application-prep-03/validate.py','e1f58c9d464933a0af9e03790251ee08eea20b2fd3675ebc00f78ae5ac27fb2b')
    # Copy only literal established argv constants; no imports or Cargo/engine execution.
    tree=ast.parse((ROOT/validator['path']).read_bytes()); env={}
    for node in tree.body:
        if isinstance(node,ast.Assign) and isinstance(node.targets[0],ast.Name) and node.targets[0].id in ('CONFIGS','QUALITY'):
            value=node.value
            def literal(n):
                if isinstance(n,ast.Name): return env[n.id]
                if isinstance(n,ast.BinOp) and isinstance(n.op,ast.Add): return literal(n.left)+literal(n.right)
                if isinstance(n,ast.List): return [literal(v) for v in n.elts]
                if isinstance(n,ast.Dict): return {literal(k):literal(v) for k,v in zip(n.keys,n.values)}
                return ast.literal_eval(n)
            env[node.targets[0].id]=literal(value)
    interfaces={'required_options':['--source-preparation','--custody','--output-dir'],'comparer':sources[0],
        'custody_schema':'src06-ordinary-geometry-comparison-custody.v1','result_schema':'src06-ordinary-geometry-selected-comparison.v1',

    owner=bound('.runtime/porting/SRC-06/ordinary-geometry-owner-prep-02/manifest.json','502237329524881eb7427b7721023f3608169cfeed1524cfa7001786b032381a')
    observer=bound('.runtime/porting/SRC-06/ordinary-geometry-observer-prep-02/manifest.json','9c3b3507f9a2b1f8c7fb973b5114397ecf81544a18c7be1313aaaf6cb5d73b75')
    policy=bound('.runtime/porting/SRC-06/ordinary-geometry-observer-prep-02/policy.proposed.json','0bb48c5f93aea8393c8012f28ccfaa37c9e191e201f402a547156a8376092f6b')
    context=bound('.runtime/porting/SRC-06/ordinary-geometry-observer-prep-01/fixed-input-context.json','f9f645bd15fbd6cc96f584ea3d0b058ed0156da2f0bde8ffab56394835e8fa4e')
    ctx=json.loads((ROOT/context['path']).read_bytes()); pol=json.loads((ROOT/policy['path']).read_bytes())
    idf=(ROOT/ctx['input']['path']).read_bytes(); epjson=json.loads((ROOT/ctx['epjson_input']['path']).read_bytes())
    assert hashlib.sha256(idf).hexdigest()==pol['admission']['exact_original_IDF_SHA256'] and ref(ROOT/ctx['epjson_input']['path'])['sha256']==pol['admission']['exact_converted_epJSON_SHA256']
    # Literal CON01 parse_idf body: no new scientific parser. This one pinned input has no quoted tokens.
    text=idf.decode('utf-8-sig'); assert '"' not in text and "'" not in text
    text=re.sub(r'!.*','',text)
    objects=[[field.strip() for field in item.split(',')] for item in text.split(';') if item.strip()]
    original_targets=(ROOT/'crates/ep_raw_model/src/idf_order.rs').read_text(encoding='utf-8')
    targets=re.findall(r'object_type: "([^"]+)"',original_targets.split('/// Error returned')[0])
    unnamed=['Output:Surfaces:List','Output:Surfaces:Drawing','Output:VariableDictionary','Output:Constructions','Output:EnergyManagementSystem']
    complete={}; counts={}
    for ordinal,tokens in enumerate(objects,1):
        kind=next(k for k in epjson if k.lower()==tokens[0].lower()); counts[kind]=counts.get(kind,0)+1

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-06/ordinary-geometry-comparison-prep-01'


def ref(path):
    raw = path.read_bytes()
    return {'path':path.relative_to(ROOT).as_posix(),'sha256':hashlib.sha256(raw).hexdigest(),'size_bytes':len(raw),'line_count':len(raw.splitlines())}


def write(path, raw):
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def dump(path, value):
    return write(path,(json.dumps(value,ensure_ascii=False,indent=2,allow_nan=False)+'\n').encode())


def bound(path, expected):
    result=ref(ROOT/path); assert result['sha256']==expected,path
    return result


def source_range(path, start, end, role):
    whole=ref(ROOT/path); raw=b''.join((ROOT/path).read_bytes().splitlines(True)[start-1:end])
    archive=write(OUT/'literal-source-ranges'/(path.replace('/','__')+'.'+str(start)+'-'+str(end)+'.literal'),raw)
    return {'whole_Source':whole,'start_line':start,'end_line':end,'literal_archive':archive,'role':role}



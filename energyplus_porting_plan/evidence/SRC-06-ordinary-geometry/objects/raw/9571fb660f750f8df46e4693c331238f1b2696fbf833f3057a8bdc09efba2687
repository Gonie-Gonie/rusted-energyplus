def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def authenticated(text):
    name, digest = text.rsplit('#', 1)
    row = ref((ROOT / name).resolve())
    assert row['sha256'] == digest
    return row


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def body(name, raw):
    before = write(OUT / 'before' / name, (OLD / name).read_bytes())
    after = write(OUT / name, raw)
    delta = write(OUT / (name + '.diff'), ''.join(difflib.unified_diff((OLD / name).read_text(encoding='utf8').splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=after['path'])).encode())
    return after, dict(before=before, proposal=after, exact_diff=delta)



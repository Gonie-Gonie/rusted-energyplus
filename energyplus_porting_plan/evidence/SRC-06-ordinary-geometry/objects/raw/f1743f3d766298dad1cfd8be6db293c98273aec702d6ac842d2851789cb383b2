    need(shape['container'] == 'EnergyPlus::EPVector' and type(shape['allocated']) is bool and shape['operator_parentheses_indexing'] == 'one-based; zero is not an allocated member', 'actual EPVector allocation/indexing required')
    integer(shape['size'])



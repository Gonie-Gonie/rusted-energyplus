    keys(value, 'available reason owners actual_error_prefix actual_console_prefix actual_EIO_prefix actual_callback_count', 'available prefix')
    need(value['reason'] is None and set(value['owners']) == COUNTERS, 'complete actual counter owner required')
    for key, item in value['owners'].items():

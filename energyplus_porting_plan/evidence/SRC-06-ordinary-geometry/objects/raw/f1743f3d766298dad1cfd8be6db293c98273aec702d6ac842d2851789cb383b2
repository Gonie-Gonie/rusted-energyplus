def need(condition, message):
    if not condition:
        raise ValueError(message)


def full(path):
    path = path.resolve()
    with path.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path), sha256=digest, size_bytes=path.stat().st_size)


def bind(row):
    path = (ROOT / row['path']).resolve()
    need(path.is_file() and (path.is_relative_to(ROOT) or any(path.is_relative_to(p) for p in EXTERNAL)), 'missing or escaped factual artifact: ' + row['path'])
    actual = SEEN.get(path)
    if actual is None:
        actual = full(path); SEEN[path] = actual
    need(actual['sha256'] == row['sha256'] and all(row[k] == actual['size_bytes'] for k in ('size_bytes', 'bytes') if k in row), 'factual artifact bytes differ: ' + row['path'])
    return path


def load(row):
    return json.loads(bind(row).read_bytes())


def operand(token):
    name, sha = token.rsplit('#', 1)
    return full(bind(dict(path=name, sha256=sha)))


def same(a, b):
    need(bind(a) == bind(b), 'factual artifact identity differs')


def integer(value, minimum=0):
    need(type(value) is int and value >= minimum, 'actual integer owner required')


def keys(value, names, role):
    need(isinstance(value, dict) and set(value) == set(names.split()), 'complete actual ' + role + ' field set required')


def scalar_shapes(values):
    for value in values:
        keys(value, 'value value_bits value_class', 'scalar DTO')


def outcome(value, called=True):
    if not called:

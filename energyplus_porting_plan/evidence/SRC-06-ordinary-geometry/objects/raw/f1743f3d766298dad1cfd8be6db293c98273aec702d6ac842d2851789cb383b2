    need(len(members) == len(snapshot['files']) and set(members) == {p.relative_to(ROOT).as_posix() for p in paths}, 'complete current Source membership differs')
    for name, item in members.items():
        bind(item['archive']); bind(dict(path=name, sha256=item['archive']['sha256'], size_bytes=item['size_bytes']))
    return members



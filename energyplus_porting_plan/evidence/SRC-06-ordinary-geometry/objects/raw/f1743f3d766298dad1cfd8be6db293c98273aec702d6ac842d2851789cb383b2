def recorded(row, source, allowed=(0,)):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] in allowed and value['launch_error'] is None and value['finished_utc'] is not None and value['source_bytes_match_before_and_after'] is True, 'closed genuine guarded execution required')
    same(value['source_snapshot'], source)
    need(full(bind(value['executed_launcher']['archive']))['sha256'] == RECORDER_SHA, 'authentic recorder Source required')
    bind(value['stdout']); bind(value['stderr'])
    return value


def argument(token, expected):
    same(operand(token), expected)


def source_guard(row):
    snapshot = load(row)
    need(snapshot['schema'] == 'rust-command-source-snapshot.v1' and snapshot['bytes_normalized'] is False, 'literal full Source snapshot required')
    members = {r['historical_path']: r for r in snapshot['files']}

        need(value['status'] == 'source_not_invoked_due_to_unavailable_prerequisite' and isinstance(value['reason'], str), 'actual unreached call reason required')
        return
    keys(value, 'status exception_type exception_message', 'invoked call outcome')
    status = value['status']
    need(status in ('source_returned', 'source_fatal', 'source_exception', 'source_nonstandard_exception'), 'genuine Source call outcome required')
    if status in ('source_returned', 'source_nonstandard_exception'):
        need(value['exception_type'] is None and value['exception_message'] is None, 'actual absent exception owner required')
    else:
        need(isinstance(value['exception_type'], str) and isinstance(value['exception_message'], str), 'complete actual exception owner required')


def scalar_tree(value):
    if isinstance(value, dict):
        if set(value) & {'value_bits', 'value_class'}:
            need(set(value) == {'value', 'value_bits', 'value_class'}, 'complete scalar DTO required')
            bits = value['value_bits']; need(isinstance(bits, str) and re.fullmatch('[0-9a-f]{16}', bits), 'literal binary64 DTO bits required')
            raw = int(bits, 16); number = struct.unpack('>d', bytes.fromhex(bits))[0]
            kind = 'nan' if math.isnan(number) else ('negative_infinity' if raw >> 63 else 'positive_infinity') if math.isinf(number) else ('negative_zero' if raw >> 63 else 'positive_zero') if number == 0 else 'finite'
            need(value['value_class'] == kind, 'actual DTO class differs from retained bits')
            if math.isfinite(number):
                need(type(value['value']) in (int, float) and struct.pack('>d', float(value['value'])).hex() == bits, 'actual finite DTO decimal does not roundtrip to retained bits')
            else:
                need(value['value'] is None, 'nonfinite DTO must retain null decimal and actual bits')
            CLASSES[kind] = CLASSES.get(kind, 0) + 1
        else:
            for key, child in value.items():
                if key != 'actual_parsed_input_epJSON': scalar_tree(child)
    elif isinstance(value, list):
        for child in value: scalar_tree(child)



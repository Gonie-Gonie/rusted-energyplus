def ref(path):
    data = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data), line_count=len(data.splitlines()))


def fixed(name, sha):
    row = ref(ROOT / name)
    assert row['sha256'] == sha, name
    return row


def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        assert path.read_bytes() == data, path
    else:
        with path.open('xb') as stream:
            stream.write(data)
    return ref(path)


def replace_once(text, before, after):
    assert text.count(before) == 1, before
    return text.replace(before, after, 1)



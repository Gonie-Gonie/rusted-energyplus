def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(),
                size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    assert not path.exists(), path
    path.write_bytes(raw)


def metadata(path, value):
    write(path, (json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())


def copy(path, target):
    write(target, path.read_bytes())
    return dict(before=ref(path), proposal=ref(target), bytes_exact=True)


def physical_range(path, first, last, purpose):
    raw = path.read_bytes()
    lines = raw.splitlines(keepends=True)
    assert 1 <= first <= last <= len(lines)
    selected = b''.join(lines[first - 1:last])
    target = OUT / 'ranges' / (path.name + '.' + str(first) + '-' + str(last) + '.literal')
    write(target, selected)
    return dict(path=path.relative_to(ROOT).as_posix(), whole_Source=ref(path), start_line=first, end_line=last,
                sha256=hashlib.sha256(selected).hexdigest(), size_bytes=len(selected), literal_archive=ref(target), purpose=purpose)


def correspondence(before, after, before_label, after_label):
    old = before.read_bytes() if before is not None else b''
    new = after.read_bytes()
    delta = ''.join(difflib.unified_diff(old.decode().splitlines(True), new.decode().splitlines(True),
                                       fromfile=before_label, tofile=after_label)).encode()
    target = OUT / 'diffs' / (after.name + '.diff')
    write(target, delta)
    return dict(before=ref(before) if before is not None else None, before_bytes_empty=before is None,
                proposal=ref(after), exact_diff=ref(target), fromfile=before_label, tofile=after_label)



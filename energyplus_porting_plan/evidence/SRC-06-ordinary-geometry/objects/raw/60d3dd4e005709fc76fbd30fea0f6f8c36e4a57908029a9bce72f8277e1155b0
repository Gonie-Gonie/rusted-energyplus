"""Seal the shared future geometry comparison ledger reviewer; never invoke it."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-06/ordinary-geometry-comparison-factual-checker-prep-01'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def checked(row):
    path = ROOT / row['path']; actual = ref(path)
    assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes'])
    return path


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def main():
    workflow = ref(ROOT / '.runtime/porting/SRC-06/ordinary-geometry-workflow-prep-02/manifest.json')
    comparer = ref(ROOT / '.runtime/porting/SRC-06/ordinary-geometry-comparison-prep-03/manifest.json')
    assert workflow['sha256'] == '863c5207c2ec3994c4448651b7f2fa154c4e3939760cc437fcaa5217b61db51c'
    assert comparer['sha256'] == 'c1f7b3e59b4facb70ec9fc7058b2234645dc9422532647f028ed124d8ed1350f'
    w, c = json.loads(checked(workflow).read_bytes()), json.loads(checked(comparer).read_bytes())
    own = [ref(OUT / 'check.py'), ref(OUT / 'README.md'), ref(Path(__file__))]
    ast.parse(checked(own[0]).read_bytes()); ast.parse(Path(__file__).read_bytes())
    dependencies = [workflow, comparer, *w['own_sources'][:3], *c['own_sources'][:3], w['recorder_Source'],
        c['prospective_policy'], w['Native_baseline_acceptance'], w['protected_dispatcher_application'], w['protected_prior_summary']]
    for row in dependencies: checked(row)
    correspondence = []
    for row in own[:2]:
        raw = checked(row).read_bytes(); before = write(OUT / 'before' / Path(row['path']).name, b'')
        delta = write(OUT / (Path(row['path']).name + '.diff'), ''.join(difflib.unified_diff([],raw.decode().splitlines(True),fromfile=before['path'],tofile=row['path'])).encode())
        correspondence.append(dict(before=before,proposal=row,exact_diff=delta))
    manifest = dict(schema='src06-ordinary-geometry-comparison-factual-checker-Source-preparation.v1', status='HELD-Source-only-unexecuted',
        own_sources=own, workflow_Source_preparation=workflow, comparer_Source_preparation=comparer, fixed_dependencies=dependencies,
        exact_Source_correspondence=correspondence,
        runtime_interfaces=dict(checker=own[0],required_options=['--source-preparation','--comparison-transport','--outer-execution','--output'],
            output_schema='src06-ordinary-geometry-comparison-factual-review.v1', ledger_labels=['mismatches','unavailable','paired_owners'],
            ledger_fact_keys=['rows','decoded_bytes','decoded_sha256']),
        actual_comparison_results_read=False, Native_or_Rust_geometry_outputs_read=False, checker_imported_or_executed=False,
        geometry_equations_recomputed=False, targets_executed=False, canonical_or_Git_changed=False, scientific_PASS_claimed=False, gates_updated=False)
    print(json.dumps(write(OUT / 'manifest.json',(json.dumps(manifest,ensure_ascii=False,indent=2,allow_nan=False)+'\n').encode())))


if __name__ == '__main__': main()

"""Read complete closed comparison custody and ledgers; no geometry equations or comparer invocation."""
import argparse
import gzip
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
SEEN = {}
PHASES = ['input_join_comparisons', 'pre_owner_comparisons', 'selected_endpoint_comparisons', 'point_helper_comparisons']


def need(condition, message):
    if not condition: raise ValueError(message)


def digest(path):
    with path.open('rb') as stream: return hashlib.file_digest(stream, 'sha256').hexdigest()


def bind(row):
    path = (ROOT / row['path']).resolve()
    need(path.is_relative_to(ROOT) and path.is_file(), 'missing or uncontained factual artifact')
    need(digest(path) == row['sha256'], 'artifact SHA differs: ' + row['path'])
    if 'size_bytes' in row: need(type(row['size_bytes']) is int and path.stat().st_size == row['size_bytes'], 'artifact size differs')
    SEEN[path] = row['sha256']
    return path


def ref(path):
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=digest(path), size_bytes=path.stat().st_size)


def operand(token):
    path, sha = token.rsplit('#', 1)
    return ref(bind(dict(path=path, sha256=sha)))


def unique(pairs):
    value = {}
    for key, child in pairs:
        need(key not in value, 'duplicate JSON member: ' + key); value[key] = child
    return value


def decode(raw):
    return json.loads(raw, object_pairs_hook=unique, parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))


def load(row):
    return decode(bind(row).read_bytes())


def identity(left, right):
    need(bind(left) == bind(right) and left['sha256'] == right['sha256'], 'artifact identity differs')


def receipt(row, recorder, source):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and type(value['exit_code']) is int and value['exit_code'] in (0, 1, 2)
         and value['launch_error'] is None and value['source_bytes_match_before_and_after'] is True, 'closed actual command custody required')
    need(value['finished_utc'] is not None and value['started_utc'] <= value['finished_utc'], 'actual command must be closed')
    need(value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'recorder scope differs')
    identity(value['source_snapshot'], source)
    need(bind(value['executed_launcher']['archive']).read_bytes() == bind(recorder).read_bytes(), 'actual recorder Source differs')
    bind(value['stdout']); bind(value['stderr'])
    return value


def options(command, script, names, ordered=True):
    need(len(command) == 5 + 2 * len(names) and command[1:4] == ['-X', 'utf8', '-B']
         and (ROOT / command[4]).resolve() == bind(script), 'actual Python script/argc differs')
    keys = command[5::2]; need(set(keys) == set(names) and len(set(keys)) == len(keys) and (not ordered or keys == names), 'actual option set/order differs')
    return dict(zip(keys, command[6::2]))


def full_source(row):
    snapshot = load(row)
    need(snapshot['schema'] == 'rust-command-source-snapshot.v1' and snapshot['bytes_normalized'] is False, 'complete actual Source snapshot required')
    names = [v['historical_path'] for v in snapshot['files']]
    need(len(names) == len(set(names)), 'duplicate Source member')
    for member in snapshot['files']:
        need(bind(member['archive']).stat().st_size == member['size_bytes'], 'full archived Source member differs')
    return len(names)


def ledger(label, spec, parent):
    need(set(spec) == {'artifact', 'rows', 'decoded_bytes', 'decoded_sha256'}, 'complete ledger descriptor required')
    path = bind(spec['artifact'])
    need(path.parent == parent and path.name == label + '.jsonl.gz', 'ledger physical identity differs')
    need(type(spec['rows']) is int and spec['rows'] >= 0 and type(spec['decoded_bytes']) is int and spec['decoded_bytes'] >= 0, 'ledger cardinalities required')
    rows = []; size = 0; sha = hashlib.sha256()
    with gzip.open(path, 'rb') as stream:
        for line in stream:
            need(line.endswith(b'\n') and line.strip(), 'complete newline-delimited ledger row required')
            value = decode(line); need(type(value) is dict, 'ledger row must be an object')
            canonical = (json.dumps(value, ensure_ascii=False, separators=(',', ':'), allow_nan=False) + '\n').encode()
            need(canonical == line, 'ledger row differs from actual producer serialization/order')
            sha.update(line); size += len(line); rows.append(value)
    facts = dict(rows=len(rows), decoded_bytes=size, decoded_sha256=sha.hexdigest())
    need(all(facts[k] == spec[k] for k in facts), 'full decoded ledger hash/size/count differs')
    return rows, facts


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for key in ('source-preparation', 'comparison-transport', 'outer-execution', 'output'): parser.add_argument('--' + key, required=True)
    args = parser.parse_args(); own_ref = operand(args.source_preparation); own = load(own_ref)
    need(own['schema'] == 'src06-ordinary-geometry-comparison-factual-checker-Source-preparation.v1', 'reviewed factual checker authority required')
    for row in own['own_sources']: bind(row)
    need(bind(own['runtime_interfaces']['checker']) == Path(__file__).resolve(), 'actual checker Source differs')
    workflow_ref, comparer_ref = own['workflow_Source_preparation'], own['comparer_Source_preparation']
    workflow, comparer = load(workflow_ref), load(comparer_ref)
    for row in workflow['own_sources'] + comparer['own_sources']: bind(row)
    identity(workflow['reviewed_comparer_Source_preparation'], comparer_ref)
    transport_ref, outer_ref = operand(args.comparison_transport), operand(args.outer_execution)
    transport = load(transport_ref); source = transport['Source_snapshot']; member_count = full_source(source)
    need(transport['schema'] == 'src06-ordinary-geometry-actual-comparison-transport.v1', 'actual transport schema differs')
    identity(transport['Source_preparation'], workflow_ref); identity(transport['actual_comparer'], comparer_ref)
    need(transport['numerical_results_parsed'] is False and transport['whole_geometry_or_ordinary_PASS_claimed'] is False and transport['gates_updated'] is False, 'transport scope differs')
    recorder = workflow['recorder_Source']; outer = receipt(outer_ref, recorder, source)
    outer_names = ['--source-preparation', '--application', '--formatter-review', '--Source-snapshot', '--Rust-custody', '--Root-Rust-factual-review', '--independent-Rust-factual-review', '--output-dir']
    outer_options = options(outer['command'], workflow['runtime_interfaces']['compare'], outer_names, ordered=False)
    identity(operand(outer_options['--source-preparation']), workflow_ref); identity(operand(outer_options['--Source-snapshot']), source)
    need((ROOT / outer_options['--output-dir']).resolve() == bind(transport_ref).parent, 'actual transport output directory differs')
    need(bind(outer['stderr']).stat().st_size == 0, 'unexpected transport stderr')
    actual = receipt(transport['actual_execution'], recorder, source)
    need(outer['started_utc'] <= actual['started_utc'] <= actual['finished_utc'] <= outer['finished_utc'], 'actual nested command chronology differs')
    identity(transport['actual_complete_stdout'], actual['stdout']); identity(transport['actual_complete_stderr'], actual['stderr'])
    need(transport['actual_exit_code'] == actual['exit_code'] == outer['exit_code'], 'actual report/transport exit codes differ')
    inner_options = options(actual['command'], comparer['runtime_interfaces']['comparer'], ['--source-preparation', '--custody', '--output-dir'])
    identity(operand(inner_options['--source-preparation']), comparer_ref)
    packet_ref = transport['actual_custody']; identity(operand(inner_options['--custody']), packet_ref)
    stdout = load(actual['stdout']); need(set(stdout) == {'comparison', 'actual_exit_code'} and stdout['actual_exit_code'] == actual['exit_code'], 'actual comparer stdout/outcome differs')
    need(bind(actual['stdout']).stat().st_size <= 8000, 'full comparer stdout must fit the actual recorder echo boundary')
    echoed = [decode(line) for line in bind(outer['stdout']).read_bytes().splitlines() if line.strip()]
    need(len(echoed) == 3 and echoed[0] == stdout and set(echoed[1]) == {'receipt','exit_code','source_bytes_match_before_and_after'}
         and echoed[1]['exit_code'] == actual['exit_code'] and echoed[1]['source_bytes_match_before_and_after'] is True
         and set(echoed[2]) == {'record'}, 'complete ordered comparer/recorder/transport stdout witnesses differ')
    identity(echoed[1]['receipt'], transport['actual_execution']); identity(echoed[2]['record'], transport_ref)
    comparison_ref = stdout['comparison']; comparison = load(comparison_ref)
    outdir = (ROOT / inner_options['--output-dir']).resolve()
    need(outdir == bind(comparison_ref).parent == bind(transport_ref).parent / 'comparison' and bind(comparison_ref).name == 'comparison.json', 'actual comparison output differs')
    need(bind(actual['stderr']).stat().st_size == 0, 'unexpected comparer stderr')
    need(comparison['schema'] == 'src06-ordinary-geometry-selected-comparison.v1', 'actual comparison schema differs')
    identity(comparison['reviewed_Source_preparation'], comparer_ref); identity(comparison['actual_custody'], packet_ref)
    identity(comparison['prospective_policy'], comparer['prospective_policy'])
    packet = load(packet_ref)
    need(set(packet) == set(comparer['runtime_interfaces']['custody_keys']) and packet['schema'] == 'src06-ordinary-geometry-comparison-custody.v1', 'complete comparison custody packet differs')
    identity(packet['Source_snapshot'], source); identity(packet['prospective_policy'], comparer['prospective_policy'])
    for option, key in [('--application','actual_application'),('--formatter-review','actual_formatter_review'),('--Rust-custody','Rust_execution_custody'),('--Root-Rust-factual-review','Root_Rust_factual_review'),('--independent-Rust-factual-review','independent_Rust_factual_review')]: identity(operand(outer_options[option]), packet[key])
    identity(packet['Native_baseline_acceptance'], workflow['Native_baseline_acceptance'])
    for key in ('protected_dispatcher_application', 'protected_prior_summary'): identity(packet[key], workflow[key])
    rust_custody = load(packet['Rust_execution_custody']); identity(rust_custody['Source_snapshot'], source)
    identity(rust_custody['actual_application'], packet['actual_application'])
    for key in ('Root_Rust_factual_review', 'independent_Rust_factual_review'):
        proof = load(packet[key]); need(proof['schema'] == 'src06-ordinary-geometry-Rust-factual-review.v1' and proof['accepted'] is True and proof['gates_updated'] is False, 'complete actual Rust factual review required')
        identity(proof['actual_custody'], packet['Rust_execution_custody']); identity(proof['Source_snapshot'], source)
    rust_execution = receipt(rust_custody['actual_execution'], recorder, source)
    identity(rust_custody['actual_complete_stdout'], rust_execution['stdout'])
    need(rust_execution['finished_utc'] <= actual['started_utc'], 'comparison precedes closed Rust capture')
    release = load(packet['Native_baseline_acceptance'])
    need(release['schema'] == 'ordinary-geometry-Native-baseline-acceptance.v1' and release['accepted'] is True and release['gates_updated'] is False, 'genuine Native release required')
    native_execution = receipt(release['actual_Native_execution'], recorder, release['Source_snapshot'])
    need(native_execution['finished_utc'] <= actual['started_utc'], 'comparison precedes closed Native capture')
    native, rust = load(release['actual_authoritative_result']), load(rust_execution['stdout'])
    need(set(comparison['counts']) == set(PHASES) and all(type(v) is int and v >= 0 for v in comparison['counts'].values()), 'actual comparison counters differ')
    need(comparison['counts']['pre_owner_comparisons'] == comparison['counts']['point_helper_comparisons'] == 0, 'unrepresented intermediate/kernel calls cannot be counted')
    labels = ['mismatches', 'unavailable', 'paired_owners']; need(set(comparison['ledgers']) == set(labels), 'all three complete ledgers required')
    rows, facts = {}, {}
    for label in labels: rows[label], facts[label] = ledger(label, comparison['ledgers'][label], outdir)
    phases = {}; previous_phase = -1; mismatch_ids = set()
    for row in rows['mismatches']:
        need(set(row) == {'phase','path','Native_or_required','Rust_or_observed'} and type(row['path']) is str and row['phase'] in PHASES, 'complete mismatch witness required')
        phase = PHASES.index(row['phase']); need(phase >= previous_phase, 'mismatch phase order differs'); previous_phase = phase
        identity_key = (row['phase'], row['path']); need(identity_key not in mismatch_ids, 'duplicate mismatch identity'); mismatch_ids.add(identity_key)
        need(type(row['Native_or_required']) is not type(row['Rust_or_observed']) or row['Native_or_required'] != row['Rust_or_observed'], 'stored mismatch does not differ')
        phases[row['phase']] = phases.get(row['phase'], 0) + 1
    need(all(comparison['counts'][k] >= count for k,count in phases.items()), 'mismatch rows exceed actual phase counters')
    policy = load(comparer['prospective_policy']); null_names = comparer['exact_absent_Native_JSON_null_family_names']
    optional_expected = {'unpaired-context/' + name:None for name in policy['explicitly_unpaired']}
    optional_expected.update({'Native-parser/absent-family-null/' + name:name for name in null_names})
    required = optional = 0; optional_seen = set(); unavailable_ids = set()
    for row in rows['unavailable']:
        need(set(row) == {'path','reason','required','counted_as_PASS','details'} and type(row['path']) is str and type(row['reason']) is str and type(row['required']) is bool and row['counted_as_PASS'] is False, 'honest complete unavailable row required')
        need(row['path'] not in unavailable_ids, 'duplicate unavailable identity'); unavailable_ids.add(row['path'])
        required += row['required']; optional += not row['required']
        if not row['required']:
            need(row['path'] in optional_expected, 'unreviewed optional omission'); optional_seen.add(row['path']); name = optional_expected[row['path']]
            if name is None: need(row['reason'] == 'frozen prospective policy explicitly unpaired' and row['details'] is None, 'optional policy context differs')
            else:
                expected = dict(actual_parsed_value=None, actual_family_counts={'actual_json_type':'null','actual_size':0}, actual_input_family_supplied=False, measured_inner_creator_trace_claimed=False)
                need(row['details'] == expected and native['selected_geometry']['actual_parsed_input_epJSON'][name] is None
                     and native['selected_geometry']['actual_parsed_input_family_counts'][name] == expected['actual_family_counts'], 'full actual absent-null metadata witness differs')
    expected_pairs = []
    geometry = native.get('selected_geometry'); typed = rust.get('typed_geometry_inputs')
    if geometry is not None and typed is not None:
        for kind, family in [('Surface','surfaces'), ('Zone','zones')]:
            lookup = {v['name'].strip().lower():v['id'] for v in geometry[family]}
            need(len(lookup) == len(geometry[family]), 'duplicate actual Native name owner')
            for index,row in enumerate(typed[family]):
                expected_pairs.append(dict(kind=kind,name=row['name'],Native_id=lookup.get(row['name'].lower()),Rust_id=row['id'],Rust_vector_index=row['vector_index']))
                need(row['vector_index'] == index, 'actual typed vector index/order differs')
    need(len(rows['paired_owners']) <= len(expected_pairs), 'paired-owner ledger exceeds actual owner closure')
    for row, expected in zip(rows['paired_owners'], expected_pairs):
        need(set(row) == set(expected) | {'selected_owner_available'} and type(row['selected_owner_available']) is bool
             and all(row[k] == value for k,value in expected.items()), 'complete paired-owner ID/name/order witness differs')
    need(all(type(comparison[k]) is int and comparison[k] >= 0 for k in ['mismatch_count','required_unavailable_count','optional_unpaired_count'])
         and comparison['mismatch_count'] == len(rows['mismatches']) and comparison['required_unavailable_count'] == required and comparison['optional_unpaired_count'] == optional, 'report/complete ledger counts differ')
    failure = comparison['integrity_failure']
    if failure is None:
        need(optional_seen == set(optional_expected) and len(rows['paired_owners']) == len(expected_pairs), 'completed comparison omitted owner or optional metadata rows')
        passed = not rows['mismatches'] and required == 0
        need((comparison['status'], actual['exit_code']) == (('pass-available-selected-ordinary-geometry-only',0) if passed else ('failed-selected-ordinary-geometry',1)), 'actual report status contradicts complete ledgers')
    else:
        need(type(failure) is dict and set(failure) == {'type','message'} and all(type(v) is str for v in failure.values())
             and comparison['status'] == 'integrity-failed' and actual['exit_code'] == 2, 'honest integrity-only outcome required')
    need(comparison['all_differences_retained_without_cap'] is True and all(comparison[k] is False for k in ['Native_and_Rust_intermediate_checkpoint_pairing_claimed','all_unavailable_counted_as_PASS','whole_geometry_PASS_claimed','whole_SetupZoneGeometry_PASS_claimed','ordinary_convection_or_cadence_PASS_claimed','gates_updated']), 'comparison scope differs')
    for path, sha in SEEN.items(): need(digest(path) == sha, 'authenticated artifact changed during factual review')
    output = (ROOT / args.output).resolve(); need(output.is_relative_to(ROOT / '.runtime/porting/SRC-06') and not output.exists(), 'fresh ignored factual output required')
    result = dict(schema='src06-ordinary-geometry-comparison-factual-review.v1', accepted=True, actual_comparison=comparison_ref,
        actual_execution=transport['actual_execution'], actual_custody=packet_ref, Source_snapshot=actual['source_snapshot'],
        actual_transport=transport_ref, actual_outer_execution=outer_ref, counts=comparison['counts'], mismatch_count=len(rows['mismatches']),
        required_unavailable_count=required, optional_unpaired_count=optional, ledger_facts=facts,
        actual_paired_owner_rows=len(rows['paired_owners']), actual_mismatch_phase_counts=phases, actual_status=comparison['status'],
        full_archived_Source_members_verified=member_count, all_three_ledgers_full_hash_integrity_and_rows_accepted=True,
        all_ledger_rows_processed_in_recorded_order=True, comparison_call_counters_independently_recomputed=False,
        geometry_equations_recomputed=False, comparer_or_engine_invoked=False, scientific_PASS_claimed=False,
        whole_geometry_or_ordinary_PASS_claimed=False, gates_updated=False, review_Source=ref(Path(__file__)), review_Source_preparation=own_ref)
    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open('xb') as stream: stream.write((json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode())
    print(json.dumps(ref(output)))


if __name__ == '__main__': main()

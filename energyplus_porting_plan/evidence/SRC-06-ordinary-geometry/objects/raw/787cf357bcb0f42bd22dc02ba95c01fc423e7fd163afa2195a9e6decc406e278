"""Append read-only actual Construction identity and complete parsed-input witnesses."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD, OUT = BASE / 'ordinary-geometry-native-prep-03', BASE / 'ordinary-geometry-native-prep-04'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)
    return ref(path)


def correspondence(name, raw):
    before = write(OUT / 'before-03' / name, (OLD / name).read_bytes())
    proposal = write(OUT / name, raw)
    diff = write(OUT / 'diffs' / (name + '.diff'), ''.join(difflib.unified_diff((OLD / name).read_text(encoding='utf8').splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=proposal['path'])).encode())
    return proposal, dict(before=before, proposal=proposal, exact_diff=diff, fromfile=before['path'], tofile=proposal['path'])


prior = ref(OLD / 'manifest.json')
assert prior['sha256'] == '72f75c5242e2df7457fb9fc065b2cc1fc5922f6bb9673e6b785e145bb54f47a1'
old = json.loads((OLD / 'manifest.json').read_bytes())
sources, differences = [], []
for row in old['own_sources']:
    before = ROOT / row['path']
    raw = before.read_bytes()
    assert hashlib.sha256(raw).hexdigest() == row['sha256'] and len(raw) == row['size_bytes']
    if before.name == 'geometry_loader_fields.hh':
        assert raw.count(b'#include <EnergyPlus/DataStringGlobals.hh>') == 1
        raw = raw.replace(b'#include <EnergyPlus/DataStringGlobals.hh>', b'#include <EnergyPlus/Construction.hh>\n#include <EnergyPlus/DataStringGlobals.hh>', 1)
        needle = b'    return {{"capture_boundary", "returned HeatBalanceManager::GetBuildingData with actual loader_ErrorsFound false"},'
        assert raw.count(needle) == 1
        addition = b'''    auto const &construct = state.dataConstruction->Construct;
    json constructions = json::array();
    if (construct.allocated())
        for (int i = construct.l(); i <= construct.u(); ++i)
            constructions.push_back({{"id", i}, {"name", construct(i).Name}});
    json construction_allocation = {{"container", "ObjexxFCL::Array1D"}, {"allocated", construct.allocated()}, {"size", construct.size()},
        {"lower", construct.allocated() ? json(construct.l()) : json(nullptr)},
        {"upper", construct.allocated() ? json(construct.u()) : json(nullptr)}};
'''
        raw = raw.replace(needle, addition + needle, 1)
        needle = b'        {"zones", zones}, {"spaces", spaces}, {"surfaces", surfaces}, {"actual_parsed_input_family_counts", family_counts(state)},'
        assert raw.count(needle) == 1
        raw = raw.replace(needle, needle + b'\n        {"constructions", constructions}, {"construction_allocation", construction_allocation}, {"TotConstructs", state.dataHeatBal->TotConstructs},\n        {"actual_parsed_input_epJSON", state.dataInputProcessing->inputProcessor->epJSON},', 1)
    elif before.name == 'geometry_loader.cmake':
        raw = raw.replace(b'GEOMETRY_LOADER_V3', b'GEOMETRY_LOADER_V4').replace(b'_geometry_loader_v3_', b'_geometry_loader_v4_').replace(b'geometry_loader_v3_add_reference', b'geometry_loader_v4_add_reference').replace(b'geometry_loader_helper_v3', b'geometry_loader_helper_v4')
    source, diff = correspondence(before.name, raw)
    sources.append(source)
    differences.append(diff)
request_old = json.loads((OLD / 'request.proposed.json').read_bytes())
request = copy.deepcopy(request_old)
request['native_source_files'] = sources
request_ref, request_diff = correspondence('request.proposed.json', (json.dumps(request, indent=2) + '\n').encode())
differences.append(request_diff)
readme = (OLD / 'README.md').read_text(encoding='utf8')
readme += '\nSuccessor04 adds only read-only witnesses at the existing returned GetBuildingData boundary: the complete actual InputProcessor.epJSON object (including its real IDF-order/internal metadata), and actual Construction Array1D allocation/bounds/all allocated ID/name rows plus actual TotConstructs. The table uses actual array indices, including allocated tail rows; it does not infer construction IDs from input order or Rust. No parser, cleanup, name normalization, formula, geometry call or additional getter is invoked. All previous selected geometry/context/callback/prefix fields remain present. The fixed input, thirteen actual loader calls and helper main remain byte exact03.\n\nRecipe04 appends only a distinct geometry_loader_helper_v4 target, GEOMETRY_LOADER_V4 variables/once guard and geometry_loader_v4_add_reference function with the same-parent six-file closure. Source03 and its actual v3 configure/build/provider evidence remain historical. Fresh configuration must authenticate the actual restored 743-row dispatcher graph and add only this v4 TU to 744 rows; Source03 wording about an earlier configured target is historical, not a live-graph assertion. No configure, build, target, result, canonical or Git action occurred during this Source preparation. This supplements required identity/Raw witnesses and makes no numerical or ordinary-integration PASS claim.\n'
doc, doc_diff = correspondence('README.md', readme.encode())
differences.append(doc_diff)
new = copy.deepcopy(old)
new.update(own_sources=sources, authoring_source=ref(Path(__file__)), README=doc, prospective_request=request_ref, previous_preparation=prior, authentic_before_manifest=write(OUT / 'before-03/manifest.json', (OLD / 'manifest.json').read_bytes()), incremental_correspondence=differences, prior_incremental_correspondence=old['incremental_correspondence'], prior_authoring_source=old['authoring_source'], independent_successor_target='geometry_loader_helper_v4', previous_configured_target_retained=None, previous_configured_target_note='Source03 phrase is historical; fresh v4 configuration authenticates actual restored dispatcher743 and adds sole v4 TU', declared_readonly_owner_completeness_correction=True, unchanged_helper_primary_fields_and_other_two_copied_headers=False, unchanged_helper_main_and_all_three_copied_headers=True)
for name, lo, hi, purpose in [('Construction.hh', 133, 143, 'actual ConstructionProps Name owner'), ('Construction.hh', 360, 370, 'actual Objexx Array1D construction owner declaration'), ('DataHeatBalance.hh', 1854, 1864, 'actual TotConstructs owner'), ('HeatBalanceManager.cc', 1390, 1404, 'actual GetConstructData allocation and TotConstructs assignment'), ('HeatBalanceManager.cc', 1452, 1458, 'actual input name assignment into Construction owner'), ('InputProcessing/InputProcessor.hh', 307, 315, 'actual public parsed epJSON owner copied whole without cleanup')]:
    whole = ref(ROOT / '.reference/energyplus-src/26.1.0/src/EnergyPlus' / name)
    literal = write(OUT / 'ranges' / (name.replace('/', '_') + f'.{lo}-{hi}.literal'), b''.join((ROOT / whole['path']).read_bytes().splitlines(keepends=True)[lo-1:hi]))
    new['Source_ranges'].append(dict(path=whole['path'], whole_Source=whole, start_line=lo, end_line=hi, sha256=literal['sha256'], size_bytes=literal['size_bytes'], literal_archive=literal, purpose=purpose))
    if whole not in new['whole_Original_sources']:
        new['whole_Original_sources'].append(whole)
new['runtime_interfaces'].update(target='geometry_loader_helper_v4', argv=['geometry_loader_helper_v4.exe', 'repository-root', 'request-path', 'fresh-contained-SRC06-output'], CMake_Source_directory_variable='GEOMETRY_LOADER_V4_SOURCE_DIR', inherited_recipe_variable='GEOMETRY_LOADER_V4_INHERITED_RECIPE', returned_readonly_identity_and_Raw_witnesses=['constructions', 'construction_allocation', 'TotConstructs', 'actual_parsed_input_epJSON'])
assert all(request[key] == request_old[key] for key in request if key != 'native_source_files')
assert all(source['sha256'] == parent['sha256'] for source, parent in zip(sources, old['own_sources']) if Path(source['path']).name not in ('geometry_loader_fields.hh', 'geometry_loader.cmake'))
ast.parse(Path(__file__).read_bytes())
print(json.dumps(write(OUT / 'manifest.json', (json.dumps(new, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())))

"""Preserve unexecuted01; correct its exact configure-preparation schema spelling."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD, OUT = BASE / 'ordinary-geometry-provider-prep-01', BASE / 'ordinary-geometry-provider-prep-02'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


old = json.loads((OLD / 'manifest.json').read_bytes())
raw = (OLD / 'collect_providers.py').read_bytes()
needle = b'ordinary-geometry-configure-Source-preparation.v1'
replacement = b'ordinary-geometry-configure-dry-Source-preparation.v1'
assert raw.count(needle) == 1
raw = raw.replace(needle, replacement, 1); ast.parse(raw)
before = write(OUT / 'before/collect_providers01.py', (OLD / 'collect_providers.py').read_bytes())
collector = write(OUT / 'collect_providers.py', raw)
delta = write(OUT / 'collect_providers.py.diff', ''.join(difflib.unified_diff((OLD / 'collect_providers.py').read_text(encoding='utf8').splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=collector['path'])).encode())
contract = write(OUT / 'provider-contract.json', (OLD / 'provider-contract.json').read_bytes())
doc = write(OUT / 'README.md', (OLD / 'README.md').read_bytes() + b'\nSuccessor02 corrects only the exact actual configure-preparation schema spelling to ordinary-geometry-configure-dry-Source-preparation.v1. Source-only self-review found01 before any collector/tool execution. Provider contract, all sixteen symbols, literal Source ranges, arithmetic-independent collection and full custody rules are byte-exact01;01 remains immutable.\n')
m = copy.deepcopy(old)
m.update(own_sources=[collector, contract, doc, ref(Path(__file__))], accepted_predecessor=ref(OLD / 'manifest.json'), predecessor_own_sources=old['own_sources'], narrow_source_correspondence=dict(before=before, proposal=collector, exact_diff=delta))
m['runtime_interfaces']['collector'] = collector
assert json.loads((ROOT / m['configure_Source_preparation']['path']).read_bytes())['schema'] == replacement.decode()
print(json.dumps(write(OUT / 'manifest.json', (json.dumps(m, ensure_ascii=False, indent=2) + '\n').encode())))


// min( double, double )
inline
double
min( double const a, double const b )
{
	return ( a < b ? a : b );
}

// min( long double, long double )
inline
long double
min( long double const a, long double const b )
{
	return ( a < b ? a : b );
}

// Use std::min for 2 arguments not covered by the above overloads
using std::min;

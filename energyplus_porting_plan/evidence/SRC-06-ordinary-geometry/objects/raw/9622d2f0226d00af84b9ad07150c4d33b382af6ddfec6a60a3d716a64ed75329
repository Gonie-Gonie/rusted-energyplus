"""Preserve unexecuted02; authenticate typed physical-line Source ranges before full references."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD, OUT = BASE / 'ordinary-geometry-execution-prep-02', BASE / 'ordinary-geometry-execution-prep-03'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)
    return ref(path)


m = json.loads((OLD / 'manifest.json').read_bytes())
before_raw = (OLD / 'run_execution.py').read_bytes()
needle = b"    if isinstance(value, dict):\n        if 'path' in value and 'sha256' in value:\n"
replacement = b"""    if isinstance(value, dict):
        if all(key in value for key in ('path', 'start_line', 'end_line', 'literal_archive', 'whole_Source')):
            whole = bind(value['whole_Source']); literal = bind(value['literal_archive'])
            need(whole == (ROOT / value['path']).resolve(), 'typed Source range whole path differs')
            lines = whole.read_bytes().splitlines(keepends=True)
            start, end = value['start_line'], value['end_line']
            need(type(start) is int and type(end) is int and 1 <= start <= end <= len(lines), 'typed physical-line bounds differ')
            raw = b''.join(lines[start - 1:end])
            need(raw == literal.read_bytes() and hashlib.sha256(raw).hexdigest() == value['sha256'] and len(raw) == value['size_bytes'], 'typed Source range bytes differ')
            return
        if 'path' in value and 'sha256' in value:
"""
assert before_raw.count(needle) == 1
raw = before_raw.replace(needle, replacement, 1)
ast.parse(raw)
before = write(OUT / 'before/execution02.py', before_raw)
driver = write(OUT / 'run_execution.py', raw)
delta = write(OUT / 'run_execution.py.diff', ''.join(difflib.unified_diff(before_raw.decode().splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=driver['path'])).encode())
doc_before = write(OUT / 'before/README02.md', (OLD / 'README.md').read_bytes())
doc = write(OUT / 'README.md', (OLD / 'README.md').read_bytes() + b'\nSuccessor03 repairs the independent Source peer finding before any execution: typed physical-line Source ranges authenticate the pinned whole Original source and literal archive separately, then compare every literal slice byte, SHA, size and physical bounds. Their outer slice SHA is never used as a whole-file SHA. Both whole and archive full references remain frozen before and after capture. Generic full references and all engine/input/output rules are unchanged;01/02 stay preserved and unexecuted.\n')
doc_delta = write(OUT / 'README.md.diff', ''.join(difflib.unified_diff((OLD / 'README.md').read_text(encoding='utf8').splitlines(True), (OUT / 'README.md').read_text(encoding='utf8').splitlines(True), fromfile=doc_before['path'], tofile=doc['path'])).encode())
previous_sources = copy.deepcopy(m['own_sources'])
m.update(own_sources=[driver, doc, ref(Path(__file__))], accepted_predecessor=ref(OLD / 'manifest.json'), predecessor_own_sources=previous_sources, narrow_source_correspondence=dict(before=before, proposal=driver, exact_diff=delta), narrow_document_correspondence=dict(before=doc_before, proposal=doc, exact_diff=doc_delta), earlier_source_correspondence=m['narrow_source_correspondence'], earlier_document_correspondence=m['narrow_document_correspondence'])
m['runtime_interfaces']['driver'] = driver
print(json.dumps(write(OUT / 'manifest.json', (json.dumps(m, ensure_ascii=False, indent=2) + '\n').encode())))

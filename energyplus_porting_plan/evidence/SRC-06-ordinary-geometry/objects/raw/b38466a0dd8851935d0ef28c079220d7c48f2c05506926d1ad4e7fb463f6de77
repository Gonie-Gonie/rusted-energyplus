"""Bounded input/source metadata helpers; no scientific code or process execution."""
import hashlib
import json
from pathlib import Path
import re
import stat

ROOT = Path(__file__).resolve().parents[4]
SEEN = {}


def need(value, message):
    if not value:
        raise ValueError(message)


def path(value):
    candidate = ROOT / value
    resolved = candidate.resolve()
    need(resolved != ROOT and resolved.is_relative_to(ROOT), 'Contained path required')
    for item in [candidate, *candidate.parents]:
        if item == ROOT.parent:
            break
        if item.exists():
            need(not item.is_symlink() and not (item.lstat().st_file_attributes & stat.FILE_ATTRIBUTE_REPARSE_POINT),
                 'No symlink/reparse path component admitted')
    return resolved


def sha(file):
    result = hashlib.sha256()
    with file.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            result.update(chunk)
    return result.hexdigest()


def ref(file):
    return {'path': file.relative_to(ROOT).as_posix(), 'sha256': sha(file), 'size_bytes': file.stat().st_size}


def argument(value):
    location, digest = value.rsplit('#', 1)
    need(re.fullmatch('[0-9a-f]{64}', digest) is not None, 'Explicit SHA256 required')
    return {'path': path(location).relative_to(ROOT).as_posix(), 'sha256': digest}


def checked(binding, maximum=16 * 1024 * 1024):
    file = path(binding['path'])
    need(file.is_file() and file.stat().st_size <= maximum, 'Bounded regular input/source required')
    need(sha(file) == binding['sha256'], 'Bound input bytes differ: ' + str(file))
    if 'size_bytes' in binding:
        need(type(binding['size_bytes']) is int and file.stat().st_size == binding['size_bytes'], 'Bound input size differs')
    need(file not in SEEN or SEEN[file] == binding['sha256'], 'Conflicting input bindings')
    SEEN[file] = binding['sha256']
    return file


def read(binding):
    return json.loads(checked(binding).read_text(encoding='utf-8'))


def unchanged():
    for file, digest in SEEN.items():
        need(sha(file) == digest, 'Input/source changed: ' + str(file))


def fresh_output(value):
    out = path(value)
    need(out.is_relative_to(ROOT / '.runtime/porting/SCH-01') and not out.exists(), 'Fresh ignored SCH01 output required')
    out.mkdir(parents=True)
    return out


def write_json(file, value):
    need(not file.exists(), 'Refusing to overwrite output')
    file.write_text(json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + '\n', encoding='utf-8', newline='\n')


def emit(out, filename, value):
    unchanged()
    write_json(out / filename, value)
    unchanged()
    print(json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False))

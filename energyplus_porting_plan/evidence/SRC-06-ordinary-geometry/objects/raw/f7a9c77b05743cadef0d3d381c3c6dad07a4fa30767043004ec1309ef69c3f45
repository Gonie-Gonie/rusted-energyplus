def ref(path, lines=True):
    path = Path(path)
    size = 0
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            size += len(block)
            digest.update(block)
    try:
        name = path.relative_to(ROOT).as_posix()
    except ValueError:
        name = str(path)
    result = dict(path=name, sha256=digest.hexdigest(), size_bytes=size)
    if lines:
        result['line_count'] = len(path.read_bytes().splitlines())
    return result


def fixed(name, sha, lines=True):
    row = ref(ROOT / name, lines)
    assert row['sha256'] == sha, name
    return row


def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(data)
    return ref(path)


def delta(before, after, old_label, new_label):
    return ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True),
                                        fromfile=old_label, tofile=new_label)).encode()


def pe_bytes(path, address, length):
    with Path(path).open('rb') as stream:
        dos = stream.read(64)
        assert dos[:2] == b'MZ'
        stream.seek(struct.unpack_from('<I', dos, 60)[0])
        coff = stream.read(24)
        assert coff[:4] == b'PE\0\0'
        optional = stream.read(struct.unpack_from('<H', coff, 20)[0])
        assert struct.unpack_from('<H', optional)[0] == 0x20b
        image_base = struct.unpack_from('<Q', optional, 24)[0]
        rva = address - image_base
        sections = [stream.read(40) for _ in range(struct.unpack_from('<H', coff, 6)[0])]
        section = next(s for s in sections if struct.unpack_from('<I', s, 12)[0] <= rva <
                       struct.unpack_from('<I', s, 12)[0] + max(struct.unpack_from('<I', s, 8)[0], struct.unpack_from('<I', s, 16)[0]))
        stream.seek(struct.unpack_from('<I', section, 20)[0] + rva - struct.unpack_from('<I', section, 12)[0])
        data = stream.read(length)
        assert len(data) == length
        return data



"""UNSEALED Root-only comparison transport draft; no equations or Native replay."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[4]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for key in ['source-preparation', 'application', 'formatter-review', 'Source-snapshot', 'Rust-custody',
                'Root-Rust-factual-review', 'independent-Rust-factual-review', 'output-dir']:
        parser.add_argument('--' + key, required=True)
    args = parser.parse_args()
    name, sha = args.source_preparation.rsplit('#', 1); path = (ROOT / name).resolve()
    if not path.is_relative_to(ROOT) or hashlib.sha256(path.read_bytes()).hexdigest() != sha:
        raise ValueError('reviewed workflow authority differs')
    prep = json.loads(path.read_bytes()); row = prep['runtime_interfaces']['validate']; validate_path = (ROOT / row['path']).resolve()
    if not validate_path.is_relative_to(ROOT) or hashlib.sha256(validate_path.read_bytes()).hexdigest() != row['sha256']:
        raise ValueError('reviewed validation Source differs')
    spec = importlib.util.spec_from_file_location('geometry_validation', validate_path)
    V = importlib.util.module_from_spec(spec); spec.loader.exec_module(V)
    M, A, prep_ref, prep = V.bootstrap(args.source_preparation)
    A.need(A.bind(prep['runtime_interfaces']['compare']) == Path(__file__).resolve(), 'actual comparison transport Source differs')
    prep['_actual_operand'] = args.source_preparation
    app_ref, review_ref, source = [A.operand(v) for v in [args.application, args.formatter_review, args.Source_snapshot]]
    app, fmt, observer = V.application(M, A, prep, app_ref, review_ref, source)
    rust_ref = A.operand(args.Rust_custody); rust = A.load(rust_ref)
    A.need(rust['schema'] == 'src06-ordinary-geometry-actual-Rust-capture-custody.v1'
           and rust['actual_application'] == app_ref and rust['Source_snapshot'] == source
           and rust['comparison_performed'] is False and rust['gates_updated'] is False,
           'closed actual same-Source geometry capture required')
    execution = A.load(rust['actual_execution'])
    A.need(execution['exit_code'] in [0, 2] and rust['actual_exit_code'] == execution['exit_code']
           and execution['launch_error'] is None and execution['source_bytes_match_before_and_after'] is True
           and execution['source_snapshot'] == source, 'actual geometry process custody differs')
    for row in [execution['stdout'], execution['stderr'], rust['actual_request'], rust['actual_executable_after']]: A.bind(row)
    A.need(execution['stdout'] == rust['actual_complete_stdout'] and execution['stderr'] == rust['actual_complete_stderr'], 'uncapped raw capture identities differ')
    request = A.load(rust['actual_request']); policy = observer['runtime_interfaces']['prospective_pairing_policy']
    A.need(request['pairing_policy'] == policy and request['runtime_source_bindings'] == app['runtime_source_bindings'], 'frozen policy/runtime request differs')
    facts = [A.operand(args.Root_Rust_factual_review), A.operand(args.independent_Rust_factual_review)]
    for ref in facts:
        review = A.load(ref)
        A.need(review['accepted'] is True and review['actual_custody'] == rust_ref
               and review['Source_snapshot'] == source and review['gates_updated'] is False,
               'Root and independent complete factual capture reviews required')
    release, native = M.baseline(A, prep)
    comparer_ref = prep['reviewed_comparer_Source_preparation']; comparer = A.load(comparer_ref)
    for row in comparer['own_sources']: A.bind(row)
    for ref in prep['comparer_FULL_Source_reviews']:
        review = A.load(ref)
        A.need(review['accepted'] is True and A.bind(review['reviewed_manifest']) == A.bind(comparer_ref), 'complete comparer Source review required')
    A.need(len(prep['comparer_FULL_Source_reviews']) == 2, 'Root and independent comparer Source reviews required')
    interface = comparer['runtime_interfaces']
    A.need(interface['required_options'] == ['--source-preparation', '--custody', '--output-dir']
           and A.bind(comparer['prospective_policy']).read_bytes() == A.bind(policy).read_bytes(),
           'future reviewed comparer must accept this exact prospective transport protocol')
    out = (ROOT / args.output_dir).resolve()
    A.need(out.is_relative_to(ROOT / '.runtime/porting/SRC-06') and not out.exists(), 'fresh ignored comparison transport output required')
    A.members(source, current=True); out.mkdir(parents=True)
    packet = dict(schema='src06-ordinary-geometry-comparison-custody.v1', actual_application=app_ref,
        actual_formatter_review=review_ref, Source_snapshot=source, Native_baseline_acceptance=prep['Native_baseline_acceptance'],
        Rust_execution_custody=rust_ref, Root_Rust_factual_review=facts[0], independent_Rust_factual_review=facts[1],
        prospective_policy=policy, protected_dispatcher_application=prep['protected_dispatcher_application'], protected_prior_summary=prep['protected_prior_summary'])
    packet_ref = A.dump(out / 'comparison-custody.json', packet)
    command = ['python', '-X', 'utf8', '-B', str(A.bind(interface['comparer'])),
        '--source-preparation', str(A.bind(comparer_ref)) + '#' + comparer_ref['sha256'],
        '--custody', str(A.bind(packet_ref)) + '#' + packet_ref['sha256'], '--output-dir', str(out / 'comparison')]
    A.dump(out / 'before.json', dict(Source_preparation=prep_ref, actual_custody=packet_ref, actual_comparer=comparer_ref, prospective_command=command))
    code = subprocess.call([sys.executable, '-X', 'utf8', '-B', str(A.bind(prep['recorder_Source'])), '--output-dir', str(out / 'command'), '--'] + command, cwd=ROOT)
    receipt_ref = A.ref(out / 'command/receipt.json'); receipt = A.load(receipt_ref)
    A.need(receipt['exit_code'] == code and receipt['command'] == command and receipt['launch_error'] is None
           and receipt['source_snapshot'] == source and receipt['source_bytes_match_before_and_after'] is True,
           'actual comparison command/Source custody differs')
    A.need(execution['finished_utc'] <= receipt['started_utc'] and native['finished_utc'] <= receipt['started_utc'], 'both captures must close before comparison')
    for row in [receipt['stdout'], receipt['stderr'], packet_ref, policy]: A.bind(row)
    A.members(source, current=True); V.application(M, A, prep, app_ref, review_ref, source)
    # An actual nonzero comparison remains a retained failure. No result is interpreted here.
    record = dict(schema='src06-ordinary-geometry-actual-comparison-transport.v1', Source_preparation=prep_ref,
        actual_custody=packet_ref, actual_comparer=comparer_ref, actual_execution=receipt_ref, actual_exit_code=code,
        actual_complete_stdout=receipt['stdout'], actual_complete_stderr=receipt['stderr'], Source_snapshot=source,
        numerical_results_parsed=False, whole_geometry_or_ordinary_PASS_claimed=False, gates_updated=False)
    print(json.dumps(dict(record=A.dump(out / 'record.json', record)))); return code


if __name__ == '__main__': sys.exit(main())

"""Repair only selected Source correspondence container shapes; never invoke publication."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OUT = BASE / 'ordinary-geometry-publication-prep-03'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def checked(row):
    path = ROOT / row['path']; actual = ref(path)
    assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes'])
    return path


def load(row): return json.loads(checked(row).read_bytes())


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def dump(path, value): return write(path, (json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode())


def pair(out, name, before_ref, raw):
    old = checked(before_ref).read_bytes(); before = write(out / 'before' / name, old); proposal = write(out / name, raw)
    delta = write(out / (name + '.diff'), ''.join(difflib.unified_diff(old.decode().splitlines(True),raw.decode().splitlines(True),fromfile=before['path'],tofile=proposal['path'])).encode())
    return dict(before=before, proposal=proposal, exact_diff=delta)


def main():
    parent_ref = ref(BASE / 'ordinary-geometry-publication-prep-02/manifest.json')
    assert parent_ref['sha256'] == 'c2cf3136a87af7c37421220d33c5ab5f0abe6f6549e7a3d4151199f7840f76a5'
    parent = load(parent_ref); failure_ref = ref(BASE / 'ordinary-geometry-publication-command-02/receipt.json')
    assert failure_ref['sha256'] == '723a531849fe136e6292ba65b91663b602e76a967cf24b17e73db48af3136e01'
    failure = load(failure_ref); assert failure['exit_code'] == 1 and failure['finished_utc'] is not None and failure['source_bytes_match_before_and_after'] is True
    assert b"AttributeError: 'str' object has no attribute 'get'" in checked(failure['stderr']).read_bytes()
    token = failure['command'][-1]; name, sha = token.rsplit('#',1); packet = load(dict(path=name,sha256=sha))
    approval = load(ref(BASE / 'ordinary-geometry-provider-acceptance-02/acceptance.json')); inventory = load(approval['provider_inventory'])
    refs = parent['historical_Source_preparations'] + [parent[k] for k in ['geometry_Source_preparation','observer_Source_preparation','Native_Source_preparation']]
    refs += [packet['workflow_Source_preparation'],packet['comparer_Source_preparation'],parent['actual_application_Source_preparation'],approval['provider_collection_preparation'],approval['reviewed_execution_Source_preparation'],inventory['configure_preparation'],parent_ref]
    families = ['own_sources','application_sources','Source_ranges','Source_context_ranges','literal_Source_ranges','Original_helper_ranges','Original_provider_entry_ranges','Original_owner_ranges','selected_source_ranges','source_correspondence','incremental_correspondence','prior_incremental_correspondence','inherited_source_correspondence','previous_source_correspondence','narrow_source_correspondence','previous_narrow_source_correspondence']
    audited, singles = {}, []
    for row in refs:
        if row['path'] in audited: continue
        value = load(row); audited[row['path']] = row
        for family in families:
            items = value.get(family, [])
            if isinstance(items, dict):
                assert family in families[9:] and set(items) == {'before','proposal','exact_diff'}
                singles.append(dict(Source_preparation=row,field=family,exact_keys=list(items))); items = [items]
            assert isinstance(items,list) and all(isinstance(item,dict) for item in items)
    assert len(audited) == 32 and len(singles) == 18
    old = checked(parent['own_sources'][0]).read_bytes()
    needle = b"        for item in value.get(family, []):\n            for key in ['before', 'before_proposal', 'before_archive', 'proposal', 'exact_diff']:\n"
    replacement = b"        items = value.get(family, [])\n        if isinstance(items, dict):\n            need(set(items) == {'before', 'proposal', 'exact_diff'}, 'exact single Source correspondence shape required')\n            items = [items]\n        need(isinstance(items, list) and all(isinstance(item, dict) for item in items), 'Source correspondence entries must be objects')\n        for item in items:\n            for key in ['before', 'before_proposal', 'before_archive', 'proposal', 'exact_diff']:\n"
    assert old.count(needle) == 1; raw = old.replace(needle,replacement); assert raw.replace(replacement,needle) == old; ast.parse(raw)
    assert not OUT.exists() and not (ROOT/'energyplus_porting_plan/evidence/SRC-06-ordinary-geometry').exists()
    code = pair(OUT,'publish.py',parent['own_sources'][0],raw)
    readme = pair(OUT,'README.md',parent['own_sources'][1],checked(parent['own_sources'][1]).read_bytes()+b'\nSuccessor03 only accepts the two actual selected Source-correspondence container shapes: a list of object rows, or one exact before/proposal/exact_diff object normalized to a one-item list. All selected Source manifest list/member shapes were audited before seal; malformed types remain errors. The failed publication02 closed receipt and full logs are retained. Mandatory producer loads, historical application/current comparison separation, full artifact hashes, closed-log guards, storage, science and policy remain unchanged.\n')
    audit = dump(OUT/'selected-Source-metadata-shape-audit.json',dict(schema='src06-geometry-selected-Source-metadata-shape-audit.v1',Source_preparations=list(audited.values()),Source_preparation_count=len(audited),exact_single_correspondence_objects=singles,all_other_selected_list_member_shapes_valid=True,actual_result_payloads_or_ledger_values_read=False,publisher_imported_or_executed=False))
    manifest = copy.deepcopy(parent)
    manifest.update(parent_Source_preparation=parent_ref,own_sources=[code['proposal'],readme['proposal'],ref(Path(__file__))],narrow_source_correspondence=[code,readme],
        selected_Source_metadata_shape_audit=audit,fixed_evidence=parent['fixed_evidence']+[audit,failure_ref,failure['stdout'],failure['stderr'],failure['executed_launcher']['archive']],
        retained_closed_failures=parent['retained_closed_failures']+[failure_ref],historical_Source_preparations=parent['historical_Source_preparations']+[parent_ref],
        successor_scope='Only strict single-object versus list Source correspondence transport; prior failed publication02 preserved.')
    manifest['runtime_interfaces']['publisher']=code['proposal']; manifest_ref=dump(OUT/'manifest.json',manifest)
    cold=ROOT/'.runtime/porting/SRC-05/cold-guard-native-invocation-plan-01'; prior=ref(cold/'prepare_native02.py')
    assert prior['sha256']=='ebdde9778ea64d4c4d38de29eaaaee5b85f237daa93f5ab847a4f511973ae7d2'
    old=checked(prior).read_bytes(); needle=parent_ref['sha256'].encode(); assert old.count(needle)==1
    raw=old.replace(needle,manifest_ref['sha256'].encode()); ast.parse(raw)
    cold_pair=pair(cold,'prepare_native03.py',prior,raw)
    cold_record=dump(cold/'runner03-Source-correspondence.json',dict(schema='src05-cold-guard-runner-Source-correspondence.v1',actual_author_Source=ref(Path(__file__)),publisher_Source_preparation=manifest_ref,source_correspondence=cold_pair,only_exact_publisher_pin_changed=True,runner_invoked=False,gates_updated=False))
    print(json.dumps(dict(publisher=manifest_ref,cold_runner=cold_pair['proposal'],cold_Source_correspondence=cold_record)))


if __name__ == '__main__': main()

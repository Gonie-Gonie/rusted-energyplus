"""Preserve unexecuted01 and respect recorder log descriptors' optional declared sizes."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD, OUT = BASE / 'ordinary-geometry-execution-prep-01', BASE / 'ordinary-geometry-execution-prep-02'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)
    return ref(path)


m = json.loads((OLD / 'manifest.json').read_bytes())
before_raw = (OLD / 'run_execution.py').read_bytes()
old = b"logs[k]['size_bytes'] == value[k]['size_bytes']"
new = b"all(value[k][size_key] == logs[k]['size_bytes'] for size_key in ('size_bytes', 'bytes') if size_key in value[k])"
assert before_raw.count(old) == 1
raw = before_raw.replace(old, new, 1)
ast.parse(raw)
before = write(OUT / 'before/execution01.py', before_raw)
driver = write(OUT / 'run_execution.py', raw)
delta = write(OUT / 'run_execution.py.diff', ''.join(difflib.unified_diff(before_raw.decode().splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=driver['path'])).encode())
doc_before = write(OUT / 'before/README01.md', (OLD / 'README.md').read_bytes())
doc = write(OUT / 'README.md', (OLD / 'README.md').read_bytes() + b'\nSuccessor02 preserves unexecuted01 and corrects its log-descriptor guard: the genuine recorder supplies mandatory path/SHA, with optional declared size. Full actual log size is always derived and retained; any supplied size remains strict. Source-only preflight found this before any driver execution. All provider/input/core/Source/argc and output custody rules are unchanged.\n')
doc_delta = write(OUT / 'README.md.diff', ''.join(difflib.unified_diff((OLD / 'README.md').read_text(encoding='utf8').splitlines(True), (OUT / 'README.md').read_text(encoding='utf8').splitlines(True), fromfile=doc_before['path'], tofile=doc['path'])).encode())
previous_sources = copy.deepcopy(m['own_sources'])
m.update(own_sources=[driver, doc, ref(Path(__file__))], accepted_predecessor=ref(OLD / 'manifest.json'), predecessor_own_sources=previous_sources, narrow_source_correspondence=dict(before=before, proposal=driver, exact_diff=delta), narrow_document_correspondence=dict(before=doc_before, proposal=doc, exact_diff=doc_delta))
m['runtime_interfaces']['driver'] = driver
print(json.dumps(write(OUT / 'manifest.json', (json.dumps(m, ensure_ascii=False, indent=2) + '\n').encode())))

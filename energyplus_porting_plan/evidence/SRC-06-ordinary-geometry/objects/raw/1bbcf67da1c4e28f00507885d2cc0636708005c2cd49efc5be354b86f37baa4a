import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-06'
OLD, OUT = BASE / 'ordinary-geometry-execution-prep-04', BASE / 'ordinary-geometry-execution-prep-05'


def ref(path):
    raw = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(raw)
    return ref(path)


def body(name, raw):
    before = write(OUT / 'before' / name, (OLD / name).read_bytes())
    proposal = write(OUT / name, raw)
    delta = write(OUT / (name + '.diff'), ''.join(difflib.unified_diff((OLD / name).read_text(encoding='utf8').splitlines(True), raw.decode().splitlines(True), fromfile=before['path'], tofile=proposal['path'])).encode())
    return proposal, dict(before=before, proposal=proposal, exact_diff=delta)



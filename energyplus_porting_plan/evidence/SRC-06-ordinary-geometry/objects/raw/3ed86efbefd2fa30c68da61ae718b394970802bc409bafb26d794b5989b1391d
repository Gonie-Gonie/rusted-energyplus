"""Authenticate closed actual capture, Source, quality, PE and factual acceptance metadata."""
import hashlib
import json
from pathlib import Path
import struct


def identity(C, a, b, external=False):
    pa = C.exact(a, external_binary=external); pb = C.exact(b, external_binary=external)
    C.need(pa.samefile(pb), 'declared artifact paths differ')
    return pa


def snapshot(C, row, current=False):
    value = C.load(row)
    C.need(value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False, 'complete literal Source snapshot required')
    members = {}
    for item in value['files']:
        name = item['historical_path']; C.need(name not in members, 'duplicate Source member')
        archive = C.exact(item['archive'])
        C.need(archive.stat().st_size == item['size_bytes'], 'Source archive size differs')
        members[name] = item
        if current:
            C.need((C.ROOT / name).resolve().is_relative_to(C.ROOT), 'escaped Source member')
            C.exact({'path': name, 'sha256': item['archive']['sha256'], 'size_bytes': item['size_bytes']})
    if current:
        actual = set((C.ROOT/'crates').rglob('*.rs')) | set((C.ROOT/'crates').rglob('Cargo.toml'))
        actual |= {C.ROOT/n for n in ('Cargo.toml','Cargo.lock','rust-toolchain.toml','.cargo/config.toml') if (C.ROOT/n).is_file()}
        C.need({(C.ROOT/n).resolve() for n in members} == {p.resolve() for p in actual}, 'full current Source membership differs')
    return members


def receipt(C, row, recorder, source, allowed=(0,)):
    value = C.receipt(row, recorder, allowed=allowed)
    identity(C, value['source_snapshot'], source)
    C.need(value['finished_utc'] is not None and value['started_utc'] <= value['finished_utc'], 'closed chronological command required')
    return value


def facts(C, row, schema, binding_key, binding):
    value = C.load(row)
    C.need(value['schema'] == schema and value['accepted'] is True and value['gates_updated'] is False, 'actual complete factual acceptance required')
    identity(C, value[binding_key], binding)
    return value


def authenticate(C, packet, manifest):
    C.need(packet['schema'] == 'src06-ordinary-geometry-comparison-custody.v1', 'reviewed geometry custody packet required')
    C.need(set(packet) == set(manifest['runtime_interfaces']['custody_keys']), 'exact geometry custody keys required')
    policy = C.load(packet['prospective_policy']); identity(C, packet['prospective_policy'], manifest['prospective_policy'])
    native_release = C.load(packet['Native_baseline_acceptance'])

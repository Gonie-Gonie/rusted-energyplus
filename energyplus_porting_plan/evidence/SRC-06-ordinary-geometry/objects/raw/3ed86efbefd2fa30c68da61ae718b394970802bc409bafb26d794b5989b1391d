    C.need(native_guard['schema'] == 'ordinary-geometry-execution-custody.v1' and native_before['schema'] == 'ordinary-geometry-execution-before.v1', 'actual Native before/custody required')
    identity(C, native_guard['actual_before'], native_release['actual_before']); identity(C, native_before['Source_preparation'], native_release['Native_Source_preparation'])
    identity(C, native_before['Source_snapshot'], native_release['Source_snapshot'])
    native_members = snapshot(C, native_before['Source_snapshot']); snapshot(C, native_before['build_Source_snapshot'])
    identity(C, native_guard['actual_command_receipt'], native_release['actual_Native_execution'])
    identity(C, native_guard['actual_authoritative_result'], native_release['actual_authoritative_result'])
    identity(C, native_before['Root_provider_acceptance'], native_release['actual_provider_acceptance'])
    native_receipt = receipt(C, native_guard['actual_command_receipt'], manifest['recorder_Source'], native_before['Source_snapshot'], (0,2))
    C.need(native_receipt['command'] == native_before['actual_argv'] and len(native_receipt['command']) == 4, 'actual Native argc4 differs')
    C.need(native_guard['actual_target_exit_code'] == native_guard['actual_recorder_exit_code'] == native_receipt['exit_code'] == 0
           and native_guard['all_frozen_artifacts_unchanged'] is True and native_guard['numerical_results_interpreted'] is False
           and native_guard['FP_controls_modified'] is False and native_guard['gates_updated'] is False, 'released closed Native custody required')
    identity(C, native_guard['actual_full_output_logs']['stdout'], native_receipt['stdout']); identity(C, native_guard['actual_full_output_logs']['stderr'], native_receipt['stderr'])
    for row in native_before['frozen_artifacts']:
        path = (C.ROOT/row['path']).resolve()
        name = path.relative_to(C.ROOT).as_posix() if path.is_relative_to(C.ROOT) else None
        if name in native_members:
            historical = native_members[name]
            C.need(row['sha256'] == historical['archive']['sha256'] and row['size_bytes'] == historical['size_bytes'], 'historical Native capture Source alias differs')
            C.exact(historical['archive'])
        else:
            C.exact(row, external_binary=Path(row['path']).is_absolute())
    after = native_guard['frozen_artifacts_after']
    C.need(len(after) == len(native_before['frozen_artifacts']) and all(v['available'] is True for v in after), 'complete actual Native after inventory required')
    for before, final in zip(native_before['frozen_artifacts'], after):
        C.need(all(before[k] == final[k] for k in ('path','sha256','size_bytes')), 'Native frozen bytes changed')
    produced = native_guard['produced_loader_files_full_SHA_inventory']
    C.need(len({str(C.exact(v)) for v in produced}) == len(produced), 'duplicate produced Native file')
    C.need(any(v['sha256'] == native_release['actual_authoritative_result']['sha256'] and C.exact(v).samefile(C.exact(native_release['actual_authoritative_result'])) for v in produced), 'authoritative Native file missing from complete inventory')
    for name in ('Root_factual_review','independent_FULL_factual_review'):
        proof = C.load(native_release[name]); C.need(proof['accepted'] is True and proof['gates_updated'] is False, 'both Native full factual acceptances required')
    native = C.load(native_release['actual_authoritative_result'])
    identity(C, native['actual_request'], native_before['actual_input']); identity(C, native['actual_binary'], native_before['actual_binary'], True)
    native_prep = C.load(manifest['Native_Source_preparation']); request = C.load(native_prep['prospective_request'])
    identity(C, native_before['actual_input'], native_prep['prospective_request'])
    identity(C, native_before['literal_IDF'], request['case']['input'])
    identity(C, native_before['actual_case_metadata'], request['case_metadata'])
    C.need(len(request['all_45_guard_refs']) == 45, 'complete forty-five original input guards required')
    for row in request['all_45_guard_refs']: C.exact(row)
    app = C.load(packet['actual_application']); source = packet['Source_snapshot']
    C.need(app['schema'] == 'src06-ordinary-geometry-actual-application.v1', 'actual ten-path geometry application required')
    C.exact(app['Source_preparation'])
    identity(C, app['geometry_Source_preparation'], manifest['geometry_Source_preparation']); identity(C, app['observer_Source_preparation'], manifest['observer_Source_preparation'])
    identity(C, app['Native_baseline_acceptance'], packet['Native_baseline_acceptance']); identity(C, app['source_final'], source)
    rows = app['application']; C.need(len(rows) == 10 and len({r['canonical_path'] for r in rows}) == 10, 'complete ten application rows required')
    old = snapshot(C, app['source_before']); literal = snapshot(C, app['source_literal']); final = snapshot(C, source, True)
    C.need(set(final) == set(literal) and len(final) == len(old) + 5, 'exact five new Rust members required')
    owned = {r['canonical_path'] for r in rows}
    C.need(all(old[k]['archive']['sha256'] == final[k]['archive']['sha256'] for k in set(old)-owned), 'unrelated Source changed')
    held = C.load(manifest['geometry_Source_preparation'])['application_sources'] + C.load(manifest['observer_Source_preparation'])['application_sources']
    C.need([r['canonical_path'] for r in rows] == [r['canonical_path'] for r in held], 'held application order differs')
    import difflib
    for row, approved in zip(rows, held):
        name = row['canonical_path']; proposal = C.exact(approved['proposal']); actual_literal = C.exact(row['actual_literal_archive']); actual_final = C.exact(row['actual_final_archive'])
        C.need(all(row[k] == v for k,v in approved.items()), 'held Source row ancestry differs')
        actual_before = C.exact(row['actual_before_archive']).read_bytes()
        if approved['new_destination_absent']:
            C.need(name not in old and actual_before == b'', 'new Source member had a prior owner')
        else:
            C.need(actual_before == C.exact(approved['before_archive']).read_bytes() and hashlib.sha256(actual_before).hexdigest() == old[name]['archive']['sha256'], 'actual before bytes differ from held and full before Source')
        C.need(proposal.read_bytes() == actual_literal.read_bytes(), 'literal application differs from held Source')
        C.need(literal[name]['archive']['sha256'] == row['actual_literal_archive']['sha256'] and final[name]['archive']['sha256'] == row['actual_final_archive']['sha256'], 'application snapshot archive differs')
        C.need(C.exact(row['actual_final']).samefile(C.ROOT/name) and C.exact(row['actual_final']).read_bytes() == actual_final.read_bytes(), 'actual final canonical owner differs')
        for diff_key, before, after_bytes in [('actual_semantic_diff', C.exact(row['actual_before_archive']).read_bytes() if row.get('actual_before_archive') else b'', actual_literal.read_bytes()),('actual_formatter_diff', actual_literal.read_bytes(), actual_final.read_bytes())]:
            declared = C.exact(row[diff_key]).read_bytes()
            if not declared:
                C.need(before == after_bytes, 'empty diff has unequal endpoints')
            else:
                labels = declared.decode().splitlines(True)[:2]
                C.need(len(labels) == 2 and labels[0].startswith('--- ') and labels[1].startswith('+++ '), 'literal diff labels missing')
                regenerated = ''.join(difflib.unified_diff(before.decode().splitlines(True),after_bytes.decode().splitlines(True),fromfile=labels[0][4:].rstrip('\n'),tofile=labels[1][4:].rstrip('\n'))).encode()
                C.need(regenerated == declared, 'semantic/formatter diff correspondence differs')
    approval = C.load(packet['actual_formatter_review']); C.need(approval['Root_FULL_formatter_correspondence_accepted'] is True and approval['independent_FULL_formatter_correspondence_accepted'] is True, 'both actual formatter acceptances required')
    identity(C, approval['actual_application'], packet['actual_application']); identity(C, approval['Source_snapshot'], source)
    for name in ('protected_dispatcher_application','protected_prior_summary'):
        identity(C, app[name], packet[name])
    dispatcher = C.load(packet['protected_dispatcher_application'])
    for row in dispatcher['application']:
        C.need(row['canonical_path'] not in owned, 'geometry overlaps protected dispatcher Source')
        C.need(final[row['canonical_path']]['archive']['sha256'] == row['actual_final_archive']['sha256'], 'protected dispatcher Source changed')
    rust_guard = C.load(packet['Rust_execution_custody'])
    C.need(rust_guard['schema'] == 'src06-ordinary-geometry-actual-Rust-capture-custody.v1', 'closed actual Rust capture required')
    identity(C, rust_guard['actual_application'], packet['actual_application']); identity(C, rust_guard['Source_snapshot'], source)
    build_record = C.load(rust_guard['actual_build_record'])
    C.need(build_record['schema'] == 'src06-ordinary-geometry-actual-quality-and-artifact.v1', 'actual four quality/build/PE packet required')
    identity(C, build_record['Source_snapshot'], source)
    quality = build_record['quality_executions']; C.need(len(quality) == 4, 'exact four quality commands required')
    commands = manifest['runtime_interfaces']['required_quality_commands']
    previous = C.load(app['actual_formatter_execution'])['finished_utc']
    C.need(list(quality) == list(commands), 'ordered four quality roles required')
    for role, command in commands.items():
        value = receipt(C, quality[role], manifest['recorder_Source'], source)
        C.need(value['command'] == command and previous <= value['started_utc'], 'actual quality argv or formatter chronology differs'); previous = value['finished_utc']
    artifact = build_record['actual_Cargo_artifact']
    identity(C, build_record['actual_application'], packet['actual_application']); identity(C, build_record['actual_formatter_review'], packet['actual_formatter_review'])
    C.need(C.exact(build_record['frozen_pair_policy']).read_bytes() == C.exact(manifest['prospective_policy']).read_bytes() == C.exact(build_record['pair_policy']).read_bytes(), 'policy bytes were not frozen before execution')
    cargo = receipt(C, artifact['actual_build_execution'], manifest['recorder_Source'], source)
    C.need(cargo['command'] == manifest['runtime_interfaces']['required_Cargo_build_command'] and previous <= cargo['started_utc'], 'actual Cargo example build differs')
    exe = C.exact(artifact['executable'], external_binary=True)
    messages = [json.loads(line) for line in C.exact(cargo['stdout']).read_text(encoding='utf-8').splitlines() if line.strip().startswith('{')]
    emitted = [v for v in messages if v.get('reason') == 'compiler-artifact' and v.get('target',{}).get('name') == 'src06_ordinary_geometry_observer' and v.get('executable')]
    C.need(len(emitted) == 1 and emitted[0] == artifact['cargo_message'] and Path(emitted[0]['executable']).resolve().samefile(exe), 'sole actual Cargo emitted example required')
    identity(C, artifact['actual_full_Cargo_JSON'], cargo['stdout'])
    capture = cargo['cargo_compiler_artifacts_capture']; C.need(capture['status'] == 'pass' and len(capture['rows']) == 1 and capture['rows'][0]['cargo_message'] == emitted[0], 'recorder immediate Cargo artifact capture differs')
    identity(C, capture['rows'][0]['executable'], artifact['executable'], True)
    C.need(emitted[0]['target']['kind'] == ['example'] and Path(emitted[0]['target']['src_path']).resolve() == C.ROOT/'crates/ep_run/examples/src06_ordinary_geometry_observer.rs' and emitted[0]['profile']['opt_level'] == '0' and emitted[0]['profile']['test'] is False, 'actual dev example profile/source differs')
    with exe.open('rb') as stream:
        header = stream.read(64); C.need(header[:2] == b'MZ', 'actual Windows PE required'); offset = struct.unpack_from('<I',header,60)[0]; stream.seek(offset); coff = stream.read(24)
        optional_size = struct.unpack_from('<H',coff,20)[0]; optional = stream.read(optional_size); sections = stream.read(struct.unpack_from('<H',coff,6)[0]*40); pe = coff+optional
    C.need(pe[:4] == b'PE\0\0' and struct.unpack_from('<H',pe,4)[0] == 0x8664 and struct.unpack_from('<H',pe,24)[0] == 0x20b and struct.unpack_from('<Q',pe,96)[0] == 8*1024*1024, 'actual x64 PE 8MiB stack required')
    inspection = artifact['PE_inspection']; identity(C,inspection['actual_binary'],artifact['executable'],True)
    C.need(C.exact(inspection['actual_PE_header_bytes']).read_bytes() == header+coff+optional+sections and inspection['PE_header_file_offset'] == offset and inspection['stack_reserve_bytes'] == 8*1024*1024,'actual archived PE header differs from executable')
    actual = receipt(C, rust_guard['actual_execution'], manifest['recorder_Source'], source, (0,2))
    artifact_acceptance = C.load(rust_guard['actual_Root_artifact_acceptance'])
    C.need(artifact_acceptance['Root_FULL_PE_and_Cargo_artifact_accepted'] is True, 'explicit Root PE/artifact acceptance required')
    identity(C, artifact_acceptance['actual_build_record'], rust_guard['actual_build_record']); identity(C, artifact_acceptance['Source_snapshot'], source); identity(C, artifact_acceptance['actual_executable'], artifact['executable'], True)
    req_ref = rust_guard['actual_request']; req = C.load(req_ref)
    C.need(len(actual['command']) == 3 and Path(actual['command'][0]).resolve().samefile(exe) and (C.ROOT/actual['command'][1]).resolve().samefile(C.exact(req_ref)) and actual['command'][2] == req_ref['sha256'] and cargo['finished_utc'] <= actual['started_utc'], 'actual Rust argc3/build chronology differs')
    identity(C, rust_guard['actual_complete_stdout'], actual['stdout']); identity(C, rust_guard['actual_complete_stderr'], actual['stderr'])
    identity(C, rust_guard['actual_executable_after'], artifact['executable'], True)
    C.need(C.exact(actual['stderr']).stat().st_size == 0 and rust_guard['actual_exit_code'] == actual['exit_code'], 'actual Rust output/exit custody differs')
    for name in ('Root_Rust_factual_review','independent_Rust_factual_review'):
        value = C.load(packet[name]); C.need(value['accepted'] is True and value['gates_updated'] is False, 'both actual Rust factual acceptances required'); identity(C, value['actual_custody'], packet['Rust_execution_custody']); identity(C, value['Source_snapshot'], source)
    C.need(set(req) == {'schema','input_context','runtime_source_bindings','pairing_policy'} and req['schema'] == 'src06-ordinary-geometry-observer-request.v1', 'exact input-only Rust request required')
    identity(C, req['input_context'], manifest['input_context']); identity(C, req['pairing_policy'], manifest['prospective_policy']); identity(C, req['runtime_source_bindings'], app['runtime_source_bindings'])
    bindings = C.load(req['runtime_source_bindings']); C.need(bindings['schema'] == 'src06-ordinary-geometry-runtime-source-bindings.v1', 'actual runtime Source packet required')
    interfaces = C.load(manifest['observer_Source_preparation'])['runtime_interfaces']
    for field, names in [('observer_sources','ordered_observer_source_paths'),('actual_public_API_sources','ordered_public_API_source_paths')]:
        C.need([r['path'] for r in bindings[field]] == interfaces[names], 'ordered runtime Source membership differs')
        for row in bindings[field]:
            C.exact(row); C.need(final[row['path']]['archive']['sha256'] == row['sha256'], 'runtime owner differs from actual formatted full Source')
    rust = C.load(actual['stdout']); C.need(rust['actual_runtime_source_bindings'] == bindings, 'actual Rust runtime packet differs')
    identity(C, rust['actual_request'], req_ref); identity(C, rust['actual_input_context'], req['input_context']); identity(C, rust['frozen_pairing_policy'], req['pairing_policy'])
    context = C.load(req['input_context'])
    identity(C, request['case']['input'], context['input'])
    historical_request = C.load(context['Native_input_request'])
    for name in ('schema','energyplus_commit','case','case_metadata','fixed_scope','all_45_guard_refs','inherited_input_only_request','loader_phase_order','expected_values_supplied','expected_exits_supplied','Native_results_supplied','scientific_execution_performed'):
        C.need(request[name] == historical_request[name], 'Native successor changed fixed scientific input contract: '+name)
    return native, rust, context, request, native_before

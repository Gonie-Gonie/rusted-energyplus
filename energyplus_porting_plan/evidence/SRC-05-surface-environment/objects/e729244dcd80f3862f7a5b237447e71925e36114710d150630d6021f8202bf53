include("${SRC05_REFERENCE_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  function(src05_place_reference)
    if(NOT TARGET src05_surface_environment_helper OR NOT IS_DIRECTORY "${SRC05_OUTPUT_DIR}")
      message(FATAL_ERROR "Reviewed helper and prepared output directory required")
    endif()
    set_target_properties(src05_surface_environment_helper PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${SRC05_OUTPUT_DIR}")
    get_target_property(_src05_link_options src05_surface_environment_helper LINK_OPTIONS)
    list(REMOVE_ITEM _src05_link_options "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/src05_surface_environment_helper.map")
    set_property(TARGET src05_surface_environment_helper PROPERTY LINK_OPTIONS "${_src05_link_options}")
    target_link_options(src05_surface_environment_helper PRIVATE "-Wl,-Map,${SRC05_OUTPUT_DIR}/src05_surface_environment_helper.map")
  endfunction()
  cmake_language(DEFER CALL src05_place_reference)
endif()

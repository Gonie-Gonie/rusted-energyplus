def need(condition, message):
    if not condition:
        raise ValueError(message)


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def exact(row, external_binary=False):
    path = (ROOT / row['path']).resolve()
    allowed = path.is_relative_to(ROOT) or (external_binary and path.is_absolute() and path.drive.upper() == 'D:' and path.suffix.lower() in ('.exe', '.map'))
    need(allowed and path.is_file(), 'missing or uncontained artifact: ' + row['path'])
    need(digest(path) == row['sha256'], 'artifact SHA differs: ' + row['path'])
    if 'size_bytes' in row:
        need(type(row['size_bytes']) is int and path.stat().st_size == row['size_bytes'], 'artifact size differs')
    SEEN[path] = row['sha256']
    return path


def unique(pairs):
    value = {}
    for key, item in pairs:
        need(key not in value, 'duplicate JSON member: ' + key)
        value[key] = item
    return value


def load(row):
    return json.loads(exact(row).read_text(encoding='utf-8-sig'), object_pairs_hook=unique, parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))


def ref(path):
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest(path), 'size_bytes': path.stat().st_size}


def same(left, right, path, phase):
    COUNTS[phase] += 1
    if type(left) is not type(right) or left != right:
        MISMATCHES.append({'phase': phase, 'path': path, 'Native_or_required': left, 'Rust_or_observed': right})


def scalar(value):
    need(isinstance(value, dict) and set(value) == {'value', 'value_bits', 'value_class'}, 'complete scalar DTO required')
    token = value['value_bits']
    need(isinstance(token, str) and len(token) == 16 and all(c in '0123456789abcdef' for c in token), 'canonical scalar bits required')
    number = struct.unpack('>d', bytes.fromhex(token))[0]
    kind = 'nan' if math.isnan(number) else 'positive_infinity' if number == math.inf else 'negative_infinity' if number == -math.inf else ('negative_zero' if token[0] == '8' else 'positive_zero') if number == 0 else 'finite'
    need(value['value_class'] == kind, 'scalar class differs from bits')
    if math.isfinite(number):
        need(type(value['value']) in (int, float) and struct.pack('>d', float(value['value'])).hex() == token, 'decimal scalar differs from bits')
    else:
        need(value['value'] is None, 'nonfinite scalar must retain null decimal')
    return token, kind


def literal(value):
    need(isinstance(value, dict) and set(value) == {'bits'}, 'literal-only bit operand required')
    token = value['bits']
    need(isinstance(token, str) and len(token) == 16 and all(c in '0123456789abcdef' for c in token), 'canonical input bits required')
    number = struct.unpack('>d', bytes.fromhex(token))[0]
    return token, 'nan' if math.isnan(number) else 'positive_infinity' if number == math.inf else 'negative_infinity' if number == -math.inf else ('negative_zero' if token[0] == '8' else 'positive_zero') if number == 0 else 'finite'


def unavailable(path, reason, details=None):
    UNAVAILABLE.append({'path': path, 'reason': reason, 'required_for_whole_unit': True, 'counted_as_PASS': False, 'details': details})


def receipt(row, recorder, allowed=(0,)):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] in allowed and value['launch_error'] is None, 'actual command outcome unavailable')
    need(value['source_bytes_match_before_and_after'] is True and value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'actual Source custody failed')
    for name in ('stdout', 'stderr', 'source_snapshot'):
        exact(value[name])
    need(exact(value['executed_launcher']['archive']).read_bytes() == exact(recorder).read_bytes(), 'recorder Source differs')
    return value


def equal_ref(a, b):
    return a['sha256'] == b['sha256'] and a.get('size_bytes') == b.get('size_bytes') and (ROOT / a['path']).resolve() == (ROOT / b['path']).resolve()


def custody(packet, policy):
    need(packet['schema'] == 'src05-surface-environment-comparison-custody.v1', 'Root literal custody packet required')
    for name in ('Native_input', 'Rust_input'):
        actual, source = exact(packet[name]), exact(policy['literal_input_source'])
        need(actual.read_bytes() == source.read_bytes(), 'full literal request bytes differ')
    native_prep, rust_prep = load(policy['Native_source_preparation']), load(policy['Rust_source_preparation'])
    n = receipt(packet['Native_execution'], policy['recorder_source'], (0, 2))
    r = receipt(packet['Rust_execution'], policy['recorder_source'])
    outer = receipt(packet['Rust_launch_execution'], policy['recorder_source'])
    build = receipt(packet['Native_build_execution'], policy['recorder_source'])
    frozen = load(packet['Native_frozen_build_inputs'])
    need(frozen['schema'] == 'src05-direct-setters-frozen-build-inputs.v1' and equal_ref(frozen['reviewed_Source_preparation'], policy['Native_source_preparation']), 'actual Native Source freeze differs')
    expected = native_prep['Native_source_files'] + [native_prep['input_only_request'], native_prep['prospective_policy']]
    need(len(frozen['frozen_Source_and_input']) == len(expected), 'full Native Source/input freeze required')
    for actual, held in zip(frozen['frozen_Source_and_input'], expected):
        need(exact(actual).read_bytes() == exact(held).read_bytes(), 'frozen actual Native source/input differs')
    need(build['finished_utc'] <= n['started_utc'] and 'src05_surface_environment_helper' in build['command'], 'actual build/capture chronology differs')
    native_binary = exact(packet['Native_binary'], True)
    need(len(n['command']) == 2 and Path(n['command'][0]).resolve() == native_binary and Path(n['command'][1]).resolve() == exact(packet['Native_input']), 'Native argc2/literal input command differs')
    need(exact(n['stdout']) == exact(packet['Native_result']), 'Native result must be complete actual stdout')
    proof = load(packet['Native_execution_build_inputs'])
    need(proof['schema'] == 'src05-direct-setters-actual-link-inputs.v1' and equal_ref(proof['reviewed_Source_preparation'], policy['Native_source_preparation']), 'actual Native link Source proof differs')
    need(proof['frozen_Source_and_input'] == frozen['frozen_Source_and_input'], 'actual linked/frozen full Source/input inventory differs')
    need(equal_ref(proof['actual_Native_binary'], packet['Native_binary']) and equal_ref(proof['actual_link_command'], packet['Native_build_execution']), 'actual link/binary receipt join differs')
    exact(proof['actual_Native_binary'], True)
    exact(proof['actual_full_link_map'], True)
    provider_lines = exact(proof['selected_link_provider_lines']).read_text(encoding='utf-8')
    need(all(name in provider_lines for name in native_prep['core_address_bound_providers_required']), 'actual selected provider inventory incomplete')
    core_check = receipt(proof['official_Source_and_core_check'], policy['recorder_source'])
    need(core_check['finished_utc'] <= n['started_utc'], 'official Source/core check must precede Native capture')
    need(proof['Original_Source_or_core_math_modified'] is False and packet['Root_FULL_address_bound_provider_and_PE_review_accepted'] is True, 'Root genuine provider/core/PE review required')
    command = ['cargo', 'test'] + CONFIGS + ['--locked', '-p', 'ep_runtime', '--lib', FILTER, '--', '--exact', '--ignored']
    need(r['command'] == command, 'actual ignored-test Cargo command differs')
    launch = exact(packet['Rust_launch_source'])
    need(outer['command'][1:] == ['-X', 'utf8', '-B', str(launch), str(exact(packet['Rust_input'])), str(exact(packet['Rust_result']))], 'Root env launcher/input/output command differs')
    need(outer['started_utc'] <= r['started_utc'] <= r['finished_utc'] <= outer['finished_utc'] and outer['source_snapshot'] == r['source_snapshot'], 'Cargo outside actual launcher/Source capture')
    sidecar = load(packet['Rust_execution_sidecar'])
    need(sidecar['schema'] == 'src05-selected-surface-environment-execution-input-custody.v1', 'actual input/environment sidecar required')
    need(sidecar['actual_launcher_source'] == packet['Rust_launch_source'] and sidecar['actual_Cargo_execution'] == packet['Rust_execution'], 'actual launcher/Cargo sidecar join differs')
    need(sidecar['actual_environment_operands'] == {'SRC05_REFERENCE_INPUT': str(exact(packet['Rust_input'])), 'SRC05_REFERENCE_OUTPUT': str(exact(packet['Rust_result']))}, 'actual literal environment differs')
    need(sidecar['input_bytes_match_before_after'] is True and sidecar['actual_Cargo_exit_code'] == 0, 'actual env-input/Cargo outcome differs')
    for name in ('actual_input_before', 'actual_input_after'):
        need(exact(sidecar[name]).read_bytes() == exact(packet['Rust_input']).read_bytes(), 'actual full input before/after differs')
    need(exact(sidecar['actual_output']) == exact(packet['Rust_result']), 'actual output sidecar differs')
    snap = load(r['source_snapshot'])
    need(snap['schema'] == 'rust-command-source-snapshot.v1' and snap['bytes_normalized'] is False, 'literal full Cargo Source snapshot required')
    members = {row['historical_path']: row for row in snap['files']}
    need(len(members) == len(snap['files']), 'duplicate Source member')
    for row in snap['files']:
        need(exact(row['archive']).stat().st_size == row['size_bytes'], 'full Source archive size differs')
    need([row['canonical_path'] for row in packet['actual_Rust_observer_sources']] == rust_prep['selected_observer_source_paths'], 'selected observer Source membership differs')
    for row, held in zip(packet['actual_Rust_observer_sources'], rust_prep['selected_observer_sources']):
        need(exact(row['actual_final_source']).read_bytes() == exact(members[row['canonical_path']]['archive']).read_bytes(), 'compiled observer Source differs')
        before, after = exact(row['actual_literal_source']).read_bytes(), exact(row['actual_final_source']).read_bytes()
        need(before == exact(held).read_bytes(), 'installed literal observer is not reviewed proposal')
        delta = exact(row['formatter_correspondence_diff']).read_text(encoding='utf-8')
        labels = delta.splitlines()
        need((not delta and before == after) or (len(labels) >= 2 and delta == ''.join(difflib.unified_diff(before.decode('utf-8').splitlines(True), after.decode('utf-8').splitlines(True), fromfile=labels[0][4:], tofile=labels[1][4:]))), 'actual literal/final formatter correspondence differs')
    need(packet['Root_and_other_author_FULL_formatter_correspondence_accepted'] is True and packet['Root_reviewed_literal_environment_launcher'] is True, 'Root Source/formatter reviews required')
    need(set(packet['quality_executions']) == {'fmt_check', 'clippy', 'focused', 'workspace'}, 'four actual quality roles required')
    for row in packet['quality_executions'].values():
        q = receipt(row, policy['recorder_source'])
        need(q['source_snapshot'] == r['source_snapshot'] and q['finished_utc'] <= r['started_utc'], 'quality and actual observer Source/chronology differ')
    return n, r


def array_rows(owner, count):
    need(type(owner['allocated']) is bool and owner['size'] == count and owner['values_available'] is True and len(owner['rows']) == count, 'full actual array allocation/rows missing')
    if owner['allocated']:
        need(type(owner['lower']) is int and type(owner['upper']) is int and owner['lower'] == 1 and owner['upper'] == count, 'actual one-based array bounds differ')
    else:
        need(count == 0 and owner['lower'] is None and owner['upper'] is None, 'unallocated nonempty array unavailable')
    need([v['actual_array_index'] for v in owner['rows']] == list(range(1, count + 1)), 'array order differs')
    return [v['value'] for v in owner['rows']]


def selected(snapshot, spec, native):
    count = len(spec['initial']['surfaces'])
    owner = snapshot['owner']
    if native:
        need(owner['TotSurfaces'] == count and owner['Surface']['size'] == count and len(owner['Surface']['rows']) == count and type(owner['Surface']['allocated']) is bool, 'full Surface owner unavailable')
        arrays = {name: array_rows(owner[name], count) for name in ARRAYS}
        rows = [{**r, **{name: arrays[name][i] for name in ARRAYS}} for i, r in enumerate(owner['Surface']['rows'])]
        params, weather = {name: owner['environment'][name] for name in PARAMS}, {name: owner['environment'][name] for name in WEATHER}
        need(snapshot['callback_integrity_failed'] is False and snapshot['actual_callback_count'] == len(snapshot['callbacks']), 'full callback integrity failed')
        need([v['actual_ordinal'] for v in snapshot['callbacks']] == list(range(1, len(snapshot['callbacks']) + 1)), 'callback order omitted')
    else:
        need(owner['actual_Rust_Vec_len'] == count and type(owner['actual_Rust_Vec_capacity']) is int and owner['actual_Rust_Vec_capacity'] >= count and len(owner['rows']) == count, 'full Rust row owner unavailable')
        rows, params, weather = owner['rows'], owner['parameters'], owner['weather']
        need(snapshot['unavailable_counted_as_PASS'] is False, 'unavailable owner counted as PASS')
        need(snapshot['unavailable_Native_owner_families'] == ['cold_check_and_backend', 'constructor_weather_before_literal_write', 'EPVector_and_Objexx_allocation_implementation'], 'full explicit unavailable owner ledger differs')
    need(set(params) == set(PARAMS) and (weather is None or set(weather) == set(WEATHER)), 'complete parameters/weather required')
    result = []
    for i, (row, declared) in enumerate(zip(rows, spec['initial']['surfaces'])):
        need(row['actual_surface_index' if native else 'actual_input_surface_index'] == declared['actual_surface_index'] == i + 1 and row['Name'] == declared['Name'], 'actual input identity/order differs')
        if not native:
            need(row['Rust_row_index'] == i, 'actual Rust row order differs')
        need(type(row['ExtWind']) is bool, 'actual exposure bool required')
        result.append({name: scalar(row[name]) if name != 'ExtWind' else row[name] for name in ['Centroid_z', 'ExtWind'] + ARRAYS})
    return {'parameters': {name: scalar(v) for name, v in params.items()}, 'weather': None if weather is None else {name: scalar(v) for name, v in weather.items()}, 'rows': result}


def pair(a, b, path, phase):
    same(a['parameters'], b['parameters'], path + '/parameters', phase)
    if b['weather'] is not None:
        same(a['weather'], b['weather'], path + '/weather', phase)
    need(len(a['rows']) == len(b['rows']), 'selected cardinality differs')
    for i, (left, right) in enumerate(zip(a['rows'], b['rows']), 1):
        for name in left:
            same(left[name], right[name], f'{path}/surface{i}/{name}', phase)


def arithmetic_cell(stage, owner, index, name):
    # Source branch classification only; no endpoint equation or expected value.
    zero = ('0000000000000000', '8000000000000000')
    if stage == 'bulbs' and name in ARRAYS[:2]:
        return owner['parameters']['SiteTempGradient'][0] not in zero
    if stage == 'wind_speed' and name == ARRAYS[2]:
        return (owner['parameters']['SiteWindExp'][0] not in zero and owner['rows'][index]['ExtWind']
                and struct.unpack('>d', bytes.fromhex(owner['rows'][index]['Centroid_z'][0]))[0] > 0.0)
    return False


def endpoint_scalar(left, right, path, phase, arithmetic):
    if arithmetic and (left[1] not in ('finite', 'positive_zero', 'negative_zero') or right[1] not in ('finite', 'positive_zero', 'negative_zero')):
        ARITHMETIC_UNAVAILABLE.append(path)
        unavailable(path, 'nonfinite-arithmetic-endpoint; no-numerical-PASS', {'Native': left, 'Rust': right})
        return
    same(left, right, path, phase)


def endpoint(a, b, path, stage):
    same(a['parameters'], b['parameters'], path + '/parameters', 'selected_endpoint_comparisons')
    same(a['weather'], b['weather'], path + '/weather', 'selected_endpoint_comparisons')
    for i, (left, right) in enumerate(zip(a['rows'], b['rows'])):
        for name in left:
            field = f'{path}/surface{i+1}/{name}'
            if name == 'ExtWind':
                same(left[name], right[name], field, 'selected_endpoint_comparisons')
            else:
                endpoint_scalar(left[name], right[name], field, 'selected_endpoint_comparisons', arithmetic_cell(stage, a, i, name))


def compare(packet, policy):
    nreceipt, rreceipt = custody(packet, policy)
    source, native, rust = load(packet['Native_input']), load(packet['Native_result']), load(packet['Rust_result'])
    need(native['schema'] == 'src05-surface-environment-direct-results.v1' and rust['schema'] == 'src05-surface-environment-selected-results.v1', 'result schema differs')
    count = len(source['cases'])
    need(native['requested_case_count'] == native['recorded_case_count'] == count == len(native['cases']) == len(rust['cases']) == policy['literal_case_count'], 'all literal cases required')
    for result, names in [(native, ['expected_values_supplied', 'Original_bodies_modified', 'scientific_PASS_claimed', 'gates_updated']), (rust, ['full_input_SHA_verified_internally', 'Native_results_or_expected_values_read', 'cold_check_backend_or_ordinary_manager_PASS_claimed', 'scientific_PASS_claimed', 'gates_updated'])]:
        need(all(result[name] is False for name in names), 'result scope declaration differs')
    need(rust['external_full_input_SHA_and_Source_capture_before_after_required'] is True and rust['all_declared_operations_retained'] is True and Path(rust['actual_input_path']).resolve() == exact(packet['Rust_input']) and rust['actual_input_size_bytes'] == exact(packet['Rust_input']).stat().st_size, 'full Rust input custody differs')
    endpoints, any_stopped, operations = [], False, 0
    for spec, ncase, rcase in zip(source['cases'], native['cases'], rust['cases']):
        key = spec['case_id']
        need(ncase['case_id'] == rcase['case_id'] == key and ncase['literal_input'] == rcase['literal_input'] == spec, 'full literal case witness/order differs')
        need(ncase['numerical_PASS_claimed'] is False and rcase['numerical_PASS_claimed'] is False and ncase['ordinary_production_handoff_verified'] is False and rcase['ordinary_production_handoff_verified'] is False and rcase['cold_check_or_backend_invoked'] is False, 'case scope differs')
        calls = ncase['actual_calls']
        need(ncase['actual_source_call_count'] == len(calls) and len(calls) >= 2 and [c['actual_call_ordinal'] for c in calls] == list(range(1, len(calls) + 1)), 'full Native call ledger required')
        for call, identity in zip(calls[:2], [('prepare-site-defaults', 'HeatBalanceManager::GetSiteAtmosphereData'), ('prepare-station-defaults', 'Weather::GetWeatherStation')]):
            need((call['operation_id'], call['api']) == identity and call['actual_source_invoked'] is True and call['actual_source_return_observed'] is True and call['source_exception'] is None, 'real default producer unavailable')
            selected(call['before'], spec, True); selected(call['after'], spec, True)
        need(calls[0]['after'] == calls[1]['before'], 'default producer continuity differs')
        need(rcase['actual_default_station_constructor_invoked'] is True, 'actual Rust default producer missing')
        for name in ['SiteTempGradient', 'WeatherFileTempModCoeff', 'WeatherFileWindModCoeff']:
            same(scalar(calls[1]['after']['owner']['environment'][name]), scalar(rcase['actual_default_station_parameters'][name]), key + '/default-producer/' + name, 'input_join_comparisons')
        a, b = selected(ncase['prepared_state'], spec, True), selected(rcase['prepared_state'], spec, False)
        pair(a, b, key + '/initial', 'input_join_comparisons')
        for i, declared in enumerate(spec['initial']['surfaces']):
            for name in ['Centroid_z'] + ARRAYS:
                same(literal(declared[name]), a['rows'][i][name], f'{key}/literal-initial/surface{i+1}/{name}', 'input_join_comparisons')
            same(declared['ExtWind'], a['rows'][i]['ExtWind'], f'{key}/literal-initial/surface{i+1}/ExtWind', 'input_join_comparisons')
        for name in ['SiteWindExp', 'SiteWindBLHeight']:
            same(literal(spec['initial']['site_parameters'][name]), a['parameters'][name], key + '/literal-initial/' + name, 'input_join_comparisons')
        for name in ['SiteTempGradient', 'WeatherFileTempModCoeff', 'WeatherFileWindModCoeff']:
            override = spec['initial']['site_parameters'][name + '_override']
            required = scalar(calls[1]['after']['owner']['environment'][name]) if override is None else literal(override)
            same(required, a['parameters'][name], key + '/literal-override-or-default/' + name, 'input_join_comparisons')
        for name, value in spec['initial']['backend_flags'].items():
            owner = ncase['prepared_state']['owner']
            actual = owner['backend_flags'][name] if name in owner['backend_flags'] else owner['backend'][name]
            same(value, actual, key + '/literal-backend-flag/' + name, 'input_join_comparisons')
        prior_n, prior_r, cursor, boundary_cursor, stopped = ncase['prepared_state'], rcase['prepared_state'], 2, 0, False
        expected_unreached, rust_ordinal = [], 0
        need(len(rcase['operations']) == len(spec['operations']), 'full Rust operations required')
        for op, rop in zip(spec['operations'], rcase['operations']):
            operations += 1
            path = key + '/' + op['operation_id']
            need(rop['operation_id'] == op['operation_id'] and rop['literal_operation'] == op and rop['independent_setter_probes_not_ordinary_manager'] is True, 'Rust operation identity/input differs')
            need(rop['before_declared_weather_writes'] == prior_r, 'Rust operation continuity differs')
            changed = copy.deepcopy(prior_r)
            changed['owner']['weather'] = rop['after_declared_weather_writes']['owner']['weather']
            need(changed == rop['after_declared_weather_writes'], 'undeclared Rust input write')
            declared_native = not stopped
            if declared_native:
                boundary = ncase['declared_weather_boundaries'][boundary_cursor]; boundary_cursor += 1
                need(boundary['literal_operation'] == op and boundary['before_declared_weather_writes'] == prior_n, 'Native operation/input continuity differs')
                changed = copy.deepcopy(prior_n)
                for name in WEATHER:
                    changed['owner']['environment'][name] = boundary['after_declared_weather_writes']['owner']['environment'][name]
                need(changed == boundary['after_declared_weather_writes'], 'undeclared Native input write')
                prior_n = boundary['after_declared_weather_writes']
            else:
                expected_unreached.append(op)
            prior_r = rop['after_declared_weather_writes']
            need(len(rop['calls']) == 4, 'full Rust stage ledger required')
            for stage, observed in zip(STAGES, rop['calls']):
                invoked = stage != 'check'
                if invoked:
                    rust_ordinal += 1
                need(observed['stage'] == stage and observed['actual_selected_method_invoked'] is invoked and observed['actual_selected_method_return_observed'] is invoked and observed['actual_selected_call_ordinal'] == (rust_ordinal if invoked else None) and observed['before'] == prior_r and observed['counted_as_PASS'] is False, 'actual Rust stage/invocation continuity differs')
                if not invoked:
                    need(observed['before'] == observed['after'], 'unavailable Rust guard changed owners')
                point = observed['actual_point_helper_returns']
                need(len(point) == (len(spec['initial']['surfaces']) if stage in ('bulbs', 'wind_speed') else 0) and all(v['Rust_row_index'] == i for i, v in enumerate(point)), 'full actual point-method rows required')
                point_keys = {'Rust_row_index', 'temperature_at_height_dry', 'temperature_at_height_wet'} if stage == 'bulbs' else {'Rust_row_index', 'wind_speed_at_height'}
                need(all(set(v) == point_keys for v in point), 'complete exact point-method DTO required')
                for v in point:
                    for name in point_keys - {'Rust_row_index'}:
                        scalar(v[name])
                if stopped:
                    if declared_native:
                        expected_unreached.append({'operation_id': op['operation_id'], 'unreached_stage': stage})
                    unavailable(path + '/' + stage, 'Native-stage-unreached; independent-Rust-probe-not-paired')
                else:
                    call = calls[cursor]; cursor += 1
                    need(call['operation_id'] == op['operation_id'] and call['api'] == APIS[stage] and call['actual_source_invoked'] is True and call['before'] == prior_n, 'actual Native stage/API continuity differs')
                    returned = call['actual_source_return_observed']
                    need(type(returned) is bool and ((returned and call['source_exception'] is None) or (not returned and call['source_exception']['kind'] == 'OriginalFatalError')), 'unavailable/nonstandard actual Native source outcome')
                    for name, declared in op['weather'].items():
                        same(literal(declared), scalar(call['before']['owner']['environment'][name]), path + '/literal-weather/' + stage + '/' + name, 'input_join_comparisons')
                        same(literal(declared), scalar(observed['before']['owner']['weather'][name]), path + '/Rust-literal-weather/' + stage + '/' + name, 'input_join_comparisons')
                    if stage == 'check':
                        unavailable(path + '/check', 'Rust-cold-check-and-full-backend-unavailable', {'actual_Native_return_observed': returned, 'source_exception': call['source_exception']})
                    elif returned:
                        endpoints.append((spec, stage, path + '/' + stage, call, observed))
                    else:
                        unavailable(path + '/' + stage, 'actual-Native-setter-did-not-return', call['source_exception'])
                    selected(call['before'], spec, True); selected(call['after'], spec, True)
                    prior_n, stopped = call['after'], not returned
                prior_r = observed['after']
        need(cursor == len(calls) and boundary_cursor == len(ncase['declared_weather_boundaries']) and expected_unreached == ncase['unreached_operations_or_stages'], 'all Native calls/boundaries/unreached ledger required')
        need(prior_n == ncase['final'] and prior_r == rcase['final'] and ncase['actual_source_stopped'] is stopped, 'actual final owner/stop closure differs')
        need(rcase['actual_selected_method_call_count'] == rust_ordinal and rcase['actual_point_helper_call_count'] == 3 * len(spec['initial']['surfaces']) * len(spec['operations']), 'actual Rust method call counts differ')
        any_stopped = any_stopped or stopped
        unavailable(key + '/Native-only-context', 'actual-cold-backend/constructor-weather/allocation-implementation-unpaired')
    need(operations == policy['literal_operation_count'] and nreceipt['exit_code'] == (2 if any_stopped else 0), 'actual process exit disagrees with complete helper source-stop ledger')
    admitted = not MISMATCHES
    for spec, stage, path, call, observed in endpoints:
        if not admitted:
            unavailable(path, 'global-input-or-initial-owner-join-failed; endpoint-not-paired')
            continue
        a, b = selected(call['before'], spec, True), selected(observed['before'], spec, False)
        before_count = len(MISMATCHES)
        pair(a, b, path + '/full-preowner', 'pre_owner_comparisons')
        if len(MISMATCHES) != before_count:
            unavailable(path, 'full-preowner-join-failed; endpoint-not-paired')
            continue
        a, b = selected(call['after'], spec, True), selected(observed['after'], spec, False)
        arithmetic_before = len(ARITHMETIC_UNAVAILABLE)
        endpoint(a, b, path + '/after', stage)
        PAIRS.append({'path': path, 'stage': stage, 'full_preowner_join_passed': True, 'endpoint_compared': True,
                      'arithmetic_nonfinite_unavailable_count': len(ARITHMETIC_UNAVAILABLE) - arithmetic_before, 'whole_unit_PASS_claimed': False})
        for i, point in enumerate(observed['actual_point_helper_returns']):
            names = [('temperature_at_height_dry', 'SurfOutDryBulbTemp'), ('temperature_at_height_wet', 'SurfOutWetBulbTemp')] if stage == 'bulbs' else [('wind_speed_at_height', 'SurfOutWindSpeed')]
            skip = stage == 'wind_speed' and a['parameters']['SiteWindExp'][0] not in ('0000000000000000', '8000000000000000') and not a['rows'][i]['ExtWind']
            if skip:
                unavailable(path + f'/point/surface{i+1}', 'Native-NoWind-row-skipped; independent-point-result-not-paired')
                continue
            for method, field in names:
                endpoint_scalar(a['rows'][i][field], scalar(point[method]), path + f'/point/surface{i+1}/' + method, 'point_helper_comparisons', arithmetic_cell(stage, a, i, field))
    return {'input_and_initial_owner_join_passed': admitted, 'endpoint_pairing_performed': admitted, 'actual_case_count': count,
            'actual_weather_operation_count': operations, 'paired_available_setter_boundaries': len(PAIRS),
            'actual_Native_process_exit_code': nreceipt['exit_code'], 'actual_Native_Source_snapshot': nreceipt['source_snapshot'], 'actual_Cargo_Source_snapshot': rreceipt['source_snapshot']}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--custody', required=True)
    parser.add_argument('--output-dir', required=True)
    args = parser.parse_args()
    name, sha = args.custody.rsplit('#', 1)
    packet_ref = {'path': name, 'sha256': sha}
    packet, policy_ref = load(packet_ref), ref(HERE / 'policy.json')
    policy = load(policy_ref)
    need(equal_ref(packet['prospective_policy'], policy_ref), 'fixed prospective policy differs')
    output = (ROOT / args.output_dir).resolve()
    need(output.is_relative_to(ROOT / '.runtime/porting/SRC-05') and not output.exists(), 'fresh ignored SRC05 output required')
    output.mkdir(parents=True, exist_ok=False)
    try:
        findings = compare(packet, policy)
        status = 'pass-available-selected-setters-only' if findings['input_and_initial_owner_join_passed'] and not MISMATCHES and not ARITHMETIC_UNAVAILABLE else 'fail-selected-setters-or-input-join'
        code = 0 if status == 'pass-available-selected-setters-only' else 1
    except (KeyError, TypeError, ValueError, IndexError, OSError) as error:
        findings, status, code = {'integrity_failure': str(error), 'endpoint_pairing_performed': False}, 'fail-observation-or-custody-integrity', 2
    for path, sha in SEEN.items():
        need(digest(path) == sha, 'authenticated artifact changed during comparison')
    ledgers = {}
    for name, rows in [('mismatches', MISMATCHES), ('unavailable', UNAVAILABLE), ('paired-boundaries', PAIRS)]:
        path = output / (name + '.ndjson')
        with path.open('x', encoding='utf-8', newline='\n') as stream:
            for row in rows:
                stream.write(json.dumps(row, allow_nan=False) + '\n')
        ledgers[name] = ref(path)
    report = {'schema': 'src05-selected-surface-environment-comparison.v1', 'status': status, 'actual_custody': packet_ref,
        'actual_prospective_policy': policy_ref, 'findings': findings, 'counts': COUNTS, 'mismatch_count': len(MISMATCHES),
        'required_unavailable_count': len(UNAVAILABLE), 'nonfinite_arithmetic_unavailable_count': len(ARITHMETIC_UNAVAILABLE), 'all_mismatches_and_unavailable_rows_retained_uncapped': True, 'ledgers': ledgers,
        'cold_guard_backend_PASS_claimed': False, 'whole_SRC05_unit_or_ordinary_manager_PASS_claimed': False, 'gates_updated': False}
    with (output / 'comparison.json').open('x', encoding='utf-8', newline='\n') as stream:
        json.dump(report, stream, indent=2, allow_nan=False); stream.write('\n')
    print(json.dumps({'comparison': ref(output / 'comparison.json'), 'status': status, 'exit_code': code}))
    return code


if __name__ == '__main__':
    sys.exit(main())

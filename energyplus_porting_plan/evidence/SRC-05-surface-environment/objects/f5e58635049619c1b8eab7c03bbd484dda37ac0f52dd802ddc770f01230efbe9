# Append one genuine public-API helper; keep the entire prior recipe/target graph.
if(NOT DEFINED SRC05_SOURCE_DIR OR NOT DEFINED SRC05_INHERITED_RECIPE)
  message(FATAL_ERROR "SRC05 requires explicit reviewed Source directory and authentic prior recipe")
endif()
include("${SRC05_INHERITED_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_src05_scheduled GLOBAL PROPERTY SRC05_REFERENCE_SCHEDULED)
  if(NOT _src05_scheduled)
    set_property(GLOBAL PROPERTY SRC05_REFERENCE_SCHEDULED TRUE)
    function(src05_add_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "SRC05 requires unchanged Original energypluslib")
      endif()
      get_target_property(_src05_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_src05_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      list(APPEND _src05_defs ${_src05_directory_defs})
      list(FILTER _src05_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _src05_defs)
      add_executable(src05_surface_environment_helper "${SRC05_SOURCE_DIR}/surface_environment_reference_helper.cpp")
      target_include_directories(src05_surface_environment_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${SRC05_SOURCE_DIR}")
      target_compile_definitions(src05_surface_environment_helper PRIVATE ${_src05_defs})
      target_link_libraries(src05_surface_environment_helper PRIVATE energypluslib project_options project_fp_options project_warnings)
      target_compile_features(src05_surface_environment_helper PRIVATE cxx_std_20)
      target_link_options(src05_surface_environment_helper PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/src05_surface_environment_helper.map")
    endfunction()
    cmake_language(DEFER CALL src05_add_reference)
  endif()
endif()

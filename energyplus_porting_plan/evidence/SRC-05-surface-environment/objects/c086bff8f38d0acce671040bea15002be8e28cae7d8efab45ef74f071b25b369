"""Apply reviewed SRC05 rows after genuine Native baseline capture, retaining fmt custody."""
import argparse
import difflib
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
spec = importlib.util.spec_from_file_location('recorder', ROOT / 'tools/porting/record_command.py')
rec = importlib.util.module_from_spec(spec)
spec.loader.exec_module(rec)
OUT = ROOT / '.runtime/porting/SRC-05/surface-environment-applied-01'


def checked(ref):
    path = (ROOT / ref['path']).resolve()
    assert path.is_relative_to(ROOT)
    data = path.read_bytes()
    assert rec.sha(path) == ref['sha256'], ref['path']
    assert 'size_bytes' not in ref or len(data) == ref['size_bytes']
    return data


def rows(ref):
    return {r['historical_path']: r['archive']['sha256'] for r in json.loads(checked(ref))['files']}


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--preparation', required=True)
args = parser.parse_args()
name, sha = args.preparation.rsplit('#', 1)
prep_ref = {'path': name, 'sha256': sha}
prep = json.loads(checked(prep_ref))
assert sha == '05dad8308583e1c441c1ff8c59bb4253b2b61906935fa4ef37b2ad7d848d4722'
application = prep['application']
assert len(application) == 5 and not OUT.exists()
assert {r['canonical_path'] for r in application} == {
    'crates/ep_runtime/src/heat_balance/convection.rs',
    'crates/ep_runtime/src/heat_balance/convection/surface_environment.rs',
    'crates/ep_runtime/src/heat_balance/convection/surface_environment_selected_reference.rs',
    'crates/ep_runtime/src/runtime/tests/part03.rs',
    'energyplus_porting_plan/cards/SRC-05.md'}
baseline_ref = {'path': '.runtime/porting/SRC-05/selected-observation-01/Root-full-baseline-review.json',
                'sha256': '630ed63a0af0a6607a3f5fa1e593c88c93ff98182d63dda23afb8914387955df'}
baseline = json.loads(checked(baseline_ref))
assert baseline['baseline_before_canonical_Rust_math_application'] is True
assert baseline['whole_source_call_and_input_continuity_verified'] is True
assert baseline['full_counts']['genuine_cold_stops'] == 8 and baseline['Native_actual_exit_code'] == 2
checked(baseline['Native_execution'])
checked(baseline['Native_result'])
for row in application:
    if row.get('new_destination_absent'):
        assert not (ROOT / row['canonical_path']).exists()
    else:
        assert checked(row['actual_before']) == checked(row['before_archive'])
    checked(row['proposal'])
    checked(row['exact_diff'])
before = rec.source_snapshot()
assert before['sha256'] == '5f982aba87e32de31a541c3cef83fd6a6d2e2fcd12efe1276b6ed2b694d0c899'
OUT.mkdir()
card_row = next(r for r in application if r['canonical_path'].endswith('SRC-05.md'))
card = ROOT / card_row['canonical_path']
card.write_bytes(checked(card_row['proposal']))
card_ref = rec.store_bytes(card.read_bytes())
for row in application:
    if row is not card_row:
        path = ROOT / row['canonical_path']
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(checked(row['proposal']))
literal = rec.source_snapshot()
fmt_dir = '.runtime/porting/SRC-05/surface-environment-format-command-01'
assert subprocess.run([sys.executable, '-X', 'utf8', '-B', 'tools/porting/record_command.py', '--output-dir', fmt_dir, '--', 'cargo', 'fmt', '--all'], cwd=ROOT).returncode == 0
final = rec.source_snapshot()
fmt_ref = rec.ref(ROOT / fmt_dir / 'receipt.json')
assert json.loads(checked(fmt_ref))['source_snapshot'] == literal
before_rows, final_rows = rows(before), rows(final)
changed = {r['canonical_path'] for r in application if r['canonical_path'].endswith('.rs')}
assert final_rows.keys() == before_rows.keys() | {r['canonical_path'] for r in application if r.get('new_destination_absent')}
assert all(before_rows[p] == final_rows[p] for p in before_rows.keys() - changed)
applied = []
for index, row in enumerate(application):
    path = ROOT / row['canonical_path']
    data = path.read_bytes()
    delta = ''.join(difflib.unified_diff(checked(row['proposal']).decode('utf8').splitlines(keepends=True), data.decode('utf8').splitlines(keepends=True), fromfile=row['proposal']['path'], tofile=row['canonical_path'])).encode('utf8')
    diffpath = OUT / f'formatter-{index + 1}.diff'
    diffpath.write_bytes(delta)
    applied.append({**row, 'actual_final': {**rec.ref(path), 'size_bytes': len(data)}, 'actual_formatter_diff': {**rec.ref(diffpath), 'size_bytes': len(delta)}, 'actual_final_archive': rec.store_bytes(data)})
record = {'schema': 'src05-surface-environment-actual-application.v1', 'source_preparation': prep_ref, 'genuine_Native_baseline_before_application': baseline_ref, 'card_contract_before_implementation': card_ref, 'source_before': before, 'source_literal': literal, 'source_final': final, 'source_file_count': len(final_rows), 'unrelated_source_files_verified_byte_exact': len(before_rows.keys() - changed), 'actual_format_receipt': fmt_ref, 'application': applied, 'numerical_comparison_performed': False, 'gates_updated': False}
record_path = OUT / 'record.json'
record_path.write_bytes(rec.json_bytes(record))
print(json.dumps({'record': rec.ref(record_path), 'final_source': final, 'unrelated_files': record['unrelated_source_files_verified_byte_exact']}))

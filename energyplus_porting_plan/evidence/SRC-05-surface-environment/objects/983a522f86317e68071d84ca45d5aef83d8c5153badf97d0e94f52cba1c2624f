+// Input-only direct calls to unchanged linked Original DataSurfaces APIs.
+#include "surface_environment_reference_fields.hh"
+#include <fstream>
+#include <initializer_list>
+#include <iostream>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <set>
+#include <stdexcept>

+namespace {
+using Src05::json;
+void require(bool ok, std::string const &message)
+{
+    if (!ok) {
+        throw std::runtime_error(message);
+    }
+}
+void keys(json const &v, std::initializer_list<char const *> names)
+{
+    require(v.is_object() && v.size() == names.size(), "Exact input object shape required");
+    for (char const *name : names) {
+        require(v.contains(name), std::string("Missing input field: ") + name);
+    }
+}
+double input(json const &v, bool retained_nan_allowed = false)
+{
+    keys(v, {"bits"});
+    require(v.at("bits").is_string(), "Literal binary64 input bits required");
+    auto const token = v.at("bits").get<std::string>();
+    require(token.size() == 16 && token.find_first_not_of("0123456789abcdef") == std::string::npos, "Canonical16-hex input required");
+    auto const number = std::bit_cast<double>(static_cast<std::uint64_t>(std::stoull(token, nullptr, 16)));
+    require(std::isfinite(number) || (retained_nan_allowed && std::isnan(number)), "Finite active scalar or declared skipped NaN owner required");
+    return number;
+}
+bool boolean(json const &v)
+{
+    require(v.is_boolean(), "Literal boolean input required");
+    return v.get<bool>();
+}
+struct ConsoleCapture {
+    std::ostringstream text;
+    std::streambuf *previous = nullptr;
+    ConsoleCapture() : previous(std::cout.rdbuf(text.rdbuf())) {}
+    ~ConsoleCapture() { std::cout.rdbuf(previous); }
+    ConsoleCapture(ConsoleCapture const &) = delete;
+    ConsoleCapture &operator=(ConsoleCapture const &) = delete;
+};
+struct Fixture {
+    ConsoleCapture console_capture;
+    std::unique_ptr<EnergyPlus::EnergyPlusData> state;
+    std::ostringstream *error = nullptr;
+    json callbacks = json::array(), calls = json::array();
+    std::size_t callback_count = 0, actual_calls = 0;
+    bool callback_integrity_failed = false, stopped = false, errors_found = false;
+    Fixture() : state(std::make_unique<EnergyPlus::EnergyPlusData>())
+    {
+        auto sink = std::make_unique<std::ostringstream>();
+        error = sink.get();
+        state->files.err_stream = std::move(sink);
+        state->files.eio.open_as_stringstream();
+        state->dataGlobal->errorCallback = [this](EnergyPlus::Error level, std::string const &text) noexcept {
+            callback("errorCallback", static_cast<int>(level), text);
+        };
+        state->dataGlobal->messageCallback = [this](std::string const &text) noexcept {
+            callback("messageCallback", std::nullopt, text);
+        };
+        state->init_constant_state(*state);
+    }
+    Fixture(Fixture const &) = delete;
+    Fixture &operator=(Fixture const &) = delete;
+    void callback(char const *kind, std::optional<int> level, std::string const &text) noexcept
+    {
+        if (callback_count == std::numeric_limits<std::size_t>::max()) {
+            callback_integrity_failed = true;
+            return;
+        }
+        ++callback_count;
+        try {
+            callbacks.push_back({{"actual_ordinal", callback_count}, {"kind", kind},
+                                 {"level", level ? json(*level) : json(nullptr)}, {"message", text}});
+        } catch (...) {
+            callback_integrity_failed = true;
+        }
+    }
+    json snapshot()
+    {
+        return {{"owner", Src05::owners(*state)}, {"ErrorsFound", errors_found},
+                {"error_stream", error->str()}, {"eio", state->files.eio.get_output()}, {"console", console_capture.text.str()},
+                {"callbacks", callbacks}, {"actual_callback_count", callback_count}, {"callback_integrity_failed", callback_integrity_failed}};
+    }
+    template<class Call> void invoke(std::string const &id, char const *api, Call const &call)
+    {
+        auto const before = snapshot();
+        bool returned = false;
+        json exception = nullptr;
+        ++actual_calls;
+        try {
+            call();
+            returned = true;
+        } catch (EnergyPlus::FatalError const &e) {
+            exception = {{"kind", "OriginalFatalError"}, {"message", e.what()}};
+        } catch (std::exception const &e) {
+            exception = {{"kind", "std_exception"}, {"message", e.what()}};
+        } catch (...) {
+            exception = {{"kind", "nonstandard_exception"}, {"message", nullptr}};
+        }
+        stopped = !returned;
+        calls.push_back({{"operation_id", id}, {"actual_call_ordinal", actual_calls}, {"api", api},
+                         {"actual_source_invoked", true}, {"actual_source_return_observed", returned},
+                         {"source_exception", exception}, {"before", before}, {"after", snapshot()}});
+    }
+};
+void prepare(Fixture &f, json const &v)
+{
+    keys(v, {"site_parameters", "backend_flags", "surfaces"});
+    auto &s = *f.state;
+    auto const &p = v.at("site_parameters");
+    keys(p, {"Terrain_source_label", "SiteWindExp", "SiteWindBLHeight", "SiteTempGradient_override",
+             "WeatherFileTempModCoeff_override", "WeatherFileWindModCoeff_override"});
+    require(p.at("Terrain_source_label").is_string(), "Declared terrain/source input label required");
+    s.dataEnvrn->SiteWindExp = input(p.at("SiteWindExp"));
+    s.dataEnvrn->SiteWindBLHeight = input(p.at("SiteWindBLHeight"));
+    require(s.dataEnvrn->SiteWindExp >= 0.0 && s.dataEnvrn->SiteWindBLHeight > 0.0, "Nonnegative exponent and positive boundary layer required");
+    auto const &b = v.at("backend_flags");
+    keys(b, {"WarmupFlag", "DoingSizing", "KickOffSimulation", "DoingInputProcessing", "printConsoleOutput"});
+    s.dataGlobal->WarmupFlag = boolean(b.at("WarmupFlag"));
+    s.dataGlobal->DoingSizing = boolean(b.at("DoingSizing"));
+    s.dataGlobal->KickOffSimulation = boolean(b.at("KickOffSimulation"));
+    s.dataGlobal->DoingInputProcessing = boolean(b.at("DoingInputProcessing"));
+    s.dataGlobal->printConsoleOutput = boolean(b.at("printConsoleOutput"));
+    auto const &rows = v.at("surfaces");
+    require(rows.is_array() && rows.size() <= static_cast<std::size_t>(std::numeric_limits<int>::max()), "Full source-sized surface input required");
+    auto &d = *s.dataSurface;
+    d.TotSurfaces = static_cast<int>(rows.size());
+    d.Surface.allocate(rows.size());
+    d.SurfOutDryBulbTemp.allocate(d.TotSurfaces); d.SurfOutWetBulbTemp.allocate(d.TotSurfaces);
+    d.SurfOutWindSpeed.allocate(d.TotSurfaces); d.SurfOutWindDir.allocate(d.TotSurfaces);
+    std::set<std::string> names;
+    for (int i = 1; i <= d.TotSurfaces; ++i) {
+        auto const &r = rows.at(static_cast<std::size_t>(i - 1));
+        keys(r, {"actual_surface_index", "Name", "Centroid_z", "ExtWind", "SurfOutDryBulbTemp", "SurfOutWetBulbTemp", "SurfOutWindSpeed", "SurfOutWindDir"});
+        require(r.at("actual_surface_index").is_number_integer() && r.at("actual_surface_index").get<std::int64_t>() == i,
+                "Actual contiguous Source index/order required");
+        require(r.at("Name").is_string() && !r.at("Name").get<std::string>().empty() && names.insert(r.at("Name").get<std::string>()).second,
+                "Unique actual surface names required");
+        auto &surface = d.Surface(i);
+        surface.Name = r.at("Name").get<std::string>(); surface.Centroid.z = input(r.at("Centroid_z")); surface.ExtWind = boolean(r.at("ExtWind"));
+        d.SurfOutDryBulbTemp(i) = input(r.at("SurfOutDryBulbTemp")); d.SurfOutWetBulbTemp(i) = input(r.at("SurfOutWetBulbTemp"));
+        d.SurfOutWindSpeed(i) = input(r.at("SurfOutWindSpeed"), !surface.ExtWind && s.dataEnvrn->SiteWindExp != 0.0);
+        d.SurfOutWindDir(i) = input(r.at("SurfOutWindDir"));
+    }
+    auto &ip = *s.dataInputProcessing->inputProcessor;
+    require(ip.epJSON.empty() && s.dataSQLiteProcedures->sqlite == nullptr && s.dataGlobal->fMessagePtr == nullptr,
+            "Fresh empty getter-domain/absent optional backend owner required");
+    f.invoke("prepare-site-defaults", "HeatBalanceManager::GetSiteAtmosphereData", [&] { EnergyPlus::HeatBalanceManager::GetSiteAtmosphereData(s, f.errors_found); });
+    if (!f.stopped) {
+        f.invoke("prepare-station-defaults", "WeatherManager::GetWeatherStation", [&] { EnergyPlus::WeatherManager::GetWeatherStation(s, f.errors_found); });
+    }
+    require(!f.stopped && !f.errors_found, "Actual absent-object default producers must return before direct setters");
+    for (auto const &name : {"SiteTempGradient_override", "WeatherFileTempModCoeff_override", "WeatherFileWindModCoeff_override"}) {
+        if (!p.at(name).is_null()) {
+            double const value = input(p.at(name));
+            if (std::string(name) == "SiteTempGradient_override") { s.dataEnvrn->SiteTempGradient = value; }
+            if (std::string(name) == "WeatherFileTempModCoeff_override") { s.dataEnvrn->WeatherFileTempModCoeff = value; }
+            if (std::string(name) == "WeatherFileWindModCoeff_override") { s.dataEnvrn->WeatherFileWindModCoeff = value; }
+        }
+    }
+}
+json evaluate(json const &item, bool &any_failure)
+{
+    keys(item, {"case_id", "purpose", "admission_lane", "initial", "operations"});
+    require(item.at("case_id").is_string() && item.at("purpose").is_string(), "Case identity and Source purpose required");
+    require(item.at("admission_lane") == "fixed-default-state-direct" || item.at("admission_lane") == "diagnostic-direct-operands",
+            "Explicit direct-unit admission required; no ordinary simulation claim");
+    Fixture f;
+    auto const fresh = f.snapshot();
+    prepare(f, item.at("initial"));
+    auto const prepared = f.snapshot();
+    require(item.at("operations").is_array() && !item.at("operations").empty(), "Full ordered operations required");
+    json boundaries = json::array(), unreached = json::array();
+    std::set<std::string> ids;
+    for (auto const &op : item.at("operations")) {
+        keys(op, {"operation_id", "weather", "sequence"});
+        require(op.at("operation_id").is_string() && ids.insert(op.at("operation_id").get<std::string>()).second, "Unique operation ID required");
+        auto const &sequence = op.at("sequence");
+        require(sequence == json::array({"bulbs", "check", "wind_speed", "wind_direction"}), "Exact manager setter/check sequence required");
+        if (f.stopped) { unreached.push_back(op); continue; }
+        auto const &w = op.at("weather"); keys(w, {"OutDryBulbTemp", "OutWetBulbTemp", "WindSpeed", "WindDir"});
+        auto const before = f.snapshot(); auto &s = *f.state;
+        s.dataEnvrn->OutDryBulbTemp = input(w.at("OutDryBulbTemp")); s.dataEnvrn->OutWetBulbTemp = input(w.at("OutWetBulbTemp"));
+        s.dataEnvrn->WindSpeed = input(w.at("WindSpeed")); s.dataEnvrn->WindDir = input(w.at("WindDir"));
+        boundaries.push_back({{"literal_operation", op}, {"before_declared_weather_writes", before}, {"after_declared_weather_writes", f.snapshot()}});
+        auto const id = op.at("operation_id").get<std::string>();
+        for (auto const &entry : sequence) {
+            if (f.stopped) { unreached.push_back({{"operation_id", id}, {"unreached_stage", entry}}); continue; }
+            auto const stage = entry.get<std::string>();
+            if (stage == "bulbs") { f.invoke(id, "DataSurfaces::SetSurfaceOutBulbTempAt", [&] { EnergyPlus::DataSurfaces::SetSurfaceOutBulbTempAt(s); }); }
+            if (stage == "check") { f.invoke(id, "DataSurfaces::CheckSurfaceOutBulbTempAt", [&] { EnergyPlus::DataSurfaces::CheckSurfaceOutBulbTempAt(s); }); }
+            if (stage == "wind_speed") { f.invoke(id, "DataSurfaces::SetSurfaceWindSpeedAt", [&] { EnergyPlus::DataSurfaces::SetSurfaceWindSpeedAt(s); }); }
+            if (stage == "wind_direction") { f.invoke(id, "DataSurfaces::SetSurfaceWindDirAt", [&] { EnergyPlus::DataSurfaces::SetSurfaceWindDirAt(s); }); }
+        }
+    }
+    any_failure = any_failure || f.stopped || f.callback_integrity_failed;
+    return {{"case_id", item.at("case_id")}, {"literal_input", item}, {"fresh_constructor_state", fresh}, {"prepared_state", prepared},
+            {"declared_weather_boundaries", boundaries}, {"actual_calls", f.calls}, {"unreached_operations_or_stages", unreached}, {"final", f.snapshot()},
+            {"actual_source_call_count", f.actual_calls}, {"actual_source_stopped", f.stopped}, {"ordinary_production_handoff_verified", false},
+            {"numerical_PASS_claimed", false}};
+}
+} // namespace
+int main(int argc, char const *argv[])
+{
+    try {
+        require(argc == 2, "Usage: src05_surface_environment_helper <literal-input-only-request.json>");
+        std::ifstream stream(argv[1]); require(stream.is_open(), "Cannot open input-only request");
+        auto const request = json::parse(stream);
+        keys(request, {"schema", "expected_values_supplied", "ordinary_production_prestate_supplied", "cases"});
+        require(request.at("schema") == "src05-surface-environment-direct-request.v1" && request.at("expected_values_supplied") == false &&
+                request.at("ordinary_production_prestate_supplied") == false, "Unadmitted Source request");
+        require(request.at("cases").is_array() && !request.at("cases").empty(), "Full ordered input cases required");
+        json cases = json::array(); bool failed = false; std::set<std::string> ids;
+        for (auto const &item : request.at("cases")) {
+            require(item.at("case_id").is_string() && ids.insert(item.at("case_id").get<std::string>()).second, "Unique case ID required");
+            cases.push_back(evaluate(item, failed));
+        }
+        std::cout << json{{"schema", "src05-surface-environment-direct-results.v1"}, {"cases", cases}, {"requested_case_count", request.at("cases").size()},
+                          {"recorded_case_count", cases.size()}, {"expected_values_supplied", false}, {"Original_bodies_modified", false},
+                          {"scientific_PASS_claimed", false}, {"gates_updated", false}}.dump() << '\n';
+        return failed ? 2 : 0;
+    } catch (std::exception const &error) {
+        std::cerr << error.what() << '\n';
+        return 2;
+    }
+}

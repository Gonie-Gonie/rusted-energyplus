def ref(path):
    b = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(b).hexdigest(), size_bytes=len(b), line_count=len(b.splitlines()))


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding='utf-8', newline='\n')


def delta(a, b, name):
    return ''.join(difflib.unified_diff(a.splitlines(True), b.splitlines(True), fromfile='a/' + name, tofile='b/' + name))



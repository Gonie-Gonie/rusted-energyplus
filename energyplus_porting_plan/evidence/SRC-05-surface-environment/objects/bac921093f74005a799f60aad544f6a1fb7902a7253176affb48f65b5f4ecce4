"""Factual released Original baseline review only; never Rust parity or equation replay."""
from pathlib import Path
import collections
import copy
import hashlib
import json
import runpy
import struct

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-05/native-factual-review-01'
assert not OUT.exists()
SOURCE = ROOT / '.runtime/porting/SRC-05/surface-environment-selected-comparison-prep-02/compare.py'
assert hashlib.sha256(SOURCE.read_bytes()).hexdigest() == '762ee3695013464caf32b5207052204f8cd35a2a55a42bc758e920c89e99757f'
# Reuse the accepted receipt/scalar/complete Native DTO primitives only. Its main
# and compare/custody functions are never called; no Rust result is opened.
api = runpy.run_path(str(SOURCE))
need, exact, load, scalar, literal = [api[k] for k in ('need','exact','load','scalar','literal')]
selected, array_rows, receipt = [api[k] for k in ('selected','array_rows','receipt')]


def ref(path):
    with path.open('rb') as stream:
        sha=hashlib.file_digest(stream,'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix(),sha256=sha,size_bytes=path.stat().st_size)


def literal_owner(snapshot, spec):
    value=selected(snapshot,spec,True)
    for observed, declared in zip(value['rows'],spec['initial']['surfaces']):
        need(observed['ExtWind']==declared['ExtWind'],'initial exposure copy differs')
        for name in ['Centroid_z']+api['ARRAYS']:
            need(observed[name]==literal(declared[name]),'initial literal owner copy differs')
    for name in ('SiteWindExp','SiteWindBLHeight'):
        need(value['parameters'][name]==literal(spec['initial']['site_parameters'][name]),'actual caller site operand copy differs')


def snapshot(value, spec, fresh=False):
    actual_spec={'initial':{'surfaces':[]}} if fresh else spec
    selected(value,actual_spec,True)
    need(type(value['ErrorsFound']) is bool,'actual ErrorsFound bool required')
    for name in ('error_stream','eio','console'):
        need(type(value[name]) is str,'full actual stream string required')
    backend=value['owner']['backend']; flags=value['owner']['backend_flags']
    ints=['TotalWarningErrors','TotalSevereErrors','TotalWarningErrorsDuringWarmup','TotalSevereErrorsDuringWarmup','TotalWarningErrorsDuringSizing','TotalSevereErrorsDuringSizing']
    bools=['AbortProcessing','outputErrorHeader','DoingInputProcessing','printConsoleOutput','errorCallback_present','messageCallback_present','fMessagePtr_present','sqlite_present']
    strings=['LastSevereError','VerStringVar','IDDVerString','CurrentDateTime']
    need(set(backend)==set(ints+bools+strings+['MatchCounts']),'full backend member inventory required')
    need(all(type(backend[n]) is int and backend[n]>=0 for n in ints),'actual severity counters required')
    need(all(type(backend[n]) is bool for n in bools) and all(type(backend[n]) is str for n in strings),'full backend owner types required')
    need(set(flags)=={'WarmupFlag','DoingSizing','KickOffSimulation'} and all(type(v) is bool for v in flags.values()),'full actual context flags required')
    need(backend['errorCallback_present'] and backend['messageCallback_present'] and not backend['fMessagePtr_present'] and not backend['sqlite_present'],'actual declared optional backend presence differs')
    need(all(type(v) is int for v in array_rows(backend['MatchCounts'],20)),'full ordered20 MatchCounts required')
    for c in value['callbacks']:
        need(c['kind'] in ('errorCallback','messageCallback') and type(c['message']) is str,'full actual callback payload required')
        need((c['kind']=='messageCallback' and c['level'] is None) or (c['kind']=='errorCallback' and type(c['level']) is int),'actual callback level kind differs')
    return value


def prefix(before, after):
    for name in ('error_stream','eio','console'):
        need(after[name].startswith(before[name]),'captured output prefix was lost')
    need(after['callbacks'][:len(before['callbacks'])]==before['callbacks'],'captured callback prefix lost')


recorder=ref(ROOT/'tools/porting/record_command.py')
execution_ref=dict(path='.runtime/porting/SRC-05/selected-observation-01/Native-command/receipt.json',sha256='a4bb9ac4fbdb85e8ad426f24fbb182a006e0bc16d08186da45c8987cb9bec0b2')
execution=receipt(execution_ref,recorder,(0,2))
need(execution['exit_code']==2,'actual Original exit2 must be retained')
need(exact(execution['stderr']).stat().st_size==0,'unexpected Native stderr')
freeze_ref=ref(ROOT/'.runtime/porting/SRC-05/selected-observation-01/frozen-observation-inputs.json')
freeze=load(freeze_ref); need(freeze['schema']=='src05-selected-setters-frozen-observation-inputs.v1','actual observation freeze required')
build_ref=freeze['actual_Native_build_inputs']; build=load(build_ref)
need(build['schema']=='src05-direct-setters-actual-link-inputs.v1' and build['Original_Source_or_core_math_modified'] is False,'genuine actual Native build authority required')
preparation=load(build['reviewed_Source_preparation'])
need(preparation['schema']=='src05-surface-environment-native-source-preparation.v1','actual reviewed Native Source required')
need(build['frozen_Source_and_input']==preparation['Native_source_files']+[preparation['input_only_request'],preparation['prospective_policy']],'full literal Source/input freeze correspondence differs')
for row in build['frozen_Source_and_input']: exact(row)
for role in ('actual_link_command','official_Source_and_core_check','actual_address_to_Original_Source_check'):
    r=receipt(build[role],recorder);need(r['finished_utc']<=execution['started_utc'],'build/core/provider command must precede capture')
pe=load(build['actual_PE_inventory']); need(pe['actual_Native_binary']==build['actual_Native_binary'] and pe['actual_full_link_map']==build['actual_full_link_map'],'actual PE/link inventory binary/map joins differ')
exact(build['actual_Native_binary'],True); exact(build['actual_full_link_map'],True)
provider=exact(build['selected_link_provider_lines']).read_text(encoding='utf-8')
need(all(name in provider for name in preparation['core_address_bound_providers_required']),'six actual address-bound providers unavailable')
for key in ('Native_input','Rust_input'):
    need(exact(freeze[key]).read_bytes()==exact(preparation['input_only_request']).read_bytes(),'full frozen input copy differs')
need(execution['command']==[str(exact(build['actual_Native_binary'],True)),str(exact(freeze['Native_input']))],'actual Native argc2/input/exe differs')
snap=load(execution['source_snapshot']);need(snap['schema']=='rust-command-source-snapshot.v1' and snap['bytes_normalized'] is False,'full actual Source snapshot required')
need(len({v['historical_path'] for v in snap['files']})==len(snap['files']),'duplicate actual Source snapshot path')
for row in snap['files']: need(exact(row['archive']).stat().st_size==row['size_bytes'],'full Source archived byte size differs')
request=load(freeze['Native_input']); data=load(execution['stdout'])
need(data['schema']=='src05-surface-environment-direct-results.v1','complete actual Native result required')
need(request['schema']=='src05-surface-environment-direct-request.v1' and request['expected_values_supplied'] is False and request['ordinary_production_prestate_supplied'] is False,'literal-only request required')
need(data['requested_case_count']==data['recorded_case_count']==len(data['cases'])==len(request['cases'])==26,'all26 actual cases required')
need(all(data[k] is False for k in ('expected_values_supplied','Original_bodies_modified','scientific_PASS_claimed','gates_updated')),'actual result scope declaration differs')
records=[]; calls_by_api=collections.Counter(); stages_unreached=collections.Counter(); entire_ops_unreached=0; operation_count=0; all_call_count=0; snapshots_checked=0
for spec,case in zip(request['cases'],data['cases']):
    need(case['case_id']==spec['case_id'] and case['literal_input']==spec,'literal case identity/order/input differs')
    need(case['ordinary_production_handoff_verified'] is False and case['numerical_PASS_claimed'] is False,'case must not claim parity/ordinary completion')
    snapshot(case['fresh_constructor_state'],spec,True);snapshot(case['prepared_state'],spec);snapshots_checked+=2
    literal_owner(case['prepared_state'],spec)
    for name,value in spec['initial']['backend_flags'].items():
        owner=case['prepared_state']['owner']; actual=owner['backend_flags'].get(name,owner['backend'].get(name))
        need(type(actual) is bool and actual is value,'literal backend flag copy differs')
    calls=case['actual_calls'];need(case['actual_source_call_count']==len(calls) and [v['actual_call_ordinal'] for v in calls]==list(range(1,len(calls)+1)),'full ordered actual call count differs')
    need(len(calls)>=2,'actual two default producers required')
    for i,(identity,name) in enumerate([('prepare-site-defaults','HeatBalanceManager::GetSiteAtmosphereData'),('prepare-station-defaults','Weather::GetWeatherStation')]):
        c=calls[i];need((c['operation_id'],c['api'])==(identity,name) and c['actual_source_invoked'] is True and c['actual_source_return_observed'] is True and c['source_exception'] is None,'actual absent-object default producer unavailable')
        snapshot(c['before'],spec);snapshot(c['after'],spec);prefix(c['before'],c['after']);snapshots_checked+=2
        need(not c['before']['ErrorsFound'] and not c['after']['ErrorsFound'],'default producer reported unexpected error')
        need(c['before']['callbacks']==c['after']['callbacks'] and c['before']['error_stream']==c['after']['error_stream'],'default producer emitted unexpected diagnostic')
        calls_by_api[c['api']]+=1
    need(calls[0]['after']==calls[1]['before'],'default call continuity differs')
    prepared=copy.deepcopy(calls[1]['after'])
    for name in ('SiteTempGradient','WeatherFileTempModCoeff','WeatherFileWindModCoeff'):
        override=spec['initial']['site_parameters'][name+'_override']
        if override is not None:
            need(scalar(case['prepared_state']['owner']['environment'][name])==literal(override),'literal override copy differs')
            prepared['owner']['environment'][name]=case['prepared_state']['owner']['environment'][name]
    need(prepared==case['prepared_state'],'unexpected owner mutation during literal post-default overrides')
    prior=case['prepared_state']; cursor=2; boundary_cursor=0; stopped=False; unreached=[]; audits=[]; fatal=None
    for op in spec['operations']:
        operation_count+=1
        if stopped:
            unreached.append(op);entire_ops_unreached+=1;continue
        boundary=case['declared_weather_boundaries'][boundary_cursor];boundary_cursor+=1
        need(boundary['literal_operation']==op and boundary['before_declared_weather_writes']==prior,'actual weather boundary prefix differs')
        snapshot(boundary['before_declared_weather_writes'],spec);snapshot(boundary['after_declared_weather_writes'],spec);snapshots_checked+=2
        changed=copy.deepcopy(prior)
        for name,operand in op['weather'].items():
            actual=boundary['after_declared_weather_writes']['owner']['environment'][name]
            need(scalar(actual)==literal(operand),'actual full weather input copy differs')
            changed['owner']['environment'][name]=actual
        need(changed==boundary['after_declared_weather_writes'],'undeclared mutation at weather input writes')
        prior=boundary['after_declared_weather_writes']
        for stage in api['STAGES']:
            if stopped:
                unreached.append(dict(operation_id=op['operation_id'],unreached_stage=stage));stages_unreached[stage]+=1;continue
            c=calls[cursor];cursor+=1;all_call_count+=1
            need(c['api']==api['APIS'][stage] and c['operation_id']==op['operation_id'] and c['actual_source_invoked'] is True and c['before']==prior,'actual stage/input/API prefix differs')
            snapshot(c['before'],spec);snapshot(c['after'],spec);prefix(c['before'],c['after']);snapshots_checked+=2
            calls_by_api[c['api']]+=1
            returned=c['actual_source_return_observed'];need(type(returned) is bool,'actual return flag bool required')
            if returned: need(c['source_exception'] is None,'returned call carries unexpected exception')
            else:
                need(stage=='check' and c['source_exception']==dict(kind='OriginalFatalError',message='Program terminates due to preceding condition(s).'),'unexpected actual source stop/exception')
                before=selected(c['before'],spec,True);trigger=[]
                for i,row in enumerate(before['rows']):
                    if any(struct.unpack('>d',bytes.fromhex(row[n][0]))[0] < -100.0 for n in api['ARRAYS'][:2]):trigger.append(i+1)
                need(trigger,'actual Original cold fatal has no captured strict-cold input row')
                added=c['after']['callbacks'][len(c['before']['callbacks']):]
                need(added and added[0]['kind']=='errorCallback' and added[0]['level']==3 and added[0]['message']=='SetOutBulbTempAt: Surface Outdoor Temperatures < -100 C','cold severe actual callback prefix absent')
                need(added[-1]['kind']=='errorCallback' and added[-1]['level']==4 and added[-1]['message']==c['source_exception']['message'],'actual fatal callback tail absent')
                fatal=dict(operation_id=op['operation_id'],actual_call_ordinal=c['actual_call_ordinal'],exception=c['source_exception'],captured_strict_cold_row_ids=trigger,actual_new_callbacks=added,
                    actual_error_stream=c['after']['error_stream'],actual_console=c['after']['console'],actual_backend_after=c['after']['owner']['backend'])
            if stage=='check':need(selected(c['before'],spec,True)==selected(c['after'],spec,True),'cold check mutated selected arithmetic owners')
            if returned:
                need(c['before']['callbacks']==c['after']['callbacks'] and c['before']['owner']['backend']==c['after']['owner']['backend'],'returned setter/check emitted unexpected backend mutation')
            audits.append(dict(operation_id=op['operation_id'],stage=stage,actual_call_ordinal=c['actual_call_ordinal'],actual_source_return_observed=returned,source_exception=c['source_exception']))
            prior=c['after'];stopped=not returned
    snapshot(case['final'],spec);snapshots_checked+=1
    need(cursor==len(calls) and boundary_cursor==len(case['declared_weather_boundaries']) and unreached==case['unreached_operations_or_stages'],'full call/boundary/unreached closure differs')
    need(prior==case['final'] and case['actual_source_stopped'] is stopped,'actual final/stopped owner closure differs')
    records.append(dict(case_id=spec['case_id'],actual_call_count=len(calls),actual_weather_boundary_count=boundary_cursor,actual_source_stopped=stopped,
        ordered_actual_setter_check_calls=audits,actual_unreached_operations_or_stages=unreached,actual_Original_fatal=fatal,math_parity_claimed=False))
need(operation_count==30 and all_call_count+52==sum(len(c['actual_calls']) for c in data['cases']),'complete declared30 operation/all-call ledger required')
need(any(c['actual_source_stopped'] for c in data['cases']),'exit2 requires captured actual source stops')
for path,sha in api['SEEN'].items():
    with path.open('rb') as stream:need(hashlib.file_digest(stream,'sha256').hexdigest()==sha,'authenticated actual artifact changed during factual review')
report=dict(schema='src05-independent-Original-factual-baseline-review.v1',status='accepted-factual-baseline-with-retained-Original-fatal-stops',
    actual_review_source=ref(Path(__file__)),reused_accepted_reader_source=ref(SOURCE),actual_Native_execution=execution_ref,actual_full_Native_stdout=execution['stdout'],
    actual_observation_freeze=freeze_ref,actual_build_inputs=build_ref,actual_source_snapshot=execution['source_snapshot'],actual_process_exit_code=execution['exit_code'],
    actual_case_count=len(records),declared_weather_operation_count=operation_count,actual_source_call_count=sum(c['actual_call_count'] for c in records),
    actual_source_calls_by_API=dict(calls_by_api),actual_source_fatal_case_count=sum(c['actual_source_stopped'] for c in records),
    actual_unreached_stages=dict(stages_unreached),actual_entire_unreached_operations=entire_ops_unreached,full_snapshot_DTOs_validated=snapshots_checked,
    full_input_and_executable_current_after_hashes_match_recorded_precapture_pins=True,
    custody_boundary='Pre-capture pins are actual frozen observation/build metadata. This review independently hashes after capture and rechecks during review; record_command does not guard Native exe/input bytes during execution. No separate retroactive within-command executable guard is claimed.',
    callback_integrity_or_unexpected_exception_found=False,unexpected_stderr_found=False,all_expected_prefixes_and_unreached_ledger_retained=True,
    complete_ordered_case_review=records,Rust_results_read=False,selected_math_parity_comparison_performed=False,scientific_PASS_claimed=False,cold_backend_Rust_equivalence_claimed=False,
    whole_SRC05_or_ordinary_manager_PASS_claimed=False,gates_updated=False)
OUT.mkdir(parents=True)
with (OUT/'review.json').open('x',encoding='utf-8',newline='\n') as stream:json.dump(report,stream,indent=2,allow_nan=False);stream.write('\n')
print(json.dumps(ref(OUT/'review.json')))

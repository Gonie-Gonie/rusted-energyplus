import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[3]


def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(), 'size_bytes': len(data)}


input_path, output_path = [Path(v).resolve() for v in sys.argv[1:]]
assert input_path.is_relative_to(ROOT / '.runtime/porting/SRC-05')
assert output_path.is_relative_to(ROOT / '.runtime/porting/SRC-05')
assert output_path.parent.is_dir() and not output_path.exists()
launcher = ref(Path(__file__))
before = ref(input_path)
environment = os.environ.copy()
operands = {'SRC05_REFERENCE_INPUT': str(input_path), 'SRC05_REFERENCE_OUTPUT': str(output_path)}
environment.update(operands)
directory = output_path.parent / 'cargo-command'
command = ['cargo', 'test', '--config', 'profile.dev.debug=0', '--config', 'profile.test.debug=0', '--config', 'build.incremental=false', '--locked', '-p', 'ep_runtime', '--lib', 'heat_balance::convection::surface_environment::selected_reference::observe_literal_surface_environment_setters', '--', '--exact', '--ignored']
frozen = {'actual_launcher_source': launcher, 'actual_environment_operands': operands, 'actual_input_before': before, 'actual_Cargo_command': command}
with output_path.with_suffix('.before.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(frozen, stream, indent=2)
    stream.write('\n')
code = subprocess.call([sys.executable, '-X', 'utf8', '-B', 'tools/porting/record_command.py', '--output-dir', str(directory.relative_to(ROOT)), '--', *command], cwd=ROOT, env=environment)
after = ref(input_path)
assert ref(Path(__file__)) == launcher
sidecar = {'schema': 'src05-selected-surface-environment-execution-input-custody.v1', **frozen, 'actual_input_after': after, 'actual_Cargo_execution': ref(directory / 'receipt.json'), 'actual_output': ref(output_path) if output_path.exists() else None, 'actual_Cargo_exit_code': code, 'input_bytes_match_before_after': before == after, 'numerical_PASS_claimed': False, 'gates_updated': False}
with output_path.with_suffix('.custody.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(sidecar, stream, indent=2)
    stream.write('\n')
print(json.dumps({'sidecar': ref(output_path.with_suffix('.custody.json')), 'actual_Cargo_exit_code': code}))
raise SystemExit(code if before == after else 1)

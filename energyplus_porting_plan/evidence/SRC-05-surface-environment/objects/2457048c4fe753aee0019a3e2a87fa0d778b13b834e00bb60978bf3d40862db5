"""Apply only reviewed Source05 actual Boolean correction; retain full cumulative custody."""
import difflib
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
spec = importlib.util.spec_from_file_location('recorder', ROOT / 'tools/porting/record_command.py')
rec = importlib.util.module_from_spec(spec)
spec.loader.exec_module(rec)
OUT = ROOT / '.runtime/porting/SRC-05/observer-lint-applied-01'


def checked(row):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT) and rec.sha(path) == row['sha256']
    data = path.read_bytes()
    assert 'size_bytes' not in row or len(data) == row['size_bytes']
    return data


def members(row):
    return {v['historical_path']: v for v in json.loads(checked(row))['files']}


preparation = {'path': '.runtime/porting/SRC-05/surface-environment-prep-05/manifest.json',
               'sha256': 'cff45c9a0db7972cf59243c53e68d58532fbc068fd4294f6e6c6acd530eecc75'}
prep = json.loads(checked(preparation))
row = prep['narrow_actual_correction']
assert row['canonical_path'] == 'crates/ep_runtime/src/heat_balance/convection/surface_environment_selected_reference.rs'
assert checked(row['actual_before']) == checked(row['before_archive'])
proposal = checked(row['proposal'])
checked(row['exact_diff'])
failed = json.loads(checked(prep['retained_failed_quality']))
assert failed['exit_code'] == 101 and failed['source_bytes_match_before_and_after'] is True
before = rec.source_snapshot()
assert before['sha256'] == 'c21f5f0a687046825827d499e6d91cee58685c3fe95d21f9fbdc674d03cc00c1'
assert not OUT.exists()
OUT.mkdir()
(ROOT / row['canonical_path']).write_bytes(proposal)
literal = rec.source_snapshot()
fmt_dir = '.runtime/porting/SRC-05/observer-lint-format-command-01'
assert subprocess.run([sys.executable, '-X', 'utf8', '-B', 'tools/porting/record_command.py', '--output-dir', fmt_dir, '--', 'cargo', 'fmt', '--all'], cwd=ROOT).returncode == 0
final = rec.source_snapshot()
before_rows, final_rows = members(before), members(final)
assert final_rows.keys() == before_rows.keys() and len(final_rows) == 3919
assert all(before_rows[p] == final_rows[p] for p in before_rows if p != row['canonical_path'])
applied = []
for index, held in enumerate(prep['application'], 1):
    path = ROOT / held['canonical_path']
    data = path.read_bytes()
    delta = ''.join(difflib.unified_diff(checked(held['proposal']).decode().splitlines(True), data.decode().splitlines(True), fromfile=held['proposal']['path'], tofile=held['canonical_path'])).encode()
    diffpath = OUT / f'formatter-{index}.diff'
    diffpath.write_bytes(delta)
    applied.append({**held, 'actual_final': {**rec.ref(path), 'size_bytes': len(data)}, 'actual_final_archive': rec.store_bytes(data), 'actual_formatter_diff': {**rec.ref(diffpath), 'size_bytes': len(delta)}})
fmt = rec.ref(ROOT / fmt_dir / 'receipt.json')
assert json.loads(checked(fmt))['source_snapshot'] == literal
record = {'schema': 'src05-observer-lint-actual-correction.v1', 'source_preparation': preparation,
          'prior_actual_application': rec.ref(ROOT / '.runtime/porting/SRC-05/surface-environment-applied-01/record.json'),
          'retained_failed_quality': prep['retained_failed_quality'], 'actual_corrective_application': row,
          'source_before': before, 'source_literal': literal, 'source_final': final, 'source_file_count': 3919,
          'unrelated_source_files_verified_byte_exact': 3918, 'actual_format_receipt': fmt, 'application': applied,
          'cumulative_correspondence_is_not_a_reapplication_of_historical_before_rows': True,
          'numerical_results_read_by_correction': False, 'gates_updated': False}
path = OUT / 'record.json'
path.write_bytes(rec.json_bytes(record))
print(json.dumps({'record': rec.ref(path), 'Source': final}))

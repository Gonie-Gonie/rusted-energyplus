def ref(path):
    data = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(data).hexdigest(),
            "size_bytes": len(data), "line_count": len(data.splitlines())}


def put(name, data):
    path = OUT / name
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data if isinstance(data, bytes) else data.encode("utf-8"))
    return ref(path)


def ranged(path, first, last, purpose):
    data = b"".join(path.read_bytes().splitlines(keepends=True)[first - 1:last])
    return {"source": ref(path), "first_line": first, "last_line": last,
            "range_sha256": hashlib.sha256(data).hexdigest(), "range_size_bytes": len(data), "purpose": purpose}



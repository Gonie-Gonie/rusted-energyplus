OUT = Path('.runtime/porting/ZON-05/rust-humidity-member-prep-01')
def describe(path):
    path = Path(path)
    b = path.read_bytes()
    return {'path':path.as_posix(),'sha256':hashlib.sha256(b).hexdigest(),
            'size_bytes':len(b),'line_count':len(b.splitlines())}
def write(path, data):
    assert not path.exists(),path
    path.parent.mkdir(parents=True,exist_ok=True)
    path.write_bytes(data)
def json_write(path, value): write(path,(json.dumps(value,indent=2,ensure_ascii=False)+'\n').encode())
def patch(before, after, dest, destination):
    old = before.read_text(encoding='utf8').splitlines(keepends=True) if before else []
    new = after.read_text(encoding='utf8').splitlines(keepends=True)
    value = ''.join(difflib.unified_diff(old,new,fromfile=before.as_posix() if before else '/dev/null',tofile=after.as_posix()))
    write(dest,value.encode())
    return {'canonical_destination':destination,'before':describe(before) if before else None,
            'proposed':describe(after),'exact_diff':describe(dest)}
def range_ref(path, first, last, purpose):
    b=b''.join(Path(path).read_bytes().splitlines(keepends=True)[first-1:last])
    return {'path':path,'start_line':first,'end_line':last,'sha256':hashlib.sha256(b).hexdigest(),
            'size_bytes':len(b),'purpose':purpose}


for path in [main_path, tests_path, HERE / 'prepare_sources.py', Path(__file__)]: ast.parse(path.read_text(encoding='utf-8'))
test_tree = ast.parse(tests_path.read_text(encoding='utf-8'))
assert sum(isinstance(node, ast.FunctionDef) and node.name.startswith('test_') for node in ast.walk(test_tree)) == 7
put(HERE / 'before/comparison_contract_tests.py', (RAD / 'comparison_contract_tests.py').read_bytes())
diffs = []
for name in ['compare_unit.py', 'comparison_contract_tests.py']:
    before, after = HERE / 'before' / name, HERE / name
    delta = ''.join(difflib.unified_diff(before.read_text(encoding='utf-8').splitlines(True), after.read_text(encoding='utf-8').splitlines(True),
                    fromfile=ref(before)['path'], tofile=ref(after)['path'])).encode('utf-8')
    path = HERE / 'diffs' / (name + '.diff')
    if path.exists(): path.write_bytes(delta)
    else: put(path, delta)
    diffs.append({'before': ref(before), 'after': ref(after), 'diff': ref(path)})
policy = read(ZON / 'native-helper-prep-01/observation-policy.proposed.json')
source = main_path.read_text(encoding='utf-8')
tree = ast.parse(source)
assignments = {node.targets[0].id: node.value for node in tree.body if isinstance(node, ast.Assign) and isinstance(node.targets[0], ast.Name)}
assert ast.literal_eval(assignments['FROZEN_PROFILES']) == policy['required_numerical_profiles']
assert ast.literal_eval(assignments['API_PATHS']) == observer['runtime_interfaces']['actual_public_API_sources']
assert ast.literal_eval(assignments['OBSERVER_PATHS']) == observer['runtime_interfaces']['observer_sources']
assert ast.literal_eval(assignments['IO_SHA']) == qa['own_sources'][2]['sha256']
assert ast.literal_eval(assignments['SHAPE_SHA']) == qa['own_sources'][1]['sha256']
assert 'frozen_before_this_ZON05_helper_execution' in source and 'RAD01' not in source
assert 'request["requested_counts"]' not in source and 'native["energyplus_commit"]' not in source
ranges = observer['read_source_ranges'] + [
    ranged(ZON / 'original-data-review-prep-01/shape.py', 1, 204, 'unchanged whole factual Native ledger validator, directly reused'),
    ranged(ZON / 'original-data-review-prep-01/packet_io.py', 1, 105, 'unchanged direct Source/input identity and archive IO'),
    ranged(ZON / 'original-data-review-prep-01/review_data.py', 1, 261, 'actual QA schema/argv/source archives and release protocol'),
    ranged(ROOT / 'crates/ep_runtime/src/psychrometrics/psy02_state.rs', 230, 257, 'actual WFromRh has no direct target cache slot; nested rows separate'),
    ranged(ROOT / observer['own_sources'][1]['path'], 1, 143, 'actual serialized Rust field/phase/property owner contract'),
    ranged(ROOT / observer['own_sources'][0]['path'], 149, 177, 'actual same-case call/prefix/phase/result Source contract')]
deps = [ref(p) for p in [native_path, freeze_path, qa_path, observer_path, pure_path,
        ZON / 'native-helper-prep-01/input-only-cases.proposed.json',
        ZON / 'native-helper-prep-01/observation-policy.proposed.json']]
own = [ref(main_path), ref(tests_path)]
manifest = {'schema': 'zon05-same-input-unit-comparison-source-preparation.v1', 'card': 'ZON-05',
    'status': 'held-source-only-unexecuted-awaiting-Root-and-other-author-FULL-review',
    'own_sources': own, 'documentation': ref(HERE / 'README.md'),
    'authoring_sources': [ref(HERE / 'prepare_sources.py'), ref(Path(__file__))],
    'literal_dependencies': deps, 'direct_unchanged_QA_runtime_support_sources': qa['own_sources'][1:],
    'before_templates': [{'historical_source': ref(RAD / name), 'archive': ref(HERE / 'before' / name)}
        for name in ['compare_unit.py', 'comparison_contract_tests.py']] + [
        {'historical_source': ref(RAD / 'manifest.json'), 'archive': ref(HERE / 'before/RAD-manifest.json')},
        {'historical_source': ref(RAD / 'README.md'), 'archive': ref(HERE / 'before/RAD-README.md')}],
    'exact_diffs': diffs, 'read_source_ranges': ranges,

"""Seal raw Source metadata only; never import or execute comparison code."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
HERE = Path(__file__).resolve().parent
RAD = HERE.parents[1] / 'RAD-01/comparer-prep-02'
ZON = HERE.parent

def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}

def put(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as handle: handle.write(data)

def read(path):
    return json.loads(path.read_text(encoding='utf-8'))

def ranged(path, first, last, purpose):
    data = b''.join(path.read_bytes().splitlines(keepends=True)[first-1:last])
    return {'source': ref(path), 'first_line': first, 'last_line': last,
            'range_sha256': hashlib.sha256(data).hexdigest(), 'range_size_bytes': len(data), 'purpose': purpose}

observer_path = ZON / 'rust-observer-prep-02/manifest.json'
qa_path = ZON / 'original-data-review-prep-01/manifest.json'
native_path = ZON / 'native-helper-prep-01/manifest.json'
freeze_path = ZON / 'input-writer-prep-01/manifest.json'
pure_path = ZON / 'rust-humidity-member-prep-01/manifest.json'

        '--Rust-build-execution', '--Rust-execution', '--Rust-results', '--output-dir'],
        'comparison_schema': 'zon05-unit-comparison.v1', 'pass_status': 'pass-selected-direct-humidity-member',
        'fail_status': 'fail-selected-direct-humidity-member',
        'executed_reader_sources_order': [own[0]] + qa['own_sources'][1:],

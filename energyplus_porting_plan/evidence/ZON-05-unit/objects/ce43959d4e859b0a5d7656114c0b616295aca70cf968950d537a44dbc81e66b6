    'tests_proposed_not_executed': {'count': 7, 'purpose': 'generic comparison primitives only; no new scientific input fixture or answer'},
    'Source_verification': {'own_and_author_AST_only': True, 'before_templates_exact': True, 'source_diffs_regenerated': True,
        'direct_QA_supports_byte_unchanged': True, 'fixed_policy_literal_exact': True, 'missing_stopped_nonfinite_never_PASS': True,
        'project_or_comparer_or_tests_import_or_execution': False, 'targets_or_Cargo_or_formatter': False,
        'Native_numeric_weather_binary_or_core_payload_read': False, 'canonical_or_Git_changed': False,
        'future_outputs_SourceSnapshot_or_digests_guessed': False, 'full_card_or_scientific_PASS_claimed': False}}
put(HERE / 'manifest.json', (json.dumps(manifest, ensure_ascii=False, indent=2) + '\n').encode('utf-8'))
seen, count = set(), 0
def walk(value):
    global count
    if isinstance(value, list):
        for item in value: walk(item)
    elif isinstance(value, dict):
        if 'path' in value and 'sha256' in value:
            key = (value['path'], value['sha256'])
            if key not in seen:
                seen.add(key); actual = ref(ROOT / value['path'])
                for field in ['sha256', 'size_bytes', 'line_count']:
                    if field in value: assert value[field] == actual[field], (key, field)
        if 'range_sha256' in value:
            data = b''.join((ROOT / value['source']['path']).read_bytes().splitlines(keepends=True)[value['first_line']-1:value['last_line']])
            assert hashlib.sha256(data).hexdigest() == value['range_sha256'] and len(data) == value['range_size_bytes']
            count += 1
        for item in value.values(): walk(item)
walk(manifest)
for row in diffs:
    before, after = ROOT / row['before']['path'], ROOT / row['after']['path']
    delta = ''.join(difflib.unified_diff(before.read_text(encoding='utf-8').splitlines(True), after.read_text(encoding='utf-8').splitlines(True), fromfile=row['before']['path'], tofile=row['after']['path'])).encode('utf-8')
    assert delta == (ROOT / row['diff']['path']).read_bytes()
print(json.dumps({'manifest': ref(HERE / 'manifest.json'), 'own': own,
    'unique_whole_refs': len(seen), 'typed_ranges': count, 'diffs': [row['diff'] for row in diffs]}, indent=2))

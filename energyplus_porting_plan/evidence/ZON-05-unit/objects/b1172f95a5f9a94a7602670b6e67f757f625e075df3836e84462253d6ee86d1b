+fn psych(value: &EnergyPlusPsychrometricsState) -> Value {
+    let mut out = psych_state(value.snapshot());
+    let caches = value.final_caches();
+    // Copy actual named Psat slots. No hash/tag calculation or HIT inference.
+    out["nondefault_Psat_rows"] = json!(caches.psat.iter().copied().filter(|row| {
+        matches!(row, EnergyPlusPsychrometricCacheSlot::Psat { i_tdb, value, .. }
+            if *i_tdb != -1000 || value.to_bits() != 0)
+    }).map(slot).collect::<Vec<_>>());
+    out["Psat_cache_capacity"] = json!(ENERGYPLUS_PSY_CACHE_SIZE);
+    out["other_actual_nondefault_cache_rows"] = json!({
+        "Twb": caches.twb.iter().copied().map(slot).collect::<Vec<_>>(),
+        "TsatPb": caches.tsat_pb.iter().copied().map(slot).collect::<Vec<_>>(),
+        "TsatHPb": caches.tsat_h_pb.iter().copied().map(slot).collect::<Vec<_>>()});
+    out["cache_hits_or_Native_internal_locals_observed"] = json!(false);
+    out["Native_global_diagnostic_indices_or_backend_inferred"] = json!(false);

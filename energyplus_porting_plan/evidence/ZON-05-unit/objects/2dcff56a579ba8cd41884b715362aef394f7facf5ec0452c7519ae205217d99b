def ref(path):
    b = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(b).hexdigest(),
            "size_bytes": len(b), "line_count": len(b.splitlines())}


def put(name, data):
    path = OUT / name
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data if isinstance(data, bytes) else data.encode("utf-8"))
    return ref(path)



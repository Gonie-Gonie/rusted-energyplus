+/// Actual Rust member-return custody, distinct from unobserved Native locals.
+#[derive(Clone, Debug)]
+pub struct ZoneHumidityCorrectionCall {
+    /// Actual source zone index supplied by the caller.
+    pub zone_id: i32,
+    /// Actual positive system-node write, or no write for source node0.
+    pub system_node_written: Option<i32>,
+    /// Actual passed-instance Wsat call/cache observation; no HIT classification.
+    pub saturation_call: EnergyPlusPsychrometricOperation,
+}

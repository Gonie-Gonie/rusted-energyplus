+fn validate(
+    state: &ZoneAirInitializationState,
+    sources: &ZoneHumiditySourceTerms,
+    context: &ZoneHumidityCorrectionContext,
+    nodes: &[ZoneHumidityNode],
+) -> Result<i32, ZoneHumidityCorrectionUnavailable> {
+    use ZoneHumidityCorrectionUnavailable::Scope;
+    if context.zone_id <= 0 || context.space_id != 0 || context.zone_name.is_empty()
+        || context.solution_algorithm != 0 || context.room_air_model != 1
+        || context.do_space_heat_balance || context.do_latent_sizing
+        || context.is_return_plenum || context.is_supply_plenum
+        || context.leakage_parallel_piu_count != 0 || context.afn_control_type != 0
+        || context.afn_multizone_always_simulated || context.afn_fan_activated
+        || context.afn_distribution_simulated || context.duct_loss_simulated || context.hybrid_model
+    {
+        return Err(Scope("zone-only mixed ThirdOrder without excluded routes required"));
+    }
+    if context.multiplier < 1 || context.list_multiplier < 1 {
+        return Err(Scope("positive Original integer multipliers required"));
+    }
+    let zone_mult = context.multiplier.checked_mul(context.list_multiplier)
+        .ok_or(Scope("Original int multiplier product is not representable"))?;
+    let physical = [context.volume, context.moisture_capacitance_multiplier,
+        context.outdoor_pressure, context.time_step_sys_seconds];
+    if physical.iter().any(|v| !v.is_finite() || *v <= 0.0)
+        || [context.outdoor_humidity_ratio,context.time_step_sys,context.time_step_zone]
+            .iter().any(|v| !v.is_finite())
+    {
+        return Err(Scope("finite declared positive capacity/pressure/seconds required"));
+    }
+    let retained = [state.zt,state.mat,state.ztav,state.air_hum_rat,state.air_hum_rat_avg,
+        state.air_hum_rat_temp,state.w1,state.wmx,state.wm2,state.w_time_minus_p,state.air_rel_hum];
+    if retained.iter().chain(state.w_prev_zone_ts.iter()).chain(state.dsw_prev_zone_ts.iter())
+        .chain(state.w_prev_zone_ts_temp.iter()).any(|v| !v.is_finite())
+    {
+        return Err(Scope("finite independently supplied state and all four history slots required"));
+    }
+    let zero = [sources.oamfl,sources.vamfl,sources.ctmfl,sources.eamfl,sources.eamfl_x_hum_rat,
+        sources.sum_hm_ara,sources.sum_hm_ara_w,sources.mixing_mass_flow_zone,
+        sources.mixing_mass_flow_x_hum_rat,sources.m_dot_oa,sources.latent_gain,
+        sources.latent_gain_except_people,sources.sum_latent_ht_rad_sys,sources.sum_latent_pool];
+    if zero.iter().any(|v| *v != 0.0) {
+        return Err(Scope("actual excluded OA/latent/surface/mixing operands must be zero"));
+    }
+    if nodes.len() > i32::MAX as usize || context.inlet_node_ids.len() > i32::MAX as usize
+        || (!context.is_controlled && !context.inlet_node_ids.is_empty())
+    {
+        return Err(Scope("source-sized ordered allocation and controlled inlet owner required"));
+    }
+    for (index,node) in nodes.iter().enumerate() {
+        if node.node_id != (index + 1) as i32
+            || [node.mass_flow_rate,node.temperature,node.humidity_ratio,node.enthalpy]
+                .iter().any(|v| !v.is_finite())
+            || node.mass_flow_rate < 0.0 || node.humidity_ratio < 0.0
+        {
+            return Err(Scope("contiguous actual nodes with finite nonnegative mass/W required"));
+        }
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    for &id in &context.inlet_node_ids {
+        if id <= 0 || id as usize > nodes.len() || !seen.insert(id) {
+            return Err(Scope("unique actually allocated inlet IDs required"));
+        }
+    }
+    let id = context.system_zone_node_number;
+    if id < 0 || id as usize > nodes.len() || (id > 0 && seen.contains(&id)) {
+        return Err(Scope("allocated feedback node distinct from declared inlets required"));
+    }
+    Ok(zone_mult)
+}

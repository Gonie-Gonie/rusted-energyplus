+/// Executes the admitted direct member once, preserving literal arithmetic order.
+///
+/// Only `air_hum_rat_temp` and a positive system node's W/H are written. The
+/// supplied psychrometric instance persists across calls. No compatibility
+/// fallback, stored-solution floor, current commit or history shift is invoked.
+pub fn correct_selected_zone_humidity_ratio(
+    state: &mut ZoneAirInitializationState,
+    sources: &ZoneHumiditySourceTerms,
+    context: &ZoneHumidityCorrectionContext,
+    nodes: &mut [ZoneHumidityNode],
+    psychrometrics: &mut EnergyPlusPsychrometricsState,
+) -> Result<ZoneHumidityCorrectionCall, ZoneHumidityCorrectionUnavailable> {
+    let zone_mult = validate(state,sources,context,nodes)?;
+    let mut moisture_mass_flow_rate = 0.0;
+    let mut zone_mass_flow_rate = 0.0;
+    if context.is_controlled {
+        for &id in &context.inlet_node_ids {
+            let inlet = &nodes[(id - 1) as usize];
+            moisture_mass_flow_rate += (inlet.mass_flow_rate * inlet.humidity_ratio) / f64::from(zone_mult);
+            zone_mass_flow_rate += inlet.mass_flow_rate / f64::from(zone_mult);
+        }
+    }
+    let latent_gain = sources.latent_gain + sources.sum_latent_ht_rad_sys + sources.sum_latent_pool;
+    let rho_air = energyplus_psy_rho_air_fn_pb_tdb_w(context.outdoor_pressure,state.zt,state.air_hum_rat);
+    if rho_air < 0.0 {
+        // EP_psych_errors invokes a stateful diagnostic/fatal path here. The
+        // existing Rust density owner does not implement that backend.
+        return Err(ZoneHumidityCorrectionUnavailable::NegativeDensityDiagnostic);
+    }
+    let h2o_ht_of_vap = energyplus_psy_hg_air_fn_w_tdb(state.air_hum_rat,state.zt);
+    let b = (latent_gain / h2o_ht_of_vap)
+        + ((sources.oamfl + sources.vamfl + sources.ctmfl) * context.outdoor_humidity_ratio)
+        + sources.eamfl_x_hum_rat + moisture_mass_flow_rate + sources.sum_hm_ara_w
+        + sources.mixing_mass_flow_x_hum_rat + sources.m_dot_oa * context.outdoor_humidity_ratio;
+    let a = zone_mass_flow_rate + sources.oamfl + sources.vamfl + sources.eamfl
+        + sources.ctmfl + sources.sum_hm_ara + sources.mixing_mass_flow_zone + sources.m_dot_oa;
+    let c = rho_air * context.volume * context.moisture_capacitance_multiplier / context.time_step_sys_seconds;
+    state.air_hum_rat_temp =
+        (b + c * (3.0 * state.w_prev_zone_ts_temp[0]
+            - (3.0 / 2.0) * state.w_prev_zone_ts_temp[1]
+            + (1.0 / 3.0) * state.w_prev_zone_ts_temp[2])) / ((11.0 / 6.0) * c + a);
+    if state.air_hum_rat_temp < 0.0 {
+        state.air_hum_rat_temp = 0.0;
+    }
+    let saturation_call = psychrometrics.evaluate(
+        EnergyPlusPsychrometricFunction::WFromRh,&[state.zt,1.0,context.outdoor_pressure],
+    ).map_err(ZoneHumidityCorrectionUnavailable::PsychrometricInterface)?;
+    if state.air_hum_rat_temp > saturation_call.result {
+        state.air_hum_rat_temp = saturation_call.result;
+    }
+    let id = context.system_zone_node_number;
+    if id > 0 {
+        nodes[(id - 1) as usize].humidity_ratio = state.air_hum_rat_temp;
+        nodes[(id - 1) as usize].enthalpy = energyplus_psy_h_fn_tdb_w(state.zt,state.air_hum_rat_temp);
+    }
+    Ok(ZoneHumidityCorrectionCall {
+        zone_id: context.zone_id,
+        system_node_written: if id > 0 { Some(id) } else { None },
+        saturation_call,
+    })
+}

+/// Explicit unavailable boundaries; none is a fabricated Native exception.
+#[derive(Clone, Debug, PartialEq)]
+pub enum ZoneHumidityCorrectionUnavailable {
+    /// A supplied route/input lies outside the declared direct unit scope.
+    Scope(&'static str),
+    /// The existing PSY01 numerical density route reaches its deferred backend.
+    NegativeDensityDiagnostic,
+    /// Existing PSY02 dispatch rejected the literal property call interface.
+    PsychrometricInterface(&'static str),
+}

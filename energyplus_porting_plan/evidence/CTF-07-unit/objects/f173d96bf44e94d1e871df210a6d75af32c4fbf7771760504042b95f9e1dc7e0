//! Literal Construction.cc 1496-1589 Gamma method, selected 1D/no-source path.

use super::ctf_state_space_assembly::{
    CtfAssemblyContext, CtfAssemblyRoute, CtfAssemblyUnavailable,
};

/// Actual same-attempt owners after exponential and inverse have returned.
#[derive(Clone, Copy, Debug)]
pub struct CtfGammaInput<'a> {
    /// Actual positive source matrix dimension.
    pub rcmax: i32,
    /// Actual AInv(i1,i2), with i2 contiguous, from the original AMat.
    pub a_inv: &'a [f64],
    /// Actual AExp(i1,i2), in the same source row-first layout.
    pub a_exp: &'a [f64],
    /// Actual caller-owned IdenMatrix; it is never manufactured here.
    pub iden_matrix: &'a [f64],
    /// Actual compressed BMat(1..3), not a reconstructed dense input matrix.
    pub b_mat: &'a [f64],
}

/// Unsupported scope or unavailable owner shape, not a Native method outcome.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum CtfGammaScopeError {
    /// A reached matrix must have positive rcmax.
    Dimension(i32),
    /// All three square owners must contain rcmax squared values.
    MatrixShape,
    /// The actual compressed forcing owner must contain exactly three values.
    ForcingShape,
    /// The perpendicular branch is outside this selected port.
    UnsupportedDimensions(i32),
    /// Internal heat-source equations are outside this selected port.
    InternalSource,
    /// The actual no-source path must have reset both node selectors.
    SourceNodeState,
    /// An enclosing invocation cannot have the pre-invocation ordinal zero.
    AttemptOrdinal,
}

/// Actual Gamma owners and the private ATemp state before source deallocation.
#[derive(Clone, Debug, PartialEq)]
pub struct CtfGammaMatrix {
    /// Same actual assembly attempt; this function generates no retry metadata.
    pub context: CtfAssemblyContext,
    /// Actual source matrix dimension, retained unchanged.
    pub rcmax: i32,
    /// ATemp=AExp-IdenMatrix at Construction.cc1530, retained before deallocation1553.
    /// Square storage is (i1-1)*rcmax+(i2-1), with i2 contiguous.
    pub a_temp: Vec<f64>,
    /// Actual Gamma1(j,i), 3 by rcmax, with i contiguous.
    pub gamma1: Vec<f64>,
    /// Actual Gamma2(j,i), 3 by rcmax, with i contiguous.
    pub gamma2: Vec<f64>,
}

/// A real unavailable route has no fabricated Gamma or workspace arrays.
#[derive(Clone, Debug, PartialEq)]
pub enum CtfGammaObservation {
    /// The enclosing source route did not invoke the selected method.
    Unavailable(CtfAssemblyUnavailable),
    /// Complete selected method owner for the supplied actual attempt.
    Gamma(Box<CtfGammaMatrix>),
}

/// Preserve the literal i/is1 and i/j/is1 accumulation and scalar operation order.
///
/// AInv, AExp, IdenMatrix, BMat and current CTFTimeStep come from the caller's
/// same actual attempt. This function neither calls the preceding methods nor
/// constructs identity, selects timestep, activates a cache or drives retries.
/// No finite, zero-timestep or conditioning guard changes source arithmetic.
pub fn calculate_selected_ctf_gammas(
    input: CtfGammaInput<'_>,
    context: CtfAssemblyContext,
) -> Result<CtfGammaObservation, CtfGammaScopeError> {
    if let CtfAssemblyRoute::Unavailable(reason) = context.route {
        return Ok(CtfGammaObservation::Unavailable(reason));
    }
    if context.source_sink_present {
        return Err(CtfGammaScopeError::InternalSource);
    }
    if context.solution_dimensions != 1 {
        return Err(CtfGammaScopeError::UnsupportedDimensions(
            context.solution_dimensions,
        ));
    }
    if context.node_source != 0 || context.node_user_temp != 0 {
        return Err(CtfGammaScopeError::SourceNodeState);
    }
    if context.attempt_ordinal == 0 {
        return Err(CtfGammaScopeError::AttemptOrdinal);
    }
    let n = usize::try_from(input.rcmax)
        .ok()
        .filter(|&n| n > 0)
        .ok_or(CtfGammaScopeError::Dimension(input.rcmax))?;
    let size = n.checked_mul(n).ok_or(CtfGammaScopeError::MatrixShape)?;
    let gamma_size = n.checked_mul(3).ok_or(CtfGammaScopeError::MatrixShape)?;
    if input.a_inv.len() != size || input.a_exp.len() != size || input.iden_matrix.len() != size {
        return Err(CtfGammaScopeError::MatrixShape);
    }
    if input.b_mat.len() != 3 {
        return Err(CtfGammaScopeError::ForcingShape);
    }
    let at = |i1: usize, i2: usize| (i1 - 1) * n + i2 - 1;
    let mut a_temp = vec![0.0; size];
    for index in 0..size {
        a_temp[index] = input.a_exp[index] - input.iden_matrix[index];
    }
    let mut gamma1 = vec![0.0; gamma_size];
    for i in 1..=n {
        for is1 in 1..=n {
            gamma1[at(1, i)] += input.a_inv[at(is1, i)] * a_temp[at(1, is1)] * input.b_mat[0];
            gamma1[at(2, i)] += input.a_inv[at(is1, i)] * a_temp[at(n, is1)] * input.b_mat[1];
            // Source NodeSource>0 is false on this selected route. Row3 keeps
            // the actual source zero initialization; BMat(3) is not read here.
        }
    }
    // Native destroys ATemp here. Retaining its already-computed values adds
    // an output owner only; no later selected arithmetic reads this workspace.
    let mut gamma2 = vec![0.0; gamma_size];
    for i in 1..=n {
        for j in 1..=3 {
            for is1 in 1..=n {
                if j == 1 && is1 == 1 {
                    gamma2[at(j, i)] += input.a_inv[at(is1, i)]
                        * (gamma1[at(j, is1)] / context.ctf_time_step - input.b_mat[0]);
                } else if j == 2 && is1 == n {
                    gamma2[at(j, i)] += input.a_inv[at(is1, i)]
                        * (gamma1[at(j, is1)] / context.ctf_time_step - input.b_mat[1]);
                } else {
                    // Source j==3 && is1==NodeSource cannot hold when the real
                    // selector is zero. Keep all genuine j3 division/products,
                    // including nonfinite outcomes; do not force its row zero.
                    gamma2[at(j, i)] += input.a_inv[at(is1, i)]
                        * (gamma1[at(j, is1)] / context.ctf_time_step);
                }
            }
        }
    }
    Ok(CtfGammaObservation::Gamma(Box::new(CtfGammaMatrix {
        context,
        rcmax: input.rcmax,
        a_temp,
        gamma1,
        gamma2,
    })))
}


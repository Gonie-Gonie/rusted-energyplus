        packet = packet.replace('methods.packet(freeze, request, admission, projection, policy, m.require)',
            'methods.packet(freeze, request, admission, projection, policy, m.require)\n    gamma.packet(freeze, request, admission, projection, policy, m.require)')
        packet = packet.replace('methods.scope(m, same, preceding, freeze, request, admission, projection,\n                  m.load(SOURCE_INVENTORIES["reviewed_passive_source_inventory"]), execution["started_utc"])',
            'gamma.scope(m, same, preceding, freeze, request, admission, projection,\n                m.load(SOURCE_INVENTORIES["reviewed_passive_source_inventory"]), execution["started_utc"], lane)')
        packet = packet.replace('{"assembly": 1, "exponential": 1, "inverse": 1}', '{"assembly": 1, "exponential": 1, "inverse": 1, "Gamma": 1}')

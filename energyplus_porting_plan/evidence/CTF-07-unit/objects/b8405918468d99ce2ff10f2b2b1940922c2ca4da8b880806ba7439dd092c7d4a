        assert 'methods.scope' not in packet and 'actual_scope_amendment_executions' not in packet
        source = replace_once(source, original_packet, packet)
        run = function(source, "run"); original_run = run
        for old, new in [('ctf06_unit_io', 'ctf07_unit_io'), ('ctf06_production_io', 'ctf07_production_io'),
                         ('ctf06_method_pairing', 'ctf07_method_pairing'), ('ctf06_method_structure', 'ctf07_method_structure'),

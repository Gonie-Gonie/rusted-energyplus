    pair = (OLD / "method_compare.py").read_text()
    pair = replace_once(pair, '"initialize_construction_ctf_first_matrix_functions"', '"initialize_construction_ctf_first_matrix_with_gammas"')
    write(OUT / "method_compare.py", pair)
    observer = json.loads((OBS / "manifest.json").read_text())

"""Author ignored Source-only comparer proposals using stdlib byte/AST operations."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent
OLD = ROOT / ".runtime/porting/CTF-06/comparer-prep-01"
QA = ROOT / ".runtime/porting/CTF-07/original-data-review-prep-01"
OBS = ROOT / ".runtime/porting/CTF-07/rust-observer-prep-01"


def identity(path):
    path = Path(path); data = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(data).hexdigest(),
            "size_bytes": len(data), "line_count": len(data.splitlines())}


def literal(source, name):
    for node in ast.parse(source).body:
        if isinstance(node, ast.Assign) and any(isinstance(target, ast.Name) and target.id == name for target in node.targets):
            return ast.literal_eval(node.value)
    raise ValueError(name)


def replace_assignment(source, name, value):
    rows = source.splitlines(True)
    for node in ast.parse(source).body:
        if isinstance(node, ast.Assign) and any(isinstance(target, ast.Name) and target.id == name for target in node.targets):
            rows[node.lineno-1:node.end_lineno] = [name + " = " + repr(value) + "\n"]
            return "".join(rows)
    raise ValueError(name)


def function(source, name):
    rows = source.splitlines(True)
    node = next(node for node in ast.parse(source).body if isinstance(node, (ast.FunctionDef, ast.ClassDef)) and node.name == name)
    return "".join(rows[node.lineno-1:node.end_lineno])


def replace_once(source, old, new):
    assert source.count(old) == 1, (old, source.count(old))
    return source.replace(old, new, 1)


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8", newline="\n")



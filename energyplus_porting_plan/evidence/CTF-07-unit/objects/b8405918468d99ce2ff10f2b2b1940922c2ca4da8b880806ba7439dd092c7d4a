    for ref in predecessor["own_sources"]:
        assert identity(ROOT / ref["path"])["sha256"] == ref["sha256"]
    before = OUT / "before"; before.mkdir(exist_ok=False)
    for filename in ["compare_unit.py", "compare_production.py", "packet_io.py", "method_compare.py", "method_shape.py", "README.md", "manifest.json"]:
        (before / filename).write_bytes((OLD / filename).read_bytes())
    for filename in ["method_shape.py", "gamma_shape.py"]:
        (OUT / filename).write_bytes((QA / filename).read_bytes())
    io = (OLD / "packet_io.py").read_text()

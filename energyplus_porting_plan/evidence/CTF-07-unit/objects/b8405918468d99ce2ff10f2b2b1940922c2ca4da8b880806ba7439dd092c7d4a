        retention["scope"] = "new-CTF07-linked-originals-only"
        source = replace_assignment(source, "RETENTION_INTENT", retention)
        source = source.replace('for key in VARIABLES + METHOD_VARIABLES}', 'for key in VARIABLES + METHOD_VARIABLES + GAMMA_VARIABLES}')

    qa_ref = identity(QA / "manifest.json")
    for lane in ["unit", "production"]:
        filename = "compare_" + lane + ".py"
        source = (OLD / filename).read_text()
        for name, value in {"PAIR_SHA": identity(OUT / "method_compare.py")["sha256"],
                            "METHOD_SHA": identity(OUT / "method_shape.py")["sha256"],
                            "IO_SHA": identity(OUT / "packet_io.py")["sha256"],
                            "DATAQA_SOURCE_INVENTORY": qa_ref, "SOURCE_INVENTORIES": inventories,

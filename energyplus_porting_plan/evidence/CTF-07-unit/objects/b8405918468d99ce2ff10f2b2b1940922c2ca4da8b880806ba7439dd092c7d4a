            'Actual Rust current07 and separate historical05/06 provenance differs')
        needle = '    comparison = Comparison(m.require); '
        assert needle in run
        run = run.replace(needle, '    m.require(rust["ctf07_gamma_observation_policy"] == native["CTF07_gamma_observation_policy"] == gamma.POLICY,\n              "Actual Gamma source policy differs from frozen packet")\n    comparison = Comparison(m.require)\n    actual_gamma_counts = gamma_pairing.validate_all(comparison,native,qa,methods,gamma)\n    ')
        if lane == "unit":

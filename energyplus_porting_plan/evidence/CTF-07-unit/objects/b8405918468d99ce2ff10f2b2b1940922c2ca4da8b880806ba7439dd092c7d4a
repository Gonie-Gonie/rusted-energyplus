                         ('ctf06-production-independent-original-data-review.v1', 'ctf07-production-independent-original-data-review.v1'),
                         ('ctf06-helper-results.v1', 'ctf07-helper-results.v1'), ('ctf06-production-helper-results.v1', 'ctf07-production-helper-results.v1'),

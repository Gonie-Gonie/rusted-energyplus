            run = run.replace('for key in VARIABLES}; passed =', 'for key in VARIABLES}; result["method_handoff_metrics"] = {key: result["metrics"].pop(key) for key in METHOD_VARIABLES}; passed =')
        run = run.replace('PREP / "method_compare.py", PREP / "method_shape.py"]',

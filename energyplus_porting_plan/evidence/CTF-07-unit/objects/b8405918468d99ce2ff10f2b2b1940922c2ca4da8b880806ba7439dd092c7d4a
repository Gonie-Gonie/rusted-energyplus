        packet = function(source, "packet_policy")
        original_packet = packet
        packet = packet.replace('lane, methods):', 'lane, methods, gamma):')
        packet = packet.replace('prefix = "ctf06-"', 'prefix = "ctf07-"').replace('frozen_before_this_CTF06_helper_execution', 'frozen_before_this_CTF07_helper_execution')

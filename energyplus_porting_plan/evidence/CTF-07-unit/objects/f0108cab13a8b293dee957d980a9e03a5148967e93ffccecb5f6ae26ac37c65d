+"""Pair copied first Gamma owners only; no Gamma, identity or retry evaluator."""
+from collections import Counter
+
+VARIABLES = ["CTF07.Gamma1", "CTF07.Gamma2", "CTF07.ATemp"]
+GAMMA_ORDER = "source_j_outer_i_inner_row_first"
+ERROR_ROUTES = ["FirstAssemblyUnavailable", "AssemblyRouteUnavailable", "ExponentialUnavailable",
+                "ExponentialRouteUnavailable", "InverseNotInvoked", "InverseUnavailable",
+                "ConstructionIdentityMismatch", "NotFirstAttempt", "AssemblyContext",
+                "AttemptContextMismatch", "DimensionMismatch", "GammaScope", "GammaRouteUnavailable"]
+
+
+def validate_all(c, native, qa, methods, gamma):
+    """Authenticate every real visit/count/integrity ledger before any Gamma pair."""
+    counts, integrity = Counter(), []
+    for model in native["model_cases"]:
+        for operation in model["operations"]:
+            label = model["id"] + "/" + operation["id"]
+            methods.review(operation, None, c.need, c.dto, counts, integrity, label)
+            gamma.review(operation, None, c.need, c.dto, counts, integrity, label)
+    method_totals = methods.summary(native, counts, c.need)
+    totals = gamma.summary(native, counts, c.need)
+    for key, value in {**method_totals, **totals}.items():
+        c.exact("DataQA_all_method_counts/" + key, qa["actual_observation_counts"][key], value)
+        c.need(qa["actual_observation_counts"][key] == value, "Actual DataQA count proof must pass before Gamma pairing")
+    c.need(not integrity, "Any actual method/Gamma copy, association, order, omission or failure prevents pairing")
+    return totals
+
+
+def rust_route(c, path, row, construction_id):
+    if not isinstance(row, dict):
+        c.absence(path + "/Rust_route_record", True, False, True, "required actual public Gamma Result ledger absent")
+        return None
+    c.need(row.get("protocol") == "ctf07-first-gammas.v1" and
+           row.get("actual_public_API") == "initialize_construction_ctf_first_gammas" and
+           row.get("actual_public_API_invoked") is True and type(row.get("owner_available")) is bool and
+           type(row.get("selected_first_Gamma_operands")) is bool and row.get("only_first_Rust_method_invocation_owned") is True and
+           row.get("counted_as_PASS") is False and all(row.get(key) is False for key in ["retry_driver_available",
+               "later_Native_method_visits_paired", "later_Native_method_visits_counted_as_PASS",
+               "Native_stage_callback_or_return_counts_inferred", "observer_Gamma_or_workspace_arithmetic_performed"]),
+           "Actual first-only public Gamma Result without reconstructed values/returns required")
+    c.exact(path + "/construction_id", construction_id, row.get("construction_id"))
+    c.exact(path + "/selection_copy", row["owner_available"], row["selected_first_Gamma_operands"])
+    if row["owner_available"]:
+        c.need(row.get("actual_source_route") == "FirstGammaReturned" and row.get("unavailable_reason") is None and
+               isinstance(row.get("snapshot"), dict), "Actual successful Gamma owner required")
+    else:
+        c.need(row.get("actual_source_route") in ERROR_ROUTES and row.get("snapshot") is None and
+               isinstance(row.get("unavailable_reason"), str) and row["unavailable_reason"],
+               "Actual Gamma prerequisite/route stop must retain reason and null owner")
+    return row
+
+
+def pair_operation(c, path, operation, row, assembly, exponential, inverse, construction_id, pairing):
+    rust = rust_route(c, path + "/CTF07", row, construction_id)
+    record = {"path": path, "actual_source_invoked": operation["actual_source_invoked"],
+              "actual_native_whole_outcome_context_only": operation["call_outcome"],
+              "selected_operands_paired": False, "all_later_actual_visits_paired": False, "counted_as_PASS": False}
+    if not operation["actual_source_invoked"]:
+        c.absence(path + "/Gamma", False, bool(rust and rust["owner_available"]), False,
+                  "whole source uninvoked after genuine stop; no Gamma invocation/phase inferred/noPASS")
+        return record
+    observed = operation["observations"]; ledger = observed["Gamma"]; visits = ledger["invocations"]
+    record.update({key: ledger[key] for key in ["actual_invocation_count", "actual_retained_invocation_count",
+        "actual_stage_callback_counts", "stage_records_omitted", "failure_event_counts", "first_failure", "last_failure"]})
+    record["actual_visits"] = [{"observed_invocation_ordinal": visit["observed_invocation_ordinal"],
+        "observed_assembly_ordinal": visit["observed_assembly_ordinal"],
+        "actual_stage_callback_counts": visit["actual_stage_callback_counts"],
+        "actual_source_return_marker_reached": visit["SourceReturn"]["reached"], "paired": False,
+        "later_context_only": visit["observed_invocation_ordinal"] > 1, "counted_as_PASS": False} for visit in visits]
+    attempts = observed["MatrixAssembly"]["attempts"]
+    native_assembly = attempts[0] if attempts and attempts[0]["observed_attempt_ordinal"] == 1 else None
+    native_selected = bool(native_assembly and native_assembly["available"] and
+        native_assembly["snapshot"]["SourceSinkPresent"] is False and native_assembly["snapshot"]["SolutionDimensions"] == 1)
+    rust_selected = isinstance(assembly, dict) and assembly.get("owner_available") is True
+    first = visits[0] if visits and visits[0]["observed_invocation_ordinal"] == 1 else None
+    if not (native_selected or rust_selected or bool(rust and rust["owner_available"])):
+        c.absence(path + "/Gamma", False, bool(rust and rust["owner_available"]), False,
+                  "actual first assembly unselected/unreached; explicit Gamma route remains unavailable/noPASS")
+        return record
+    native_available = bool(native_selected and first and first["association_available"] and first["observed_assembly_ordinal"] == 1 and
+        all(first[stage]["reached"] and first[stage]["available"] for stage in ["Entry", "ATempReady", "Gamma1Final", "Gamma2Final", "SourceReturn"]))
+    rust_available = bool(rust and rust["owner_available"])
+    if not native_available or not rust_available:
+        c.absence(path + "/Gamma", native_available, rust_available, True,
+                  "required selected first Gamma owner absent on one or both sides; later visits cannot replace first1/noPASS")
+        return record
+    c.need(rust_selected and isinstance(exponential, dict) and exponential.get("owner_available") is True and
+           isinstance(inverse, dict) and inverse.get("owner_available") is True and inverse.get("actual_public_API_invoked") is True,
+           "Selected Gamma requires the same actual first assembly and successful ordered exponential/inverse owners")
+    for name, prior in [("exponential", exponential), ("inverse", inverse)]:
+        c.exact(path + "/Gamma/same_" + name + "_owner_available", True, rust.get("same_" + name + "_owner_available"))
+        c.exact(path + "/Gamma/same_" + name + "_construction_id", construction_id, rust.get("same_" + name + "_construction_id"))
+        c.exact(path + "/Gamma/actual_" + name + "_construction_id", construction_id, prior.get("construction_id"))
+    c.exact(path + "/Gamma/same_inverse_public_API_invoked", inverse["actual_public_API_invoked"], rust.get("same_inverse_public_API_invoked"))
+    c.exact(path + "/Gamma/same_exponential_result", "Ok(())", rust.get("same_exponential_result"))
+    snapshot = rust["snapshot"]
+    c.need(snapshot.get("ATemp_storage_order") == pairing.ORDER and snapshot.get("Gamma_storage_order") == GAMMA_ORDER and
+           type(snapshot.get("rcmax")) is int and snapshot["rcmax"] > 0 and isinstance(snapshot.get("context"), dict),
+           "Actual square ATemp and rectangular Gamma source storage/context required")
+    n = snapshot["rcmax"]
+    for stage in ["Entry", "ATempReady", "Gamma1Final", "Gamma2Final", "SourceReturn"]:
+        context = first[stage]["snapshot"]["context"]
+        c.exact(path + "/Gamma/" + stage + "/rcmax", context["rcmax"], n)
+        pairing.context(c, path + "/Gamma/" + stage + "/context", context, snapshot["context"], construction_id, observed["InitialDiscretization"])
+    native_exp = observed["Exponential"]["invocations"][0]
+    native_inv = observed["Inverse"]["invocations"][0]
+    c.need(all(visit["observed_invocation_ordinal"] == visit["observed_assembly_ordinal"] == 1 and
+               visit["SourceReturn"]["reached"] and visit["SourceReturn"]["available"] for visit in [native_exp, native_inv]),
+           "Actual first exponential/inverse caller returns must precede Gamma entry")
+    pairing.original_handoff(c, path + "/Gamma/original_first_assembly", rust, assembly,
+                             pairing.matrix_map(c, native_exp["Entry"]), construction_id)
+    entry = pairing.matrix_map(c, first["Entry"])
+    source_assembly = assembly["snapshot"]
+    pairing.values(c, path + "/Gamma/entry_IdenMatrix", entry["IdenMatrix"], source_assembly["matrices"]["IdenMatrix"], n * n)
+    pairing.values(c, path + "/Gamma/entry_BMat", first["Entry"]["snapshot"]["BMat"], source_assembly["matrices"]["BMat"], 3)
+    for owner, prior, native_prior in [("AExp", exponential, native_exp), ("AInv", inverse, native_inv)]:
+        pairing.values(c, path + "/Gamma/entry_" + owner, entry[owner], prior["snapshot"]["matrices"][owner], n * n)
+        pairing.values(c, path + "/Gamma/actual_prior_return_" + owner, pairing.matrix_map(c, native_prior["SourceReturn"])[owner], entry[owner], n * n)
+    names = ["Gamma1", "Gamma2", "ATemp"]
+    matrices, counts, shapes = [snapshot.get(key) for key in ["matrices", "actual_matrix_value_counts", "actual_matrix_shapes"]]
+    c.need(all(isinstance(value, dict) and set(value) == set(names) for value in [matrices, counts, shapes]),
+           "All three actual Gamma/workspace owners and shape/count metadata required")
+    for name, stage in [("Gamma1", "Gamma1Final"), ("Gamma2", "Gamma2Final"), ("ATemp", "ATempReady")]:
+        shape = [n, n] if name == "ATemp" else [3, n]
+        size = n * n if name == "ATemp" else 3 * n
+        c.need(type(counts[name]) is int and isinstance(shapes[name], list) and all(type(v) is int for v in shapes[name]), "Typed copied Gamma shape/count required")
+        c.exact(path + "/Gamma/" + name + "/shape", shape, shapes[name])
+        c.exact(path + "/Gamma/" + name + "/count", size, counts[name])
+        actual = pairing.matrix_map(c, first[stage])[name]
+        pairing.values(c, path + "/Gamma/" + name, actual, matrices[name], size, "CTF07." + name)
+        if name != "ATemp":
+            pairing.values(c, path + "/Gamma/actual_return_handoff/" + name, actual,
+                           pairing.matrix_map(c, first["SourceReturn"])[name], size)
+    record["selected_operands_paired"] = True
+    record["actual_visits"][0]["paired"] = True
+    c.counts["gamma_selected_first_owner_pairs"] += 1
+    return record
+
+
+def compare_unit(c, native, rust, request, pairing):
+    records = []
+    for expected, left, right in zip(request["model_cases"], native["model_cases"], rust["model_cases"]):
+        for index, (declared, operation, observed) in enumerate(zip(expected["operations"], left["operations"], right["operations"])):
+            records.append(pair_operation(c, expected["id"] + "/" + declared["id"], operation,
+                observed.get("CTF07_first_gammas"), observed.get("CTF04_first_assembly"),
+                observed.get("CTF06_first_exponential"), observed.get("CTF05_first_inverse"), index, pairing))
+    return records
+
+
+def compare_production(c, native, rust, request, pairing, normalized, owners):
+    records = []
+    for expected, left, right in zip(request["model_cases"], native["model_cases"], rust["model_cases"]):
+        path = expected["id"]; typed = right.get("typed_owners")
+        constructions = typed.get("constructions") if isinstance(typed, dict) else None
+        selected = right.get("selected_CTF07_owners")
+        if not isinstance(constructions, list) or not isinstance(selected, dict) or selected.get("owner_available") is not True:
+            c.absence(path + "/required_initialized_Gamma_owners", left["loader_ready"], False, True,
+                      "required actual typed construction/Gamma owner ledger unavailable")
+            for operation in left["operations"]:
+                records.append(pair_operation(c, path + "/" + operation["id"], operation, None, None, None, None, None, pairing))
+            continue
+        c.need(selected.get("actual_CTF06_then_CTF05_then_CTF07_order_is_producer_owned") is True and
+               selected.get("only_first_Rust_method_invocation_owned") is True and selected.get("Native_whole_solver_flags_unpaired") is True and
+               all(selected.get(key) is False for key in ["predecessor_or_Gamma_owners_reexecuted_by_observer", "retry_driver_available",
+                   "later_Native_method_visits_paired", "later_Native_method_visits_counted_as_PASS", "numerical_PASS_claimed"]),
+               "Actual borrowed first-only initialized Gamma owners required")
+        ids = [row["id"] for row in constructions]; by_name = owners(constructions, "name", c)
+        rows = selected.get("construction_first_gammas")
+        c.need(isinstance(rows, list) and len({row["construction_id"] for row in rows}) == len(rows) and type(selected.get("actual_owner_count")) is int,
+               "Unique ordered actual Gamma owner IDs/count required")
+        c.exact(path + "/Gamma/owner_order", ids, [row["construction_id"] for row in rows])
+        c.exact(path + "/Gamma/owner_count", len(rows), selected["actual_owner_count"])
+        for index, row in enumerate(rows): c.exact(path + "/Gamma/state_vector_index/" + str(index), index, row["state_vector_index"])
+        gammas = {row["construction_id"]: row["result"] for row in rows}
+        matches = {}
+        for card, field in [("CTF04", "construction_first_assembly"), ("CTF06", "construction_first_exponential"), ("CTF05", "construction_first_inverse")]:
+            owner = right.get("selected_" + card + "_owners")
+            prior = owner.get(field, []) if isinstance(owner, dict) else []
+            c.need(isinstance(prior, list) and len({row["construction_id"] for row in prior}) == len(prior), "Unique real matching predecessor owners required")
+            matches[card] = {row["construction_id"]: row["result"] for row in prior}
+        for operation in left["operations"]:
+            name = normalized(operation["actual_construction_Name"], c); construction = by_name.get(name)
+            cid = construction["id"] if construction else None
+            records.append(pair_operation(c, path + "/" + name, operation, gammas.get(cid), matches["CTF04"].get(cid),
+                matches["CTF06"].get(cid), matches["CTF05"].get(cid), cid, pairing))
+    return records

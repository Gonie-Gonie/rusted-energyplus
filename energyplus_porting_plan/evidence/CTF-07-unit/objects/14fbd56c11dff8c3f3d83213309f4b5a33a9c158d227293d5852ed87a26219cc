def ref(path):
    raw = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(raw).hexdigest(),
            "size_bytes": len(raw), "line_count": len(raw.splitlines())}


def checked(binding):
    path = ROOT / binding["path"]
    actual = ref(path)
    for key in ("sha256", "size_bytes", "line_count"):
        if key in binding:
            assert actual[key] == binding[key], (path, key)
    return path


def once(text, old, new):
    assert text.count(old) == 1, old
    return text.replace(old, new, 1)


def namespace(text):
    for old, new in [
        ("ctf06_candidate_", "ctf07_candidate_"), ("ctf06-candidate-", "ctf07-candidate-"),
        ("ctf06-helper-cases.v1", "ctf07-helper-cases.v1"),
        ("ctf06-native-admission-contract.v1", "ctf07-native-admission-contract.v1"),
        ("ctf06-production-helper-cases.v1", "ctf07-production-helper-cases.v1"),
        ("ctf06-production-native-admission-contract.v1", "ctf07-production-native-admission-contract.v1"),
        ("frozen_before_this_CTF06_helper_execution", "frozen_before_this_CTF07_helper_execution"),
        ("actual frozen CTF06 production packet differs", "actual frozen CTF07 production packet differs"),
    ]:
        text = text.replace(old, new)
    return text



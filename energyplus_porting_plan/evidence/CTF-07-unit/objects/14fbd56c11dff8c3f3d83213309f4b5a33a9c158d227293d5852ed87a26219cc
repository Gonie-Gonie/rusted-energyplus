def scope_block(value):
    return '''    require(
        VALUE["actual_scope_amendment_execution_role"]
            == "real-CTF-07-check-only; prior05/06-authorities-separate"
            && admission["actual_scope_amendment_execution_role"]
                == VALUE["actual_scope_amendment_execution_role"]
            && admission["prior_05_06_authority"] == VALUE["prior_05_06_authority"]
            && admission["current_cards"] == VALUE["current_cards"],
        "current07 authority role or separate historical prior05/06 authority differs",
    )?;
    bindings.push(VALUE["current_cards"]["CTF-07"].clone());
    let prior = &VALUE["prior_05_06_authority"];
    for key in ["prior_06_freeze", "prior_06_freeze_execution", "prior_05_06_scope_amendment",
        "prior_06_writer_manifest", "prior_06_source_contract"] {
        bindings.push(prior[key].clone());
    }
    for card in ["CTF-05", "CTF-06"] {
        bindings.push(prior["prior_scope_checks"][card].clone());
    }
    for binding in rows(&prior["historical_before_document_archives"])? {
        bindings.push(binding.clone());
    }
    for binding in rows(&prior["available_prior_frozen_document_archives"])? {
        bindings.push(binding["archive"].clone());
    }
    // Historical after-doc identities are documentary, never current07 live bindings.
'''.replace("VALUE", value)



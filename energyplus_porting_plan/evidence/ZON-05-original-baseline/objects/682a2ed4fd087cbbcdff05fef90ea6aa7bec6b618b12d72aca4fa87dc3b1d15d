"""Review actual RAD owner/serialization ledgers; no view-factor or warning evaluator."""
import re
import struct
from collections import Counter

LAYOUT = "actual Array2 row-first: F(j,i), flat offset (j-1)*N+(i-1)"
CLASSES = {"Wall": 1, "Floor": 2, "Roof": 3, "Ceiling": 3}


def review(result, request, need, bind):
    counts, statuses, constructors, seeds = Counter(), Counter(), Counter(), Counter()
    integrity = []

    def integer(value, low=0, high=None):
        need(type(value) is int and value >= low and (high is None or value <= high), "Typed actual integer required")

    def boolean(value):
        need(type(value) is bool, "Typed actual boolean required")

    def scalar(row):
        need(isinstance(row, dict) and set(row) == {"value", "value_bits", "value_class"}, "Complete actual scalar DTO required")
        bits = row["value_bits"]
        need(isinstance(bits, str) and re.fullmatch("[0-9a-f]{16}", bits), "Actual binary64 bits required")
        word = int(bits, 16)
        exponent, fraction, negative = (word >> 52) & 2047, word & ((1 << 52) - 1), bool(word >> 63)
        kind = ("nan" if fraction else "negative_infinity" if negative else "positive_infinity") if exponent == 2047 else (
            "negative_zero" if negative else "positive_zero") if word & ((1 << 63) - 1) == 0 else "finite"
        need(row["value_class"] == kind, "Actual class disagrees with copied bits")
        if exponent == 2047:
            need(row["value"] is None, "Nonfinite owner requires null decimal and retained bits/class")
        else:
            need(type(row["value"]) in (int, float) and struct.pack(">d", float(row["value"])).hex() == bits,
                 "Finite decimal serialization disagrees with copied bits")
        counts["scalar_DTO_visits"] += 1

    def outcome(row, allowed):
        need(isinstance(row, dict) and set(row) == {"status", "exception_type", "exception_message"} and
             row["status"] in allowed, "Genuine caught/source-stop outcome required")
        status = row["status"]
        if status in ["source_fatal", "source_exception"]:
            need(isinstance(row["exception_type"], str) and isinstance(row["exception_message"], str), "Actual caught exception metadata required")
        else:
            need(row["exception_type"] is None and row["exception_message"] is None, "Unassigned exception metadata must remain null")
        return status

    invoked_statuses = ["source_returned", "source_fatal", "source_exception", "source_nonstandard_exception"]
    need(len(result["model_cases"]) == len(request["model_cases"]), "Complete declared model ledger required")
    for declared, model in zip(request["model_cases"], result["model_cases"]):
        label = declared["id"]
        need(model["id"] == label and model["lane"] == declared["lane"] and model["declared_context"] == declared["context"],
             "Actual model identity/order/context differs")
        n = len(declared["surface_registry"])
        ctor = outcome(model["constructor_outcome"], invoked_statuses); constructors[ctor] += 1
        initialized = ctor == "source_returned"
        seed = model["member_seed_outcome"]
        if initialized:
            seed_status = outcome(seed, invoked_statuses); seeds[seed_status] += 1
        else:
            need(seed is None, "Uninvoked member seed must remain null")
            seed_status = None; seeds["source_not_invoked_after_constructor_stop"] += 1
        invoked = initialized and seed_status == "source_returned"
        boolean(model["actual_source_invoked"])
        need(model["actual_source_invoked"] is invoked, "Actual source invocation/seed custody differs")
        allowed = invoked_statuses if invoked else ["source_not_invoked_after_member_seed_stop" if initialized else
                                                   "source_not_invoked_after_constructor_stop"]
        status = outcome(model["call_outcome"], allowed); statuses[status] += 1
        snapshot = model["actual_input_snapshot"]
        expected_by_id = {row["surface_id"]: row for row in declared["surface_registry"]}
        expected_pointers = [expected_by_id[value]["native_surface_index"] for value in declared["surface_order"]]
        if invoked:
            need(isinstance(snapshot, dict) and snapshot["N"] == n and type(snapshot["N"]) is int and
                 snapshot["actual_zone_index"] == 1 and type(snapshot["actual_zone_index"]) is int and
                 snapshot["actual_zone_name"] == declared["context"]["zone_name"] and
                 snapshot["opaque_zone_id"] == declared["context"]["zone_id"] and
                 snapshot["declared_enclosure_index"] == declared["context"]["enclosure_index"] and
                 snapshot["geometry_loader_invoked"] is False and snapshot["Native_enclosure_owner_produced"] is False,
                 "Actual declared unit owners required; no production geometry claim")
            integer(snapshot["opaque_zone_id"], 0, 0xffffffff); integer(snapshot["declared_enclosure_index"], 0, 0xffffffff)
            need(len(snapshot["actual_surface_registry"]) == n and len(snapshot["actual_input_pointer_order"]) == n,
                 "Actual complete registry/SPtr input shape differs")
            for expected, actual in zip(declared["surface_registry"], snapshot["actual_surface_registry"]):
                integer(actual["opaque_surface_id"], 0, 0xffffffff); integer(actual["actual_surface_index"], 1, n)
                integer(actual["Zone"], 1, 1); integer(actual["Class"], 1, 3)
                need(actual["opaque_surface_id"] == expected["surface_id"] and actual["actual_surface_index"] == expected["native_surface_index"] and
                     actual["Name"] == expected["name"] and actual["Zone"] == 1 and actual["Class"] == CLASSES[expected["surface_type"]] and
                     actual["declared_surface_type"] == expected["surface_type"], "Actual seeded registry/class/ID order differs")
                for key, source in [("Area", "area_m2"), ("Azimuth", "azimuth_deg"), ("Tilt", "tilt_deg")]:
                    scalar(actual[key]); need(actual[key]["value_bits"] == expected[source]["bits"], "Actual registry input bits differ")
            for position, (opaque, actual) in enumerate(zip(declared["surface_order"], snapshot["actual_input_pointer_order"]), 1):
                expected = expected_by_id[opaque]
                integer(actual["source_surface_position"], 1, n); integer(actual["opaque_surface_id"], 0, 0xffffffff); integer(actual["SPtr"], 1, n)
                need(actual["source_surface_position"] == position and actual["opaque_surface_id"] == opaque and
                     actual["SPtr"] == expected["native_surface_index"], "Actual input SPtr association/order differs")
                for key, source in [("A", "area_m2"), ("Azimuth", "azimuth_deg"), ("Tilt", "tilt_deg")]:
                    scalar(actual[key]); need(actual[key]["value_bits"] == expected[source]["bits"], "Actual ordered source input bits differ")
            counts["actual_input_snapshots"] += 1
        else:
            need(snapshot is None, "Uncompleted seed must not invent an input snapshot")
        observed = model["observations"]
        for key in ["actual_zone_area_callback_count", "actual_matrix_callback_count", "actual_warning_callback_count",
                    "actual_diagnostic_callback_count", "omitted_warning_records", "omitted_diagnostic_records"]:
            integer(observed[key]); counts[key] += observed[key]
        failures = observed["failure_counts"]
        need(isinstance(failures, list) and len(failures) == 4, "Actual four typed observer failure sites required")
        for value in failures: integer(value)
        for key in ["observer_failure", "required_reached_owner_missing", "observation_integrity_failed"]: boolean(observed[key])
        need(observed["observer_failure"] is any(failures), "Actual failure-site aggregate differs")
        area, factors, pointers = observed["ZoneArea"], observed["F"], observed["actual_SPtr"]
        need(observed["F_layout"] == LAYOUT, "Actual destination-row/source-column layout differs")
        if area is not None:
            need(isinstance(area, list) and len(area) == n and observed["actual_zone_area_callback_count"] > 0,
                 "Actual ZoneArea owner/count/shape differs")
            for value in area: scalar(value)
        if pointers is not None:
            need(isinstance(pointers, list) and all(type(value) is int for value in pointers) and pointers == expected_pointers and
                 observed["actual_zone_area_callback_count"] > 0, "Actual copied SPtr owner differs")
        need((area is None) is (pointers is None), "Atomic ZoneArea/SPtr copy availability differs")
        if factors is not None:
            need(isinstance(factors, list) and len(factors) == n * n and observed["F_shape"] == [n, n] and
                 all(type(value) is int for value in observed["F_shape"]) and
                 observed["actual_matrix_callback_count"] > 0, "Actual matrix owner/count/shape differs")
            for value in factors: scalar(value)
        else:
            need(observed["F_shape"] is None, "Uncopied matrix shape must remain null")
        warning_rows, diagnostic_rows = observed["warnings"], observed["diagnostics"]
        need(isinstance(warning_rows, list) and isinstance(diagnostic_rows, list), "Actual retained diagnostic ledgers required")
        need(len(warning_rows) + observed["omitted_warning_records"] == observed["actual_warning_callback_count"] and
             len(diagnostic_rows) + observed["omitted_diagnostic_records"] == observed["actual_diagnostic_callback_count"],
             "Actual retained/omitted callback counts differ")
        previous_ordinal = previous_position = previous_end = 0
        for warning in warning_rows:
            integer(warning["actual_warning_callback_ordinal"], previous_ordinal + 1, observed["actual_warning_callback_count"])
            integer(warning["source_surface_position"], previous_position + 1, n)
            integer(warning["actual_diagnostic_end_exclusive"], previous_end, observed["actual_diagnostic_callback_count"])
            position = warning["source_surface_position"]
            expected = expected_by_id[declared["surface_order"][position - 1]]
            integer(warning["actual_surface_index"], 1, n); integer(warning["actual_zone_index"], 1, 1)
            need(warning["actual_surface_index"] == expected["native_surface_index"] and warning["actual_zone_index"] == 1 and
                 warning["surface_name"] == expected["name"] and warning["zone_name"] == declared["context"]["zone_name"],
                 "Actual reached warning owner association differs")
            scalar(warning["actual_seen_area"])
            if area is not None:
                need(warning["actual_seen_area"]["value_bits"] == area[position - 1]["value_bits"], "Actual warning/ZoneArea owner handoff differs")
            previous_ordinal, previous_position, previous_end = warning["actual_warning_callback_ordinal"], position, warning["actual_diagnostic_end_exclusive"]
        previous = 0
        for diagnostic in diagnostic_rows:
            integer(diagnostic["actual_callback_ordinal"], previous + 1, observed["actual_diagnostic_callback_count"])
            integer(diagnostic["actual_error_level"], -1)
            need(isinstance(diagnostic["message"], str), "Actual diagnostic text required")
            previous = diagnostic["actual_callback_ordinal"]
        if initialized:
            need(observed["err_stream"] is not None, "Actual installed Native stringstream log required")
            bind(observed["err_stream"]); integer(observed["actual_TotalWarningErrors"])
        else:
            need(observed["err_stream"] is None and observed["actual_TotalWarningErrors"] is None, "Unavailable Native state must retain null diagnostics owners")
        required_missing = status == "source_returned" and (observed["actual_zone_area_callback_count"] != 1 or
            observed["actual_matrix_callback_count"] != 1 or area is None or factors is None or pointers is None)
        need(observed["required_reached_owner_missing"] is required_missing, "Reached-required owner absence summary differs")
        failed = observed["observer_failure"] or required_missing or observed["omitted_warning_records"] != 0 or observed["omitted_diagnostic_records"] != 0
        need(observed["observation_integrity_failed"] is failed, "Actual observation integrity summary differs")
        if failed: integrity.append(label + "/observer-or-required-owner-integrity")
        if not invoked:
            need(area is None and factors is None and pointers is None and not warning_rows and
                 observed["actual_zone_area_callback_count"] == observed["actual_matrix_callback_count"] == observed["actual_warning_callback_count"] == 0,
                 "Uninvoked source must not invent calculation owners")
        counts["model_cases"] += 1
        counts["actual_source_invocations" if invoked else "actual_source_uninvoked"] += 1
        counts["returned_ZoneArea_owners"] += int(area is not None)
        counts["returned_F_owners"] += int(factors is not None)
        counts["retained_warning_records"] += len(warning_rows)
        counts["retained_diagnostic_records"] += len(diagnostic_rows)
    boolean(result["observer_integrity_failed"])
    need(result["observer_integrity_failed"] is bool(integrity), "Global actual integrity summary differs")
    integer(result["actual_source_invocations"])
    need(result["actual_source_invocations"] == counts["actual_source_invocations"] and result["actual_status_counts"] == dict(statuses),
         "Actual invocation/status counts differ from retained records")
    for value in result["actual_status_counts"].values(): integer(value)
    return {**dict(counts), "actual_source_status_counts": dict(statuses), "actual_constructor_status_counts": dict(constructors),
            "actual_member_seed_status_counts": dict(seeds)}, integrity

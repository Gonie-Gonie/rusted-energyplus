"""Narrow held quality-command custody repair, without target execution."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path
import shutil

ROOT = Path(__file__).resolve().parents[3]
PARENT = ROOT / '.runtime/porting/SRC-05/surface-environment-main-thread-prep-01'
PACKAGE = ROOT / '.runtime/porting/SRC-05/surface-environment-main-thread-prep-02'
OLD = ROOT / '.runtime/porting/SRC-05/surface-environment-selected-comparison-prep-04'
OUT = ROOT / '.runtime/porting/SRC-05/surface-environment-selected-comparison-prep-05'


def ref(path):
    data = path.read_bytes()
    return {'path':path.relative_to(ROOT).as_posix(),'sha256':hashlib.sha256(data).hexdigest(),
            'size_bytes':len(data),'line_count':len(data.splitlines())}


def dump(path,value):
    path.write_text(json.dumps(value,ensure_ascii=False,indent=2,allow_nan=False)+'\n',encoding='utf-8',newline='\n')


def delta(before,after,dest):
    dest.write_text(''.join(difflib.unified_diff(before.read_text(encoding='utf-8').splitlines(True),
        after.read_text(encoding='utf-8').splitlines(True),fromfile=before.relative_to(ROOT).as_posix(),
        tofile=after.relative_to(ROOT).as_posix())),encoding='utf-8',newline='\n')
    return ref(dest)


contracts = '''QUALITY_COMMANDS = {
    'fmt_check': ['cargo', 'fmt', '--all', '--', '--check'],
    'clippy': ['cargo', 'clippy'] + CONFIGS + ['--locked', '--workspace', '--all-targets', '--', '-D', 'warnings'],
    'focused': ['cargo', 'test'] + CONFIGS + ['--locked', '-p', 'ep_runtime', '--lib', 'heat_balance::'],
    'workspace': ['cargo', 'test'] + CONFIGS + ['--locked', '--workspace'],
}
'''
assert not PACKAGE.exists() and not OUT.exists()
for dest in [PACKAGE,OUT]:
    (dest/'before').mkdir(parents=True)
    (dest/'diffs').mkdir()
for name in ['manifest.json','run_main_thread.py','README.md']:
    shutil.copyfile(PARENT/name,PACKAGE/'before'/name)
text=(PARENT/'run_main_thread.py').read_text(encoding='utf-8')
anchor="CONFIGS = ['--config', 'profile.dev.debug=0', '--config', 'profile.test.debug=0', '--config', 'build.incremental=false']\n"
assert text.count(anchor)==1
text=text.replace(anchor,anchor+contracts)
anchor="    for row in quality.values():\n        recorded(row, source, recorder)\n"
assert text.count(anchor)==1
text=text.replace(anchor,"    for role, row in quality.items():\n        need(recorded(row, source, recorder)['command'] == QUALITY_COMMANDS[role], 'actual quality command differs: ' + role)\n")
(PACKAGE/'run_main_thread.py').write_text(text,encoding='utf-8',newline='\n')
readme=(PARENT/'README.md').read_text(encoding='utf-8')+'''

Narrow02 binds each runtime quality receipt to its genuine intended argv. Roles
cannot be satisfied by repeating one successful fmt receipt. Commands are exact
existing SRC05 quality02: cargo fmt --all -- --check; clippy with CONFIGS/--locked/
--workspace/--all-targets/--/-D warnings; focused test with CONFIGS/--locked/-p
ep_runtime/--lib/heat_balance::; workspace test with CONFIGS/--locked/--workspace.
Runtime full Source/chronology and four explicit receipt operands are preserved.
Rust/Cargo/lock/body/local audit and all mathematical policy stay literal01.
The actual Cargo manifest/main remain borrowed immutable01; only launcher02 is
new. No build, observation, new output read or canonical mutation occurred.
'''
(PACKAGE/'README.md').write_text(readme,encoding='utf-8',newline='\n')
for name in ['run_main_thread.py','README.md']:
    delta(PACKAGE/'before'/name,PACKAGE/name,PACKAGE/'diffs'/(name+'.from01.diff'))
manifest=json.loads((PARENT/'manifest.json').read_bytes())
manifest['accepted_parent']=ref(PARENT/'manifest.json')
manifest['runtime_interfaces']['launcher']=ref(PACKAGE/'run_main_thread.py')
manifest['runtime_interfaces']['required_quality_commands']={
    role:json.loads((ROOT/'.runtime/porting/SRC-05/surface-environment-quality-02'/name/'receipt.json').read_bytes())['command']
    for role,name in [('fmt_check','fmt-command'),('clippy','clippy-command'),('focused','focused-command'),('workspace','workspace-command')]}
manifest['quality_command_authorities']=[ref(ROOT/'.runtime/porting/SRC-05/surface-environment-quality-02'/name/'receipt.json')
    for name in ['fmt-command','clippy-command','focused-command','workspace-command']]
manifest['narrow_successor_before']=[ref(p) for p in sorted((PACKAGE/'before').iterdir())]
manifest['narrow_successor_diffs']=[ref(p) for p in sorted((PACKAGE/'diffs').iterdir())]
manifest['author_sources'].append(ref(Path(__file__)))
manifest['own_sources'] += [ref(p) for p in sorted(PACKAGE.rglob('*')) if p.is_file()]
dump(PACKAGE/'manifest.json',manifest)
for name in ['manifest.json','compare.py','policy.json','README.md']:
    shutil.copyfile(OLD/name,OUT/'before'/name)
text=(OLD/'compare.py').read_text(encoding='utf-8')
assert text.count(anchor)==0
text=text.replace("CONFIGS = ['--config', 'profile.dev.debug=0', '--config', 'profile.test.debug=0', '--config', 'build.incremental=false']\n",
    "CONFIGS = ['--config', 'profile.dev.debug=0', '--config', 'profile.test.debug=0', '--config', 'build.incremental=false']\n"+contracts)
anchor="    for row in packet['quality_executions'].values():\n        q = receipt(row,policy['recorder_source'])\n        need(q['source_snapshot'] == source and q['finished_utc'] <= build['started_utc'], 'quality/current Source/chronology differs')\n"
assert text.count(anchor)==1
text=text.replace(anchor,"    for role, row in packet['quality_executions'].items():\n        q = receipt(row,policy['recorder_source'])\n        need(q['command'] == QUALITY_COMMANDS[role], 'actual quality command differs: ' + role)\n        need(q['source_snapshot'] == source and q['finished_utc'] <= build['started_utc'], 'quality/current Source/chronology differs')\n")
(OUT/'compare.py').write_text(text,encoding='utf-8',newline='\n')
policy=json.loads((OLD/'policy.json').read_bytes())
policy['Rust_source_preparation']=ref(PACKAGE/'manifest.json')
dump(OUT/'policy.json',policy)
readme=(OLD/'README.md').read_text(encoding='utf-8')+'''

Narrow05 carries only the independently identified quality-command completeness
repair and standalone02 authority. Both launcher and comparer require each of
four exact genuine argv, so a copied fmt receipt cannot impersonate another role.
No scalar, route, input, endpoint/stop/unavailable logic or new outcome is changed.
All Rust main/Cargo/lock, old FAIL, and local precision Source bytes remain01.
'''
(OUT/'README.md').write_text(readme,encoding='utf-8',newline='\n')
for name in ['compare.py','policy.json','README.md']:
    delta(OUT/'before'/name,OUT/name,OUT/'diffs'/(name+'.from04.diff'))
parent=json.loads((OLD/'manifest.json').read_bytes())
parent['accepted_parent']=ref(OLD/'manifest.json')
parent['own_sources_and_metadata']=[ref(OUT/name) for name in ['compare.py','policy.json','README.md']]
parent['author']=ref(Path(__file__))
parent['before']=[ref(p) for p in sorted((OUT/'before').iterdir())]
parent['exact_diffs']=[ref(p) for p in sorted((OUT/'diffs').iterdir())]
parent['Rust_main_thread_preparation']=ref(PACKAGE/'manifest.json')
parent['quality_command_authorities']=manifest['quality_command_authorities']
dump(OUT/'manifest.json',parent)
for path in [PACKAGE/'run_main_thread.py',OUT/'compare.py']:
    ast.parse(path.read_text(encoding='utf-8'))
old_ast={n.name:ast.dump(n,include_attributes=False) for n in ast.parse((OLD/'compare.py').read_text(encoding='utf-8')).body if isinstance(n,ast.FunctionDef)}
new_ast={n.name:ast.dump(n,include_attributes=False) for n in ast.parse(text).body if isinstance(n,ast.FunctionDef)}
assert all(new_ast[name]==body for name,body in old_ast.items() if name!='main_thread_rust_custody')
print(json.dumps({'standalone':ref(PACKAGE/'manifest.json'),'comparer':ref(OUT/'manifest.json')}))

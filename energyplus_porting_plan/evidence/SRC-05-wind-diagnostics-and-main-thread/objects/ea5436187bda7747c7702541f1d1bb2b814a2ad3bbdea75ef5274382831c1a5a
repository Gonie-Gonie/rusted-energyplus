def ref(path):
    with path.open('rb') as stream: digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=digest, size_bytes=path.stat().st_size)


def checked(row, retain=True):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT) and path.suffix.lower() not in EXCLUDED
    actual = ref(path)
    assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes'])
    SEEN[path] = actual
    if retain: SELECTED[path] = actual
    return path


def load(row):
    return json.loads(checked(row).read_bytes())


def operand(text):
    path, digest = text.rsplit('#', 1)
    return ref(checked(dict(path=path, sha256=digest)))


def selected_refs(value):
    if isinstance(value, dict):
        if {'path', 'sha256', 'start_line', 'end_line', 'literal_archive'} <= value.keys():
            literal = checked(value['literal_archive']).read_bytes()
            assert hashlib.sha256(literal).hexdigest() == value['sha256'] and len(literal) == value['size_bytes']
            if value['path'].startswith(('.runtime/', '.reference/', 'energyplus_porting_plan/evidence/')):
                source = checked(ref((ROOT / value['path']).resolve())).read_bytes().splitlines(True)
                start, end = value['start_line'], value['end_line']
                assert type(start) is int and type(end) is int and 1 <= start <= end <= len(source)
                assert b''.join(source[start - 1:end]) == literal
            return
        if 'path' in value and 'sha256' in value:
            path = Path(value['path'])
            if not path.is_absolute() and value['path'].startswith(('.runtime/', '.reference/', 'energyplus_porting_plan/evidence/')) and path.suffix.lower() not in EXCLUDED: checked(value)
        else:
            for child in value.values(): selected_refs(child)
    elif isinstance(value, list):
        for child in value: selected_refs(child)


def receipt(row, snapshot=None, exit_code=None):
    value = load(row)
    assert value['schema'] == 'recorded-porting-command.v1' and value['finished_utc'] and value['launch_error'] is None
    assert value['executed_launcher']['archive']['sha256'] == RECORDER_SHA
    for key in ('stdout', 'stderr', 'source_snapshot'): checked(value[key])
    checked(value['executed_launcher']['archive'])
    if snapshot is not None: assert value['source_snapshot'] == snapshot and value['source_bytes_match_before_and_after'] is True
    if exit_code is not None: assert value['exit_code'] == exit_code
    return value


def snapshot_rows(row):
    value = load(row)
    assert value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False
    rows = {item['historical_path']: item for item in value['files']}
    assert len(rows) == len(value['files'])
    for item in rows.values(): assert checked(item['archive'], retain=False).stat().st_size == item['size_bytes']
    return rows


def frozen_rows(before, after):
    old = {row['path']: {key: row[key] for key in ('path', 'sha256', 'size_bytes')} for row in before}
    new = {row['path']: {key: row[key] for key in ('path', 'sha256', 'size_bytes')} for row in after}
    assert len(old) == len(before) and len(new) == len(after) and all(new.get(path) == row for path, row in old.items())
    assert all(row.get('available', True) is True for row in after)
    return len(old), len(new)



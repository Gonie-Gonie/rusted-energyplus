"""Factual post-link custody only; no helper invocation or numerical claims."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-05/wind-pow-native-build-02'


def ref(path):
    with path.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return {'path': path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path),
            'sha256': digest, 'size_bytes': path.stat().st_size}


def read(path):
    return json.loads(path.read_bytes())


inventory_path = OUT / 'linked-provider-and-PE-inventory.json'
inventory = read(inventory_path)
snapshot = inventory['Source_snapshot']
roles = ['configure-command', 'dry-verbose-command', 'compile-command', 'core-after-command',
         'collect-evidence-command', 'provider-addr2line-command', 'setter-disassembly-command',
         'pow-disassembly-command', 'extended-pow-disassembly-command', 'rounding-disassembly-command',
         'fpreset-disassembly-command']
receipts = {}
for role in roles:
    path = OUT / role / 'receipt.json'
    row = read(path)
    assert row['schema'] == 'recorded-porting-command.v1' and row['exit_code'] == 0
    assert row['source_bytes_match_before_and_after'] is True and row['launch_error'] is None
    assert row['source_snapshot'] == snapshot
    for key in ['stdout', 'stderr']:
        assert ref(ROOT / row[key]['path'])['sha256'] == row[key]['sha256']
    assert (ROOT / row['stderr']['path']).stat().st_size == 0
    receipts[role] = ref(path)
steps = lambda path: [line.split('] ', 1)[1] for line in path.read_text(encoding='utf8').splitlines()
                      if line.startswith(('[1/2] ', '[2/2] '))]
dry, actual = [steps(OUT / role / 'stdout.log') for role in ['dry-verbose-command', 'compile-command']]
assert len(dry) == 2 and dry == actual
assert (ROOT / '.runtime/ep261-gcc13-o0/compile_commands.json').read_bytes() == (OUT / 'compile_commands.json.after').read_bytes()
for key in ['actual_Native_binary', 'actual_full_link_map', 'actual_helper_object']:
    declared = inventory[key]
    path = Path(declared['path'])
    if not path.is_absolute():
        path = ROOT / path
    assert ref(path) == declared
setter = (OUT / 'setter-disassembly-command/stdout.log').read_text(encoding='utf8')
pow_body = (OUT / 'pow-disassembly-command/stdout.log').read_text(encoding='utf8')
extended = (OUT / 'extended-pow-disassembly-command/stdout.log').read_text(encoding='utf8')
fpreset = (OUT / 'fpreset-disassembly-command/stdout.log').read_text(encoding='utf8')
assert setter.count('call   141ab8e36 <pow>') == 2
assert 'call   141abf2c0 <log2l>' in pow_body and 'call   141abf1e0 <exp2l>' in pow_body and 'fmulp' in pow_body
assert 'fnstcw' in extended and extended.count('fldcw') == 2 and 'fninit' in fpreset
path = OUT / 'actual-link-custody-review.json'
assert not path.exists()
review = {'schema': 'src05-wind-pow-post-link-factual-custody-review.v1',
          'actual_provider_and_PE_inventory': ref(inventory_path), 'actual_receipts': receipts,
          'actual_Root_dry_review': ref(OUT / 'Root-full-dry-review.json'), 'Source_snapshot': snapshot,
          'dry_and_actual_compile_link_commands_byte_exact': True, 'current_compile_graph_equals_configured_after_archive': True,
          'full_binary_map_and_object_rehashed_after_all_read_only_tools': True,
          'genuine_setter_calls_selected_pow_twice': True,
          'selected_pow_calls_selected_log2l_then_extended_multiply_then_selected_exp2l': True,
          'selected_exp2l_temporarily_changes_rounding_control_and_restores_saved_word': True,
          'CRT_fp10_selected_fpreset_contains_FNINIT': True,
          'actual_review_source': ref(Path(__file__)),
          'helper_executed': False, 'numerical_results_read': False, 'historical_controls_reconstructed': False,
          'thread_precision_hypothesis_established': False, 'production_math_changed': False,
          'Root_FULL_provider_and_PE_acceptance_required_before_helper_execution': True, 'gates_updated': False}
path.write_text(json.dumps(review, ensure_ascii=False, allow_nan=False, indent=2) + '\n', encoding='utf8', newline='\n')
print(json.dumps(ref(path)))

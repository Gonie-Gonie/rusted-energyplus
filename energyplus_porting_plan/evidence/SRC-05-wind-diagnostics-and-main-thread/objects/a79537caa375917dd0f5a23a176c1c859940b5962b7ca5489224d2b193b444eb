// Diagnostic only: genuine core setter plus separately labelled primitive stages.
#include "surface_environment_reference_fields.hh"
#include <cfenv>
#include <exception>
#include <fstream>
#include <iostream>
#include <memory>
#include <set>
#include <stdexcept>
#include <thread>

#if defined(__OPTIMIZE__)
#error "The stage/control diagnostic requires unoptimized observation code"
#endif

namespace {
using Src05::json;
void require(bool condition, char const *message)
{
    if (!condition) throw std::runtime_error(message);
}
void keys(json const &value, std::initializer_list<char const *> names)
{
    require(value.is_object() && value.size() == names.size(), "Exact input object required");
    for (auto name : names) require(value.contains(name), "Missing literal input field");
}
double input(json const &value)
{
    keys(value, {"bits"});
    auto token = value.at("bits").get<std::string>();
    require(token.size() == 16 && token.find_first_not_of("0123456789abcdef") == std::string::npos, "Canonical IEEE bits required");
    return std::bit_cast<double>(static_cast<std::uint64_t>(std::stoull(token, nullptr, 16)));
}
[[gnu::noinline]] json controls()
{
    std::uint16_t cw = 0;
    std::uint32_t mxcsr = 0;
    // Read only. No rounding, exception, denormal or precision control is written.
    __asm__ __volatile__("fnstcw %0" : "=m"(cw));
    __asm__ __volatile__("stmxcsr %0" : "=m"(mxcsr));
    return {{"x87_control_word", cw}, {"MXCSR", mxcsr}, {"c_fegetround", std::fegetround()},
            {"x87_rounding_control_bits", (cw >> 10) & 3}, {"SSE_rounding_control_bits", (mxcsr >> 13) & 3}};
}
template<class Function> [[gnu::noinline]] double observe(json &stages, char const *name, Function const &function)
{
    auto before = controls();
    double value = function();
    auto after = controls();
    stages.push_back({{"stage", name}, {"controls_before", before}, {"controls_after", after}, {"result", Src05::scalar(value)}});
    return value;
}
json lane(json const &request, char const *name)
{
    auto entry = controls();
    json rows = json::array();
    for (auto const &row : request.at("cases")) {
        keys(row, {"case_id", "purpose", "operands"});
        auto const &o = row.at("operands");
        keys(o, {"WindSpeed", "WeatherFileWindModCoeff", "SiteWindBLHeight", "SiteWindExp", "Centroid_z"});
        double wind = input(o.at("WindSpeed")), modifier = input(o.at("WeatherFileWindModCoeff"));
        double bl = input(o.at("SiteWindBLHeight")), exponent = input(o.at("SiteWindExp")), z = input(o.at("Centroid_z"));
        json stages = json::array();
        auto product = observe(stages, "wind_times_modifier", [&] { return wind * modifier; });
        auto bl_power = observe(stages, "BL_pow_negative_exponent", [&] { return std::pow(bl, -exponent); });
        auto fac = observe(stages, "fac", [&] { return product * bl_power; });
        auto z_power = observe(stages, "Z_pow_exponent", [&] { return std::pow(z, exponent); });
        observe(stages, "diagnostic_fac_times_Z_power", [&] { return fac * z_power; });
        auto state = std::make_unique<EnergyPlus::EnergyPlusData>();
        state->dataEnvrn->WindSpeed = wind;
        state->dataEnvrn->WeatherFileWindModCoeff = modifier;
        state->dataEnvrn->SiteWindBLHeight = bl;
        state->dataEnvrn->SiteWindExp = exponent;
        state->dataSurface->TotSurfaces = 1;
        state->dataSurface->Surface.allocate(1);
        state->dataSurface->SurfOutWindSpeed.allocate(1);
        state->dataSurface->Surface(1).Centroid.z = z;
        state->dataSurface->Surface(1).ExtWind = true;
        state->dataSurface->SurfOutWindSpeed(1) = 14.0;
        observe(stages, "Native_SetSurfaceWindSpeedAt", [&] {
            EnergyPlus::DataSurfaces::SetSurfaceWindSpeedAt(*state);
            return state->dataSurface->SurfOutWindSpeed(1);
        });
        rows.push_back({{"literal_input", row}, {"stages", stages}, {"diagnostic_stages_are_Original_internal_locals", false},
                        {"genuine_setter_surface_count", 1}, {"genuine_setter_ExtWind", true}, {"incoming_wind_owner", Src05::scalar(14.0)}});
    }
    return {{"lane", name}, {"entry_controls", entry}, {"rows", rows}, {"exit_controls", controls()}};
}
} // namespace
int main(int argc, char const *argv[])
{
    try {
        require(argc == 2, "Usage: src05_wind_pow_helper <input-only.json>");
        std::ifstream stream(argv[1]); require(stream.is_open(), "Input file unavailable");
        auto request = json::parse(stream);
        keys(request, {"schema", "expected_values_supplied", "diagnostic_only", "cases"});
        require(request.at("schema") == "src05-wind-pow-diagnostic-request.v1" && request.at("expected_values_supplied") == false &&
                request.at("diagnostic_only") == true, "Unadmitted diagnostic request");
        require(request.at("cases").is_array() && !request.at("cases").empty(), "Ordered literal cases required");
        std::set<std::string> ids;
        for (auto const &row : request.at("cases")) require(ids.insert(row.at("case_id").get<std::string>()).second, "Duplicate case ID");
        auto main_lane = lane(request, "main_thread");
        json worker_lane;
        std::exception_ptr worker_error;
        std::thread worker([&] {
            try { worker_lane = lane(request, "std_thread_spawn"); }
            catch (...) { worker_error = std::current_exception(); }
        });
        worker.join();
        if (worker_error) std::rethrow_exception(worker_error);
        std::cout << json{{"schema", "src05-wind-pow-diagnostic-results.v1"}, {"implementation", "Native"},
                          {"lanes", json::array({main_lane, worker_lane})}, {"expected_values_supplied", false},
                          {"floating_point_controls_written", false}, {"historical_execution_controls_observed", false},
                          {"scientific_PASS_claimed", false}, {"production_math_changed", false}, {"gates_updated", false}}.dump() << '\n';
        return 0;
    } catch (std::exception const &error) {
        std::cerr << error.what() << '\n';
        return 2;
    }
}

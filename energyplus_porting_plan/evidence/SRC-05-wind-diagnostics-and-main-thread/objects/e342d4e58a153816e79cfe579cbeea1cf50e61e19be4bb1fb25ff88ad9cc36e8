import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[3]
TOOLS = ROOT / '.runtime/reference-tools/winlibs-gcc13.2.0-ucrt-r3/mingw64/bin'
sys.path.insert(0, str(ROOT / 'tools/porting'))
import native_pe


def full(path):
    path = path.resolve()
    with path.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return {'path': path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path),
            'sha256': digest, 'size_bytes': path.stat().st_size}


def location(value):
    path = Path(value)
    return path.resolve() if path.is_absolute() else (ROOT / path).resolve()


def exact(row):
    actual = full(location(row['path']))
    assert actual['sha256'] == row['sha256']
    assert 'size_bytes' not in row or actual['size_bytes'] == row['size_bytes']
    return location(row['path'])


def operand(value):
    path, digest = value.rsplit('#', 1)
    assert re.fullmatch('[0-9a-f]{64}', digest)
    result = full(location(path))
    assert result['sha256'] == digest
    return result


def read(row):
    return json.loads(exact(row).read_bytes())


def dump(path, value):
    assert not path.exists()
    path.write_text(json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n', encoding='utf8', newline='\n')



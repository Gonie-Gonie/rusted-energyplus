"""Preserve the first genuine ordinary history comparison, including its FAIL."""
import copy
import gzip
import hashlib
import json
from pathlib import Path
import re
import shutil
import subprocess

ROOT = Path.cwd()
RAW = ROOT / '.runtime/porting/CTF-10'
OUT = ROOT / 'energyplus_porting_plan/evidence/CTF-10-ordinary-history-comparison'


def ref(path):
    with path.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest, 'size_bytes': path.stat().st_size}


def load(path):
    return json.loads(path.read_bytes())


def dump(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n', encoding='utf8', newline='\n')


assert not OUT.exists()
report_path = RAW / 'ordinary-history-comparison-01/comparison.json'
report = load(report_path)
assert ref(report_path)['sha256'] == '82c5e4c775c7ed780d2450d9262a8470ca490482069e34a8b665ceee2a7c2ba8'
assert report['status'] == 'fail-retained-mismatch-or-required-unavailable'
assert report['stream_custody_failure'] is None
assert report['all_unmatched_and_mismatches_retained_without_cap'] is True
assert report['comparison_counts'] == {'exact_observations': 1978267, 'mismatches': 35031}
assert report['boundary_counts']['paired_stages'] == 192
assert report['boundary_counts']['required_unavailable_or_unmatched'] == 3898
assert report['actual_Source_snapshot']['sha256'] == 'e2dd7f51e2eda2899f028f281cbbb9d9d58690486754cc44c44c383101adf255'
for flag in ['selected_paired_boundary_comparison_passed', 'Native_only_context_or_Rust_generation_counted_as_PASS', 'inside_equation_per_iteration_PASS_claimed', 'whole_manager_PASS_claimed', 'integration_PASS_claimed', 'full_card_gates_updated']:
    assert report[flag] is False
execution_path = RAW / 'ordinary-history-comparison-command-01/receipt.json'
execution = load(execution_path)
assert ref(execution_path)['sha256'] == 'eb3e01e8f271928323f0f0bdbbbbd3fa8024b54a74d0352a64bacf6ca3af173c'
assert execution['exit_code'] == 1 and execution['source_bytes_match_before_and_after'] is True
ordinary_path = RAW / 'ordinary-history-invocation-03/ordinary-execution-command/receipt.json'
ordinary = load(ordinary_path)
assert ordinary['exit_code'] == 0 and ordinary['source_bytes_match_before_and_after'] is True
for value in [ordinary['source_snapshot'], execution['source_snapshot']]:
    assert all(value[key] == report['actual_Source_snapshot'][key] for key in ['path', 'sha256'])
assert ref(ROOT / report['actual_Source_snapshot']['path']) == report['actual_Source_snapshot']
for item in report['full_gzip_ledgers'].values():
    assert ref(ROOT / item['path']) == item
assert ref(ROOT / report['actual_Rust_events']['path']) == report['actual_Rust_events']
archive = RAW / 'ordinary-history-comparison-archive-01'
assert not archive.exists()
archive.mkdir()
rust_gzip = archive / 'events.ndjson.gz'
with (ROOT / report['actual_Rust_events']['path']).open('rb') as source, rust_gzip.open('xb') as target:
    with gzip.GzipFile(filename='', fileobj=target, mode='wb', mtime=0) as compressed:
        shutil.copyfileobj(source, compressed)
with gzip.open(rust_gzip, 'rb') as stream:
    assert hashlib.file_digest(stream, 'sha256').hexdigest() == report['actual_Rust_events']['sha256']
native_archive_path = ROOT / 'energyplus_porting_plan/evidence/CTF-10-surface-consumer05-original-baseline/objects/1127191a37e14cec2d068976dbf4a2bdfb654c3a0242950b85e3b963e19c9abe'
assert ref(native_archive_path)['sha256'] == native_archive_path.name
native_archive = load(native_archive_path)
native_gzip = ROOT / native_archive['stored']['path']
assert ref(native_gzip) == native_archive['stored']
assert native_archive['all_original_bytes_retained'] is True
assert native_archive['full_decompressed_sha256'] == 'eb344b4086531b636d5c701e454477248224aa5c30722e75a15eae0ef035e436'
selected = {Path(__file__).resolve(), rust_gzip, native_archive_path, RAW / 'ordinary-history-comparison-command-01-argv.json', RAW / 'ordinary-history-request-command-03-argv.json'}
for directory in ['ordinary-history-comparison-prep-01', 'ordinary-history-comparison-prep-02', 'ordinary-history-comparison-prep-03', 'ordinary-history-pairing-policy-prep-02', 'ordinary-history-invocation-prep-01', 'ordinary-history-comparison-01', 'ordinary-history-comparison-command-01', 'ordinary-history-invocation-03/ordinary-execution-command', 'ordinary-history-invocation-03/ordinary-output', 'ordinary-history-request-command-03', 'ordinary-history-directory-compression-command-03']:
    selected.update(p for p in (RAW / directory).rglob('*') if p.is_file() and '__pycache__' not in p.parts)
for filename in ['request.json', 'policy.json']:
    selected.add(RAW / 'ordinary-history-invocation-03' / filename)
stored = {}
for object_dir in (ROOT / 'energyplus_porting_plan/evidence').glob('*/objects'):
    for path in object_dir.iterdir():
        if path.is_file() and re.fullmatch('[0-9a-f]{64}', path.name):
            stored.setdefault(path.name, path)
OUT.mkdir()
(OUT / 'objects').mkdir()
rows = []
for path in sorted(selected):
    original = ref(path)
    target = stored.get(original['sha256'], OUT / 'objects' / original['sha256'])
    if not target.exists():
        shutil.copyfile(path, target)
    identity = ref(target)
    assert identity['sha256'] == original['sha256'] and identity['size_bytes'] == original['size_bytes']
    stored[original['sha256']] = target
    rows.append({'original': original, 'stored': identity})
summary_path = OUT / 'summary.json'
dump(summary_path, {'schema': 'ctf10-first-persistent-ordinary-history-comparison.v1',
    'status': report['status'], 'actual_comparison': ref(report_path), 'actual_comparison_execution': ref(execution_path),
    'actual_ordinary_execution': ref(ordinary_path), 'actual_Source_snapshot': report['actual_Source_snapshot'],
    'source_and_quality_summary': ref(ROOT / 'energyplus_porting_plan/evidence/CTF-10-ordinary-history-capture-source/entry-and-quality.json'),
    'actual_boundary_counts': report['boundary_counts'], 'actual_comparison_counts': report['comparison_counts'],
    'full_Rust_stream_gzip': {'compressed': ref(rust_gzip), 'decompressed': report['actual_Rust_events']},
    'previously_archived_full_Native_stream_gzip': ref(native_gzip), 'selected_objects': rows,
    'full_stream_custody_passed': True, 'all_unmatched_and_mismatches_retained_without_cap': True,
    'actual_ordinary_runtime_exit_code': 0, 'actual_ordinary_lifecycle_events': 578,
    'ordinary_numerical_comparison_passed': False, 'whole_manager_PASS_claimed': False, 'integration_PASS_claimed': False, 'card_gates_updated': False,
    'remaining_issues': ['Rust ordinary A currently skips warmup; Native warmup/kickoff selected boundaries remain unmatched or ambiguous.',
        'First Run step has first-time/start flag and selected outdoor weather owner differences.',
        'Copied history/report owners and finite arithmetic endpoints differ; successful process/IO is not numerical parity.']})
summary = ref(summary_path)
plan_path = ROOT / 'energyplus_porting_plan/plan.json'
plan = load(plan_path)
old_plan = copy.deepcopy(plan)
task = next(row for row in plan['tasks'] if row['id'] == 'CTF-10')
field = 'actual_persistent_ordinary_history_comparison'
assert field not in task
task[field] = summary
inverse = copy.deepcopy(plan)
del next(row for row in inverse['tasks'] if row['id'] == 'CTF-10')[field]
assert inverse == old_plan
dump(plan_path, plan)
card = ROOT / 'energyplus_porting_plan/cards/CTF-10.md'
with card.open('a', encoding='utf8', newline='\n') as stream:
    stream.write('\n## First genuine ordinary history comparison: retained FAIL\n\n')
    stream.write('Strict A/Deny ordinary execution exited0 and captured all578 observed lifecycle events. The frozen full-stream comparer exited1:192 paired stages,3,898 required unavailable/unmatched stages,1,978,267 exact observations and35,031 mismatches. Stream custody completed without truncation; every mismatch/unmatched stage and the full Rust stream are archived. Warmup/kickoff/start-flag and outdoor weather owner differences remain. No integration, equation-per-iteration, whole-manager or full-card PASS is claimed.\n')
    stream.write(f'Evidence: [retained ordinary comparison](../evidence/CTF-10-ordinary-history-comparison/summary.json) (`{summary["sha256"]}`).\n')
with (ROOT / 'energyplus_porting_plan/CHECKLIST.md').open('a', encoding='utf8', newline='\n') as stream:
    stream.write('\nCTF-10 genuine A ordinary history capture completed (578 events, runtime exit0); full comparison retained FAIL (192 paired stages,3,898 required unavailable/unmatched,35,031 mismatches). [Full evidence and remaining issues](evidence/CTF-10-ordinary-history-comparison/summary.json). Card gates remain unchanged.\n')
assert subprocess.run(['python', '-X', 'utf8', '-B', 'tools/porting/sync_plan_views.py', '--write']).returncode == 0
print(json.dumps({'summary': summary, 'archived_paths': len(rows), 'gates_changed': False}))

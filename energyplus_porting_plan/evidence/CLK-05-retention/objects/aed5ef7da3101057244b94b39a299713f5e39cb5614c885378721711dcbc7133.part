$ErrorActionPreference = 'Stop'
$workspacePath = (Get-Location).Path
if ($workspacePath -ne 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus') { throw 'Exact repository cwd required' }
$productsPath = (Resolve-Path -LiteralPath 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus\.runtime\ep261-gcc13-o0\Products').Path
$productsItem = Get-Item -LiteralPath $productsPath
if ($productsPath -ne 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus\.runtime\ep261-gcc13-o0\Products' -or ($productsItem.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Exact non-reparse Products directory required' }
$targetPath = (Resolve-Path -LiteralPath 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus\.runtime\ep261-gcc13-o0\Products\clk05_reference_helper.exe').Path
$targetItem = Get-Item -LiteralPath $targetPath
if ($targetItem.PSIsContainer -or ($targetItem.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Regular non-reparse file required' }
if ([IO.Path]::GetDirectoryName($targetPath) -ne $productsPath -or $targetItem.Name -ne 'clk05_reference_helper.exe') { throw 'Target outside exact Products file' }
if ($targetItem.Length -ne 1296986812 -or (Get-FileHash -LiteralPath $targetPath -Algorithm SHA256).Hash.ToLowerInvariant() -ne 'b1e54c8f083b587d689bd97539db0f329a12227b87226c9070bd2065947d9bcc') { throw 'Actual pre-action file identity differs' }

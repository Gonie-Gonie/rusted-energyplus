# Add one direct selected R format TU; retain the explicit actual inherited registration chain.
if(NOT DEFINED CLK03_REPOSITORY_ROOT OR NOT DEFINED SOURCE_ROUND_FORMAT_SOURCE_DIR OR NOT DEFINED SOURCE_ROUND_FORMAT_INHERITED_RECIPE)
  message(FATAL_ERROR "SOURCE_ROUND_FORMAT requires explicit repository and reviewed helper-source directories")
endif()
include("${SOURCE_ROUND_FORMAT_INHERITED_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_source_round_format_scheduled GLOBAL PROPERTY SOURCE_ROUND_FORMAT_REFERENCE_SCHEDULED)
  if(NOT _source_round_format_scheduled)
    set_property(GLOBAL PROPERTY SOURCE_ROUND_FORMAT_REFERENCE_SCHEDULED TRUE)
    function(source_round_format_add_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "SOURCE_ROUND_FORMAT requires the verified unchanged Original GNU core archive")
      endif()
      get_target_property(_source_round_format_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_source_round_format_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      list(APPEND _source_round_format_defs ${_source_round_format_directory_defs})
      list(FILTER _source_round_format_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _source_round_format_defs)
      add_executable(source_round_format_unit_helper "${SOURCE_ROUND_FORMAT_SOURCE_DIR}/round_unit_helper.cpp")
      target_include_directories(source_round_format_unit_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${SOURCE_ROUND_FORMAT_SOURCE_DIR}")
      target_compile_definitions(source_round_format_unit_helper PRIVATE ${_source_round_format_defs})
      target_link_libraries(source_round_format_unit_helper PRIVATE energypluslib project_options project_fp_options project_warnings)
      target_compile_features(source_round_format_unit_helper PRIVATE cxx_std_20)
      target_link_options(source_round_format_unit_helper PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/source_round_format_unit_helper.map")
    endfunction()
    cmake_language(DEFER CALL source_round_format_add_reference)
  endif()
endif()

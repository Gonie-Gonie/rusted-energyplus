"""Retain the rejected open-log publication and restore only its document edits."""
import gzip
import hashlib
import importlib.util
import json
from pathlib import Path
import subprocess

ROOT = Path.cwd().resolve()
OUT = ROOT / '.runtime/porting/SYS-03/round-format-publication-superseded-01'
EVIDENCE = ROOT / 'energyplus_porting_plan/evidence/SYS-03-round-format'
assert OUT.is_relative_to(ROOT) and EVIDENCE.is_relative_to(ROOT)
assert not OUT.exists() and EVIDENCE.is_dir()
assert subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip() == 'd0a33750848d360dfa674e55d9f6a000e90c7afd'
spec = importlib.util.spec_from_file_location('rec', ROOT / 'tools/porting/record_command.py')
rec = importlib.util.module_from_spec(spec)
spec.loader.exec_module(rec)
snapshot = dict(path='.runtime/porting/source-objects/56/5660999cac47deb982091970d2e19af4853b000515b541a5119a90e022f1c548', sha256='5660999cac47deb982091970d2e19af4853b000515b541a5119a90e022f1c548')
assert rec.snapshot_still_matches(snapshot)
summary_path = EVIDENCE / 'summary.json'
summary_ref = {**rec.ref(summary_path), 'size_bytes': summary_path.stat().st_size}
assert summary_ref['sha256'] == 'f87d57a30c1d710a703cd168e5a5fdbfff2df15ee4f7e95170e4fe491424d1e4'
summary = json.loads(summary_path.read_bytes())
bad = []
for row in summary['selected_objects']:
    original, stored = row['original'], row['stored']
    source = ROOT / original['path']
    copy = ROOT / stored['path']
    assert rec.sha(copy) == stored['sha256'] and copy.stat().st_size == stored['size_bytes']
    decoded = gzip.decompress(copy.read_bytes()) if row.get('encoding') == 'gzip' else copy.read_bytes()
    assert hashlib.sha256(decoded).hexdigest() == original['sha256'] and len(decoded) == original['size_bytes']
    if rec.sha(source) != original['sha256'] or source.stat().st_size != original['size_bytes']:
        bad.append(dict(captured_at_publication=original, actual_after_publication={**rec.ref(source), 'size_bytes': source.stat().st_size}))
assert len(bad) == 1
assert bad[0]['captured_at_publication']['path'] == '.runtime/porting/SYS-03/round-format-publication-command-01/stdout.log'
assert bad[0]['captured_at_publication']['size_bytes'] == 0 and bad[0]['actual_after_publication']['size_bytes'] == 436
publication = ROOT / '.runtime/porting/SYS-03/round-format-publication-command-01/receipt.json'
assert rec.sha(publication) == 'f6aecbf152ca0f839c161b714ec5dcbe6471b9735124c2d70ffe86c865892aa4'
paths = ['energyplus_porting_plan/plan.json', 'energyplus_porting_plan/CHECKLIST.md', 'energyplus_porting_plan/energyplus_porting_checklist.html', 'energyplus_porting_plan/cards/SYS-03.md']
before = {name: (ROOT / name).read_bytes() for name in paths}
plan = json.loads(before[paths[0]])
head_plan = json.loads(subprocess.check_output(['git', 'show', 'HEAD:' + paths[0]]))
assert next(task for task in plan['tasks'] if task['id'] == 'SYS-03').pop('actual_selected_R_format_comparison')['sha256'] == summary_ref['sha256']
assert plan == head_plan
OUT.mkdir()
for name, data in before.items():
    target = OUT / 'before-doc-reset' / name
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
review = dict(schema='source-round-format-publication-postcheck-failure.v1', rejected_publication_summary=summary_ref, closed_publication_receipt=rec.ref(publication), complete_retained_entries_verified=161, full_stored_archive_payloads_verified=True, postpublication_original_file_mismatches=bad, reason='Publisher selected its active recorder stdout before the final sync/print writes. Its empty snapshot is retained but cannot establish closed execution custody.', scientific_comparison_changed=False, numerical_results_remain_615_exact_texts=True, canonical_Source_unchanged=snapshot, gates_updated=False)
(OUT / 'Root-full-publication-failure-review.json').write_bytes(rec.json_bytes(review))
target = (OUT / 'evidence').resolve()
assert EVIDENCE.resolve().is_relative_to(ROOT) and target.is_relative_to(ROOT) and not target.exists()
EVIDENCE.rename(target)
for name in paths[:3]:
    assert (ROOT / name).read_bytes() == before[name]
    (ROOT / name).write_bytes(subprocess.check_output(['git', 'show', 'HEAD:' + name]))
card = ROOT / paths[3]
assert card.read_bytes() == before[paths[3]]
contract = ROOT / '.runtime/porting/source-objects/9b/9b58cc7d63529400112b88e98cd36c0f9c9f2ca4eb8de796cff1e4ed6f58ea48'
assert rec.sha(contract) == contract.name
card.write_bytes(contract.read_bytes())
assert rec.snapshot_still_matches(snapshot)
print(json.dumps(dict(retained_failed_publication=rec.ref(OUT / 'Root-full-publication-failure-review.json'), actual_archive_directory=target.as_posix(), restored_before_publication_card=rec.ref(card), Source_unchanged=True)))

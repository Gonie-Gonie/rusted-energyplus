    preparation = read(PREP / "manifest.json")
    for row in preparation["own_sources"]: exact(row["source"])
    for row in preparation["before_archives"][:4]: exact(row["original"])
    need(sha(BASE / "surface-consumer-native-prep-05/surface_consumer_reference.cmake") == "f6e5d4c4d03f0c1f5299a2e9c9f145083442ada92364750f6eac292584ac670e" and sha(BASE / "report-input-scan-native-prep-01/scan_unit_reference.cmake") == "76796e8cb4e6aa59a0d8cd2acbf243f9052c3c435713c5b7b168452fe0655d9d", "Accepted additive registration sources differ")
    need(sha(RECORDER) == "5745ad9809e196af00b858fcdc0d3d783531628fa2abf1e086f75c7d293514ba" and sha(DERIVE) == "3b39cc4562943692e43e11e4d2d7e1bc70f84a58e09c0fea28c0b85b8e905dcf", "Reviewed recorder/PE derivative Source differs")

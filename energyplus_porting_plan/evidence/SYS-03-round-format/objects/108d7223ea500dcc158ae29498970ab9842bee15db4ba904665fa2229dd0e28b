// Actual EnergyPlus IOFiles F/G formatting over independently supplied IEEE bits.
#include <EnergyPlus/IOFiles.hh>
#include <nlohmann/json.hpp>
#include <array>
#include <charconv>
#include <cstdint>
#include <cstring>
#include <fstream>
#include <iostream>
#include <initializer_list>
#include <set>
#include <stdexcept>
#include <string>
#include <typeinfo>

using json = nlohmann::json;
namespace {
void require(bool ok, char const *message) { if (!ok) { throw std::runtime_error(message); } }
void keys(json const &value, std::initializer_list<char const *> names)
{
    require(value.is_object() && value.size() == names.size(), "Exact typed input object required");
    for (auto const *name : names) { require(value.contains(name), "Missing input member"); }
}
double supplied_bits(std::string const &text)
{
    require(text.size() == 16, "Exact 16-digit IEEE input required");
    std::uint64_t raw = 0;
    auto const result = std::from_chars(text.data(), text.data() + text.size(), raw, 16);
    require(result.ec == std::errc{} && result.ptr == text.data() + text.size(), "Invalid IEEE input");
    static_assert(sizeof(raw) == sizeof(double));
    double value;
    std::memcpy(&value, &raw, sizeof(value));
    return value;
}
std::string actual_bits(double const &value)
{
    std::uint64_t raw; std::memcpy(&raw, &value, sizeof(raw));
    std::array<char, 16> text{};
    auto const result = std::to_chars(text.data(), text.data() + text.size(), raw, 16);
    require(result.ec == std::errc{}, "Actual IEEE copy failed");
    return std::string(16 - static_cast<std::size_t>(result.ptr - text.data()), '0') + std::string(text.data(), result.ptr);
}
} // namespace
int main(int argc, char const *argv[])
{
    try {
        require(argc == 2, "Usage: ctf10_report_format_unit_helper <input-only-request.json>");
        std::ifstream input(argv[1]); require(input.is_open(), "Input-only request unavailable");
        auto const request = json::parse(input);
        keys(request, {"schema", "card", "expected_values_supplied", "values", "formats"});
        require(request.at("schema") == "ctf10-report-format-unit-request.v1" && request.at("card") == "CTF-10" && request.at("expected_values_supplied") == false, "Unadmitted request");
        std::array<std::string, 8> const formats{"{:8.3F}", "{:8.4F}", "{:14.3F}", "{:11.3F}", "{:13.3F}", "{:15.4G}", "{:12.4G}", "{:20.8G}"};
        require(request.at("formats") == json(formats), "Exact eight Source report formats required");
        require(request.at("values").is_array() && !request.at("values").empty(), "Input-only values required");
        json rows = json::array(); std::set<std::string> ids; bool failure = false;
        for (auto const &row : request.at("values")) {
            keys(row, {"case_id", "value_bits"});
            auto const id = row.at("case_id").get<std::string>(); require(ids.insert(id).second, "Duplicate input identity");
            double const value = supplied_bits(row.at("value_bits").get<std::string>());
            json observations = json::array();
            for (auto const &format : formats) {
                json record{{"format", format}, {"actual_value_bits_before_call", actual_bits(value)}, {"actual_source_invoked", true}};
                try {
                    record["text"] = EnergyPlus::format(format, value);
                    record["outcome"] = "source_returned";
                    record["exception_type"] = nullptr; record["exception_message"] = nullptr;
                } catch (std::exception const &error) {
                    failure = true; record["text"] = nullptr; record["outcome"] = "source_exception";
                    record["exception_type"] = typeid(error).name(); record["exception_message"] = error.what();
                } catch (...) {
                    failure = true; record["text"] = nullptr; record["outcome"] = "source_nonstandard_exception";
                    record["exception_type"] = nullptr; record["exception_message"] = nullptr;
                }
                observations.push_back(record);
            }
            rows.push_back({{"case_id", id}, {"value_bits", row.at("value_bits")}, {"observations", observations}});
        }
        std::cout << json({{"schema", "ctf10-report-format-unit-native-results.v1"}, {"rows", rows},
            {"expected_values_supplied", false}, {"helper_PASS_claimed", false}, {"full_report_or_backend_equivalence_claimed", false}}).dump() << '\n';
        return failure ? 2 : 0;
    } catch (std::exception const &error) { std::cerr << error.what() << '\n'; return 2; }
}

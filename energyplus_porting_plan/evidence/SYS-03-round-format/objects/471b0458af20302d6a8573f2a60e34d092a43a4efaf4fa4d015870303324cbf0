"""Apply the reviewed R prerequisite after a genuinely captured Native baseline."""
import argparse
import difflib
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
spec = importlib.util.spec_from_file_location('recorder', ROOT / 'tools/porting/record_command.py')
rec = importlib.util.module_from_spec(spec)
spec.loader.exec_module(rec)
OUT = ROOT / '.runtime/porting/SYS-03/round-format-applied-01'


def checked(row):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT)
    data = path.read_bytes()
    assert rec.sha(path) == row['sha256'], row['path']
    assert 'size_bytes' not in row or len(data) == row['size_bytes']
    return data


def members(row):
    value = json.loads(checked(row))
    assert value['schema'] == 'rust-command-source-snapshot.v1'
    return {item['historical_path']: item['archive']['sha256'] for item in value['files']}


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--Native-baseline-review', required=True)
args = parser.parse_args()
name, digest = args.Native_baseline_review.rsplit('#', 1)
baseline_ref = dict(path=name, sha256=digest)
baseline = json.loads(checked(baseline_ref))
assert baseline['schema'] == 'source-round-format-Root-Native-baseline-review.v1'
assert baseline['genuine_Native_baseline_before_canonical_Rust_application'] is True
assert baseline['full_input_and_call_continuity_verified'] is True
assert baseline['Native_actual_exit_code'] == 0
assert baseline['actual_value_rows'] == 124 and baseline['actual_invoked_calls'] == 615
assert baseline['explicit_uninvoked_positive_infinity_rows'] == 5
assert baseline['Root_FULL_inline_R_provider_and_PE_review_accepted'] is True
for key in ('Native_execution', 'Native_result', 'Native_execution_custody', 'Native_execution_build_inputs'):
    checked(baseline[key])
prep_ref = dict(path='.runtime/porting/SYS-03/round-format-prep-01/manifest.json', sha256='a14b80e8cf025727b8f18edbb0c47a7636420e992248aa249ff6542997f0e98a')
prep = json.loads(checked(prep_ref))
contract_ref = dict(path='.runtime/porting/SYS-03/round-format-application-prep-01/manifest.json', sha256='53e8fcb385b135931819ac61d37756dbcaca7df517ddf11fef4e854eff16ab08')
contract = json.loads(checked(contract_ref))
assert contract['formatter_preparation'] == prep_ref
card = contract['card']
assert checked(card['actual_before']) == checked(card['before_archive'])
checked(card['proposal'])
checked(card['exact_diff'])
application = prep['application']
assert len(application) == 5 and not OUT.exists()
for row in application:
    if row['new_destination_absent']:
        assert not (ROOT / row['canonical_path']).exists()
    else:
        assert checked(row['actual_before']) == checked(row['before_archive'])
    checked(row['proposal'])
    checked(row['exact_diff'])
before = rec.source_snapshot()
assert before['sha256'] == '371ee432d89384311dbe6c07f0d3beb8cb99cba51ab69d14a71b7a63ce0df6ea'
OUT.mkdir()
(ROOT / card['canonical_path']).write_bytes(checked(card['proposal']))
card_ref = rec.store_bytes(checked(card['proposal']))
for row in application:
    destination = ROOT / row['canonical_path']
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_bytes(checked(row['proposal']))
literal = rec.source_snapshot()
fmt_dir = '.runtime/porting/SYS-03/round-format-format-command-01'
assert subprocess.run([sys.executable, '-X', 'utf8', '-B', 'tools/porting/record_command.py', '--output-dir', fmt_dir, '--', 'cargo', 'fmt', '--all'], cwd=ROOT).returncode == 0
final = rec.source_snapshot()
fmt_ref = rec.ref(ROOT / fmt_dir / 'receipt.json')
assert json.loads(checked(fmt_ref))['source_snapshot'] == literal
old, current = members(before), members(final)
changed = {row['canonical_path'] for row in application}
assert current.keys() == old.keys() | {row['canonical_path'] for row in application if row['new_destination_absent']}
assert all(old[key] == current[key] for key in old.keys() - changed)
applied = []
for index, row in enumerate(application):
    destination = ROOT / row['canonical_path']
    data = destination.read_bytes()
    delta = ''.join(difflib.unified_diff(checked(row['proposal']).decode('utf-8').splitlines(True), data.decode('utf-8').splitlines(True), fromfile=row['proposal']['path'], tofile=row['canonical_path'])).encode('utf-8')
    path = OUT / f'formatter-{index + 1}.diff'
    path.write_bytes(delta)
    applied.append({**row, 'actual_final': {**rec.ref(destination), 'size_bytes': len(data)}, 'actual_final_archive': rec.store_bytes(data), 'actual_formatter_diff': {**rec.ref(path), 'size_bytes': len(delta)}})
record = dict(schema='source-round-format-actual-application.v1', source_preparation=prep_ref, reviewed_card_contract=contract_ref, genuine_Native_baseline_before_application=baseline_ref, card_contract_before_implementation=card_ref, source_before=before, source_literal=literal, source_final=final, source_file_count=len(current), unrelated_source_files_verified_byte_exact=len(old.keys() - changed), actual_format_receipt=fmt_ref, application=applied, numerical_comparison_performed=False, gates_updated=False)
(OUT / 'record.json').write_bytes(rec.json_bytes(record))
print(json.dumps(dict(record=rec.ref(OUT / 'record.json'), final_source=final, unrelated_files=record['unrelated_source_files_verified_byte_exact'])))

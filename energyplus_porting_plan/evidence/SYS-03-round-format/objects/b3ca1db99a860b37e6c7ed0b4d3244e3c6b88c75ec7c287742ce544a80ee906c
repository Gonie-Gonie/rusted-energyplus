include("${SOURCE_ROUND_FORMAT_REFERENCE_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  function(source_round_format_place_reference)
    if(NOT TARGET source_round_format_unit_helper OR NOT IS_DIRECTORY "${SOURCE_ROUND_FORMAT_OUTPUT_DIR}")
      message(FATAL_ERROR "Reviewed helper and prepared output directory required")
    endif()
    set_target_properties(source_round_format_unit_helper PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${SOURCE_ROUND_FORMAT_OUTPUT_DIR}")
    get_target_property(_source_round_format_link_options source_round_format_unit_helper LINK_OPTIONS)
    list(REMOVE_ITEM _source_round_format_link_options "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/source_round_format_unit_helper.map")
    set_property(TARGET source_round_format_unit_helper PROPERTY LINK_OPTIONS "${_source_round_format_link_options}")
    target_link_options(source_round_format_unit_helper PRIVATE "-Wl,-Map,${SOURCE_ROUND_FORMAT_OUTPUT_DIR}/source_round_format_unit_helper.map")
  endfunction()
  cmake_language(DEFER CALL source_round_format_place_reference)
endif()

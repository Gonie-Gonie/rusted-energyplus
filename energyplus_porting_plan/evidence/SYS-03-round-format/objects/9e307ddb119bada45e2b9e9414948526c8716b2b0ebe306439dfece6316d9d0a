def ref(path):
    with path.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest, 'size_bytes': path.stat().st_size}


def load(path):
    return json.loads(path.read_bytes())


def checked(row):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT) and ref(path)['sha256'] == row['sha256']
    assert 'size_bytes' not in row or path.stat().st_size == row['size_bytes']
    return path


def operand(text):
    name, digest = text.rsplit('#', 1)
    return checked({'path': name, 'sha256': digest})


def dump(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n', encoding='utf8', newline='\n')



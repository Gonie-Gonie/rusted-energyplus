def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}


def put(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data if isinstance(data, bytes) else data.encode('utf8'))
    return ref(path)


def one(text, before, after):
    assert text.count(before) == 1
    return text.replace(before, after)


def delta(path, before, after, old_label, new_label):
    value = ''.join(difflib.unified_diff(before.decode('utf8').splitlines(True), after.decode('utf8').splitlines(True), fromfile=old_label, tofile=new_label))
    return put(path, value)



impl PartialEq for WarmupOutputError {
    fn eq(&self, other: &Self) -> bool {
        use crate::heat_balance::error_backend::SourceErrorBackendFailure as B;
        let io_equal = |a: &std::io::Error, b: &std::io::Error| a.kind() == b.kind() && a.raw_os_error() == b.raw_os_error() && a.to_string() == b.to_string();
        match (self, other) {

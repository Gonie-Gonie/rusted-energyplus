struct Stop { bytes:Vec<u8>, remaining:usize }
impl Write for Stop {
    fn write(&mut self, bytes:&[u8])->io::Result<usize> {
        if self.remaining==0 {return Err(io::Error::other("authored actual diagnostic sink stop"));}
        let n=self.remaining.min(bytes.len());self.bytes.extend_from_slice(&bytes[..n]);self.remaining-=n;Ok(n)
    }
    fn flush(&mut self)->io::Result<()> {Ok(())}
}


/// Real post-thermal RecKeep call, before caller commit. Every Run step records.
pub(crate) fn record_completed_step(
    state: &mut HeatBalanceState, driver: Option<HeatBalanceWeatherDriver<'_>>,
    output: Option<&mut CtfInitializationContext<'_>>,
) -> Result<(), RuntimeError> {
    let current = view(driver)?;
    let stamp = clock(&current)?;
    let output = context(output)?;
    output.backend.state.warmup_flag = current.warmup_flag;
    let owner = state.warmup_convergence.as_mut().ok_or_else(|| unavailable("missing actual ordinary convergence owner"))?;
    if let Some(reason) = owner.unavailable_reason { return Err(unavailable(reason)); }
    let report = owner.report.as_mut().ok_or_else(|| unavailable("missing actual ordinary report allocation"))?;
    if owner.warmup_flag != current.warmup_flag || report.configuration.doing_sizing != output.backend.state.doing_sizing
        || report.configuration.environment_name != current.environment_name
        || report.configuration.run_period_environment != current.run_period_environment
        || owner.zones.len() != state.zones.len() {
        return Err(unavailable("ordinary report phase/environment/Zone owner mismatch"));
    }
    for (index, (zone, actual)) in owner.zones.iter_mut().zip(&state.zones).enumerate() {
        if zone.zone_id != actual.zone_id || zone.sensible_report_timestep.and_then(|step| step.checked_add(1)) != Some(state.timestep_index) {
            return Err(unavailable("ordinary RecKeep requires this actual timestep's accepted sensible report"));
        }
        let (heat, cool) = zone.air_system_sensible_rates_w.ok_or_else(|| unavailable("unobserved ordinary sensible rates"))?;
        let ztav = actual.zone_timestep_average_air_temperature_c;
        if !ztav.is_finite() || !heat.is_finite() || !cool.is_finite() || heat < 0.0 || cool < 0.0 {
            return Err(unavailable("nonfinite or negative ordinary Record operands"));
        }
        zone.record(ztav, heat, cool);
        report.record_zone(index, zone, current.warmup_flag, stamp, output.eio)?;
    }
    // Exact ManageHeatBalance suffix. Partial first-day samples never reach this.
    if !current.warmup_flag && current.end_day && stamp.day == 1 && !output.backend.state.doing_sizing {
        report.report(false, &owner.zones, output.eio)?;
    }
    Ok(())
}


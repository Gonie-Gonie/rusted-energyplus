custody_ref = full(OUT / 'comparison-custody.json')
code, compare_ref = recorded([sys.executable, '-X', 'utf8', '-B', str(checked(compare_source)), '--custody', custody_ref['path'] + '#' + custody_ref['sha256'], '--output-dir', COMPARE_OUT.relative_to(ROOT).as_posix()], OUT / 'comparison-command', applied['source_final'])
current_source(applied['source_final'])
assert all(full(path) == row for path, row in FROZEN.items())
write(OUT / 'workflow.json', dict(schema='sys02-selected-report-invocation.v1', frozen_inputs=full(OUT / 'frozen-inputs.json'), actual_Rust_launch=launch_ref, actual_Cargo_execution=packet['Rust_execution'], actual_execution_sidecar=sidecar_ref, actual_comparison_execution=compare_ref, actual_comparison_exit_code=code, actual_custody=custody_ref, actual_comparison=full(COMPARE_OUT / 'comparison.json'), full_frozen_artifacts_preserved=True, Native_replay_performed=False, ordinary_tests_or_execution_performed=False, numerical_PASS_claimed=False, gates_updated=False))

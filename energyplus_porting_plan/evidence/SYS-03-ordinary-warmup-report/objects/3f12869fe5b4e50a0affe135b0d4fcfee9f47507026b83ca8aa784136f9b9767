checked(policy['Rust_source_preparation']); checked(policy['Native_source_preparation']); checked(policy['literal_rate_bindings'])
assert full(RECORDER)['sha256'] == policy['recorder_source']['sha256'] == '5745ad9809e196af00b858fcdc0d3d783531628fa2abf1e086f75c7d293514ba'
checked(policy['recorder_source'])
assert full(LAUNCHER)['sha256'] == '7cd1403488fac0fbd730b353053150443ec4097888a23ec427ce3085f7adb688'
launcher_ref = full(LAUNCHER); checked(launcher_ref); checked(full(Path(__file__).resolve()))
members = current_source(applied['source_final'])
fmt = load(applied['actual_format_receipt'])
assert fmt['exit_code'] == 0 and fmt['command'] == ['cargo', 'fmt', '--all'] and fmt['source_snapshot'] == applied['source_literal']
rows = [r for r in applied['application'] if r['canonical_path'].endswith('.rs')]
assert len(applied['application']) == 20 and [r['canonical_path'] for r in rows] == policy['Rust_observer_source_paths']
actual_sources = []
for row, held in zip(rows, policy['Rust_reviewed_proposals']):
    assert row['proposal'] == held

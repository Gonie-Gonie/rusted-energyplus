code, launch_ref = recorded([sys.executable, '-X', 'utf8', '-B', str(LAUNCHER), str(input_path), str(output_path)], OUT / 'Rust-launch-command', applied['source_final'])
if code != 0:
    current_source(applied['source_final'])
    assert all(full(path) == row for path, row in FROZEN.items())
    write(OUT / 'failed-selected-execution.json', dict(actual_execution=launch_ref, actual_exit_code=code, comparison_invoked=False, ordinary_tests_invoked=False))

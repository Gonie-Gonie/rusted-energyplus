    assert checked(row['actual_final']).read_bytes() == after == checked(members[row['canonical_path']]['archive']).read_bytes()
    expected = ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=row['proposal']['path'], tofile=row['canonical_path'])).encode()

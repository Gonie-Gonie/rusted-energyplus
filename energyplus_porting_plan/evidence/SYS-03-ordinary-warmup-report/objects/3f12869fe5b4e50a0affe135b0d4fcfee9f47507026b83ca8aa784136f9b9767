ROOT = Path(__file__).resolve().parents[4]
OUT = ROOT / '.runtime/porting/SYS-02/report-observation-01'
COMPARE_OUT = ROOT / '.runtime/porting/SYS-02/report-comparison-01'
RECORDER = ROOT / 'tools/porting/record_command.py'
LAUNCHER = ROOT / '.runtime/porting/SYS-02/run-selected-observer-01.py'
COMPARER = ROOT / '.runtime/porting/SYS-02/warmup-selected-comparison-prep-03/manifest.json'
HISTORY = ROOT / '.runtime/porting/SYS-02/rolling-observation-01/comparison-custody.json'
FROZEN = {}


def full(path):
    with path.open('rb') as stream:
        sha = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path), sha256=sha, size_bytes=path.stat().st_size)


def checked(row, external_binary=False):
    path = (ROOT / row['path']).resolve()
    assert path.is_relative_to(ROOT) or (external_binary and Path(row['path']).is_absolute() and not str(path).startswith('\\\\') and path.suffix.lower() == '.exe')
    actual = full(path)
    assert actual['sha256'] == row['sha256'] and ('size_bytes' not in row or actual['size_bytes'] == row['size_bytes']), row['path']
    FROZEN[path] = actual
    return path


def operand(token):
    name, sha = token.rsplit('#', 1)
    return full(checked(dict(path=name, sha256=sha)))


def load(row):
    return json.loads(checked(row).read_bytes())


def write(path, value):
    with path.open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode())


def current_source(row):
    value = load(row)
    assert value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False
    members = {r['historical_path']: r for r in value['files']}
    paths = set((ROOT / 'crates').rglob('*.rs')) | set((ROOT / 'crates').rglob('Cargo.toml'))
    paths |= {ROOT / n for n in ('Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml') if (ROOT / n).is_file()}
    assert len(members) == len(value['files']) == 3928 and {p.relative_to(ROOT).as_posix() for p in paths} == set(members)
    for name, item in members.items():
        checked(item['archive'])
        checked(dict(path=name, sha256=item['archive']['sha256'], size_bytes=item['size_bytes']))
    return members


def recorded(command, directory, source):
    code = subprocess.run([sys.executable, '-X', 'utf8', '-B', str(RECORDER), '--output-dir', directory.relative_to(ROOT).as_posix(), '--', *command], cwd=ROOT).returncode
    row = full(directory / 'receipt.json')
    receipt = load(row)
    assert receipt['command'] == command and receipt['exit_code'] == code and receipt['source_snapshot'] == source and receipt['source_bytes_match_before_and_after'] is True
    assert receipt['launch_error'] is None
    checked(receipt['stdout']); checked(receipt['stderr'])
    assert checked(receipt['executed_launcher']['archive']).read_bytes() == RECORDER.read_bytes()
    return code, row


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--applied-record', required=True)
parser.add_argument('--formatter-acceptance', required=True)

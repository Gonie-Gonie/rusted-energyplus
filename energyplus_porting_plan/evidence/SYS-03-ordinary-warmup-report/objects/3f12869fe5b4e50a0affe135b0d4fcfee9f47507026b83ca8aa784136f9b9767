packet.update(prospective_policy=full(policy_path), Rust_input=full(input_path), Rust_launch_source=launcher_ref, actual_Rust_observer_sources=actual_sources, Root_and_other_author_FULL_formatter_correspondence_accepted=True, Root_and_other_author_FULL_build_fix_correspondence_accepted=True, actual_post_application_build_fixes=applied['actual_post_application_build_fixes'], source_correspondence_scope='accepted original formatter plus separately reviewed compile/lint fixes; no arithmetic, branch or output-order change', Root_reviewed_literal_environment_launcher=True, actual_ordinary_application=applied_ref, actual_formatter_acceptance=acceptance_ref)
checked(packet['Rust_input']); checked(packet['prospective_policy'])
frozen = dict(schema='sys02-selected-report-invocation-frozen-inputs.v1', actual_application=applied_ref, actual_formatter_acceptance=acceptance_ref, current_Source_snapshot=applied['source_final'], reviewed_comparer=comparer_ref, actual_comparer_source=compare_source, prospective_policy_source=policy_source, frozen_policy=packet['prospective_policy'], actual_Rust_input=packet['Rust_input'], actual_Rust_observer_sources=actual_sources, historical_Native_custody=full(HISTORY), historical_Native_artifacts={k: packet[k] for k in native_keys}, frozen_artifacts=list(FROZEN.values()), Native_replay_performed=False, ordinary_tests_or_execution_performed=False, gates_updated=False)
write(OUT / 'frozen-inputs.json', frozen)

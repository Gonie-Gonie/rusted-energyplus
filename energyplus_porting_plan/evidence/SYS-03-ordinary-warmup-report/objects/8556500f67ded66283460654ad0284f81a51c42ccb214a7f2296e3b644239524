+def native_report(snapshot, count, policy, time_steps_in_hour):
+    owner = snapshot['owner']
+    need(len(owner['zones']) == count, 'full Native report Zone names required')
+    names = [row['Name'] for row in owner['zones']]
+    configuration = {name: owner['configuration'][name] for name in ('RunPeriodEnvironment', 'EnvironmentName', 'ReportDetailedWarmupConvergence')}
+    configuration.update({name: owner['clock'][name] for name in ('DoingSizing', 'DoPureLoadCalc')})
+    need(isinstance(snapshot['eio'], str), 'complete actual Native EIO text required')
+    need(owner['clock']['TimeStepsInHour'] == time_steps_in_hour, 'actual Native report allocation clock differs')
+    return report_owners(owner, names, configuration, list(snapshot['eio'].encode('utf-8')), policy, time_steps_in_hour)
+
+
+def rust_report(snapshot, count, policy, time_steps_in_hour):
+    owner = snapshot['report_owners']
+    need(isinstance(owner, dict) and owner['schema'] == 'sys02-selected-warmup-report-owners.v1', 'actual retained Rust report owner required')
+    need(len(owner['zone_names']) == count and owner['Native_report_text_parity_claimed'] is False and owner['ordinary_report_caller_or_backend_PASS_claimed'] is False, 'selected report scope differs')
+    eio = owner['actual_report_EIO_bytes']
+    need(isinstance(eio, list) and all(type(v) is int and 0 <= v <= 255 for v in eio), 'complete actual Rust EIO bytes required')
+    need(bytes(eio).decode('utf-8') == owner['actual_report_EIO_utf8'], 'Rust EIO byte/text witness differs')
+    # No local-mean reconstruction: these real Rust locals have no Native snapshot owner.
+    need(isinstance(owner['unpaired_actual_Rust_local_summaries'], list), 'explicit unpaired local summary ledger required')
+    return report_owners(owner, owner['zone_names'], dict(owner['configuration']), eio, policy, time_steps_in_hour)
+

+def report_array(array, count, scratch=False):
+    need(type(array['allocated']) is bool and type(array['size']) is int and array['size'] == count, 'complete report array allocation required')
+    need(array['allocated'] is True and array['lower'] == 1 and array['upper'] == count, 'actual one-based report allocation/bounds differ')
+    available = array['values_available']
+    need(type(available) is bool and (available or scratch), 'only unwritten scratch may be unavailable')
+    if available:
+        need(isinstance(array['rows'], list) and len(array['rows']) == count, 'report array rows omitted')
+        need([r['actual_array_index'] for r in array['rows']] == list(range(1, count + 1)), 'report array order differs')
+        values = [scalar(r['value']) for r in array['rows']]
+    else:
+        need(array['rows'] is None, 'unavailable scratch values must not be supplied')
+        values = None
+    return {'allocated': array['allocated'], 'size': count, 'lower': array['lower'], 'upper': array['upper'],
+            'values_available': available, 'values': values}
+
+
+def report_matrix(array, zones, points):
+    need(array['allocated'] is True and type(array['size']) is int and array['size'] == zones * points, 'full report matrix allocation required')
+    need((array['lower1'], array['upper1'], array['lower2'], array['upper2']) == (1, zones, 1, points), 'actual report matrix extents differ')
+    need(len(array['rows']) == points and [r['actual_point_index'] for r in array['rows']] == list(range(1, points + 1)), 'full point-major report rows required')
+    values = []
+    for row in array['rows']:
+        need(len(row['zones']) == zones and [r['actual_zone_index'] for r in row['zones']] == list(range(1, zones + 1)), 'full ordered report Zone columns required')
+        values.append([scalar(r['value']) for r in row['zones']])
+    return {'allocated': array['allocated'], 'size': array['size'], 'lower1': array['lower1'], 'upper1': array['upper1'],
+            'lower2': array['lower2'], 'upper2': array['upper2'], 'values': values}
+
+
+def report_owners(owner, names, configuration, eio, policy, time_steps_in_hour):
+    need(type(owner['CountWarmupDayPoints']) is int and owner['CountWarmupDayPoints_available'] is True, 'actual report Count unavailable')
+    need(type(time_steps_in_hour) is int and time_steps_in_hour > 0, 'literal report allocation clock required')
+    points, zones = owner['arrays']['TempZoneRpt']['upper2'], len(names)
+    need(type(points) is int and points == time_steps_in_hour * 24, 'actual full report allocation differs from literal clock')
+    need(0 <= owner['CountWarmupDayPoints'] <= points, 'actual report Count outside allocation')
+    flags = {name: owner[name] for name in policy['report_header_fields']}
+    need(all(type(value) is bool for value in flags.values()), 'actual report header flags required')
+    result = {'zone_names': names, 'configuration': configuration, 'CountWarmupDayPoints': owner['CountWarmupDayPoints'],
+              'CountWarmupDayPoints_available': True, **flags, 'arrays': {}, 'actual_report_EIO_bytes': eio}
+    for name in policy['report_difference_fields']:
+        result['arrays'][name] = report_array(owner['arrays'][name], zones)
+    for name in policy['report_matrix_fields']:
+        result['arrays'][name] = report_matrix(owner['arrays'][name], zones, points)
+    for name in policy['report_scratch_fields']:
+        result['arrays'][name] = report_array(owner['arrays'][name], points, True)
+    return result
+

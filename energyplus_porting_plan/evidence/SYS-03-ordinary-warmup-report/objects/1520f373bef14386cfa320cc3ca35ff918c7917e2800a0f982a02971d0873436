"""Review a single test fixture input correction, then apply only on explicit Root invocation."""
import difflib
import hashlib
import importlib.util
import json
from pathlib import Path
import sys

ROOT = Path.cwd()
BASE = ROOT / '.runtime/porting/SYS-03'
PREP = BASE / 'ordinary-warmup-report-fixture-name-fix-prep-01'
OUT = BASE / 'ordinary-warmup-report-applied-03'
SEEN = set()

def ref(path):
    data = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data))

def check(row):
    path = ROOT / row['path']
    actual = ref(path)
    assert actual['sha256'] == row['sha256']
    assert 'size_bytes' not in row or row['size_bytes'] == actual['size_bytes']
    SEEN.add(path)
    return path

def collect(value):
    if isinstance(value, dict):
        if 'path' in value and 'sha256' in value: check(value)
        for child in value.values(): collect(child)
    elif isinstance(value, list):
        for child in value: collect(child)

manifest_ref = ref(PREP / 'manifest.json')
assert manifest_ref['sha256'] == '7910657aedc0ffc348022b7da0b3cb97a27fc5cedb3e8b0e54f6df55a092d2af'
manifest = json.loads(check(manifest_ref).read_bytes())
collect(manifest)
assert len(manifest['application']) == 1
row = manifest['application'][0]
old, proposed = [check(row[k]).read_bytes() for k in ('before_archive', 'proposal')]
assert old.count(b'cube_model()') == 1
assert proposed == old.replace(b'cube_model()', b'ctf_ordinary_output_test_model()', 1)
assert check(row['actual_before']).read_bytes() == old
diff = ''.join(difflib.unified_diff(old.decode().splitlines(True), proposed.decode().splitlines(True), fromfile=row['canonical_path'] + ' (actual D362 before)', tofile=row['canonical_path'] + ' (held fixture name correction)'))
assert diff == check(row['exact_diff']).read_text(encoding='utf8')
for item in manifest['source_context']['selected_ranges']:
    assert b''.join(check(item['source']).read_bytes().splitlines(True)[item['start_line'] - 1:item['end_line']]) == check(item['archive']).read_bytes()
review_path = PREP / 'Root-full-Source-review.json'
review = dict(schema='sys03-ordinary-fixture-name-Root-full-Source-review.v1', Source_preparation=manifest_ref, full_whole_refs_verified=len(SEEN), literal_ranges_verified=5, entire_38_line_test_and_context_read=True, exact_diff_regenerated=True, entire_file_single_token_inverse_verified=True, all_numeric_inputs_and_assertions_unchanged=True, production_Source_unchanged=True, actual_review_Source=ref(Path(__file__)), tests_executed=False)
if sys.argv[1:] == ['--review']:
    with review_path.open('x', encoding='utf8', newline='\n') as stream:
        json.dump(review, stream, ensure_ascii=False, indent=2, allow_nan=False); stream.write('\n')
    print(json.dumps(ref(review_path)))
    sys.exit(0)
assert sys.argv[1:] == ['--apply'] and json.loads(review_path.read_bytes()) == review
assert not OUT.exists()
spec = importlib.util.spec_from_file_location('reviewed_recorder', ROOT / 'tools/porting/record_command.py')
rec = importlib.util.module_from_spec(spec); spec.loader.exec_module(rec)
assert rec.sha(ROOT / 'tools/porting/record_command.py') == '5745ad9809e196af00b858fcdc0d3d783531628fa2abf1e086f75c7d293514ba'
before = rec.source_snapshot()
assert before == manifest['source_context']['current_Source_snapshot']
previous = json.loads(check(manifest['current_actual_application']).read_bytes())
assert previous['source_final'] == before
OUT.mkdir()
(ROOT / row['canonical_path']).write_bytes(proposed)
final = rec.source_snapshot()
old_files = {r['historical_path']: r['archive']['sha256'] for r in json.loads(check(before).read_bytes())['files']}
new_files = {r['historical_path']: r['archive']['sha256'] for r in json.loads(check(final).read_bytes())['files']}
assert len(old_files) == len(new_files) == 3928 and old_files.keys() == new_files.keys()
assert [name for name in old_files if old_files[name] != new_files[name]] == [row['canonical_path']]
rows = []
for index, original in enumerate(previous['application'], 1):
    path = ROOT / original['canonical_path']; data = path.read_bytes()
    delta = OUT / f'correspondence-{index}.diff'
    delta.write_bytes(''.join(difflib.unified_diff(check(original['proposal']).read_text(encoding='utf8').splitlines(True), data.decode().splitlines(True), fromfile=original['proposal']['path'], tofile=original['canonical_path'])).encode())
    rows.append({**original, 'actual_final': ref(path), 'actual_final_archive': rec.store_bytes(data), 'actual_formatter_diff': ref(delta), 'correspondence_scope': 'original reviewed literal proposal through formatter, separately reviewed compile/lint fixes and test-only fixture name correction'})
correction = {**row, 'actual_final': ref(ROOT / row['canonical_path']), 'actual_final_archive': rec.store_bytes(proposed)}
record = {**previous, 'previous_actual_application': manifest['current_actual_application'], 'selected_actual_application': manifest['current_actual_application'], 'source_final_before_test_fixture_correction': before, 'source_final': final, 'actual_post_application_fixture_name_fix': manifest_ref, 'Root_full_fixture_name_Source_review': ref(review_path), 'test_only_source_correction': [correction], 'all_other_3927_Source_files_preserved_during_test_fixture_correction': True, 'production_Source_changed_by_test_fixture_correction': False, 'historical_failed_workspace_preserved': manifest['actual_failure']['workspace_execution'], 'application': rows}
(OUT / 'record.json').write_bytes(rec.json_bytes(record))
print(json.dumps(dict(record=ref(OUT / 'record.json'), source_final=final)))

"""Prepare a custody-only successor for separately reviewed post-format build fixes."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
OLD = ROOT / '.runtime/porting/SYS-02/warmup-report-invocation-prep-01'
OUT = ROOT / '.runtime/porting/SYS-02/warmup-report-invocation-prep-02'
assert not OUT.exists()
OUT.mkdir()


def ref(p):
    data = p.read_bytes()
    return dict(path=p.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data))


source = (OLD / 'run_selected_report.py').read_text(encoding='utf8')
assert ref(OLD / 'run_selected_report.py')['sha256'] == 'c3f2e10d5db9d3e904bf26faaccc22f8dc39ce268cc50925b6dc662d50c1341c'
replacements = [
    ('ordinary-warmup-report-applied-01/record.json', 'ordinary-warmup-report-applied-02/record.json'),
    ("assert applied['source_before']['sha256']", "assert acceptance['Root_FULL_build_fix_correspondence_accepted'] is True and acceptance['Header_FULL_build_fix_correspondence_accepted'] is True\nassert applied['actual_post_application_build_fixes']['sha256'] == acceptance['actual_post_application_build_fixes']['sha256'] == 'ad3febbb71fa3ba8ba5d19e2bf9f830db4cad66303594a655908ad56fe794a7e'\nfixes = load(applied['actual_post_application_build_fixes'])\nassert len(fixes['application_sources']) == 2 and fixes['arithmetic_or_branch_or_output_order_changed'] is False\nchecked(applied['previous_actual_application'])\nchecked(fixes['previous_full_formatter_acceptance'])\nassert applied['arithmetic_or_branch_or_output_order_changed_by_build_fixes'] is False\npost_fmt = load(applied['actual_post_application_fix_format_receipt'])\nassert post_fmt['exit_code'] == 0 and post_fmt['command'] == ['cargo', 'fmt', '--all'] and post_fmt['source_snapshot'] == applied['post_application_fix_literal_Source']\nassert applied['source_before']['sha256']"),
    ('Root_and_other_author_FULL_formatter_correspondence_accepted=True, Root_reviewed_literal_environment_launcher=True', 'Root_and_other_author_FULL_formatter_correspondence_accepted=True, Root_and_other_author_FULL_build_fix_correspondence_accepted=True, actual_post_application_build_fixes=applied[\'actual_post_application_build_fixes\'], source_correspondence_scope=\'accepted original formatter plus separately reviewed compile/lint fixes; no arithmetic, branch or output-order change\', Root_reviewed_literal_environment_launcher=True'),
]
for before, after in replacements:
    assert source.count(before) == 1
    source = source.replace(before, after)
ast.parse(source)
target = OUT / 'run_selected_report.py'
target.write_text(source, encoding='utf8', newline='\n')
delta = ''.join(difflib.unified_diff((OLD / 'run_selected_report.py').read_text(encoding='utf8').splitlines(True), source.splitlines(True), fromfile=(OLD / 'run_selected_report.py').relative_to(ROOT).as_posix(), tofile=target.relative_to(ROOT).as_posix()))
(OUT / 'driver.diff').write_text(delta, encoding='utf8', newline='\n')
value = dict(schema='sys02-selected-report-invocation-Source-preparation.v2', parent=ref(OLD / 'manifest.json'), own_sources=[ref(target), ref(Path(__file__).resolve())], exact_parent_delta=ref(OUT / 'driver.diff'), actual_build_fix_preparation=ref(ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-build-fixes-prep-01/manifest.json'), schema_compatibility='original actual application and correspondence schemas retained; new fields explicitly retain separate compile-fix provenance', inherited_functions_AST_unchanged=True, comparison_Source_or_policy_changed=False, target_executed=False, canonical_Source_changed=False, gates_updated=False)
(OUT / 'manifest.json').write_text(json.dumps(value, indent=2) + '\n', encoding='utf8', newline='\n')
print(json.dumps(ref(OUT / 'manifest.json')))

"""Author ignored ordinaryA successor only after Root supplies settled Source/card."""
import argparse
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OLD = ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-prep-01'
OUT = ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-prep-02'
OLD_SHA = 'a0afa0f9ddd3054becf2ce147a06366345263cd2d26b2f8c34ef039cc0362018'


def exact(row):
    p = (ROOT / row['path']).resolve()
    assert p.is_relative_to(ROOT) and p.is_file()
    data = p.read_bytes()
    assert hashlib.sha256(data).hexdigest() == row['sha256']
    assert 'size_bytes' not in row or len(data) == row['size_bytes']
    return data


def ref(p):
    data = p.read_bytes()
    return {'path': p.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}


def operand(value):
    path, sha = value.rsplit('#', 1)
    row = {'path': path, 'sha256': sha}
    exact(row)
    return ref(ROOT / path)


def write(p, data):
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as stream:
        stream.write(data)
    return ref(p)


def delta(before, after, name):
    return ''.join(difflib.unified_diff(before.decode('utf-8').splitlines(keepends=True),
        after.decode('utf-8').splitlines(keepends=True), fromfile='before/' + name,
        tofile='proposed/' + name)).encode('utf-8')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--actual-R-application', required=True)
    parser.add_argument('--settled-Source-snapshot', required=True)
    parser.add_argument('--settled-card-sha256', required=True)
    args = parser.parse_args()
    assert not OUT.exists()
    previous = {'path': (OLD / 'manifest.json').relative_to(ROOT).as_posix(), 'sha256': OLD_SHA}
    before_manifest = exact(previous)
    old = json.loads(before_manifest)
    rref, snapshot_ref = operand(args.actual_R_application), operand(args.settled_Source_snapshot)
    applied, snapshot = json.loads(exact(rref)), json.loads(exact(snapshot_ref))
    assert applied['schema'] == 'source-round-format-actual-application.v1'
    assert applied['source_preparation']['sha256'] == old['required_shared_R_preparation']['sha256']
    assert applied['source_before']['sha256'] == old['actual_before_Source_snapshot']['sha256']
    assert applied['source_final']['sha256'] == snapshot_ref['sha256']
    old_snapshot = json.loads(exact(old['actual_before_Source_snapshot']))
    assert snapshot['schema'] == old_snapshot['schema'] == 'rust-command-source-snapshot.v1'
    assert snapshot['bytes_normalized'] is False
    old_members = {r['historical_path']: r for r in old_snapshot['files']}
    members = {r['historical_path']: r for r in snapshot['files']}
    assert len(members) == len(snapshot['files']) and not (set(old_members) - set(members))
    current_paths = set((ROOT / 'crates').rglob('*.rs')) | set((ROOT / 'crates').rglob('Cargo.toml'))
    current_paths.update(ROOT / name for name in ('Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml') if (ROOT / name).is_file())
    assert {p.relative_to(ROOT).as_posix() for p in current_paths} == set(members)
    changed = {p for p in members if p not in old_members or members[p]['archive']['sha256'] != old_members[p]['archive']['sha256']}
    assert changed == {r['canonical_path'] for r in applied['application']}
    for p, row in members.items():
        data = exact(row['archive'])
        assert len(data) == row['size_bytes'] and (ROOT / p).read_bytes() == data
    for row in applied['application']:
        assert exact(row['actual_final']) == exact(row['actual_final_archive']) == exact(members[row['canonical_path']]['archive'])
    card_row = next(r for r in old['application_sources'] if r['canonical_path'].endswith('/cards/SYS-03.md'))
    rust = [r for r in old['application_sources'] if r is not card_row]
    assert len(rust) == 19 and not (changed & {r['canonical_path'] for r in rust})
    for row in rust:
        for key in ('proposal', 'before_archive', 'exact_diff', 'held_report_parent_proposal', 'held_report_parent_exact_delta'):
            if key in row:
                exact(row[key])
        if row.get('actual_before') is None:
            assert row['new_destination_absent'] is True and not (ROOT / row['canonical_path']).exists()
        else:
            assert exact(row['actual_before']) == exact(row['before_archive'])
    old_card, old_proposal = exact(card_row['before_archive']), exact(card_row['proposal'])
    assert old_proposal.startswith(old_card)
    card = ROOT / card_row['canonical_path']
    current = exact({'path': card_row['canonical_path'], 'sha256': args.settled_card_sha256})
    suffix = old_proposal[len(old_card):]
    assert suffix and suffix not in current
    proposed = current + suffix
    new = copy.deepcopy(old)
    new['previous_Source_preparation'] = ref(OLD / 'manifest.json')
    new['actual_before_Source_snapshot'] = snapshot_ref
    new['actual_shared_R_application'] = rref
    new['historical_before_Source_snapshot'] = old['actual_before_Source_snapshot']
    new['rebase_scope'] = {'all_19_Rust_application_rows_byte_exact_01': True,
        'R_changed_owned_Rust_paths': [], 'all_current_Source_members_verified': len(members),
        'card_retains_settled_prefix_and_literal_01_ordinary_contract': True}
    new_card = {'canonical_path': card_row['canonical_path'], 'actual_before': ref(card),
        'before_archive': write(OUT / 'before' / card_row['canonical_path'], current),
        'proposal': write(OUT / 'proposed' / card_row['canonical_path'], proposed),
        'exact_diff': write(OUT / 'diffs' / (card_row['canonical_path'] + '.diff'), delta(current, proposed, card_row['canonical_path']))}
    new['application_sources'] = [new_card if r is card_row else r for r in old['application_sources']]
    assert [r for r in new['application_sources'] if r['canonical_path'].endswith('.rs')] == rust
    new['authentic_previous_manifest'] = write(OUT / 'before/manifest.json', before_manifest)
    new['authentic_previous_README'] = write(OUT / 'before/README.md', exact(old['README']))
    text = ('# Ordinary A warmup/report Source successor02\n\n'
        'This metadata/card rebase follows the actual shared R installation. All nineteen Rust application rows, proposals, before archives, cumulative diffs and six report-parent deltas are borrowed byte-exact from accepted01. The actual complete current Source snapshot and every current member are authenticated before sealing. None of the five R application paths is owned by ordinaryA.\n\n'
        'The sole new proposal is the SYS03 card: its settled current prefix is preserved and the exact ordinary contract suffix from01 is appended. Original Source ranges, prior author and report/R preparation descriptors remain historical authorities; the new author is recorded separately.\n\n'
        'No project import, formatter, build, test, scientific execution, canonical change or gate update is performed. Ordinary and selected report comparisons remain pending actual calls.\n').encode('utf-8')
    new['README'] = write(OUT / 'README.md', text)
    new['rebase_author_source'] = ref(Path(__file__))
    manifest = (json.dumps(new, indent=2, ensure_ascii=False) + '\n').encode('utf-8')
    write(OUT / 'manifest.json', manifest)
    write(OUT / 'manifest.diff', delta(before_manifest, manifest, 'manifest.json'))
    ast.parse(Path(__file__).read_text())
    print(json.dumps(ref(OUT / 'manifest.json')))


if __name__ == '__main__':
    main()

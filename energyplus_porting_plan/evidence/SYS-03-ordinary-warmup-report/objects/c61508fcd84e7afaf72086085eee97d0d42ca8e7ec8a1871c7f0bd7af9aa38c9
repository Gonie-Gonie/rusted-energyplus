    # No local-mean reconstruction: these real Rust locals have no Native snapshot owner.
    need(isinstance(owner['unpaired_actual_Rust_local_summaries'], list), 'explicit unpaired local summary ledger required')
    return report_owners(owner, owner['zone_names'], dict(owner['configuration']), eio, policy, time_steps_in_hour)



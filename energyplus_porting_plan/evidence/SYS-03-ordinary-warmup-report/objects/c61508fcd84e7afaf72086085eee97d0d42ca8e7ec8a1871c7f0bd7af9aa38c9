def exact(row):
    p = (ROOT / row['path']).resolve()
    assert p.is_relative_to(ROOT)
    data = p.read_bytes()
    assert hashlib.sha256(data).hexdigest() == row['sha256']
    assert 'size_bytes' not in row or len(data) == row['size_bytes']
    return data


def ref(p):
    data = p.read_bytes()
    return {'path': p.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}


def write(p, data):
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as stream:
        stream.write(data)
    return ref(p)


def delta(before, after, name):
    return ''.join(difflib.unified_diff(before.decode('utf-8').splitlines(keepends=True),
        after.decode('utf-8').splitlines(keepends=True), fromfile='before/' + name,
        tofile='proposed/' + name)).encode('utf-8')



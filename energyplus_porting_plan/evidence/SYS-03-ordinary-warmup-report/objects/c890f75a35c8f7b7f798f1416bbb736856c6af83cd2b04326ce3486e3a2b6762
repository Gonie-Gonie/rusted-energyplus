import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path
import shutil

ROOT = Path(__file__).resolve().parents[3]
OLD = ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-publication-prep-02'
OUT = ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-publication-prep-03'


def ref(path):
    b = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(b).hexdigest(), size_bytes=len(b), line_count=len(b.splitlines()))


def write(path, b):
    with path.open('xb') as stream: stream.write(b)


assert ref(OLD / 'manifest.json')['sha256'] == '057c1f5c2fbb837d88d690933973c2f60d298ae926619282f687dc4ba1d0bd97'
failure_path = ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-publication-command-01/receipt.json'
assert ref(failure_path)['sha256'] == '65e403e594660d28e33c87b4b0118347ea00b3ace5fabe4d6c60c1b76fcfc831'
failure = json.loads(failure_path.read_bytes())
assert failure['exit_code'] == 1 and failure['source_bytes_match_before_and_after'] is True
assert not (ROOT / 'energyplus_porting_plan/evidence/SYS-03-ordinary-warmup-report').exists()
OUT.mkdir(); (OUT / 'before').mkdir()
for name in ('publish.py', 'README.md', 'manifest.json'): shutil.copyfile(OLD / name, OUT / 'before' / name)
old = (OLD / 'publish.py').read_bytes()
anchor = b"    if isinstance(value, dict):\n        if 'path' in value and 'sha256' in value:\n"
replacement = b"""    if isinstance(value, dict):
        if {'path', 'sha256', 'start_line', 'end_line', 'literal_archive'} <= value.keys():
            literal = checked(value['literal_archive']).read_bytes()
            assert hashlib.sha256(literal).hexdigest() == value['sha256'] and len(literal) == value['size_bytes']
            if value['path'].startswith(('.runtime/', '.reference/', 'energyplus_porting_plan/evidence/')):
                source = checked(ref((ROOT / value['path']).resolve())).read_bytes().splitlines(True)
                start, end = value['start_line'], value['end_line']
                assert type(start) is int and type(end) is int and 1 <= start <= end <= len(source)
                assert b''.join(source[start - 1:end]) == literal
            return
        if 'path' in value and 'sha256' in value:
"""
assert old.count(anchor) == 1
new = old.replace(anchor, replacement)
assert new.replace(replacement, anchor) == old
write(OUT / 'publish.py', new)
readme = (OLD / 'README.md').read_text(encoding='utf8')
readme += '\nSuccessor03 recognizes typed Source range descriptors before whole-file refs: literal_archive SHA/size and the declared slice SHA/size must agree. For immutable Original/helper paths the exact physical-line slice is also verified against the whole Source, whose computed full ref and bytes are retained. Historical canonical Rust slice archives are authenticated without pretending their old line numbers refer to current canonical files. The failed publication01 receipt/logs remain immutable and the evidence directory was absent; no outcome, pairing or quality rule changes.\n'
write(OUT / 'README.md', readme.encode())
diffs = []
for name in ('publish.py', 'README.md'):
    before, after = OUT / 'before' / name, OUT / name
    delta = OUT / (name + '.narrow.diff')
    write(delta, ''.join(difflib.unified_diff(before.read_text(encoding='utf8').splitlines(True), after.read_text(encoding='utf8').splitlines(True), fromfile=before.relative_to(ROOT).as_posix(), tofile=after.relative_to(ROOT).as_posix())).encode())
    diffs.append(dict(before=ref(before), after=ref(after), exact_diff=ref(delta)))
manifest = copy.deepcopy(json.loads((OLD / 'manifest.json').read_bytes()))
manifest.update(own_sources=[ref(OUT / 'publish.py')], author=ref(Path(__file__)), README=ref(OUT / 'README.md'), predecessor_source_preparation=ref(OLD / 'manifest.json'), before_archives=[ref(OUT / 'before' / name) for name in ('publish.py', 'README.md', 'manifest.json')], narrow_exact_diffs=diffs, retained_failed_publication_execution=ref(failure_path))
manifest['source_dependencies'] += [ref(OLD / name) for name in ('manifest.json', 'publish.py', 'README.md')] + [ref(failure_path), failure['stdout'], failure['stderr']]
ast.parse(new); ast.parse(Path(__file__).read_bytes())
write(OUT / 'manifest.json', (json.dumps(manifest, ensure_ascii=False, indent=2) + '\n').encode())
print(json.dumps(ref(OUT / 'manifest.json')))

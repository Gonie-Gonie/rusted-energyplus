"""Seal four compile/lint corrections; do not apply or execute targets."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
OUT = ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-build-fixes-prep-01'
assert not OUT.exists()
OUT.mkdir()


def ref(p):
    data = p.read_bytes()
    return dict(path=p.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data))


def exact_replace(text, old, new):
    assert text.count(old) == 1, old
    return text.replace(old, new)


rows = []
for name in ('crates/ep_runtime/src/runtime.rs', 'crates/ep_runtime/src/runtime/tests/warmup_ordinary_reports.rs'):
    p = ROOT / name
    before = p.read_bytes()
    text = before.decode()
    if name.endswith('/runtime.rs'):
        text = exact_replace(text, 'fn simulate_heat_balance_zone_air_temperatures_internal(\n', '#[expect(\n    clippy::too_many_arguments,\n    reason = "Retain explicit source-order weather, coefficient and output owners"\n)]\nfn simulate_heat_balance_zone_air_temperatures_internal(\n')
        text = exact_replace(text, '        first_hour_interpolation_starting_values,\n        initialization.as_deref_mut(),\n    )?;', '        first_hour_interpolation_starting_values,\n        initialization,\n    )?;')
    else:
        text = exact_replace(text, '            simulate_heat_balance_zone_air_temperatures_with_production_weather_and_warmup_reporting(', '            crate::simulate_heat_balance_zone_air_temperatures_with_production_weather_and_warmup_reporting(')
        text = exact_replace(text, 'options,&mut context,HeatBalanceOrdinaryWarmupReportInputs {', 'options,&mut context,crate::HeatBalanceOrdinaryWarmupReportInputs {')
    old, new = OUT / 'before' / name, OUT / 'proposed' / name
    old.parent.mkdir(parents=True, exist_ok=True); new.parent.mkdir(parents=True, exist_ok=True)
    old.write_bytes(before); new.write_bytes(text.encode())
    delta = ''.join(difflib.unified_diff(before.decode().splitlines(True), text.splitlines(True), fromfile=name, tofile=new.relative_to(ROOT).as_posix())).encode()
    diff = OUT / (str(len(rows) + 1) + '.diff'); diff.write_bytes(delta)
    rows.append(dict(canonical_path=name, actual_before=ref(p), before_archive=ref(old), proposal=ref(new), exact_diff=ref(diff)))
manifest = dict(schema='sys03-ordinary-warmup-report-build-fixes-Source-preparation.v1', previous_actual_application=ref(ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-applied-01/record.json'), previous_full_formatter_acceptance=ref(ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-applied-01/Root-and-Header-full-formatter-review.json'), actual_failed_Clippy=ref(ROOT / '.runtime/porting/SYS-03/ordinary-warmup-report-quality-01/clippy-command/receipt.json'), source_before=dict(path='.runtime/porting/source-objects/52/52209e602618cddb36ffa879f7f3d97497dd7bcc2a85674a878f3a7b3bf19061', sha256='52209e602618cddb36ffa879f7f3d97497dd7bcc2a85674a878f3a7b3bf19061'), application_sources=rows, changes=['qualify two existing public reexports in included regression Source', 'move the final output owner instead of an unnecessary reborrow', 'expect the actual eight-owner private caller lint with a scoped reason'], arithmetic_or_branch_or_output_order_changed=False, production_target_executed=False, gates_updated=False, author=ref(Path(__file__).resolve()))
(OUT / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n', encoding='utf8', newline='\n')

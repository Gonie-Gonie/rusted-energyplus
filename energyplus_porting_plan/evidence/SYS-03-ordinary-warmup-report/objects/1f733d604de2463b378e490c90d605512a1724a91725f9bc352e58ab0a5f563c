impl From<WarmupReportError> for crate::error::RuntimeError {
    fn from(error: WarmupReportError) -> Self {
        use crate::error::WarmupOutputError;
        let error = match error {
            WarmupReportError::Unavailable(reason) => WarmupOutputError::Unavailable(reason.into()),
            WarmupReportError::Format(reason) => WarmupOutputError::Format(format!("{reason:?}")),
            WarmupReportError::Io(error) => WarmupOutputError::Io(error),
        };
        Self::WarmupOutput(Box::new(error))
    }
}

// Output-only observations of actual Construction.cc local storage.
#ifndef CTF06_OBSERVER_HH_INCLUDED
#define CTF06_OBSERVER_HH_INCLUDED

#include <EnergyPlus/Construction.hh>
#include <ObjexxFCL/Array1D.hh>
#include <ObjexxFCL/Array2D.hh>

#include <array>
#include <cstddef>
#include <cstdint>
#include <optional>
#include <vector>

namespace EnergyPlus::CTF06Observation {

enum class Phase : std::size_t
{
    PostLoad = 0,
    PostMerge = 1,
    PostConversion = 2,
    InitialDiscretization = 3
};

// Object-representation copies preserve signed zero and nonfinite payload bits.
struct Binary64Copy
{
    std::uint64_t bits = 0;
};

struct LayerSnapshot
{
    Binary64Copy dl;
    Binary64Copy rk;
    Binary64Copy rho;
    Binary64Copy cp;
    Binary64Copy lr;
    bool ResLayer = false;
};

struct Snapshot
{
    bool reached = false;
    bool active_prefix_available = false;
    bool ErrorsFound = false;
    bool DoCTFErrorReport = false;
    int LayersInConstruct = 0;
    int NumResLayers = 0;
    std::size_t copied_layer_count = 0;
    // Only [0, copied_layer_count) is an observation. Never emit the tail.
    std::array<LayerSnapshot, Construction::MaxLayersInConstruct> active_prefix{};
    // Empty until the actual post-401 callback; not invented zero operands.
    std::optional<Binary64Copy> dyn;
    std::optional<Binary64Copy> rs;
    std::optional<Binary64Copy> cnd;
};

// Actual initial state after original Construction.cc 619, before retries.
struct InitialLayerSnapshot
{
    int Nodes = 0;
    Binary64Copy dx;
};

struct InitialDiscretizationSnapshot
{
    bool reached = false;
    bool active_prefix_available = false;
    bool ErrorsFound = false;
    bool DoCTFErrorReport = false;
    int LayersInConstruct = 0;
    int NumResLayers = 0;
    std::size_t copied_layer_count = 0;
    // Only the copied active prefix is observed. Never emit the unused tail.
    std::array<InitialLayerSnapshot, Construction::MaxLayersInConstruct> active_prefix{};
    int rcmax = 0;
    int NodeSource = 0;
    int NodeUserTemp = 0;
    Binary64Copy CTFTimeStep;
    int NumHistories = 0;
    Binary64Copy TimeStepZone;
};

// Matrix storage is observed during one actual selected 1D loop occurrence.
enum class MatrixAttemptFailureKind : std::size_t
{
    IdentityMismatch = 0,
    OrderFailure = 1,
    ActivePrefixShape = 2,
    MatrixShape = 3,
    CopyException = 4,
    LedgerAppendException = 5
};

struct MatrixAttemptFailure
{
    std::size_t observed_attempt_ordinal = 0;
    MatrixAttemptFailureKind kind = MatrixAttemptFailureKind::IdentityMismatch;
};

struct Array1Bounds
{
    int lower = 0;
    int upper = 0;
    std::size_t size = 0;
};

struct Array2Bounds
{
    int lower1 = 0;
    int upper1 = 0;
    int lower2 = 0;
    int upper2 = 0;
    std::size_t size = 0;
};

struct MatrixLayerSnapshot
{
    LayerSnapshot converted;
    int Nodes = 0;
    Binary64Copy dx;
};

struct MatrixAttemptSnapshot
{
    // One-based visit to the sole post-728 callsite within the bound whole call.
    std::size_t observed_attempt_ordinal = 0;
    bool reached = false;
    bool active_prefix_available = false;
    bool matrices_available = false;
    std::array<bool, 6> failure_kinds{};
    bool ErrorsFound = false;
    bool DoCTFErrorReport = false;
    bool IsUsedCTF = false;
    bool SourceSinkPresent = false;
    int SolutionDimensions = 0;
    int TotLayers = 0;
    int LayersInConstruct = 0;
    int NumResLayers = 0;
    int rcmax = 0;
    int NodeSource = 0;
    int NodeUserTemp = 0;
    Binary64Copy CTFTimeStep;
    int NumHistories = 0;
    Binary64Copy TimeStepZone;
    std::size_t copied_layer_count = 0;
    std::array<MatrixLayerSnapshot, Construction::MaxLayersInConstruct> active_prefix{};
    // Null bounds mean the real owner was not allocated, not zero dimensions.
    std::optional<Array2Bounds> AMat_bounds;
    std::optional<Array2Bounds> IdenMatrix_bounds;
    std::optional<Array1Bounds> BMat_bounds;
    std::optional<Array1Bounds> CMat_bounds;
    std::optional<Array1Bounds> DMat_bounds;
    // Source i1 outer, i2 inner: i2 is contiguous. No identity/zero synthesis.
    std::vector<Binary64Copy> AMat;
    std::vector<Binary64Copy> IdenMatrix;
    std::array<Binary64Copy, 3> BMat{};
    std::array<Binary64Copy, 2> CMat{};
    std::array<Binary64Copy, 2> DMat{};
};


// Separate actual method visits; none of these counters modifies the old ledger.
enum class MethodKind : std::size_t { Exponential = 0, Inverse = 1 };
enum class MethodStage : std::size_t
{
    Entry = 0, InitializedInputs = 1, ScalingControls = 2,
    PowerControl = 3, SquareControl = 4, FinalWorkspace = 5, SourceReturn = 6
};
enum class MethodFailureKind : std::size_t
{
    IdentityMismatch = 0, AssociationFailure = 1, OrderFailure = 2,
    MatrixShape = 3, CopyException = 4, LedgerAppendException = 5
};
enum class MatrixOwner : std::size_t
{
    AMat = 0, IdenMatrix = 1, AMat1 = 2, AMato = 3,
    AMatN = 4, AExp = 5, AInv = 6
};

struct MethodFailure
{
    MethodKind method = MethodKind::Exponential;
    std::size_t invocation_ordinal = 0;
    std::size_t assembly_ordinal = 0;
    MethodStage stage = MethodStage::Entry;
    MethodFailureKind kind = MethodFailureKind::IdentityMismatch;
};

struct MethodContext
{
    // Fresh copies of actual Construction members at this callback.
    bool IsUsedCTF = false;
    bool SourceSinkPresent = false;
    int SolutionDimensions = 0;
    int TotLayers = 0;
    int rcmax = 0;
    int NodeSource = 0;
    int NodeUserTemp = 0;
    Binary64Copy CTFTimeStep;
    int NumHistories = 0;
    // These are explicitly the checked earlier assembly's actual stack context.
    bool assembly_context_available = false;
    bool assembly_ErrorsFound = false;
    bool assembly_DoCTFErrorReport = false;
    Binary64Copy assembly_TimeStepZone;
};

struct MethodMatrixSnapshot
{
    MatrixOwner owner = MatrixOwner::AMat;
    std::optional<Array2Bounds> bounds;
    bool copy_available = false;
    std::vector<Binary64Copy> values;
};

struct ExponentialControls
{
    Binary64Copy AMatRowNormMax;
    int k = 0;
    Binary64Copy fact;
    Binary64Copy CheckVal;
    int l = 0;
    // Available only at the final boundary; not an iteration count.
    std::optional<int> final_i;
};

struct MethodValueSnapshot
{
    bool reached = false;
    bool matrices_available = false;
    MethodContext context;
    std::size_t observed_matrix_count = 0;
    // Only [0, observed_matrix_count) is observed; never serialize unused slots.
    std::array<MethodMatrixSnapshot, 4> matrices{};
    std::optional<ExponentialControls> exponential_controls;
    // Populated only at the actual caller-return site, with actual stack inputs.
    bool caller_context_available = false;
    bool caller_ErrorsFound = false;
    bool caller_DoCTFErrorReport = false;
    std::optional<Binary64Copy> caller_TimeStepZone;
};

struct PowerControlSnapshot
{
    std::size_t observed_event_ordinal = 0;
    int i = 0;
    bool SigFigLimit = false;
};
struct SquareControlSnapshot
{
    std::size_t observed_event_ordinal = 0;
    int isq = 0;
    bool Backup = false;
};

struct MethodInvocationSnapshot
{
    std::size_t observed_invocation_ordinal = 0;
    std::size_t observed_assembly_ordinal = 0;
    bool association_available = false;
    std::array<bool, 6> failure_kinds{};
    std::array<std::size_t, 7> actual_stage_callback_counts{};
    MethodValueSnapshot entry;
    MethodValueSnapshot initialized_inputs;
    MethodValueSnapshot scaling_controls;
    std::vector<PowerControlSnapshot> power_controls;
    std::vector<SquareControlSnapshot> square_controls;
    MethodValueSnapshot final_workspace;
    MethodValueSnapshot source_return;
};

struct MethodCapture
{
    std::size_t actual_invocation_count = 0;
    std::array<std::size_t, 7> actual_stage_callback_counts{};
    std::vector<MethodInvocationSnapshot> invocations;
    // Every actual callback without its required retained record is counted.
    std::array<std::size_t, 7> stage_records_omitted{};
    bool observer_failure = false;
    std::array<std::size_t, 6> failure_event_counts{};
    std::optional<MethodFailure> first_failure;
    std::optional<MethodFailure> last_failure;
};

struct Capture
{
    // Internal identity checks only. A future helper supplies its real owner ID.
    EnergyPlusData const *bound_state = nullptr;
    Construction::ConstructionProps const *bound_construction = nullptr;
    std::array<Snapshot, 3> phases{};
    InitialDiscretizationSnapshot initial_discretization{};
    std::array<std::size_t, 4> actual_phase_callback_counts{};
    std::size_t actual_callback_count = 0;
    bool binding_error = false;
    bool identity_mismatch = false;
    bool duplicate_phase = false;
    bool phase_order_invalid = false;
    bool active_prefix_invalid = false;
    // These counters are separate; the old four checkpoint counters are intact.
    std::size_t actual_matrix_attempt_callback_count = 0;
    std::vector<MatrixAttemptSnapshot> matrix_attempts;
    std::size_t matrix_attempt_records_omitted = 0;
    bool matrix_observer_failure = false;
    std::array<std::size_t, 6> matrix_failure_event_counts{};
    std::optional<MatrixAttemptFailure> first_matrix_failure;
    std::optional<MatrixAttemptFailure> last_matrix_failure;
    MethodCapture exponential;
    MethodCapture inverse;
};

// A helper binds its explicit actual state/array element before one genuine call.
// Nested bindings are rejected as observer metadata; they do not replace a call.
class Binding
{
public:
    Binding(Capture &capture, EnergyPlusData const &state,
            Construction::ConstructionProps const &construction) noexcept;
    ~Binding() noexcept;
    Binding(Binding const &) = delete;
    Binding &operator=(Binding const &) = delete;
    Binding(Binding &&) = delete;
    Binding &operator=(Binding &&) = delete;
    [[nodiscard]] bool active() const noexcept { return active_; }

private:
    Capture *capture_ = nullptr;
    bool active_ = false;
};


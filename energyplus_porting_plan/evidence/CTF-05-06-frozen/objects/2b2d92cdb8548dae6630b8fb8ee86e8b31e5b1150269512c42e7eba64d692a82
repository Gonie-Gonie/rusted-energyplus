def range_guard(source, row):
    raw = m.contained(m.bind(source)["path"]).read_bytes().splitlines(keepends=True)
    lo, hi = row["start_line"], row["end_line"]
    m.require(type(lo) is int and type(hi) is int and 1 <= lo <= hi <= len(raw), "Bounded source range required")
    selected = b"".join(raw[lo - 1:hi])
    m.require(hashlib.sha256(selected).hexdigest() == row.get("range_sha256", row.get("sha256")) and
              len(selected) == row.get("range_size_bytes", row.get("size_bytes")), "Selected source range differs")


def scope_authority(args, passive, native_ref, passive_ref, policy_ref):
    cards = {"CTF-05": m.argument(args.current_card_05), "CTF-06": m.argument(args.current_card_06)}
    for name, card in cards.items():
        m.require(card["path"] == "energyplus_porting_plan/cards/" + name + ".md", "Actual current method card required")
    amendment_ref = m.argument(args.actual_scope_amendment)
    executions = {"CTF-05": m.argument(args.actual_scope_amendment_execution_05),
                  "CTF-06": m.argument(args.actual_scope_amendment_execution_06)}
    amendment = m.load(amendment_ref)
    m.require(amendment["schema"] == "ctf05-ctf06-source-scope-amendment.v1" and
              amendment["cards"] == ["CTF-05", "CTF-06"] and amendment["scope_review_passed"] is True and
              amendment["all_other_gates_pending"] is True and amendment["strict_profiles_settled_before_outputs"] is True and
              amendment["actual_CTF05_or_CTF06_build_or_engine_execution_performed"] is False,
              "Actual combined pre-output source scope authority required")
    m.require(m.bind(amendment["native_observer"]) == native_ref and
              m.bind(amendment["passive_observer"]) == passive_ref and
              m.bind(amendment["method_policy_source_inventory"]) == policy_ref and
              amendment["requested_counts"] == COUNTS, "Actual scope source/policy/input count binding differs")
    before = [m.bind(row) for row in amendment["before_documents"]]
    after = [m.bind(row) for row in amendment["after_documents"]]
    m.require(len(before) == len(after) == 3 and len({row["path"] for row in before}) == 3 and
              len({row["path"] for row in after}) == 3, "Exact plan/two-card before and after identities required")
    for name, card in cards.items():
        historical = next(row for row in passive["source_refs"] if row["path"] == card["path"])
        m.require(any(row["sha256"] == historical["sha256"] and row["size_bytes"] == historical["size_bytes"]
                      for row in before) and card in after, "Historical card copy/current amended card correspondence differs")
        execution = m.load(executions[name])
        m.require(type(execution["exit_code"]) is int and execution["exit_code"] == 0 and
                  execution["launch_error"] is None and execution["source_bytes_match_before_and_after"] is True and
                  execution["command"] == ["python", "-X", "utf8", "-B", "tools/porting/check_plan.py",
                                           "--check", "--card", name],
                  "Both actual source-preserving card validation recorders required")
        for key in ["stdout", "stderr"]:
            m.bind(execution[key])
        m.require(m.contained(execution["stderr"]["path"]).read_bytes() == b"", "Scope validation stderr must be empty")
    m.require(m.identity("energyplus_porting_plan/plan.json") in after, "Current plan must match the real amended after identity")
    return {"current_cards": cards, "actual_scope_amendment": amendment_ref,
            "actual_scope_amendment_execution": executions["CTF-06"],
            "actual_scope_amendment_executions": executions,
            "actual_scope_amendment_execution_role": "real-CTF-06-check-only; both-required-checks-in-executions-mapping",
            "historical_scope_documents": before, "current_scope_documents": after,
            "scope_recorder_role": "validated-Root-authored-documents; did-not-author-amendment"}

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--lane", choices=["unit", "production"], required=True)
    for name in ["approved-source-sha256", "source-manifest", "native-source-manifest", "current-card-05", "current-card-06",
                 "actual-scope-amendment", "actual-scope-amendment-execution-05",
                 "actual-scope-amendment-execution-06", "output-dir"]:
        parser.add_argument("--" + name, required=True)
    args = parser.parse_args()
    started = datetime.now(timezone.utc).isoformat()
    writer = m.identity(__file__)
    m.require(writer["sha256"] == args.approved_source_sha256, "Explicit approved writer SHA differs")
    own_ref = m.argument(args.source_manifest)
    own = m.load(own_ref)
    own_sources = [m.bind(row) for row in own["own_sources"]]
    m.require(own["schema"] == "ctf06-input-writer-source-preparation.v1" and
              own_sources == [writer, m.identity(io_path)], "Exact approved writer/helper identities required")
    native_ref = m.argument(args.native_source_manifest)
    m.require(native_ref == m.bind(NATIVE), "Exact held Native source preparation required")
    native = m.load(native_ref)
    m.require(native["schema"] == "ctf06-combined-exponential-inverse-helper-source-preparation.v1" and
              native["energyplus_commit"] == COMMIT, "Pinned combined method observer manifest required")
    passive_ref = m.bind(PASSIVE)
    passive = m.load(passive_ref)
    m.require(passive["energyplus_commit"] == COMMIT and any(
        row["path"] == passive_ref["path"] and row["sha256"] == passive_ref["sha256"]
        for row in native["inherited_dependencies"]), "Held helper/passive source binding differs")
    documents = {Path(row["path"]).name: m.bind(row) for row in native["policy_proposals"]}
    proposed = m.load(documents["input-policy-proposal.json"])
    projection_policy_ref = documents["projection-policy-proposal.json"]
    projection_policy = m.load(projection_policy_ref)
    initial_policy = projection_policy["ctf03_initial_observation_policy"]
    m.require(initial_policy == proposed["ctf03_initial_observation_policy"], "Typed initial policy differs")
    initial_profiles = projection_policy["ctf03_initial_profiles"]
    initial_variables = ["dx", "initial_CTFTimeStep", "caller_TimeStepZone"]
    m.require([row["variable"] for row in initial_profiles] == initial_variables and all(
        type(row["atol"]) is float and row["atol"] == 0.0 and type(row["rtol"]) is float and row["rtol"] == 0.0 and
        row["class_exact"] is True and row["shape_exact"] is True and row["signed_zero_exact"] is True and
        row["required_shape"] == ("actual_LayersInConstruct_active_prefix" if index == 0 else "scalar")
        for index, row in enumerate(initial_profiles)), "Inherited three initial profiles must remain unchanged context")
    matrix_policy = projection_policy["ctf04_matrix_observation_policy"]
    m.require(matrix_policy == proposed["ctf04_matrix_observation_policy"] and
              matrix_policy["selected_attempt_ordinal"] == 1 and
              matrix_policy["later_Native_attempts_paired"] is False and
              matrix_policy["selected_first_attempt_uses_actual_initial619_dt_and_history"] is True and
              matrix_policy["Rust_retry_driver_available"] is False and
              projection_policy["all_actual_Native_attempt_records_retained"] is True and
              projection_policy["Native_retry_dt_history_or_attempt_counts_supplied_to_Rust"] is False,
              "First actual 1D matrix visit only; all later attempts retained unpaired without Rust injection")
    profiles = projection_policy["arithmetic_profiles_by_variable"]
    variables = ["AMat", "IdenMatrix", "BMat", "CMat", "DMat", "assembly_CTFTimeStep", "caller_TimeStepZone"]
    shapes = ["actual_rcmax_by_rcmax", "actual_rcmax_by_rcmax", [3], [2], [2], "scalar", "scalar"]
    m.require([row["variable"] for row in profiles] == variables and all(
        type(row["atol"]) is float and row["atol"] == 0.0 and type(row["rtol"]) is float and row["rtol"] == 0.0 and
        row["class_exact"] is True and row["shape_exact"] is True and row["signed_zero_exact"] is True and
        row["required_shape"] == shapes[index] for index, row in enumerate(profiles)),
        "Seven exact zero/class/actual-matrix-shape/signedzero profiles required")
    old_policy_ref = m.bind(INHERITED_POLICY)
    old_policy = m.load(old_policy_ref)
    for key in ["ctf03_initial_observation_policy", "ctf04_matrix_observation_policy",
                "ctf03_initial_profiles", "arithmetic_profiles_by_variable"]:
        m.require(projection_policy[key] == old_policy[key], "Inherited initial/matrix policy and profiles must remain unchanged")
    method_policies = {key: projection_policy[key] for key in
                       ["ctf06_exponential_observation_policy", "ctf05_inverse_observation_policy"]}
    for key, policy in method_policies.items():
        m.require(policy == proposed[key] and policy["selected_invocation_ordinal"] == 1 and
                  policy["selected_assembly_ordinal"] == 1 and
                  policy["selected_first_attempt_uses_actual_initial619_dt_and_history"] is True and
                  policy["all_actual_visits_and_control_events_retained"] is True and
                  policy["later_Native_attempts_paired"] is False and policy["later_Native_attempts_counted_as_PASS"] is False and
                  policy["observer_failure_or_omission_is_integrity_failure"] is True and
                  policy["Rust_retry_driver_available"] is False, "First actual method only; full visits/integrity retained")
    selection = projection_policy["method_selection"]
    m.require(selection["actual_assembly_ordinal"] == selection["actual_exponential_invocation_ordinal"] ==
              selection["actual_inverse_invocation_ordinal"] == 1 and
              selection["actual_order"] == ["assembly728", "exponential884", "inverse887"] and
              selection["no_initial_dt_equals_TimeStepZone_assertion"] is True and
              selection["no_Rust_retry_driver_claim"] is True, "Exact first-visit source order/initial association required")
    method_profiles = {"ctf06_exponential_profiles": projection_policy["ctf06_exponential_profiles"],
                       "ctf05_inverse_profiles": projection_policy["ctf05_inverse_profiles"]}
    for key, names, required_shapes in [
        ("ctf06_exponential_profiles", ["AExp", "final_AMat1", "final_AMato", "final_AMatN", "AMatRowNormMax", "fact", "CheckVal"],
         ["actual_rcmax_by_rcmax"] * 4 + ["scalar"] * 3),
        ("ctf05_inverse_profiles", ["AInv", "final_AMat1"], ["actual_rcmax_by_rcmax"] * 2)]:
        rows = method_profiles[key]
        m.require([row["variable"] for row in rows] == names and all(
            type(row["atol"]) is float and row["atol"] == 0.0 and type(row["rtol"]) is float and row["rtol"] == 0.0 and
            row["class_exact"] is True and row["shape_exact"] is True and row["signed_zero_exact"] is True and
            row["required_shape"] == required_shapes[index] for index, row in enumerate(rows)),
            "Separate exact exponential seven/inverse two profiles required")
    m.require(proposed["linked_original_retention_intent"] == projection_policy["linked_original_retention_intent"] ==
              LINKED_ORIGINAL_RETENTION_INTENT, "Forward-only new06 debug-original retention intent differs")
    inherited = INHERITED[args.lane]
    old_refs = {key: m.bind({"path": inherited["base"] + name, "sha256": inherited[key]}) for key, name in
                [("request", "helper-request.json"), ("source", "source.json"), ("tolerances", "tolerances.json")]}
    old_request, old_source, old_tolerance = [m.load(old_refs[key]) for key in ["request", "source", "tolerances"]]
    models = old_request["model_cases"]  # Exact literal/member or original IDF rows; no normalization or reconstruction.
    counts = {"model_cases": len(models)}
    if args.lane == "unit":
        counts["calculateTransferFunction"] = sum(len(row["operations"]) for row in models)
        m.require(counts == COUNTS["unit"], "Genuine inherited unit39/42 input rows required")
        counts["total_operations"] = counts["calculateTransferFunction"]
    else:
        counts["loader_phase_records"] = len(models) * len(old_request["loader_phase_order"])
        m.require(counts == COUNTS["production"], "Genuine inherited production15/195 input rows required")
    m.require(counts == old_request["requested_counts"] and old_request["energyplus_commit"] == COMMIT and
              old_source["energyplus_commit"] == COMMIT, "Inherited request source/count identity differs")
    old_profiles = old_tolerance["arithmetic_profiles_by_variable"]
    expected18 = [phase + "." + field for phase in ["PostLoad", "PostMerge", "PostConversion"]
                  for field in ["dl", "rk", "rho", "cp", "lr"]] + ["PostConversion." + key for key in ["dyn", "rs", "cnd"]]
    m.require([row["variable"] for row in old_profiles] == expected18 and all(
        row["atol"] == row["rtol"] == 0.0 and row["class_exact"] is True and row["shape_exact"] is True
        for row in old_profiles), "Inherited18 preprocessing profiles must remain unchanged separate context")
    scope_ref = m.bind(proposed["fixed_scope"])
    scope = m.load(scope_ref)
    guards = [row[key] for row in scope["cases"] for key in ["input", "weather", "metadata"]]
    m.require(len(scope["cases"]) == 15 and len(guards) == 45 and guards == old_request["all_45_guard_refs"] ==
              proposed["all_45_guard_refs"] and m.bind(old_request["fixed_scope"]) == scope_ref,
              "Exact inherited fixed15 and ordered45 input guard refs required")
    for row in guards:
        m.bind(row)  # Only byte identities, no scientific/weather parsing.
    if args.lane == "production":
        m.require(all(row["id"] == selected["id"] and row["input"] == selected["input"]
                      for row, selected in zip(models, scope["cases"])), "Production scope order/input rows differ")
    originals = []
    for row in old_source["source_files"]:
        source = m.bind({**row, "path": ORIGINAL + row["path"]})
        m.require(m.contained(source["path"]).is_relative_to(m.ROOT / ORIGINAL), "Original source tree escape")
        originals.append(source)
        for selected in row.get("selected_ranges", []):
            range_guard(source, selected)
    m.require(len(originals) == (7 if args.lane == "unit" else 21), "Genuine inherited Original source inventory differs")
    for row in old_source.get("primary_source_ranges", []):
        range_guard(row["source"], row)
    for row in native["source_ranges"]:
        selected = {"start_line": row["first_line"], "end_line": row["last_line"],
                    "sha256": row["sha256"], "size_bytes": row["size_bytes"]}
        range_guard(m.identity(row["path"]), selected)
    native_sources = [m.bind(row) for row in native["native_inventory_by_lane"][args.lane]]
    m.require(len(native_sources) == 8 and len({Path(row["path"]).name for row in native_sources}) == 8,
              "Exact lane-specific Native8 identity inventory required")
    authority = scope_authority(args, passive, native_ref, passive_ref, projection_policy_ref)
    authority.update(native_source_manifest=native_ref, passive_observer=passive_ref,
                     method_policy_source_inventory=projection_policy_ref,
                     inherited_input_only_packet=old_refs)
    output = m.contained(args.output_dir, existing=False)
    m.require(output.is_relative_to(m.CTF) and output != m.CTF and not output.exists(), "Fresh CTF06 output required")
    m.recheck()
    output.mkdir(parents=True, exist_ok=False)
    archive_dir = output / "source-archives"
    archive_dir.mkdir()
    archives = [m.archive(row, archive_dir, index) for index, row in enumerate(
        own_sources + [native_ref, passive_ref, old_policy_ref, *documents.values(), *old_refs.values()] + originals + native_sources)]
    prefix = "ctf06-" + ("production-" if args.lane == "production" else "")
    common = {**FLAGS, "linked_original_retention_intent": LINKED_ORIGINAL_RETENTION_INTENT, "energyplus_commit": COMMIT, "fixed_scope": scope_ref, "all_45_guard_refs": guards,
              **{key: authority[key] for key in ["actual_scope_amendment", "actual_scope_amendment_execution",
                  "actual_scope_amendment_executions", "actual_scope_amendment_execution_role", "current_cards"]}}
    source = m.emit(output / "source.json", {"schema": prefix + "source-contract.v1", **FLAGS,
        "energyplus_commit": COMMIT, "source_files": old_source["source_files"],
        "inherited_primary_source_ranges": old_source.get("primary_source_ranges", []),
        "ctf06_selected_primary_ranges": native["source_ranges"], "source_authorities": authority,
        "selected_source_boundary": "unchanged whole calls; first728 assembly then exponential884/inverse887 first invocations; actual initial619 association; all later visits retained unpaired/noPASS"})
    tolerances = m.emit(output / "tolerances.json", {"schema": prefix + "tolerances-contract.v1", **FLAGS,
        "linked_original_retention_intent": LINKED_ORIGINAL_RETENTION_INTENT, **method_policies, **method_profiles,
        "ctf03_initial_observation_policy": initial_policy, "ctf04_matrix_observation_policy": matrix_policy, "arithmetic_profiles_by_variable": profiles, "ctf03_initial_profiles": initial_profiles,
        "ctf01_preprocessing_profiles": old_profiles, "inherited_ctf01_tolerances": old_refs["tolerances"],
        "copied_input_and_owner_profile": old_tolerance["copied_input_and_owner_profile"],
        "discrete_exact": projection_policy["discrete_exact"], "nonfinite_policy": projection_policy["nonfinite_policy"],
        "tolerance_changes_after_output_inspection_permitted": False})
    request_extra = {"loader_phase_order": old_request["loader_phase_order"]} if args.lane == "production" else {}
    request = m.emit(output / "helper-request.json", {"schema": prefix + "helper-cases.v1", **common,
        "contracts": {"source": source, "tolerances": tolerances}, "observation_policy": old_request["observation_policy"],
        "ctf03_initial_observation_policy": initial_policy, "ctf04_matrix_observation_policy": matrix_policy, **method_policies, "model_cases": models, "requested_counts": counts, **request_extra})
    cases = m.emit(output / "cases.json", {"schema": prefix + "cases-contract.v1", **FLAGS,
        "helper_request": request, "source": source, "tolerances": tolerances, "fixed_CON_scope": scope_ref,
        "all_45_guard_refs": guards, "requested_counts": counts, "inherited_input_only_request": old_refs["request"],
        "model_member_caller_operation_order_and_bits_unchanged": True})
    contracts = {"source": source, "cases": cases, "tolerances": tolerances}
    projection = m.emit(output / "projection.json", {"schema": prefix + "observation-projection.v1", **common,
        "helper_request": request, "contracts": contracts, "native_observation_policy": old_request["observation_policy"],
        "ctf03_initial_observation_policy": initial_policy, "ctf04_matrix_observation_policy": matrix_policy, **method_policies, "method_state_pairing_and_availability": projection_policy,
        "numeric_policy": tolerances, "source_authorities": authority, "scientific_values_compared_or_PASS_claimed": False})
    admission = m.emit(output / "native-admission-contract.json", {"schema": prefix + "native-admission-contract.v1", **common,
        "helper_request": request, "projection": projection, "contracts": contracts, "native_source_files": native_sources,
        "ctf03_initial_observation_policy": initial_policy, "ctf04_matrix_observation_policy": matrix_policy, **method_policies, "requested_counts": counts, **request_extra})
    m.recheck()
    receipt = {"schema": prefix + "frozen-packet.v1", "status": "frozen-inherited-input-and-fresh-combined-CTF05-CTF06-policy-before-helper",
        "lane": args.lane, "linked_original_retention_intent": LINKED_ORIGINAL_RETENTION_INTENT, **FLAGS, "started_utc": started, "finished_utc": datetime.now(timezone.utc).isoformat(),
        "source_preparation_approval": {"approved_writer_sha256": writer["sha256"], "source_manifest": own_ref,
                                        "reviewed_sources": own_sources}, "source_authorities": authority,
        "helper_request": request, "native_admission_contract": admission, "projection": projection,
        "contracts": contracts, "requested_counts": counts, "fixed_scope": scope_ref, "all_45_guard_refs": guards,
        "executed_writer_sources": archives[:2], "reviewed_source_archives": archives,
        "inherited_CTF01_freeze_claimed_as_fresh_CTF06_freeze": False, "scientific_operands_evaluated": False,
        "expected_arrays_or_method_outcomes_generated": False, "numerical_PASS_claimed": False,
        "canonical_files_updated": False, "gates_updated": False}
    m.emit(output / "freeze-receipt.json", receipt)
    m.recheck()
    print(json.dumps(receipt, ensure_ascii=False, allow_nan=False, indent=2))


if __name__ == "__main__":
    main()

def ref(path):
    raw = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(raw).hexdigest(),
            "size_bytes": len(raw), "line_count": len(raw.splitlines())}


def once(text, old, new):
    assert text.count(old) == 1, old
    return text.replace(old, new, 1)


def namespace(text):
    for old, new in [("ctf04_candidate_", "ctf06_candidate_"),
                     ("ctf04-candidate-", "ctf06-candidate-"),
                     ("ctf04-helper-cases.v1", "ctf06-helper-cases.v1"),
                     ("ctf04-native-admission-contract.v1", "ctf06-native-admission-contract.v1"),
                     ("ctf04-production-helper-cases.v1", "ctf06-production-helper-cases.v1"),
                     ("ctf04-production-native-admission-contract.v1", "ctf06-production-native-admission-contract.v1"),
                     ("frozen_before_this_CTF04_helper_execution", "frozen_before_this_CTF06_helper_execution"),
                     ("actual frozen CTF04 production packet differs", "actual frozen CTF06 production packet differs")]:
        text = text.replace(old, new)
    return text



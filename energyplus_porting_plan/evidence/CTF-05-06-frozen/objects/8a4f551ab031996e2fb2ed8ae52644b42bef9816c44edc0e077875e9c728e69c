+inline bool method_copy_failed(MethodObservation::MethodCapture const &source)
+{
+    if (source.observer_failure || source.actual_invocation_count != source.invocations.size() ||
+        source.first_failure || source.last_failure) return true;
+    for (auto count : source.failure_event_counts) if (count != 0) return true;
+    for (auto count : source.stage_records_omitted) if (count != 0) return true;
+    std::array<std::size_t, 7> retained_counts{};
+    for (std::size_t index = 0; index < source.invocations.size(); ++index) {
+        auto const &record = source.invocations[index];
+        if (record.observed_invocation_ordinal != index + 1 || !record.association_available ||
+            record.observed_assembly_ordinal != record.observed_invocation_ordinal) return true;
+        for (bool failed : record.failure_kinds) if (failed) return true;
+        std::array<std::size_t, 7> const retained{{record.entry.reached ? 1u : 0u,
+            record.initialized_inputs.reached ? 1u : 0u, record.scaling_controls.reached ? 1u : 0u,
+            record.power_controls.size(), record.square_controls.size(),
+            record.final_workspace.reached ? 1u : 0u, record.source_return.reached ? 1u : 0u}};
+        if (record.actual_stage_callback_counts != retained) return true;
+        for (std::size_t stage = 0; stage < retained.size(); ++stage) retained_counts[stage] += retained[stage];
+        for (auto const *value : {&record.entry, &record.initialized_inputs, &record.scaling_controls,
+                                 &record.final_workspace, &record.source_return}) {
+            if (!value->reached) continue; // A genuine stop does not invent a missing callback.
+            if (!value->matrices_available || !value->context.assembly_context_available ||
+                value->observed_matrix_count > value->matrices.size()) return true;
+            for (std::size_t matrix = 0; matrix < value->observed_matrix_count; ++matrix)
+                if (!value->matrices[matrix].copy_available) return true;
+        }
+        if (record.source_return.reached && (!record.source_return.caller_context_available ||
+            !record.source_return.caller_TimeStepZone)) return true;
+        for (std::size_t event = 0; event < record.power_controls.size(); ++event)
+            if (record.power_controls[event].observed_event_ordinal != event + 1) return true;
+        for (std::size_t event = 0; event < record.square_controls.size(); ++event)
+            if (record.square_controls[event].observed_event_ordinal != event + 1) return true;
+    }
+    return retained_counts != source.actual_stage_callback_counts;
+}
+inline json method_observations(MethodObservation::MethodCapture const &source, MethodObservation::MethodKind method)
+{
+    json invocations = json::array(), stages = json::array(), failures = json::array();
+    for (auto const &record : source.invocations) {
+        json power = json::array(), square = json::array(), kinds = json::array();
+        for (auto const &event : record.power_controls) power.push_back({{"observed_event_ordinal", event.observed_event_ordinal},
+            {"i", event.i}, {"SigFigLimit", event.SigFigLimit}});
+        for (auto const &event : record.square_controls) square.push_back({{"observed_event_ordinal", event.observed_event_ordinal},
+            {"isq", event.isq}, {"Backup", event.Backup}});
+        for (std::size_t index = 0; index < record.failure_kinds.size(); ++index)
+            kinds.push_back({{"kind", method_failure_name(static_cast<MethodObservation::MethodFailureKind>(index))}, {"failed", record.failure_kinds[index]}});
+        invocations.push_back({{"observed_invocation_ordinal", record.observed_invocation_ordinal},
+            {"observed_assembly_ordinal", record.observed_assembly_ordinal}, {"association_available", record.association_available},
+            {"failure_kinds", kinds}, {"actual_stage_callback_counts", record.actual_stage_callback_counts},
+            {"Entry", method_value(record.entry)}, {"InitializedInputs", method_value(record.initialized_inputs)},
+            {"ScalingControls", method_value(record.scaling_controls)}, {"PowerControl", power}, {"SquareControl", square},
+            {"FinalWorkspace", method_value(record.final_workspace)}, {"SourceReturn", method_value(record.source_return)},
+            {"actual_retained_power_control_count", record.power_controls.size()},
+            {"actual_retained_square_control_count", record.square_controls.size()}, {"counted_as_PASS", false}});
+    }
+    for (std::size_t index = 0; index < source.actual_stage_callback_counts.size(); ++index)
+        stages.push_back({{"stage", method_stage_name(static_cast<MethodObservation::MethodStage>(index))},
+            {"actual_callback_count", source.actual_stage_callback_counts[index]}, {"records_omitted", source.stage_records_omitted[index]}});
+    for (std::size_t index = 0; index < source.failure_event_counts.size(); ++index)
+        failures.push_back({{"kind", method_failure_name(static_cast<MethodObservation::MethodFailureKind>(index))},
+            {"actual_event_count", source.failure_event_counts[index]}});
+    return {{"protocol", method == MethodObservation::MethodKind::Exponential ? "ctf06-exponential-method-observation.v1" : "ctf05-inverse-method-observation.v1"},
+        {"method", method_kind_name(method)}, {"actual_invocation_count", source.actual_invocation_count},
+        {"actual_retained_invocation_count", source.invocations.size()}, {"actual_stage_callback_counts", source.actual_stage_callback_counts},
+        {"stage_records_omitted", source.stage_records_omitted}, {"stage_ledger", stages},
+        {"observer_failure", source.observer_failure}, {"method_copy_integrity_failed", method_copy_failed(source)},
+        {"failure_event_counts", failures}, {"first_failure", method_failure_event(source.first_failure)},
+        {"last_failure", method_failure_event(source.last_failure)}, {"invocations", invocations},
+        {"no_actual_entry_observed", source.actual_invocation_count == 0}, {"record_cap", nullptr},
+        {"deduplicated", false}, {"truncated", false}, {"unreached_counted_as_PASS", false},
+        {"later_attempts_counted_as_PASS", false}, {"values_or_identity_or_return_reconstructed", false},
+        {"old_checkpoint_and_matrix_counters_include_method_callbacks", false}};
+}
+inline bool methods_observer_failed(MethodObservation::Capture const &capture)
+{
+    return method_copy_failed(capture.exponential) || method_copy_failed(capture.inverse);
+}
+struct MethodTotals
+{
+    std::size_t actual_invocation_count = 0, retained_invocation_count = 0;
+    std::array<std::size_t, 7> actual_stage_callback_counts{}, stage_records_omitted{};
+    std::array<std::size_t, 6> failure_event_counts{};
+    std::size_t retained_power_control_count = 0, retained_square_control_count = 0;
+    bool copy_integrity_failed = false;
+};
+inline void add_method_totals(MethodTotals &total, json const &ledger)
+{
+    total.actual_invocation_count += ledger.at("actual_invocation_count").get<std::size_t>();
+    total.retained_invocation_count += ledger.at("actual_retained_invocation_count").get<std::size_t>();
+    total.copy_integrity_failed = total.copy_integrity_failed || ledger.at("method_copy_integrity_failed").get<bool>();
+    for (std::size_t index = 0; index < total.actual_stage_callback_counts.size(); ++index) {
+        total.actual_stage_callback_counts[index] += ledger.at("actual_stage_callback_counts").at(index).get<std::size_t>();
+        total.stage_records_omitted[index] += ledger.at("stage_records_omitted").at(index).get<std::size_t>();
+    }
+    for (std::size_t index = 0; index < total.failure_event_counts.size(); ++index)
+        total.failure_event_counts[index] += ledger.at("failure_event_counts").at(index).at("actual_event_count").get<std::size_t>();
+    for (auto const &record : ledger.at("invocations")) {
+        total.retained_power_control_count += record.at("actual_retained_power_control_count").get<std::size_t>();
+        total.retained_square_control_count += record.at("actual_retained_square_control_count").get<std::size_t>();
+    }
+}

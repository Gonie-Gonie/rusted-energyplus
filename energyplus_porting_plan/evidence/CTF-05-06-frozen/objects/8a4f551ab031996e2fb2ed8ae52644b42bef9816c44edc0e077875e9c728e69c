+        {"actual_stage_callback_counts", total.actual_stage_callback_counts}, {"stage_records_omitted", total.stage_records_omitted},
+        {"failure_event_counts", total.failure_event_counts}, {"actual_retained_power_control_count", total.retained_power_control_count},
+        {"actual_retained_square_control_count", total.retained_square_control_count}, {"method_copy_integrity_failed", total.copy_integrity_failed},
+        {"complete_method_return_parity_claimed", false}, {"numerical_PASS_claimed", false}};

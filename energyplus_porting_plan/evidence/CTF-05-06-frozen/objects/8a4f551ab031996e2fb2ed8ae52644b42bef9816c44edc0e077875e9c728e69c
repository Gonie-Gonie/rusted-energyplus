+    return {{"IsUsedCTF", source.IsUsedCTF}, {"SourceSinkPresent", source.SourceSinkPresent},
+        {"SolutionDimensions", source.SolutionDimensions}, {"TotLayers", source.TotLayers}, {"rcmax", source.rcmax},
+        {"NodeSource", source.NodeSource}, {"NodeUserTemp", source.NodeUserTemp},
+        {"CTFTimeStep", scalar_bits(source.CTFTimeStep.bits)}, {"NumHistories", source.NumHistories},
+        {"assembly_context_available", source.assembly_context_available}, {"earlier_checked_assembly_context", assembly},
+        {"assembly_context_is_fresh_method_stack_context", false}};
+}
+inline json method_value(MethodObservation::MethodValueSnapshot const &source)
+{
+    if (!source.reached) return {{"reached", false}, {"available", false}, {"snapshot", nullptr},
+        {"unavailable_reason", "actual_stage_callback_not_retained_or_not_reached"}, {"counted_as_PASS", false}};
+    require(source.observed_matrix_count <= source.matrices.size(), "Observed method matrix count exceeds actual storage capacity");
+    json matrices = json::array(), controls = nullptr, caller = nullptr;
+    for (std::size_t index = 0; index < source.observed_matrix_count; ++index) {
+        auto const &copy = source.matrices[index]; json bounds = nullptr, values = nullptr;
+        if (copy.bounds) bounds = {{"lower1", copy.bounds->lower1}, {"upper1", copy.bounds->upper1},
+            {"lower2", copy.bounds->lower2}, {"upper2", copy.bounds->upper2}, {"size", copy.bounds->size}};
+        if (copy.copy_available) {
+            values = json::array();
+            for (auto const &value : copy.values) values.push_back(scalar_bits(value.bits));
+        }
+        matrices.push_back({{"owner", method_matrix_name(copy.owner)}, {"actual_bounds", bounds},
+            {"copy_available", copy.copy_available}, {"values", values}});
+    }
+    if (source.exponential_controls) {
+        auto const &copy = *source.exponential_controls;
+        controls = {{"AMatRowNormMax", scalar_bits(copy.AMatRowNormMax.bits)}, {"k", copy.k},
+            {"fact", scalar_bits(copy.fact.bits)}, {"CheckVal", scalar_bits(copy.CheckVal.bits)}, {"l", copy.l},
+            {"final_i", copy.final_i ? json(*copy.final_i) : json(nullptr)}};
+    }
+    if (source.caller_context_available) caller = {{"ErrorsFound", source.caller_ErrorsFound},
+        {"DoCTFErrorReport", source.caller_DoCTFErrorReport},
+        {"TimeStepZone", source.caller_TimeStepZone ? scalar_bits(source.caller_TimeStepZone->bits) : json(nullptr)}};
+    return {{"reached", true}, {"available", source.matrices_available},
+        {"unavailable_reason", source.matrices_available ? json(nullptr) : json("required_method_matrix_copy_unavailable")},
+        {"snapshot", {{"context_available", source.observed_matrix_count != 0},
+            {"context", source.observed_matrix_count != 0 ? method_context(source.context) : json(nullptr)}, {"matrices_available", source.matrices_available},
+            {"observed_matrix_count", source.observed_matrix_count}, {"matrices", matrices},
+            {"exponential_controls", controls}, {"caller_context_available", source.caller_context_available},
+            {"actual_return_site_caller_context", caller}}}, {"counted_as_PASS", false}};
+}

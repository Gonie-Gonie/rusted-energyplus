+inline char const *method_kind_name(MethodObservation::MethodKind value)
+{
+    switch (value) {
+    case MethodObservation::MethodKind::Exponential: return "Exponential";
+    case MethodObservation::MethodKind::Inverse: return "Inverse";
+    }
+    throw std::runtime_error("Unknown actual method kind");
+}
+inline char const *method_stage_name(MethodObservation::MethodStage value)
+{
+    using Stage = MethodObservation::MethodStage;
+    switch (value) {
+    case Stage::Entry: return "Entry";
+    case Stage::InitializedInputs: return "InitializedInputs";
+    case Stage::ScalingControls: return "ScalingControls";
+    case Stage::PowerControl: return "PowerControl";
+    case Stage::SquareControl: return "SquareControl";
+    case Stage::FinalWorkspace: return "FinalWorkspace";
+    case Stage::SourceReturn: return "SourceReturn";
+    }
+    throw std::runtime_error("Unknown actual method stage");
+}
+inline char const *method_failure_name(MethodObservation::MethodFailureKind value)
+{
+    using Kind = MethodObservation::MethodFailureKind;
+    switch (value) {
+    case Kind::IdentityMismatch: return "IdentityMismatch";
+    case Kind::AssociationFailure: return "AssociationFailure";
+    case Kind::OrderFailure: return "OrderFailure";
+    case Kind::MatrixShape: return "MatrixShape";
+    case Kind::CopyException: return "CopyException";
+    case Kind::LedgerAppendException: return "LedgerAppendException";
+    }
+    throw std::runtime_error("Unknown actual method failure");
+}
+inline char const *method_matrix_name(MethodObservation::MatrixOwner value)
+{
+    using Owner = MethodObservation::MatrixOwner;
+    switch (value) {
+    case Owner::AMat: return "AMat";
+    case Owner::IdenMatrix: return "IdenMatrix";
+    case Owner::AMat1: return "AMat1";
+    case Owner::AMato: return "AMato";
+    case Owner::AMatN: return "AMatN";
+    case Owner::AExp: return "AExp";
+    case Owner::AInv: return "AInv";
+    }
+    throw std::runtime_error("Unknown actual matrix owner");
+}

+MatrixAttemptSnapshot const *associated_assembly(Capture const &capture,
+                                                Construction::ConstructionProps const &construction,
+                                                std::size_t ordinal) noexcept
+{
+    if (ordinal == 0 || ordinal != capture.actual_matrix_attempt_callback_count ||
+        capture.matrix_attempts.empty()) return nullptr;
+    MatrixAttemptSnapshot const &assembly = capture.matrix_attempts.back();
+    if (assembly.observed_attempt_ordinal != ordinal || !assembly.reached ||
+        !assembly.active_prefix_available || !assembly.matrices_available) return nullptr;
+    for (bool failed : assembly.failure_kinds) if (failed) return nullptr;
+    if (assembly.IsUsedCTF != construction.IsUsedCTF ||
+        assembly.SourceSinkPresent != construction.SourceSinkPresent ||
+        assembly.SolutionDimensions != construction.SolutionDimensions ||
+        assembly.TotLayers != construction.TotLayers || assembly.rcmax != construction.rcmax ||
+        assembly.NodeSource != construction.NodeSource || assembly.NodeUserTemp != construction.NodeUserTemp ||
+        assembly.NumHistories != construction.NumHistories ||
+        assembly.CTFTimeStep.bits != copy_bits(construction.CTFTimeStep).bits) return nullptr;
+    return &assembly;
+}

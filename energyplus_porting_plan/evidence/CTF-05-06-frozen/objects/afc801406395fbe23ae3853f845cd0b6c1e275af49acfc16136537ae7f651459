+MethodInvocationSnapshot *method_visit(Capture &capture, MethodKind method,
+                                       Construction::ConstructionProps const &construction,
+                                       MethodStage stage) noexcept
+{
+    MethodCapture &ledger = method_capture(capture, method);
+    std::size_t const index = static_cast<std::size_t>(stage);
+    ++ledger.actual_stage_callback_counts[index];
+    if (ledger.invocations.empty() ||
+        ledger.invocations.back().observed_invocation_ordinal != ledger.actual_invocation_count) {
+        ++ledger.stage_records_omitted[index];
+        method_failure(capture, method, nullptr, stage, MethodFailureKind::AssociationFailure);
+        return nullptr;
+    }
+    MethodInvocationSnapshot &invocation = ledger.invocations.back();
+    ++invocation.actual_stage_callback_counts[index];
+    if (stage != MethodStage::PowerControl && stage != MethodStage::SquareControl &&
+        invocation.actual_stage_callback_counts[index] > 1) {
+        ++ledger.stage_records_omitted[index];
+        method_failure(capture, method, &invocation, stage, MethodFailureKind::OrderFailure);
+        return nullptr; // Preserve the first real value record, retaining the extra visit count.
+    }
+    if (capture.bound_state == nullptr || capture.bound_construction != &construction) {
+        method_failure(capture, method, &invocation, stage, MethodFailureKind::IdentityMismatch);
+    }
+    if (invocation.observed_invocation_ordinal != invocation.observed_assembly_ordinal ||
+        associated_assembly(capture, construction, invocation.observed_assembly_ordinal) == nullptr) {
+        method_failure(capture, method, &invocation, stage, MethodFailureKind::AssociationFailure);
+    }
+    bool ordered = invocation.entry.reached && !invocation.source_return.reached;
+    switch (stage) {
+    case MethodStage::InitializedInputs:
+        ordered = ordered && !invocation.initialized_inputs.reached;
+        break;
+    case MethodStage::ScalingControls:
+        ordered = ordered && method == MethodKind::Exponential && invocation.initialized_inputs.reached &&
+                  !invocation.scaling_controls.reached;
+        break;
+    case MethodStage::PowerControl:
+        ordered = ordered && method == MethodKind::Exponential && invocation.scaling_controls.reached &&
+                  !invocation.final_workspace.reached &&
+                  invocation.actual_stage_callback_counts[static_cast<std::size_t>(MethodStage::SquareControl)] == 0;
+        break;
+    case MethodStage::SquareControl:
+        ordered = ordered && method == MethodKind::Exponential && invocation.scaling_controls.reached &&
+                  !invocation.final_workspace.reached;
+        break;
+    case MethodStage::FinalWorkspace:
+        ordered = ordered && !invocation.final_workspace.reached && invocation.initialized_inputs.reached &&
+                  (method == MethodKind::Inverse || invocation.scaling_controls.reached);
+        break;
+    case MethodStage::SourceReturn:
+        ordered = ordered && invocation.final_workspace.reached;
+        break;
+    case MethodStage::Entry:
+        ordered = false; // Entry has its own independent actual invocation counter.
+        break;
+    }
+    if (!ordered) method_failure(capture, method, &invocation, stage, MethodFailureKind::OrderFailure);
+    return &invocation;
+}

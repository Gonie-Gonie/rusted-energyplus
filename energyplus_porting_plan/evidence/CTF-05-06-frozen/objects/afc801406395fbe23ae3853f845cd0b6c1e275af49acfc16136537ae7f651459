+MethodCapture &method_capture(Capture &capture, MethodKind method) noexcept
+{
+    return method == MethodKind::Exponential ? capture.exponential : capture.inverse;
+}
+
+void method_failure(Capture &capture, MethodKind method, MethodInvocationSnapshot *invocation,
+                    MethodStage stage, MethodFailureKind kind) noexcept
+{
+    MethodCapture &ledger = method_capture(capture, method);
+    ledger.observer_failure = true;
+    std::size_t const index = static_cast<std::size_t>(kind);
+    ++ledger.failure_event_counts[index];
+    if (invocation != nullptr) invocation->failure_kinds[index] = true;
+    MethodFailure const failure{method, ledger.actual_invocation_count,
+        invocation == nullptr ? capture.actual_matrix_attempt_callback_count : invocation->observed_assembly_ordinal,
+        stage, kind};
+    if (!ledger.first_failure) ledger.first_failure = failure;
+    ledger.last_failure = failure;
+}

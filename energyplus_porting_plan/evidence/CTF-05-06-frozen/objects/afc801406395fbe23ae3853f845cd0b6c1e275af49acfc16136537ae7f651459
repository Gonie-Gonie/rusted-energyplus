+void method_return(MethodKind method, EnergyPlusData const &state,
+                   Construction::ConstructionProps const &construction,
+                   bool ErrorsFound, bool DoCTFErrorReport, Real64 const &TimeStepZone) noexcept
+{
+    Capture *capture = active_capture;
+    if (capture == nullptr) return;
+    MethodInvocationSnapshot *invocation = method_visit(*capture, method, construction, MethodStage::SourceReturn);
+    if (invocation == nullptr) return;
+    if (capture->bound_state != &state) {
+        method_failure(*capture, method, invocation, MethodStage::SourceReturn, MethodFailureKind::IdentityMismatch);
+    }
+    MethodValueSnapshot &snapshot = invocation->source_return;
+    snapshot.caller_context_available = capture->bound_state == &state && capture->bound_construction == &construction;
+    snapshot.caller_ErrorsFound = ErrorsFound;
+    snapshot.caller_DoCTFErrorReport = DoCTFErrorReport;
+    snapshot.caller_TimeStepZone = copy_bits(TimeStepZone);
+    MatrixAttemptSnapshot const *assembly = associated_assembly(*capture, construction, invocation->observed_assembly_ordinal);
+    if (assembly == nullptr || assembly->ErrorsFound != ErrorsFound ||
+        assembly->DoCTFErrorReport != DoCTFErrorReport || assembly->TimeStepZone.bits != copy_bits(TimeStepZone).bits) {
+        method_failure(*capture, method, invocation, MethodStage::SourceReturn, MethodFailureKind::AssociationFailure);
+    }
+    copy_method_matrices(*capture, method, *invocation, MethodStage::SourceReturn, construction, snapshot,
+        {{MatrixOwner::AMat, &construction.AMat}, {MatrixOwner::IdenMatrix, &construction.IdenMatrix},
+        {method == MethodKind::Exponential ? MatrixOwner::AExp : MatrixOwner::AInv,
+         method == MethodKind::Exponential ? &construction.AExp : &construction.AInv}});
+}

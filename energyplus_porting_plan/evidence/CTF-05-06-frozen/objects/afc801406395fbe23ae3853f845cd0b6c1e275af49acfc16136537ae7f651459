+        invocation->initialized_inputs, {{MatrixOwner::AMat1, &AMat1}, {MatrixOwner::AMato, &AMato},
+        {MatrixOwner::AMatN, &AMatN}, {MatrixOwner::AExp, &construction.AExp}});
+}

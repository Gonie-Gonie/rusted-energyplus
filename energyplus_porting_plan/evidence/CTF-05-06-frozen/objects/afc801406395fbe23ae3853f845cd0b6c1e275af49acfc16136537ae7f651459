+void method_entry(MethodKind method, Construction::ConstructionProps const &construction) noexcept
+{
+    Capture *capture = active_capture;
+    if (capture == nullptr) return;
+    MethodCapture &ledger = method_capture(*capture, method);
+    std::size_t const ordinal = ++ledger.actual_invocation_count;
+    ++ledger.actual_stage_callback_counts[static_cast<std::size_t>(MethodStage::Entry)];
+    bool const previous_returned = ordinal == 1 ||
+        (!ledger.invocations.empty() && ledger.invocations.back().observed_invocation_ordinal == ordinal - 1 &&
+         ledger.invocations.back().source_return.reached);
+    try {
+        ledger.invocations.emplace_back();
+    } catch (...) {
+        ++ledger.stage_records_omitted[static_cast<std::size_t>(MethodStage::Entry)];
+        method_failure(*capture, method, nullptr, MethodStage::Entry, MethodFailureKind::LedgerAppendException);
+        return;
+    }
+    MethodInvocationSnapshot &invocation = ledger.invocations.back();
+    invocation.observed_invocation_ordinal = ordinal;
+    invocation.observed_assembly_ordinal = capture->actual_matrix_attempt_callback_count;
+    ++invocation.actual_stage_callback_counts[static_cast<std::size_t>(MethodStage::Entry)];
+    if (capture->bound_state == nullptr || capture->bound_construction != &construction) {
+        method_failure(*capture, method, &invocation, MethodStage::Entry, MethodFailureKind::IdentityMismatch);
+        invocation.entry.reached = true;
+        return;
+    }
+    invocation.association_available = ordinal == invocation.observed_assembly_ordinal &&
+        associated_assembly(*capture, construction, invocation.observed_assembly_ordinal) != nullptr;
+    if (!invocation.association_available) {
+        method_failure(*capture, method, &invocation, MethodStage::Entry, MethodFailureKind::AssociationFailure);
+    }
+    bool ordered = previous_returned;
+    if (method == MethodKind::Exponential) {
+        ordered = ordered && capture->inverse.actual_invocation_count == ordinal - 1 &&
+            capture->inverse.actual_stage_callback_counts[static_cast<std::size_t>(MethodStage::SourceReturn)] == ordinal - 1;
+    } else {
+        ordered = ordered && capture->exponential.actual_invocation_count == ordinal &&
+            capture->exponential.actual_stage_callback_counts[static_cast<std::size_t>(MethodStage::SourceReturn)] == ordinal &&
+            !capture->exponential.invocations.empty() &&
+            capture->exponential.invocations.back().observed_invocation_ordinal == ordinal &&
+            capture->exponential.invocations.back().source_return.reached;
+    }
+    if (!ordered) method_failure(*capture, method, &invocation, MethodStage::Entry, MethodFailureKind::OrderFailure);
+    copy_method_matrices(*capture, method, invocation, MethodStage::Entry, construction, invocation.entry,
+        {{MatrixOwner::AMat, &construction.AMat}, {MatrixOwner::IdenMatrix, &construction.IdenMatrix}});
+}

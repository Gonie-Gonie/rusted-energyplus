+def exact(row):
+    path = (ROOT / row['path']).resolve()
+    assert path.is_relative_to(ROOT) and path.is_file()
+    data = path.read_bytes()
+    assert hashlib.sha256(data).hexdigest() == row['sha256'] and len(data) == row['size_bytes']
+    return path, data
+
+def totals(plan):
+    result = {}
+    for scope in ('A', 'B'):
+        selected = [task for task in plan['tasks'] if scope in task['applicability'].split('/')]
+        def complete(task):
+            scoped = task.get('scope_gates')
+            values = scoped.get(scope) if isinstance(scoped, dict) else None
+            if not isinstance(values, dict): values = {key: task.get(key) for key in GATES}
+            return set(values) == set(GATES) and all(value == '\uD1B5\uACFC' for value in values.values())
+        result[scope] = [sum(complete(task) for task in selected), len(selected)]
+    return result

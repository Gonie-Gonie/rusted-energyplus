"""Root-only input transport for fixed15; direct6 remain a separate unavailable Rust lane."""
import copy
import hashlib
import json
from pathlib import Path
import shutil
import sys

ROOT = Path.cwd().resolve()
BASE = ROOT / '.runtime/porting/CTF-10'
PRIOR = {'path': '.runtime/porting/CTF-10/candidate-production-inputs-01/request.json', 'sha256': '10fda19a9c3bb626642f9df80fea428f84d395ab93af57226415e67536dcbbdd'}
OBSERVER = {'path': '.runtime/porting/CTF-10/init-postlude-rust-observer-prep-01/manifest.json', 'sha256': 'b089d724b65467e72564176038001e6567e51861a924cc0bcd9f94848fe19c5c'}
NATIVE_SHA = '9a664b1a4ac99b8b6b00813aaa43a59bb61bab24b3752ebaf06d22324d29160b'
GUARDS = {}

def need(ok, message):
    if not ok:
        raise ValueError(message)

def path(name):
    p = (ROOT / name).resolve()
    need(p.is_relative_to(ROOT) and p != ROOT, 'Contained repository path required')
    return p

def sha(p):
    with p.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()

def ref(p):
    return {'path': p.relative_to(ROOT).as_posix(), 'sha256': sha(p), 'size_bytes': p.stat().st_size}

def exact(row):
    p = path(row['path'])
    need(p.is_file() and sha(p) == row['sha256'], 'Input/Source SHA differs')
    need('size_bytes' not in row or type(row['size_bytes']) is int and p.stat().st_size == row['size_bytes'], 'Provided byte size differs')
    current = ref(p)
    need(current['path'] not in GUARDS or GUARDS[current['path']] == current, 'Conflicting input identity')
    GUARDS[current['path']] = current
    return p

def operand(value):
    name, digest = value.rsplit('#', 1)
    return ref(exact({'path': name, 'sha256': digest}))

def pairs(rows):
    value = {}
    for key, item in rows:
        need(key not in value, 'Duplicate JSON key')
        value[key] = item
    return value

def read(row):
    return json.loads(exact(row).read_bytes(), object_pairs_hook=pairs, parse_constant=lambda value: need(False, 'Nonfinite JSON token: ' + value))

def write(p, value):
    with p.open('x', encoding='utf8', newline='\n') as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write('\n')

need(len(sys.argv) == 4, 'native_freeze_path#SHA runtime_sources_path#SHA fresh_output_directory required')
freeze_ref = operand(sys.argv[1]); runtime_ref = operand(sys.argv[2]); out = path(sys.argv[3])
need(out.is_relative_to(BASE) and not out.exists(), 'Fresh contained CTF10 output directory required')
freeze = read(freeze_ref); runtime = read(runtime_ref); prior = read(PRIOR); observer = read(OBSERVER)
need(freeze['schema'] == 'ctf10-native-Init-postlude-frozen-inputs.v1' and freeze['frozen_before_this_execution'] is True, 'Reviewed pre-execution Native input packet required')
for key in ['expected_values_supplied', 'expected_exits_supplied', 'scientific_execution_performed', 'numerical_PASS_claimed', 'gates_updated']:
    need(freeze[key] is False, 'Input packet must supply no outcome or PASS')
need(freeze['declared_model_cases'] == 15 and freeze['declared_direct_cases'] == 6 and freeze['native_source_manifest']['sha256'] == NATIVE_SHA, 'Reviewed fixed15/direct6 Native Source required')
native_source = read(freeze['native_source_manifest']); native = read(freeze['helper_request']); admission = read(freeze['native_admission_contract'])
need(native['schema'] == 'ctf10-production-helper-cases.v1' and admission['schema'] == 'ctf10-production-native-admission-contract.v1', 'Established production packet schemas required')
need(admission['helper_request'] == freeze['helper_request'] and admission['contracts'] == freeze['contracts'] and admission['projection'] == freeze['projection'], 'Frozen admission identities differ')
need(admission['native_source_files'] == native_source['native_source_files'] and len(admission['native_source_files']) == 12, 'Reviewed twelve-source admission required')
for row in admission['native_source_files'] + list(freeze['contracts'].values()) + [freeze['projection'], freeze['observation_policy']]:
    exact(row)
for key in ['frozen_before_this_CTF10_helper_execution', 'expected_values_supplied', 'expected_exits_supplied', 'scientific_execution_performed']:
    need(native[key] is (key == 'frozen_before_this_CTF10_helper_execution') and admission[key] is native[key], 'Native input-only flags differ')
need(native['requested_counts'] == {'model_cases': 15, 'loader_phase_records': 195} and admission['requested_counts'] == native['requested_counts'], 'Literal fixed15/13-loader declaration differs')
need(native['fixed_scope'] == prior['fixed_scope'] and native['actual_scope_amendment_execution_role'] == 'real-CTF-10-Init-postlude-check-only' and admission['actual_scope_amendment_execution_role'] == native['actual_scope_amendment_execution_role'], 'Fixed scope or actual Init check role differs')
need(len(native['model_cases']) == 15 and len(native['all_45_guard_refs']) == 45, 'Complete original fixed-input ledger required')
for row in native['all_45_guard_refs']:
    exact(row)
need(set(runtime) == {'schema', 'observer_sources', 'actual_public_API_sources'} and runtime['schema'] == 'ctf10-Init-postlude-production-runtime-source-bindings.v1', 'Explicit runtime Source binding packet required')
interfaces = observer['runtime_interfaces']
for key, expected in [('observer_sources', interfaces['ordered_observer_source_paths']), ('actual_public_API_sources', interfaces['ordered_public_API_source_paths'])]:
    need([row['path'] for row in runtime[key]] == expected, 'Actual ordered own4/API58 Source inventory differs')
    for row in runtime[key]:
        exact(row)
need(len(runtime['observer_sources']) == 4 and len(runtime['actual_public_API_sources']) == 58, 'Complete actual observer/API Source inventories required')
need(len(prior['model_cases']) == 15 and prior['initial_zone_air_temperature_c'] == {'bits': '4034000000000000'}, 'Unchanged fixed15 initial caller required')
exact(prior['fixed_scope'])
for case, original in zip(prior['model_cases'], native['model_cases']):
    need(set(case) == {'id', 'input', 'conversion_available', 'epjson_input', 'conversion_unavailable_reason', 'conversion_proof_bindings'} and case['id'] == original['id'] and case['input'] == original['input'], 'Ordered original-IDF case differs')
    need(type(case['conversion_available']) is bool and case['conversion_proof_bindings'], 'Literal conversion availability and proof refs required')
    exact(case['input'])
    for row in case['conversion_proof_bindings']:
        exact(row)
    if case['conversion_available']:
        need(case['conversion_unavailable_reason'] is None, 'Available conversion cannot have an absence reason')
        exact(case['epjson_input'])
    else:
        need(case['epjson_input'] is None and isinstance(case['conversion_unavailable_reason'], str) and case['conversion_unavailable_reason'], 'Unavailable conversion must remain absent')
request = copy.deepcopy(prior)
request.update(schema=interfaces['request_schema'], observer_sources=runtime['observer_sources'], actual_public_API_sources=runtime['actual_public_API_sources'], native_helper_request=freeze['helper_request'], native_admission_contract=freeze['native_admission_contract'])
allowed = {'schema', 'observer_sources', 'actual_public_API_sources', 'native_helper_request', 'native_admission_contract'}
need(len(request) == 12 and all(request[key] == prior[key] for key in prior if key not in allowed), 'Only established transport fields may change')
need(request['frozen_before_execution'] is True and request['expected_values_supplied'] is False and request['Native_results_supplied'] is False and request['actual_Cargo_source_capture_must_match'] is True, 'Frozen input-only candidate contract required')
direct = read(freeze['direct_unit_request']); literal = read(direct['literal_case_source'])
declared = next(row['source'] for row in native_source['own_sources'] if Path(row['source']['path']).name == 'direct-unit-cases.proposed.json')
need(direct['schema'] == 'ctf10-Init-postlude-direct-unit-request.v1' and direct['literal_case_source'] == declared and direct['cases'] == literal['cases'] and len(direct['cases']) == 6, 'Separate six literal Native direct inputs required')
for key in ['frozen_before_this_helper_execution', 'expected_values_supplied', 'expected_exits_supplied', 'scientific_execution_performed']:
    need(direct[key] is (key == 'frozen_before_this_helper_execution'), 'Direct inputs must supply no result or exit')
direct_idf = exact(direct['input']); literal_idf = exact(literal['literal_IDF_source'])
need(sha(direct_idf) == sha(literal_idf), 'Direct literal IDF bytes differ')
out.mkdir()
write(out / 'production-request.json', request)
shutil.copyfile(exact(freeze['direct_unit_request']), out / 'direct-unit-request.json')
shutil.copyfile(direct_idf, out / 'direct-input.idf')
need(sha(out / 'direct-unit-request.json') == freeze['direct_unit_request']['sha256'] and sha(out / 'direct-input.idf') == direct['input']['sha256'], 'Direct transport byte copies differ')
write(out / 'input-custody.json', {'schema': 'ctf10-Init-postlude-input-only-transport.v1', 'actual_native_freeze': freeze_ref, 'actual_runtime_sources': runtime_ref, 'reviewed_observer_source_preparation': OBSERVER, 'prior_production_request': PRIOR, 'production_request': ref(out / 'production-request.json'), 'ordered_Native_model_callers': native['model_cases'], 'all_45_fixed_input_guards': native['all_45_guard_refs'], 'direct_unit_request': freeze['direct_unit_request'], 'direct_request_bytecopy': ref(out / 'direct-unit-request.json'), 'direct_input_bytecopy': ref(out / 'direct-input.idf'), 'direct_Rust_lane': None, 'direct_Rust_unavailable_reason': 'This fixed15 transport leaves the separately reviewed direct-state Rust lane to its own request and custody', 'original_names_layers_IDF_order_and_conversion_refs_unchanged': True, 'conversion_proof_semantics_revalidated': False, 'Native_results_or_expected_values_read': False, 'numerical_PASS_claimed': False, 'integration_PASS_claimed': False, 'gates_updated': False})
for row in list(GUARDS.values()):
    exact(row)
print(json.dumps({'production_request': ref(out / 'production-request.json'), 'input_custody': ref(out / 'input-custody.json'), 'direct_Rust_lane_executed': False, 'numerical_PASS_claimed': False}), flush=True)

"""Narrow top-level two-lane adapter, derived from the accepted full-event reader."""
import json

def read(path, need, unique_object, visit):
    decoder=json.JSONDecoder(object_pairs_hook=unique_object,parse_constant=lambda v:need(False,'Nonfinite JSON token: '+v))
    with path.open('r',encoding='utf8',newline='') as handle:
        buffer='';eof=False
        def more():
            nonlocal buffer,eof
            block=handle.read(65536)
            if block:buffer+=block
            else:eof=True
        def whitespace():
            nonlocal buffer
            while True:
                buffer=buffer.lstrip(' \t\r\n')
                if buffer or eof:return
                more()
        def literal(token):
            nonlocal buffer
            whitespace()
            while len(buffer)<len(token) and not eof:more()
            need(buffer.startswith(token),'Whole-Init JSON delimiter differs: '+token);buffer=buffer[len(token):]
        def value():
            nonlocal buffer
            whitespace()
            while True:
                try:v,end=decoder.raw_decode(buffer)
                except json.JSONDecodeError:
                    if eof:raise
                    more();continue
                if end==len(buffer) and not eof:more();continue
                buffer=buffer[end:];return v
        literal('{');top={};seen=set();arrays=set();whitespace()
        if not buffer.startswith('}'):
            while True:
                key=value();need(type(key) is str and key not in seen,'Unique top-level key required');seen.add(key);literal(':')
                if key in ['model_cases','direct_unit_cases']:
                    arrays.add(key);literal('[');whitespace();ordinal=0
                    if not buffer.startswith(']'):
                        while True:
                            row=value();need(type(row) is dict,'Complete actual case object required');ordinal+=1;visit(key,ordinal,row);whitespace()
                            if buffer.startswith(']'):break
                            literal(',')
                    literal(']');top[key]={'streamed_case_count':ordinal}
                else:top[key]=value()
                whitespace()
                if buffer.startswith('}'):break
                literal(',')
        literal('}');whitespace();need(eof and not buffer,'Trailing/partial whole-Init JSON rejected')
        need(arrays=={'model_cases','direct_unit_cases'},'Both complete actual lanes required');return top

"""Source-only Native06 pin successors; no project helper or target invocation."""
import argparse
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent
BASE = OUT.parent

def ref(p):
    raw = p.read_bytes()
    return dict(path=p.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(raw).hexdigest(), size_bytes=len(raw), line_count=len(raw.splitlines()))

def put(p, raw):
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as stream: stream.write(raw)

def delta(a, b, p):
    put(p, ''.join(difflib.unified_diff(a.read_bytes().decode().splitlines(True), b.read_bytes().decode().splitlines(True), fromfile=a.relative_to(ROOT).as_posix(), tofile=b.relative_to(ROOT).as_posix(), n=3)).encode())
    return ref(p)

def main(native_sha):
    assert not (OUT / 'manifest.json').exists()
    old = BASE / 'init-postlude-direct-rust-observer-prep-02'
    assert ref(old / 'manifest.json')['sha256'] == 'beef016a72873faad6e5d80db580ba1c3773b454fc4b40b31e7f7f744428c80b'
    native = BASE / 'native-init-postlude-prep-06/manifest.json'
    assert ref(native)['sha256'] == native_sha
    nref = ref(native); m = json.loads((old / 'manifest.json').read_bytes())
    old_pin = m['runtime_interfaces']['current_native_source_manifest']['sha256']
    rows = []; narrow = []
    for i, row in enumerate(m['own_sources']):
        name = row['canonical_path']; original = (ROOT / row['proposal']['path']).read_bytes(); body = original
        if i == 0:
            assert body.count(old_pin.encode()) == 1 and body.count(b'reviewed Native04 Source required') == 1
            body = body.replace(old_pin.encode(), native_sha.encode()).replace(b'reviewed Native04 Source required', b'reviewed Native06 Source required')
            assert body.replace(native_sha.encode(), old_pin.encode()).replace(b'reviewed Native06 Source required', b'reviewed Native04 Source required') == original
        proposal = OUT / 'proposed' / name; before = OUT / 'before' / name; prior = OUT / 'before-02' / name
        put(proposal, body); put(before, (ROOT / row['before_archive']['path']).read_bytes()); put(prior, original)
        suffix = name.replace('/', '__') + '.diff'
        rows.append(dict(canonical_path=name, proposal=ref(proposal), before_archive=ref(before), exact_diff=delta(before, proposal, OUT / 'diffs' / suffix), new_destination_absent=True))
        narrow.append(dict(source=ref(proposal), before_archive=ref(prior), immutable02_source=row['proposal'], exact_diff=delta(prior, proposal, OUT / 'from-02-diffs' / suffix)))
        assert not (ROOT / name).exists()
    put(OUT / 'before-02/manifest.json', (old / 'manifest.json').read_bytes())
    put(OUT / 'before-02/README.md', (old / 'README.md').read_bytes())
    put(OUT / 'README.md', (old / 'README.md').read_bytes() + b'''

Source03 binds reviewed Native06 after the five direct numeric seed transports
were corrected to read the unchanged literal JSON numbers. Only the main's
Native manifest SHA and its cosmetic Native06 error label change. The inverse
restores02 exactly; both supports are byte-exact02. Own3/API59, input-only six,
real report conversion/parser/compiler, once-only entry and retained error owners
are unchanged. No Native result, fixture, formula, schema or gate is altered.
This successor is held and unexecuted; the failed Native05 capture stays separate
and unreleased. No canonical, Cargo, formatter, target or Git operation occurs.
''')
    m['own_sources'] = rows; m['application_sources'] = rows; m['from02_source_correspondence'] = narrow
    m['predecessor_manifest'] = ref(old / 'manifest.json'); m['predecessor_manifest_archive'] = ref(OUT / 'before-02/manifest.json')
    m['source_dependencies'].append(nref); m['runtime_interfaces']['current_native_source_manifest'] = nref
    m['README'] = ref(OUT / 'README.md'); m['README_before02'] = ref(OUT / 'before-02/README.md')
    m['README_exact_diff'] = delta(OUT / 'before-02/README.md', OUT / 'README.md', OUT / 'from-02-diffs/README.md.diff')
    m['authoring_source'] = ref(Path(__file__)); m['authorship_limit'] += ' Header authored03 pin/label successor; independent narrow review remains required.'
    whole = set(); ranges = set()
    def verify(v):
        if isinstance(v, dict):
            if {'path','sha256'} <= v.keys():
                raw = (ROOT / v['path']).read_bytes()
                if 'start_line' in v:
                    raw = b''.join(raw.splitlines(True)[v['start_line']-1:v['end_line']]); ranges.add((v['path'],v['start_line'],v['end_line']))
                else: whole.add((v['path'],v['sha256']))
                assert hashlib.sha256(raw).hexdigest() == v['sha256'], v
                if 'size_bytes' in v: assert len(raw) == v['size_bytes'], v
                if 'line_count' in v: assert len(raw.splitlines()) == v['line_count'], v
            for x in v.values(): verify(x)
        elif isinstance(v, list):
            for x in v: verify(x)
    verify(m); ast.parse(Path(__file__).read_bytes()); put(OUT / 'manifest.json', (json.dumps(m, indent=2) + '\n').encode())
    print(json.dumps(dict(direct_observer=ref(OUT / 'manifest.json'), unique_whole=len(whole), typed_ranges=len(ranges))))

if __name__ == '__main__':
    p = argparse.ArgumentParser(description=__doc__); p.add_argument('--native-sha256', required=True)
    main(p.parse_args().native_sha256)

template<class Array, class Copy> json allocated_rows(Array const &owner, Copy const &copy)
{
    json rows = json::array();
    if (owner.allocated()) {
        for (int index = owner.l(); index <= owner.u(); ++index) {
            rows.push_back({{"actual_array_index", index}, {"value", copy(owner(index))}});
        }
    }
    return {{"allocated", owner.allocated()}, {"size", owner.size()},
        {"lower", owner.allocated() ? json(owner.l()) : json(nullptr)},
        {"upper", owner.allocated() ? json(owner.u()) : json(nullptr)}, {"rows", rows}};
}
inline json predefined_registry_owner(EnergyPlus::EnergyPlusData const &state)
{
    auto const &s = *state.dataOutRptPredefined;
    json named = json::array();
#define CTF10_COPY_INDEX(name) named.push_back({{"name", #name}, {"value", s.name}});
#include "ctf10_predefined_named_fields.inc"
#undef CTF10_COPY_INDEX
    auto const report = allocated_rows(s.reportName, [](auto const &v) -> json {
        return {{"name", v.name}, {"namewithspaces", v.namewithspaces}, {"abrev", v.abrev}, {"show", v.show}};
    });
    auto const subtable = allocated_rows(s.subTable, [](auto const &v) -> json {
        return {{"name", v.name}, {"indexReportName", v.indexReportName}, {"footnote", v.footnote}};
    });
    auto const column = allocated_rows(s.columnTag, [](auto const &v) -> json {
        return {{"heading", v.heading}, {"indexSubTable", v.indexSubTable}};
    });
    auto const entry = allocated_rows(s.tableEntry, [](auto const &v) -> json {
        return {{"charEntry", v.charEntry}, {"objectName", v.objectName}, {"indexColumn", v.indexColumn},
            {"subTableIndex", v.subTableIndex}, {"uniqueObjName", v.uniqueObjName},
            {"origRealEntry", scalar(v.origRealEntry)}, {"significantDigits", v.significantDigits},
            {"origEntryIsReal", v.origEntryIsReal}};
    });
    auto const component = allocated_rows(s.CompSizeTableEntry, [](auto const &v) -> json {
        return {{"typeField", v.typeField}, {"nameField", v.nameField}, {"description", v.description},
            {"valField", scalar(v.valField)}, {"strField", v.strField}, {"active", v.active}, {"written", v.written}};
    });
    auto const shadow = allocated_rows(s.ShadowRelate, [](auto const &v) -> json {
        return {{"castSurf", v.castSurf}, {"recSurf", v.recSurf}, {"recKind", v.recKind}};
    });
    return {{"named_indices", named}, {"pdchOpqConsLayCol", s.pdchOpqConsLayCol},
        {"sizeReportName", s.sizeReportName}, {"numReportName", s.numReportName}, {"reportName", report},
        {"sizeSubTable", s.sizeSubTable}, {"numSubTable", s.numSubTable}, {"subTable", subtable},
        {"sizeColumnTag", s.sizeColumnTag}, {"numColumnTag", s.numColumnTag}, {"columnTag", column},
        {"sizeTableEntry", s.sizeTableEntry}, {"numTableEntry", s.numTableEntry}, {"tableEntry", entry},
        {"sizeCompSizeTableEntry", s.sizeCompSizeTableEntry}, {"numCompSizeTableEntry", s.numCompSizeTableEntry},
        {"CompSizeTableEntry", component}, {"sizeShadowRelate", s.sizeShadowRelate},
        {"numShadowRelate", s.numShadowRelate}, {"ShadowRelate", shadow},
        {"LEEDelecCostTotal", scalar(s.LEEDelecCostTotal)}, {"LEEDgasCostTotal", scalar(s.LEEDgasCostTotal)}, {"LEEDothrCostTotal", scalar(s.LEEDothrCostTotal)},
        {"TotalNotMetHeatingOccupiedForABUPS", scalar(s.TotalNotMetHeatingOccupiedForABUPS)}, {"TotalNotMetCoolingOccupiedForABUPS", scalar(s.TotalNotMetCoolingOccupiedForABUPS)}, {"TotalNotMetOccupiedForABUPS", scalar(s.TotalNotMetOccupiedForABUPS)}, {"TotalTimeNotSimpleASH55EitherForABUPS", scalar(s.TotalTimeNotSimpleASH55EitherForABUPS)}, {"TotalVozMax", scalar(s.TotalVozMax)}, {"TotalAnyZoneBelowVozDynForOA", scalar(s.TotalAnyZoneBelowVozDynForOA)}, {"TotalAllZonesAtVozDynForOA", scalar(s.TotalAllZonesAtVozDynForOA)}, {"TotalAnyZoneAboveVozDynForOA", scalar(s.TotalAnyZoneAboveVozDynForOA)}, {"TotalAnyZoneBelowVozDynOccForOA", scalar(s.TotalAnyZoneBelowVozDynOccForOA)}, {"TotalAllZonesAtVozDynOccForOA", scalar(s.TotalAllZonesAtVozDynOccForOA)}, {"TotalAnyZoneAboveVozDynOccForOA", scalar(s.TotalAnyZoneAboveVozDynOccForOA)}, {"TotalAnyZoneVentUnoccForOA", scalar(s.TotalAnyZoneVentUnoccForOA)}, {"TotalAnyAirLoopBelowVozDynForOA", scalar(s.TotalAnyAirLoopBelowVozDynForOA)}, {"TotalAllAirLoopsAtVozDynForOA", scalar(s.TotalAllAirLoopsAtVozDynForOA)}, {"TotalAnyAirLoopAboveVozDynForOA", scalar(s.TotalAnyAirLoopAboveVozDynForOA)}, {"TotalAnyAirLoopBelowVozDynOccForOA", scalar(s.TotalAnyAirLoopBelowVozDynOccForOA)}, {"TotalAllAirLoopsAtVozDynOccForOA", scalar(s.TotalAllAirLoopsAtVozDynOccForOA)}, {"TotalAnyAirLoopAboveVozDynOccForOA", scalar(s.TotalAnyAirLoopAboveVozDynOccForOA)}, {"TotalAnyAirLoopVentUnoccForOA", scalar(s.TotalAnyAirLoopVentUnoccForOA)}, {"full_allocated_tails_copied", true}, {"registry_or_table_recomputed", false}};
}
inline json error_backend_owner(EnergyPlus::EnergyPlusData const &state)
{
    auto const &e = *state.dataErrTracking;
    return {{"TotalWarningErrors", e.TotalWarningErrors}, {"TotalSevereErrors", e.TotalSevereErrors},
        {"TotalWarningErrorsDuringWarmup", e.TotalWarningErrorsDuringWarmup},
        {"TotalSevereErrorsDuringWarmup", e.TotalSevereErrorsDuringWarmup},
        {"TotalWarningErrorsDuringSizing", e.TotalWarningErrorsDuringSizing},
        {"TotalSevereErrorsDuringSizing", e.TotalSevereErrorsDuringSizing},
        {"LastSevereError", e.LastSevereError}, {"AbortProcessing", e.AbortProcessing},
        {"MatchCounts", allocated_rows(e.MatchCounts, [](int v) -> json { return v; })},
        {"WarmupFlag", state.dataGlobal->WarmupFlag}, {"DoingSizing", state.dataGlobal->DoingSizing},
        {"KickOffSimulation", state.dataGlobal->KickOffSimulation},
        {"DoingInputProcessing", state.dataGlobal->DoingInputProcessing},
        {"printConsoleOutput", state.dataGlobal->printConsoleOutput},
        {"outputErrorHeader", state.dataUtilityRoutines->outputErrorHeader},
        {"error_stream_present", state.files.err_stream != nullptr},
        {"errorCallback_present", static_cast<bool>(state.dataGlobal->errorCallback)},
        {"messageCallback_present", static_cast<bool>(state.dataGlobal->messageCallback)},
        {"fMessagePtr_present", state.dataGlobal->fMessagePtr != nullptr},
        {"sqlite_present", state.dataSQLiteProcedures->sqlite != nullptr},
        {"sqlite_operations_observed", false}, {"optional_OutUnit_arguments_supplied_by_Init", false},
        {"VerStringVar", state.dataStrGlobals->VerStringVar}, {"IDDVerString", state.dataStrGlobals->IDDVerString},
        {"CurrentDateTime", state.dataStrGlobals->CurrentDateTime},
        {"source_version_and_date_header_bytes_paired_with_production_Rust", false}};
}
inline json init_postlude_owner(EnergyPlus::EnergyPlusData const &state)
{
    return {{"registry", predefined_registry_owner(state)}, {"scan_cache", ScanUnit::cache(state)},
        {"backend", error_backend_owner(state)}, {"DoZoneSizing", state.dataGlobal->DoZoneSizing},
        {"DoSystemSizing", state.dataGlobal->DoSystemSizing}, {"DoPlantSizing", state.dataGlobal->DoPlantSizing},
        {"SimpleCTFOnly", state.dataHeatBal->SimpleCTFOnly}, {"MaxCTFTerms", state.dataHeatBal->MaxCTFTerms},
        {"AnyInternalHeatSourceInInput", state.dataHeatBal->AnyInternalHeatSourceInInput}};
}

"""Seal only a held Source successor; never import or invoke run_batch.py."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent
BASE = OUT.parent
PRIOR = BASE / 'init-postlude-batch-application-prep-01'

def ref(p):
    body = p.read_bytes()
    return dict(path=p.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(body).hexdigest(), size_bytes=len(body))

def exact(r):
    p = ROOT / r['path']
    assert ref(p)['sha256'] == r['sha256']
    assert 'size_bytes' not in r or p.stat().st_size == r['size_bytes']
    return p

def put(p, body):
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as stream: stream.write(body)

def diff(p, a, b):
    put(p, ''.join(difflib.unified_diff(a.read_bytes().decode().splitlines(True), b.read_bytes().decode().splitlines(True), fromfile=a.relative_to(ROOT).as_posix(), tofile=b.relative_to(ROOT).as_posix())).encode())
    return ref(p)

def main():
    assert not (OUT / 'manifest.json').exists()
    prior_ref = ref(PRIOR / 'manifest.json')
    assert prior_ref['sha256'] == 'f3278411ea902c75f8a7d43edd13728455c3544451c119133e78d0ebc35b7f98'
    old = json.loads(exact(prior_ref).read_bytes())
    chosen = [
        ('reviewed_direct_observer_source', 'init-postlude-direct-rust-observer-prep-03', 'd5f9f845b12181b681efda876eb3150672e3d7b8b69cb0e02f7fc175243cba7c'),
        ('reviewed_native_workflow_source', 'native-init-postlude-workflow-prep-05', '382e65cf9aca2879cf4e0eff5da0f5ed889105ba5fcf95d634da7b7db7f8a3c7'),
        ('reviewed_native_source', 'native-init-postlude-prep-06', '9a664b1a4ac99b8b6b00813aaa43a59bb61bab24b3752ebaf06d22324d29160b'),
    ]
    new = copy.deepcopy(old)
    bindings = []
    for key, folder, pin in chosen:
        r = ref(BASE / folder / 'manifest.json'); assert r['sha256'] == pin
        bindings.append(dict(field=key, before=old[key], after=r)); new[key] = r
    direct = json.loads(exact(new['reviewed_direct_observer_source']).read_bytes())
    new['held_application_sources'] = copy.deepcopy(old['held_application_sources'][:9])
    for row in direct['application_sources']:
        new['held_application_sources'].append(dict(canonical_path=row['canonical_path'], source_preparation=new['reviewed_direct_observer_source'], reviewed_source_authority=row['proposal'], held_before_archive=row['before_archive'], exact_held_diff=row['exact_diff'], new_destination_absent=row['new_destination_absent']))
    rows = new['held_application_sources']
    assert len(rows) == len({r['canonical_path'] for r in rows}) == 12
    assert sum(r['new_destination_absent'] for r in rows) == 7
    assert new['direct_observer_paths'] == direct['runtime_interfaces']['ordered_observer_source_paths']
    regenerated = 0
    for row in rows:
        before = exact(row['held_before_archive']).read_bytes() if row['held_before_archive'] else b''
        after = exact(row['reviewed_source_authority']).read_bytes(); target = ROOT / row['canonical_path']
        assert (row['new_destination_absent'] and before == b'' and not target.exists()) or (not row['new_destination_absent'] and target.read_bytes() == before)
        delta = exact(row['exact_held_diff']).read_bytes(); labels = delta.decode().splitlines()
        assert ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=labels[0][4:], tofile=labels[1][4:])).encode() == delta
        regenerated += 1
    before_refs = {}
    for name in ['manifest.json', 'README.md', 'run_batch.py', 'seal_sources.py']:
        p = OUT / 'before-01' / name; put(p, (PRIOR / name).read_bytes()); before_refs[name] = ref(p)
    source = OUT / 'run_batch.py'; put(source, exact(old['workflow_source']).read_bytes()); ast.parse(source.read_bytes())
    assert source.read_bytes() == exact(old['workflow_source']).read_bytes()
    note = b'\n\nSource02 updates only reviewed authority bindings: direct observer03, Native06,\nand recovery workflow05. The 140-line application/quality runner is byte-exact01.\nThe first nine application rows remain literal01; the final three refer to\nobserver03 whose only executable delta is the Native06 pin and cosmetic label.\nAll twelve before/absence checks and held diffs are freshly verified. The five\nexisting canonical parents remain Source-cae bytes, and seven destinations remain\nabsent. No canonical source, input, report formula, API order or quality command\nis changed by this hold.\n\nRoot must still supply a genuine successful workflow05 completion and its factual\nQA release before application. The failed Native05 capture remains unreleased\nin the workflow05 authority; no future receipt, result or snapshot is supplied.\nFormatter review precedes the one four-command quality08 round. This Source-only\nsuccessor performs no import, target, Cargo, formatter, canonical or Git action.\n'
    put(OUT / 'README.md', exact(old['README']).read_bytes() + note)
    new['workflow_source'] = ref(source); new['README'] = ref(OUT / 'README.md')
    new['exact_source_diff'] = diff(OUT / 'run_batch.py.diff', exact(old['reused_actual_Root_source_templates'][0]['before_archive']), source)
    new['authoring_source'] = ref(Path(__file__))
    new['predecessor_manifest'] = prior_ref; new['before_01'] = before_refs
    new['from_01_source_diff'] = diff(OUT / 'from-01-diffs/run_batch.py.diff', exact(before_refs['run_batch.py']), source)
    new['from_01_README_diff'] = diff(OUT / 'from-01-diffs/README.md.diff', exact(before_refs['README.md']), OUT / 'README.md')
    change = dict(schema='ctf10-Init-postlude-batch-authority-source-delta.v1', changed_authority_fields=bindings, unchanged_runner=ref(source), unchanged_first_nine_application_rows=True, refreshed_direct_application_rows=rows[9:], runtime_interfaces_unchanged=True, execution_performed=False)
    put(OUT / 'authority-bindings.delta.json', (json.dumps(change, indent=2) + '\n').encode())
    new['exact_authority_binding_delta'] = ref(OUT / 'authority-bindings.delta.json')
    new['Source_only_checks']['regenerated_held_source_diffs'] = regenerated
    new['Source_only_checks']['runner_byte_exact_01'] = True
    new['Source_only_checks']['changed_binding_count'] = 3
    all_refs = set()
    def verify(v):
        if isinstance(v, dict):
            if {'path', 'sha256'} <= v.keys(): exact(v); all_refs.add((v['path'], v['sha256']))
            for x in v.values(): verify(x)
        elif isinstance(v, list):
            for x in v: verify(x)
    verify(new); ast.parse(Path(__file__).read_bytes())
    put(OUT / 'manifest.json', (json.dumps(new, indent=2, allow_nan=False) + '\n').encode())
    print(json.dumps(dict(manifest=ref(OUT / 'manifest.json'), unique_whole=len(all_refs), exact_held_diffs=regenerated, runner_byte_exact_01=True)))

if __name__ == '__main__': main()

"""Source-defined stage/identity joins, with every unavailable obligation retained."""


def partition(record,stage,c,path,load):
    if type(record) is not dict or record.get('available') is not True:
        c.absence(path,False,True,'Required actual Native '+stage+' partition unavailable');return None
    value=load(record['owner_file'])
    c.exact(path+'/schema','ctf10-actual-Init-postlude-owner.v1',value.get('schema'))
    c.exact(path+'/stage',stage,record.get('stage'));c.exact(path+'/copied_stage',stage,value.get('stage'))
    return value.get('owner')


def one(records,stage,need):
    rows=[v for v in records if v['stage']==stage];need(len(rows)<=1,'Unique actual partition stage required')
    return rows[0] if rows else None


def facts(value,pair,need):
    if type(value) is dict:
        if 'value_bits' in value or 'value_class' in value:return pair.bits(value,need)
        return {key:facts(v,pair,need) for key,v in value.items()}
    if type(value) is list:return [facts(v,pair,need) for v in value]
    return value


def preprocessing(c,path,operation,state,pair,need):
    retained=state.get('retained_preprocessing')
    for stage,key in [('PostLoad','after_load'),('PostMerge','after_merge'),('PostConversion','after_conversion')]:
        observed=operation['observations'][stage]
        actual=retained.get(key) if type(retained) is dict else None
        c.exact(path+'/'+stage+'/reached',observed['reached'],actual is not None)
        if not observed['reached']:continue
        n=observed.get('snapshot')
        if not pair.required(c,path+'/'+stage,n,actual):continue
        r=actual['active'] if stage=='PostConversion' else actual
        for name in ['LayersInConstruct','NumResLayers']:c.exact(path+'/'+stage+'/'+name,n[name],r[name])
        c.tree(path+'/'+stage+'/active_prefix',facts(n['active_prefix'],pair,need),facts(r['active_prefix'],pair,need))
        if stage=='PostConversion':
            for nk,rk in [('dyn','dyn'),('rs','rs'),('cnd','cnd')]:pair.scalar(c,path+'/'+stage+'/'+nk,n[nk],actual[rk],need)


def public(c,path,operation,rust,pair,need,material_ids=None,construction_join=None):
    ledger=operation['observations']['PublicStorage'];before=pair.checkpoint(ledger['before_reset'])
    returned=pair.checkpoint(ledger['actual_caller_return']);partial=pair.checkpoint(ledger['scope_exit'])
    if type(before) is not dict:
        c.absence(path+'/before_reset',False,type(rust) is dict,'Actual invoked public before-reset owner is required');return
    if type(rust) is not dict:
        if returned is not None:c.absence(path+'/returned',True,False,'Actual returned Native owner cannot be paired with missing Rust storage')
        else:pair.unpaired(c,path+'/partial','Native unreturned partial storage has no retained production State owner')
        return
    if 'snapshot' in rust:
        current=rust.get('snapshot');storage=current.get('public_storage') if type(current) is dict else None
        c.exact(path+'/actual_Rust_invocation',True,rust.get('actual_public_initializer_invoked'))
        c.exact(path+'/used',before['IsUsedCTF'],rust.get('actual_Rust_is_used_ctf'))
        if material_ids is not None:
            need(all(v in material_ids for v in before['original_LayerPoint']),'Actual original material IDs need declared input joins')
            c.tree(path+'/original_material_ids',[material_ids[v] for v in before['original_LayerPoint']],rust['original_material_ids'])
        flags=rust.get('actual_retry_flags_on_return') if before['IsUsedCTF'] else rust.get('actual_unused_reset_flags')
    else:
        storage=rust.get('public_storage');flags=rust.get('actual_shared_flags')
    eligible=returned is not None and not before['SourceSinkPresent'] and before['SolutionDimensions']==1 and \
        type(returned['NumCTFTerms']) is int and 0<=returned['NumCTFTerms']<=18
    if eligible:
        pair.storage(c,path+'/actual_returned_storage',returned,storage,need,numeric=True)
        if pair.required(c,path+'/return_flags',returned,flags):
            for key in ['ErrorsFound','DoCTFErrorReport']:c.exact(path+'/return_flags/'+key,returned[key],flags.get(key))
    else:
        pair.unpaired(c,path+'/numerical_selection','Actual nonreturned/source/2D/out-of-capacity route is excluded from numerical PASS',returned is not None,type(storage) is dict)
        if partial is not None and storage is not None:
            pair.storage(c,path+'/retained_partial_copy_facts',partial,storage,need,numeric=False)
    reset=pair.checkpoint(ledger['after_reset'])
    if pair.required(c,path+'/actual_reset',reset,reset):
        for name in pair.ARRAYS:
            need(type(reset[name]) is list and len(reset[name])==19,'Complete actual fixed19 reset array required')
            for index,value in enumerate(reset[name]):
                c.exact(path+'/actual_Native_reset/'+name+'/'+str(index),'0000000000000000',pair.bits(value,need)['value_bits'])
    reverse=ledger['reverse_completed'];route=rust.get('snapshot')
    route=route.get('actual_Rust_route') if type(route) is dict else rust.get('construction_return_route')
    import re
    match=re.fullmatch(r'Reversed \{ construction_id: ConstructionId\((\d+)\), declared_index: (\d+) \}',route or '')
    c.exact(path+'/actual_reverse_return',reverse['reached'],match is not None)
    if reverse['reached']:
        provider=pair.checkpoint(reverse['actual_provider'])
        if type(provider) is not dict:c.absence(path+'/reverse_provider',False,match is not None,'Reached actual reverse provider missing')
        elif match is not None:
            actual=(construction_join or {}).get(provider['actual_construction_index'])
            if actual is None:c.absence(path+'/reverse_declared_provider',True,False,'Actual earlier provider has no genuine declared Rust join')
            else:
                c.exact(path+'/reverse_provider_id',actual['id'],int(match[1]));c.exact(path+'/reverse_provider_declared_index',actual['index'],int(match[2]))
                pair.storage(c,path+'/actual_provider_storage',provider,actual['storage'],need,numeric=False)


def case(c,path,lane,native,rust,supplied,load,pair,need):
    if not pair.required(c,path,native,rust):return
    c.exact(path+'/id',supplied['id'],native.get('id'));c.exact(path+'/Rust_id',supplied['id'],rust.get('id'))
    direct=lane=='direct_unit_cases';whole=native['whole_Init']
    calls=rust.get('direct_initializer_invocation_count') if direct else rust.get('selected_Init_postlude',{}).get('ordinary_initializer_invocation_count')
    c.exact(path+'/actual_Init_invocation_count',int(whole['actual_source_invoked']),calls)
    if not whole['actual_source_invoked']:
        invoked=rust.get('direct_initializer_invoked') if direct else rust.get('selected_Init_postlude',{}).get('ordinary_initializer_invoked')
        c.exact(path+'/Init_invoked',False,invoked)
        pair.unpaired(c,path+'/Init_prerequisite','Actual Native preparation did not invoke Init; unavailable outcome is never PASS',False,invoked is True)
        return
    if direct:
        c.tree(path+'/literal_input',supplied,rust.get('actual_input_row'))
        c.exact(path+'/literal_IDF',native['actual_raw_input']['sha256'],rust['actual_raw_input']['sha256'])
        invoked=rust.get('direct_initializer_invoked');initialization=rust.get('initialization') or {};error=initialization.get('error')
        before=rust.get('caller_before_initializer');after=rust.get('caller_after_return_or_error')
        source_to_declared={1:0};records=native['preparation_owner_records']
        default_before=partition(one(records,'BeforeRegistry',need),'BeforeRegistry',c,path+'/BeforeRegistry',load)
        n_before=partition(whole.get('before_postlude_owner'),'BeforeInit',c,path+'/BeforeInit',load)
        endpoint=whole['after_postlude_owner']['stage']
        n_after=partition(whole['after_postlude_owner'],endpoint,c,path+'/'+endpoint,load)
        state=rust.get('direct_state_after_return_or_error')
        registry=rust.get('initial_registry') or {};c.exact(path+'/initial_registry_invoked',True,registry.get('invoked'))
        c.exact(path+'/initial_registry_returned',True,registry.get('status')=='source-returned')
        if default_before is not None and type(registry.get('caller_before')) is dict:
            pair.reports(c,path+'/BeforeRegistry',default_before,registry['caller_before']['reports'],need)
        elif default_before is not None:c.absence(path+'/BeforeRegistry/Rust',True,False,'Required genuine default caller registry owner unavailable')
        initial=partition(one(records,'AfterRegistry',need),'AfterRegistry',c,path+'/AfterRegistry',load)
        if initial is not None and type(registry.get('caller_after')) is dict:
            pair.reports(c,path+'/AfterRegistry',initial,registry['caller_after']['reports'],need)
        elif initial is not None:c.absence(path+'/AfterRegistry/Rust',True,False,'Required real Rust registry call owner unavailable')
        c.exact(path+'/setup_length',len(native['setup_calls']),len(rust['setup_calls']))
        for index,(a,b) in enumerate(zip(native['setup_calls'],rust['setup_calls'])):
            c.exact(path+'/setup/'+str(index)+'/action',a['action'],b['action'])
            c.exact(path+'/setup/'+str(index)+'/invoked',a['actual_source_invoked'],b['actual_source_invoked'])
            c.exact(path+'/setup/'+str(index)+'/returned',a['call_outcome']['status']=='source_returned',b['status']=='source-returned')
            c.exact(path+'/setup/'+str(index)+'/assigned_report',a.get('assigned_report'),b.get('assigned_report'))
        pair.callbacks(c,path+'/callbacks',native['backend_callbacks'],after.get('backend_callbacks',[]) if type(after) is dict else [],need)
        if type(after) is dict:
            prefix=after['prefixes']['eio'];raw=load(native['source_diagnostics']['logs']['eio'],raw=True)
            need(type(prefix['hex']) is str and len(prefix['hex'])==2*prefix['size_bytes'],'Complete Rust EIO bytes required')
            c.exact(path+'/complete_direct_EIO',raw.hex(),prefix['hex'])
    else:
        post=rust.get('selected_Init_postlude',{});invoked=post.get('ordinary_initializer_invoked')
        initialization=rust['initialization'];error=post.get('error');before=post.get('caller_before_initializer');after=post.get('caller_after_return_or_error')
        c.tree(path+'/original_IDF',supplied['input'],native['actual_input']);c.tree(path+'/Rust_original_IDF',supplied['input'],rust['input'])
        records=native['postlude_owner_records'];n_before=partition(one(records,'BeforeInit',need),'BeforeInit',c,path+'/BeforeInit',load)
        default_before=partition(one(records,'BeforeRegistry',need),'BeforeRegistry',c,path+'/BeforeRegistry',load)
        if default_before is not None and type(before) is dict:
            pair.reports(c,path+'/BeforeRegistry_to_actual_Rust_caller_before_producer',default_before,before['reports'],need)
        elif default_before is not None:c.absence(path+'/BeforeRegistry/Rust_caller',True,False,'Required actual Rust caller before the producer is unavailable')
        pair.unpaired(c,path+'/BeforeInit_caller_stage','Native registry and thirteen loaders precede BeforeInit; Rust before_initializer precedes its genuine registry/cache producer. No equivalent intermediate Rust caller snapshot is retained',n_before is not None,False)
        endpoint='AfterInitReturn' if whole['call_outcome']['status']=='source_returned' else 'AfterInitOuterCatch'
        n_after=partition(one(records,endpoint,need),endpoint,c,path+'/'+endpoint,load)
        typed=rust.get('typed_owners');source_to_declared={};material_ids={}
        original=native['initialized_owners'].get('snapshot')
        if pair.required(c,path+'/declared_input_owners',original,typed):
            names=rust['typed_report_inputs'];cnames={v['id']:v['name'] for v in names['loader_construction_names']};mnames={v['id']:v['name'] for v in names['loader_material_names']}
            c.exact(path+'/declared_construction_count',len(original['constructions']),len(typed['constructions']))
            c.exact(path+'/declared_material_count',len(original['materials']),len(typed['materials']))
            for index,(a,b) in enumerate(zip(original['materials'],typed['materials'])):
                c.exact(path+'/material/'+str(index)+'/Native_index',index+1,a['array_index']);c.exact(path+'/material/'+str(index)+'/Rust_index',index,b['model_vector_index'])
                c.exact(path+'/material/'+str(index)+'/loader_name',a['Name'],mnames.get(b['id']));material_ids[a['array_index']]=b['id']
            for index,(a,b) in enumerate(zip(original['constructions'],typed['constructions'])):
                c.exact(path+'/construction/'+str(index)+'/Native_index',index+1,a['array_index']);c.exact(path+'/construction/'+str(index)+'/Rust_index',index,b['model_vector_index'])
                c.exact(path+'/construction/'+str(index)+'/loader_name',a['Name'],cnames.get(b['id']));source_to_declared[a['array_index']]=index
        state=post.get('public_owner')
        rows=state.get('constructions',[]) if type(state) is dict and state.get('owner_available') is True else []
        construction_join={}
        for actual_index,index in source_to_declared.items():
            row=rows[index] if index<len(rows) else None
            value=row.get('snapshot') if type(row) is dict else None
            construction_join[actual_index]=dict(index=index,id=typed['constructions'][index]['id'],storage=value.get('public_storage') if type(value) is dict else None)
        c.exact(path+'/actual_public_owner_rows',len(original['constructions']) if type(original) is dict else 0,len(rows))
        for operation in native['operations']:
            index=source_to_declared.get(operation['actual_construction_index']);r=rows[index] if index is not None and index<len(rows) else None
            if type(r) is dict:
                c.exact(path+'/public/'+str(index)+'/declared_index',index,r.get('declared_index'))
                c.exact(path+'/public/'+str(index)+'/construction_id',typed['constructions'][index]['id'],r.get('construction_id'))
            public(c,path+'/public/'+str(operation['actual_construction_index']),operation,r,pair,need,material_ids,construction_join)
        pair.unpaired(c,path+'/production_streams','Full Native loader/preparation/EIO/error/console bytes retained; no invented BeforeInit prefix or header stripping',True,type(after) is dict)
    pair.outcome(c,path+'/whole_Init',whole,initialization.get('status'),invoked,error)
    stages=[('BeforeInit',n_before,before),(endpoint,n_after,after)] if direct else [(endpoint,n_after,after)]
    for stage,n,r in stages:
        if pair.required(c,path+'/'+stage,n,r):
            pair.reports(c,path+'/'+stage+'/reports',n,r['reports'],need)
            pair.backend(c,path+'/'+stage+'/backend',n['backend'],r['backend'],need,direct)
    observation=whole.get('observations')
    if type(after) is dict:pair.progress(c,path+'/reached_postlude',observation,after['reports']['progress'],need,source_to_declared)
    if direct:
        operations=native['operations'];c.exact(path+'/single_actual_Construction',1,len(operations))
        entry=rust.get('direct_state_before_initializer')
        if operations:
            n_entry=pair.checkpoint(operations[0]['observations']['PublicStorage']['before_reset'])
            pair.storage(c,path+'/actual_direct_public_before_reset',n_entry,
                entry.get('public_storage') if type(entry) is dict else None,need,numeric=False)
        if operations and type(state) is dict:
            public(c,path+'/retained_direct_public',operations[0],state,pair,need)
            preprocessing(c,path+'/retained_preprocessing',operations[0],state,pair,need)
            flags=state['actual_shared_flags'];events=observation['events'] if type(observation) is dict else []
            if events:
                for key in ['ErrorsFound','DoCTFErrorReport']:c.exact(path+'/actual_final_flags/'+key,events[-1]['snapshot'][key],flags[key])
            c.exact(path+'/direct_init_return',whole['call_outcome']['status']=='source_returned',state['init_returned'])
        elif operations:c.absence(path+'/retained_direct_state',True,False,'Required caller-retained direct state is absent after the actual invocation')
    if n_after is not None and type(state) is dict:
        aggregate=state.get('aggregate_after_actual_returned_calls') if direct else state.get('aggregate_after_returned_calls')
        if type(aggregate) is dict:
            for key in ['SimpleCTFOnly','MaxCTFTerms']:c.exact(path+'/actual_aggregate/'+key,n_after[key],aggregate[key])
            calls=observation.get('construction_records',[]) if type(observation) is dict else []
            c.exact(path+'/actual_aggregate/returned_calls',sum(v['postaggregate_reached'] for v in calls),aggregate['returned_constructions'])
        else:c.absence(path+'/actual_aggregate',True,False,'Available actual public state must retain its aggregate owner')
        if not direct and type(state.get('actual_final_shared_flags')) is dict and type(observation) is dict and observation['events']:
            for key in ['ErrorsFound','DoCTFErrorReport']:c.exact(path+'/actual_final_shared_flags/'+key,observation['events'][-1]['snapshot'][key],state['actual_final_shared_flags'][key])
    pair.unpaired(c,path+'/other_whole_Init_owners','Native sizing input flags and AnyInternalHeatSourceInInput are captured; no corresponding actual Rust field is exposed by these observer schemas',True,False)

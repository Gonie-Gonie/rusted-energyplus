+//! Input-only helper for a future direct observer; not a parser replacement.
+
+use ep_compiler::{CompileReport, compile_raw_model};
+use ep_model::ReportInputs;
+use ep_raw_model::RawModel;
+
+/// Compile the genuine parsed report document with existing defaults and order.
+/// Only the actual ReportInputs are moved out. Typed simulation timestep,
+/// geometry, constructions and material owners never seed the direct Init call.
+/// Missing compiled input remains None with the real compiler report retained.
+pub fn compile_direct_report_inputs(
+    raw: &RawModel,
+) -> (Option<ReportInputs>, CompileReport) {
+    let compiled = compile_raw_model(raw);
+    (compiled.model.map(|model| model.report_inputs), compiled.report)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ep_raw_model::parse_epjson_str_with_idf_order;
+
+    #[test]
+    fn report_only_input_keeps_real_default_and_idf_order_owners()
+        -> Result<(), Box<dyn std::error::Error>> {
+        let raw = parse_epjson_str_with_idf_order(
+            r#"{"Output:Constructions":{"Output:Constructions 1":{"details_type_1":"Constructions","details_type_2":"Materials"}}}"#,
+            "Output:Constructions,Constructions,Materials;",
+        )?;
+        let (inputs, _) = compile_direct_report_inputs(&raw);
+        let inputs = inputs.ok_or("actual compiled report input missing")?;
+        assert_eq!(inputs.objects.len(), 1);
+        assert_eq!(inputs.objects[0].alphas, ["CONSTRUCTIONS", "MATERIALS", ""]);
+        assert_eq!(inputs.objects[0].num_alphas, 2);
+        assert!(!inputs.objects[0].is_epjson);
+        Ok(())
+    }
+}

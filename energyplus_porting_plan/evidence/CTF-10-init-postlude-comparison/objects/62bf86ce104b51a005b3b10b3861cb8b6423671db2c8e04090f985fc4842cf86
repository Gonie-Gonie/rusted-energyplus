"""Root-only recorded request/build/two-lane execution; no comparison or PASS."""
import argparse
from datetime import datetime
import json
from pathlib import Path
import subprocess
import sys
import write_request as m

PROJECTOR = {'path': '.runtime/porting/CTF-10/init-postlude-input-projector-prep-03/manifest.json', 'sha256': '69bc0aeeef10428b27dac71576b3f3005690e901aa60b41291a43ff6204e5072'}
EXAMPLES = {'production': 'ctf10_init_postlude_candidate_production_observer', 'direct': 'ctf10_init_postlude_candidate_direct_observer'}

def record(out, role, command, snapshot, earliest, allowed=(0,)):
    directory = out / (role + '-command-01'); m.need(not directory.exists(), 'Fresh recorded command required'); m.unchanged(); m.source_matches(snapshot)
    with (out / (role + '.orchestration.log')).open('xb') as stream:
        result = subprocess.run([sys.executable, '-X', 'utf8', '-B', str(m.RECORDER), '--output-dir', str(directory.relative_to(m.ROOT)), '--', *command], cwd=m.ROOT, stdout=stream, stderr=subprocess.STDOUT, check=False)
    r = m.ref(directory / 'receipt.json'); v = m.receipt(r, allowed)
    m.need(v['command'] == command and result.returncode == v['exit_code'] and v['source_snapshot'] == snapshot and earliest <= datetime.fromisoformat(v['started_utc']), 'Actual argv/Source/time/exit differs'); m.source_matches(snapshot); m.unchanged(); return r, v

def production_request(request_ref, execution_ref, freeze_ref, inventory, bindings, snapshot):
    request = m.read(request_ref); execution = m.receipt(execution_ref); source = m.read(PROJECTOR)['source']; m.exact(source)
    expected = ['-X', 'utf8', '-B', str(m.exact(source)), m.pin(freeze_ref), m.pin(inventory['runtime_source_bindings']['production']), str(m.path(request_ref['path']).parent)]
    actual = execution['command']; m.need(len(actual) == 8 and actual[1:4] == expected[:3] and m.path(actual[4]) == m.path(source['path']) and m.same(m.operand(actual[5]), freeze_ref) and m.same(m.operand(actual[6]), inventory['runtime_source_bindings']['production']) and m.path(actual[7]) == m.path(request_ref['path']).parent, 'Actual accepted production projector argv differs')
    emitted = m.read(execution['stdout']); m.need(m.same(emitted['production_request'], request_ref) and execution['source_snapshot'] == snapshot, 'Actual current-source production request custody differs')
    freeze = m.read(freeze_ref); api = m.read(m.PRODUCTION)['runtime_interfaces']
    m.need(set(request) == {'schema', 'fixed_scope', 'model_cases', 'initial_zone_air_temperature_c', 'observer_sources', 'native_helper_request', 'native_admission_contract', 'actual_public_API_sources', 'actual_Cargo_source_capture_must_match', 'frozen_before_execution', 'expected_values_supplied', 'Native_results_supplied'} and request['schema'] == api['request_schema'], 'Exact production request schema required')
    m.need(request['native_helper_request'] == freeze['helper_request'] and request['native_admission_contract'] == freeze['native_admission_contract'] and request['observer_sources'] == bindings['production']['observer_sources'] and request['actual_public_API_sources'] == bindings['production']['actual_public_API_sources'], 'Production request Source/freeze identities differ')
    m.need(request['actual_Cargo_source_capture_must_match'] is True and request['frozen_before_execution'] is True and request['expected_values_supplied'] is False and request['Native_results_supplied'] is False and len(request['model_cases']) == 15, 'Fixed15 input-only production request required')
    return execution

def main():
    parser = argparse.ArgumentParser(description=__doc__); m.arguments(parser)
    for n in ['production-request', 'production-projection-execution']: parser.add_argument('--' + n, required=True)
    args = parser.parse_args(); prep_ref = m.check_self(args, Path(__file__).resolve())
    inv_ref, quality_ref, freeze_ref = m.operand(args.formatted_inventory), m.operand(args.quality), m.operand(args.native_freeze)
    inventory, quality, bindings, last_quality = m.current_sources(inv_ref, quality_ref); m.frozen_direct(freeze_ref)
    ledger_ref, conversion_ref = m.operand(args.conversion_ledger), m.operand(args.conversion_execution)
    production_ref, projection_ref = m.operand(args.production_request), m.operand(args.production_projection_execution)
    projection = production_request(production_ref, projection_ref, freeze_ref, inventory, bindings, quality['Source_snapshot'])
    out = m.path(args.output_dir); m.need(out.is_relative_to(m.BASE) and not out.exists(), 'Fresh contained CTF10 workflow directory required'); m.unchanged(); out.mkdir()
    writer = Path(__file__).with_name('write_request.py').resolve()
    writer_args = [sys.executable, '-X', 'utf8', '-B', str(writer), '--approved-source-sha256', m.sha(writer), '--source-manifest', m.pin(prep_ref), '--native-freeze', m.pin(freeze_ref), '--formatted-inventory', m.pin(inv_ref), '--quality', m.pin(quality_ref), '--conversion-ledger', m.pin(ledger_ref), '--conversion-execution', m.pin(conversion_ref), '--output-dir', str(out / 'direct-inputs')]
    writer_ref, writer_execution = record(out, 'direct-input-writer', writer_args, quality['Source_snapshot'], last_quality)
    emitted = m.read(writer_execution['stdout']); direct_ref = m.operand(m.pin(emitted['request'])); custody = m.read(emitted['input_custody'])
    m.need(custody['source_preparation'] == prep_ref and custody['accepted_formatted_inventory'] == inv_ref and custody['actual_quality'] == quality_ref and custody['actual_native_freeze'] == freeze_ref and custody['actual_Source_snapshot'] == quality['Source_snapshot'], 'Actual writer custody joins differ')
    build_args = ['cargo', 'build', '--locked', *m.CONFIG, '-p', 'ep_run', '--example', EXAMPLES['production'], '--example', EXAMPLES['direct'], '--message-format=json-render-diagnostics']
    build_ref, build = record(out, 'candidate-build', build_args, quality['Source_snapshot'], datetime.fromisoformat(writer_execution['finished_utc']))
    capture = build['cargo_compiler_artifacts_capture']; m.need(capture['requested'] is True and capture['status'] == 'pass' and capture['error'] is None, 'Actual Cargo-emitted artifact capture required')
    files = m.source_matches(build['source_snapshot']); artifacts = {}
    for lane, name in EXAMPLES.items():
        rows = [r for r in capture['rows'] if r['cargo_message']['target']['name'] == name and 'example' in r['cargo_message']['target']['kind']]
        m.need(len(rows) == 1, 'Exactly one emitted example artifact required'); artifacts[lane] = rows[0]['executable']
        for r in bindings[lane]['observer_sources'] + bindings[lane]['actual_public_API_sources']: m.need(files[r['path']]['archive']['sha256'] == r['sha256'] and files[r['path']]['size_bytes'] == r['size_bytes'], 'Actual Cargo Source/API capture differs')
    executions = []; earliest = datetime.fromisoformat(build['finished_utc'])
    for lane, request_ref in [('production', production_ref), ('direct', direct_ref)]:
        artifact = artifacts[lane]; binary = m.exact(dict(path=artifact['historical_path'], sha256=artifact['sha256'])); m.exact(request_ref)
        r, v = record(out, lane + '-candidate', [str(binary), str(m.path(request_ref['path'])), request_ref['sha256']], quality['Source_snapshot'], earliest, (0, 2))
        m.exact(dict(path=artifact['historical_path'], sha256=artifact['sha256'])); executions.append(dict(lane=lane, request=request_ref, emitted_artifact=artifact, execution=r, actual_exit_code=v['exit_code'])); earliest = datetime.fromisoformat(v['finished_utc'])
    m.unchanged(); m.source_matches(quality['Source_snapshot'])
    result = dict(schema='ctf10-Init-postlude-actual-candidate-execution-workflow.v1', source_preparation=prep_ref, accepted_formatted_inventory=inv_ref, actual_quality=quality_ref, actual_Source_snapshot=quality['Source_snapshot'], actual_native_freeze=freeze_ref, production_projection_execution=projection_ref, direct_input_writer_execution=writer_ref, direct_input_custody=emitted['input_custody'], actual_build=build_ref, actual_candidate_executions=executions, actual_candidate_commands_returned_zero=all(r['actual_exit_code'] == 0 for r in executions), all_bound_inputs_and_sources_unchanged=True, Native_results_read=False, scientific_comparison_performed=False, numerical_PASS_claimed=False, whole_Init_parity_claimed=False, gates_updated=False)
    m.write(out / 'workflow.json', result); print(json.dumps(dict(workflow=m.ref(out / 'workflow.json'), actual_candidate_exit_codes=[r['actual_exit_code'] for r in executions], numerical_PASS_claimed=False)), flush=True)
    return 0 if result['actual_candidate_commands_returned_zero'] else 2

if __name__ == '__main__': raise SystemExit(main())

"""Root losslessly compresses three completed retained Cargo artifacts before the next build."""
import hashlib,json,shutil,subprocess
from pathlib import Path
ROOT=Path.cwd().resolve();OUT=ROOT/'.runtime/porting/CTF-10/init-postlude-retained-cargo-storage-01'
names=['eplus_rs-591b04cd3fa3a5b1.exe','eplus_rs-5d435c28fb58030b.exe','arbitrary_run_ideal_loads-dd485b1133f18062.exe']
def ref(p):
 with p.open('rb')as s:digest=hashlib.file_digest(s,'sha256').hexdigest()
 return {'path':p.relative_to(ROOT).as_posix(),'sha256':digest,'size_bytes':p.stat().st_size}
assert not OUT.exists();prepared=[]
for name in names:
 p=(ROOT/'target/debug/deps'/name).resolve(strict=True)
 assert p.parent==ROOT/'target/debug/deps'and p.is_file()and not p.is_symlink()and not p.is_junction()and not(p.stat().st_file_attributes&0x400)
 prepared.append((p,ref(p)))
OUT.mkdir();free_before=shutil.disk_usage(ROOT).free;rows=[]
for p,before in prepared:
 assert ref(p)==before;log=OUT/(p.name+'.log')
 with log.open('xb')as stream:r=subprocess.run(['compact.exe','/C','/EXE:LZX','/Q',str(p)],stdout=stream,stderr=subprocess.STDOUT)
 after=ref(p);assert r.returncode==0 and after==before
 rows.append({'before':before,'after':after,'compact_exit_code':r.returncode,'command_log':ref(log),'bytes_and_path_unchanged':True})
 print('Root retained build cache compression',p.name,'exact bytes retained',flush=True)
record={'schema':'ctf10-next-unit-retained-Cargo-cache-transparent-storage.v1','files':rows,'observed_free_bytes_before':free_before,'observed_free_bytes_after':shutil.disk_usage(ROOT).free,'operation':'NTFS compact.exe /C /EXE:LZX /Q','file_deleted_or_moved':False,'Original_or_scientific_result_mutated':False,'gates_updated':False}
(OUT/'record.json').write_bytes((json.dumps(record,indent=2)+'\n').encode())

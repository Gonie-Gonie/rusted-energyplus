def providers(link_map,sources):
    prefixes={'EnergyPlus::HeatBalanceManager::InitConductionTransferFunctions(':'HeatBalanceManager.ctf10.cc.obj'}
    prefixes.update({'EnergyPlus::Construction::ConstructionProps::'+name+'(':'Construction.ctf10.cc.obj' for name in ['calculateTransferFunction','reportLayers','reportTransferFunction']})
    hits={k:[] for k in prefixes};loads=[];core=[];section=None;original_hits=0
    with link_map.open(encoding='utf8') as s:
        for number,line in enumerate(s,1):
            if line.startswith(' .text '):section=(number,line)
            f=line.split()
            if len(f)>=2 and f[0].startswith('0x'):
                symbol=line.strip().split(None,1)[1]
                for prefix,owner in prefixes.items():
                    if symbol.startswith(prefix):
                        need(section is not None and 'CMakeFiles/'+TARGET+'.dir/' in section[1] and owner in section[1],'Selected genuine derived provider required');parts=section[1].split();address=int(f[0],16)
                        need(int(parts[1],16)<=address<int(parts[1],16)+int(parts[2],16),'Symbol address must belong to actual latest text section');hits[prefix].append(dict(symbol_line=number,symbol=line.rstrip(),section_provider=dict(line=section[0],text=section[1].rstrip())))
            if line.startswith('LOAD ') and 'CMakeFiles/'+TARGET+'.dir/' in line:loads.append(dict(line=number,text=line.rstrip()))
            if line.strip()=='LOAD Products/libenergypluslib.a':core.append(number)
            if any('libenergypluslib.a('+n+'.cc.obj)' in line for n in ['Construction','HeatBalanceManager']):original_hits+=1
    need(all(len(v)==1 for v in hits.values()) and len(loads)==4 and len(core)==1 and max(r['line'] for r in loads)<core[0] and original_hits==0,'Four genuine TU loads/unique derived providers/no selected core duplicates required')
    need(all(sum(Path(r['path']).name+'.obj' in v['text'] for v in loads)==1 for r in sources),'Every actual four-TU object required');return dict(address_bound_selected_providers={k:v[0] for k,v in hits.items()},actual_target_LOADs=loads,core_LOAD=core,selected_core_duplicate_hits=original_hits)


def unpaired(c, path, reason, native=True, rust=False):
    c.unavailable.append(dict(path=path,Native_available=native,Rust_available=rust,
        required=False,reason=reason,counted_as_PASS=False))


def required(c,path,left,right):
    if type(left) is not dict or type(right) is not dict:
        c.absence(path,type(left) is dict,type(right) is dict,'Required genuine owner missing on one or both sides')
        return False
    return True


def bits(value,need):
    need(type(value) is dict and type(value.get('value_bits')) is str and
         len(value['value_bits'])==16 and all(v in '0123456789abcdef' for v in value['value_bits']),
         'Actual binary64 bit owner required')
    word=int(value['value_bits'],16);exp=(word>>52)&2047;fraction=word&((1<<52)-1);negative=bool(word>>63)
    cls=('nan' if fraction else ('negative_infinity' if negative else 'positive_infinity')) if exp==2047 else \
        ('negative_zero' if negative else 'positive_zero') if (word&((1<<63)-1))==0 else 'finite'
    need(value.get('value_class')==cls,'Scalar class must describe its own actual bits')
    return dict(value_bits=value['value_bits'],value_class=cls)


def scalar(c,path,left,right,need,*,numeric=False):
    if not required(c,path,left,right):return
    c.tree(path,bits(left,need),bits(right,need))
    if numeric:
        c.counts['numeric_comparisons']+=1
        if any(v['value_class'] not in ['finite','positive_zero','negative_zero'] for v in [left,right]):
            c.failure(path,'nonfinite_numeric_owners',left,right)


def array(c,path,left,right,need,*,numeric=False):
    if type(left) is not list or type(right) is not list:
        c.absence(path,type(left) is list,type(right) is list,'Required complete fixed19 owner missing');return
    c.exact(path+'/Native_slots',19,len(left));c.exact(path+'/Rust_slots',19,len(right))
    for index,(a,b) in enumerate(zip(left,right)):
        scalar(c,path+'/'+str(index),a,b,need,numeric=numeric)


def allocated(c,path,left,right,need,row_copy):
    if not required(c,path,left,right):return
    need(type(left.get('allocated')) is bool and type(right.get('allocated')) is bool,'Actual allocation flags required')
    c.exact(path+'/allocated',left['allocated'],right['allocated'])
    if not left['allocated']:
        need(left['size']==0 and left['lower'] is None and left['upper'] is None and left['rows']==[],
             'Native unallocated transport must retain null bounds/zero rows')
    if not right['allocated']:
        need(right['length'] is None and right['values'] is None,'Rust unallocated transport must retain null length/values')
    if not left['allocated'] or not right['allocated']:return
    need(type(left['size']) is int and type(left['rows']) is list and type(right['length']) is int and
         type(right['values']) is list,'Full actual allocated row owners required')
    c.exact(path+'/Native_lower',1,left['lower']);c.exact(path+'/Native_upper',left['size'],left['upper'])
    c.exact(path+'/Native_retained_length',left['size'],len(left['rows']))
    c.exact(path+'/Rust_retained_length',right['length'],len(right['values']))
    c.exact(path+'/full_capacity',left['size'],right['length'])
    c.exact(path+'/retained_rows',len(left['rows']),len(right['values']))
    for index,(a,b) in enumerate(zip(left['rows'],right['values'])):
        label=path+'/'+str(index)
        c.exact(label+'/Native_index',index+1,a['actual_array_index'])
        c.exact(label+'/Rust_vector_index',index,b['vector_index'])
        c.exact(label+'/Rust_source_index',index+1,b['source_one_based_index'])
        row_copy(label,a['value'],b['value'])


def reports(c,path,native,rust,need):
    if not required(c,path,native,rust):return
    n=native['registry'];r=rust['registry'];t=rust['table']
    c.exact(path+'/named_count',1301,len(n['named_indices']))
    c.exact(path+'/declared_named_count',1301,len(r['declared_named_indices']))
    c.exact(path+'/map_count',1301,r['named_index_owner_count'])
    c.exact(path+'/map_rows',r['named_index_owner_count'],len(r['named_indices']))
    declared=r['declared_named_indices'];lookup={v['name']:v['value'] for v in r['named_indices']}
    need(len(lookup)==len(r['named_indices']),'Unique actual registry map names required')
    for index,(a,b) in enumerate(zip(n['named_indices'],declared)):
        c.exact(path+'/named/'+str(index)+'/declaration_index',index,b['declaration_index'])
        c.exact(path+'/named/'+str(index)+'/name',a['name'],b['name'])
        c.exact(path+'/named/'+str(index)+'/value',a['value'],b['value'])
        c.exact(path+'/named/'+str(index)+'/same_actual_map_owner',b['value'],lookup.get(b['name']))
    for nk,rk in [('sizeReportName','report_capacity'),('numReportName','report_count'),
                  ('sizeSubTable','subtable_capacity'),('numSubTable','subtable_count'),
                  ('sizeColumnTag','column_capacity'),('numColumnTag','column_count')]:c.exact(path+'/'+nk,n[nk],r[rk])
    c.tree(path+'/opaque_columns',n['pdchOpqConsLayCol'],r['opaque_layer_columns'])
    for nk,rk,owner in [('reportName','reports',r),('subTable','subtables',r),('columnTag','columns',r),('tableEntry','entries',t)]:
        def row_copy(label,a,b,keys=ROW_KEYS[nk]):
            if not required(c,label,a,b):return
            need(set(keys).issubset(a) and set(keys.values()).issubset(b),'Every actual retained row member is required')
            for old,new in keys.items():
                if old=='origRealEntry':scalar(c,label+'/'+old,a.get(old),b.get(new),need)
                else:c.exact(label+'/'+old,a.get(old),b.get(new))
        allocated(c,path+'/'+nk,n[nk],owner[rk],need,row_copy)
    for nk,rk in [('sizeTableEntry','size_table_entry'),('numTableEntry','num_table_entry')]:c.exact(path+'/'+nk,n[nk],t[rk])
    native_scan=native['scan_cache'];actual_scan={old:rust['scan'].get(new) for old,new in SCAN.items()}
    for group,names in SCAN_GROUPS.items():
        values=rust['scan'].get(group)
        need(type(values) is list and len(values)==len(names),'Full actual paired Scan option/flag group required')
        actual_scan.update(zip(names,values,strict=True))
    need(len(actual_scan)==31 and set(native_scan)==set(actual_scan),'Exact Source31 Scan names required')
    c.tree(path+'/Scan31',native_scan,actual_scan)
    unpaired(c,path+'/Native_registry_context','Twenty-two real totals, component-size/shadow arrays and their counts are captured Native context outside the selected Init/report suffix; no Rust owner is invented',True,False)


def backend(c,path,native,rust,need,direct):
    if not required(c,path,native,rust):return
    need(set(BACKEND).issubset(native) and set(BACKEND.values()).issubset(rust) and
        set(TRACKING).issubset(native) and type(rust.get('tracking')) is dict and
        set(TRACKING.values()).issubset(rust['tracking']),'Every paired actual backend owner is required')
    for old,new in BACKEND.items():c.exact(path+'/'+old,native.get(old),rust.get(new))
    for old,new in TRACKING.items():c.exact(path+'/'+old,native.get(old),rust['tracking'].get(new))
    counts=native['MatchCounts'];need(counts['allocated'] is True and counts['size']==20 and counts['lower']==1 and counts['upper']==20 and
        len(counts['rows'])==20,'Actual full Native20 MatchCounts required')
    for index,row in enumerate(counts['rows']):need(row['actual_array_index']==index+1 and type(row['value']) is int,'Ordered actual MatchCounts owner required')
    c.tree(path+'/MatchCounts',[v['value'] for v in counts['rows']],rust['tracking']['match_counts'])
    if direct:
        need(all(old in native and new in rust for old,new in [('errorCallback_present','error_callback_present'),
            ('messageCallback_present','message_callback_present'),('fMessagePtr_present','f_message_present'),
            ('sqlite_present','sqlite_present')]),'Actual optional backend presence owners required')
        for old,new in [('errorCallback_present','error_callback_present'),('messageCallback_present','message_callback_present'),
                        ('fMessagePtr_present','f_message_present'),('sqlite_present','sqlite_present')]:c.exact(path+'/'+old,native.get(old),rust.get(new))
    unpaired(c,path+'/caller_headers_optional_context','Native version/IDD/date strings and production callbacks are actual different caller inputs; DeveloperFlag Native owner was not copied',True,True)


def checkpoint(copy):
    return copy.get('snapshot') if type(copy) is dict and copy.get('reached') is True and copy.get('copy_available') is True else None


def storage(c,path,native,rust,need,*,numeric):
    if not required(c,path,native,rust):return
    need(set(STORAGE).issubset(native) and set(STORAGE).issubset(rust) and
        all(type(owner[name]) is int for owner in [native,rust] for name in ['NumHistories','NumCTFTerms']),
        'Every actual public storage member/count is required')
    for name in ARRAYS:array(c,path+'/'+name,native.get(name),rust.get(name),need,numeric=numeric and name in ARRAYS[:4])
    for name in ['CTFTimeStep','UValue']:scalar(c,path+'/'+name,native.get(name),rust.get(name),need,numeric=numeric)
    for name in ['NumHistories','NumCTFTerms']:c.exact(path+'/'+name,native.get(name),rust.get(name))
    for name in ARRAYS[4:] if numeric else []:
        for owner,side in [(native,'Native'),(rust,'Rust')]:
            for index,value in enumerate(owner.get(name,[])):
                c.exact(path+'/'+name+'/'+side+'/'+str(index)+'/required_positive_reset_bits','0000000000000000',bits(value,need)['value_bits'])


def progress(c,path,observation,rust,need,source_to_declared):
    if not required(c,path,observation,rust):return
    events=observation['events'];need(all(v['copy_available'] is True and type(v['snapshot']) is dict for v in events),'Full actual reached Init event copies required')
    for index,event in enumerate(events):need(event['actual_event_ordinal']==index+1,'Actual Init event ordinal sequence differs')
    def returned(kind):
        result=[]
        for event in events:
            if event['event']==kind:
                index=event['snapshot']['actual_construction_index']
                need(index in source_to_declared,'Reached report event needs real declared construction association')
                result.append(source_to_declared[index])
        return result
    c.tree(path+'/layer_return_order',returned('ReportLayersReturn'),rust['layer_report_declared_indices'])
    c.tree(path+'/coefficient_return_order',returned('ReportTransferReturn'),rust['coefficient_report_declared_indices'])
    scan=[v['snapshot']['InitCTFDoReport'] for v in events if v['event']=='ScanReturn'];need(len(scan)<=1,'At most one true whole Init Scan return')
    c.exact(path+'/Scan_assigned_output',scan[0] if scan else None,rust['construction_scan_result'])
    for event,key in [('ReportHeaders','report_headers_written'),('FinalFatalBoundary','final_fatal_invoked')]:
        c.exact(path+'/'+key,any(v['event']==event for v in events),rust[key])
    c.exact(path+'/postlude_returned',observation['actual_function_end_reached'],rust['postlude_returned'])


def callbacks(c,path,native,rust,need):
    c.exact(path+'/count',len(native),len(rust))
    for index,(a,b) in enumerate(zip(native,rust)):
        for v in [a,b]:need(v['actual_ordinal']==index+1,'Actual mixed callback ordinal sequence required')
        for key in ['kind','actual_level','actual_message']:c.exact(path+'/'+str(index)+'/'+key,a.get(key),b.get(key))


def outcome(c,path,native,rust,invoked,error):
    c.exact(path+'/invoked',native['actual_source_invoked'],invoked)
    status=native['call_outcome']['status']
    c.exact(path+'/normal_return',status=='source_returned',rust=='source-returned')
    if native['actual_source_invoked']:
        c.exact(path+'/actual_fatal',status=='source_fatal',type(error) is dict and error.get('actual_SourceFatalError_returned') is True)
        if status not in ['source_returned','source_fatal']:
            unpaired(c,path+'/exception','Actual nonfatal Native exception has no Source-equal Rust exception-type contract',True,type(error) is dict)

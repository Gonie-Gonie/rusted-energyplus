    source_ref=manifest['original_workflow_preparation'];source=m.load(source_ref)
    m.require(qa['schema']=='ctf10-native-Init-postlude-independent-original-data-review.v1' and
        qa['status']=='pass-actual-Init-postlude-custody-before-Rust' and qa['Original_capture_custody_released'] is True and
        not qa['observation_integrity_failures'] and type(qa['actual_observation_counts']) is dict and
        qa['numerical_PASS_claimed'] is False and qa['whole_CTF10_gates_updated'] is False and m.load(qe['stdout'])==qa,
        'Actual full OriginalQA0/stdout/custody release required')
    c.same(m,qa['reviewed_source_manifest'],source_ref)
    m.require(qa['executed_reader_sources']==source['own_sources'],'Actual three reader Source identities differ')
    for row in source['own_sources']:m.bind(row)
    cmd=qe['command'];m.require(len(cmd)==14 and Path(cmd[0]).name.lower() in ['python','python.exe'] and cmd[1:4]==['-X','utf8','-B'] and
        m.contained(cmd[4])==m.contained(source['own_sources'][0]['path']) and cmd[5]=='qa','Actual held QA phase/CLI required')
    opts=dict(zip(cmd[6::2],cmd[7::2],strict=True))
    m.require(set(opts)=={'--approved-runner-sha256','--source-manifest','--native-workflow','--output-dir'} and
        opts['--approved-runner-sha256']==source['own_sources'][0]['sha256'],'Actual approved QA Source/options differ')
    c.same(m,m.argument(opts['--source-manifest']),source_ref);c.same(m,m.argument(opts['--native-workflow']),qa['actual_workflow'])
    m.require(m.contained(opts['--output-dir'],existing=False)==m.contained(qa_ref['path']).parent,'Actual QA output owner differs')
    w=m.load(qa['actual_workflow']);freeze=m.load(w['freeze']);native=m.load(w['native_source_manifest'])
    c.same(m,w['workflow_source_manifest'],source_ref);c.same(m,qa['actual_frozen_input'],w['freeze']);c.same(m,qa['actual_native_execution'],w['native_execution'])
    c.same(m,w['native_source_manifest'],manifest['native_source_preparation']);c.same(m,freeze['native_source_manifest'],w['native_source_manifest'])
    m.require(w['schema']=='ctf10-native-Init-postlude-workflow.v1' and freeze['schema']=='ctf10-native-Init-postlude-frozen-inputs.v1' and
        freeze['frozen_before_this_execution'] is True and freeze['declared_model_cases']==15 and freeze['declared_direct_cases']==6 and
        all(freeze[k] is False for k in ['expected_values_supplied','expected_exits_supplied','scientific_execution_performed','numerical_PASS_claimed','gates_updated']),
        'Exact pre-execution fixed15/direct6 Native Source/policy packet required')
    c.same(m,freeze['observation_policy'],manifest['prospective_policy']);m.bind(freeze['observation_policy'])
    for row in native['native_source_files']+[native['recipe']]:m.bind(row)
    for row in [*freeze['contracts'].values(),freeze['projection'],*freeze['source_authorities']['current_after_documents']]:m.bind(row)
    req=m.load(freeze['helper_request']);direct=m.load(freeze['direct_unit_request']);admission=m.load(freeze['native_admission_contract'])
    profiles=m.load(manifest['strict_public_policy_source'])
    m.require(req['ctf10_public_profiles']==profiles['arithmetic_profiles_by_variable'],'Literal six pre-output public profiles differ')
    m.require(req['schema']=='ctf10-production-helper-cases.v1' and req['requested_counts']=={'model_cases':15,'loader_phase_records':195} and
        len(req['model_cases'])==15 and len(req['all_45_guard_refs'])==45 and len(direct['cases'])==6 and
        admission['native_source_files']==native['native_source_files'] and len(native['native_source_files'])==12,
        'Complete unchanged fixed input and twelve-source admission required')
    for row in req['all_45_guard_refs']:m.bind(row)
    for key in ['helper_request','projection','direct_unit_request']:c.same(m,admission[key],freeze[key])
    m.require(admission['contracts']==freeze['contracts'],'Actual frozen admission contracts differ')
    literal=m.load(direct['literal_case_source']);m.require(direct['cases']==literal['cases'],'Actual six literal direct inputs differ')
    c.same(m,dict(path=direct['input']['path'],sha256=literal['literal_IDF_source']['sha256'],size_bytes=literal['literal_IDF_source']['size_bytes']),direct['input'])
    m.bind(direct['input']);m.bind(literal['literal_IDF_source'])
    ne=c.recorded(m,w['native_execution']);c.before(m,ne,qe)
    for key in ['helper_binary','linked_original','link_map']:c.full(m,w[key])
    m.require(ne['command']==[str(m.contained(w['helper_binary']['path'])),str(m.ROOT),str(m.contained(freeze['helper_request']['path'])),
        str(m.contained(freeze['native_admission_contract']['path'])),str(m.contained(freeze['direct_unit_request']['path'])),str(m.contained(w['actual_native_output_directory'],existing=False))],
        'Actual Native argc6/frozen operands required')
    m.require(type(qa['actual_native_results']) is dict and m.contained(qa['actual_native_results']['path'])==m.contained(w['result_file']),
        'Released complete Native result-file authority required')
    files={}
    for row in qa['complete_payload_file_identities']:
        value=c.full(m,row);m.require(value['path'] not in files,'Duplicate actual payload identity');files[value['path']]=value
    result=c.full(m,qa['actual_native_results']);m.require(result['path'] in files,'Complete Native result is absent from released payload custody')
    return qa_ref,qe_ref,qa,qe,freeze,req,direct,admission,result,files


def candidate(m,c,lane,args,manifest,freeze,native_request,direct,qa_execution):
    prefix='production' if lane=='model_cases' else 'direct'
    refs={key:m.argument(getattr(args,prefix+'_'+key.replace('-','_'))) for key in ['request','build-execution','execution']}
    request=m.load(refs['request']);prep=m.load(manifest[prefix+'_observer_preparation']);interface=prep['runtime_interfaces']
    m.require(request['schema']==interface['request_schema'] and len(request)==12 and request['frozen_before_execution'] is True and
        request['expected_values_supplied'] is False and request['Native_results_supplied'] is False and request['actual_Cargo_source_capture_must_match'] is True,
        'Exact frozen input-only candidate request required')
    for key,paths in [('observer_sources',interface['ordered_observer_source_paths']),('actual_public_API_sources',interface['ordered_public_API_source_paths'])]:
        m.require([v['path'] for v in request[key]]==paths,'Actual ordered candidate own/API Source paths differ')
        for row in request[key]:m.bind(row)
    c.same(m,request['native_admission_contract'],freeze['native_admission_contract'])
    if lane=='model_cases':
        c.same(m,request['native_helper_request'],freeze['helper_request']);prior=m.load(manifest['historical_production_request'])
        m.require(request['model_cases']==prior['model_cases'] and request['fixed_scope']==prior['fixed_scope'] and
            request['initial_zone_air_temperature_c']==prior['initial_zone_air_temperature_c'] and
            len(request['model_cases'])==15,'Unchanged ordered actual conversion and caller input authorities required')
        m.bind(request['fixed_scope'])
        for row,supplied in zip(request['model_cases'],native_request['model_cases'],strict=True):
            m.require(row['id']==supplied['id'] and row['input']==supplied['input'],'Actual same-input fixed15 case order differs');m.bind(row['input'])
            m.require(type(row['conversion_available']) is bool and row['conversion_proof_bindings'],'Actual input-only conversion provenance required')
            for binding in row['conversion_proof_bindings']:m.bind(binding)
            if row['conversion_available']:m.bind(row['epjson_input']);m.require(row['conversion_unavailable_reason'] is None,'Available conversion has an absence reason')
            else:m.require(row['epjson_input'] is None and type(row['conversion_unavailable_reason']) is str and bool(row['conversion_unavailable_reason']),'Unavailable conversion needs genuine reason and no invented input')
    else:
        c.same(m,request['direct_unit_request'],freeze['direct_unit_request'])
        m.require(m.load(request['native_frozen_packet'])==freeze,'Candidate direct exact Native frozen packet differs')
        m.bind(request['report_input_epjson']);m.require(request['report_conversion_proof_bindings'],'Real direct report input conversion proof required')
        proofs=[]
        for binding in request['report_conversion_proof_bindings']:
            m.bind(binding)
            try:value=m.load(binding)
            except (json.JSONDecodeError,UnicodeDecodeError):continue
            if type(value) is dict and value.get('schema')=='sch01-input-conversion-command.v1':proofs.append(value)
        m.require(len(proofs)==1,'Exactly one genuine direct input-only conversion command required');proof=proofs[0]
        m.require(proof['case_id']=='CTF10-DIRECT-REPORT' and proof['exit_code']==0 and proof['launch_error'] is None and proof['epjson_available'] is True and
            proof['available_epjson_input']==request['report_input_epjson'] and proof['original_and_staged_IDF_preserved'] is True and
            all(proof[k] is False for k in ['numerical_engine_executed','Native_scientific_outputs_used_as_inputs','expected_answers_supplied']) and
            proof['converter']['path']=='.runtime/energyplus/26.1.0/ConvertInputFormat.exe' and len(proof['command'])==2 and proof['command'][1]=='input.idf',
            'Actual successful input-only direct report conversion differs')
        for key in ['source_input','staged_input']:
            m.bind(proof[key]);m.require(proof[key]['sha256']==direct['input']['sha256'] and proof[key]['size_bytes']==direct['input']['size_bytes'],'Direct conversion original IDF bytes differ')
    build=c.recorded(m,refs['build-execution']);actual=c.recorded(m,refs['execution'],(0,2));c.before(m,qa_execution,actual);c.before(m,build,actual)
    c.same(m,build['source_snapshot'],actual['source_snapshot'])
    observer=interface['ordered_observer_source_paths'][0];example=Path(observer).stem;command=build['command']
    examples=[command[index+1] for index,value in enumerate(command[:-1]) if value=='--example']
    expected_examples=['ctf10_init_postlude_candidate_production_observer','ctf10_init_postlude_candidate_direct_observer']
    m.require(command[:2]==['cargo','build'] and '--locked' in command and '--message-format=json-render-diagnostics' in command and
        examples==expected_examples and example in examples and command[command.index('-p')+1]=='ep_run','Actual locked two-observer ep_run Cargo build required')
    capture=build['cargo_compiler_artifacts_capture'];m.require(capture['requested'] is True and capture['status']=='pass' and capture['error'] is None,'Actual emitted Cargo artifact capture required')
    artifacts=[v for v in capture['rows'] if v['cargo_message']['target']['name']==example and 'example' in v['cargo_message']['target']['kind']]
    m.require(len(artifacts)==1,'Exactly one genuine Cargo observer executable required');artifact=artifacts[0];message=artifact['cargo_message']
    m.require(m.contained(message['target']['src_path'])==m.contained(observer) and message['executable'] is not None,'Actual Cargo artifact Source differs')
    emitted=False
    with m.contained(build['stdout']['path']).open(encoding='utf8') as handle:
        for line in handle:
            if line.strip() and json.loads(line,object_pairs_hook=m.unique_object)==message:emitted=True
    m.require(emitted,'Captured Cargo artifact must occur in complete actual Cargo stdout')
    executable=c.full(m,dict(path=artifact['executable']['historical_path'],sha256=artifact['executable']['sha256']))
    m.require(m.contained(message['executable'])==m.contained(executable['path']) and actual['command']==[str(m.contained(executable['path'])),str(m.contained(refs['request']['path'])),refs['request']['sha256']],
        'Actual Rust executable/argc3/full request SHA differs')
    snapshot=m.load(build['source_snapshot']);m.require(snapshot['schema']=='rust-command-source-snapshot.v1' and snapshot['bytes_normalized'] is False,'Actual raw Cargo Source snapshot required')
    rows=snapshot['files'];m.require(len({v['historical_path'] for v in rows})==len(rows),'Unique actual raw Source snapshot membership required')
    found={}
    for row in rows:
        archived=m.bind(row['archive']);current=m.bind(dict(path=row['historical_path'],sha256=archived['sha256'],size_bytes=row['size_bytes']))
        m.require(archived['size_bytes']==current['size_bytes'],'Actual raw Source archive/current bytes differ');found[current['path']]=current
    for row in request['observer_sources']+request['actual_public_API_sources']:
        m.require(found.get(row['path'])==m.bind(row),'Every genuine own/API Source must belong to same actual Cargo snapshot')
    result=c.full(m,actual['stdout']);m.require(result['size_bytes']<=MAX_BYTES,'Complete Rust result exceeds factual4GiB resource bound; retained failure')
    return refs,request,build,actual,result,executable,interface


def run(args):
    common=PREP/'custody.py'
    if hashlib.sha256(common.read_bytes()).hexdigest()!=COMMON_SHA:raise ValueError('Reviewed common Source differs before import')
    spec=importlib.util.spec_from_file_location('Init_pair_custody',common);c=importlib.util.module_from_spec(spec);spec.loader.exec_module(c)
    m=c.modules();own_ref=m.argument(args.source_manifest);manifest=m.load(own_ref)
    m.require(Path.cwd().resolve()==m.ROOT and own_ref['sha256']==args.approved_source_sha256 and manifest['schema']=='ctf10-Init-postlude-comparison-source-preparation.v1','Approved comparison Source/cwd required')
    sources=[m.bind(v) for v in manifest['own_sources']]
    m.require(m.identity(Path(__file__)) in sources,'Actual runner must belong to approved own Sources')
    def dependency(name):
        row=next(v for v in sources if Path(v['path']).name==name);return c.boot(name.removesuffix('.py'),name,row['sha256'])
    pair=dependency('pair_owners.py');case=dependency('compare_case.py');comparison=dependency('comparison.py');stream=dependency('stream_cases.py')
    qa_ref,qe_ref,qa,qe,freeze,native_request,direct,admission,result,files=original(m,c,args,manifest)
    m.require(result['size_bytes']<=MAX_BYTES,'Complete Native result exceeds factual4GiB resource bound; retained failure')
    candidates={lane:candidate(m,c,lane,args,manifest,freeze,native_request,direct,qe) for lane in ['model_cases','direct_unit_cases']}
    c.same(m,candidates['model_cases'][2]['source_snapshot'],candidates['direct_unit_cases'][2]['source_snapshot'])
    c.same(m,candidates['model_cases'][0]['build-execution'],candidates['direct_unit_cases'][0]['build-execution'])
    tops={lane:{} for lane in candidates};iterators={}
    for lane,data in candidates.items():
        lanes=['model_cases','direct_unit_cases'] if lane=='model_cases' else ['direct_unit_cases']
        iterators[lane]=stream.iter_cases(m.contained(data[4]['path']),m.require,m.unique_object,lanes,['direct_unit_cases'] if lane=='model_cases' else [],tops[lane])
    ledger=comparison.Comparison(m.require);native_top={};counts={'model_cases':0,'direct_unit_cases':0}
    def payload(row,raw=False):
        actual=c.full(m,row);m.require(files.get(actual['path'])==actual,'Every joined partition/log must belong to released full Native payload custody')
        m.require(actual['size_bytes']<=MAX_BYTES,'Complete partition/log exceeds factual4GiB resource bound; retained failure')
        p=m.contained(actual['path'])
        if raw:return p.read_bytes()
        with p.open(encoding='utf8') as handle:
            return json.load(handle,object_pairs_hook=m.unique_object,parse_constant=lambda value:m.require(False,'Nonfinite JSON token: '+value))
    for lane,ordinal,row in stream.iter_cases(m.contained(result['path']),m.require,m.unique_object,['model_cases','direct_unit_cases'],[],native_top):
        supplied=native_request['model_cases'] if lane=='model_cases' else direct['cases'];m.require(ordinal<=len(supplied),'Extra actual Native case')
        counts[lane]+=1
        try:rust_lane,rust_ordinal,rust=next(iterators[lane])
        except StopIteration:ledger.absence(lane+'/'+str(ordinal),True,False,'Required complete actual Rust case missing');continue
        ledger.exact(lane+'/'+str(ordinal)+'/candidate_lane',lane,rust_lane);ledger.exact(lane+'/'+str(ordinal)+'/candidate_ordinal',ordinal,rust_ordinal)
        case.case(ledger,lane+'/'+supplied[ordinal-1]['id'],lane,row,rust,supplied[ordinal-1],payload,pair,m.require)
    m.require(counts=={'model_cases':15,'direct_unit_cases':6},'Every15+6 actual Native case is required')
    for lane,iterator in iterators.items():
        for actual_lane,ordinal,row in iterator:ledger.absence(actual_lane+'/'+str(ordinal),False,True,'Extra unmatched actual Rust case')
        refs,request,build,actual,rust_result,executable,interface=candidates[lane];top=tops[lane]
        m.require(top['schema']==interface['results_schema'] and top['all_bound_inputs_unchanged'] is True and top['scientific_comparison_performed'] is False and
            top['numerical_PASS_claimed'] is False and top['gates_updated'] is False and top['whole_Init_parity_claimed'] is False,
            'Actual complete candidate results/Source limits differ')
        c.same(m,top['actual_request'],refs['request'])
        m.require(top['observer_sources']==request['observer_sources'] and top['actual_public_API_sources']==request['actual_public_API_sources'],'Actual candidate output own/API binding differs')
        c.same(m,top['native_admission_contract'],freeze['native_admission_contract'])
        if lane=='model_cases':m.require(top['direct_unit_cases'] is None and top['direct_unit_lane_executed'] is False,'Production must not claim direct6 invocation')
        if actual['exit_code']!=0:ledger.failure(lane+'/actual_Rust_exit','availability_failures',0,actual['exit_code'])
    m.require(native_top['schema']=='ctf10-Init-postlude-helper-results.v1' and native_top['native_source_files']==m.load(manifest['native_source_preparation'])['native_source_files'],
        'Actual complete Native root Source/schema differs')
    summary=ledger.report();summary['numeric_comparisons']=ledger.counts['numeric_comparisons'];passed=summary['mismatch_count']==0
    output=m.contained(args.output_dir,existing=False);m.require(output.is_relative_to(m.BASE) and output!=m.BASE and not output.exists(),'Fresh contained comparison output required');output.mkdir()
    archived=[m.archive(row,output,index) for index,row in enumerate(sources)]
    report=dict(schema='ctf10-Init-postlude-same-input-owner-comparison.v1',status='pass-selected-paired-Init-owner-fields' if passed else 'fail-selected-paired-Init-owner-fields',
        selected_paired_owner_fields_passed=passed,actual_case_counts=counts,comparison=summary,comparer_source_preparation=own_ref,executed_comparer_sources=archived,
        actual_original_data_review=qa_ref,actual_original_data_review_execution=qe_ref,actual_Native_results=result,actual_Native_frozen_input=qa['actual_frozen_input'],
        actual_candidate_bindings={lane:dict(request=v[0]['request'],build_execution=v[0]['build-execution'],execution=v[0]['execution'],result=v[4],executable=v[5],source_snapshot=v[2]['source_snapshot']) for lane,v in candidates.items()},
        policy=freeze['observation_policy'],arithmetic_profile_authority=native_request['ctf10_public_profiles'],
        required_missing_counted_as_PASS=False,whole_Init_equivalence_claimed=False,ordinary_production_integration_PASS_claimed=False,complete_CTF10_PASS_claimed=False,gates_updated=False)
    c.recheck(m)
    with (output/'comparison.json').open('x',encoding='utf8',newline='\n') as handle:json.dump(report,handle,ensure_ascii=False,allow_nan=False,indent=2);handle.write('\n')
    c.recheck(m);print(json.dumps(report,ensure_ascii=False,allow_nan=False,indent=2));return 0 if passed else 1


if __name__=='__main__':
    p=argparse.ArgumentParser(description=__doc__)
    for name in ['approved-source-sha256','source-manifest','original-data-review','original-data-review-execution','production-request','production-build-execution','production-execution','direct-request','direct-build-execution','direct-execution','output-dir']:
        p.add_argument('--'+name,required=True)
    raise SystemExit(run(p.parse_args()))

}
inline json matrix_attempt(EnergyPlus::CTF10Observation::MatrixAttemptSnapshot const &source)
{
    json layers = nullptr, matrices = nullptr;
    if (source.active_prefix_available) {
        require(source.copied_layer_count <= source.active_prefix.size(), "Actual matrix layer prefix exceeds capture capacity");
        layers = json::array();
        for (std::size_t index = 0; index < source.copied_layer_count; ++index) {
            auto const &layer = source.active_prefix[index]; auto const &v = layer.converted;
            layers.push_back({{"dl", scalar_bits(v.dl.bits)}, {"rk", scalar_bits(v.rk.bits)},
                {"rho", scalar_bits(v.rho.bits)}, {"cp", scalar_bits(v.cp.bits)},
                {"lr", scalar_bits(v.lr.bits)}, {"ResLayer", v.ResLayer},
                {"Nodes", layer.Nodes}, {"dx", scalar_bits(layer.dx.bits)}});
        }
    }
    auto const copies = [](auto const &values) {
        json result = json::array();
        for (auto const &value : values) result.push_back(scalar_bits(value.bits));
        return result;
    };
    if (source.matrices_available) matrices = {{"AMat", copies(source.AMat)}, {"IdenMatrix", copies(source.IdenMatrix)},
        {"BMat", copies(source.BMat)}, {"CMat", copies(source.CMat)}, {"DMat", copies(source.DMat)}};
    auto const bounds1 = [](auto const &value) -> json {
        return value ? json{{"lower", value->lower}, {"upper", value->upper}, {"size", value->size}} : json(nullptr);
    };
    auto const bounds2 = [](auto const &value) -> json {
        return value ? json{{"lower1", value->lower1}, {"upper1", value->upper1},
                            {"lower2", value->lower2}, {"upper2", value->upper2}, {"size", value->size}} : json(nullptr);
    };
    bool failure = false; json kinds = json::array();
    for (std::size_t index = 0; index < source.failure_kinds.size(); ++index) {
        auto const kind = static_cast<EnergyPlus::CTF10Observation::MatrixAttemptFailureKind>(index);
        kinds.push_back({{"kind", matrix_failure_kind(kind)}, {"failed", source.failure_kinds[index]}});
        failure = failure || source.failure_kinds[index];
    }
    bool const available = source.reached && source.active_prefix_available && source.matrices_available && !failure;
    return {{"observed_attempt_ordinal", source.observed_attempt_ordinal}, {"reached", source.reached}, {"available", available},
        {"unavailable_reason", available ? json(nullptr) : json("required_matrix_observer_integrity_failure")}, {"failure_kinds", kinds},
        {"snapshot", {{"ErrorsFound", source.ErrorsFound}, {"DoCTFErrorReport", source.DoCTFErrorReport},
            {"IsUsedCTF", source.IsUsedCTF}, {"SourceSinkPresent", source.SourceSinkPresent},
            {"SolutionDimensions", source.SolutionDimensions}, {"TotLayers", source.TotLayers},
            {"LayersInConstruct", source.LayersInConstruct}, {"NumResLayers", source.NumResLayers},
            {"rcmax", source.rcmax}, {"NodeSource", source.NodeSource}, {"NodeUserTemp", source.NodeUserTemp},
            {"CTFTimeStep", scalar_bits(source.CTFTimeStep.bits)}, {"NumHistories", source.NumHistories},
            {"TimeStepZone", scalar_bits(source.TimeStepZone.bits)}, {"active_prefix_available", source.active_prefix_available},
            {"copied_layer_count", source.copied_layer_count}, {"active_prefix", layers},
            {"matrices_available", source.matrices_available}, {"matrices", matrices},
            {"actual_bounds", {{"AMat", bounds2(source.AMat_bounds)}, {"IdenMatrix", bounds2(source.IdenMatrix_bounds)},
                {"BMat", bounds1(source.BMat_bounds)}, {"CMat", bounds1(source.CMat_bounds)}, {"DMat", bounds1(source.DMat_bounds)}}}}}};
}
inline bool matrix_observer_failed(EnergyPlus::CTF10Observation::Capture const &capture)
{
    if (capture.matrix_observer_failure || capture.matrix_attempt_records_omitted != 0 ||
        capture.actual_matrix_attempt_callback_count != capture.matrix_attempts.size()) return true;
    for (auto count : capture.matrix_failure_event_counts) if (count != 0) return true;
    if (capture.first_matrix_failure || capture.last_matrix_failure) return true;
    for (std::size_t index = 0; index < capture.matrix_attempts.size(); ++index) {
        auto const &record = capture.matrix_attempts[index];
        if (record.observed_attempt_ordinal != index + 1 || !record.reached ||
            !record.active_prefix_available || !record.matrices_available ||
            record.LayersInConstruct < 1 || record.LayersInConstruct > EnergyPlus::Construction::MaxLayersInConstruct ||
            record.copied_layer_count != static_cast<std::size_t>(record.LayersInConstruct) || record.rcmax < 1) return true;
        for (auto failed : record.failure_kinds) if (failed) return true;
        auto const count = static_cast<std::size_t>(record.rcmax);
        if (count > std::numeric_limits<std::size_t>::max() / count ||
            record.AMat.size() != count * count || record.IdenMatrix.size() != count * count) return true;
    }
    return false;
}
inline json matrix_observations(EnergyPlus::CTF10Observation::Capture const &capture)
{
    json attempts = json::array(), failures = json::array();
    for (auto const &attempt : capture.matrix_attempts) attempts.push_back(matrix_attempt(attempt));
    for (std::size_t index = 0; index < capture.matrix_failure_event_counts.size(); ++index)
        failures.push_back({{"kind", matrix_failure_kind(static_cast<EnergyPlus::CTF10Observation::MatrixAttemptFailureKind>(index))},
                            {"actual_event_count", capture.matrix_failure_event_counts[index]}});
    auto const event = [](auto const &value) -> json {
        return value ? json{{"observed_attempt_ordinal", value->observed_attempt_ordinal}, {"kind", matrix_failure_kind(value->kind)}} : json(nullptr);
    };
    return {{"protocol", "ctf04-matrix-assembly.v1"}, {"actual_matrix_attempt_callback_count", capture.actual_matrix_attempt_callback_count},
        {"actual_retained_attempt_count", capture.matrix_attempts.size()}, {"matrix_attempt_records_omitted", capture.matrix_attempt_records_omitted},
        {"matrix_observer_failure", capture.matrix_observer_failure}, {"matrix_copy_integrity_failed", matrix_observer_failed(capture)},
        {"matrix_failure_event_counts", failures}, {"first_matrix_failure", event(capture.first_matrix_failure)},
        {"last_matrix_failure", event(capture.last_matrix_failure)}, {"attempts", attempts},
        {"no_callback_reached", capture.actual_matrix_attempt_callback_count == 0}, {"unreached_counted_as_PASS", false},
        {"matrix_or_identity_or_retry_state_reconstructed", false}, {"old_checkpoint_counters_include_matrix_callbacks", false}};
}

inline json matrix_failure_kind(EnergyPlus::CTF10Observation::MatrixAttemptFailureKind kind)
{
    using Kind = EnergyPlus::CTF10Observation::MatrixAttemptFailureKind;
    switch (kind) {
    case Kind::IdentityMismatch: return "IdentityMismatch";
    case Kind::OrderFailure: return "OrderFailure";
    case Kind::ActivePrefixShape: return "ActivePrefixShape";

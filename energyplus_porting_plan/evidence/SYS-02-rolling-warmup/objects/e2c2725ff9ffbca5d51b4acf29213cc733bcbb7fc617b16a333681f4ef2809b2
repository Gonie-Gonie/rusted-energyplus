+def ref(path):
+    data = path.read_bytes()
+    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
+            'size_bytes': len(data), 'line_count': len(data.splitlines())}
+
+
+def checked(row):
+    path = (ROOT / row['path']).resolve()
+    assert path.is_relative_to(ROOT)
+    data = path.read_bytes()
+    assert hashlib.sha256(data).hexdigest() == row['sha256']
+    assert 'size_bytes' not in row or len(data) == row['size_bytes']
+    return data
+
+
+def put(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+    return ref(path)
+
+
+def one(data, old, new):
+    assert data.count(old) == 1
+    return data.replace(old, new)
+
+

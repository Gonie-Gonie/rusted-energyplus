//! Selected rolling-owner contracts exercise the real private Record/Check methods.
use super::*;

#[test]
fn record_shifts_full_rolling_history_and_daily_reset_preserves_bits() {
    let mut zone = HeatBalanceWarmupZoneConvergence::new(ep_model::ZoneId(0));
    assert_eq!(zone.rolling.map(f64::to_bits), [0; 6]);
    zone.record(-0.0, -0.0, 0.0);
    assert_eq!(zone.rolling[0].to_bits(), (-0.0_f64).to_bits());
    // Original ObjexxFCL::max retains its first operand on an equal comparison.
    assert_eq!(zone.rolling[1].to_bits(), (-0.0_f64).to_bits());
    zone.record(12.0, 2.0, 3.0);
    assert_eq!(
        zone.rolling.map(f64::to_bits),
        [12.0_f64, 3.0, -0.0, -0.0, 0.0, 0.0].map(f64::to_bits),
    );
    let before_check = zone.rolling.map(f64::to_bits);
    let _ = zone.check(0.0, 0.0);
    zone.retain_and_reset();
    assert_eq!(zone.rolling.map(f64::to_bits), before_check);
    assert_eq!(zone.current, [-9999.0, -9999.0, -9999.0, 1000.0]);
    zone.record(14.0, 4.0, 1.0);
    assert_eq!(
        zone.rolling.map(f64::to_bits),
        [14.0_f64, 4.0, 12.0, 3.0, -0.0, -0.0].map(f64::to_bits),
    );
}

#[test]
fn two_zone_records_and_real_day_check_keep_independent_rolling_owners() {
    let mut owner = HeatBalanceWarmupConvergenceState {
        zones: vec![
            HeatBalanceWarmupZoneConvergence::new(ep_model::ZoneId(0)),
            HeatBalanceWarmupZoneConvergence::new(ep_model::ZoneId(1)),
        ],
        checked_day: 0,
        convergence_checks_failed: false,
        warmup_flag: true,
        maximum_day_forced_exit: false,
        unavailable_reason: None,
    };
    owner.zones[0].record(5.0, 1.0, 4.0);
    owner.zones[1].record(-2.0, 8.0, 3.0);
    owner.zones[0].record(7.0, 2.0, 6.0);
    assert_eq!(owner.zones[0].rolling, [7.0, 6.0, 5.0, 4.0, 0.0, 0.0]);
    assert_eq!(owner.zones[1].rolling, [-2.0, 8.0, 0.0, 0.0, 0.0, 0.0]);
    let before = owner.zones.iter().map(|z| z.rolling.map(f64::to_bits)).collect::<Vec<_>>();
    owner.check_day(1, HeatBalanceWarmupOptions {
        enabled: true,
        minimum_days: 1,
        maximum_days: 3,
        temperature_convergence_tolerance_delta_c: 0.0,
        loads_convergence_tolerance_w: 0.0,
    });
    assert_eq!(owner.zones.iter().map(|z| z.rolling.map(f64::to_bits)).collect::<Vec<_>>(), before);
    owner.zones[1].record(-3.0, 2.0, 9.0);
    assert_eq!(owner.zones[0].rolling, [7.0, 6.0, 5.0, 4.0, 0.0, 0.0]);
    assert_eq!(owner.zones[1].rolling, [-3.0, 9.0, -2.0, 8.0, 0.0, 0.0]);
    assert_eq!(owner.zones[0].zone_id, ep_model::ZoneId(0));
    assert_eq!(owner.zones[1].zone_id, ep_model::ZoneId(1));
}

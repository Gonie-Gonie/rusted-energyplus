def boot(name, filename, digest):
    path = PREP / filename
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise ValueError("Reviewed stdlib reader dependency differs before import")
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    return module


def run(args):
    m = boot("ctf10_production_data_io", "packet_io.py", IO_SHA)
    shape = boot("ctf10_production_data_shape", "production_shape.py", SHAPE_SHA)
    initial = boot("ctf10_initial_shape", "initial_shape.py", INITIAL_SHA)
    methods = boot("ctf10_method_shape", "method_shape.py", METHOD_SHA)
    gamma = boot("ctf10_gamma_shape", "gamma_shape.py", GAMMA_SHA)
    coefficients = boot("ctf10_coefficient_shape", "coefficient_shape.py", COEFFICIENT_SHA)
    retry = boot("ctf10_retry_shape", "retry_shape.py", RETRY_SHA)
    public = boot("ctf10_public_shape", "public_shape.py", PUBLIC_SHA)
    started = datetime.now(timezone.utc).isoformat()
    m.require(m.identity(__file__)["sha256"] == args.approved_source_sha256, "Root-reviewed reader SHA required")
    for path in [Path(__file__), PREP / "production_shape.py", PREP / "initial_shape.py", PREP / "method_shape.py", PREP / "gamma_shape.py", PREP / "coefficient_shape.py", PREP / "retry_shape.py", PREP / "public_shape.py", PREP / "packet_io.py"]: m.bind(m.identity(path))
    m.require(Path.cwd().resolve() == m.ROOT, "Recorded repository cwd required")

    def same(left, right):
        for row in [left, right]:
            m.require(re.fullmatch("[0-9a-f]{64}", row["sha256"]), "Actual reference SHA required")
        m.require(m.contained(left["path"], existing=False) == m.contained(right["path"], existing=False) and
                  left["sha256"] == right["sha256"], "Actual direct artifact identities differ")

    def instant(text):
        value = datetime.fromisoformat(text.replace("Z", "+00:00"))
        m.require(value.tzinfo is not None, "Aware actual UTC interval required")
        return value

    def recorded(ref, before=None, require_zero=True):
        value = m.load(ref)
        m.require(value["schema"] == "recorded-porting-command.v1" and type(value["exit_code"]) is int and
                  value["source_bytes_match_before_and_after"] is True and Path(value["cwd"]).resolve() == m.ROOT,
                  "Genuine source-preserving repository recorder required")
        if require_zero:
            m.require(value["exit_code"] == 0 and value["launch_error"] is None, "Actual successful recorded command required")
        m.require(instant(value["started_utc"]) <= instant(value["finished_utc"]), "Actual command interval differs")
        if before is not None:
            m.require(instant(value["finished_utc"]) <= instant(before), "Required preceding actual command is later")
        for key in ["stdout", "stderr"]: m.bind(value[key])
        m.require(value["executed_launcher"]["historical_path"] == "tools/porting/record_command.py", "Actual recorder source owner differs")
        m.bind(value["executed_launcher"]["archive"])
        return value

    names = ["native-execution", "results", "freeze-receipt", "freeze-execution", "build", "build-execution", "build-review", "build-review-execution"]
    refs = {name: m.argument(getattr(args, name.replace("-", "_"))) for name in names if name != "results"}
    native = recorded(refs["native-execution"], started, require_zero=False)
    freeze = m.load(refs["freeze-receipt"])
    frozen_command = recorded(refs["freeze-execution"], native["started_utc"])
    m.require(m.load(frozen_command["stdout"]) == freeze and freeze["schema"] == "ctf10-production-frozen-packet.v1" and
              freeze["status"] == "frozen-inherited-input-and-fresh-CTF10-public-storage-policy-before-helper" and
              freeze["frozen_before_this_CTF10_helper_execution"] is True and freeze["numerical_PASS_claimed"] is False,
              "Genuine input-only freeze0/full recorder stdout required")
    approval = freeze["source_preparation_approval"]
    m.require(approval["source_manifest"]["sha256"] == "839495c10e16c647851f783531e58314746ed70e8c1ac0ff9c15297fd0bad1b2", "Exact reviewed freezer manifest required")
    approved_sources = [m.bind(row) for row in approval["reviewed_sources"]]
    m.require(len(approved_sources) == len(freeze["executed_writer_sources"]) == 2 and
              approved_sources[0]["sha256"] == approval["approved_writer_sha256"] ==
              "08238b07360fb7d082974865fd8108a089f9bacf61d0b8ce972a80bba846342f", "Exact approved fresh freezer identity required")
    for declared, copied in zip(approved_sources, freeze["executed_writer_sources"]):
        m.require(copied["historical_path"] == declared["path"] and
                  m.bind(copied["archive"])["sha256"] == declared["sha256"], "Executed freezer source owner/archive differs")
    m.require([m.bind(row) for row in m.load(approval["source_manifest"])["own_sources"]] == approved_sources, "Actual freezer approval inventory differs")
    argv = frozen_command["command"]
    m.require(len(argv) == 25 and Path(argv[0]).name.lower() in ["python", "python.exe"] and
              argv[1:4] == ["-X", "utf8", "-B"] and m.contained(argv[4]) == m.contained(approved_sources[0]["path"]),
              "Actual fresh freezer command/source differs")
    tail = argv[5:]; flags = dict(zip(tail[::2], tail[1::2]))
    m.require(len(flags) == 10 and set(flags) == {"--lane", "--approved-source-sha256", "--source-manifest", "--native-source-manifest", "--current-card-10",
              "--actual-scope-amendment", "--actual-scope-amendment-execution", "--prior-09-freeze", "--prior-09-freeze-execution", "--output-dir"} and
              flags["--lane"] == LANE and flags["--approved-source-sha256"] == approval["approved_writer_sha256"], "Actual freezer flags differ")
    authority = freeze["source_authorities"]; prior = authority["historical_prior_09_authority"]
    for flag, ref in [("source-manifest", approval["source_manifest"]), ("native-source-manifest", authority["native_source_manifest"]),
                      ("current-card-10", authority["current_cards"]["CTF-10"]), ("actual-scope-amendment", authority["actual_scope_amendment"]),
                      ("actual-scope-amendment-execution", authority["actual_scope_amendment_execution"]), ("prior-09-freeze", prior["prior_09_freeze"]),
                      ("prior-09-freeze-execution", prior["prior_09_freeze_execution"])]:
        same(m.argument(flags["--" + flag]), ref)
    m.require(m.contained(flags["--output-dir"], existing=False) == m.contained(freeze["helper_request"]["path"]).parent and
              m.contained(frozen_command["stderr"]["path"]).stat().st_size == 0, "Actual freezer output/stderr differs")
    request_ref, admission_ref, projection_ref = freeze["helper_request"], freeze["native_admission_contract"], freeze["projection"]
    request, admission, projection = m.load(request_ref), m.load(admission_ref), m.load(projection_ref)
    m.require(request["schema"] == "ctf10-production-helper-cases.v1" and admission["schema"] == "ctf10-production-native-admission-contract.v1" and
              projection["schema"] == "ctf10-production-observation-projection.v1", "Actual frozen CTF packet schemas required")
    same(admission["helper_request"], request_ref); same(admission["projection"], projection_ref); same(projection["helper_request"], request_ref)
    m.require(set(request["contracts"]) == {"source", "tolerances"} and set(admission["contracts"]) == {"source", "cases", "tolerances"} and
              admission["contracts"] == projection["contracts"] == freeze["contracts"] and
              projection["native_observation_policy"] == request["observation_policy"], "Actual one-way contract policy differs")
    for value in [freeze, request, admission, projection]:
        m.require(value["frozen_before_this_CTF10_helper_execution"] is True and value["expected_values_supplied"] is False and
                  value["expected_exits_supplied"] is False and value["scientific_execution_performed"] is False, "Production input-only policy differs")
    contracts = {}
    for key, ref in freeze["contracts"].items():
        contract = m.load(ref)
        m.require(contract["schema"] == "ctf10-production-" + key + "-contract.v1" and contract["frozen_before_this_CTF10_helper_execution"] is True, "Frozen contract differs")
        m.require(contract["expected_values_supplied"] is False and contract["expected_exits_supplied"] is False and
                  contract["scientific_execution_performed"] is False, "Contract must remain input-only")
        contracts[key] = contract
        if key in request["contracts"]: same(request["contracts"][key], ref)
    source_manifest = m.load(freeze["source_authorities"]["native_source_manifest"])
    m.require(source_manifest["schema"] == "ctf10-native-helper-source-preparation.v1" and
              freeze["source_authorities"]["native_source_manifest"]["sha256"] ==
              "1aca57d1c46b6d1a0e756deb61328413a071abc74f4bc9e241f35915a2b20b63" and
              admission["native_source_files"] == [m.bind(row) for row in source_manifest["native_source_files_by_lane"][LANE]], "Exact reviewed Native9 inventory required")
    passive_ref = source_manifest["accepted10_passive_manifest"]
    m.require(passive_ref["sha256"] == "a2765a61087045ecb400f260740216bcc6b0330e91975a0168eeead09bb7645d", "Exact passive matrix observer required")
    m.bind(passive_ref)
    public.scope(m, same, recorded, freeze, request, admission, projection, m.load(passive_ref), frozen_command["started_utc"], LANE, coefficients, retry)
    pe_inventory = m.bind({"path": ".runtime/porting/CTF-10/native-build-review-prep-01/manifest.json",
                           "sha256": "4ba85e024746836e861a7161215f791c2980fcb8603d5f04fbcc3606344c2eee"})
    for row in freeze["reviewed_source_archives"]: m.bind(row["archive"])
    inherited = m.load(freeze["source_authorities"]["inherited_input_only_packet"]["request"])
    m.require(request["model_cases"] == inherited["model_cases"] and request["requested_counts"] == inherited["requested_counts"] and
              request["observation_policy"] == inherited["observation_policy"], "Inherited literal input/caller/order must remain exact")
    if LANE == "production": m.require(request["loader_phase_order"] == inherited["loader_phase_order"], "Inherited lifecycle order differs")
    same(contracts["tolerances"]["inherited_ctf01_tolerances"], freeze["source_authorities"]["inherited_input_only_packet"]["tolerances"])
    initial.packet(freeze, request, admission, projection, contracts["tolerances"],
                  m.load(contracts["tolerances"]["inherited_ctf01_tolerances"]), m.require)
    methods.packet(freeze, request, admission, projection, contracts["tolerances"], m.require)
    gamma.packet(freeze, request, admission, projection, contracts["tolerances"], m.require)
    coefficients.packet(freeze, request, admission, projection, contracts["tolerances"], m.require)
    retry.packet(freeze, request, admission, projection, contracts["tolerances"], m.require)
    public.packet(freeze, request, admission, projection, contracts["tolerances"], m.require)
    primary_ranges = [r["range"] for r in source_manifest["source_inventory"] if "range" in r and r["source"]["path"].startswith(".reference/energyplus-src/26.1.0/")]
    primary_ranges += [r for r in source_manifest["additional_API_ranges"] if r["path"].startswith(".reference/energyplus-src/26.1.0/")]
    for selected in primary_ranges:
        bound = m.bind(m.identity(selected["path"]))
        lines = m.contained(bound["path"]).read_bytes().splitlines(True)
        lo, hi = selected.get("first_line", selected.get("start_line")), selected.get("last_line", selected.get("end_line"))
        m.require(type(lo) is int and type(hi) is int and 1 <= lo <= hi <= len(lines) and selected.get("bytes_normalized", False) is False, "Typed actual current primary source range required")
        data = b"".join(lines[lo - 1:hi])
        m.require(hashlib.sha256(data).hexdigest() == selected["sha256"] and len(data) == selected["size_bytes"], "Actual current primary source range differs")
    m.require(contracts["source"]["source_authorities"] == freeze["source_authorities"] and
              contracts["source"]["ctf10_selected_primary_ranges"] == primary_ranges,
              "Actual current10 source authority and selected ranges differ")
    original_sources = contracts["source"]["source_files"]
    m.require(len(original_sources) == (7 if LANE == "unit" else 21), "Actual inherited Original inventory differs")
    for row in original_sources:
        bound = m.bind({**row, "path": ".reference/energyplus-src/26.1.0/" + row["path"]})
        lines = m.contained(bound["path"]).read_bytes().splitlines(True)
        for selected in row.get("selected_ranges", []):
            lo, hi = selected["start_line"], selected["end_line"]
            m.require(type(lo) is int and type(hi) is int and 1 <= lo <= hi <= len(lines) and selected.get("bytes_normalized", False) is False,
                      "Actual inherited source range metadata differs")
            data = b"".join(lines[lo - 1:hi])
            m.require(hashlib.sha256(data).hexdigest() == selected["sha256"] and len(data) == selected["size_bytes"], "Actual inherited source range differs")
    same(contracts["cases"]["helper_request"], request_ref)
    for key in ["source", "tolerances"]: same(contracts["cases"][key], freeze["contracts"][key])
    for row in request["all_45_guard_refs"]: m.bind(row)
    m.require(len(request["all_45_guard_refs"]) == 45, "Exact inherited 45 guards required")
    scope = m.load(request["fixed_scope"])
    m.require(request["all_45_guard_refs"] == [row[key] for row in scope["cases"] for key in ["input", "weather", "metadata"]] and
              contracts["cases"]["fixed_CON_scope"] == request["fixed_scope"] and contracts["cases"]["all_45_guard_refs"] == request["all_45_guard_refs"] and
              [{"id": row["id"], "input": row["input"]} for row in request["model_cases"]] == [{"id": row["id"], "input": row["input"]} for row in scope["cases"]],
              "Fixed15/ordered45 source-input associations differ")
    m.require(m.contained(frozen_command["stderr"]["path"]).stat().st_size == 0, "Actual freeze stderr differs")
    m.require(request["loader_phase_order"] == admission["loader_phase_order"] and len(request["loader_phase_order"]) == 13 and
              request["requested_counts"] == {"model_cases": len(request["model_cases"]), "loader_phase_records": len(request["model_cases"]) * len(request["loader_phase_order"])} and
              len(request["model_cases"]) == 15, "Production requested counts must derive from actual fixed arrays")
    build, peer = m.load(refs["build"]), m.load(refs["build-review"])
    compile_command = recorded(refs["build-execution"], native["started_utc"])
    peer_command = recorded(refs["build-review-execution"], native["started_utc"])
    m.require(build["schema"] == "ctf10-production-native-build.v1" and build["status"] == "pass-actual-4TU-link-and-preservation", "Actual build identity required")
    for key in ["all_previous_compile_commands_unchanged", "protected_artifacts_and_present_core_objects_unchanged", "link_provider_verified"]:
        m.require(build[key] is True, "Actual build preservation/provider evidence required")
    for key in ["previous_compile_rows", "current_compile_rows", "core_registered", "core_present", "core_absent", "protected_ref_count"]:
        m.require(type(build[key]) is int and build[key] >= 0, "Typed actual build inventory count required")
    m.require(build["current_compile_rows"] == build["previous_compile_rows"] + 8 and build["core_registered"] == 643 and
              build["core_present"] + build["core_absent"] == 643, "Actual registered/present/absent build inventory differs")
    preservation = m.load(build["preservation"])
    for key in ["all_protected_refs_unchanged", "all_present_core_objects_unchanged", "absent_registered_objects_still_absent", "all_previous_compile_commands_unchanged"]:
        m.require(preservation[key] is True, "Actual protected/cache preservation differs")
    m.require(isinstance(preservation["protected_refs"], list) and len(preservation["protected_refs"]) == build["protected_ref_count"] > 0 and
              len(preservation["present_objects"]) == build["core_present"] and
              len(preservation["absent_registered_object_paths"]) == build["core_absent"] and
              all(preservation[key] == build[key] for key in ["previous_compile_rows", "current_compile_rows", "core_registered"]) and
              preservation["selected_core_Construction_object_hits"] == 0 and
              preservation["selected_core_HeatBalanceManager_object_hits"] == 0 and
              "native-observer-prep-01/HeatBalanceManager.ctf10.cc.obj" in preservation["derived_HeatBalanceManager_provider"]["section_provider"]["text"].replace("\\", "/") and
              "native-observer-prep-01/Construction.ctf10.cc.obj" in preservation["derived_provider"]["section_provider"]["text"].replace("\\", "/"),
              "Actual protected/core/provider metadata differs")
    # Reuse the genuine unit core check; a new expensive check is not required.
    recorded(build["core_before_check"], compile_command["started_utc"])
    same(build["compile_execution"], refs["build-execution"])
    for key in ["configure_execution", "derivation_execution"]: recorded(build[key], native["started_utc"])
    m.bind(build["validated_derivative"])
    m.require(peer["schema"] == "ctf10-production-independent-build-PE-review.v1" and
              peer["status"] == "pass-exact-retained-PE-runtime-and-actual-build-identity" and peer["retained_runtime_exact"] is True,
              "Actual independent build/PE review required")
    m.require(build["target"] == peer["target"] == "ctf10_" + LANE + "_helper" and peer["lane"] == LANE and
              peer["actual_previous_compile_rows"] == build["previous_compile_rows"] and
              peer["actual_current_compile_rows"] == build["current_compile_rows"] and
              peer["actual_protected_ref_count"] == build["protected_ref_count"], "Actual lane/target/PE inventory copy differs")
    same(peer["build"], refs["build"])
    peer_reader = m.bind(peer["executed_reader"])
    m.require(peer_reader["sha256"] == args.approved_build_review_source_sha256 == "1dbb0054716d64aa030837aa7f011cdf4681772e00db7e90e1595501d84ff95e" and
              re.fullmatch("[0-9a-f]{64}", args.approved_build_review_source_sha256) and len(peer_command["command"]) == 11 and
              Path(peer_command["command"][0]).name.lower() in ["python", "python.exe"] and
              peer_command["command"][1:4] == ["-X", "utf8", "-B"] and
              m.contained(peer_command["command"][4]) == m.contained(peer_reader["path"]) and
              peer_command["command"][5:8] == ["--lane", LANE, "--build"] and
              peer_command["command"][9] == "--output-dir", "Actual approved PE reader command/source differs")
    same(m.argument(peer_command["command"][8]), refs["build"])
    m.require(m.contained(peer_command["command"][10], existing=False) == m.contained(refs["build-review"]["path"]).parent,
              "Actual approved PE output directory differs")
    peer_stdout = m.load(peer_command["stdout"])
    m.require(set(peer_stdout) == {"review", "status"} and peer_stdout["status"] == peer["status"], "Actual PE stdout must be its exact compact two-key summary")
    same(peer_stdout["review"], refs["build-review"]); m.bind(peer_stdout["review"])
    m.require(m.contained(peer_command["stderr"]["path"]).stat().st_size == 0, "Actual independent PE stderr differs")
    for key in ["helper_binary", "linked_original", "validated_derivative"]: same(peer[key], build[key])
    m.bind(peer["native_pe_source"])
    maps = {key: m.load(peer["maps"][key]) for key in ["original", "derived", "comparison"]}
    for key, binary in [("original", "linked_original"), ("derived", "helper_binary")]:
        m.require(maps[key]["sha256"] == build[binary]["sha256"] and type(maps[key]["size_bytes"]) is int and
                  maps[key]["size_bytes"] > 0, "Actual PE map binary identity/size differs")
    m.require(build["linked_original_retention_intent"] == peer["linked_original_retention_intent"] == freeze["linked_original_retention_intent"] == initial.RETENTION_INTENT, "Actual new linked Original custody/intent differs")
    native_sources = admission["native_source_files"]
    m.require(len(native_sources) == 9 and len(build["native_source_files"]) == 9, "Actual source9 required")
    for declared, compiled in zip(native_sources, build["native_source_files"]): same(declared, compiled); m.bind(declared)
    m.require(instant(frozen_command["finished_utc"]) <= instant(compile_command["started_utc"]), "Freeze must precede actual Native compilation")
    result_name, separator, result_sha = args.results.rpartition("#")
    if not separator: result_name, result_sha = args.results, None
    m.require(result_sha is None or re.fullmatch("[0-9a-f]{64}", result_sha), "Explicit preserved result SHA required when a file exists")
    result_path = m.contained(result_name, existing=False)
    m.require(result_path.name == "ctf10-production-helper-results.json", "Genuine helper result filename required")
    expected_argv = [m.contained(build["helper_binary"]["path"], existing=False), m.ROOT, m.contained(request_ref["path"]),
                     m.contained(admission_ref["path"]), result_path.parent]
    m.require(len(native["command"]) == 5 and [Path(value).resolve() if index == 1 else m.contained(value, existing=False) for index, value in enumerate(native["command"])] == expected_argv,
              "Actual direct Native argc5 command differs")
    counts, integrity, result_ref, output_files = None, [], None, []
    complete = False
    if result_path.is_file() and native["launch_error"] is None:
        m.require(result_sha is not None, "Existing actual result requires its supplied SHA")
        result_ref = m.bind_observation({"path": result_name, "sha256": result_sha})
        # Actual scientific serialization uses the 1GiB physical bound, not the 16MB small-metadata parser cap.
        result = json.loads(result_path.read_text(encoding="utf-8"), object_pairs_hook=m.unique_object,
                            parse_constant=lambda value: m.require(False, "Nonfinite JSON literal: " + value))
        m.require(result["schema"] == "ctf10-production-helper-results.v1" and result["complete_requested_model_ledger"] is True and
                  result["energyplus_commit"] == request["energyplus_commit"] and set(result["contracts"]) == set(freeze["contracts"]) and
                  result["requested_counts"] == freeze["requested_counts"] == request["requested_counts"] == admission["requested_counts"],
                  "Actual complete result ledger/source/count identities differ")
        for key, ref in freeze["contracts"].items(): same(result["contracts"][key], ref)
        for key, ref in [("actual_request", request_ref), ("native_admission_contract", admission_ref), ("observation_projection", projection_ref),
                         ("actual_binary", build["helper_binary"])]: same(result[key], ref)
        m.require(type(result["actual_binary"]["size_bytes"]) is int and result["actual_binary"]["size_bytes"] == maps["derived"]["size_bytes"], "Observed binary size differs from actual PE map")
        for key in ["actual_scope_amendment", "actual_scope_amendment_execution", "fixed_scope", "all_45_guard_refs", "native_source_files"]:
            m.require(result[key] == (admission[key] if key == "native_source_files" else request[key]), "Actual source/scope/input binding differs")
        for key in ["complete_all_phase_observations_claimed", "scientific_comparison_performed", "numerical_PASS_claimed", "gates_updated", "whole_building_or_CTF02_through_CTF10_certified"]:
            m.require(result[key] is False, "Actual result scope exceeds selected source")
        m.require(result["CTF03_initial_observation_policy"] == initial.POLICY and result["CTF04_matrix_observation_policy"] == initial.MATRIX_POLICY, "Actual initial/matrix output policies differ")
        for key, expected in [("CTF06_exponential_observation_policy", methods.POLICIES["ctf06_exponential_observation_policy"]),
                              ("CTF05_inverse_observation_policy", methods.POLICIES["ctf05_inverse_observation_policy"]),
                              ("CTF07_gamma_observation_policy", gamma.POLICY),
                              ("CTF08_final_coefficient_observation_policy", coefficients.POLICY),

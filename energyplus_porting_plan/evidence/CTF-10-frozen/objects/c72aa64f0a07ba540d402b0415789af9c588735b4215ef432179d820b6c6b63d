bool coefficient_prior_Gamma_returned(Capture const &capture,
                                      Construction::ConstructionProps const &construction,
                                      std::size_t ordinal) noexcept
{
    GammaCapture const &ledger = capture.gamma;
    std::size_t const returned = static_cast<std::size_t>(GammaStage::SourceReturn);
    if (ledger.actual_invocation_count != ordinal || ledger.actual_stage_callback_counts[returned] != ordinal ||
        ledger.invocations.empty() || !gamma_prior_methods_returned(capture, ordinal)) return false;
    GammaInvocationSnapshot const &prior = ledger.invocations.back();
    if (prior.observed_invocation_ordinal != ordinal || prior.observed_assembly_ordinal != ordinal ||
        !prior.association_available || !prior.source_return.reached ||
        !prior.source_return.caller_context_available || !prior.source_return.caller_TimeStepZone) return false;
    MatrixAttemptSnapshot const *assembly = associated_assembly(capture, construction, ordinal);
    if (assembly == nullptr) return false;
    MethodContext const &context = prior.source_return.context;
    return context.assembly_context_available &&
        context.IsUsedCTF == construction.IsUsedCTF && context.SourceSinkPresent == construction.SourceSinkPresent &&
        context.SolutionDimensions == construction.SolutionDimensions && context.TotLayers == construction.TotLayers &&
        context.rcmax == construction.rcmax && context.NodeSource == construction.NodeSource &&
        context.NodeUserTemp == construction.NodeUserTemp && context.NumHistories == construction.NumHistories &&
        context.CTFTimeStep.bits == copy_bits(construction.CTFTimeStep).bits &&
        context.assembly_ErrorsFound == assembly->ErrorsFound &&
        context.assembly_DoCTFErrorReport == assembly->DoCTFErrorReport &&
        context.assembly_TimeStepZone.bits == assembly->TimeStepZone.bits &&
        prior.source_return.caller_ErrorsFound == assembly->ErrorsFound &&
        prior.source_return.caller_DoCTFErrorReport == assembly->DoCTFErrorReport &&
        prior.source_return.caller_TimeStepZone->bits == assembly->TimeStepZone.bits;
}

FinalCoefficientInvocationSnapshot *coefficient_visit(Capture &capture,
    Construction::ConstructionProps const &construction, FinalCoefficientStage stage) noexcept
{
    FinalCoefficientCapture &ledger = capture.final_coefficients;
    std::size_t const index = static_cast<std::size_t>(stage);
    ++ledger.actual_stage_callback_counts[index];
    if (ledger.invocations.empty() ||
        ledger.invocations.back().observed_invocation_ordinal != ledger.actual_invocation_count) {
        ++ledger.stage_records_omitted[index];
        coefficient_failure(capture, nullptr, stage, MethodFailureKind::AssociationFailure);
        return nullptr;
    }
    FinalCoefficientInvocationSnapshot &invocation = ledger.invocations.back();
    if (++invocation.actual_stage_callback_counts[index] > 1) {
        ++ledger.stage_records_omitted[index];
        coefficient_failure(capture, &invocation, stage, MethodFailureKind::OrderFailure);
        return nullptr;
    }
    if (capture.bound_state == nullptr || capture.bound_construction != &construction) {
        coefficient_failure(capture, &invocation, stage, MethodFailureKind::IdentityMismatch);
    }
    if (invocation.observed_invocation_ordinal != invocation.observed_assembly_ordinal ||
        associated_assembly(capture, construction, invocation.observed_assembly_ordinal) == nullptr ||
        !coefficient_prior_Gamma_returned(capture, construction, invocation.observed_assembly_ordinal)) {
        coefficient_failure(capture, &invocation, stage, MethodFailureKind::AssociationFailure);
    }
    bool ordered = invocation.entry.reached && !invocation.source_return.reached;
    switch (stage) {
    case FinalCoefficientStage::PrivateFinal:
        ordered = ordered && !invocation.private_final.reached;
        break;
    case FinalCoefficientStage::SourceReturn:
        ordered = ordered && invocation.private_final.reached;
        break;
    case FinalCoefficientStage::Entry:
        ordered = false;
        break;
    }
    if (!ordered) coefficient_failure(capture, &invocation, stage, MethodFailureKind::OrderFailure);
    return &invocation;
}

struct FinalCoefficientMatrixView
{
    FinalCoefficientMatrixOwner owner;
    Array2D<Real64> const *values;
};

void copy_coefficient_matrices(Capture &capture, FinalCoefficientInvocationSnapshot &invocation,
    FinalCoefficientStage stage, Construction::ConstructionProps const &construction,
    FinalCoefficientValueSnapshot &snapshot, std::initializer_list<FinalCoefficientMatrixView> views) noexcept
{
    snapshot.reached = true;
    snapshot.context = method_context(capture, construction, invocation.observed_assembly_ordinal);
    snapshot.NumOfPerpendNodes = construction.NumOfPerpendNodes;
    if (capture.bound_state == nullptr || capture.bound_construction != &construction) return;
    if (views.size() > snapshot.matrices.size()) {
        coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
        return;
    }
    snapshot.observed_matrix_count = views.size();
    std::size_t index = 0;
    for (FinalCoefficientMatrixView const &view : views) {
        FinalCoefficientMatrixSnapshot &copy = snapshot.matrices[index++];
        copy.owner = view.owner;
        copy.bounds = array_bounds(*view.values);
    }
    int const n = snapshot.context.rcmax;
    if (n < 1) {
        coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
        return;
    }
    index = 0;
    bool complete = true;
    for (FinalCoefficientMatrixView const &view : views) {
        FinalCoefficientMatrixSnapshot &copy = snapshot.matrices[index++];
        bool const gamma = view.owner == FinalCoefficientMatrixOwner::Gamma1 || view.owner == FinalCoefficientMatrixOwner::Gamma2;
        int const rows = gamma || view.owner == FinalCoefficientMatrixOwner::s0 ? 3 : n;
        int const columns = view.owner == FinalCoefficientMatrixOwner::s0 ? 4 : n;
        std::size_t const row_count = static_cast<std::size_t>(rows);
        std::size_t const column_count = static_cast<std::size_t>(columns);
        if (column_count > std::numeric_limits<std::size_t>::max() / row_count) {
            complete = false;
            coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
            continue;
        }
        std::size_t const elements = row_count * column_count;
        if (!copy.bounds || copy.bounds->lower1 != 1 || copy.bounds->upper1 != rows ||
            copy.bounds->lower2 != 1 || copy.bounds->upper2 != columns || copy.bounds->size != elements) {
            complete = false;
            coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
            continue;
        }
        try {
            copy.values.reserve(elements);
            for (int i1 = 1; i1 <= rows; ++i1) {
                for (int i2 = 1; i2 <= columns; ++i2) {
                    copy.values.push_back(copy_bits((*view.values)(i1, i2)));
                }
            }
            copy.copy_available = copy.values.size() == elements;
            if (!copy.copy_available) {
                complete = false;
                coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
            }
        } catch (...) {
            copy.values.clear();
            complete = false;
            coefficient_failure(capture, &invocation, stage, MethodFailureKind::CopyException);
        }
    }
    snapshot.matrices_available = complete;
}

void copy_coefficient_history(Capture &capture, FinalCoefficientInvocationSnapshot &invocation,
    FinalCoefficientStage stage, Construction::ConstructionProps const &construction,
    FinalCoefficientValueSnapshot &snapshot) noexcept
{
    if (capture.bound_state == nullptr || capture.bound_construction != &construction) return;
    snapshot.NumCTFTerms = construction.NumCTFTerms;
    if (construction.s.allocated()) {
        snapshot.s_bounds = Array3Bounds{construction.s.l1(), construction.s.u1(),
            construction.s.l2(), construction.s.u2(), construction.s.l3(), construction.s.u3(), construction.s.size()};
    }
    snapshot.e_bounds = array_bounds(construction.e);
    int const n = construction.rcmax;
    if (n < 1 || static_cast<std::size_t>(n) > std::numeric_limits<std::size_t>::max() / 12) {
        coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
        return;
    }
    std::size_t const count = static_cast<std::size_t>(n);
    bool const s_shape = snapshot.s_bounds && snapshot.s_bounds->lower1 == 1 && snapshot.s_bounds->upper1 == 3 &&
        snapshot.s_bounds->lower2 == 1 && snapshot.s_bounds->upper2 == 4 &&
        snapshot.s_bounds->lower3 == 1 && snapshot.s_bounds->upper3 == n && snapshot.s_bounds->size == 12 * count;
    if (!s_shape) {
        coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
    } else {
        try {
            snapshot.s.reserve(12 * count);
            for (int j = 1; j <= 3; ++j) {
                for (int k = 1; k <= 4; ++k) {
                    for (int term = 1; term <= n; ++term) snapshot.s.push_back(copy_bits(construction.s(j, k, term)));
                }
            }
            snapshot.s_available = snapshot.s.size() == 12 * count;
            if (!snapshot.s_available) coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
        } catch (...) {
            snapshot.s.clear();
            coefficient_failure(capture, &invocation, stage, MethodFailureKind::CopyException);
        }
    }
    if (!exact_vector(snapshot.e_bounds, n)) {
        coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
    } else {
        try {
            snapshot.e.reserve(count);
            for (int term = 1; term <= n; ++term) snapshot.e.push_back(copy_bits(construction.e(term)));
            snapshot.e_available = snapshot.e.size() == count;
            if (!snapshot.e_available) coefficient_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
        } catch (...) {
            snapshot.e.clear();
            coefficient_failure(capture, &invocation, stage, MethodFailureKind::CopyException);
        }
    }
    snapshot.history_available = snapshot.s_available && snapshot.e_available;
}


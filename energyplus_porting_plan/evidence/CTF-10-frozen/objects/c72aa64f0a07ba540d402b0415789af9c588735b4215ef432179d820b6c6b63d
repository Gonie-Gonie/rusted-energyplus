void coefficient_failure(Capture &capture, FinalCoefficientInvocationSnapshot *invocation,
                          FinalCoefficientStage stage, MethodFailureKind kind) noexcept
{
    FinalCoefficientCapture &ledger = capture.final_coefficients;
    ledger.observer_failure = true;
    std::size_t const index = static_cast<std::size_t>(kind);
    ++ledger.failure_event_counts[index];
    if (invocation != nullptr) invocation->failure_kinds[index] = true;
    FinalCoefficientFailure const failure{ledger.actual_invocation_count,
        invocation == nullptr ? capture.actual_matrix_attempt_callback_count : invocation->observed_assembly_ordinal,
        stage, kind};

void retry_assigned_sums(EnergyPlusData const &state,
    Construction::ConstructionProps const &construction, bool ErrorsFound, bool DoCTFErrorReport,
    Real64 const &TimeStepZone, bool CTFConvrg,
    Real64 const &SumXi, Real64 const &SumYi, Real64 const &SumZi, Real64 const &BiggestSum) noexcept
{
    auto *copy = retry_event_copy(RetryEvent::AssignedSums, state, construction,
        ErrorsFound, DoCTFErrorReport, TimeStepZone, CTFConvrg);
    if (copy != nullptr) copy->assigned_sums = std::array<Binary64Copy, 4>{
        copy_bits(SumXi), copy_bits(SumYi), copy_bits(SumZi), copy_bits(BiggestSum)};
}

void retry_diagnostic(EnergyPlusData const &state, std::size_t actual_global_message_index,
    int actual_level, std::string const &actual_message) noexcept
{
    Capture *capture = active_capture;
    if (capture == nullptr) return; // Loader diagnostics have no bound whole CTF call.
    auto &ledger = capture->retry_driver;
    if (!retry_increment(*capture, ledger.actual_diagnostic_count, RetrySite::Diagnostic, ledger.actual_diagnostic_count)) return;
    auto const ordinal = ledger.actual_diagnostic_count;
    if (capture->bound_state != &state || capture->bound_construction == nullptr) {
        retry_increment(*capture, ledger.diagnostic_records_omitted, RetrySite::Diagnostic, ordinal);
        retry_failure(*capture, RetrySite::Diagnostic, ordinal, RetryFailureKind::IdentityMismatch);
        return;
    }
    try { ledger.diagnostics.emplace_back(); }
    catch (...) {
        retry_increment(*capture, ledger.diagnostic_records_omitted, RetrySite::Diagnostic, ordinal);
        retry_failure(*capture, RetrySite::Diagnostic, ordinal, RetryFailureKind::LedgerAppendException);
        return;
    }
    auto &copy = ledger.diagnostics.back();
    copy.observed_diagnostic_ordinal = ordinal;
    copy.actual_global_message_index = actual_global_message_index;
    copy.observed_pre_assignment_ordinal = ledger.actual_pre_assignment_count;
    copy.observed_post_assembly_callback_count = capture->actual_matrix_attempt_callback_count;
    if (!ledger.caller_events.empty() && ledger.caller_events.back().observed_event_ordinal == ledger.actual_caller_event_count)
        copy.preceding_caller_event_ordinal = ledger.actual_caller_event_count;
    copy.actual_level = actual_level;
    try { copy.actual_message = actual_message; copy.copy_available = true; }
    catch (...) { retry_failure(*capture, RetrySite::Diagnostic, ordinal, RetryFailureKind::CopyException, &copy.failure_kinds); }
}


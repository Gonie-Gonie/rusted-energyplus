void pre_matrix_assignment(EnergyPlusData const &state,
    Construction::ConstructionProps const &construction, bool ErrorsFound, bool DoCTFErrorReport,
    int LayersInConstruct, int NumResLayers,
    Array1D<Real64> const &dl, Array1D<Real64> const &rk, Array1D<Real64> const &rho,
    Array1D<Real64> const &cp, Array1D<Real64> const &lr, Array1D_bool const &ResLayer,
    Array1D_int const &Nodes, Array1D<Real64> const &dx,
    Real64 const &TimeStepZone, bool CTFConvrg) noexcept
{
    Capture *capture = active_capture;
    if (capture == nullptr) return;
    auto &ledger = capture->retry_driver;
    if (!retry_increment(*capture, ledger.actual_pre_assignment_count, RetrySite::PreAssignment, ledger.actual_pre_assignment_count)) return;
    auto const ordinal = ledger.actual_pre_assignment_count;
    if (capture->bound_state != &state || capture->bound_construction != &construction) {
        retry_increment(*capture, ledger.pre_assignment_records_omitted, RetrySite::PreAssignment, ordinal);
        retry_failure(*capture, RetrySite::PreAssignment, ordinal, RetryFailureKind::IdentityMismatch);
        return;
    }
    try { ledger.pre_assignments.emplace_back(); }
    catch (...) {
        retry_increment(*capture, ledger.pre_assignment_records_omitted, RetrySite::PreAssignment, ordinal);
        retry_failure(*capture, RetrySite::PreAssignment, ordinal, RetryFailureKind::LedgerAppendException);
        return;
    }
    auto &copy = ledger.pre_assignments.back();
    copy.observed_pre_assignment_ordinal = ordinal;
    copy.preceding_post_assembly_callback_count = capture->actual_matrix_attempt_callback_count;
    copy.reached = true;
    copy.context = retry_context(construction, ErrorsFound, DoCTFErrorReport, TimeStepZone, CTFConvrg);
    copy.LayersInConstruct = LayersInConstruct; copy.NumResLayers = NumResLayers;
    copy.association_available = retry_pre_association(*capture, copy);
    if (!copy.association_available) retry_failure(*capture, RetrySite::PreAssignment, ordinal,
        RetryFailureKind::AssociationFailure, &copy.failure_kinds);
    bool const prefix = LayersInConstruct > 0 && LayersInConstruct <= Construction::MaxLayersInConstruct &&
        NumResLayers >= 0 && NumResLayers <= LayersInConstruct &&
        covers_prefix(dl, LayersInConstruct) && covers_prefix(rk, LayersInConstruct) &&
        covers_prefix(rho, LayersInConstruct) && covers_prefix(cp, LayersInConstruct) &&
        covers_prefix(lr, LayersInConstruct) && covers_prefix(ResLayer, LayersInConstruct) &&
        covers_prefix(Nodes, LayersInConstruct) && covers_prefix(dx, LayersInConstruct);
    if (prefix) {
        for (int layer = 1; layer <= LayersInConstruct; ++layer) {
            auto &value = copy.active_prefix[static_cast<std::size_t>(layer - 1)];
            value.converted.dl = copy_bits(dl(layer)); value.converted.rk = copy_bits(rk(layer));
            value.converted.rho = copy_bits(rho(layer)); value.converted.cp = copy_bits(cp(layer));
            value.converted.lr = copy_bits(lr(layer)); value.converted.ResLayer = ResLayer(layer);
            value.Nodes = Nodes(layer); value.dx = copy_bits(dx(layer));
        }
        copy.copied_layer_count = static_cast<std::size_t>(LayersInConstruct);
        copy.active_prefix_available = true;
    } else retry_failure(*capture, RetrySite::PreAssignment, ordinal, RetryFailureKind::OwnerShape, &copy.failure_kinds);
    copy.AMat_bounds = array_bounds(construction.AMat);
    copy.IdenMatrix_bounds = array_bounds(construction.IdenMatrix);
    copy_retry_matrix(*capture, copy, construction.AMat, copy.AMat_bounds, copy.AMat, copy.AMat_available);
    copy_retry_matrix(*capture, copy, construction.IdenMatrix, copy.IdenMatrix_bounds, copy.IdenMatrix, copy.IdenMatrix_available);
    if (exact_vector(array_bounds(construction.BMat), 3)) copy.BMat3_after_reset = copy_bits(construction.BMat(3));
    else retry_failure(*capture, RetrySite::PreAssignment, ordinal, RetryFailureKind::OwnerShape, &copy.failure_kinds);
    copy.matrices_available = copy.AMat_available && copy.IdenMatrix_available;
}

void retry_caller_event(RetryEvent event, EnergyPlusData const &state,
    Construction::ConstructionProps const &construction, bool ErrorsFound, bool DoCTFErrorReport,

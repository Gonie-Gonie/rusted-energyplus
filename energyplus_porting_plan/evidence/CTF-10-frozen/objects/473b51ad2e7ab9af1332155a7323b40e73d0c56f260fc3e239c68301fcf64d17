+inline json public_snapshot(MethodObservation::PublicSnapshot const &source)
+{
+    json value = nullptr;
+    if (source.copy_available) {
+        json layers = nullptr;
+        if (source.original_layer_prefix_available) {
+            require(source.TotLayers >= 0 && static_cast<std::size_t>(source.TotLayers) <= source.original_LayerPoint.size(),
+                "Actual copied original membership exceeds declared capacity");
+            layers = json::array();
+            for (int layer = 0; layer < source.TotLayers; ++layer)
+                layers.push_back(source.original_LayerPoint[static_cast<std::size_t>(layer)]);
+        }
+        value = {{"actual_construction_address", source.actual_construction_address},
+            {"actual_construction_index", source.actual_construction_index}, {"actual_Name", source.actual_Name},
+            {"ErrorsFound", source.ErrorsFound}, {"DoCTFErrorReport", source.DoCTFErrorReport},
+            {"IsUsedCTF", source.IsUsedCTF}, {"SourceSinkPresent", source.SourceSinkPresent},
+            {"SolutionDimensions", source.SolutionDimensions}, {"TotLayers", source.TotLayers},
+            {"original_layer_prefix_available", source.original_layer_prefix_available}, {"original_LayerPoint", layers},
+            {"CTFCross", public_bits(source.CTFCross)}, {"CTFFlux", public_bits(source.CTFFlux)},
+            {"CTFInside", public_bits(source.CTFInside)}, {"CTFOutside", public_bits(source.CTFOutside)},
+            {"CTFSourceIn", public_bits(source.CTFSourceIn)}, {"CTFSourceOut", public_bits(source.CTFSourceOut)},
+            {"CTFTSourceOut", public_bits(source.CTFTSourceOut)}, {"CTFTSourceIn", public_bits(source.CTFTSourceIn)},
+            {"CTFTSourceQ", public_bits(source.CTFTSourceQ)}, {"CTFTUserOut", public_bits(source.CTFTUserOut)},
+            {"CTFTUserIn", public_bits(source.CTFTUserIn)}, {"CTFTUserSource", public_bits(source.CTFTUserSource)},
+            {"CTFTimeStep", scalar_bits(source.CTFTimeStep.bits)}, {"UValue", scalar_bits(source.UValue.bits)},
+            {"NumHistories", source.NumHistories}, {"NumCTFTerms", source.NumCTFTerms}};
+    }
+    return {{"reached", source.reached}, {"copy_available", source.copy_available}, {"snapshot", value},
+        {"unavailable_reason", source.copy_available ? json(nullptr) : json(source.reached ? "actual_copy_failed" : "source_checkpoint_not_reached")}};
+}
+inline json reverse_public_snapshot(MethodObservation::ReversePublicSnapshot const &source)
+{
+    return {{"reached", source.reached}, {"current", public_snapshot(source.current)},

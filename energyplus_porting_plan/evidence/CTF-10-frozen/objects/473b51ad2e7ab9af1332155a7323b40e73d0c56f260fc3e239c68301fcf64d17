+inline void add_public_totals(PublicTotals &total, json const &ledger)
+{
+    ++total.actual_whole_call_records;
+    for (std::size_t i = 0; i < total.sites.size(); ++i) {
+        total.sites[i] += ledger.at("actual_site_counts").at(i).at("actual_count").get<std::size_t>();
+        total.failures[i] += ledger.at("failure_kind_counts").at(i).at("actual_count").get<std::size_t>();
+    }
+    total.integrity_failed = total.integrity_failed || ledger.at("public_copy_integrity_failed").get<bool>();
+}

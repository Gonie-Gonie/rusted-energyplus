+inline bool public_copy_failed(MethodObservation::PublicCapture const &source)
+{
+    if (source.integrity_failed) return true;
+    auto const failed = [](MethodObservation::PublicSnapshot const &copy) {
+        return copy.reached && (!copy.copy_available || !copy.original_layer_prefix_available);
+    };
+    return failed(source.before_reset) || failed(source.after_reset) || failed(source.scope_exit) || failed(source.actual_caller_return) ||
+        failed(source.reverse_entry.current) || failed(source.reverse_entry.actual_provider) ||
+        failed(source.reverse_completed.current) || failed(source.reverse_completed.actual_provider);
+}
+inline json public_observations(MethodObservation::PublicCapture const &source)
+{
+    json sites = json::array(), failures = json::array();
+    for (std::size_t i = 0; i < source.actual_site_counts.size(); ++i)
+        sites.push_back({{"site", public_site_name(static_cast<MethodObservation::PublicSite>(i))}, {"actual_count", source.actual_site_counts[i]}});
+    for (std::size_t i = 0; i < source.failure_kind_counts.size(); ++i)
+        failures.push_back({{"kind", public_failure_name(static_cast<MethodObservation::PublicFailureKind>(i))}, {"actual_count", source.failure_kind_counts[i]}});
+    return {{"protocol", "ctf10-actual-public-storage-observation.v1"}, {"before_reset", public_snapshot(source.before_reset)},
+        {"after_reset", public_snapshot(source.after_reset)}, {"reverse_entry", reverse_public_snapshot(source.reverse_entry)},
+        {"reverse_completed", reverse_public_snapshot(source.reverse_completed)}, {"scope_exit", public_snapshot(source.scope_exit)},
+        {"scope_exited_during_unwind", source.scope_exited_during_unwind}, {"actual_caller_return", public_snapshot(source.actual_caller_return)},
+        {"actual_site_counts", sites}, {"failure_kind_counts", failures}, {"first_failure", public_failure_record(source.first_failure)},
+        {"last_failure", public_failure_record(source.last_failure)}, {"integrity_failed", source.integrity_failed},
+        {"public_copy_integrity_failed", public_copy_failed(source)}, {"declared_fixed_array_count", 12}, {"slots_per_array", 19},
+        {"observer_indices_derived_from_NumCTFTerms", false}, {"whole_Init_or_safe_Source_store_inferred", false},

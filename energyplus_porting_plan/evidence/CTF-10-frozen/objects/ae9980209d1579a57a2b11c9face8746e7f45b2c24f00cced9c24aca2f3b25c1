"""Bind this source-only ignored proposal; no reviewed-target imports or execution."""
from pathlib import Path
import ast
import difflib
import hashlib
import json
import re

ROOT = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent
OLD = ROOT / ".runtime/porting/CTF-09/native-helper-prep-01"
PASSIVE = ROOT / ".runtime/porting/CTF-10/native-observer-prep-01"
NAMES = ["ctf10_observation_fields.hh", "ctf10_unit_helper.cpp", "ctf10_unit_fields.hh", "ctf10_unit_admission.hh",
         "ctf10_production_helper.cpp", "ctf10_production_fields.hh", "ctf10_production_admission.hh", "ctf10_reference.cmake"]


def read(path):
    return path.read_bytes().decode("utf-8")


def ref(path):
    b = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(b).hexdigest(),
            "size_bytes": len(b), "line_count": len(b.splitlines())}


def byte_range(path, first, last, purpose):
    b = b"".join(path.read_bytes().splitlines(keepends=True)[first - 1:last])
    return {"path": path.relative_to(ROOT).as_posix(), "first_line": first, "last_line": last,
            "sha256": hashlib.sha256(b).hexdigest(), "size_bytes": len(b), "purpose": purpose}


def names_only(text):
    text = text.replace("CTF09Observation", "CTF10Observation")
    for name in NAMES:
        text = text.replace(name.replace("ctf10", "ctf09"), name)
    for name in ["CTF09_OBSERVATION_FIELDS_HH", "CTF09_UNIT_FIELDS_HH", "CTF09_UNIT_ADMISSION_HH",
                 "CTF09_PRODUCTION_FIELDS_HH", "CTF09_PRODUCTION_ADMISSION_HH"]:
        text = text.replace(name, name.replace("CTF09", "CTF10"))
    return text.replace("ctf09_observer.hh", "ctf10_observer.hh").replace("ctf09_observer.cc", "ctf10_observer.cc").replace("Construction.ctf09.cc", "Construction.ctf10.cc")


def section(text, start, end):
    return text[text.index(start):text.index(end, text.index(start))]


def verify_descriptor(value):
    if isinstance(value, dict):
        if {"path", "sha256", "size_bytes"} <= value.keys():
            path = ROOT / value["path"]
            data = path.read_bytes()
            if "first_line" in value:
                data = b"".join(data.splitlines(keepends=True)[value["first_line"] - 1:value["last_line"]])
            assert hashlib.sha256(data).hexdigest() == value["sha256"], value
            assert len(data) == value["size_bytes"], value
            if "line_count" in value:
                assert len(data.splitlines()) == value["line_count"], value
        for item in value.values():
            verify_descriptor(item)
    elif isinstance(value, list):
        for item in value:
            verify_descriptor(item)



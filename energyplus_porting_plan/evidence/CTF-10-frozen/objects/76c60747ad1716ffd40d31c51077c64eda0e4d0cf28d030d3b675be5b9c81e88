+            {"actual_Name", call->identity_available ? json(call->actual_Name) : json(nullptr)}, {"identity_available", call->identity_available},
+            {"actual_caller_return_reached", call->actual_caller_return_reached}, {"postaggregate_reached", call->postaggregate_reached},
+            {"scope_exit_reached", call->scope_exit_reached}, {"scope_exited_during_unwind", call->scope_exited_during_unwind},

+    for (std::size_t i = 0; i < source.failure_kind_counts.size(); ++i)
+        failures.push_back({{"kind", init_failure_name(static_cast<Observation::InitFailureKind>(i))}, {"actual_count", source.failure_kind_counts[i]}});
+    return {{"protocol", "ctf10-actual-whole-Init-observation.v1"}, {"binding_error", source.binding_error},
+        {"integrity_failed", source.integrity_failed}, {"Init_copy_integrity_failed", init_copy_failed(source, messages)},
+        {"actual_entry_reached", source.actual_entry_reached}, {"actual_function_end_reached", source.actual_function_end_reached},
+        {"scope_exit_reached", source.scope_exit_reached}, {"scope_exited_during_unwind", source.scope_exited_during_unwind},
+        {"actual_caller_return_reached", source.actual_caller_return_reached}, {"actual_event_count", source.actual_event_count},
+        {"actual_construction_call_count", source.actual_construction_call_count}, {"actual_diagnostic_count", source.actual_diagnostic_count},
+        {"actual_retained_event_count", source.events.size()}, {"actual_retained_construction_call_count", source.constructions.size()},
+        {"actual_retained_diagnostic_count", source.diagnostics.size()}, {"event_records_omitted", source.event_records_omitted},
+        {"construction_records_omitted", source.construction_records_omitted}, {"diagnostic_records_omitted", source.diagnostic_records_omitted},
+        {"actual_event_kind_counts", source.actual_event_kind_counts}, {"failure_kind_counts", failures},
+        {"first_failure", init_failure_record(source.first_failure)}, {"last_failure", init_failure_record(source.last_failure)},

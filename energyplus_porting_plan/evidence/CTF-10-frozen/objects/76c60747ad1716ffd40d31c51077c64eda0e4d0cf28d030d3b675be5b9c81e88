+inline char const *init_event_name(Observation::InitEvent event)
+{
+    constexpr std::array<char const *, 15> names{{"Entry", "ConstructionEntry", "ConstructionReturn", "PostConstructionAggregate",
+        "AfterAllAggregates", "ReportLayersEntry", "ReportLayersReturn", "ScanEntry", "ScanReturn", "ReportHeaders",
+        "ReportTransferEntry", "ReportTransferReturn", "FinalFatalBoundary", "FunctionEnd", "ScopeExit"}};
+    return names.at(static_cast<std::size_t>(event));
+}
+inline char const *init_site_name(Observation::InitSite site)
+{
+    constexpr std::array<char const *, 3> names{{"Event", "Construction", "Diagnostic"}};
+    return names.at(static_cast<std::size_t>(site));
+}
+inline char const *init_failure_name(Observation::InitFailureKind kind)
+{
+    constexpr std::array<char const *, 6> names{{"IdentityMismatch", "ConstructionNotFound", "LedgerAppendException", "CopyException", "Order", "CounterOverflow"}};
+    return names.at(static_cast<std::size_t>(kind));
+}
+inline json init_failure_record(std::optional<Observation::InitFailure> const &failure)
+{
+    if (!failure) return nullptr;
+    return {{"site", init_site_name(failure->site)}, {"actual_site_ordinal", failure->actual_site_ordinal},
+        {"kind", init_failure_name(failure->kind)}};
+}
+inline bool init_diagnostic_join_valid(Observation::InitCapture const &source, json const &messages)
+{
+    for (auto const &copy : source.diagnostics) {
+        if (!copy.copy_available || copy.actual_global_message_index >= messages.size()) return false;
+        auto const &message = messages.at(copy.actual_global_message_index);
+        if (message.at("level") != copy.actual_level || message.at("message") != copy.actual_message) return false;
+        if (copy.preceding_retained_event_ordinal && std::none_of(source.events.begin(), source.events.end(),
+                [&](auto const &event) { return event.actual_event_ordinal == *copy.preceding_retained_event_ordinal; })) return false;
+        if (copy.active_retained_construction_call_ordinal && std::none_of(source.constructions.begin(), source.constructions.end(),
+                [&](auto const &call) { return call && call->actual_call_ordinal == *copy.active_retained_construction_call_ordinal; })) return false;
+    }
+    return true;
+}
+inline bool init_copy_failed(Observation::InitCapture const &source, json const &messages)
+{
+    if (source.binding_error || source.integrity_failed || source.event_records_omitted || source.construction_records_omitted ||
+        source.diagnostic_records_omitted || source.actual_event_count != source.events.size() ||
+        source.actual_construction_call_count != source.constructions.size() || source.actual_diagnostic_count != source.diagnostics.size() ||
+        !init_diagnostic_join_valid(source, messages)) return true;
+    for (auto const &event : source.events) if (!event.copy_available) return true;
+    for (auto const &call : source.constructions)
+        if (!call || !call->identity_available || observer_failed(call->observations, messages)) return true;
+    return false;
+}

+inline json init_operations(Observation::InitCapture const &source, json const &messages)
+{
+    json rows = json::array();
+    for (auto const &call : source.constructions) {
+        require(call != nullptr, "Retained actual Init call pointer is null");
+        json outcome = {{"status", "source_return_not_observed"}, {"source_fatal", nullptr}, {"source_exception", nullptr},
+            {"exception_type", nullptr}, {"exception_message", nullptr}};
+        if (call->actual_caller_return_reached) outcome = {{"status", "source_returned"}, {"source_fatal", false},
+            {"source_exception", false}, {"exception_type", nullptr}, {"exception_message", nullptr}};
+        rows.push_back({{"kind", "calculateTransferFunction"}, {"actual_source_invoked", true},
+            {"actual_Init_call_ordinal", call->actual_call_ordinal}, {"actual_construction_index", call->actual_construction_index},
+            {"actual_construction_address", call->actual_construction_address},
+            {"actual_construction_Name", call->identity_available ? json(call->actual_Name) : json(nullptr)},
+            {"call_outcome", outcome}, {"before", nullptr}, {"after", nullptr},
+            {"manual_full_model_before_after_unavailable", true}, {"observations", observations(call->observations, messages)},
+            {"actual_Init_caller_return_reached", call->actual_caller_return_reached},
+            {"postaggregate_reached", call->postaggregate_reached}, {"scope_exit_reached", call->scope_exit_reached},
+            {"scope_exited_during_unwind", call->scope_exited_during_unwind},
+            {"actual_input_owner_join", "initialized_owners_and_public.before_reset_original_LayerPoint"},
+            {"actual_caller_join", "whole_Init.events.actual_TimeStepZone_and_public_shared_flags"},
+            {"unreturned_call_fatal_or_exception_inferred", false}});
+    }
+    return rows;
+}

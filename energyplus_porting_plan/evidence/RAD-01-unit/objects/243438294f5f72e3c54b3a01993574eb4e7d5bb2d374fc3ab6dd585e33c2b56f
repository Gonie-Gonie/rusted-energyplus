def successor(kind, names, replacements, disclosure):
    old = BASE / (kind + "-prep-01"); out = BASE / (kind + "-prep-02"); out.mkdir(exist_ok=True)
    previous = out / "before-01"; previous.mkdir(exist_ok=False)
    m = copy.deepcopy(json.loads((old / "manifest.json").read_bytes()))
    for name in [*names, "manifest.json", "README.md"]:
        destination = previous / name; destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes((old / name).read_bytes())
    own, narrow = [], []
    for index, name in enumerate(names):
        destination = out / name; destination.parent.mkdir(parents=True, exist_ok=True)
        raw = (old / name).read_bytes()
        if index == 0:
            for left, right in replacements:
                assert raw.count(left.encode()) == 1, left
                raw = raw.replace(left.encode(), right.encode())
        destination.write_bytes(raw)
        row = ref(destination)
        if "prospective_canonical_path" in m["own_sources"][index]: row["prospective_canonical_path"] = m["own_sources"][index]["prospective_canonical_path"]
        own.append(row)
        narrow.append(diff(previous / name, destination, out / "from-01" / (Path(name).name + ".diff")))
    m["own_sources"] = own
    (out / "README.md").write_bytes((old / "README.md").read_bytes() + ("\n" + disclosure + "\n").encode())
    narrow.append(diff(previous / "README.md", out / "README.md", out / "from-01/README.md.diff"))
    m["historical_before_and_diffs"] = {key: m.pop(key) for key in ["exact_diffs"]}
    if kind == "rust-observer":
        m["exact_diffs"] = []
        for name, row in zip(names, own):
            destination = out / "diffs" / (Path(name).name + ".diff"); destination.parent.mkdir(exist_ok=True)
            destination.write_text("".join(difflib.unified_diff([], (out / name).read_text().splitlines(keepends=True),
                fromfile="/dev/null", tofile=row["prospective_canonical_path"])), encoding="utf-8", newline="\n")
            m["exact_diffs"].append(ref(destination))
    else:
        tests = "comparison_contract_tests.py"; (out / tests).write_bytes((old / tests).read_bytes()); (previous / tests).write_bytes((old / tests).read_bytes())
        ast.parse((out / tests).read_text()); m["contract_test_source"] = ref(out / tests)
        m["exact_diffs"] = [diff(ROOT / before["path"], out / name, out / (name + ".diff")) for name, before in zip(names, m["before_sources"])]
        td = out / "comparison_contract_tests.py.diff"
        td.write_text("".join(difflib.unified_diff([], (out / tests).read_text().splitlines(keepends=True), fromfile="/dev/null", tofile=(out / tests).relative_to(ROOT).as_posix())), encoding="utf-8", newline="\n")
        m["exact_diffs"].append(ref(td))
        m["read_source_ranges"] = json.loads(qa.read_bytes())["read_source_ranges"] + json.loads((BASE / "rust-observer-prep-02/manifest.json").read_bytes())["read_source_ranges"]
        for name in names: ast.parse((out / name).read_text())
    m["historical_superseded_dependencies"] = []
    updated = []
    for row in m["source_dependencies"]:
        path = ROOT / row["path"]
        if path in rebindings:
            m["historical_superseded_dependencies"].append(row); updated.append(ref(rebindings[path]))
        else: updated.append(row)
    m["source_dependencies"] = updated
    m["predecessor_01"] = ref(old / "manifest.json")
    m["before_01"] = [ref(path) for path in previous.rglob("*") if path.is_file()]
    m["from_01_diffs"] = narrow
    m["readme"] = ref(out / "README.md"); m["authoring_source"] = ref(Path(__file__).resolve())
    m["successor_scope"] = disclosure
    (out / "manifest.json").write_text(json.dumps(m, ensure_ascii=False, indent=2) + "\n", encoding="utf-8", newline="\n")
    return out



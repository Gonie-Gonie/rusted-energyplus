"""Prepare only immutable Source pin successors; no imports or target execution."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
BASE = ROOT / ".runtime/porting/RAD-01"


def ref(path):
    raw = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(raw).hexdigest(),
            "size_bytes": len(raw), "line_count": len(raw.splitlines())}


def diff(before, after, path):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(difflib.unified_diff(before.read_text().splitlines(keepends=True), after.read_text().splitlines(keepends=True),
        fromfile=before.relative_to(ROOT).as_posix(), tofile=after.relative_to(ROOT).as_posix())), encoding="utf-8", newline="\n")
    return ref(path)



+#[test]
+fn nonfinite_f_and_g_use_source_default_left_alignment()
+-> Result<(), CtfReportUnavailable> {
+    use formatting::{fixed, general};
+    // The fmt8 nonfinite branch writes its signed word before width padding.
+    // Quiet/signaling payloads are real bit inputs, not expected Native data.
+    for (bits, text) in [
+        (0x7ff0_0000_0000_0000, "INF  "),
+        (0xfff0_0000_0000_0000, "-INF "),
+        (0x7ff8_0000_0000_0001, "NAN  "),
+        (0xfff8_0000_0000_0001, "-NAN "),
+        (0x7ff0_0000_0000_0001, "NAN  "),
+        (0xfff0_0000_0000_0001, "-NAN "),
+    ] {
+        let value = f64::from_bits(bits);
+        assert_eq!(fixed(value, 5, 3), text);
+        assert_eq!(fixed(value, 5, 4), text);
+        assert_eq!(general(value, 5, 4)?, text);
+        assert_eq!(general(value, 5, 8)?, text);
+    }
+    // Width is a minimum; the signed word is retained when it does not fit.
+    assert_eq!(fixed(f64::INFINITY, 2, 3), "INF");
+    assert_eq!(general(f64::NEG_INFINITY, 2, 4)?, "-INF");
     Ok(())
 }
 

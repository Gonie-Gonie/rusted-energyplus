def source(target, predecessor=None):
    p = Path(predecessor or target)
    raw = p.read_bytes()
    dest = BEFORE / target
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists(): assert dest.read_bytes() == raw
    else: dest.write_bytes(raw)
    entries.append({'target': target, 'before_origin': p.as_posix(), 'before': dest.as_posix()})
    return raw.decode('utf-8').replace('\r\n', '\n')

def save(target, text):
    p = PROPOSED / target
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_bytes(text.encode('utf-8'))

def replace(text, before, after, count=1):
    assert text.count(before) == count, (before[:100], text.count(before))
    return text.replace(before, after)


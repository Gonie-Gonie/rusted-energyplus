"""Finalize actual successful validations, update documents, and commit/push tested bytes."""
import hashlib, json, subprocess, sys
from pathlib import Path
BASE=Path('.runtime/porting/CTF-10')
def sha(path):
    with path.open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
def read(path):return json.loads(path.read_bytes())
def record(name,command):
    out=BASE/name;assert not out.exists()
    print('Starting actual',name,flush=True)
    result=subprocess.run(['python','-X','utf8','-B','tools/porting/record_command.py','--output-dir',str(out),'--',*command],stdout=subprocess.DEVNULL)
    receipt=read(out/'receipt.json')
    assert result.returncode==receipt['exit_code']==0 and receipt['source_bytes_match_before_and_after'] is True
    assert receipt['source_snapshot']==source
    print('Completed actual',name,flush=True)

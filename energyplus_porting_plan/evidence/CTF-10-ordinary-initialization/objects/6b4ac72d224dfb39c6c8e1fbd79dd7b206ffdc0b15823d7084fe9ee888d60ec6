"""Archive actual application plus two reviewed test-only corrections."""
import hashlib, json, shutil
from pathlib import Path
ROOT = Path.cwd().resolve(); BASE = ROOT / '.runtime/porting/CTF-10'
def ref(path):
    data = path.read_bytes()
    return {'path':path.relative_to(ROOT).as_posix(),'sha256':hashlib.sha256(data).hexdigest(),'size_bytes':len(data)}
parent = BASE / 'ordinary-initialization-applied-01/record.json'
assert ref(parent)['sha256'] == '7776c20153b64ec93b89b33e095b104ed003b9c0cf54cf657271095334f89a79'
original = json.loads(parent.read_bytes())
correction2 = BASE / 'ordinary-initialization-correction-02'
correction3 = BASE / 'ordinary-initialization-correction-03'
part = 'crates/ep_runtime/src/runtime/tests/part03.rs'
outputs = 'crates/ep_run/src/ctf_initialization_outputs.rs'
assert (ROOT/part).read_bytes() == (correction2/'part03.rs').read_bytes()
assert (ROOT/outputs).read_bytes() == (correction3/'ctf_initialization_outputs.rs').read_bytes()
out = BASE / 'ordinary-initialization-applied-02'
assert not out.exists(); (out/'current').mkdir(parents=True)
sources = []
for prior in [*original['actual_sources'], {'canonical_path':part}]:
    name = prior['canonical_path']; canonical = ROOT/name
    if name != part:
        expected = correction3/'ctf_initialization_outputs.rs' if name == outputs else ROOT/prior['actual_final_source']['path']
        assert canonical.read_bytes() == expected.read_bytes()
    archive = out/'current'/name.replace('/','__')
    shutil.copyfile(canonical,archive); assert archive.read_bytes() == canonical.read_bytes()
    sources.append({'canonical_path':name,'actual_final_source':ref(archive),
        'Source_authority':'reviewed fatal-test correction03' if name == outputs else 'reviewed existing-test arity correction02' if name == part else 'byte-exact accepted parent application01'})
assert len(sources)==19 and len({row['canonical_path'] for row in sources})==19
result = {'schema':original['schema'],'actual_sources':sources,'parent_application':ref(parent),
    'correction_records':[ref(correction2/'record.json'),ref(correction3/'record.json')],
    'actual_source_preparation':original['actual_source_preparation'],
    'Root_and_Header_cumulative_Source_review_accepted':True,'ordinary_A_and_B_dispatch_connected':True,
    'actual_Root_source':ref(Path(__file__).resolve()),'Source_normalization_performed':False,
    'original_application_formatter_evidence_retained_in_parent':True,
    'corrections_are_test_only':True,'scientific_PASS_claimed':False,'gates_updated':False}
(out/'record.json').write_bytes((json.dumps(result,indent=2)+'\n').encode())
print(json.dumps(ref(out/'record.json')),flush=True)

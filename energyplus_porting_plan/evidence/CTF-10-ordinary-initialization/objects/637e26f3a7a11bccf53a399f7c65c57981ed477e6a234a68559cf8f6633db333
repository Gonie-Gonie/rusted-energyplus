entries=json.loads((ROOT/'unsealed-source-entries.json').read_text())

def save(target,text,predecessor=None,new=False):
    if new:
        assert not Path(target).exists()
        before=None
    else:
        origin=Path(predecessor or target); before=ROOT/'before'/target
        before.parent.mkdir(parents=True,exist_ok=True)
        assert not before.exists();before.write_bytes(origin.read_bytes())
    out=ROOT/'proposed'/target;out.parent.mkdir(parents=True,exist_ok=True)
    assert not out.exists();out.write_bytes(text.encode())
    entries.append({'target':target,'before_origin':None if new else str(origin).replace('\\','/'),
        'before':None if new else before.as_posix()})

def change(t,a,b,count=1):
    assert t.count(a)==count,(a[:70],t.count(a));return t.replace(a,b)


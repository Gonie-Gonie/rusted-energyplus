"""Root-only actual operand assembly; no finalizer, targets, copying or Git."""
import argparse, hashlib, json
from pathlib import Path
ROOT = Path.cwd().resolve()
BASE = ROOT / '.runtime/porting/CTF-10'
FORBIDDEN = {'.exe', '.dll', '.rlib', '.obj', '.a', '.map', '.idf', '.epw'}
checked, lineage, receipts = {}, {}, {}

def path(name):
    p = (ROOT / name).resolve()
    assert p.is_relative_to(ROOT) and p.is_file() and p.suffix.lower() not in FORBIDDEN
    return p

def ref(p):
    p = path(p)
    with p.open('rb') as stream: digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    row = {'path': p.relative_to(ROOT).as_posix(), 'sha256': digest, 'size_bytes': p.stat().st_size}
    if p in checked: assert checked[p] == row, str(p)
    checked[p] = row
    return row

def read(p): return json.loads(path(p).read_bytes())
def opaque(p): lineage[path(p)] = ref(p)
def receipt(p):
    p = path(p); r = read(p)
    assert r['schema'] == 'recorded-porting-command.v1' and Path(r['cwd']).resolve() == ROOT
    assert r['launch_error'] is None and type(r['exit_code']) is int
    assert r['source_bytes_match_before_and_after'] is True
    receipts[p] = ref(p)
    return r

def execution_lineage(p):
    p = path(p); r = read(p)
    assert r['schema'] == 'recorded-porting-command.v1' and Path(r['cwd']).resolve() == ROOT
    if r['launch_error'] is None and type(r['exit_code']) is int and r['source_bytes_match_before_and_after'] is True:
        receipt(p)
    else:
        # Intended source-mutation and launch-error history cannot satisfy the
        # finalizer's preserved-Source command validator; retain it opaquely.
        opaque(p)
        owners = [r[key] for key in ['stdout', 'stderr', 'source_snapshot'] if r.get(key)]
        if r.get('executed_launcher'): owners.append(r['executed_launcher']['archive'])
        for owner in owners:
            p1 = ROOT / owner['path']; actual = ref(p1)
            assert actual['sha256'] == owner['sha256']
            if 'size_bytes' in owner: assert actual['size_bytes'] == owner['size_bytes']
            opaque(p1)

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--quality-version', type=int, required=True)
parser.add_argument('--format-comparison', required=True)
parser.add_argument('--format-comparison-execution', required=True)
parser.add_argument('--ordinary-smoke', required=True)
parser.add_argument('--optional-report-input-packet')
parser.add_argument('--optional-report-cli-receipt')
parser.add_argument('--output', required=True)
parser.add_argument('--lineage', action='append', default=[])
parser.add_argument('--lineage-receipt', action='append', default=[])
args = parser.parse_args()
assert args.quality_version >= 6
assert (args.optional_report_input_packet is None) == (args.optional_report_cli_receipt is None)
output = (ROOT / args.output).resolve()
assert output.is_relative_to(BASE) and output.parent.is_dir() and not output.exists()
metadata = BASE / 'ordinary-init-milestone-finalizer-prep-03/manifest.json'
assert ref(metadata)['sha256'] == 'e13f49f10ded171c6d15a66dd61d023a15dad707900d9f2c0e54aac3a96af773'
finalizer = BASE / 'ordinary-init-milestone-finalizer-prep-02/finalize-ordinary-initialization.py'
assert ref(finalizer)['sha256'] == '3a7afa3e28a4394898e62ef783c5360888dc6ff79cd1cf7c400204d57ddee08c'
application = BASE / 'ordinary-initialization-applied-03/record.json'
assert ref(application)['sha256'] == 'd8dd8f803c33a20dc6ab9ef07e0dd170c857ae8aeb9716f527115ad3f2b4ba33'
quality = {}; source = None
for role in ['fmt-check', 'clippy', 'focused', 'workspace']:
    p = BASE / f'ordinary-initialization-{role}-command-{args.quality_version:02}/receipt.json'
    r = receipt(p); assert r['exit_code'] == 0
    if source is None: source = r['source_snapshot']
    assert r['source_snapshot'] == source
    quality[role] = ref(p)
for number in range(1, args.quality_version + 1):
    for role in ['fmt-check', 'clippy', 'focused', 'workspace', 'quality-launch']:
        p = BASE / f'ordinary-initialization-{role}-command-{number:02}/receipt.json'
        if p.exists(): receipt(p)
for name in ['clippy-command-01', *[f'workspace-command-{n:02}' for n in range(2, 6)]]:
    assert receipt(BASE / f'ordinary-initialization-{name}/receipt.json')['exit_code'] != 0
for role in ['fmt-check', 'clippy', 'focused', 'workspace']:
    assert receipt(BASE / f'ordinary-initialization-{role}-command-06/receipt.json')['exit_code'] == 0
for number in range(1, 7):
    directory = BASE / f'ordinary-initialization-correction-{number:02}'
    assert directory.is_dir()
    for p in sorted(directory.rglob('*')):
        if p.is_file(): opaque(p)
test_record = read(BASE / 'ordinary-initialization-correction-05/record.json')
additional = []
for row in test_record['actual_sources']:
    archive = BASE / 'ordinary-initialization-correction-05' / Path(row['canonical_path']).name
    actual = ref(archive); assert actual['sha256'] == row['after_sha256']
    with (ROOT / row['canonical_path']).open('rb') as stream:
        assert hashlib.file_digest(stream, 'sha256').hexdigest() == actual['sha256']
    additional.append({'canonical_path': row['canonical_path'], 'actual_final_source': actual})
assert {r['canonical_path'] for r in additional} == {'crates/ep_run/tests/arbitrary_run/output_manifest.rs', 'crates/ep_run/tests/arbitrary_run_ideal_loads.rs'}
for directory in ['report-format-nonfinite-repair-prep-01', 'report-format-nonfinite-repair-applied-01']:
    assert (BASE / directory).is_dir()
    for p in sorted((BASE / directory).rglob('*')):
        if p.is_file(): opaque(p)
for version in [1, 2, 3]:
    for family in ['ordinary-init-plumbing-prep', 'ordinary-init-smoke-runner-prep', 'ordinary-init-eio-report-input-prep', 'ordinary-init-milestone-finalizer-prep']:
        for p in sorted((BASE / f'{family}-{version:02}').rglob('*')):
            if p.is_file(): opaque(p)
for pattern in ['run-ordinary-*.py', 'prepare-ordinary-*.py', 'correct-ordinary-*.py', 'seal-ordinary-*.py', 'apply-ordinary-*.py', 'update-ordinary-*.py', 'publish-ordinary-*.py']:
    for p in sorted(BASE.glob(pattern)): opaque(p)
opaque(Path(__file__).resolve())
for p in args.lineage: opaque(p)
for p in args.lineage_receipt: receipt(p)
failed_format = BASE / 'report-format-candidate-workflow-01/comparison.json'
opaque(failed_format); opaque(BASE / 'report-format-candidate-workflow-01/mismatches.json')
receipt(BASE / 'report-format-candidate-workflow-command-01/receipt.json')
for key in ['cargo', 'rust_execution']:
    receipt(ROOT / read(failed_format)[key]['path'])
for p in sorted(BASE.glob('ordinary*command*/receipt.json')): execution_lineage(p)
execution_lineage(BASE / 'report-format-nonfinite-repair-apply-command-01/receipt.json')
packet = {'schema': 'ctf10-ordinary-initialization-milestone-inputs.v1', 'application': ref(application), 'additional_test_sources': additional, 'quality': quality,
          'retained_lineage': list(lineage.values()), 'retained_lineage_receipts': list(receipts.values()),
          'format_comparison': ref(args.format_comparison), 'format_comparison_execution': ref(args.format_comparison_execution), 'ordinary_smoke': ref(args.ordinary_smoke),
          'optional_report_input_packet': ref(args.optional_report_input_packet) if args.optional_report_input_packet else None,
          'optional_report_CLI_receipt': ref(args.optional_report_cli_receipt) if args.optional_report_cli_receipt else None}
for p, row in list(checked.items()): assert ref(p) == row
with output.open('xb') as stream: stream.write((json.dumps(packet, indent=2, allow_nan=False) + '\n').encode('utf8'))
print(json.dumps(ref(output)), flush=True)

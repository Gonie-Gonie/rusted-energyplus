def sha(data):
    return hashlib.sha256(data).hexdigest()

def ref(path):
    path = Path(path)
    data = path.read_bytes()
    return dict(path=path.as_posix(), sha256=sha(data), size_bytes=len(data), line_count=len(data.splitlines()))

def exact(row):
    data = Path(row['path']).read_bytes()
    assert sha(data) == row['sha256'] and len(data) == row['size_bytes'], row['path']
    if 'line_count' in row:
        assert len(data.splitlines()) == row['line_count'], row['path']
    return data

def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    assert not path.exists(), path
    path.write_bytes(data)
    return ref(path)

def difference(before, after, old, new):
    return ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=old, tofile=new)).encode()

def replace(text, old, new):
    assert text.count(old) == 1, old
    return text.replace(old, new)


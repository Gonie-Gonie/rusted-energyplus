    elif canonical.endswith('/heat_balance/mod.rs'):
        proposed = replace(before.decode(), 'pub mod ctf_init_postlude;\n', 'pub mod ctf_init_postlude;\npub mod ctf_initialization_context;\n')
    elif canonical.endswith('/ctf_reports.rs'):
        proposed = replace(proposed, 'impl std::error::Error for CtfReportError {}', '''impl std::error::Error for CtfReportError {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {

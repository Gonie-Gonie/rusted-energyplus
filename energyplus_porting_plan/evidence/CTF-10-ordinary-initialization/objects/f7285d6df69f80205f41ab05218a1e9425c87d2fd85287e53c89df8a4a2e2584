+struct OrdinaryFailingEio;
+impl std::io::Write for OrdinaryFailingEio {
+    fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+        Err(std::io::Error::from_raw_os_error(5))
+    }
+    fn flush(&mut self) -> std::io::Result<()> { Ok(()) }

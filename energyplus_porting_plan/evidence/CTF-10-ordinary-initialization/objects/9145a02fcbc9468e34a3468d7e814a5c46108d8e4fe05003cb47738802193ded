source_range = b''.join(original.read_bytes().splitlines(keepends=True)[757:794])
(out / 'ShowFatalError.original.txt').write_bytes(source_range)
(out / 'record.json').write_text(json.dumps({'schema':'ctf10-ordinary-fatal-test-expectation-correction.v1','canonical_path':path.relative_to(ROOT).as_posix(),'before_sha256':hashlib.sha256(before).hexdigest(),'after_sha256':hashlib.sha256(after).hexdigest(),'Original_source':original.relative_to(ROOT).as_posix(),'Original_lines':[758,794],'Original_range_sha256':hashlib.sha256(source_range).hexdigest(),'production_implementation_changed':False,'reason':'Original ShowFatalError emits fatal effects then throws; it does not assign AbortProcessing. Test now requires its genuine unchanged false value.','failed_execution':'ordinary-initialization-workspace-command-02/receipt.json'},indent=2)+'\n',encoding='utf8',newline='\n')
path.write_bytes(after)
print('Corrected only genuine unchanged AbortProcessing test expectation', hashlib.sha256(after).hexdigest(), flush=True)

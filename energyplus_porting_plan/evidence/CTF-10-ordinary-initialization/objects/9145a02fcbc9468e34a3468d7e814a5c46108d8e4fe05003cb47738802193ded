"""Correct only a test expectation against the pinned genuine fatal function."""
import difflib, hashlib, json
from pathlib import Path
ROOT = Path.cwd().resolve()
BASE = ROOT / '.runtime/porting/CTF-10'
path = ROOT / 'crates/ep_run/src/ctf_initialization_outputs.rs'
prior = json.loads((BASE / 'ordinary-initialization-applied-01/record.json').read_bytes())
row = next(row for row in prior['actual_sources'] if row['canonical_path'] == path.relative_to(ROOT).as_posix())
before = path.read_bytes()
assert hashlib.sha256(before).hexdigest() == row['actual_final_source']['sha256']
old = b'        assert!(output.state.tracking.abort_processing);\n'
new = b'        // Genuine ShowFatalError preserves AbortProcessing and throws FatalError.\n        assert!(!output.state.tracking.abort_processing);\n'
assert before.count(old) == 1
after = before.replace(old, new)
out = BASE / 'ordinary-initialization-correction-03'

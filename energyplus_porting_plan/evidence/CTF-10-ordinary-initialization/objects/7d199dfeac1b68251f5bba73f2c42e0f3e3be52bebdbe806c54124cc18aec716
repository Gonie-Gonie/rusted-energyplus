"""Run selected formatter comparison and six ordinary CLIs on corrected tested Source."""
import hashlib, json, subprocess, sys
from pathlib import Path
BASE = Path('.runtime/porting/CTF-10')
SOURCE = 'dbc350f53d96910194c90b82f396cc8a464ba1c87de10055c4a209b8bc6b05eb'
def sha(path):
    with path.open('rb') as stream: return hashlib.file_digest(stream, 'sha256').hexdigest()
def operand(path): return path.as_posix() + '#' + sha(path)
quality = []
for role in ['fmt-check', 'clippy', 'focused', 'workspace']:
    path = BASE / ('ordinary-initialization-' + role + '-command-06/receipt.json')
    actual = json.loads(path.read_bytes())
    assert actual['exit_code'] == 0 and actual['source_bytes_match_before_and_after'] is True
    assert actual['source_snapshot']['sha256'] == SOURCE
    quality.append(operand(path))
runner = BASE / 'report-format-workflow-prep-02/run_format_workflow.py'
assert sha(runner) == 'de9f75292a7848e00566ad2795d16c3ea11a1fac1287ff94b7c4c408d97301ad'
native = BASE / 'report-format-native-workflow-01/native.json'
assert sha(native) == '862887b58164e3d13e6739d5004b55c27314820c4259c1c52f24b5d824382b68'
observer = Path('crates/ep_run/examples/ctf10_report_format_unit_observer.rs')
formatter = Path('crates/ep_runtime/src/heat_balance/ctf_reports_format.rs')
assert sha(observer) == 'c2c57750cf987bfb6cd5b392d9b93098e067a3ba2706bd0fd2f21c0d0c422481'
assert sha(formatter) == 'a4c0f21ecc2caf3c223c69dfef65b0a2fdd866268484ce66575080a35a4af49c'
def record(name, command):
    output = BASE / name
    assert not output.exists()
    print('Actual ordinary validation starting', name, flush=True)
    result = subprocess.run([sys.executable, '-X', 'utf8', '-B', 'tools/porting/record_command.py', '--output-dir', output.as_posix(), '--', *command], stdout=subprocess.DEVNULL)
    actual = json.loads((output / 'receipt.json').read_bytes())
    assert result.returncode == actual['exit_code'] == 0
    assert actual['source_bytes_match_before_and_after'] is True and actual['source_snapshot']['sha256'] == SOURCE
    print('Actual ordinary validation completed', name, flush=True)
record('report-format-candidate-workflow-command-01', [sys.executable, '-X', 'utf8', '-B', str(runner), 'candidate', '--approved-runner-sha256', sha(runner), '--native-workflow', operand(native), '--observer-source', operand(observer), '--format-source', operand(formatter), '--output-dir', str(BASE / 'report-format-candidate-workflow-01')])
smoke = BASE / 'ordinary-init-smoke-runner-prep-03/run-ordinary-init-smoke-03.py'
assert sha(BASE / 'ordinary-init-smoke-runner-prep-03/manifest.json') == '20da95e4bef40abad5390fb49ed703fb6b52884721f8e99bc17083260cfbab53'
assert sha(smoke) == '2c909462a87e0c9f545624e2edbe11f7245874e8eb125364d6781329bb4ac60b'
application = BASE / 'ordinary-initialization-applied-03/record.json'
assert sha(application) == 'd8dd8f803c33a20dc6ab9ef07e0dd170c857ae8aeb9716f527115ad3f2b4ba33'
record('ordinary-init-smoke-workflow-command-01', [sys.executable, '-X', 'utf8', '-B', str(smoke), str(application), sha(application), *quality])

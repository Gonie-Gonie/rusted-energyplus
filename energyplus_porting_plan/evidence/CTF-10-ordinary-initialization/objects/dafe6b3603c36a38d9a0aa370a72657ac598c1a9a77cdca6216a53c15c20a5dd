args=list(receipt['command']);assert len(args)==15 and args[1]=='run' and args[-2:]==['--porting-scope','a']
assert Path(args[2]).resolve()==ROOT/base['path'] and '--hours'not in args and not any('oracle'in value for value in args)
artifact=summary['actual_Cargo_binary'];assert sha(ROOT/artifact['historical_path'])==artifact['sha256'] and Path(args[0]).resolve()==ROOT/artifact['historical_path']
addition=b'\n\nOutput:Constructions,\n  Constructions;\n'

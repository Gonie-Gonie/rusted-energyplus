OUT.mkdir();input_path=OUT/'input.idf';input_path.write_bytes(variant)
assert input_path.read_bytes()==original+addition
args[2]=str(input_path);args[args.index('--output-dir')+1]=str(output)
for row in guards:exact(row)
assert sha(summary_path)==sys.argv[2] and sha(snapshot)==summary['same_actual_source_snapshot']['sha256']
result={'schema':'ctf10-ordinary-initialization-enabled-eio-input-only.v1','actual_smoke_summary':ref(summary_path),
 'current_final_source_inventory':ref(inventory),'actual_source_snapshot':summary['same_actual_source_snapshot'],
 'base_A24_input':base,'input':ref(input_path),'literal_append_utf8':addition.decode(),'literal_append_sha256':hashlib.sha256(addition).hexdigest(),
 'original_bytes_retained_as_exact_prefix':True,'all45_original_input_guards':packet['all45_fixed_input_guards'],
 'all45_original_input_guards_unchanged':True,'ordinary_command_not_executed':args,'fresh_output_directory':str(output),
 'actual_build_receipt':summary['actual_build'],'actual_Cargo_binary':artifact,
 'purpose':'one explicit Output:Constructions report branch; unchanged thermal/weather inputs',
 'numerical_expected_values_supplied':False,'Native_same_input_comparison_claimed':False,
 'variant_cli_or_engine_execution_performed':False,'enabled_EIO_observed':False,'numerical_or_integration_PASS_claimed':False}
(OUT/'manifest.json').write_bytes((json.dumps(result,indent=2)+'\n').encode())

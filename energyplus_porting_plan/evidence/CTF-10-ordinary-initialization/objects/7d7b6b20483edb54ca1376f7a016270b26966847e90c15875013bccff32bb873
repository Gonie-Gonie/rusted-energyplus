"""Correct the second test's fatal flag expectation; retain actual application lineage."""
import difflib, hashlib, json
from pathlib import Path
ROOT=Path.cwd().resolve(); BASE=ROOT/'.runtime/porting/CTF-10'
def ref(path):
    data=path.read_bytes();return {'path':path.relative_to(ROOT).as_posix(),'sha256':hashlib.sha256(data).hexdigest(),'size_bytes':len(data)}
application_path=BASE/'ordinary-initialization-applied-02/record.json'
assert ref(application_path)['sha256']=='90c6b581dbca40d3f30ee2cf255ba3315a63a44dff8270615a665ff1c2783a32'
application=json.loads(application_path.read_bytes())
name='crates/ep_runtime/src/runtime/tests/ctf_ordinary_outputs.rs';path=ROOT/name
row=next(row for row in application['actual_sources'] if row['canonical_path']==name)
before=path.read_bytes();assert hashlib.sha256(before).hexdigest()==row['actual_final_source']['sha256']
old=b'    assert!(state.tracking.abort_processing);\n';new=b'    assert!(!state.tracking.abort_processing);\n'
assert before.count(old)==1;after=before.replace(old,new)
out=BASE/'ordinary-initialization-correction-06'
assert not out.exists();out.mkdir()
(out/'ctf_ordinary_outputs.before.rs').write_bytes(before)
(out/'ctf_ordinary_outputs.rs').write_bytes(after)
(out/'correction.diff').write_bytes(''.join(difflib.unified_diff(before.decode().splitlines(True),after.decode().splitlines(True),fromfile='before',tofile=name)).encode())
record={'schema':'ctf10-ordinary-runtime-fatal-test-expectation-correction.v1','canonical_path':name,'before_sha256':hashlib.sha256(before).hexdigest(),'after_sha256':hashlib.sha256(after).hexdigest(),'production_implementation_changed':False,'Original_function_proof':ref(BASE/'ordinary-initialization-correction-03/ShowFatalError.original.txt'),'reason':'The genuine fatal function leaves AbortProcessing unchanged; require false while still requiring actual severe count, report prefix, fatal invocation and missing normal return.','actual_failure_receipt':'ordinary-initialization-workspace-command-05/receipt.json'}
(out/'record.json').write_bytes((json.dumps(record,indent=2)+'\n').encode())
path.write_bytes(after)
row['actual_final_source']=ref(out/'ctf_ordinary_outputs.rs');row['Source_authority']='reviewed unchanged-fatal-flag runtime test correction06'
application['previous_application']=ref(application_path)
application['correction_records'].append(ref(out/'record.json'))
application['actual_Root_source']=ref(Path(__file__).resolve())
target=BASE/'ordinary-initialization-applied-03'
assert not target.exists();target.mkdir()
(target/'record.json').write_bytes((json.dumps(application,indent=2)+'\n').encode())
for row in application['actual_sources']:assert (ROOT/row['canonical_path']).read_bytes()==(ROOT/row['actual_final_source']['path']).read_bytes()
print(json.dumps({'application':ref(target/'record.json'),'correction':ref(out/'record.json'),'corrected_test_source':ref(path)}),flush=True)

Binding::Binding(Capture &capture) noexcept : previous(active) { active = &capture; }
Binding::~Binding() noexcept { active = previous; }
Scope::Scope(EnergyPlus::EnergyPlusData &owner, Procedure p) noexcept
    : procedure(p), parent(current_scope), state(owner), exceptions_on_entry(std::uncaught_exceptions())
{
    current_scope = this;
    if (active) {
        auto &calls = active->procedure_calls[static_cast<unsigned>(procedure)];
        if (increment(calls)) ordinal = calls;
    }
    record(state, "scope_entry");
}
Scope::~Scope() noexcept
{
    record(state, std::uncaught_exceptions() > exceptions_on_entry ? "scope_unwinding" : "scope_normal_exit");
    current_scope = parent;
}
void record(EnergyPlus::EnergyPlusData &state, char const *checkpoint, Copy kind,
            int surface, int term, std::initializer_list<RealField> reals,
            std::initializer_list<IntegerField> integers) noexcept
{
    if (!active) return;
    if (!increment(active->attempted_events)) return;
    auto const ordinal = active->attempted_events;
    try {
        json event{{"event_ordinal", ordinal}, {"checkpoint", checkpoint}, {"copy_kind", static_cast<unsigned>(kind)}, {"clock", clock(state)},
                   {"procedure", current_scope ? json(procedure_name(current_scope->procedure)) : json(nullptr)},
                   {"invocation_ordinal", current_scope ? json(current_scope->ordinal) : json(nullptr)},
                   {"parent_procedure", current_scope && current_scope->parent ? json(procedure_name(current_scope->parent->procedure)) : json(nullptr)},
                   {"parent_invocation_ordinal", current_scope && current_scope->parent ? json(current_scope->parent->ordinal) : json(nullptr)},
                   {"locals", json::object()}, {"owners", nullptr}, {"counted_as_PASS", false}};
        for (auto const &r : reals) event["locals"][r.name] = scalar(r.value);
        for (auto const &i : integers) event["locals"][i.name] = i.value;
        if (kind == Copy::Catalog) event["owners"] = catalog(state);
        else if (kind != Copy::None) {
            if (surface != 0) event["owners"] = surface_copy(state, kind, surface, term);
            else {
                event["owners"] = json::array();
                for (int index : state.dataSurface->AllHTSurfaceList)
                    event["owners"].push_back(surface_copy(state, kind, index, term));
            }
        }
        if (std::strcmp(checkpoint, "history_initialization_entry_owners") == 0 ||
            std::strcmp(checkpoint, "history_update_entry_owners") == 0)
            event["history_entry_context"] = history_entry_context(state);
        auto const bytes = event.dump(); // Complete one event before touching the stream.
        if (!active->first_event) active->output << ',';
        active->output << bytes;
        if (!active->output) {
            active->stream_failed = true;
            increment(active->stream_failed_events);
            return;
        }
        active->first_event = false;
        increment(active->retained_events);
    } catch (...) {
        increment(active->copy_failures[static_cast<unsigned>(kind)]);
        if (active->first_failed_event == 0) active->first_failed_event = ordinal;
        active->last_failed_event = ordinal;
    }
}
bool finish(Capture &capture, bool returned, int exit_code, char const *caught) noexcept
{
    try {
        json summary{{"actual_engine_entry_returned", returned},
            {"actual_engine_exit_code", returned ? json(exit_code) : json(nullptr)},
            {"outer_caught_exception_class", caught ? json(caught) : json(nullptr)},
            {"procedure_calls", capture.procedure_calls}, {"attempted_events", capture.attempted_events},
            {"retained_events", capture.retained_events}, {"copy_failures_by_Copy_enum", capture.copy_failures},
            {"first_failed_event", capture.first_failed_event}, {"last_failed_event", capture.last_failed_event},
            {"stream_failed_events", capture.stream_failed_events}, {"counter_overflow", capture.counter_overflow},
            {"stream_failed", capture.stream_failed}, {"all_source_calls_or_complete_history_lifecycle_certified", false},
            {"numeric_profiles_chosen", false}, {"integration_PASS_claimed", false}};
        capture.output << "],\"summary\":" << summary.dump() << '}';
        capture.output.flush();
        bool copies_ok = true;
        for (auto const failures : capture.copy_failures) if (failures != 0) copies_ok = false;
        return static_cast<bool>(capture.output) && !capture.stream_failed && !capture.counter_overflow && copies_ok;
    } catch (...) { return false; }
}

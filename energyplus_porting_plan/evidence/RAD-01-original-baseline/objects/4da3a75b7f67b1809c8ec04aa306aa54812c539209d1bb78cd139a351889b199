ORIGIN = ROOT / '.runtime/porting/CTF-10/native-build-review-prep-01/review_build.py'


def ref(path):
    path = path if isinstance(path, Path) else ROOT / path
    raw = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(raw).hexdigest(),
            'size_bytes': len(raw), 'line_count': len(raw.splitlines())}


def change(text, old, new):
    assert text.count(old) == 1, old
    return text.replace(old, new)


before = OUT / 'before'
before.mkdir(exist_ok=False)
(before / ORIGIN.name).write_bytes(ORIGIN.read_bytes())
text = ORIGIN.read_text(encoding='utf-8')

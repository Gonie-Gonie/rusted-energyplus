text = change(text, "assert 'HeatBalanceManager.ctf10.cc.obj' in preservation['derived_HeatBalanceManager_provider']['section_provider']['text']\n", '')
text = change(text, "'actual_ctf_pe'", "'actual_rad_pe'")
text = change(text, "'lane': args.lane, 'target': target,", "'lane': 'unit', 'target': target,")
source = OUT / 'review_build.py'
source.write_bytes(text.encode('utf-8'))
ast.parse(text)
patch = ''.join(difflib.unified_diff(ORIGIN.read_text(encoding='utf-8').splitlines(True), text.splitlines(True),
            fromfile=ref(before / ORIGIN.name)['path'], tofile=ref(source)['path']))
(OUT / 'review_build.py.diff').write_bytes(patch.encode('utf-8'))

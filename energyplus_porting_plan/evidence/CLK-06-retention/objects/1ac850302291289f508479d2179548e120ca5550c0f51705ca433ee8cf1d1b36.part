$ErrorActionPreference = 'Stop'
$workspacePath = (Get-Location).Path
if ($workspacePath -ne 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus') { throw 'Exact repository cwd required' }
$productsPath = (Resolve-Path -LiteralPath 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus\.runtime\ep261-gcc13-o0\Products').Path
$productsItem = Get-Item -LiteralPath $productsPath
if ($productsPath -ne 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus\.runtime\ep261-gcc13-o0\Products' -or ($productsItem.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Exact non-reparse Products directory required' }
$targetPath = (Resolve-Path -LiteralPath 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus\.runtime\ep261-gcc13-o0\Products\clk06_reference_helper.exe').Path
$targetItem = Get-Item -LiteralPath $targetPath
if ($targetItem.PSIsContainer -or ($targetItem.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Regular non-reparse file required' }
if ([IO.Path]::GetDirectoryName($targetPath) -ne $productsPath -or $targetItem.Name -ne 'clk06_reference_helper.exe') { throw 'Target outside exact Products file' }
if ($targetItem.Length -ne 1297365278 -or (Get-FileHash -LiteralPath $targetPath -Algorithm SHA256).Hash.ToLowerInvariant() -ne '672dfd6b708833bbcc0f1869c5933a595423be86404b06142b5a179392545fb4') { throw 'Actual pre-action file identity differs' }
Remove-Item -LiteralPath $targetPath -Force
if (Test-Path -LiteralPath 'C:\Users\GonieGonie\Documents\GitHub\rusted-energyplus\.runtime\ep261-gcc13-o0\Products\clk06_reference_helper.exe') { throw 'Original still present' }
Write-Output 'Removed exact validated new clk06_reference_helper debug original; actual absence verified.'

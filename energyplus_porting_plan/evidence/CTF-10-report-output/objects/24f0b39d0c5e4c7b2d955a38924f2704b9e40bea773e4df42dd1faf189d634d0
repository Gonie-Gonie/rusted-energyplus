"""Exercise immutable publication across eight actual concurrent processes."""
import hashlib,importlib.util,json,multiprocessing
from pathlib import Path
ROOT=Path.cwd().resolve();OUT=ROOT/'.runtime/porting/CTF-10/recorder-concurrency-test-01'
DATA=b'concurrent immutable source publication\n'*32768
def recorder():
 spec=importlib.util.spec_from_file_location('actual_recorder',ROOT/'tools/porting/record_command.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
 m.RAW=OUT;m.OBJECTS=OUT/'objects';return m
def worker(barrier):
 m=recorder();barrier.wait(timeout=30)
 for _ in range(3):
  r=m.store_bytes(DATA);assert (ROOT/r['path']).read_bytes()==DATA
def main():
 OUT.mkdir();context=multiprocessing.get_context('spawn');barrier=context.Barrier(8);workers=[context.Process(target=worker,args=(barrier,))for _ in range(8)]
 for p in workers:p.start()
 for p in workers:p.join(timeout=45);assert p.exitcode==0,p.exitcode
 m=recorder();r=m.store_bytes(DATA);assert (ROOT/r['path']).read_bytes()==DATA
 assert list((OUT/'objects').rglob('*'))==[(OUT/'objects'/r['sha256'][:2]),ROOT/r['path']]
 corrupt=b'explicit corruption fixture';digest=hashlib.sha256(corrupt).hexdigest();path=m.OBJECTS/digest[:2]/digest;path.parent.mkdir(exist_ok=True);path.write_bytes(b'incorrect fixture bytes')
 try:m.store_bytes(corrupt)
 except ValueError:pass
 else:raise AssertionError('corruption was not rejected')
 assert path.read_bytes()==b'incorrect fixture bytes'
 result={'schema':'immutable-source-publication-regression.v1','concurrent_processes':8,'writes_per_process':3,'all_readers_saw_complete_bytes':True,'existing_corruption_rejected_without_overwrite':True,'temporary_publish_files_remaining':0,'actual_recorder_sha256':hashlib.sha256((ROOT/'tools/porting/record_command.py').read_bytes()).hexdigest()}
 (OUT/'result.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8');print(result,flush=True)
if __name__=='__main__':main()

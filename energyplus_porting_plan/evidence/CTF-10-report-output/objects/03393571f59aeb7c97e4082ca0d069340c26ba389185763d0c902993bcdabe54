"""Rerun all four quality checks after the one-field observer correction."""
import difflib,hashlib,json,subprocess
from pathlib import Path
BASE=Path('.runtime/porting/CTF-10');snapshot=None;OUT=BASE/'report-scan-observer-correction-01';OUT.mkdir()
old=(BASE/'report-scan-observer-applied-01/ctf10_report_scan_unit_observer.rs').read_bytes();assert hashlib.sha256(old).hexdigest()=='9e4c5ac7a9a9a376c6d3b7e69202ef6fe8eaac9d7731ce9f50f611579e48cec0'
p=Path('crates/ep_run/examples/ctf10_report_scan_unit_observer.rs');new=p.read_bytes();assert old.count(b'compiled.diagnostics')==1 and new==old.replace(b'compiled.diagnostics',b'compiled.report.diagnostics')
(OUT/p.name).write_bytes(new);(OUT/'correction.diff').write_text(''.join(difflib.unified_diff(old.decode().splitlines(True),new.decode().splitlines(True),fromfile='formatted held observer',tofile='actual corrected observer')),encoding='utf8')
for role in ['fmt-check','clippy','focused','workspace']:
 prior=json.loads((BASE/f'report-input-scan-{role}-command-01/receipt.json').read_bytes());assert prior['exit_code']==0
 destination=BASE/f'report-output-{role}-command-02'
 subprocess.run(['python','-X','utf8','-B','tools/porting/record_command.py','--output-dir',str(destination),'--',*prior['command']],check=True)
 actual=json.loads((destination/'receipt.json').read_bytes());assert actual['exit_code']==0 and actual['source_bytes_match_before_and_after']is True
 if snapshot is None:snapshot=actual['source_snapshot']
 assert actual['source_snapshot']==snapshot
 print('Actual quality completed',role,snapshot,flush=True)

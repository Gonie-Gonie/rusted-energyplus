--- /dev/null
+++ .runtime/porting/SYS-02/warmup-selected-observer-prep-01/author.py
@@ -0,0 +1,146 @@
+"""Seal literal companion inputs and a cfg(test) private-method observer only."""
+from pathlib import Path
+import ast
+import copy
+import difflib
+import hashlib
+import json
+
+ROOT = Path(__file__).resolve().parents[4]
+OUT = Path(__file__).resolve().parent
+NATIVE = ROOT / '.runtime/porting/SYS-02/warmup-native-prep-01'
+
+def ref(p):
+    b = p.read_bytes()
+    return {'path': p.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(b).hexdigest(),
+            'size_bytes': len(b), 'line_count': len(b.splitlines())}
+
+def write(p, text):
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_bytes(text.encode('utf-8'))
+
+assert ref(NATIVE/'manifest.json')['sha256'] == '61e2ca2825d527fe0da515cbc7d3d5ae2076eac32806130336faeaef49937368'
+assert ref(NATIVE/'input-only-cases.proposed.json')['sha256'] == '34a6d7cd40ff24ae08c04b7be88cbc527c2e4c003d734f7e6b212ed121359637'
+native = json.loads((NATIVE/'input-only-cases.proposed.json').read_text())
+# Literal independent pre-Record input bindings. No numeric equations or outputs.
+rate_rows = [
+ ('0000000000000000','0000000000000000','0000000000000000'),
+ ('3f1a36e2eb1c432c','3f1a36e2eb1c432c','0000000000000000'),
+ ('3f1a36e2eb1c432d','3f1a36e2eb1c432d','0000000000000000'),
+ ('3f1a36e2eb1c432e','3f1a36e2eb1c432e','0000000000000000'),
+ ('4058ffffffffffff','4058ffffffffffff','0000000000000000'),
+ ('4059000000000000','4059000000000000','0000000000000000'),
+ ('4059000000000001','4059000000000001','0000000000000000'),
+ ('4072c00000000000','4072c00000000000','0000000000000000'),
+ ('4079000000000000','4079000000000000','0000000000000000'),
+ ('407f400000000000','407f400000000000','0000000000000000'),
+ ('4089000000000000','4089000000000000','0000000000000000'),
+ ('bf1a36e2eb1c432c','0000000000000000','3f1a36e2eb1c432c'),
+ ('bf1a36e2eb1c432d','0000000000000000','3f1a36e2eb1c432d'),
+ ('bf1a36e2eb1c432e','0000000000000000','3f1a36e2eb1c432e'),
+ ('c058ffffffffffff','0000000000000000','4058ffffffffffff'),
+ ('c059000000000000','0000000000000000','4059000000000000'),
+ ('c059000000000001','0000000000000000','4059000000000001'),
+ ('c069000000000000','0000000000000000','4069000000000000'),
+ ('c072c00000000000','0000000000000000','4072c00000000000'),
+ ('c079000000000000','0000000000000000','4079000000000000'),
+ ('c089000000000000','0000000000000000','4089000000000000'),
+]
+lookup = {sn:(h,c) for sn,h,c in rate_rows}
+assert len(lookup) == len(rate_rows)
+mapping = {'schema':'sys02-prospective-Record-input-bindings.v1',
+           'Native_input_source':ref(NATIVE/'input-only-cases.proposed.json'),
+           'literal_rows':[{'SNLoad_input_bits':s,'independent_heat_rate_input_bits':h,'independent_cool_rate_input_bits':c} for s,h,c in rate_rows],
+           'actual_Native_producer_values_observed':False, 'producer_equivalence_or_PASS_claimed':False,
+           'every_actual_Native_pre_Record_rate_must_equal_literal_before_endpoint_pairing':True}
+write(OUT/'literal-rate-input-bindings.json',json.dumps(mapping,indent=2)+'\n')
+cases=[]
+for item in native['cases']:
+    case={'case_id':item['case_id'],'initial':copy.deepcopy(item['initial']),'operations':[]}
+    for operation in item['operations']:
+        row={k:copy.deepcopy(operation[k]) for k in ['operation_id','operation','clock']}
+        row['observations']=[]
+        for i,sample in enumerate(operation['zone_samples']):
+            heat,cool=lookup[sample['SNLoad']['bits']]
+            row['observations'].append({'native_zone_index':i+1,'Rust_direct_zone_id':i,
+                'ZTAV':copy.deepcopy(sample['ZTAV']),'heat_rate':{'bits':heat},'cool_rate':{'bits':cool}})
+        case['operations'].append(row)
+    cases.append(case)
+companion={'schema':'sys02-warmup-selected-request.v1','expected_values_supplied':False,'Native_results_supplied':False,
+           'Native_input_source':ref(NATIVE/'input-only-cases.proposed.json'),
+           'literal_rate_input_bindings':ref(OUT/'literal-rate-input-bindings.json'),'cases':cases}
+write(OUT/'input-only-companion.proposed.json',json.dumps(companion,indent=2)+'\n')
+
+parent='crates/ep_runtime/src/heat_balance/warmup.rs'
+new='crates/ep_runtime/src/heat_balance/warmup_selected_reference.rs'
+before=OUT/'before'/parent
+before.parent.mkdir(parents=True,exist_ok=True)
+before.write_bytes((ROOT/parent).read_bytes())
+assert b'mod selected_reference;' not in before.read_bytes()
+append='\n#[cfg(test)]\n#[path = "warmup_selected_reference.rs"]\nmod selected_reference;\n'
+proposal=OUT/'proposed'/parent
+write(proposal,before.read_text(encoding='utf-8-sig')+append)
+assert proposal.read_bytes()[:-len(append.encode())] == before.read_bytes()
+assert not (ROOT/new).exists()
+application=[]
+for name in [parent,new]:
+    p=OUT/'proposed'/name
+    old=before.read_text(encoding='utf-8-sig').splitlines(keepends=True) if name==parent else []
+    d=OUT/'diffs'/(name.replace('/','__')+'.diff')
+    write(d,''.join(difflib.unified_diff(old,p.read_text().splitlines(keepends=True),
+        fromfile=name if name==parent else '/dev/null',tofile=name)))
+    row={'canonical_path':name,'proposal':ref(p),'exact_diff':ref(d)}
+    if name==parent:row.update(actual_before=ref(ROOT/name),before_archive=ref(before))
+    else:row['new_destination_absent']=True
+    application.append(row)
+
+source_ranges=[]
+for name,first,last,purpose in [
+ (parent,264,340,'actual private constructor/Record/four comparisons/transfer-reset'),
+ (parent,341,403,'actual production record_state prerequisite and selected check_day'),
+ ('crates/ep_runtime/src/heat_balance/state.rs',884,944,'actual public selected owner layout/options'),
+ ('crates/ep_runtime/Cargo.toml',1,16,'existing serde_json dev-only transport dependency'),
+ ('crates/ep_model/src/ids.rs',1,11,'actual u32 direct unit ID type'),
+ ('crates/ep_runtime/src/heat_balance/ctf_caller_clock.rs',170,173,'existing cfg(test) path-child convention'),
+]:
+    p=ROOT/name;b=b''.join(p.read_bytes().splitlines(keepends=True)[first-1:last]);assert len(b.splitlines())==last-first+1
+    q=OUT/'source-ranges'/(name.replace('/','__')+f'.{first}-{last}.txt');q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b)
+    source_ranges.append({'path':name,'start_line':first,'end_line':last,'purpose':purpose,
+        'sha256':hashlib.sha256(b).hexdigest(),'size_bytes':len(b),'literal_archive':ref(q)})
+own=['literal-rate-input-bindings.json','input-only-companion.proposed.json','README.md','author.py']
+additions=[]
+for name in own:
+    p=OUT/name;d=OUT/'diffs'/(name+'.addition.diff')
+    write(d,''.join(difflib.unified_diff([],p.read_text().splitlines(keepends=True),fromfile='/dev/null',tofile=p.relative_to(ROOT).as_posix())))
+    additions.append(ref(d))
+metadata={'schema':'sys02-warmup-selected-observer-source-preparation.v1','status':'HELD-Source-only-unexecuted',
+    'Native_source_preparation':ref(NATIVE/'manifest.json'),'Native_input_source':ref(NATIVE/'input-only-cases.proposed.json'),
+    'actual_current_owner_application':ref(ROOT/'.runtime/porting/SYS-03/warmup-owner-applied-01/record.json'),
+    'application_sources':application,'own_sources_and_metadata':[ref(OUT/x) for x in own],
+    'Source_dependencies':[ref(ROOT/x) for x in ['crates/ep_runtime/src/heat_balance/state.rs','crates/ep_runtime/Cargo.toml',
+        'crates/ep_model/src/ids.rs','crates/ep_runtime/src/heat_balance/ctf_caller_clock.rs']],
+    'read_source_ranges':source_ranges,'exact_addition_diffs':additions,
+    'runtime_interfaces':{'request_schema':companion['schema'],'result_schema':'sys02-warmup-selected-results.v1',
+        'test_filter':'heat_balance::warmup::selected_reference::observe_literal_selected_warmup_methods',
+        'required_environment_operands':['SYS02_REFERENCE_INPUT','SYS02_REFERENCE_OUTPUT'],
+        'Cargo_test_arguments':['--locked','-p','ep_runtime','--lib','heat_balance::warmup::selected_reference::observe_literal_selected_warmup_methods','--','--exact','--ignored'],
+        'Root_must_supply_established_Cargo_config_and_record_literal_environment_operands':True,
+        'actual_new_test_is_ignored_in_ordinary_quality':True,
+        'full_input_SHA_before_after_and_full_Cargo_Source_snapshot_authentication_external':True,
+        'output_fresh_create_new_under_ignored_SYS02_only':True,
+        'public_API_or_normal_production_route_changed':False},
+    'pairing_prerequisites':{'every_case_initial_selected_Native_and_Rust_owner_must_match_before_endpoints':True,
+        'every_actual_Native_pre_RecKeep_ZTAV_heat_cool_clock_and_association_must_equal_companion_literals':True,
+        'all_calls_cases_retained_without_sampling':True,'required_missing_or_unavailable_never_PASS':True,
+        'Native_report_producer_equivalence_not_inferred_from_rate_input_equality':True,
+        'remaining_Native_rolling_report_backend_ordinary_handoff_are_explicitly_unavailable_not_PASS':True,
+        'no_zone_arbitrary_minimum_days_scope_not_generalized':True},
+    'scientific_execution_performed':False,'Native_outputs_read':False,'expected_answers_supplied':False,
+    'gates_updated':False,'canonical_Source_modified':False}
+ast.parse(Path(__file__).read_text())
+assert len(cases)==25
+assert {s['SNLoad']['bits'] for c in native['cases'] for o in c['operations'] for s in o['zone_samples']}==set(lookup)
+write(OUT/'manifest.json',json.dumps(metadata,indent=2)+'\n')
+print(json.dumps({'manifest':ref(OUT/'manifest.json'),'fixed_cases':len(cases),'literal_rate_bindings':len(lookup),
+                  'new_observer_lines':len((OUT/'proposed'/new).read_bytes().splitlines()),
+                  'application_diffs':len(application),'Source_ranges':len(source_ranges)}))

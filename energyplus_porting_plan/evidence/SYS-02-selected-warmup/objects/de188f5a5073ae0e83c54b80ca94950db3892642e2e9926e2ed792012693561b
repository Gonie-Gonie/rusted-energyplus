    [[nodiscard]] T &operator()(size_type n)
    {
        return (*this)[n - 1];
    }

    [[nodiscard]] const T &operator()(size_type n) const
    {
        return (*this)[n - 1];
    }

    void allocate(size_type size)
    {
        m_allocated = true;
        std::vector<T>::resize(size);
        std::fill(begin(), end(), T{});
    }

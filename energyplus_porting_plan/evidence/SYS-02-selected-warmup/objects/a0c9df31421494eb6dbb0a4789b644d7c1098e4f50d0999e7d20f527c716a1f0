include("${SYS02_REFERENCE_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  function(sys02_place_reference)
    if(NOT TARGET sys02_warmup_helper OR NOT IS_DIRECTORY "${SYS02_OUTPUT_DIR}")
      message(FATAL_ERROR "Reviewed helper and prepared output directory required")
    endif()
    set_target_properties(sys02_warmup_helper PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${SYS02_OUTPUT_DIR}")
    get_target_property(_sys02_link_options sys02_warmup_helper LINK_OPTIONS)
    list(REMOVE_ITEM _sys02_link_options "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/sys02_warmup_helper.map")
    set_property(TARGET sys02_warmup_helper PROPERTY LINK_OPTIONS "${_sys02_link_options}")
    target_link_options(sys02_warmup_helper PRIVATE "-Wl,-Map,${SYS02_OUTPUT_DIR}/sys02_warmup_helper.map")
  endfunction()
  cmake_language(DEFER CALL sys02_place_reference)
endif()

"""Root-only comparison of genuine selected warmup methods; no equations."""
import argparse
import copy
import difflib
import hashlib
import json
import math
from pathlib import Path
import struct
import sys

ROOT = Path(__file__).resolve().parents[4]
HERE = Path(__file__).resolve().parent
FILTER = 'heat_balance::warmup::selected_reference::observe_literal_selected_warmup_methods'
CONFIGS = ['--config', 'profile.dev.debug=0', '--config', 'profile.test.debug=0', '--config', 'build.incremental=false']
SEEN = {}
MISMATCHES = []
COUNTS = {'input_join_comparisons': 0, 'selected_endpoint_comparisons': 0}


def need(condition, message):
    if not condition:
        raise ValueError(message)


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def exact(row, external_binary=False):
    path = (ROOT / row['path']).resolve()
    allowed = path.is_relative_to(ROOT) or (external_binary and Path(row['path']).is_absolute() and not str(path).startswith('\\\\') and path.suffix.lower() == '.exe')
    need(allowed and path.is_file(), 'missing or uncontained artifact')
    need(digest(path) == row['sha256'], 'artifact SHA differs: ' + row['path'])
    if 'size_bytes' in row:
        need(type(row['size_bytes']) is int and path.stat().st_size == row['size_bytes'], 'artifact size differs')
    SEEN[path] = row['sha256']
    return path


def load(row):
    return json.loads(exact(row).read_text(encoding='utf-8-sig'), parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))


def ref(path):
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest(path), 'size_bytes': path.stat().st_size}


def same(left, right, path, phase):
    COUNTS['input_join_comparisons' if phase == 'input' else 'selected_endpoint_comparisons'] += 1
    if type(left) is not type(right) or left != right:
        MISMATCHES.append({'phase': phase, 'path': path, 'Native_or_required': left, 'Rust_or_observed': right})


def bits(token):
    need(isinstance(token, str) and len(token) == 16 and all(c in '0123456789abcdef' for c in token), 'canonical bits required')
    value = struct.unpack('>d', bytes.fromhex(token))[0]
    need(math.isfinite(value), 'nonfinite selected value cannot PASS')
    return value


def scalar(value):
    need(isinstance(value, dict) and set(value) == {'value', 'value_bits', 'value_class'}, 'mandatory complete scalar missing')
    number = bits(value['value_bits'])
    kind = ('negative_zero' if value['value_bits'][0] == '8' else 'positive_zero') if number == 0.0 else 'finite'
    need(value['value_class'] == kind and type(value['value']) in (int, float), 'scalar class/value differs')
    need(struct.pack('>d', float(value['value'])).hex() == value['value_bits'], 'decimal and exact IEEE bits differ')
    return value['value_bits'], kind


def literal(value):
    need(isinstance(value, dict) and set(value) == {'bits'}, 'sole literal bits operand required')
    number = bits(value['bits'])
    kind = ('negative_zero' if value['bits'][0] == '8' else 'positive_zero') if number == 0.0 else 'finite'
    return value['bits'], kind


def array_rows(array, count):
    need(array['size'] == count and array['values_available'] is True, 'selected allocation/availability differs')
    need(len(array['rows']) == count, 'selected owner rows missing')
    if count:
        need(array['allocated'] is True and array['lower'] == 1 and array['upper'] == count, 'one-based selected bounds differ')
    need([r['actual_array_index'] for r in array['rows']] == list(range(1, count + 1)), 'selected row order differs')
    return [r['value'] for r in array['rows']]


def native_selected(snapshot, count, policy):
    owner = snapshot['owner']
    fields = {name: array_rows(owner['arrays'][name], count) for name in policy['daily_owner_fields']}
    convergence = array_rows(owner['arrays']['WarmupConvergenceValues'], count)
    zones = []
    for i in range(count):
        zone = {name: scalar(values[i]) for name, values in fields.items()}
        zone.update({name: scalar(convergence[i][name]) for name in policy['metric_fields']})
        zone['PassFlag'] = array_rows(convergence[i]['PassFlag'], 4)
        need(all(type(v) is int and v in (1, 2) for v in zone['PassFlag']), 'four genuine convergence flags required')
        zones.append(zone)
    need(type(owner['clock']['WarmupFlag']) is bool, 'mandatory Native WarmupFlag')
    return {'zones': zones, 'WarmupFlag': owner['clock']['WarmupFlag']}


def rust_selected(snapshot, count, policy):
    need(len(snapshot['zones']) == count and snapshot['unavailable_counted_as_PASS'] is False, 'complete Rust owner/unavailable record required')
    need(snapshot['unavailable_Native_owner_families'] == policy['unavailable_Native_owner_families'], 'unavailable ledger differs')
    zones = []
    for i, row in enumerate(snapshot['zones']):
        need(row['actual_Rust_direct_zone_id'] == i, 'explicit direct Rust ID/order differs')
        fields = row['selected_owners']
        need(set(fields) == set(policy['daily_owner_fields'] + policy['metric_fields'] + ['PassFlag']), 'selected Rust field missing/extra')
        zone = {name: scalar(fields[name]) for name in policy['daily_owner_fields'] + policy['metric_fields']}
        zone['PassFlag'] = fields['PassFlag']
        need(len(zone['PassFlag']) == 4 and all(type(v) is int and v in (1, 2) for v in zone['PassFlag']), 'four Rust convergence flags required')
        zones.append(zone)
    need(type(snapshot['WarmupFlag']) is bool, 'mandatory Rust WarmupFlag')
    return {'zones': zones, 'WarmupFlag': snapshot['WarmupFlag']}


def pair(left, right, path, phase):
    same(left['WarmupFlag'], right['WarmupFlag'], path + '/WarmupFlag', phase)
    need(len(left['zones']) == len(right['zones']), 'zone cardinality differs')
    for i, (a, b) in enumerate(zip(left['zones'], right['zones'])):
        for name in a:
            if name == 'PassFlag':
                for k in range(4):
                    same(a[name][k], b[name][k], f'{path}/zone{i + 1}/{name}/{k + 1}', phase)
            else:
                same(a[name], b[name], f'{path}/zone{i + 1}/{name}', phase)


def receipt(row, recorder):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] == 0 and value['launch_error'] is None, 'actual command did not return zero')
    need(value['source_bytes_match_before_and_after'] is True and value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'actual source preservation/custody failed')
    for name in ('stdout', 'stderr', 'source_snapshot'):
        exact(value[name])
    exact(value['executed_launcher']['archive'])
    need(exact(value['executed_launcher']['archive']).read_bytes() == exact(recorder).read_bytes(), 'recorder Source differs')
    return value


def custody(packet, policy):
    need(packet['schema'] == 'sys02-selected-warmup-comparison-custody.v1', 'Root literal custody packet required')
    for name in ('Native_input', 'Rust_input'):
        need(packet[name]['sha256'] == policy[name + '_source']['sha256'] and packet[name]['size_bytes'] == policy[name + '_source']['size_bytes'], 'literal frozen request differs')
        exact(policy[name + '_source'])
    for name in ('Native_source_preparation', 'Rust_source_preparation', 'literal_rate_bindings'):
        load(policy[name])
    n, r, outer = (receipt(packet[name], policy['recorder_source']) for name in ('Native_execution', 'Rust_execution', 'Rust_launch_execution'))
    build, frozen = receipt(packet['Native_build_execution'], policy['recorder_source']), load(packet['Native_frozen_build_inputs'])
    need(frozen['reviewed_Source_preparation']['sha256'] == policy['Native_source_preparation']['sha256'], 'actual Native build Source preparation differs')
    for row in frozen['frozen_Source_and_input']:
        exact(row)
    need(build['finished_utc'] <= n['started_utc'] and 'sys02_warmup_helper' in build['command'], 'actual helper build/capture chronology differs')
    need(len(n['command']) == 2 and Path(n['command'][0]).resolve() == exact(packet['Native_binary'], True) and Path(n['command'][1]).resolve() == exact(packet['Native_input']), 'Native argc2/source input command differs')
    need(exact(n['stdout']) == exact(packet['Native_result']), 'Native result is not complete actual stdout')
    command = ['cargo', 'test'] + CONFIGS + ['--locked', '-p', 'ep_runtime', '--lib', FILTER, '--', '--exact', '--ignored']
    need(r['command'] == command, 'actual selected ignored-test Cargo command differs')
    launch = exact(packet['Rust_launch_source'])
    need(outer['command'][1:] == ['-X', 'utf8', '-B', str(launch), str(exact(packet['Rust_input'])), str(exact(packet['Rust_result']))], 'Root env launcher command/input/output differs')
    need(outer['started_utc'] <= r['started_utc'] <= r['finished_utc'] <= outer['finished_utc'], 'actual Cargo call outside launcher')
    need(outer['source_snapshot'] == r['source_snapshot'], 'launcher/Cargo full Source snapshots differ')
    sidecar = load(packet['Rust_execution_sidecar'])
    need(sidecar['schema'] == 'sys02-selected-warmup-execution-input-custody.v1', 'actual input/environment sidecar required')
    need(sidecar['actual_launcher_source'] == packet['Rust_launch_source'] and sidecar['actual_Cargo_execution'] == packet['Rust_execution'], 'actual launcher/Cargo sidecar join differs')
    need(sidecar['actual_environment_operands'] == {'SYS02_REFERENCE_INPUT': str(exact(packet['Rust_input'])), 'SYS02_REFERENCE_OUTPUT': str(exact(packet['Rust_result']))}, 'actual literal environment differs')
    need(sidecar['actual_input_before']['sha256'] == sidecar['actual_input_after']['sha256'] == packet['Rust_input']['sha256'] and sidecar['actual_input_before']['size_bytes'] == sidecar['actual_input_after']['size_bytes'] == packet['Rust_input']['size_bytes'], 'actual full input before/after differs')
    need(exact(sidecar['actual_input_before']) == exact(sidecar['actual_input_after']) == exact(packet['Rust_input']) and exact(sidecar['actual_output']) == exact(packet['Rust_result']), 'actual input/output path custody differs')
    snap = load(r['source_snapshot'])
    need(snap['schema'] == 'rust-command-source-snapshot.v1' and snap['bytes_normalized'] is False, 'literal Cargo Source capture required')
    members = {row['historical_path']: row for row in snap['files']}
    need(len(members) == len(snap['files']), 'duplicate Source snapshot member')
    for row in snap['files']:
        need(exact(row['archive']).stat().st_size == row['size_bytes'], 'full Source archive size differs')
    for row, held in zip(packet['actual_Rust_observer_sources'], policy['Rust_reviewed_proposals']):
        captured = members[row['canonical_path']]
        need(exact(row['actual_final_source']).read_bytes() == exact(captured['archive']).read_bytes(), 'compiled observer Source differs')
        before, after = exact(row['actual_literal_source']).read_bytes(), exact(row['actual_final_source']).read_bytes()
        need(before == exact(held).read_bytes(), 'installed literal observer is not reviewed proposal')
        delta = exact(row['formatter_correspondence_diff']).read_text(encoding='utf-8')
        labels = delta.splitlines()
        need((not delta and before == after) or (len(labels) >= 2 and delta == ''.join(difflib.unified_diff(before.decode('utf-8').splitlines(keepends=True), after.decode('utf-8').splitlines(keepends=True), fromfile=labels[0][4:], tofile=labels[1][4:]))), 'actual literal/final formatter diff differs')
    need([row['canonical_path'] for row in packet['actual_Rust_observer_sources']] == policy['Rust_observer_source_paths'], 'actual selected Source membership differs')
    need(packet['Root_and_other_author_FULL_formatter_correspondence_accepted'] is True, 'actual formatter Source peer required')
    need(packet['Root_reviewed_literal_environment_launcher'] is True, 'Root Source review of literal env launcher is required')
    return n, r, outer


def setup(snapshot, initial, path):
    owner = snapshot['owner']
    for name in ('TimeStepSysSec', 'TempConvergTol', 'LoadsConvergTol'):
        same(literal(initial[name]), scalar(owner['configuration'][name]), path + '/configuration/' + name, 'input')
    for name in ('MinNumberOfWarmupDays', 'MaxNumberOfWarmupDays', 'RunPeriodEnvironment', 'EnvironmentName', 'ReportDetailedWarmupConvergence'):
        same(initial[name], owner['configuration'][name], path + '/configuration/' + name, 'input')
    same(len(initial['zone_names']), owner['configuration']['NumOfZones'], path + '/NumOfZones', 'input')
    same(0, owner['configuration']['numSpaces'], path + '/numSpaces', 'input')
    for name in ('TimeStepsInHour', 'DoingSizing', 'DoPureLoadCalc'):
        same(initial[name], owner['clock'][name], path + '/clock/' + name, 'input')
    same(literal(initial['TimeStepZone']), scalar(owner['clock']['TimeStepZone']), path + '/TimeStepZone', 'input')


def compare(packet, policy):
    nreceipt, rreceipt, outer = custody(packet, policy)
    source, companion = load(packet['Native_input']), load(packet['Rust_input'])
    native, rust = load(packet['Native_result']), load(packet['Rust_result'])
    need(native['schema'] == 'sys02-warmup-direct-results.v1' and rust['schema'] == 'sys02-warmup-selected-results.v1', 'actual result schema differs')
    for name in ('expected_values_supplied', 'Original_bodies_modified', 'scientific_PASS_claimed', 'ordinary_handoff_PASS_claimed', 'gates_updated'):
        need(native[name] is False, 'Native Source/outcome assertion differs')
    for name in ('full_input_SHA_verified_internally', 'SNLoad_to_rate_equations_in_observer', 'Native_results_or_expected_values_read', 'production_call_path_or_whole_SYS02_SYS03_PASS_claimed', 'scientific_PASS_claimed', 'gates_updated'):
        need(rust[name] is False, 'Rust observer declaration differs')
    for name in ('external_full_input_SHA_and_Source_capture_before_after_required', 'all_declared_operations_retained', 'Native_pre_Record_operand_and_initial_owner_join_required_before_pairing'):
        need(rust[name] is True, 'mandatory external input/call custody missing')
    need(Path(rust['actual_input_path']).resolve() == exact(packet['Rust_input']) and rust['actual_input_size_bytes'] == packet['Rust_input']['size_bytes'], 'actual Rust input witness differs')
    count = len(source['cases'])
    need(native['requested_case_count'] == native['recorded_case_count'] == count == len(native['cases']) == len(rust['cases']) == len(companion['cases']), 'all fixed cases required')
    endpoints, unavailable = [], []
    for index, (spec, rspec, ncase, rcase) in enumerate(zip(source['cases'], companion['cases'], native['cases'], rust['cases'])):
        path = spec['case_id']
        need(path == rspec['case_id'] == ncase['case_id'] == rcase['case_id'], 'case order/identity differs')
        need(ncase['literal_input'] == spec and rcase['literal_initial_input'] == spec['initial'] == rspec['initial'], 'literal original/companion case witness differs')
        need(ncase['status'] == 'actual-selected-public-calls-returned' and ncase['unreached_operations'] == [], 'Native stop/unreached cannot pair')
        need(ncase['ordinary_simulation_or_BeginEnvrn_claimed'] is False and ncase['numerical_PASS_claimed'] is False and rcase['producer_or_whole_SYS02_SYS03_PASS_claimed'] is False and rcase['direct_unit_IDs_claimed_as_production_IDs'] is False, 'case scope declaration differs')
        zones = len(spec['initial']['zone_names'])
        need(rcase['actual_private_zone_constructor_calls'] == zones, 'constructor call custody differs')
        calls, boundaries, rops = ncase['actual_calls'], ncase['declared_input_boundaries'], rcase['operations']
        need(len(boundaries) == len(rops) == len(spec['operations']) == len(rspec['operations']), 'full operation ledger required')
        expected = [('allocate', 'HeatBalanceManager::AllocateHeatBalArrays', None)]
        for op in spec['operations']:
            if op['operation'] == 'record':
                expected.extend((op['operation_id'], 'ZoneSystemSensibleDemand::reportZoneAirSystemSensibleLoads', i + 1) for i in range(zones))
            api = {'record': 'RecKeepHeatBalance', 'check': 'CheckWarmupConvergence', 'report': 'ReportWarmupConvergence'}[op['operation']]
            expected.append((op['operation_id'], 'HeatBalanceManager::' + api, None))
        need(len(calls) == ncase['actual_source_call_count'] == len(expected), 'actual Native calls omitted/extra')
        for ordinal, (call, requested) in enumerate(zip(calls, expected), 1):
            need((call['operation_id'], call['api'], call['actual_zone_index']) == requested and call['actual_call_ordinal'] == ordinal, 'actual Native call order/API/zone differs')
            need(call['actual_source_invoked'] is True and call['actual_source_return_observed'] is True and call['source_exception'] is None, 'unavailable Native call cannot pair')
            for snap in (call['before'], call['after']):
                need(snap['callback_integrity_failed'] is False and snap['actual_callback_count'] == len(snap['callbacks']), 'callback integrity failed')
                need([row['actual_ordinal'] for row in snap['callbacks']] == list(range(1, len(snap['callbacks']) + 1)), 'callback records omitted')
            setup(call['before'], spec['initial'], path + f'/call{ordinal}/before')
            setup(call['after'], spec['initial'], path + f'/call{ordinal}/after')
        pair(native_selected(calls[0]['after'], zones, policy), rust_selected(rcase['constructed_selected_owners'], zones, policy), path + '/initial', 'input')
        cursor, prior_n, prior_r = 1, calls[0]['after'], rcase['constructed_selected_owners']
        for op, rop, boundary, observed in zip(spec['operations'], rspec['operations'], boundaries, rops):
            key = path + '/' + op['operation_id']
            need(boundary['operation_id'] == observed['operation_id'] == rop['operation_id'] == op['operation_id'] and observed['operation'] == rop['operation'] == op['operation'], 'operation identity/order differs')
            need(boundary['literal_input'] == op and observed['literal_input'] == rop and boundary['WarmupFlag_overwritten_by_input'] is False and rop['clock'] == op['clock'], 'actual ordered input witness differs')
            need(boundary['before_declared_input_writes'] == prior_n and observed['before'] == prior_r, 'operation before/previous endpoint discontinuity')
            changed = copy.deepcopy(boundary['before_declared_input_writes'])
            changed['owner']['clock'].update(op['clock'])
            if op['operation'] == 'record':
                need(len(rop['observations']) == zones, 'every literal rate input required')
                for i, operand in enumerate(rop['observations']):
                    need(operand['native_zone_index'] == i + 1 and operand['Rust_direct_zone_id'] == i and operand['ZTAV'] == op['zone_samples'][i]['ZTAV'], 'literal association/ZTAV differs')
                    changed['owner']['zones'][i]['ZTAV'] = boundary['after_declared_input_writes']['owner']['zones'][i]['ZTAV']
                    same(literal(operand['ZTAV']), scalar(changed['owner']['zones'][i]['ZTAV']), key + f'/input/zone{i + 1}/ZTAV', 'input')
            else:
                need(rop['observations'] == [], 'nonrecord operand injection')
            need(changed == boundary['after_declared_input_writes'], 'undeclared input/owner write')
            previous = boundary['after_declared_input_writes']
            consumed = zones + 1 if op['operation'] == 'record' else 1
            for call in calls[cursor:cursor + consumed]:
                need(call['before'] == previous, 'actual Native call boundary discontinuity')
                previous = call['after']
            call = calls[cursor + consumed - 1]
            cursor += consumed
            clock = call['before']['owner']['clock']
            need(all(clock[name] == value for name, value in op['clock'].items()), 'actual clock does not match literal operation')
            if op['operation'] == 'record':
                actual_zones = call['before']['owner']['zones']
                need(len(actual_zones) == zones, 'complete pre-RecKeep zones required')
                for i, (actual, operand) in enumerate(zip(actual_zones, rop['observations'])):
                    need(actual['actual_zone_index'] == i + 1 and actual['Name'] == spec['initial']['zone_names'][i], 'actual Native zone association differs')
                    for name, value in [('ZTAV', actual['ZTAV']), ('heat_rate', actual['sensible_report']['airSysHeatRate']), ('cool_rate', actual['sensible_report']['airSysCoolRate'])]:
                        same(literal(operand[name]), scalar(value), key + f'/preRecKeep/zone{i + 1}/' + name, 'input')
            invoked = op['operation'] != 'report'
            need(observed['actual_selected_method_invoked'] is invoked and observed['actual_selected_method_call_count'] == (zones if op['operation'] == 'record' else 1 if invoked else 0), 'actual Rust private-method call custody differs')
            need(observed['Native_sensible_report_or_ordinary_record_state_invoked'] is False and observed['Native_endpoint_or_branch_result_read'] is False and observed['numerical_PASS_claimed'] is False, 'Rust operation scope differs')
            need(observed['status'] == ('selected-private-method-returned' if invoked else 'unavailable-no-Rust-rolling-report-backend-owner'), 'actual Rust status differs')
            if invoked:
                for side in ('before', 'after'):
                    endpoints.append((native_selected(call[side], zones, policy), rust_selected(observed[side], zones, policy), key + '/' + side))
            else:
                need(observed['after'] == observed['before'], 'unavailable Report changed Rust owners')
                unavailable.append({'case_id': path, 'operation_id': op['operation_id'], 'family': 'ReportWarmupConvergence', 'required_for_selected_lane': False, 'counted_as_PASS': False})
            prior_n, prior_r = call['after'], observed['after']
        need(cursor == len(calls) and ncase['final'] == prior_n and rcase['final'] == prior_r, 'final/all-call closure differs')
        endpoints.append((native_selected(ncase['final'], zones, policy), rust_selected(rcase['final'], zones, policy), path + '/final'))
    admitted = not MISMATCHES
    if admitted:
        for left, right, path in endpoints:
            pair(left, right, path, 'endpoint')
    return {'input_and_initial_owner_join_passed': admitted, 'endpoint_pairing_performed': admitted,
            'actual_case_count': count, 'actual_selected_boundary_count': len(endpoints) if admitted else 0,
            'unavailable_report_operations': unavailable, 'unavailable_owner_families': [{'family': name, 'counted_as_PASS': False} for name in policy['unavailable_Native_owner_families']],
            'actual_Cargo_Source_snapshot': rreceipt['source_snapshot'], 'actual_Native_Source_snapshot': nreceipt['source_snapshot']}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--custody', required=True)
    parser.add_argument('--output-dir', required=True)
    args = parser.parse_args()
    name, sha = args.custody.rsplit('#', 1)
    packet_ref = {'path': name, 'sha256': sha}
    packet = load(packet_ref)
    policy_ref = ref(HERE / 'policy.json')
    policy = load(policy_ref)
    need(packet['prospective_policy']['sha256'] == policy_ref['sha256'] and packet['prospective_policy']['size_bytes'] == policy_ref['size_bytes'], 'approved prospective policy differs')
    output = (ROOT / args.output_dir).resolve()
    need(output.is_relative_to(ROOT / '.runtime/porting/SYS-02') and not output.exists(), 'fresh ignored SYS02 output required')
    output.mkdir(parents=True, exist_ok=False)
    try:
        findings = compare(packet, policy)
        status = 'pass-selected-methods-only' if findings['input_and_initial_owner_join_passed'] and not MISMATCHES else 'fail-selected-methods-or-input-join'
        code = 0 if status == 'pass-selected-methods-only' else 1
    except (KeyError, TypeError, ValueError, OSError) as error:
        findings, status, code = {'integrity_failure': str(error), 'endpoint_pairing_performed': False}, 'fail-observation-or-custody-integrity', 2
    for path, sha in SEEN.items():
        need(digest(path) == sha, 'authenticated input/artifact changed during comparison')
    mismatches = output / 'mismatches.ndjson'
    with mismatches.open('x', encoding='utf-8', newline='\n') as stream:
        for row in MISMATCHES:
            stream.write(json.dumps(row, allow_nan=False) + '\n')
    report = {'schema': 'sys02-selected-warmup-comparison.v1', 'status': status, 'actual_custody': packet_ref,
              'actual_prospective_policy': policy_ref, 'findings': findings, 'counts': COUNTS,
              'mismatch_count': len(MISMATCHES), 'all_mismatches_retained': True, 'mismatches': ref(mismatches),
              'producer_equivalence_PASS_claimed': False, 'rolling_report_backend_PASS_claimed': False,
              'whole_SYS02_SYS03_or_ordinary_handoff_PASS_claimed': False, 'gates_updated': False}
    with (output / 'comparison.json').open('x', encoding='utf-8', newline='\n') as stream:
        json.dump(report, stream, indent=2, allow_nan=False)
        stream.write('\n')
    print(json.dumps({'comparison': ref(output / 'comparison.json'), 'status': status, 'exit_code': code}))
    return code


if __name__ == '__main__':
    sys.exit(main())

def declared_calls(item):
    n = len(item['initial']['zone_names'])
    answer = [{'operation_id': 'allocate', 'api': 'HeatBalanceManager::AllocateHeatBalArrays', 'actual_zone_index': None}]
    for v in item['operations']:
        if v['operation'] == 'record':
            answer += [{'operation_id': v['operation_id'], 'api': 'ZoneSystemSensibleDemand::reportZoneAirSystemSensibleLoads',
                        'actual_zone_index': i} for i in range(1, n+1)]
        api = {'record': 'RecKeepHeatBalance', 'check': 'CheckWarmupConvergence', 'report': 'ReportWarmupConvergence'}[v['operation']]
        answer.append({'operation_id': v['operation_id'], 'api': 'HeatBalanceManager::' + api, 'actual_zone_index': None})
    return answer


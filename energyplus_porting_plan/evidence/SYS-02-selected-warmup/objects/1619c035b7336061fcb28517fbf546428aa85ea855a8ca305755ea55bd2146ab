for name, first, last, purpose in ranges:
    p = EP / name
    data = b''.join(p.read_bytes().splitlines(keepends=True)[first-1:last])
    assert len(data.splitlines()) == last-first+1
    archive = OUT / 'source-ranges' / f'{name.replace("/", "__")}.{first}-{last}.txt'
    archive.parent.mkdir(parents=True, exist_ok=True)
    archive.write_bytes(data)
    range_rows.append({'path': p.relative_to(ROOT).as_posix(), 'start_line': first, 'end_line': last,
                       'sha256': hashlib.sha256(data).hexdigest(), 'size_bytes': len(data), 'purpose': purpose,
                       'literal_archive': ref(archive)})


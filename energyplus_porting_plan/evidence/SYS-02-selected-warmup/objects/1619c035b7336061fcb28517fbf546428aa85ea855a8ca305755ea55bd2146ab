EP = ROOT / '.reference/energyplus-src/26.1.0/src/EnergyPlus'

def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(text.encode('utf-8'))

def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}

def scalar(v):
    return {'bits': struct.pack('>d', float(v)).hex()}

def initial(n=1, **overrides):
    value = {'zone_names': [f'SYS02-ZONE-{i+1}' for i in range(n)], 'TimeStepsInHour': 1,
             'TimeStepZone': scalar(1), 'TimeStepSysSec': scalar(3600),
             'TempConvergTol': scalar(.25), 'LoadsConvergTol': scalar(.25),
             'MinNumberOfWarmupDays': 1, 'MaxNumberOfWarmupDays': 25,
             'DoingSizing': False, 'DoPureLoadCalc': False, 'RunPeriodEnvironment': True,
             'EnvironmentName': 'SYS02-DIRECT-INPUT', 'ReportDetailedWarmupConvergence': True}
    value.update(overrides)
    return value

def op(kind, day, values=(), hour=1, step=1):
    return {'operation': kind, 'clock': {'DayOfSim': day, 'HourOfDay': hour, 'TimeStep': step},
            'zone_samples': [{'ZTAV': scalar(t), 'SNLoad': scalar(q)} for t, q in values]}


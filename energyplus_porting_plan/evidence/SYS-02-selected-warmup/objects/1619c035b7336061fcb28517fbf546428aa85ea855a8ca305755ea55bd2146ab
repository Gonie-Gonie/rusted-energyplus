                                     fromfile='/dev/null', tofile=p.relative_to(ROOT).as_posix()))
    write(q, text)
    diffs.append(ref(q))
for source, destination in zip(templates, ['warmup_reference_helper.cpp', 'warmup_reference_fields.hh', 'warmup_reference.cmake']):

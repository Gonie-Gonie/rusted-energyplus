+// Input-only direct calls to unchanged linked Original warmup/report APIs.
+#include "warmup_reference_fields.hh"
+#include <fstream>
+#include <initializer_list>
+#include <iostream>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <set>
+#include <stdexcept>
+#include <string>
+
+namespace {
+using Sys02::json;
+void require(bool ok, std::string const &message)
+{
+    if (!ok) {
+        throw std::runtime_error(message);
+    }
+}
+void keys(json const &value, std::initializer_list<char const *> names)
+{
+    require(value.is_object() && value.size() == names.size(), "Exact input object shape required");
+    for (char const *name : names) {
+        require(value.contains(name), std::string("Missing input field: ") + name);
+    }
+}
+int integer(json const &value, int minimum, int maximum)
+{
+    require(value.is_number_integer() && !value.is_boolean(), "Integer input required");
+    auto const v = value.get<std::int64_t>();
+    require(v >= minimum && v <= maximum, "Input outside declared source integer domain");
+    return static_cast<int>(v);
+}
+double input(json const &value)
+{
+    keys(value, {"bits"});
+    require(value.at("bits").is_string(), "Literal binary64 input bits required");
+    auto const token = value.at("bits").get<std::string>();
+    require(token.size() == 16 && token.find_first_not_of("0123456789abcdef") == std::string::npos, "Canonical 16-hex input required");
+    auto const number = std::bit_cast<double>(static_cast<std::uint64_t>(std::stoull(token, nullptr, 16)));
+    require(std::isfinite(number), "Finite input-only scalar required");
+    return number;
+}
+bool boolean(json const &value)
+{
+    require(value.is_boolean(), "Literal boolean input required");
+    return value.get<bool>();
+}
+struct ConsoleCapture {
+    std::ostringstream text;
+    std::streambuf *previous = nullptr;
+    ConsoleCapture() : previous(std::cout.rdbuf(text.rdbuf())) {}
+    ~ConsoleCapture() { std::cout.rdbuf(previous); }
+    ConsoleCapture(ConsoleCapture const &) = delete;
+    ConsoleCapture &operator=(ConsoleCapture const &) = delete;
+};
+struct Fixture {
+    ConsoleCapture console_capture;
+    std::unique_ptr<EnergyPlus::EnergyPlusData> state;
+    std::ostringstream *error = nullptr;
+    json callbacks = json::array();
+    bool callback_integrity_failed = false, allocated_returned = false, stddev_known = false, stopped = false;
+    std::size_t actual_calls = 0, callback_count = 0;
+    json calls = json::array();
+    Fixture() : state(std::make_unique<EnergyPlus::EnergyPlusData>())
+    {
+        auto sink = std::make_unique<std::ostringstream>();
+        error = sink.get();
+        state->files.err_stream = std::move(sink);
+        state->files.eio.open_as_stringstream();
+        state->dataGlobal->errorCallback = [this](EnergyPlus::Error level, std::string const &text) noexcept {
+            callback("errorCallback", static_cast<int>(level), text);
+        };
+        state->dataGlobal->messageCallback = [this](std::string const &text) noexcept {
+            callback("messageCallback", std::nullopt, text);
+        };
+        state->init_constant_state(*state);
+    }
+    Fixture(Fixture const &) = delete;
+    Fixture &operator=(Fixture const &) = delete;
+    void callback(char const *kind, std::optional<int> level, std::string const &text) noexcept
+    {
+        if (callback_count == std::numeric_limits<std::size_t>::max()) {
+            callback_integrity_failed = true;
+            return;
+        }
+        ++callback_count;
+        try {
+            callbacks.push_back({{"actual_ordinal", callback_count}, {"kind", kind},
+                                 {"level", level ? json(*level) : json(nullptr)}, {"message", text}});
+        } catch (...) {
+            callback_integrity_failed = true;
+        }
+    }
+    json snapshot()
+    {
+        return {{"owner", Sys02::owners(*state, allocated_returned, stddev_known)},
+                {"error_stream", error->str()}, {"eio", state->files.eio.get_output()}, {"console", console_capture.text.str()},
+                {"callbacks", callbacks}, {"actual_callback_count", callback_count},
+                {"callback_integrity_failed", callback_integrity_failed}};
+    }
+    template<class Call> bool invoke(std::string const &operation_id, char const *api, int zone_id, Call const &call)
+    {
+        auto const before = snapshot();
+        json exception = nullptr;
+        bool returned = false;
+        ++actual_calls;
+        try {
+            call();
+            returned = true;
+        } catch (std::exception const &e) {
+            exception = e.what();
+        } catch (...) {
+            exception = "non-standard Original exception";
+        }
+        stopped = !returned;
+        calls.push_back({{"operation_id", operation_id}, {"actual_call_ordinal", actual_calls}, {"api", api},
+                         {"actual_zone_index", zone_id > 0 ? json(zone_id) : json(nullptr)},
+                         {"actual_source_invoked", true}, {"actual_source_return_observed", returned},
+                         {"source_exception", exception}, {"before", before}, {"after", snapshot()}});
+        return returned;
+    }
+};
+void prepare(Fixture &fixture, json const &v)
+{
+    keys(v, {"zone_names", "TimeStepsInHour", "TimeStepZone", "TimeStepSysSec", "TempConvergTol", "LoadsConvergTol",
+             "MinNumberOfWarmupDays", "MaxNumberOfWarmupDays", "DoingSizing", "DoPureLoadCalc",
+             "RunPeriodEnvironment", "EnvironmentName", "ReportDetailedWarmupConvergence"});
+    auto &s = *fixture.state;
+    auto &g = *s.dataGlobal;
+    auto const &names = v.at("zone_names");
+    require(names.is_array() && names.size() <= static_cast<std::size_t>(std::numeric_limits<int>::max()), "Source-sized zone array required");
+    g.NumOfZones = static_cast<int>(names.size());
+    g.numSpaces = 0;
+    g.TimeStepsInHour = integer(v.at("TimeStepsInHour"), 1, std::numeric_limits<int>::max() / 24);
+    g.TimeStepZone = input(v.at("TimeStepZone"));
+    require(g.TimeStepZone > 0.0, "Positive declared zone-step hours required");
+    g.WarmupFlag = true;
+    g.DayOfSim = 1;
+    g.HourOfDay = 1;
+    g.TimeStep = 1;
+    g.DoingSizing = boolean(v.at("DoingSizing"));
+    g.DoPureLoadCalc = boolean(v.at("DoPureLoadCalc"));
+    s.dataHVACGlobal->TimeStepSysSec = input(v.at("TimeStepSysSec"));
+    require(s.dataHVACGlobal->TimeStepSysSec > 0.0, "Positive sensible-report elapsed seconds required");
+    s.dataHeatBal->TempConvergTol = input(v.at("TempConvergTol"));
+    s.dataHeatBal->LoadsConvergTol = input(v.at("LoadsConvergTol"));
+    require(s.dataHeatBal->TempConvergTol >= 0.0 && s.dataHeatBal->LoadsConvergTol >= 0.0, "Nonnegative actual tolerances required");
+    s.dataHeatBal->MinNumberOfWarmupDays = integer(v.at("MinNumberOfWarmupDays"), 1, std::numeric_limits<int>::max());
+    s.dataHeatBal->MaxNumberOfWarmupDays = integer(v.at("MaxNumberOfWarmupDays"), s.dataHeatBal->MinNumberOfWarmupDays, std::numeric_limits<int>::max());
+    s.dataEnvrn->RunPeriodEnvironment = boolean(v.at("RunPeriodEnvironment"));
+    require(v.at("EnvironmentName").is_string(), "Environment name required");
+    s.dataEnvrn->EnvironmentName = v.at("EnvironmentName").get<std::string>();
+    s.dataSysVars->ReportDetailedWarmupConvergence = boolean(v.at("ReportDetailedWarmupConvergence"));
+    s.dataHeatBal->Zone.allocate(g.NumOfZones);
+    s.dataZoneEnergyDemand->ZoneSysEnergyDemand.allocate(names.size());
+    for (int i = 1; i <= g.NumOfZones; ++i) {
+        auto const &name = names.at(static_cast<std::size_t>(i - 1));
+        require(name.is_string() && !name.get<std::string>().empty(), "Zone name required");
+        s.dataHeatBal->Zone(i).Name = name.get<std::string>();
+    }
+    require(!s.dataSurface->AnyMovableInsulation && s.dataSurface->AllHTWindowSurfaceList.empty() &&
+            !s.dataContaminantBalance->Contaminant.CO2Simulation && !s.dataContaminantBalance->Contaminant.GenericContamSimulation &&
+            s.dataViewFactor->NumOfSolarEnclosures == 0 && s.dataWeather->TotThermalReportPers == 0 &&
+            s.dataWeather->TotCO2ReportPers == 0 && s.dataWeather->TotVisualReportPers == 0 &&
+            s.dataSQLiteProcedures->sqlite == nullptr && !g.KickOffSimulation && !g.DoingInputProcessing,
+            "Fresh direct fixture prerequisites differ; no silent substitution");
+    fixture.invoke("allocate", "HeatBalanceManager::AllocateHeatBalArrays", 0, [&] {
+        EnergyPlus::HeatBalanceManager::AllocateHeatBalArrays(s);
+        fixture.allocated_returned = true;
+    });
+}
+json evaluate(json const &item, bool &any_failure)
+{
+    keys(item, {"case_id", "purpose", "initial", "operations"});
+    require(item.at("case_id").is_string() && item.at("purpose").is_string(), "Case identity and Source purpose required");
+    Fixture fixture;
+    prepare(fixture, item.at("initial"));
+    auto &s = *fixture.state;
+    require(item.at("operations").is_array() && !item.at("operations").empty(), "Complete ordered operations required");
+    json inputs = json::array(), unreached = json::array();
+    std::set<std::string> ids;
+    for (auto const &op : item.at("operations")) {
+        keys(op, {"operation_id", "operation", "clock", "zone_samples"});
+        require(op.at("operation_id").is_string() && ids.insert(op.at("operation_id").get<std::string>()).second, "Unique operation IDs required");
+        if (fixture.stopped) {
+            unreached.push_back(op);
+            continue;
+        }
+        auto const id = op.at("operation_id").get<std::string>();
+        auto const kind = op.at("operation").get<std::string>();
+        require(kind == "record" || kind == "check" || kind == "report", "Only declared unchanged public APIs admitted");
+        auto const before_input = fixture.snapshot();
+        auto const &clock = op.at("clock");
+        keys(clock, {"DayOfSim", "HourOfDay", "TimeStep"});
+        s.dataGlobal->DayOfSim = integer(clock.at("DayOfSim"), 1, std::numeric_limits<int>::max());
+        s.dataGlobal->HourOfDay = integer(clock.at("HourOfDay"), 1, 24);
+        s.dataGlobal->TimeStep = integer(clock.at("TimeStep"), 1, s.dataGlobal->TimeStepsInHour);
+        auto const &samples = op.at("zone_samples");
+        require(samples.is_array() && samples.size() == (kind == "record" ? static_cast<std::size_t>(s.dataGlobal->NumOfZones) : 0),
+                "Complete ordered record operands or genuinely empty nonrecord operands required");
+        if (kind == "record") {
+            for (int i = 1; i <= s.dataGlobal->NumOfZones; ++i) {
+                auto const &sample = samples.at(static_cast<std::size_t>(i - 1));
+                keys(sample, {"ZTAV", "SNLoad"});
+                s.dataZoneTempPredictorCorrector->zoneHeatBalance(i).ZTAV = input(sample.at("ZTAV"));
+                (void)input(sample.at("SNLoad"));
+            }
+        }
+        inputs.push_back({{"operation_id", id}, {"literal_input", op}, {"before_declared_input_writes", before_input},
+                          {"after_declared_input_writes", fixture.snapshot()}, {"WarmupFlag_overwritten_by_input", false}});
+        if (kind == "record") {
+            bool const report_point = !s.dataGlobal->WarmupFlag && s.dataGlobal->DayOfSim == 1 &&
+                                      (!s.dataGlobal->DoingSizing || s.dataGlobal->DoPureLoadCalc);
+            require(!report_point || s.dataGlobal->NumOfZones == 0 ||
+                    s.dataHeatBalMgr->CountWarmupDayPoints < s.dataGlobal->TimeStepsInHour * 24, "Full report capacity required; no truncation");
+            for (int i = 1; i <= s.dataGlobal->NumOfZones && !fixture.stopped; ++i) {
+                double const load = input(samples.at(static_cast<std::size_t>(i - 1)).at("SNLoad"));
+                fixture.invoke(id, "ZoneSystemSensibleDemand::reportZoneAirSystemSensibleLoads", i,
+                               [&] { s.dataZoneEnergyDemand->ZoneSysEnergyDemand(i).reportZoneAirSystemSensibleLoads(s, load); });
+            }
+            if (!fixture.stopped) {
+                fixture.invoke(id, "HeatBalanceManager::RecKeepHeatBalance", 0, [&] { EnergyPlus::HeatBalanceManager::RecKeepHeatBalance(s); });
+            }
+        } else if (kind == "check") {
+            fixture.invoke(id, "HeatBalanceManager::CheckWarmupConvergence", 0, [&] { EnergyPlus::HeatBalanceManager::CheckWarmupConvergence(s); });
+        } else {
+            require(s.dataGlobal->WarmupFlag || s.dataGlobal->NumOfZones == 0 || s.dataHeatBalMgr->CountWarmupDayPoints > 0,
+                    "Positive actual report point count required before division; no synthetic points");
+            fixture.invoke(id, "HeatBalanceManager::ReportWarmupConvergence", 0, [&] {
+                fixture.stddev_known = false;
+                EnergyPlus::HeatBalanceManager::ReportWarmupConvergence(s);
+                if (!s.dataGlobal->WarmupFlag) {
+                    fixture.stddev_known = true;
+                }
+            });
+        }
+    }
+    bool const failed = fixture.stopped || fixture.callback_integrity_failed;
+    any_failure = any_failure || failed;
+    return {{"case_id", item.at("case_id")}, {"purpose", item.at("purpose")}, {"literal_input", item},
+            {"declared_input_boundaries", inputs}, {"actual_calls", fixture.calls}, {"unreached_operations", unreached},
+            {"final", fixture.snapshot()}, {"actual_source_call_count", fixture.actual_calls},
+            {"status", failed ? "actual-source-or-observer-integrity-failure" : "actual-selected-public-calls-returned"},
+            {"ordinary_simulation_or_BeginEnvrn_claimed", false}, {"numerical_PASS_claimed", false}};
+}
+} // namespace
+int main(int argc, char const *argv[])
+{
+    try {
+        require(argc == 2, "Usage: sys02_warmup_helper <literal-input-only-request.json>");
+        std::ifstream stream(argv[1]);
+        require(stream.is_open(), "Cannot open input-only request");
+        auto const request = json::parse(stream);
+        keys(request, {"schema", "expected_values_supplied", "ordinary_production_prestate_supplied", "cases"});
+        require(request.at("schema") == "sys02-warmup-direct-request.v1" && request.at("expected_values_supplied") == false &&
+                request.at("ordinary_production_prestate_supplied") == false, "Unadmitted direct Source request");
+        require(request.at("cases").is_array() && !request.at("cases").empty(), "Ordered fixed input cases required");
+        json cases = json::array();
+        bool failed = false;
+        std::set<std::string> ids;
+        for (auto const &item : request.at("cases")) {
+            require(ids.insert(item.at("case_id").get<std::string>()).second, "Unique case IDs required");
+            cases.push_back(evaluate(item, failed));
+        }
+        std::cout << json{{"schema", "sys02-warmup-direct-results.v1"}, {"cases", cases},
+                          {"requested_case_count", request.at("cases").size()}, {"recorded_case_count", cases.size()},
+                          {"expected_values_supplied", false}, {"Original_bodies_modified", false},
+                          {"scientific_PASS_claimed", false}, {"ordinary_handoff_PASS_claimed", false}, {"gates_updated", false}}.dump() << '\n';
+        return failed ? 2 : 0;
+    } catch (std::exception const &error) {
+        std::cerr << error.what() << '\n';
+        return 2;
+    }
+}

# Append one genuine public-API helper; keep the entire prior recipe/target graph.
if(NOT DEFINED SYS02_SOURCE_DIR OR NOT DEFINED SYS02_INHERITED_RECIPE)
  message(FATAL_ERROR "SYS02 requires explicit reviewed Source directory and authentic prior recipe")
endif()
include("${SYS02_INHERITED_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  get_property(_sys02_scheduled GLOBAL PROPERTY SYS02_REFERENCE_SCHEDULED)
  if(NOT _sys02_scheduled)
    set_property(GLOBAL PROPERTY SYS02_REFERENCE_SCHEDULED TRUE)
    function(sys02_add_reference)
      if(NOT TARGET energypluslib)
        message(FATAL_ERROR "SYS02 requires unchanged Original energypluslib")
      endif()
      get_target_property(_sys02_defs energypluslib COMPILE_DEFINITIONS)
      get_directory_property(_sys02_directory_defs DIRECTORY "${CMAKE_SOURCE_DIR}/src/EnergyPlus" COMPILE_DEFINITIONS)
      list(APPEND _sys02_defs ${_sys02_directory_defs})
      list(FILTER _sys02_defs EXCLUDE REGEX "-NOTFOUND$")
      list(REMOVE_DUPLICATES _sys02_defs)
      add_executable(sys02_warmup_helper "${SYS02_SOURCE_DIR}/warmup_reference_helper.cpp")
      target_include_directories(sys02_warmup_helper PRIVATE "$<TARGET_PROPERTY:energypluslib,INCLUDE_DIRECTORIES>" "${SYS02_SOURCE_DIR}")
      target_compile_definitions(sys02_warmup_helper PRIVATE ${_sys02_defs})
      target_link_libraries(sys02_warmup_helper PRIVATE energypluslib project_options project_fp_options project_warnings)
      target_compile_features(sys02_warmup_helper PRIVATE cxx_std_20)
      target_link_options(sys02_warmup_helper PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/sys02_warmup_helper.map")
    endfunction()
    cmake_language(DEFER CALL sys02_add_reference)
  endif()
endif()

def compare_public_models(native, rust, request, c):
    ledger=[]
    for expected,left,right in zip(request["model_cases"],native["model_cases"],rust["model_cases"]):
        path=expected["id"]
        selected=right.get("selected_CTF02_owners")
        if not isinstance(selected,dict) or selected.get("owner_available") is not True:
            c.absence(path+"/CTF02_initialized_owner",left["loader_ready"],False,True,"required initialized CTF02 Result ledger absent")
            continue
        c.need(selected["preprocessing_or_coefficients_reexecuted_by_observer"] is False and
               selected["external_CTF_rows_supplied_to_initializer"] is False,"Actual borrowed initialized owners only")
        typed=right["typed_owners"]; construction_rows=typed["constructions"]
        ids=[r["id"] for r in construction_rows]
        results=selected["construction_coefficients"]
        c.need(isinstance(results,list) and len({r["construction_id"] for r in results}) == len(results),"Unique actual CTF02 owners required")
        c.exact(path+"/CTF02_owner_order",ids,[r["construction_id"] for r in results])
        c.exact(path+"/CTF02_owner_count",len(results),selected["actual_owner_count"])
        by_id={r["construction_id"]:r for r in results}
        by_name=owners(construction_rows,"name",c)
        prefixes={r["construction_id"]:r["result"] for r in right["selected_CTF01_owners"]["construction_preprocessing"]}
        for operation in left["operations"]:
            name=normalized(operation["actual_construction_Name"],c); construction=by_name.get(name)
            cid=construction["id"] if construction else None; row=by_id.get(cid)
            public_storage(c,path+"/"+name+"/CTF02",operation["CTF02_public_postreturn"],
                           row.get("result") if row else None,prefixes.get(cid))
        surfaces=selected["surface_coefficient_copies"]
        c.need(isinstance(surfaces,list),"Actual surface coefficient copy ledger required")
        c.exact(path+"/surface_copy_order",[r["id"] for r in typed["surfaces"]],[r["surface_id"] for r in surfaces])
        for actual,declared in zip(surfaces,typed["surfaces"]):
            p=path+"/surface/"+declared["name"]
            c.exact(p+"/actual_surface_name",declared["name"],actual["surface_name"])
            c.exact(p+"/construction_id",declared["construction_id"],actual["construction_id"])
            item=by_id.get(declared["construction_id"]); available=item is not None and item["result"].get("owner_available") is True
            c.exact(p+"/selected_construction_owner_available",available,actual["selected_construction_owner_available"])
            if not available:
                c.absence(p+"/CTF02_copy",False,False,False,"unselected construction fallback surface storage remains context-only/noPASS")
                continue
            c.exact(p+"/actual_owner_index",item["state_vector_index"],actual["actual_construction_owner_index"])
            c.exact(p+"/actual_cache_index",item["state_vector_index"],actual["actual_cache_index_copy"])
            storage=item["result"].get("snapshot"); copied=actual.get("snapshot")
            if not isinstance(storage,dict) or any(not isinstance(storage.get(key),list) or len(storage[key]) != 19 for key in PUBLIC_VARIABLES[:4]) or type(storage.get("NumCTFTerms")) is not int:
                c.absence(p+"/construction_copy_source",False,isinstance(copied,dict),True,"required exact19 construction copy source/count absent");continue
            if not isinstance(copied,dict):
                c.absence(p+"/surface_copy",True,False,True,"required selected surface copy absent");continue
            c.need(copied["context_only_unpaired"] is False and actual["copied_from_actual_surface_owner"] is True,"Actual selected surface copy provenance required")
            for native_key,copy_key in [("CTFOutside","outside"),("CTFCross","cross"),("CTFInside","inside"),("CTFFlux","flux")]:
                a=storage[native_key]; head=copied.get(copy_key+"_0"); history=copied.get(copy_key+"_history")
                if head is None or history is None:
                    c.absence(p+"/"+native_key+"/copy",True,False,True,"required scalar/history copy absent");continue
                c.dto(head);c.exact(p+"/"+native_key+"/head_bits",a[0]["value_bits"],head["value_bits"])
                terms=storage["NumCTFTerms"]
                c.need(type(terms) is int and 0 <= terms < 19 and isinstance(history,list),"Actual bounded term/surface shape required")
                c.exact(p+"/"+native_key+"/history_count",terms,len(history))
                for i,(x,y) in enumerate(zip(a[1:terms+1],history)):
                    c.dto(y);c.exact(p+"/"+native_key+"/history_bits/"+str(i),x["value_bits"],y["value_bits"])
        ledger.append({"model_id":path,"actual_construction_Result_count":len(results),"actual_surface_copy_count":len(surfaces),
                       "Native_later_solver_flags_paired":False,"unselected_or_unknown_counted_as_PASS":False})
    return ledger



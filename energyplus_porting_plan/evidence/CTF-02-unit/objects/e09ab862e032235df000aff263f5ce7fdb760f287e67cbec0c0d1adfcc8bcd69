class Comparison:
    def __init__(self, need):
        self.need = need
        self.counts = Counter()
        self.samples = []
        self.unavailable = []
        self.metrics = {key: {"count": 0, "maximum_absolute_error": 0.0, "norm": 0.0,
                              "nonfinite_error_count": 0} for key in VARIABLES}

    def failure(self, path, category, native, rust):
        self.counts["mismatches"] += 1
        self.counts[category] += 1
        if len(self.samples) < 1000:
            self.samples.append({"path": path, "category": category, "Native": native, "Rust": rust})

    def exact(self, path, native, rust):
        self.counts["discrete_comparisons"] += 1
        if type(native) is not type(rust) or native != rust:
            self.failure(path, "discrete_mismatches", native, rust)

    def absence(self, path, native_available, rust_available, required, reason):
        self.unavailable.append({"path": path, "Native_available": native_available, "Rust_available": rust_available,
                                 "required": required, "reason": reason, "counted_as_PASS": False})
        if required:
            self.failure(path, "availability_failures", native_available, rust_available)

    def dto(self, row):
        self.need(isinstance(row, dict) and set(row) == {"value", "value_bits", "value_class"}, "Actual complete binary64 DTO required")
        bits = row["value_bits"]
        self.need(isinstance(bits, str) and len(bits) == 16 and all(c in "0123456789abcdef" for c in bits), "Actual binary64 bits required")
        word = int(bits, 16)
        value = struct.unpack(">d", word.to_bytes(8, "big"))[0]
        kind = "nan" if math.isnan(value) else ("negative_infinity" if word >> 63 else "positive_infinity") if math.isinf(value) else (
            "negative_zero" if word >> 63 else "positive_zero") if value == 0 else "finite"
        self.need(row["value_class"] == kind, "Actual binary64 class differs from its bits")
        if math.isfinite(value):
            self.need(type(row["value"]) in (int, float) and struct.pack(">d", float(row["value"])).hex() == bits,
                      "Actual JSON scalar differs from its bits")
        else:
            self.need(row["value"] is None, "Observed nonfinite must retain bits/class and null JSON decimal")
        return value

    def number(self, path, profile, native, rust):
        left, right = self.dto(native), self.dto(rust)
        self.exact(path + "/class", native["value_class"], rust["value_class"])
        if not (math.isfinite(left) and math.isfinite(right)):
            self.absence(path, True, True, True, "actual nonfinite remains available; frozen policy supplies no nonfinite numerical PASS")
            return
        metric = self.metrics[profile]
        error = abs(left - right)
        metric["count"] += 1
        self.counts["numeric_comparisons"] += 1
        if not math.isfinite(error):
            metric["nonfinite_error_count"] += 1
        else:
            metric["maximum_absolute_error"] = max(metric["maximum_absolute_error"], error)
            metric["norm"] = math.hypot(metric["norm"], error)
        if error != 0.0:
            self.failure(path, "numeric_mismatches", native, rust)

    def handoff(self, path, profile, native, rust):
        # Inherited preprocessing copies are a separate handoff, not CTF02 metrics.
        self.need(profile in PREFIX_VARIABLES, "Inherited18 handoff profile required")
        left, right = self.dto(native), self.dto(rust)
        self.exact(path + "/class", native["value_class"], rust["value_class"])
        self.exact(path + "/bits", native["value_bits"], rust["value_bits"])
        self.counts["preprocessing_handoff_scalar_copies"] += 1
        if not (math.isfinite(left) and math.isfinite(right)):
            self.absence(path, True, True, True, "inherited required nonfinite handoff has no numerical PASS")

    def report(self):
        metrics = {}
        for key, metric in self.metrics.items():
            available = metric["count"] > 0 and metric["nonfinite_error_count"] == 0 and math.isfinite(metric["norm"])
            if metric["count"] == 0:
                self.absence("metrics/" + key, False, False, True, "no finite actual observations for this frozen profile")
            metrics[key] = {"count": metric["count"], "finite_metric_available": available,
                            "maximum_absolute_error": metric["maximum_absolute_error"] if available else None,
                            "RMSE": metric["norm"] / math.sqrt(metric["count"]) if available else None,
                            "nonfinite_error_count": metric["nonfinite_error_count"]}
        return {"numeric_comparisons": self.counts["numeric_comparisons"], "discrete_comparisons": self.counts["discrete_comparisons"],
                "mismatch_count": self.counts["mismatches"], "mismatch_categories": dict(self.counts), "metrics": metrics,
                "mismatch_samples": self.samples, "mismatch_samples_omitted": max(0, self.counts["mismatches"] - len(self.samples)),
                "unavailable_observations": self.unavailable, "unavailable_counted_as_PASS": False}


def normalized(value, c):
    c.need(isinstance(value, str) and value.isascii(), "Fixed input actual ASCII name required")
    return value.strip().upper()  # Actual NormalizedName::new semantics for fixed ASCII names.


def owners(rows, name_key, c):
    c.need(isinstance(rows, list), "Actual owner array required")
    result = {normalized(row[name_key], c): row for row in rows}
    c.need(len(result) == len(rows), "Actual owner names must be unique; no collision winner rewritten")
    return result


def required_exact(c, path, left, right):
    if left is None or right is None:
        c.absence(path, left is not None, right is not None, True, "required discrete owner absent")
    else:
        c.exact(path, left, right)


def copied_scalar(c, path, left, right):
    if left is None or right is None:
        c.absence(path, left is not None, right is not None, True, "required copied scalar owner absent")
        return
    c.dto(left); c.dto(right)
    c.exact(path + "/class", left["value_class"], right["value_class"])
    c.exact(path + "/bits", left["value_bits"], right["value_bits"])


def phases(c, path, left, right):
    for phase in PHASES:
        a, b = left.get(phase), right.get(phase)
        if a is None or b is None:
            c.absence(path + "/" + phase, a is not None, b is not None, True, "required phase ledger absent")
            continue
        for item in [a, b]:
            c.need(type(item["reached"]) is bool and type(item["available"]) is bool, "Typed phase availability required")
            c.need(item["reached"] or (not item["available"] and item["snapshot"] is None), "Unreached phase cannot fabricate an owner")
        c.exact(path + "/" + phase + "/reached", a["reached"], b["reached"])
        if not a["reached"] and not b["reached"]:
            c.absence(path + "/" + phase, False, False, False, "both actual phases unreached; no comparison or PASS")
            continue
        if not a["available"] or not b["available"] or a["snapshot"] is None or b["snapshot"] is None:
            c.absence(path + "/" + phase, a["available"] and a["snapshot"] is not None,
                      b["available"] and b["snapshot"] is not None, True, "required reached phase owner absent")
            continue
        x, y = a["snapshot"], b["snapshot"]
        for key in ["LayersInConstruct", "NumResLayers", "copied_layer_count", "ErrorsFound", "active_prefix_available"]:
            required_exact(c, path + "/" + phase + "/" + key, x.get(key), y.get(key))
        if x.get("active_prefix") is None or y.get("active_prefix") is None:
            c.absence(path + "/" + phase + "/active_prefix", x.get("active_prefix") is not None,
                      y.get("active_prefix") is not None, True, "required reached active-prefix owner absent")
            continue
        for row in [x, y]:
            c.need(type(row["LayersInConstruct"]) is int and 1 <= row["LayersInConstruct"] <= 11 and
                   row["copied_layer_count"] == row["LayersInConstruct"] == len(row["active_prefix"]), "Actual active prefix shape required")
        if len(x["active_prefix"]) != len(y["active_prefix"]):
            c.absence(path + "/" + phase + "/shape", True, True, True, "actual active prefix shapes differ")
            continue
        for index, (nl, rl) in enumerate(zip(x["active_prefix"], y["active_prefix"])):
            prefix = path + "/" + phase + "/" + str(index)
            required_exact(c, prefix + "/ResLayer", nl.get("ResLayer"), rl.get("ResLayer"))
            for key in ["dl", "rk", "rho", "cp", "lr"]:
                if nl.get(key) is None or rl.get(key) is None:
                    c.absence(prefix + "/" + key, nl.get(key) is not None, rl.get(key) is not None, True, "required reached scalar absent")
                else:
                    c.handoff(prefix + "/" + key, phase + "." + key, nl[key], rl[key])
        for key in ["dyn", "rs", "cnd"]:
            if phase == "PostConversion":
                if x.get(key) is None or y.get(key) is None:
                    c.absence(path + "/" + phase + "/" + key, x.get(key) is not None, y.get(key) is not None, True, "required converted scalar absent")
                else:
                    c.handoff(path + "/" + phase + "/" + key, phase + "." + key, x[key], y[key])
            else:
                c.need(x[key] is None and y[key] is None, "Preconversion scalars remain unavailable")


def compare_models(native, rust, request, c):
    c.need(len(native["model_cases"]) == len(rust["model_cases"]) == len(request["model_cases"]) == 15, "Ordered fixed15 ledger required")
    ledgers = []
    for expected, left, right in zip(request["model_cases"], native["model_cases"], rust["model_cases"]):
        path = expected["id"]
        c.exact(path + "/Native/id", expected["id"], left["id"]); c.exact(path + "/Rust/id", expected["id"], right["id"])
        c.exact(path + "/Native/input", expected["input"], left["actual_input"]); c.exact(path + "/Rust/input", expected["input"], right["input"])
        typed, selected = right["typed_owners"], right["selected_CTF01_owners"]
        ready = right["conversion_available"] is True and right["initialization"]["status"] == "source-returned" and isinstance(typed, dict) and isinstance(selected, dict) and selected.get("owner_available") is True
        if not left["loader_ready"] or not ready:
            c.absence(path, left["loader_ready"], ready, True, "actual loader/initializer owner unavailable; no semantic rejection or fabricated phase inferred")
            continue
        state = left["initialized_owners"]["snapshot"]
        c.need(left["initialized_owners"]["available"] is True and isinstance(state, dict), "Genuine Native initialized owner snapshot required")
        required_exact(c, path + "/actual_timestep_steps", state["TimeStepsInHour"], typed.get("actual_timestep_number_of_timesteps_per_hour"))
        nmat, rmat = owners(state["materials"], "Name", c), owners(typed["materials"], "name", c)
        c.exact(path + "/material_registration_order", list(nmat), list(rmat))
        c.exact(path + "/material_count", len(nmat), len(rmat))
        for name, n in nmat.items():
            r = rmat.get(name)
            if r is None:
                c.absence(path + "/material/" + name, True, False, True, "required actual typed material absent"); continue
            c.need(type(n["Num"]) is int and type(r["id"]) is int, "Actual typed material IDs required")
            c.exact(path + "/material/" + name + "/ID_offset", n["Num"], r["id"] + 1)
            c.exact(path + "/material/" + name + "/Native_array", n["Num"], n["array_index"])
            c.exact(path + "/material/" + name + "/Rust_array", r["id"], r["model_vector_index"])
            payload = r["payload"]; c.need(payload["kind"] in ["Regular", "NoMass"], "Fixed selected material family required")
            c.exact(path + "/material/" + name + "/Native_group", 0, n["group"])
            required_exact(c, path + "/material/" + name + "/ROnly_mapping", n["ROnly"], payload.get("actual_selected_ROnly_mapping"))
            stored = payload["stored_Resistance"]
            if stored.get("owner_available") is not True:
                c.absence(path + "/material/" + name + "/Resistance", True, False, True, "required actual stored Resistance owner unavailable")
            else:
                copied_scalar(c, path + "/material/" + name + "/Resistance", n["Resistance"], stored.get("value"))
            if payload["kind"] == "Regular":
                for key in ["Thickness", "Conductivity", "Density", "SpecHeat"]:
                    copied_scalar(c, path + "/material/" + name + "/" + key, n[key], payload["fields"].get(key))
            else:
                c.absence(path + "/material/" + name + "/regular_members", True, False, False, "NoMass typed owner stores R only; Native default members remain unpaired, actual initialized phases are paired")
        ncon, rcon = owners(state["constructions"], "Name", c), owners(typed["constructions"], "name", c)
        c.exact(path + "/construction_registration_order", list(ncon), list(rcon)); c.exact(path + "/construction_count", len(ncon), len(rcon))
        nmaterial_names = {row["Num"]: normalized(row["Name"], c) for row in state["materials"]}
        rmaterial_names = {row["id"]: row["name"] for row in typed["materials"]}
        rconstruction_names = {row["id"]: row["name"] for row in typed["constructions"]}
        nconstruction_names = {row["array_index"]: normalized(row["Name"], c) for row in state["constructions"]}
        c.need(len(nmaterial_names) == len(nmat) and len(rmaterial_names) == len(rmat) and len(nconstruction_names) == len(ncon) and len(rconstruction_names) == len(rcon), "Actual owner IDs must be unique")
        for name, n in ncon.items():
            r = rcon.get(name)
            if r is None:
                c.absence(path + "/construction/" + name, True, False, True, "required typed construction absent"); continue
            c.need(type(r["id"]) is int and r["id"] >= 0, "Actual typed construction ID required")
            c.exact(path + "/construction/" + name + "/ID_offset", n["array_index"], r["id"] + 1)
            c.exact(path + "/construction/" + name + "/Rust_array", r["id"], r["model_vector_index"])
            c.need(type(n["SolutionDimensions"]) is int and n["SolutionDimensions"] == 1 and n["SourceSinkPresent"] is False, "Selected actual one-dimensional/no-source construction scope required")
            c.exact(path + "/construction/" + name + "/source_declaration", n["SourceSinkPresent"], r["internal_heat_source_declaration"] != "None")
            c.exact(path + "/construction/" + name + "/TotLayers", n["TotLayers"], len(r["effective_layer_ids"]))
            c.exact(path + "/construction/" + name + "/LayerPoint_names", [nmaterial_names[x] for x in n["LayerPoint_active"]],
                    [rmaterial_names[x] for x in r["effective_layer_ids"]])
            c.exact(path + "/construction/" + name + "/LayerPoint_ID_offset", n["LayerPoint_active"], [x + 1 for x in r["effective_layer_ids"]])
        nsurf, rsurf = owners(state["allocated_surface_owner_rows"], "Name", c), owners(typed["surfaces"], "name", c)
        c.exact(path + "/surface_registration_order", list(nsurf), list(rsurf)); c.exact(path + "/surface_count", len(nsurf), len(rsurf))
        for name, n in nsurf.items():
            r = rsurf.get(name)
            if r is None:
                c.absence(path + "/surface/" + name, True, False, True, "required actual typed surface absent"); continue
            c.need(type(r["id"]) is int and r["id"] >= 0, "Actual typed surface ID required")
            c.exact(path + "/surface/" + name + "/construction", nconstruction_names[n["Construction"]], rconstruction_names[r["construction_id"]])
            c.exact(path + "/surface/" + name + "/ID_offset", n["array_index"], r["id"] + 1)
        actual = selected["construction_preprocessing"]; c.need(isinstance(actual, list), "Actual initialized preprocessing vector required")
        rresults = {row["construction_id"]: row for row in actual}; c.need(len(rresults) == len(actual), "No duplicate actual construction preprocessing owner")
        c.exact(path + "/preprocessing_owner_order", [rcon[name]["id"] for name in ncon if name in rcon], [row["construction_id"] for row in actual])
        c.need(len(left["operations"]) == left["actual_Construct_array_size"] == len(ncon), "Dynamic actual Construct call ledger required")
        for n in left["operations"]:
            name = normalized(n["actual_construction_Name"], c); r = rcon.get(name); item = rresults.get(r["id"]) if r else None
            op = path + "/construction/" + name
            if n["actual_source_invoked"] is not True or item is None:
                c.absence(op + "/invocation_owner", n["actual_source_invoked"] is True, item is not None, True, "actual Native whole invocation or initialized Rust result unavailable"); continue
            c.exact(op + "/actual_call_identity", ncon[name]["array_index"], n["actual_construction_index"])
            required_exact(c, op + "/surface_derived_use_correspondence", ncon[name]["IsUsedCTF"], item.get("actual_Rust_surface_derived_is_used_ctf"))
            result = item["result"]
            if result["status"] != "source-returned" or result.get("observations") is None:
                c.absence(op + "/Rust_selected_owner", n["observations"] is not None, False, True, "actual Rust scope/error return has no selected observations"); continue
            if n.get("observations") is None:
                c.absence(op + "/preprocessing_handoff", False, True, False,
                          "actual Native whole-call stop leaves checkpoints unknown/noPASS")
                continue
            phases(c, op, n["observations"], result["observations"])
        ledgers.append({"model_id": path, "Native_material_ids": [{"Num": row["Num"], "Name": row["Name"]} for row in state["materials"]],
            "Rust_material_ids": [{"id": row["id"], "name": row["name"]} for row in typed["materials"]],
            "Native_constructions": state["constructions"], "Rust_constructions": typed["constructions"],
            "Native_surface_associations": [{"array_index": row["array_index"], "Name": row["Name"], "Construction": row["Construction"]} for row in state["allocated_surface_owner_rows"]],
            "Rust_surface_associations": typed["surfaces"], "actual_initialized_preprocessing_owner_count": len(actual),
            "Native_whole_outcomes_context_only": [{"index": row["actual_construction_index"], "actual_source_invoked": row["actual_source_invoked"], "call_outcome": row["call_outcome"]} for row in left["operations"]]})
    return ledgers


def preprocessing_selection(result, c):
    if not isinstance(result, dict) or result.get("status") != "source-returned":
        return None
    if result.get("skipped_unused") is True or result.get("selected_ErrorsFound") is True:
        return False
    phases = result.get("observations")
    converted = phases.get("PostConversion") if isinstance(phases, dict) else None
    if not isinstance(converted, dict) or converted.get("available") is not True:
        return None
    owner = converted.get("snapshot")
    c.need(isinstance(owner, dict) and type(owner.get("LayersInConstruct")) is int and
           type(owner.get("NumResLayers")) is int, "Actual converted selection operands required")
    return not owner["LayersInConstruct"] > owner["NumResLayers"]


def public_storage(c, path, native, rust, preprocessing, caller=None):
    c.need(isinstance(native, dict) and native.get("protocol") == "ctf02-postreturn-regular-storage.v1" and
           type(native.get("public_owner_available")) is bool and type(native.get("selected_all_resistive_operands")) is bool,
           "Actual Native public availability/selection ledger required")
    selected = preprocessing_selection(preprocessing, c)
    native_selected = native["selected_all_resistive_operands"]
    rust_available = isinstance(rust, dict) and rust.get("owner_available") is True
    if isinstance(rust, dict):
        c.need(type(rust.get("owner_available")) is bool and type(rust.get("selected_all_resistive_operands")) is bool,
               "Actual Rust Result availability/selection required")
        c.exact(path + "/Rust/Result_selection", rust_available, rust["selected_all_resistive_operands"])
        if not rust_available:
            c.need(rust.get("snapshot") is None and rust.get("counted_as_PASS") is False,
                   "Unavailable Rust Result must retain null/noPASS")
    if selected is not None:
        c.exact(path + "/source_selection", native_selected, selected)
    required = native_selected or selected is True
    native_available = native["public_owner_available"] and native_selected and isinstance(native.get("snapshot"), dict)
    if not required:
        c.absence(path, False, False, False,
                  "actual unselected/unreached/whole-call-stop storage is context or unknown, never numerical PASS")
        if rust_available:
            c.failure(path + "/unselected_Rust_owner", "selection_mismatches", native_selected, True)
        return False
    if not native_available or not rust_available or not isinstance(rust.get("snapshot"), dict):
        c.absence(path, native_available, rust_available, True, "required selected public owner missing on one or both sides")
        return False
    left, right = native["snapshot"], rust["snapshot"]
    for key in ["NumHistories", "NumCTFTerms"]:
        if left.get(key) is None or right.get(key) is None:
            c.absence(path + "/" + key, left.get(key) is not None, right.get(key) is not None, True, "required actual count owner absent")
        else:
            c.need(type(left[key]) is int and type(right[key]) is int, "Actual integer coefficient counts required")
            c.exact(path + "/" + key, left[key], right[key])
    for key in PUBLIC_VARIABLES:
        a, b = left.get(key), right.get(key)
        if a is None or b is None:
            c.absence(path + "/" + key, a is not None, b is not None, True, "required selected coefficient absent")
            continue
        if key in PUBLIC_VARIABLES[:4]:
            if not isinstance(a, list) or not isinstance(b, list) or len(a) != 19 or len(b) != 19:
                c.absence(path + "/" + key + "/shape", isinstance(a, list), isinstance(b, list), True, "both exact19 slots required")
                continue
            for index, (x, y) in enumerate(zip(a, b)):
                c.number(path + "/" + key + "/" + str(index), key, x, y)
        else:
            c.number(path + "/" + key, key, a, b)
    # Literal caller/copy transport only; no timestep division or coefficient evaluator.
    actual_caller, actual_step = left.get("actual_caller_TimeStepZone"), right.get("CTFTimeStep")
    if actual_caller is None or actual_step is None:
        c.absence(path + "/caller_copy", actual_caller is not None, actual_step is not None, True,
                  "required actual caller/timestep copy absent")
    else:
        c.dto(actual_caller); c.dto(actual_step)
        if caller is not None:
            c.dto(caller)
            c.exact(path + "/actual_caller_TimeStepZone/bits", actual_caller["value_bits"], caller["value_bits"])
        c.exact(path + "/caller_to_actual_CTFTimeStep/bits", actual_caller["value_bits"], actual_step["value_bits"])
    return True


def packet_policy(m, qa, request, policy, same, recorded, lane):
    prefix = "ctf02-" + ("production-" if lane == "production" else "")
    m.require(request["schema"] == prefix + "helper-cases.v1" and
              request["frozen_before_this_CTF02_helper_execution"] is True and
              request["expected_values_supplied"] is False and request["expected_exits_supplied"] is False and
              request["scientific_execution_performed"] is False, "Genuine input-only CTF02 request required")
    freeze, execution = m.load(qa["actual_packet_freeze"]), recorded(qa["actual_packet_freeze_execution"])
    m.require(freeze["schema"] == prefix + "frozen-packet.v1" and freeze["lane"] == lane and
              freeze["status"] == "frozen-inherited-input-and-fresh-CTF02-policy-before-helper" and

"""Root-invoked metadata closure using genuine results, quality and approved notes."""
from pathlib import Path
from datetime import datetime, timezone
import argparse
import hashlib
import importlib.util
import json
import re
import shutil

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[3]
COMMON_SHA = 'ab73475b464831fd93fff59e42b2244cba5ff1c7d0be5ba816cc06e90a4533c7'
GATES = ['scope_review', 'unit_gate', 'integration_gate', 'production_gate']
PASS, PENDING = '\uD1B5\uACFC', '\uBBF8\uD655\uC778'


def load_common():
    path = HERE / 'common.py'
    if hashlib.sha256(path.read_bytes()).hexdigest() != COMMON_SHA:
        raise ValueError('Authenticated metadata-only utility required')
    spec = importlib.util.spec_from_file_location('clk05_closure_common', path)
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    return module


v = load_common()


def dump(path, value):
    with path.open('x', encoding='utf8', newline='\n') as stream:
        json.dump(value, stream, ensure_ascii=False, indent=2, allow_nan=False); stream.write('\n')


def scientific(role, schema, status, count, checked, pins):
    receipt_role = {'unit-comparison': 'unit-execution', 'production-comparison': 'production-execution'}[role]
    value = v.read(checked.check(pins[role])); command, _, finish = v.record(pins[receipt_role], checked, payload=value)
    comparison = value['comparison']
    v.need(value['schema'] == schema and value['status'] == status and value['numerical_PASS_claimed'] is True
        and type(comparison['comparison_count']) is int and comparison['comparison_count'] == count
        and type(comparison['mismatch_count']) is int and comparison['mismatch_count'] == 0
        and comparison['mismatches'] == [] and comparison['mismatch_payloads_truncated'] is False
        and value['unavailable_counted_as_PASS'] is False and value['gates_updated'] is False,
        'Authentic positive selected result0 with complete zero-mismatch ledger required')
    return value, command, finish


def preserved_failures(rows, checked):
    required = {'unit-report', 'unit-execution', 'workspace-execution', 'production-report', 'production-execution',
        'plan-execution', 'wrong-package-CLI-freeze-execution', 'production-result-QA-execution'}
    v.need(required <= set(rows) <= required | {'final-clippy-execution'},
        'Exact actual preserved failure inventory required; no absent report placeholder')
    for role, count, schema in [('unit', 198, 'clk05-candidate-comparison.v1'),
        ('production', 954, 'clk05-production-comparison.v1')]:
        value = v.read(checked.check(rows[role + '-report']))
        v.record(rows[role + '-execution'], checked, code=1, payload=value)
        v.need(value['schema'] == schema and value['numerical_PASS_claimed'] is False
            and value['comparison']['mismatch_count'] == count,
            'Historical actual selected mismatch ledger must remain failure1')
    for role, code in [('workspace-execution', 101), ('plan-execution', 1),
        ('wrong-package-CLI-freeze-execution', 1), ('production-result-QA-execution', 1)]:
        v.record(rows[role], checked, code=code)
    if 'final-clippy-execution' in rows: v.record(rows['final-clippy-execution'], checked, code=101)


def archive_guard(args, checked, pins):
    path = args.archive.resolve(strict=True); directory = path.parent; reference = v.ref(path)
    value = v.read(checked.check(reference))
    v.need(directory == ROOT / 'energyplus_porting_plan/evidence/CLK-05-archive'
        and value['schema'] == 'clk05-selected-byte-evidence-archive.v1'
        and value['exact_decompressed_bytes_verified'] is True
        and value['original_bytes_rewritten_or_JSON_reserialized'] is False
        and value['native_binary_or_full_native_trace_copied'] is False and value['duplicate_stdout_copied'] is False
        and value['gates_updated'] is False, 'Copied exact-byte bounded canonical archive required')
    execution = v.ref(args.archive_execution.resolve(strict=True)); row, _, finish = v.record(execution, checked)
    actual = v.read(checked.check(row['stdout'])); original = checked.check(actual['archive'])
    v.need(actual['archive']['sha256'] == reference['sha256'] and actual['canonical_files_changed'] is False
        and actual['scientific_execution_performed'] is False, 'Actual ignored byte-archive0 differs')
    verification = v.ref(args.archive_verification_execution.resolve(strict=True))
    verify, start, _ = v.record(verification, checked); result = v.read(checked.check(verify['stdout']))
    v.need(result['schema'] == 'clk05-byte-archive-verification.v1' and result['exact_original_bytes_restored'] is True
        and result['files_written'] is False and result['scientific_operands_parsed_or_compared'] is False
        and start >= finish and verify['command'][-2] == '--manifest'
        and v.path_of(verify['command'][-1]) == original, 'Actual independent byte-reassembly check0 required')
    archived = {row['role']: row for row in value['rows'] if 'role' in row}
    for role in ['unit-comparison', 'unit-result-review', 'production-comparison', 'production-result-review',
        'legacy-gap', 'preserved-failed-unit-comparison', 'preserved-failed-production-comparison']:
        v.need(role in archived and v.same(archived[role]['binding'], pins[role]), 'Required archived original record differs')
    for row in value['rows']:
        for part in row['storage']['parts']:
            item = (directory / part['relative_path']).resolve(strict=True)
            v.need(item.is_relative_to(directory) and item.stat().st_size == part['size_bytes'] <= 4_000_000,
                'Copied archive part containment/size differs')
            checked.check({'path': item.relative_to(ROOT).as_posix(), 'sha256': part['sha256']})
    return reference, execution, verification


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['bindings', 'source-mapping', 'card-notes', 'quality-lineage', 'quality-lineage-execution',
        'archive', 'archive-execution', 'archive-verification-execution', 'output-dir']:
        parser.add_argument('--' + name, required=True, type=Path)
    parser.add_argument('--bindings-sha256', required=True)
    parser.add_argument('--approved-source-sha256', required=True)
    args = parser.parse_args(); own = Path(__file__).read_bytes()
    v.need(Path.cwd().resolve() == ROOT and hashlib.sha256(own).hexdigest() == args.approved_source_sha256,
        'Root-reviewed exact writer and repository cwd required')
    checked = v.Bindings(); checked.check(v.ref(Path(__file__).resolve())); checked.check(v.ref(HERE / 'common.py'))
    bindings_ref = v.ref(args.bindings.resolve(strict=True))
    v.need(bindings_ref['sha256'] == args.bindings_sha256, 'Root-reviewed binding document differs')
    bound = v.read(checked.check(bindings_ref))
    v.need(bound['schema'] == 'clk05-card-closure-bindings.v1' and bound['ready_to_close'] is True
        and bound['pending_refs'] == [] and bound['canonical_gate_writes_authorized'] is True,
        'Pending evidence cannot authorize canonical closure')
    pins = bound['artifacts']; out = args.output_dir.resolve()
    v.need(out != ROOT / '.runtime/porting/CLK-05' and out.is_relative_to(ROOT / '.runtime/porting/CLK-05')
        and not out.exists(), 'Fresh ignored closure output required')
    for name, operand in [('source-mapping', args.source_mapping), ('card-notes', args.card_notes)]:
        v.need(v.same(v.ref(operand.resolve(strict=True)), pins[name]), 'Approved source mapping/narrative differs')
    mapping = v.read(checked.check(pins['source-mapping']))
    notes = checked.check(pins['card-notes']).read_text(encoding='utf8')
    v.need(mapping['schema'] == 'clk05-completion-source-mapping.v1' and mapping['source_ranges']
        and type(notes) is str and bool(notes.strip()), 'Root-authored exact mapping and UTF8 notes required')
    unit, unit_cmd, _ = scientific('unit-comparison', 'clk05-candidate-comparison.v1',
        'pass-selected-solar-storage-and-source-history', 888227, checked, pins)
    prod, prod_cmd, _ = scientific('production-comparison', 'clk05-production-comparison.v1',
        'pass-selected-solar-and-owned-production-transport', 3459134, checked, pins)
    v.need(unit['mode'] == 'candidate', 'Factual legacy completion0 cannot be promoted to unit PASS')
    unit_qa, _, unit_finish = v.review(pins['unit-result-review'], pins['unit-review-execution'],
        'clk05-independent-candidate-unit-result-review.v1',
        'pass-authenticated-selected-unit-result-and-honest-unavailable-scope', checked)
    prod_qa, _, prod_finish = v.review(pins['production-result-review'], pins['production-review-execution'],
        'clk05-independent-production-result-review.v1',
        'pass-authenticated-selected-production-result-and-honest-unavailable-scope', checked)
    for qa, role, execution_role in [(unit_qa, 'unit-comparison', 'unit-execution'),
        (prod_qa, 'production-comparison', 'production-execution')]:
        v.need(v.same(qa['reviewed_report'], pins[role]) and v.same(qa['comparison_execution'], pins[execution_role])
            and qa['scientific_execution_performed'] is False and qa['unavailable_counted_as_PASS'] is False,
            'Actual independent result review0 must bind the genuine report/receipt')
    science = prod['implementation_commit']
    v.need(science == unit_qa['actual_implementation_commit'] == prod_qa['actual_implementation_commit']
        and unit_qa['actual_crates_tree'] == prod_qa['actual_crates_tree']
        and prod_qa['actual_original_calls_paired'] == 483 and prod_qa['actual_Current_calls_observed'] == 480
        and prod_qa['supplemental_schedule_metadata_operands'] == 966, 'Same actual science source and selected call histories required')
    route = prod['supplemental_day_of_year_schedule']
    v.need(v.exact(route, prod_qa['supplemental_day_of_year_schedule'])
        and route['paired_fieldset'] == ['environment.DayOfYear_Schedule']
        and route['all_other_selected_operands_card'] == 'CLK-05'
        and route['new_Current_comparisons_performed'] is False, 'Sole authenticated historical schedule route required')
    lineage_ref, lineage_exec = v.ref(args.quality_lineage.resolve(strict=True)), v.ref(args.quality_lineage_execution.resolve(strict=True))
    v.need(v.same(lineage_ref, pins['quality-lineage']) and v.same(lineage_exec, pins['quality-lineage-execution']),
        'Actual final lineage differs from approved bindings')
    lineage, _, lineage_finish = v.review(lineage_ref, lineage_exec, 'clk05-final-quality-source-lineage.v1',
        'pass-exact-observer-only-source-lineage-and-actual-quality', checked)
    v.need(lineage_finish >= max(unit_finish, prod_finish)
        and lineage['engines_Cargo_tests_comparisons_Git_executed_by_verifier'] is False
        and lineage['scientific_values_compared_or_PARITY_extended'] is False
        and v.same(lineage['reviewed_scientific_build'], prod['Rust_build']), 'Final actual quality lineage must follow authentic result QA')
    allowed = lineage['permitted_formatted_observer_paths']; changed = lineage['exact_changed_observer_paths']
    v.need(type(allowed) is list and len(allowed) == len(set(allowed)) == 10 and type(changed) is list
        and len(changed) == len(set(changed)) and set(changed) <= set(allowed), 'Only declared passive formatting changes admitted')
    tests_changed = lineage['test_only_changed_paths']
    v.need(tests_changed == ['crates/ep_runtime/src/weather_day/producer_tests.rs']
        and set(lineage['exact_changed_source_paths']) == set(changed) | set(tests_changed)
        and lineage['production_math_and_Cargo_bytes_unchanged'] is True
        and v.same(lineage['preserved_failed_clippy'], bound['preserved_failures']['final-clippy-execution']),
        'Only independently reviewed cfg(test) Copy cleanup may accompany the ten passive observers')
    for key in ['reviewed_test_cleanup', 'independent_test_cleanup_review', 'actual_test_formatting_execution',
        'reviewed_final_quality_scope_plan']: checked.check(lineage[key])
    quality = lineage['actual_final_quality']; names = {'workspace_tests', 'clippy', 'format_check', 'source_quality', 'structure_quality'}
    v.need(set(quality) == names, 'All five actual final quality checks required')
    final = None; final_snapshot = None
    for item in quality.values():
        row, _, _ = v.record(item['receipt'], checked)
        head = row['repository_before']['head']; snapshot = row['source_snapshot']
        v.need(re.fullmatch(r'[0-9a-f]{40}', head) and row['repository_after']['head'] == head
            and row['repository_before']['worktree_clean'] is True and row['repository_after']['worktree_clean'] is True,
            'Every actual final quality check requires the same clean committed source')
        if final is None: final, final_snapshot = head, snapshot
        v.need(head == final and v.same(snapshot, final_snapshot), 'Final quality HEAD/source snapshot differs')
    tests = quality['workspace_tests']['actual_test_counts']
    v.need(set(tests) == {'groups', 'passed', 'failed', 'ignored'} and all(type(value) is int for value in tests.values())
        and tests['groups'] > 0 and tests['passed'] > 0 and tests['failed'] == tests['ignored'] == 0,
        'Actual complete workspace test counts required; future counts cannot be assumed')
    data, _, _ = v.review(pins['original-data-review'], pins['original-data-review-execution'],
        'clk05-independent-original-data-review.v1', 'pass-preserved-original-data-before-Rust-baseline', checked)
    v.need(data['actual_operation_invocations'] == 589 and data['actual_operations_skipped'] == 0
        and data['intended_native_branch_coverage_complete'] is True and data['numerical_PASS_claimed'] is False,
        'Authentic Original589 whole-call coverage before candidate required')
    gap = v.read(checked.check(pins['legacy-gap'])); v.record(pins['legacy-gap-execution'], checked, payload=gap)
    v.need(gap['schema'] == 'clk05-existing-baseline-gap.v1'
        and gap['status'] == 'observed-authenticated-existing-solar-differences-and-unavailable-source-scope'
        and gap['numerical_PASS_claimed'] is False and gap['unavailable_counted_as_PASS'] is False,
        'Actual existing differences remain factual completion, not numerical PASS')
    archive, archive_exec, archive_verify = archive_guard(args, checked, pins)
    cases = v.read(checked.check(pins['frozen-cases'])); admission = v.read(checked.check(pins['frozen-native-admission']))
    v.need(v.same(admission['helper_request'], pins['frozen-helper-request'])
        and len(admission['all_45_guard_refs']) == 45 and v.exact(cases['all_45_guard_refs'], admission['all_45_guard_refs']),
        'Unchanged frozen six-packet and all45 CON references required')
    inputs = [pins['frozen-helper-request'], *admission['all_45_guard_refs']]
    for row in inputs: checked.check(row)
    build = v.read(checked.check(prod['Rust_build'])); snapshot = v.read(checked.check(build['source_snapshot']))
    inventory = {row['historical_path']: row['archive'] for row in snapshot['files']}; granularity = []
    for owner in mapping['granularity_source_paths']:
        archive_source = inventory[owner]; payload = checked.check(archive_source).read_bytes()
        lines = len(payload.splitlines())
        granularity.append({'path': owner, 'line_count': lines, 'source_archive': archive_source})
    plan_path = ROOT / 'energyplus_porting_plan/plan.json'; card_path = ROOT / 'energyplus_porting_plan/cards/CLK-05.md'
    evidence_path = ROOT / 'energyplus_porting_plan/evidence/CLK-05.json'; before = [v.ref(plan_path), v.ref(card_path)]
    v.need(v.same(before[0], bound['before']['plan']) and v.same(before[1], bound['before']['card']) and not evidence_path.exists(),
        'Exact still-unclosed plan/card and absent completion evidence required')
    plan = v.read(plan_path); tasks = plan['tasks']; matches = [row for row in tasks if row['id'] == 'CLK-05']
    v.need(len(tasks) == 64 and len(matches) == 1 and all(matches[0][key] == PENDING for key in GATES),
        'Only four pending CLK05 gates can close')
    for ident in ['CLK-03', 'CLK-04']:
        v.need(all(next(row for row in tasks if row['id'] == ident)[key] == PASS for key in GATES), 'Actual prior card gates required')
    other = json.loads(json.dumps([row for row in tasks if row['id'] != 'CLK-05'], ensure_ascii=False))
    card = card_path.read_text(encoding='utf8'); v.need(card.count('- [ ] ') == 4, 'Exactly four original card checks required')
    preserved = bound['preserved_failures']; preserved_failures(preserved, checked)
    checks = {key: {'command': ' '.join((unit_cmd if key in ['scope_review', 'unit_gate'] else prod_cmd)['command']),
        'commit': science, 'exit_code': 0, 'artifacts': [pins['unit-comparison'], pins['unit-result-review']]
        if key in ['scope_review', 'unit_gate'] else [pins['production-comparison'], pins['production-result-review'], lineage_ref]} for key in GATES}
    plan_evidence = {'scopes': ['A', 'B'], 'implementation_commit': science, 'source_ranges': mapping['source_ranges'],
        'input_hashes': inputs, 'reference': {'kind': 'cpp-wrapper', 'artifacts': [pins['original-reference'], pins['original-data-review']]},
        'checks': checks, 'production': {'rust_entrypoint': 'ep_cli -> live WeatherSession Today -> owned sample -> thermal solar operand',
            'oracle_inputs_used': False, 'fixture_inputs_used': False},
        'comparison': {'contract': pins['frozen-tolerances'], 'report': pins['unit-comparison']},
        'byte_faithful_archive': archive, 'final_quality_lineage': lineage_ref, 'final_quality_commit': final,
        'helper_granularity': granularity, 'supplemental_day_of_year_schedule': route}
    evidence = {'schema': 'clk05-card-completion-evidence.v1', 'card': 'CLK-05', 'scopes': ['A', 'B'],
        'scientific_implementation_commit': science, 'final_quality_commit': final,
        'unit': {'report': pins['unit-comparison'], 'execution': pins['unit-execution'],
            'review': pins['unit-result-review'], 'comparison_count': 888227, 'mismatch_count': 0},
        'production': {'report': pins['production-comparison'], 'execution': pins['production-execution'],
            'review': pins['production-result-review'], 'comparison_count': 3459134, 'mismatch_count': 0,
            'actual_CLI_commands': 6, 'actual_direct_original_calls': 483, 'unpaired_Rust_Current_calls': 480},
        'native': {'data_review': pins['original-data-review'], 'actual_whole_calls': 589, 'numerical_PASS_claimed_by_QC': False},
        'legacy_gap': pins['legacy-gap'], 'supplemental_day_of_year_schedule': route,
        'contracts': admission['contracts'], 'selected_observation_projection': pins['frozen-observation-projection'],
        'preserved_failures': preserved, 'historical_unknowns': bound['historical_unknowns'],
        'compressed_full_byte_archive': archive, 'archive_execution': archive_exec, 'archive_verification_execution': archive_verify,
        'quality_lineage': lineage_ref, 'quality_lineage_execution': lineage_exec, 'actual_final_quality': quality,
        'test_only_cleanup': lineage['reviewed_test_cleanup'], 'test_only_changed_paths': tests_changed,
        'helper_granularity': granularity, 'unavailable_counted_as_PASS': False, 'whole_physical_system_certified': False,
        'CurrentTime_SimTimeSteps_current_solar_night_SRC04_paired': False, 'native_index_invented': False,
        'scientific_values_recomputed_by_closure_writer': False,
        'authorship_limits': 'Baseline authored comparer/hourly/producer/native input work. Independent result/source QA and Root execution are distinct; this writer only authenticates and transcribes completed proofs.'}
    checked.unchanged(); out.mkdir(); copies = []
    for path in [Path(__file__).resolve(), HERE / 'common.py', args.bindings.resolve(), args.source_mapping.resolve(), args.card_notes.resolve()]:
        target = out / path.name; shutil.copyfile(path, target)
        copies.append({'historical_path': path.relative_to(ROOT).as_posix(), 'archive': v.ref(target)})
    dump(evidence_path, evidence); task = matches[0]
    for key in GATES: task[key] = PASS
    task['evidence'] = plan_evidence; task['completion_evidence'] = v.ref(evidence_path)
    task['note'] = 'Selected solar storage/history and live A/B owned transport passed; current/night/SRC04 physics remains unpaired.'
    v.need(v.exact(other, [row for row in tasks if row['id'] != 'CLK-05']), 'Other63 tasks changed')
    plan_path.write_text(json.dumps(plan, ensure_ascii=False, indent=2, allow_nan=False) + '\n', encoding='utf8', newline='\n')
    card_path.write_text(card.replace('- [ ] ', '- [x] ') + '\n\n' + notes, encoding='utf8', newline='\n')
    result = {'schema': 'clk05-metadata-card-closure.v1', 'completed_utc': datetime.now(timezone.utc).isoformat(),
        'before': before, 'previously_absent_evidence': evidence_path.relative_to(ROOT).as_posix(),
        'after': [v.ref(plan_path), v.ref(card_path), v.ref(evidence_path)], 'only_CLK05_gates_updated': True,
        'other_63_tasks_unchanged': True, 'all_four_actual_gates': PASS, 'executed_writer_sources': copies,
        'actual_quality_lineage': lineage_ref, 'actual_archive': archive, 'scientific_comparer_or_engine_Cargo_Git_executed': False,
        'HTML_or_other_views_synchronized': False, 'native_retirement_admitted_or_performed': False}
    checked.unchanged(); dump(out / 'closure-result.json', result); print(json.dumps(result, ensure_ascii=False, allow_nan=False))


if __name__ == '__main__': main()

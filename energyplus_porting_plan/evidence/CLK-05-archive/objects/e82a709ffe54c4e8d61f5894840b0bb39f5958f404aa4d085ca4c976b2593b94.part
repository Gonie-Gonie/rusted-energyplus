"""Review preserved genuine CLK05 Original data before any existing-Rust baseline."""
import argparse
from collections import Counter
import hashlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
for name,digest in {'metadata.py':'196c681a9b14d71b7acb22dbd0894d47fe1c65cc9284c8bb077609653271ad7d',
                    'shape.py':'201a60b84bff352acf2f1d8a1d0fa57ce622422ff8e764b36d9d735d70199fec'}.items():
    if hashlib.sha256((HERE/name).read_bytes()).hexdigest()!=digest:
        raise ValueError('Owned metadata source changed before import: '+name)
from metadata import ROOT, actual_review, check, exact, finish, instant, need, path, read, recorded, ref, save_sources, sources, utc
from shape import Shapes, CONTROL

PIN = '6f2e40d10250a105b49966baa24d843711e61048'
COUNTS = {'setup_cases':3,'weather_sequences':36,'GetNextEnvironment':36,
          'InitializeWeather':550,'weather_operations':586,'total_operations':589}


def identity(actual,expected):
    need(check(actual)==check(expected) and actual['sha256']==expected['sha256'],'Normalized path/SHA/optional size binding differs')


def ledger(item,kind,calls,statuses):
    invoked = item['actual_source_invoked']; outcome = item['call_outcome']; status = outcome['status']
    need(type(invoked) is bool and status in ['source_returned','source_fatal','not-invoked-after-prior-source-outcome']
         and invoked is (status!='not-invoked-after-prior-source-outcome')
         and outcome['source_fatal'] is (True if status=='source_fatal' else False if invoked else None),'Actual invocation/fatal/skip types differ')
    statuses[status] += 1
    if invoked: calls[kind] += 1
    return invoked,status


def original(args,started):
    reference_ref,outer_ref = ref(args.reference),ref(args.execution)
    value = read(reference_ref)
    need(value['schema']=='clk05-original-reference.v1' and value['energyplus_commit']==PIN
         and value['status']=='wrapper-complete-actual-source-outcomes-awaiting-independent-data-review'
         and type(value['actual_helper_exit_code']) is int and value['actual_helper_exit_code']==0
         and type(value['actual_launcher_exit_code']) is int and value['actual_launcher_exit_code']==0
         and value['preservation_checks_passed'] is True,'Actual successful preserved Original wrapper required')
    for flag in ['Rust_executed','Rust_compared','gates_updated','builds_or_Git_executed','source_expected_answers_supplied',
                 'expected_values_supplied','expected_exits_supplied','deletion_performed','full_linked_original_copied',
                 'whole_ground_water_current_solar_night_and_SRC04_physics_paired','prior_actual_failure_relabelled_PASS',
                 'scientific_certification_passed','numerical_PASS_claimed']:
        need(value[flag] is False,'Honest Original boundary differs: '+flag)
    outer = recorded(outer_ref,{'reference':reference_ref,'status':value['status'],
        'actual_helper_exit_code':0,'actual_launcher_exit_code':0},started)
    need(instant(outer['started_utc'])<=instant(value['started_utc'])<=instant(value['finished_utc'])
         <=instant(outer['finished_utc']),'Actual Original wrapper chronology differs')
    need(Path(value['actual_launcher_cwd']).resolve()==ROOT,'Actual Original cwd differs')
    identity(value['executed_launcher']['archive'],next(row['archive'] for row in value['executed_source_archives']
        if row['historical_path']==value['executed_launcher']['historical_path']))
    sources(value['executed_source_archives']); sources(value['input_archives'])
    build_ref = value['native_driver_build']; build = read(build_ref)
    need(build['schema']=='clk05-native-driver-build.v1' and build['checks_passed'] is True
         and build['source_commit']==PIN and build['target']=='clk05_reference_helper','Actual native C5 build required')
    recorded(value['actual_build_execution'],{'driver_build':build_ref,'checks_passed':True,'helper_binary':build['helper_binary']},value['started_utc'])
    peer = actual_review(value['independent_actual_build_review'],value['independent_actual_build_review_execution'],
        'clk05-independent-native-build-review.v1','pass-build-and-derivative-before-original-execution',value['started_utc'])
    need(exact(peer['reviewed_build'],build_ref) and exact(peer['actual_build_command'],value['actual_build_execution'])
         and exact(peer['reviewed_source_archives'],build['executed_source_archives']),'Actual independent build/PE review binding differs')
    check(peer['actual_independent_PE_validation'])
    contract = actual_review(build['independent_contract_review'],build['reviewed_source_executions']['contract_review'],
        'clk05-independent-frozen-contract-review.v1','pass-frozen-input-source-policy-before-native-build',build['started_utc'])
    for name,schema,status in [('helper_static_review','clk05-independent-preexecution-source-review.v1','pass-source-input-policy-before-freeze'),
                              ('builder_review','clk05-independent-native-builder-static-review.v1','pass-source-and-contract-before-native-build')]:
        actual_review(build['independent_'+name if name=='helper_static_review' else 'independent_builder_static_review'],
            build['reviewed_source_executions'][name],schema,status,build['started_utc'])
    launch = actual_review(value['independent_launcher_source_review'],value['independent_launcher_source_review_execution'],
        'clk05-independent-original-launcher-static-review.v1','pass-source-and-input-contract-before-original-execution',value['started_utc'])
    sources(launch['reviewed_sources']); need(exact(launch['reviewed_contract_review'],build['independent_contract_review']),'Launcher reviewed frozen contract differs')
    for a,b in [('actual_request','helper_request'),('native_admission_contract','native_admission_contract'),
                ('observation_projection','projection'),('executed_helper','helper_binary')]: identity(value[a],build[b])
    need(exact(value['contracts'],build['contracts']) and exact(contract['reviewed_contracts'],build['contracts']),'Actual frozen contract inventory differs')
    child = read(value['execution'])
    need(child['schema']=='clk05-original-native-command.v1' and type(child['exit_code']) is int and child['exit_code']==0
         and child['spawn_error'] is None and Path(child['cwd']).resolve()==ROOT,'Actual native child0 required')
    for a,b in [('binary','executed_helper'),('request','actual_request'),('native_admission_contract','native_admission_contract'),
                ('observation_projection','observation_projection'),('native_driver_build','native_driver_build')]: identity(child[a],value[b])
    check(child['stdout']); check(child['stderr'])
    result_path = check(value['results']); need(result_path==check(reference_ref).parent/'native-output/clk05-helper-results.json','Fresh genuine native output path differs')
    wanted = [value['executed_helper']['path'],str(ROOT),value['actual_request']['path'],value['native_admission_contract']['path'],str(result_path.parent)]
    need(type(child['command']) is list and len(child['command'])==5,'Actual argc5 required')
    for index,(got,want) in enumerate(zip(child['command'],wanted,strict=True)):
        need((Path(got).resolve()==ROOT if index==1 else path(got)==path(want)),'Actual native child argv identity differs')
    need(instant(outer['started_utc'])<=instant(child['started_utc'])<=instant(child['finished_utc'])<=instant(outer['finished_utc'])
         and instant(build['finished_utc'])<=instant(peer['review_started_utc'])<=instant(peer['review_completed_utc'])<=instant(child['started_utc']),
         'Actual build/PE/native child chronology differs')
    guards = value['preservation_observations']; need(set(guards)=={'before_execution','after_execution'},'Actual before/after successful preservation guards required')
    before,after = [guards[key] for key in ['before_execution','after_execution']]
    need(exact({key:item for key,item in before.items() if key!='observed_utc'},
               {key:item for key,item in after.items() if key!='observed_utc'}),'Before/after source/input/runtime guards differ')
    for observed in [before,after]:
        need(observed['protected_and_retained_count']==20 and observed['historical_compile_rows_checked']==658
             and observed['frozen_core_rows_checked']==643 and observed['runtime_publisher_bytes_unchanged'] is True
             and observed['archived_build_sources_unchanged'] is True and observed['retired_successful_originals_actual_absence_verified'] is True,
             'Actual recorded preservation scope differs')
    return reference_ref,outer_ref,value,build,child


def actual_context(reference,request,build):
    control = build['production_control_review']
    qa = actual_review(control['review'],control['execution'],'clk05-independent-production-control-input-review.v1',
        'pass-input-registration-and-captured-environment-before-original',reference['started_utc'])
    identity(qa['reviewed_control_inputs'],request['production_control_inputs']); capture = read(request['production_control_inputs'])
    env = reference['actual_child_environment_inputs']
    need(set(env)=={'IgnoreSolarRadiation','IgnoreBeamRadiation','IgnoreDiffuseRadiation'},'Exactly three external ENV inputs required')
    for item in env.values():
        need(type(item['present']) is bool and type(item['raw_value']) is str and (item['present'] or item['raw_value']==''),'Typed presence/raw ENV snapshot differs')
    for row in capture['cases']: need(exact(row['captured_environment_inputs'],env),'Actual launch ENV differs from frozen input capture')
    for owner in [reference,read(reference['execution'])]:
        for key in ['actual_parent_environment_before_child','actual_parent_environment_after_child','actual_child_input_environment_recaptured_after_child']:
            need(exact(owner[key],env),'Actual before/after launch context differs')
        need(owner['external_input_context_preserved_before_and_after_child'] is True
             and owner['terminated_native_process_internal_environment_observed'] is False,'External recapture/internal native availability differs')
    return control


def input_context(snapshot,input):
    need(exact(snapshot['clk05_observation']['solar_controls'],input['solar_controls']),'Declared four typed controls were not stored before source read')
    mapping = {'weather':'weather','missed_counts':'missed_counts','out_of_range_counts':'out_of_range_counts',
               'last_hour':'last_hour','next_hour':'next_hour'}
    for group,fields in input.get('caller_owned_seed',{}).items():
        for name,value in fields.items():
            stored = snapshot[mapping[group]][name]
            need(stored['value_bits']==value['bits'] if type(value) is dict else exact(stored,value),'Actual caller-owned seed transport differs')
    if 'stored_solar_interpolation_override' in input:
        need([row['value_bits'] for row in snapshot['SolarInterpolation']]==[row['bits'] for row in input['stored_solar_interpolation_override']],
             'Literal caller stored-array override transport differs')


def data(reference,build):
    request = read(reference['actual_request']); result = read(reference['results']); native = read(reference['native_admission_contract'])
    need(result['schema']=='clk05-helper-results.v1' and result['energyplus_commit']==PIN and result['complete'] is True,'Complete genuine C5 result required')
    need(exact(request['requested_counts'],COUNTS) and exact(native['requested_counts'],COUNTS)
         and exact(reference['requested_counts'],COUNTS) and exact(result['requested_counts'],COUNTS),'Frozen requested counts differ')
    for actual,expected in [('actual_request','actual_request'),('native_admission_contract','native_admission_contract'),
                            ('observation_projection','observation_projection'),('actual_binary','executed_helper')]: identity(result[actual],reference[expected])
    need(set(result['contracts'])==set(reference['contracts']),'Exact actual contract keys required')
    for name,binding in result['contracts'].items(): identity(binding,reference['contracts'][name])
    for flag in ['scientific_comparison_performed','expected_values_supplied','expected_exits_supplied','full_simulation_or_selected_scope_PASS_claimed',
                 'current_solar_night_physics_paired','native_internal_record_index_observed','gates_updated']: need(result[flag] is False,'Actual result scope differs: '+flag)
    shapes = Shapes(need,exact); calls,statuses = Counter(),Counter(); coverage = []
    need(len(result['setup_cases'])==len(request['setup_cases'])==3,'Actual three pure Setup rows required')
    for actual,supplied in zip(result['setup_cases'],request['setup_cases'],strict=True):
        need(actual['id']==supplied['id'] and actual['kind']=='SetupInterpolationValues' and exact(actual['requested_operation'],supplied),'Actual pure input identity/order differs')
        invoked,status = ledger(actual,'SetupInterpolationValues',calls,statuses); need(invoked and status=='source_returned','Genuine pure Setup did not return')
        for phase in ['before','after']: shapes.snapshot(actual[phase],supplied['time_steps_per_hour'])
        for name in ['Interpolation','SolarInterpolation']:
            need(actual['after'][name+'_allocated'] is True and len(actual['after'][name])==supplied['time_steps_per_hour'],'Pure Setup actual array storage unavailable')
        need(exact(actual['before']['weather']['TimeStepFraction'],actual['after']['weather']['TimeStepFraction']),
             'Pure Setup fraction descriptor must not be certified as an applied caller write')
    need(len(result['weather_sequences'])==len(request['weather_sequences'])==36,'Actual36 sequences required')
    for actual,supplied in zip(result['weather_sequences'],request['weather_sequences'],strict=True):
        need(actual['id']==supplied['id'] and actual['lane']==supplied['lane'] and len(actual['operations'])==len(supplied['operations']),'Actual sequence order/cardinality differs')
        identity(actual['input'],supplied['input']); identity(actual['weather_input'],supplied['weather'])
        for a,b in [('declared_run_period_input','run_period'),('declared_native_preparation','native_preparation'),('declared_solar_controls','solar_controls')]:
            need(exact(actual[a],supplied[b]),'Actual literal input declaration differs')
        steps = supplied['time_steps_per_hour']
        for phase in ['constructor','after_constant_initialization']: shapes.walk(actual[phase])
        for phase in ['actual_clk05_before_preparation','allocated_defaults','prepared','before_caller_context','after_caller_context','final_state']:
            shapes.snapshot(actual[phase],steps)
        prep = actual['preparation_calls']; need(len(prep)==8 and [row['kind'] for row in prep]==supplied['native_preparation']['genuine_calls'],'Genuine whole preparation8 order incomplete')
        for row in prep:
            need(row['call_outcome']['status']=='source_returned' and row['call_outcome']['source_fatal'] is False,'Genuine intended preparation did not return')
            for phase in ['before','after']: shapes.snapshot(row[phase],steps)
        need(actual['declared_caller_context_applied'] is True,'Actual caller context was not applied')
        input_context(actual['after_caller_context'],supplied)
        invoked_count = 0
        for got,want in zip(actual['operations'],supplied['operations'],strict=True):
            need(got['id']==want['id'] and got['kind']==want['kind'] and exact(got['requested_operation'],want),'Actual requested operation identity/order differs')
            incoming = got['before_caller']['global']; caller = want['caller']
            day,environment = caller.get('BeginDayFlag',incoming['BeginDayFlag']),caller.get('BeginEnvrnFlag',incoming['BeginEnvrnFlag'])
            need(type(day) is bool and type(environment) is bool,'Typed effective caller boundary required')
            full = want['kind']=='GetNextEnvironment' or (want['kind']=='InitializeWeather' and (day or environment))
            need(got['full_solar_grid_observation_declared'] is full,'Pre-output full/compact observation mask differs')
            for phase in ['before_caller','before','after']: shapes.snapshot(got[phase],steps,full)
            invoked,status = ledger(got,want['kind'],calls,statuses)
            need(invoked and status=='source_returned' and type(got['Available']) is bool and got['Available'] is True
                 and type(got['ErrorsFound']) is bool and got['ErrorsFound'] is False,'Intended genuine source history unavailable/fatal/errors')
            need(all(exact(got['before']['global'][key],value) for key,value in caller.items()),'Declared partial caller transport differs')
            if want['kind']=='GetNextEnvironment': need(got['returned_bool'] is True,'Intended sole ordinary RunPeriod not admitted')
            else: need(got['returned_bool'] is None,'Initialize returned bool fabricated')
            invoked_count += 1
        coverage.append({'sequence_id':actual['id'],'lane':actual['lane'],'requested_operations':len(supplied['operations']),
            'actual_returned_operations':invoked_count,'actual_preparation_returned':8,'caller_context_applied':True,'intended_branch_covered':True})
    fact = {'actual_operation_invocations':sum(calls.values()),'actual_operations_skipped':statuses['not-invoked-after-prior-source-outcome'],
            'actual_source_function_counts':dict(calls),'actual_source_status_counts':dict(statuses)}
    for name,value in fact.items():
        need(exact(result[name],value) and exact(reference['actual_source_outcomes'][name],value),'Actual source ledger transcription differs')
    need(exact(dict(calls),{'SetupInterpolationValues':3,'GetNextEnvironment':36,'InitializeWeather':550})
         and exact(dict(statuses),{'source_returned':589}),'Intended actual589 history not covered; Rust admission remains held')
    return request,fact,coverage,shapes


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for key in ['reference','execution','output-dir']: parser.add_argument('--'+key,required=True,type=Path)
    args = parser.parse_args(); need(Path.cwd().resolve()==ROOT,'Repository cwd required')
    started = utc(); out = path(args.output_dir)
    need(out.is_relative_to(ROOT/'.runtime/porting/CLK-05') and not out.exists(),'Fresh ignored data-review directory required')
    reference_ref,outer_ref,reference,build,child = original(args,started)
    request,fact,coverage,shapes = data(reference,build); control = actual_context(reference,request,build)
    own = [{'historical_path':ref(HERE/name)['path'],'archive':ref(HERE/name)} for name in ['metadata.py','shape.py','review_data.py']]
    out.mkdir(); report = {'schema':'clk05-independent-original-data-review.v1','status':'pass-preserved-original-data-before-Rust-baseline',
        'review_started_utc':started,'reviewed_reference':reference_ref,'reviewed_results':reference['results'],'reviewed_execution':outer_ref,
        'reviewed_native_execution':reference['execution'],'reviewed_request':reference['actual_request'],
        'reviewed_native_admission_contract':reference['native_admission_contract'],'reviewed_projection':reference['observation_projection'],
        'reviewed_contracts':reference['contracts'],'reviewed_build':reference['native_driver_build'],
        'reviewed_build_execution':reference['actual_build_execution'],'reviewed_build_review':reference['independent_actual_build_review'],
        'reviewed_build_review_execution':reference['independent_actual_build_review_execution'],'reviewed_contract_review':build['independent_contract_review'],
        'reviewed_control_review':control,'requested_counts':COUNTS,**fact,'intended_native_branch_coverage_complete':True,
        'intended_native_branch_coverage':coverage,'actual_typed_validation_visits':dict(shapes.counts),'actual_scalar_class_validation_visits':dict(shapes.classes),
        'actual_helper_exit_code':0,'actual_launcher_exit_code':0,'future_Rust_execution_or_comparison_performed':False,
        'source_unavailable_counted_as_PASS':False,'scientific_values_compared':False,'numerical_comparison_count':None,
        'numerical_mismatch_count':None,'numerical_PASS_claimed':False,'gates_updated':False,'scientific_execution_performed':False,
        'whole_original_inventory_rehashed_by_reader':False,'recorded_original_source_preservation_before_after_verified':True,
        'future_child_ENV_proved_by_prior_capture':False,'actual_launch_external_ENV_recapture_verified':True,
        'terminated_native_process_internal_ENV_observed':False,'source_array_paths':'native and existing Rust snapshot root arrays; actual consumed Clk03 snapshot178-179',
        'reviewed_reader_sources':save_sources(out,own),'verifier_author':'/root/clk02_raw_port',
        'authorship_limits':'Raw authored this factual QC reader and raw cursor/input/profile drafts. Other-source metadata and storage integrity are checked; own scientific implementation and generated solar values are not independently certified. Runtime executor is separately identified by actual recorder.',
        'scope_limits':'Solar-only grid observation, all19 counts/full17 caches and actual589 source histories retained. CurrentTime/SimTimeSteps/private weights/current solar/night and other whole physics remain unpaired.'}
    finish(out,report)


if __name__=='__main__': main()

"""Typed storage/availability validation only; no scientific expected values."""
from collections import Counter
import math
import struct

SOLAR = ['BeamSolarRad','DifSolarRad']
REALS = ['OutDryBulbTemp','OutDewPointTemp','OutBaroPress','OutRelHum','WindSpeed','WindDir','SkyTemp','HorizIRSky',
         'BeamSolarRad','DifSolarRad','Albedo','WaterPrecip','LiquidPrecip','TotalSkyCover','OpaqueSkyCover']
COUNTS = ['OutDryBulbTemp','OutDewPointTemp','OutRelHum','OutBaroPress','WindDir','WindSpeed','BeamSolarRad','DifSolarRad',
          'TotalSkyCover','OpaqueSkyCover','Visibility','Ceiling','LiquidPrecip','WaterPrecip','AerOptDepth','SnowDepth','DaysLastSnow','WeathCodes','Albedo']
DAY = ['DayOfYear','DayOfYear_Schedule','Year','Month','DayOfMonth','DayOfWeek','DaylightSavingIndex','HolidayIndex']
DAY_REALS = ['SinSolarDeclinAngle','CosSolarDeclinAngle','EquationOfTime']
CONTROL = ['DisplayWeatherMissingDataWarnings','IgnoreSolarRadiation','IgnoreBeamRadiation','IgnoreDiffuseRadiation']


class Shapes:
    def __init__(self,need,exact):
        self.need,self.exact = need,exact
        self.counts,self.classes = Counter(),Counter()

    def scalar(self,value):
        n = self.need
        n(type(value) is dict and set(value)=={'value','value_bits','value_class'},'Scalar DTO shape differs')
        bits = value['value_bits']; n(type(bits) is str and len(bits)==16 and all(c in '0123456789abcdef' for c in bits),'Scalar binary64 bits malformed')
        number = struct.unpack('>d',bytes.fromhex(bits))[0]
        kind = 'nan' if math.isnan(number) else ('positive_infinity' if number>0 else 'negative_infinity') if math.isinf(number) else (
            ('negative_zero' if bits[0]=='8' else 'positive_zero') if number==0.0 else 'finite')
        n(value['value_class']==kind,'Stored scalar class differs from actual stored bits')
        if math.isfinite(number):
            n(type(value['value']) in [int,float] and float(value['value']).hex()==number.hex(),'Scalar JSON value differs from its own bits')
        else: n(value['value'] is None,'Nonfinite scalar requires unavailable JSON numeric value')
        self.classes[kind] += 1; self.counts['scalar'] += 1

    def walk(self,value):
        if type(value) is dict:
            if 'value_bits' in value: self.scalar(value)
            else:
                for child in value.values(): self.walk(child)
        elif type(value) is list:
            for child in value: self.walk(child)

    def solar(self,value):
        self.need(type(value) is dict and set(value)==set(SOLAR),'Exactly two actual solar fields required')
        for scalar in value.values(): self.scalar(scalar)

    def grid(self,value,steps,full):
        n = self.need
        n(type(value['allocated']) is bool and type(value['time_steps']) is int and type(value['hours']) is int
          and value['ordering']=='hour-major,timestep-minor' and value['observed_fields']==SOLAR,'Actual solar grid shape differs')
        if value['allocated']: n(value['time_steps']==steps and value['hours']==24,'Allocated actual steps-by24 storage required')
        else: n(value['time_steps']==value['hours']==0,'Unallocated actual grid dimensions differ')
        n(value['contents_available'] is full,'Actual solar availability differs from declared projection')
        if full:
            rows = value['slots']; expected = [(hour,step) for hour in range(1,value['hours']+1) for step in range(1,value['time_steps']+1)]
            n(type(rows) is list and [(row['hour'],row['time_step']) for row in rows]==expected,'Actual solar slot cardinality/order differs')
            for row in rows:
                n(type(row['hour']) is int and type(row['time_step']) is int and set(row)=={'hour','time_step','value'},'Typed solar slot required')
                self.solar(row['value'])
        else:
            n(value['slots'] is None and value['unavailability_reason']=='pre-execution declared compact unselected solar grid','Unavailable solar contents fabricated')
        self.counts['full_grid' if full else 'compact_grid'] += 1

    def snapshot(self,value,steps,full=True):
        n = self.need
        n(value['full_solar_grid_contents_available'] is full and value['full_17_field_grid_generation_parity_claimed'] is False,'Projection/full-generation boundary differs')
        for key in ['today_values','tomorrow_values']: self.grid(value[key],steps,full)
        for key in ['missed_counts','out_of_range_counts']:
            n(type(value[key]) is dict and set(value[key])==set(COUNTS) and all(type(x) is int for x in value[key].values()),'All19 actual typed counts required')
        for key in ['last_hour','next_hour']:
            cache = value[key]; n(set(cache)==set(REALS+['IsRain','IsSnow']),'Complete17 actual cache fields required')
            for field in ['IsRain','IsSnow']: n(type(cache[field]) is bool,'Actual cache flag typing differs')
            for field in REALS: self.scalar(cache[field])
        for key in ['today_variables','tomorrow_variables']:
            day = value[key]; n(set(day)==set(DAY+DAY_REALS),'Complete11 actual daily fields required')
            for field in DAY: n(type(day[field]) is int,'Actual daily integer typing differs')
            for field in DAY_REALS: self.scalar(day[field])
        for field in ['Interpolation','SolarInterpolation']:
            allocated = value[field+'_allocated']; array = value[field]
            n(type(allocated) is bool and type(array) is list and (len(array)==steps if allocated else len(array)==0),'Actual root interpolation array allocation/shape differs')
            for scalar in array: self.scalar(scalar)
        observed = value['clk05_observation']; n(set(observed['solar_controls'])==set(CONTROL)
            and all(type(x) is bool for x in observed['solar_controls'].values()),'Actual four typed controls required')
        n(observed['private_hourly_or_weight_locals_observed'] is False and observed['current_solar_night_physics_paired'] is False,'Private/unpaired observation boundary differs')
        clock = observed['clock']; n(type(clock['MinutesInTimeStep']) is int and type(clock['SimTimeSteps']) is int,'Actual passive clock types differ')
        for field in ['TimeStepZoneSec','CurrentTime']: self.scalar(clock[field])
        selected = observed['selected_today_solar_slot']; hour,step = value['global']['HourOfDay'],value['global']['TimeStep']
        n(type(hour) is int and type(step) is int,'Actual selected slot clock types differ')
        grid = value['today_values']; available = grid['allocated'] and 1<=hour<=24 and 1<=step<=steps
        if available:
            n(type(selected) is dict and selected['hour']==hour and selected['time_step']==step,'Actual selected solar identity unavailable')
            self.solar(selected['value'])
            if full: n(self.exact(selected['value'],grid['slots'][(hour-1)*steps+step-1]['value']),'Duplicate selected owner observation differs')
        else: n(selected is None,'Unavailable selected slot fabricated')
        self.walk(value); self.counts['snapshot'] += 1

"""Compare actual binary64 operands with exactly five frozen field profiles."""
from collections import Counter
import math
import re
import struct


def require(ok, message):
    if not ok:
        raise ValueError(message)


def exact(a, b):
    if type(a) is not type(b):
        return False
    if type(a) is float:
        return struct.pack('>d', a) == struct.pack('>d', b)
    if type(a) is dict:
        return set(a) == set(b) and all(exact(a[k], b[k]) for k in a)
    if type(a) is list:
        return len(a) == len(b) and all(exact(x, y) for x, y in zip(a, b))
    return a == b


def unavailable(value):
    return value is None or (type(value) is dict and value.get('available') is False
        and value.get('value') is None and value.get('counted_as_PASS') is False)


def scalar(row, label):
    require(type(row) is dict and set(row) == {'value', 'value_bits', 'value_class'}, 'Actual scalar DTO required: ' + label)
    bits = row['value_bits']
    require(type(bits) is str and re.fullmatch('[0-9a-f]{16}', bits), 'Actual binary64 bits required: ' + label)
    value = struct.unpack('>d', bytes.fromhex(bits))[0]
    require(type(row['value']) is float and math.isfinite(value) and math.isfinite(row['value'])
        and struct.pack('>d', row['value']).hex() == bits, 'Finite actual value/bit identity differs: ' + label)
    kind = 'negative_zero' if bits == '8000000000000000' else 'positive_zero' if value == 0.0 else 'finite'
    require(row['value_class'] == kind, 'Actual IEEE classification differs: ' + label)
    return value, bits, kind


class Comparison:
    def __init__(self, tolerances):
        require(tolerances['schema'] == 'clk05-tolerances-contract.v1'
            and tolerances['missing_operand_counted_as_PASS'] is False and tolerances['generic_profile_fallback'] is False,
            'Frozen field-specific tolerance/availability policy required')
        self.rows = {row['field']: row for row in tolerances['rows']}
        require(len(self.rows) == len(tolerances['rows']) == 5 and set(self.rows) ==
            {'Interpolation', 'SolarInterpolation', 'BeamSolarRad', 'DifSolarRad', 'NextHour.LiquidPrecip'}, 'Exact five profiles required')
        for name, row in self.rows.items():
            require(type(row['atol']) is float and type(row['rtol']) is float and row['rtol'] == 0.0
                and row['atol'] == (1e-12 if name == 'NextHour.LiquidPrecip' else 0.0)
                and row['signed_zero_bits_exact'] is True, 'Frozen pre-output numeric profile differs')
        self.numeric_count = self.metadata_count = self.literal_count = self.mismatch_count = 0
        self.categories, self.metrics = Counter(), {}
        self.mismatches, self.unavailable_paths = [], []

    def mismatch(self, label, actual, original, reason):
        self.mismatch_count += 1
        if len(self.mismatches) < 1000:
            self.mismatches.append({'location': label, 'actual': actual, 'original': original, 'reason': reason})

    def excluded(self, label, reason, actual_available=False, original_available=True):
        self.unavailable_paths.append({'location': label, 'actual_available': actual_available,
            'original_available': original_available, 'reason': reason, 'required': False, 'counted_as_PASS': False})

    def availability(self, actual, original, label, required=True):
        left, right = unavailable(actual), unavailable(original)
        if not (left or right):
            return True
        self.excluded(label, 'actual comparison operand unavailable', not left, not right)
        self.unavailable_paths[-1]['required'] = required
        if left != right or required:
            self.mismatch(label + '/availability', not left, not right, 'required operand unavailable' if required else 'availability differs')
        return False

    def discrete(self, actual, original, label, required=True):
        if not self.availability(actual, original, label, required):
            return
        self.metadata_count += 1; self.categories['typed_metadata'] += 1
        if not exact(actual, original):
            self.mismatch(label, actual, original, 'typed exact metadata differs')

    def literal(self, actual, original, label, required=True):
        if not self.availability(actual, original, label, required):
            return
        a, b = scalar(actual, label + '/actual'), scalar(original, label + '/original')
        self.literal_count += 1; self.categories['literal_binary64'] += 1
        if a[1:] != b[1:]:
            self.mismatch(label, actual, original, 'binary64 bits/class differ')

    def numeric(self, actual, original, label, field):
        if not self.availability(actual, original, label):
            return
        row = self.rows[field]
        a, b = scalar(actual, label + '/actual'), scalar(original, label + '/original')
        self.numeric_count += 1; self.categories[field] += 1
        error = abs(a[0] - b[0])
        metric = self.metrics.setdefault(field, {'comparison_count': 0, 'mismatch_count': 0,
            'maximum_absolute_error': 0.0, 'sum_squared_error': 0.0})
        metric['comparison_count'] += 1
        metric['maximum_absolute_error'] = max(metric['maximum_absolute_error'], error)
        metric['sum_squared_error'] += error * error
        zero_exact = a[1] == b[1] if a[0] == b[0] == 0.0 else True
        if not (a[2] == b[2] and zero_exact and error <= row['atol'] + row['rtol'] * abs(b[0])):
            metric['mismatch_count'] += 1
            self.mismatch(label, actual, original, 'frozen tolerance/classification/signed-zero differs')

    def exact_value(self, actual, original, label, required=True):
        if not self.availability(actual, original, label, required):
            return
        if type(original) is dict and set(original) == {'value', 'value_bits', 'value_class'}:
            self.literal(actual, original, label, required)
        elif type(original) is dict:
            require(type(actual) is dict and set(actual) == set(original), 'Selected field inventory differs: ' + label)
            for key in original:
                self.exact_value(actual[key], original[key], label + '/' + key, required)
        elif type(original) is list:
            require(type(actual) is list, 'Actual ordered list required')
            self.discrete(len(actual), len(original), label + '/length')
            for index, (a, b) in enumerate(zip(actual, original)):
                self.exact_value(a, b, label + '/' + str(index), required)
        else:
            self.discrete(actual, original, label, required)

    def report(self):
        metrics = {}
        for field, row in self.metrics.items():
            metrics[field] = {k: v for k, v in row.items() if k != 'sum_squared_error'}
            metrics[field]['RMSE'] = math.sqrt(row['sum_squared_error'] / row['comparison_count'])
        return {'numeric_comparison_count': self.numeric_count, 'literal_binary64_comparison_count': self.literal_count,
            'metadata_comparison_count': self.metadata_count, 'comparison_count': self.numeric_count + self.literal_count + self.metadata_count,
            'mismatch_count': self.mismatch_count, 'field_error_metrics': metrics, 'categories': dict(self.categories),
            'mismatches': self.mismatches, 'mismatch_payload_limit': 1000,
            'mismatch_payloads_truncated': self.mismatch_count > len(self.mismatches),
            'unavailable_paths': self.unavailable_paths, 'unavailable_counted_as_PASS': False}

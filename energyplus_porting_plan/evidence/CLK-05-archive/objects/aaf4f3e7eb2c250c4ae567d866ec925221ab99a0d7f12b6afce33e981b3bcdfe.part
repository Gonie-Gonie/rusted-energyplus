"""Ordered genuine calls and observed within-owner copies, never expected physics."""
from collections import Counter
from numeric import require, exact
from state import snapshot, continuity, ALL_WEATHER, SOLAR, GRID

COUNTS = {'setup_cases': 3, 'weather_sequences': 36, 'GetNextEnvironment': 36,
    'InitializeWeather': 550, 'weather_operations': 586, 'total_operations': 589}


def outcome(row, native):
    invoked = row['actual_source_invoked' if native else 'actual_rust_invoked']
    value = row['call_outcome']; require(type(invoked) is bool and type(value) is dict, 'Actual typed invocation/outcome required')
    status = value['status']
    skipped = 'not-invoked-after-prior-source-outcome' if native else 'not-invoked-after-prior-Rust-outcome'
    require(status in ['source_returned', 'source_fatal', skipped] + ([] if native else ['rust_admission_error']),
        'Observed status outside real native/Rust call domain')
    require(invoked is (status != skipped) and value['source_fatal'] is
        (None if status == skipped else status == 'source_fatal'), 'Actual invocation/fatal availability differs')
    if status == 'source_fatal':
        text = value['exception_message' if native else 'actual_rust_error']
        require(type(text) is str and bool(text), 'Actual source-fatal error availability required; text parity is unclaimed')
    return invoked, ('not_invoked' if not invoked else status)


def full(row, declared):
    g, caller = row['before_caller']['global'], declared['caller']
    day, env = caller.get('BeginDayFlag', g['BeginDayFlag']), caller.get('BeginEnvrnFlag', g['BeginEnvrnFlag'])
    require(type(day) is bool and type(env) is bool, 'Actual effective source boundary flags required')
    return declared['kind'] == 'GetNextEnvironment' or (declared['kind'] == 'InitializeWeather' and (day or env))


def caller_transport(check, row, declared, label):
    before, after = row['before_caller']['global'], row['before']['global']
    require(type(declared['caller']) is dict and set(declared['caller']) <= set(after), 'Literal supported caller keys required')
    for key, value in before.items():
        require(key in after, 'Caller lost an actual global owner field')
        expected = declared['caller'].get(key, value)
        if type(expected) is dict and set(expected) == {'bits'}:
            require(type(after[key]) is dict and after[key]['value_bits'] == expected['bits'], 'Literal binary64 caller input differs')
        else:
            check.exact_value(after[key], expected, label + '/caller/' + key)


def operation(check, actual, native, declared, label, mode):
    for row in [actual, native]:
        require(row['id'] == declared['id'] and row['kind'] == declared['kind']
            and exact(row['requested_operation'], declared), 'Complete actual call identity/input/order differs')
    a, b = outcome(actual, False), outcome(native, True)
    if not a[0] or not b[0]:
        check.availability(a if a[0] else None, b if b[0] else None, label + '/actual_call', False)
    else:
        check.discrete(list(a), list(b), label + '/actual_outcome')
    boundary = full(native, declared)
    require(full(actual, declared) is boundary and native['full_solar_grid_observation_declared'] is boundary
        and actual['full_solar_grid_observation_declared'] is boundary, 'Pre-output full/compact selection changed')
    for phase in ['before_caller', 'before', 'after']:
        snapshot(check, actual[phase], native[phase], label + '/' + phase, boundary, mode)
    for lane, row in [('Rust', actual), ('original', native)]:
        invoked = row['actual_rust_invoked' if lane == 'Rust' else 'actual_source_invoked']
        if invoked:
            caller_transport(check, row, declared, lane + '/' + label)
        if row['call_outcome']['status'] != 'source_returned':
            continue
        before, after = row['before'], row['after']
        if declared['kind'] == 'InitializeWeather':
            if before['global']['BeginDayFlag'] and not before['global']['BeginEnvrnFlag']:
                check.exact_value(after['today_variables'], before['tomorrow_variables'], lane + '/' + label + '/daily_full11_copy')
                for field in GRID + ['slots']:
                    check.exact_value(after['today_values'][field], before['tomorrow_values'][field], lane + '/' + label + '/solar2_grid_copy/' + field)
            elif before['global']['BeginDayFlag'] and before['global']['BeginEnvrnFlag']:
                check.excluded(lane + '/' + label + '/interior_first_read_handoff', 'Whole Initialize does not expose post-first-read/pre-handoff operand')
            for field in ALL_WEATHER:
                if field not in SOLAR + ['LiquidPrecip']:
                    check.exact_value(after['next_hour'][field], before['next_hour'][field], lane + '/' + label + '/next_hour_retained/' + field)
    for key in ['returned_bool', 'Available', 'ErrorsFound', 'print_environment_stamp_before', 'print_environment_stamp_after']:
        if key in native:
            require(key in actual, 'Actual real call result field absent: ' + key)
            check.discrete(actual[key], native[key], label + '/' + key, key != 'returned_bool')
    return a, b


def compare(check, native, rust, request, mode):
    require(native['schema'] == 'clk05-helper-results.v1' and rust['schema'] ==
        ('clk05-existing-probe-results.v1' if mode == 'legacy' else 'clk05-candidate-probe-results.v1'), 'Actual observer schemas differ')
    native_counts = native['requested_counts']
    counts, native_calls, actual_calls = Counter(), Counter(), Counter()
    native_status, actual_status = Counter(), Counter()
    invocations = {'native': 0, 'Rust': 0}; skips = {'native': 0, 'Rust': 0}
    require(type(native['setup_cases']) is list and type(rust['setup_cases']) is list
        and len(native['setup_cases']) == len(rust['setup_cases']) == len(request['setup_cases']), 'All3 actual Setup calls required')
    for index, (n, r, declared) in enumerate(zip(native['setup_cases'], rust['setup_cases'], request['setup_cases'], strict=True)):
        label = 'Setup/' + declared['id']
        for row in [n, r]:
            require(row['id'] == declared['id'] and row['kind'] == 'SetupInterpolationValues'
                and exact(row['requested_operation'], declared), 'Actual Setup identity/input/order differs')
        a, b = outcome(r, False), outcome(n, True)
        check.discrete(list(a), list(b), label + '/outcome')
        for phase in ['before', 'after']:
            snapshot(check, r[phase], n[phase], label + '/' + phase, True, mode, False)
        for lane, result, ledger, statuses in [('native', b, native_calls, native_status), ('Rust', a, actual_calls, actual_status)]:
            invocations[lane] += int(result[0]); skips[lane] += int(not result[0]); statuses[result[1]] += 1
            if result[0]: ledger['SetupInterpolationValues'] += 1
        counts['setup_cases'] += 1; counts['total_operations'] += 1
    require(type(native['weather_sequences']) is list and type(rust['weather_sequences']) is list
        and len(native['weather_sequences']) == len(rust['weather_sequences']) == len(request['weather_sequences']), 'All36 ordered weather sequences required')
    for n, r, declared in zip(native['weather_sequences'], rust['weather_sequences'], request['weather_sequences'], strict=True):
        label = declared['id']; counts['weather_sequences'] += 1
        for row in [n, r]:
            require(row['id'] == declared['id'] and row['lane'] == declared['lane']
                and exact(row['declared_native_preparation'], declared['native_preparation'])
                and exact(row['declared_run_period_input'], declared['run_period'])
                and exact(row['declared_solar_controls'], declared['solar_controls']), 'Literal sequence/control/preparation declarations differ')
        for phase in ['allocated_defaults', 'prepared']:
            snapshot(check, r[phase], n[phase], label + '/' + phase, True, mode, phase != 'allocated_defaults')
        for phase, actual_phase in [('before_caller_context', 'before_declared_caller_context'), ('after_caller_context', 'after_declared_caller_context')]:
            snapshot(check, r[actual_phase], n[phase], label + '/' + phase, True, mode)
        require(type(n['operations']) is list and type(r['operations']) is list
            and len(n['operations']) == len(r['operations']) == len(declared['operations']), 'Every requested call retained in order')
        previous_n, previous_r = n['after_caller_context'], r['after_declared_caller_context']
        for index, (n_op, r_op, op) in enumerate(zip(n['operations'], r['operations'], declared['operations'], strict=True)):
            op_label = label + '/operations/' + str(index)
            continuity(check, previous_n, n_op['before_caller'], 'original/' + op_label + '/adjacent')
            continuity(check, previous_r, r_op['before_caller'], 'Rust/' + op_label + '/adjacent')
            a, b = operation(check, r_op, n_op, op, op_label, mode)
            for lane, result, ledger, statuses in [('native', b, native_calls, native_status), ('Rust', a, actual_calls, actual_status)]:
                invocations[lane] += int(result[0]); skips[lane] += int(not result[0]); statuses[result[1]] += 1
                if result[0]: ledger[op['kind']] += 1
            counts[op['kind']] += 1; counts['weather_operations'] += 1; counts['total_operations'] += 1
            previous_n, previous_r = n_op['after'], r_op['after']
        continuity(check, previous_n, n['final_state'], 'original/' + label + '/final')
        continuity(check, previous_r, r['final_state'], 'Rust/' + label + '/final')
        snapshot(check, r['final_state'], n['final_state'], label + '/final_state', True, mode)
        for root_phase in ['constructor', 'after_constant_initialization', 'preparation_calls']:
            check.excluded(label + '/' + root_phase, 'Whole native Factory/constant/eight-call preparation is not the public Rust constructor phase')
    require(exact(dict(counts), COUNTS) and exact(native_counts, COUNTS) and exact(request['requested_counts'], COUNTS), 'Computed literal requested cardinality differs')
    check.discrete(rust['requested_counts'], native_counts, 'root/requested_counts')
    require(native['actual_operation_invocations'] == invocations['native'] and native['actual_operations_skipped'] == skips['native']
        and exact(native['actual_source_function_counts'], dict(native_calls))
        and exact(native['actual_source_status_counts'], dict(native_status)), 'Real native ledger differs from actual call rows')
    return {'requested_counts': dict(counts), 'actual_invocations': invocations, 'actual_skips': skips,
        'actual_native_function_counts': dict(native_calls), 'actual_Rust_API_counts': dict(actual_calls),
        'actual_native_status_counts': dict(native_status), 'actual_Rust_status_counts': dict(actual_status),
        'exception_text_parity_claimed': False, 'private_hourly_or_transient_weight_operands_reconstructed': False}

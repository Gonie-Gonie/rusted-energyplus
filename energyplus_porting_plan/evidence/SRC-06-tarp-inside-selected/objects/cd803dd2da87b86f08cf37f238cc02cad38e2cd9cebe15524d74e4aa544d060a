    same(inventory['reviewed_Source_preparation'], authority_refs['Native_preparation'])
    same(inventory['actual_build_execution'], authority_refs['actual_build'])
    provider_prep = load(approval['provider_collection_preparation'])
    need(provider_prep['schema'] == 'src06-tarp-inside-native-provider-collection-preparation.v1', 'actual reviewed collector preparation required')
    same(inventory['actual_evidence_collector'], approval['actual_evidence_collector'])
    same(approval['actual_evidence_collector'], provider_prep['own_sources'][0])
    historical = snapshot_members(inventory['Source_snapshot'], False)
    current = snapshot_members(execution_source, True)
    for value in (native, configure_prep, historical_provider_prep, provider_prep, inventory, approval):
        collect(value, historical)
    freeze, review = load(inventory['frozen_build_inputs']), load(inventory['configure_review'])
    need(freeze['schema'] == 'src06-tarp-inside-frozen-configure-inputs.v1' and review['schema'] == 'src06-tarp-inside-configure-dry-review.v1', 'actual frozen build and dry review required')
    same(review['frozen_build_inputs'], inventory['frozen_build_inputs']); same(freeze['Source_snapshot'], inventory['Source_snapshot'])
    same(freeze['reviewed_Source_preparation'], authority_refs['Native_preparation'])
    collect(freeze, historical); collect(review, historical)
    build = recorded(inventory['actual_build_execution'], inventory['Source_snapshot'])
    configure = recorded(review['configure_execution'], inventory['Source_snapshot'])
    dry = recorded(review['dry_execution'], inventory['Source_snapshot'])
    need(configure['command'] == freeze['actual_configure_command'] and build['command'] == inventory['actual_build_argv'], 'actual configure/build argv differs')
    expected = review['prospective_compile_command']
    need(expected == inventory['reviewed_prospective_build_argv'] and len(expected) == len(build['command']) == 6 and build['command'][1] == expected[1] == '-C', 'actual selected build command required')
    need((ROOT / build['command'][0]).resolve() == Path(expected[0]).resolve() and (ROOT / build['command'][2]).resolve() == Path(expected[2]).resolve() and build['command'][3:] == expected[3:] == ['-j1', '-v', 'src06_tarp_inside_helper'], 'actual build paths/options differ')
    need(dry['command'] == expected[:3] + ['-n'] + expected[3:] and configure['finished_utc'] <= dry['started_utc'] <= dry['finished_utc'] <= build['started_utc'], 'dry/build custody chronology differs')
    steps = [s for s in bind(build['stdout']).read_text(encoding='utf-8').splitlines() if re.match(r'^\[\d+/\d+\]', s)]
    need(len(steps) == 2 and steps == review['dry_steps'], 'full dry and actual compile/link steps differ')
    need(review['previous_compile_rows'] == 741 and review['current_compile_rows'] == 742 and review['exact_previous_rows_preserved'] is True and review['exact_prior_core_link_suffix_preserved'] is True, 'inherited graph/core link preservation differs')
    need(inventory['dry_and_actual_compile_link_commands_byte_exact'] is True and inventory['current_compile_graph_cache_and_core_preserved'] is True, 'provider preservation proof required')
    need(all(inventory[k] is False for k in ('helper_executed', 'numerical_results_read', 'production_math_changed', 'gates_updated')), 'pre-execution factual provider inventory required')
    for name, key in (('compile_commands.json', 'actual_graph_after'), ('CMakeCache.txt', 'actual_cache_after')):
        bind({'path': '.runtime/ep261-gcc13-o0/' + name, 'sha256': review[key]['sha256'], 'size_bytes': review[key]['size_bytes']})
    ninja_archive = full(bind(inventory['frozen_build_inputs']).parent / 'build.ninja.after')
    bind(ninja_archive); bind({'path': '.runtime/ep261-gcc13-o0/build.ninja', 'sha256': ninja_archive['sha256'], 'size_bytes': ninja_archive['size_bytes']})
    core = load(freeze['original_core_receipt']); collect(core, historical)
    need(core['checks_passed'] is True and core['scientific_source_patches'] is False, 'unchanged genuine Original core required')
    for key in ('actual_core_before', 'actual_core_after'):
        check = recorded(review[key], inventory['Source_snapshot'])
        need(check['command'][1:] == ['-X', 'utf8', '-B', 'tools/porting/build_original_reference.py', '--check'] and b'13534 byte-identical official blobs' in bind(check['stdout']).read_bytes(), 'full official Source/core check required')
    post_core = recorded(inventory['actual_post_build_core_execution'], inventory['Source_snapshot'])
    need(Path(post_core['command'][0]).resolve() == Path(sys.executable).resolve() and post_core['command'][1:] == ['-X', 'utf8', '-B', 'tools/porting/build_original_reference.py', '--check'], 'actual post-build official checker command required')
    need(b'13534 byte-identical official blobs' in bind(post_core['stdout']).read_bytes() and build['finished_utc'] <= post_core['started_utc'], 'full post-build official Source/core check and chronology required')
    binary, link_map, obj = (full(bind(inventory[k])) for k in ('actual_Native_binary', 'actual_full_link_map', 'actual_helper_object'))
    need(bind(binary) == EXTERNAL / 'src06_tarp_inside_helper.exe' and bind(link_map) == bind(binary).with_suffix('.map'), 'actual SRC06 output paths differ')
    object_path = Path(review['new_compile_row']['output'])

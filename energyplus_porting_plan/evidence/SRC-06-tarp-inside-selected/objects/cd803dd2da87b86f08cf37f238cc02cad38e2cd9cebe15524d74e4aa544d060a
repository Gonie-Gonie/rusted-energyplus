    need(bind(obj) == object_path.resolve(), 'actual selected helper object differs')
    providers = inventory['actual_address_bound_providers']
    need([v['symbol'] for v in providers] == SYMBOLS and len(inventory['actual_disassembly_executions']) == 2, 'both unique Natural and Detailed providers required')
    mapping = inventory['actual_PE']
    need(mapping['sha256'] == binary['sha256'] and mapping['size_bytes'] == binary['size_bytes'], 'actual full PE identity differs')
    with bind(binary).open('rb') as stream, mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ) as payload:
        for i, provider in enumerate(providers):
            need(provider['owning_text_section']['owner'] == 'Products/libenergypluslib.a(ConvectionCoefficients.cc.obj)' and provider['actual_addr2line_function'] == SYMBOLS[i] and provider['all_disassembled_rows_equal_actual_PE'] is True, 'genuine Original provider/PE bytes required')
            match = re.search(r'[/\\]ConvectionCoefficients\.cc:(\d+)(?: \(discriminator \d+\))?$', provider['actual_addr2line_location'])
            need(match is not None and (1907 <= int(match[1]) <= 1953 if i == 0 else 1955 <= int(match[1]) <= 1975), 'actual Original Source location differs')
            rva, size = provider['address_integer'] - mapping['image_base'], provider['actual_code_byte_count']
            need(int(provider['actual_code_extent_end'], 16) - provider['address_integer'] == size, 'complete actual code extent required')
            sections = [s for s in mapping['sections'] if not s['debug'] and s['characteristics'] & 0x20000000 and s['rva'] <= rva and rva + size <= s['rva'] + s['raw_size']]
            need(size > 0 and len(sections) == 1, 'unique executable PE extent required')
            section = sections[0]; offset = section['raw_offset'] + rva - section['rva']; data = payload[offset:offset + size]
            need(data.hex() == provider['actual_code_bytes_hex'] and hashlib.sha256(data).hexdigest() == provider['actual_code_bytes_sha256'], 'address-bound code bytes differ')
            same(provider['actual_disassembly_execution'], inventory['actual_disassembly_executions'][i])
            recorded(provider['actual_disassembly_execution'], inventory['Source_snapshot'])
    recorded(inventory['actual_addr2line_execution'], inventory['Source_snapshot'])
    loads = inventory['actual_target_and_core_LOAD_rows']
    need(len(loads) == 2 and sum(v['literal_line'] == 'LOAD Products/libenergypluslib.a' for v in loads) == 1 and sum('src06_tarp_inside_helper.dir/' in v['literal_line'] for v in loads) == 1, 'selected target and genuine core LOAD custody required')
    input_ref, policy_ref = full(bind(native['input_only_request'])), full(bind(native['prospective_policy']))
    request, policy = load(input_ref), load(policy_ref)
    def bit_count(value):
        return (int(set(value) == {'bits'}) + sum(bit_count(v) for v in value.values())) if isinstance(value, dict) else sum(bit_count(v) for v in value) if isinstance(value, list) else 0
    need(request['schema'] == 'src06-tarp-inside-direct-request.v1' and request['expected_values_supplied'] is False and request['ordinary_production_prestate_supplied'] is False, 'literal independent direct input required')
    need(len(request['cases']) == native['literal_input_case_count'] == 28 and sum(len(c['operations']) for c in request['cases']) == native['literal_input_call_count'] == 60 and bit_count(request) == native['literal_binary64_input_cell_count'] == 320, 'complete fixed input declarations required')
    need(policy['schema'] == 'src06-tarp-inside-observation-policy.v1' and policy['ordinary_production_handoff_verified'] is False and policy['gates_updated'] is False and native['runtime_interfaces']['Native_argc'] == 2, 'unchanged prospective policy and actual argc required')
    wind_before, wind_guard = (load(authority_refs[k]) for k in ('wind_before', 'wind_custody'))
    same(wind_guard['actual_before'], authority_refs['wind_before'])
    need(wind_before['implementation'] == 'Native' and wind_guard['all_frozen_artifacts_unchanged'] is True and wind_guard['actual_target_exit_code'] == wind_guard['actual_recorder_exit_code'] == 0, 'authentic closed wind environment provenance required')
    wind_receipt = recorded(wind_guard['actual_command_receipt'], wind_before['Source_snapshot'])
    need(wind_receipt['command'] == wind_before['actual_argv'], 'actual wind provenance command differs')
    dlls = [full(bind(row)) for row in wind_before['pinned_runtime_DLLs']]
    directory = ROOT / '.runtime/reference-tools/winlibs-gcc13.2.0-ucrt-r3/mingw64/bin'
    need(len(dlls) == 3 and {Path(v['path']).name for v in dlls} == {'libgcc_s_seh-1.dll', 'libstdc++-6.dll', 'libwinpthread-1.dll'} and all(bind(v).parent == directory for v in dlls), 'authentic complete Winlibs DLL set required')
    need(wind_before['actual_PATH'] == str(directory) + os.pathsep + wind_before['inherited_PATH'], 'actual wind PATH prefix differs')
    environment = os.environ.copy(); inherited_path = environment.get('PATH', ''); environment['PATH'] = str(directory) + os.pathsep + inherited_path
    bind({'path': str(RECORDER), 'sha256': RECORDER_SHA}); bind(full(Path(__file__)))
    output = (ROOT / args.output_dir).resolve()
    need(output.is_relative_to(ROOT / '.runtime/porting/SRC-06') and output != ROOT / '.runtime/porting/SRC-06' and not output.exists(), 'fresh ignored SRC06 capture directory required')
    output.mkdir(parents=True, exist_ok=False)
    argv = [str(bind(binary)), str(bind(input_ref))]
    before = {'schema': 'src06-tarp-inside-execution-before.v1', 'provider_inventory': inventory_ref, 'Root_provider_acceptance': approval_ref,
              'Source_preparation': authority_refs['Native_preparation'], 'build_Source_snapshot': inventory['Source_snapshot'], 'Source_snapshot': execution_source,
              'actual_binary': binary, 'actual_link_map': link_map, 'actual_helper_object': obj, 'actual_input': input_ref, 'observation_policy': policy_ref,
              'reviewed_execution_driver': full(Path(__file__)), 'authorities': authority_refs, 'historical_Source_aliases': list(HISTORICAL_ALIASES.values()),
              'inherited_PATH': inherited_path, 'actual_PATH': environment['PATH'], 'pinned_runtime_DLLs': dlls, 'actual_argv': argv,
              'declared_input_counts': {'cases': 28, 'calls': 60, 'binary64_cells': 320}, 'frozen_artifacts': list(FROZEN.values()), 'FP_controls_modified': False, 'scientific_PASS_claimed': False}
    write(output / 'before.json', before)
    result = subprocess.run([sys.executable, '-X', 'utf8', '-B', str(RECORDER), '--output-dir', str(output / 'command'), '--', *argv], cwd=ROOT, env=environment)
    receipt_path = output / 'command/receipt.json'; value = json.loads(receipt_path.read_bytes()) if receipt_path.is_file() else None
    after = [{**full(p), 'available': True} if p.is_file() else {'path': row['path'], 'available': False} for p, row in FROZEN.items()]
    unchanged = source_paths() == set(current) and all(row.get('available') and {k: row[k] for k in ('path', 'sha256', 'size_bytes')} == old for row, old in zip(after, FROZEN.values()))
    logs = {k: full(ROOT / value[k]['path']) for k in ('stdout', 'stderr')} if value else None
    guard = {'schema': 'src06-tarp-inside-execution-custody.v1', 'actual_before': full(output / 'before.json'), 'actual_command_receipt': full(receipt_path) if value else None,
             'actual_recorder_exit_code': result.returncode, 'actual_target_exit_code': value['exit_code'] if value else None, 'actual_full_output_logs': logs,
             'all_frozen_artifacts_unchanged': unchanged, 'frozen_artifacts_after': after, 'numerical_results_interpreted': False, 'FP_controls_modified': False, 'scientific_PASS_claimed': False, 'gates_updated': False}
    write(output / 'custody.json', guard)
    need(unchanged and value is not None and value['schema'] == 'recorded-porting-command.v1' and value['launch_error'] is None and value['source_bytes_match_before_and_after'] is True and value['source_snapshot']['sha256'] == execution_source['sha256'] and value['command'] == argv and value['exit_code'] == result.returncode and result.returncode in (0, 2), 'actual capture custody failed; all records retained')
    need(all(logs[k]['sha256'] == value[k]['sha256'] for k in logs), 'actual output log bytes differ from receipt')
    print(json.dumps({'custody': full(output / 'custody.json'), 'actual_exit_code': result.returncode, 'scientific_PASS_claimed': False}))
    return result.returncode


if __name__ == '__main__':
    sys.exit(main())

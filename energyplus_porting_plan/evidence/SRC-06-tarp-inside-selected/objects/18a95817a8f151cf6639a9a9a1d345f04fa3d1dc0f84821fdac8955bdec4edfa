+def source_correspondence(row, prep_ref, prep, members):
+    value = load(row)
+    need(value['schema'] == 'src06-tarp-inside-actual-API-correspondence.v1' and bind(value['Source_preparation']) == bind(prep_ref), 'reviewed selected Source correspondence required')
+    need(bind(value['accepted_math_preparation']) == bind(prep['accepted_math_preparation']), 'actual getter successor authority required')
+    math = load(value['accepted_math_preparation'])
+    bind(value['actual_application'])
+    need(value['Root_and_independent_FULL_formatter_correspondence_accepted'] is True, 'actual Root and independent full formatter acceptance required')
+    paths = prep['actual_public_API_source_paths']
+    rows = value['application']
+    need([r['canonical_path'] for r in rows] == paths and len(rows) == 2, 'exact two actual API correspondence rows required')
+    literals = {r['canonical_path']: r['proposal'] for r in math['application']}
+    for entry in rows:
+        name = entry['canonical_path']
+        need(bind(entry['accepted_literal']) == bind(literals[name]), 'accepted getter/math literal differs')
+        before, after = bind(entry['accepted_literal']).read_bytes(), bind(entry['actual_final_archive']).read_bytes()
+        declared = bind(entry['actual_format_diff']).read_bytes()
+        if before == after:
+            need(declared == b'', 'identical formatter endpoints require empty diff')
+        else:
+            lines = declared.decode().splitlines(True)
+            need(len(lines) >= 2 and lines[0].startswith('--- ') and lines[1].startswith('+++ '), 'literal formatter diff labels required')
+            regenerated = ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=lines[0][4:].rstrip('\r\n'), tofile=lines[1][4:].rstrip('\r\n'))).encode()
+            need(regenerated == declared, 'full actual formatter delta differs')
+        actual = full(bind(entry['actual_final_archive']))
+        need(members[name]['archive']['sha256'] == actual['sha256'] and members[name]['size_bytes'] == actual['size_bytes'], 'actual compiled Source archive differs')
+        bind({'path': name, 'sha256': actual['sha256'], 'size_bytes': actual['size_bytes']})
+    return value
+

def module(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    value = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(value)
    return value


def need(value, message):
    if not value:
        raise ValueError(message)


def keys(value, names):
    need(isinstance(value, dict) and set(value) == set(names), 'complete exact object shape required: ' + ','.join(names))


def identity(a, b):
    need(C.exact(a, True) == C.exact(b, True) and a['sha256'] == b['sha256'], 'authenticated reference identity differs')


def snapshot(row, current=False):
    value = C.load(row)
    need(value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False, 'literal full Source snapshot required')
    members = {v['historical_path']: v for v in value['files']}
    need(len(members) == len(value['files']), 'duplicate historical Source member')
    for name, entry in members.items():
        path = C.exact(entry['archive'])
        need((ROOT / name).resolve().is_relative_to(ROOT) and path.stat().st_size == entry['size_bytes'], 'historical Source member/size differs')
        if current:
            C.exact({'path': name, 'sha256': entry['archive']['sha256'], 'size_bytes': entry['size_bytes']})
    if current:
        actual = set((ROOT / 'crates').rglob('*.rs')) | set((ROOT / 'crates').rglob('Cargo.toml'))
        actual |= {ROOT / name for name in ['Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml'] if (ROOT / name).is_file()}
        need({p.relative_to(ROOT).as_posix() for p in actual} == set(members), 'complete current Source membership differs')
    return members


def frozen_rows(before, after, members):
    need(len(before) == len(after), 'every frozen artifact after-row required')
    paths = set()
    resolved_members = {(ROOT / name).resolve(): member for name, member in members.items()}
    for left, right in zip(before, after):
        name = str((ROOT / left['path']).resolve())
        need(name not in paths, 'duplicate frozen artifact')
        paths.add(name)
        need(all(right[k] == left[k] for k in ('path', 'sha256', 'size_bytes')) and right.get('available', True) is True, 'frozen before/after full bytes differ')
        member = resolved_members.get((ROOT / left['path']).resolve())
        if member is not None:
            need(left['sha256'] == member['archive']['sha256'] and left['size_bytes'] == member['size_bytes'], 'captured historical live Source alias differs')
            C.exact(member['archive'])
        else:
            C.exact(left, True)


def option_command(command, script, expected):
    need(len(command) == 5 + 2 * len(expected) and command[1:3] == ['-X', 'utf8'] and command[3] == '-B', 'actual Python -X utf8 -B launcher required')
    # Script follows the four interpreter tokens; remaining flags must be exact and unique.
    need((ROOT / command[4]).resolve() == script, 'actual launcher Source path differs')
    tokens = command[5:]
    need(len(tokens) % 2 == 0, 'complete launcher options required')
    actual = {}
    for flag, value in zip(tokens[::2], tokens[1::2]):
        need(flag not in actual, 'duplicate launcher flag')
        actual[flag] = value
    need(set(actual) == set(expected), 'exact launcher option set required')
    for flag, value in expected.items():
        if isinstance(value, dict):
            path, sha = actual[flag].rsplit('#', 1)
            need((ROOT / path).resolve() == C.exact(value) and sha == value['sha256'], 'actual launcher bound operand differs: ' + flag)
        else:
            need((ROOT / actual[flag]).resolve() == value, 'actual launcher output directory differs')



        for label, value in [('Native', left), ('Rust', right)]:
            C.same(low, value['LowHConvLimit'], path + '/literal-low/' + label, 'input_join_comparisons')
            for i, declared in enumerate(spec['initial']['surfaces']):
                for field in ('CosTilt', 'SurfHConvInt'):
                    C.same(C.literal(declared[field]), value['rows'][i][field], f'{path}/literal-{label}/surface{i+1}/{field}', 'input_join_comparisons')
                C.same(declared['ExtBoundCond'], value['rows'][i]['ExtBoundCond'], f'{path}/literal-{label}/surface{i+1}/boundary', 'input_join_comparisons')
        calls, rcalls = ncase['actual_calls'], rcase['actual_calls']
        need(ncase['actual_source_call_count'] == len(calls) and rcase['actual_source_call_count'] == len(rcalls) == len(spec['operations']), 'complete actual call counts required')
        prior_n, prior_r, cursor, stopped, unreached = ncase['prepared_state'], rcase['prepared_state'], 0, False, []
        for i, (op, rcall) in enumerate(zip(spec['operations'], rcalls), 1):
            operation_count += 1
            key = path + '/' + op['operation_id']
            need(op['api'] in APIS and rcall['operation_id'] == op['operation_id'] and rcall['literal_operation'] == op and rcall['api'] == APIS[op['api']][1] and rcall['actual_call_ordinal'] == i and rcall['actual_source_invoked'] is True and rcall['actual_source_return_observed'] is True and rcall['source_exception'] is None and rcall['counted_as_PASS'] is False, 'actual Rust call/order/literal inputs differ')
            for field in ('surface_temperature_c', 'air_temperature_c'):
                C.literal(op[field])
            detailed = op['api'] == 'CalcASHRAEDetailedIntConvCoeff'
            selected = op['surface_index'] - 1 if detailed else None
            need((op['correlation_cos_tilt'] is None and type(op['surface_index']) is int and 0 <= selected < len(left['rows'])) if detailed else op['surface_index'] is None, 'actual selected/direct argument domain differs')
            if not detailed:
                C.literal(op['correlation_cos_tilt']); C.scalar(rcall['actual_return_value'])
            else:
                need(rcall['actual_return_value'] is None, 'Detailed void call return differs')
            need(rcall['before'] == prior_r, 'full Rust call continuity differs')
            owner(rcall['before'], spec, False); owner(rcall['after'], spec, False)
            unchanged_except_selected(rcall['before'], rcall['after'], selected, False)
            if stopped:
                unreached.append(op)
                C.unavailable(key, 'Native-operation-unreached; independent-Rust-call-not-paired')
            else:
                need(cursor < len(calls), 'Native reached call absent')
                ncall = calls[cursor]; cursor += 1
                need(ncall['operation_id'] == op['operation_id'] and ncall['api'] == APIS[op['api']][0] and ncall['actual_call_ordinal'] == cursor and ncall['actual_source_invoked'] is True and ncall['before'] == prior_n, 'actual Native call/order/continuity differs')
                returned, exception = ncall['actual_source_return_observed'], ncall['source_exception']
                need(type(returned) is bool and (exception is None if returned else isinstance(exception, dict) and exception.get('kind') == 'OriginalFatalError' and type(exception.get('message')) is str), 'unexpected Native source/callback-integrity exception')
                owner(ncall['before'], spec, True); owner(ncall['after'], spec, True)
                if returned:
                    unchanged_except_selected(ncall['before'], ncall['after'], selected, True)
                    need(ncall['actual_return_value'] is None, 'Detailed void call return differs') if detailed else C.scalar(ncall['actual_return_value'])
                    endpoints.append((spec, op, key, ncall, rcall))
                else:
                    need(ncall['actual_return_value'] is None, 'failed call invented return value')
                    C.unavailable(key, 'actual-Native-source-did-not-return', exception)

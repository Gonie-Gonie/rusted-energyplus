        after_generated = {op['surface_index'] - 1} if detailed else set()
        arithmetic_before = len(NONFINITE)
        pair(owner(ncall['after'], spec, True), owner(rcall['after'], spec, False), key + '/after-full-owner', 'selected_endpoint_comparisons', after_generated)
        if not detailed:
            scalar_pair(C.scalar(ncall['actual_return_value']), C.scalar(rcall['actual_return_value']), key + '/actual-return-value', 'selected_endpoint_comparisons', True)

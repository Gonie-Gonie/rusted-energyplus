def scalar_pair(a, b, path, phase, arithmetic=False):
    finite = ('finite', 'positive_zero', 'negative_zero')
    if arithmetic and (a[1] not in finite or b[1] not in finite):
        C.same(a[1], b[1], path + '/diagnostic-class', phase)
        NONFINITE.append(path)
        C.unavailable(path, 'nonfinite-generated-arithmetic; class-required-no-numerical-PASS', {'Native': a, 'Rust': b})
    else:
        C.same(a, b, path, phase)


def pair(a, b, path, phase, generated):
    C.same(a['LowHConvLimit'], b['LowHConvLimit'], path + '/LowHConvLimit', phase)
    need(len(a['rows']) == len(b['rows']), 'full paired owner cardinality differs')
    for i, (left, right) in enumerate(zip(a['rows'], b['rows'])):
        for field in ('Name', 'index', 'CosTilt', 'ExtBoundCond'):
            C.same(left[field], right[field], f'{path}/surface{i+1}/{field}', phase)
        scalar_pair(left['SurfHConvInt'], right['SurfHConvInt'], f'{path}/surface{i+1}/SurfHConvInt', phase, i in generated)



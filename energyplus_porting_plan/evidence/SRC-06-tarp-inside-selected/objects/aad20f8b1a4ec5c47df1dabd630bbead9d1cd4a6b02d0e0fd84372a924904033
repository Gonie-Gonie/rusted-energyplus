            'nonfinite_arithmetic_unavailable_count': len(NONFINITE) - arithmetic_before, 'whole_unit_PASS_claimed': False})
    return {'global_input_and_initial_full_owner_join_passed': admitted, 'endpoint_pairing_performed': admitted,
        'actual_case_count': 28, 'actual_declared_call_count': operation_count, 'paired_available_boundaries': len(C.PAIRS),
        'actual_Native_exit_code': nreceipt['exit_code'], 'Native_source_stopped': stopped_any, 'selected_source_reachability_complete': len(endpoints) == operation_count, 'Native_capture_Source_snapshot': nreceipt['source_snapshot'],
        'actual_Cargo_Source_snapshot': rreceipt['source_snapshot'], 'Native_original_stdout': nreceipt['stdout'],
        'Rust_result': rguard['actual_output'], 'actual_API_correspondence': rguard['actual_API_correspondence']}


def main():
    global C
    import hashlib
    need(hashlib.sha256(BASE.read_bytes()).hexdigest() == BASE_SHA, 'accepted comparison primitive Source differs')
    C = module(BASE, 'accepted_src05_comparison_primitives')
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--custody', required=True)
    parser.add_argument('--output-dir', required=True)
    args = parser.parse_args()
    name, sha = args.custody.rsplit('#', 1)
    packet_ref = {'path': name, 'sha256': sha}
    packet = C.load(packet_ref)
    policy_ref = C.ref(HERE / 'policy.json')
    policy = C.load(policy_ref)
    policy['_actual_policy_ref'] = policy_ref
    C.exact({'path': BASE.relative_to(ROOT).as_posix(), 'sha256': BASE_SHA})
    output = (ROOT / args.output_dir).resolve()
    need(output.is_relative_to(ROOT / '.runtime/porting/SRC-06') and not output.exists(), 'fresh ignored SRC06 comparison output required')
    output.mkdir(parents=True)
    try:
        findings = compare(packet, policy)
        passed = findings['global_input_and_initial_full_owner_join_passed'] and findings['selected_source_reachability_complete'] and not C.MISMATCHES
        status = 'pass-available-finite-selected-API-pairs-only' if passed else 'fail-selected-API-or-input-owner-join-or-unreached'
        code = 0 if passed else 1
    except (KeyError, TypeError, ValueError, IndexError, OSError) as error:
        findings, status, code = {'integrity_failure': str(error), 'endpoint_pairing_performed': False}, 'fail-observation-or-custody-integrity', 2
    for path, sha in C.SEEN.items():
        need(C.digest(path) == sha, 'authenticated artifact changed during comparison')
    if T is not None:
        for path, row in T.SEEN.items():
            need(T.full(path) == row, 'authenticated runtime API correspondence changed')
    ledgers = {}
    for label, rows in [('mismatches', C.MISMATCHES), ('unavailable', C.UNAVAILABLE), ('paired-boundaries', C.PAIRS)]:
        path = output / (label + '.ndjson')
        with path.open('x', encoding='utf-8', newline='\n') as stream:
            for row in rows:
                stream.write(json.dumps(row, allow_nan=False) + '\n')
        ledgers[label] = C.ref(path)
    report = {'schema': 'src06-selected-tarp-inside-comparison.v1', 'status': status, 'actual_custody': packet_ref,
        'actual_prospective_policy': policy_ref, 'findings': findings, 'counts': C.COUNTS, 'mismatch_count': len(C.MISMATCHES),
        'required_unavailable_count': len(C.UNAVAILABLE), 'nonfinite_arithmetic_unavailable_count': len(NONFINITE),
        'all_mismatches_and_unavailable_rows_retained_uncapped': True, 'ledgers': ledgers,
        'diagnostic_class_checks_counted_as_numerical_PASS': False,
        'backend_or_InitIntConvCoeff_cadence_PASS_claimed': False, 'whole_SRC06_unit_or_ordinary_handoff_PASS_claimed': False, 'gates_updated': False}
    with (output / 'comparison.json').open('x', encoding='utf-8', newline='\n') as stream:
        json.dump(report, stream, indent=2, allow_nan=False); stream.write('\n')
    print(json.dumps({'comparison': C.ref(output / 'comparison.json'), 'status': status, 'exit_code': code}))
    return code


if __name__ == '__main__':
    sys.exit(main())

def backend(value):
    counters = ['TotalWarningErrors', 'TotalSevereErrors', 'TotalWarningErrorsDuringWarmup', 'TotalSevereErrorsDuringWarmup', 'TotalWarningErrorsDuringSizing', 'TotalSevereErrorsDuringSizing']
    flags = ['AbortProcessing', 'outputErrorHeader', 'DoingInputProcessing', 'printConsoleOutput', 'errorCallback_present', 'messageCallback_present', 'fMessagePtr_present', 'sqlite_present']
    names = ['LastSevereError', 'VerStringVar', 'IDDVerString', 'CurrentDateTime']
    keys(value, counters + flags + names + ['MatchCounts'])
    need(all(type(value[k]) is int and value[k] >= 0 for k in counters) and all(type(value[k]) is bool for k in flags) and all(type(value[k]) is str for k in names), 'complete Native backend scalars required')
    array(value['MatchCounts'], None, False)


def array(value, count, real):
    keys(value, ['allocated', 'size', 'lower', 'upper', 'values_available', 'rows'])
    need(type(value['allocated']) is bool and type(value['size']) is int and value['size'] >= 0 and value['values_available'] is True and isinstance(value['rows'], list) and len(value['rows']) == value['size'], 'full allocated array DTO required')
    if value['allocated']:
        need(type(value['lower']) is int and type(value['upper']) is int and value['upper'] - value['lower'] + 1 == value['size'], 'actual contiguous full bounds required')
    else:
        need(value['size'] == 0 and value['lower'] is None and value['upper'] is None, 'unallocated array bounds differ')
    if count is not None:
        need(value['allocated'] is (count > 0) and value['size'] == count and (count == 0 or value['lower'] == 1 and value['upper'] == count), 'selected full 1-based allocation differs')
    result = []
    for i, row in enumerate(value['rows']):
        keys(row, ['actual_array_index', 'value'])
        need(row['actual_array_index'] == value['lower'] + i, 'full actual array order differs')
        if real:
            result.append(C.scalar(row['value']))
        else:
            need(type(row['value']) is int, 'integer array value required')
    return result



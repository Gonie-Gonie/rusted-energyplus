            prior_r = rcall['after']
        need(cursor == len(calls) and ncase['unreached_operations'] == unreached and ncase['actual_source_stopped'] is stopped and ncase['final'] == prior_n and rcase['final'] == prior_r, 'complete actual call/stop/final closure differs')
        owner(ncase['final'], spec, True); owner(rcase['final'], spec, False)
        stopped_any = stopped_any or stopped
        C.unavailable(path + '/Native-only-full-context', 'constructor/high-limit/Objexx-implementation/backend-callbacks-prefixes-retained-unpaired')
    need(operation_count == 60 and nreceipt['exit_code'] == (2 if stopped_any else 0), 'actual Native exit/full stop ledger differs')
    admitted = not C.MISMATCHES
    for spec, op, key, ncall, rcall in endpoints:
        if not admitted:
            C.unavailable(key, 'global-input-or-initial-full-owner-join-failed; no-endpoint-pairing')

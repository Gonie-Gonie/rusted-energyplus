def sha(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def ref(path):
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha(path), 'size_bytes': path.stat().st_size}


def read(path):
    return json.loads(path.read_bytes())


def dump(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n', encoding='utf8', newline='\n')


def recorded(command, name):
    directory = RAW / name
    result = subprocess.run([sys.executable, '-X', 'utf8', '-B', str(RECORDER), '--output-dir', directory.relative_to(ROOT).as_posix(), '--', *command], cwd=ROOT)
    receipt = read(directory / 'receipt.json')
    assert receipt['command'] == command and receipt['source_snapshot'] == snapshot
    assert receipt['exit_code'] == result.returncode == 0 and receipt['launch_error'] is None and receipt['source_bytes_match_before_and_after'] is True
    return receipt



"""Seal Source-only SRC06 main transport; no Cargo, formatter, or helper execution."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-06/tarp-inside-selected-rust-prep-01'
BASE = ROOT / '.runtime/porting/SRC-05/surface-environment-main-thread-prep-01'
LAUNCH = ROOT / '.runtime/porting/SRC-05/surface-environment-main-thread-prep-02/run_main_thread.py'
GETTER = ROOT / '.runtime/porting/SRC-06/tarp-inside-getter-prep-01/manifest.json'
NATIVE = ROOT / '.runtime/porting/SRC-06/native-tarp-inside-prep-02/manifest.json'


def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(), 'size_bytes': len(data), 'line_count': len(data.splitlines())}


def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(data)
    return ref(path)


def main():
    assert ref(GETTER)['sha256'] == '7eb308271196d36cbcbf58f17cec8599ddd3c396a84c5c52fcab958933f99963'
    assert not (OUT / 'manifest.json').exists()
    old_name, name = b'src05_surface_environment_main', b'src06_tarp_inside_main'
    for file in ('Cargo.toml', 'Cargo.lock'):
        before = (BASE / 'rust' / file).read_bytes()
        assert before.count(old_name) == 1
        write(OUT / 'rust' / file, before.replace(old_name, name))
    math = json.loads(GETTER.read_bytes())
    native = json.loads(NATIVE.read_bytes())
    own = [ref(OUT / 'rust' / file) for file in ('Cargo.toml', 'Cargo.lock', 'src/main.rs')] + [ref(OUT / 'run_main_thread.py')]
    before_paths = [BASE / 'rust/Cargo.toml', BASE / 'rust/Cargo.lock', BASE / 'rust/src/main.rs', LAUNCH]
    befores, diffs = [], []
    for i, (old, new) in enumerate(zip(before_paths, own), 1):
        before, after = old.read_bytes(), (ROOT / new['path']).read_bytes()
        befores.append(write(OUT / 'before' / f'{i:02d}.source', before))
        delta = ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=ref(old)['path'], tofile=new['path'])).encode()
        diffs.append(write(OUT / 'diffs' / f'{i:02d}.diff', delta))
    ast.parse((OUT / 'run_main_thread.py').read_bytes())
    ast.parse(Path(__file__).read_bytes())
    readme = write(OUT / 'README.md', b'''# SRC-06 standalone selected main observation (held Source)

The isolated safe Rust main calls the accepted public Natural and non-Kiva Detailed APIs in the exact literal 28-case/60-call order. It copies all 320 independent binary64 inputs, obtains the default lower-limit scalar through the genuine getter, and retains every row before/after each call. Detailed's returned coefficient is assigned to the selected caller-owned row; no correlation or expected endpoint is reproduced. Native backend/constructor/high-limit/Objexx implementation owners are explicitly unavailable here, and no ordinary manager/cadence or PASS is claimed.

The getter successor 7eb30827 is the accepted math authority, retaining current composition669 as its parent. Actual formatted canonical sources are future runtime operands, never guessed identities. Root supplies `--source-correspondence PATH#SHA` with schema `src06-tarp-inside-actual-API-correspondence.v1`, Source_preparation=this manifest, accepted_math_preparation=getter manifest, actual_application=real application record, Root_and_independent_FULL_formatter_correspondence_accepted=true, and application exactly two ordered rows (convection.rs then convection/tarp_inside.rs). Each row has canonical_path, accepted_literal, actual_final_archive, actual_format_diff. The launcher authenticates both accepted literals, full regenerated formatter differences, compiled snapshot archives and live final bytes. The explicit review flag is an authority supplied only after actual full Root+peer review, not a computed token certificate.

Launcher operands: --source-preparation PATH#SHA --policy PATH#SHA --input PATH#SHA --source-snapshot PATH#SHA --source-correspondence PATH#SHA --output-dir FRESH --quality ROLE=PATH#SHA four times. Roles are fmt_check/clippy/focused/workspace and every exact actual Cargo argv is guarded. The full current Source set, actual Cargo JSON sole emitted bin, immediate executable SHA, argv3 target, input and all retained artifacts are checked before/after. No source values are obtained from Native results. The isolated Cargo lock differs from the accepted SRC05 standalone only in the root package name; no lock resolver or Cargo command ran during preparation.

Runtime outputs: before.json, artifact.json, Cargo-command and command authentic receipts/logs, result.json and custody.json. Failure records remain; exit2 or missing/incomplete results cannot count as selected PASS. This package has not executed targets, Cargo, formatting, canonical edits, FP controls or Git. Historical worker-thread precision is not inferred by this main-thread unit.
''')
    manifest = {'schema': 'src06-selected-main-thread-Source-preparation.v1', 'status': 'HELD-Source-only-unexecuted',
        'accepted_math_preparation': ref(GETTER), 'accepted_math_parent': math['predecessor_source_preparation'], 'Native_source_preparation': ref(NATIVE),
        'literal_input_source': native['input_only_request'], 'Native_observation_policy': native['prospective_policy'],
        'runtime_interfaces': {'Cargo_manifest': own[0], 'Cargo_lock': own[1], 'Rust_main': own[2], 'launcher': own[3], 'argc': 3,
            'result_schema': 'src06-tarp-inside-selected-results.v1', 'sidecar_schema': 'src06-selected-main-thread-execution-custody.v1',
            'source_correspondence_schema': 'src06-tarp-inside-actual-API-correspondence.v1'},
        'actual_public_API_source_paths': [r['canonical_path'] for r in math['application'][:2]],
        'accepted_public_API_literals': [r['proposal'] for r in math['application'][:2]],
        'own_sources': own, 'README': readme, 'authentic_transport_before': [ref(p) for p in before_paths],
        'before_archives': befores, 'exact_transport_diffs': diffs,
        'source_dependencies': [ref(GETTER), ref(NATIVE), ref(ROOT / '.runtime/porting/SRC-06/native-execution-prep-02/manifest.json'),
            ref(ROOT / '.runtime/porting/SRC-05/surface-environment-main-thread-prep-02/manifest.json'), ref(ROOT / 'tools/porting/record_command.py'), ref(Path(__file__))],
        'selected_source_ranges': math['selected_source_ranges'], 'literal_counts': {'cases': 28, 'calls': 60, 'binary64_cells': 320},
        'Root_only_runtime_actions': True, 'FP_controls_modified': False, 'Native_results_read': False,
        'Rust_results_supplied': False, 'scientific_execution_performed': False, 'canonical_changes_performed': False, 'gates_updated': False}
    write(OUT / 'manifest.json', (json.dumps(manifest, indent=2) + '\n').encode())
    print(json.dumps(ref(OUT / 'manifest.json')))


if __name__ == '__main__':
    main()

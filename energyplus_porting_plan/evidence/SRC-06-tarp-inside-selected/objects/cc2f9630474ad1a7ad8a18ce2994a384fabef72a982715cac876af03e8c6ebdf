include("${SRC06_REFERENCE_RECIPE}")
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
  function(src06_place_reference)
    if(NOT TARGET src06_tarp_inside_helper OR NOT IS_DIRECTORY "${SRC06_OUTPUT_DIR}")
      message(FATAL_ERROR "Reviewed helper and prepared output directory required")
    endif()
    set_target_properties(src06_tarp_inside_helper PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${SRC06_OUTPUT_DIR}")
    get_target_property(_src06_link_options src06_tarp_inside_helper LINK_OPTIONS)
    list(REMOVE_ITEM _src06_link_options "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/src06_tarp_inside_helper.map")
    set_property(TARGET src06_tarp_inside_helper PROPERTY LINK_OPTIONS "${_src06_link_options}")
    target_link_options(src06_tarp_inside_helper PRIVATE "-Wl,-Map,${SRC06_OUTPUT_DIR}/src06_tarp_inside_helper.map")
  endfunction()
  cmake_language(DEFER CALL src06_place_reference)
endif()

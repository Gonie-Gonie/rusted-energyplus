"""Read the closed genuine link's PE/map/providers; never execute its helper."""
import hashlib
import json
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / '.runtime/porting/SRC-05/wind-pow-native-build-02'
BINARY = Path('D:/CodexBuild/rusted-energyplus/SRC-05/wind-pow-native-build-02/bin/src05_wind_pow_helper.exe')
MAP = BINARY.with_suffix('.map')
sys.path.insert(0, str(ROOT / 'tools/porting'))
import native_pe


def sha(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def ref(path):
    return {'path': path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path),
            'sha256': sha(path), 'size_bytes': path.stat().st_size}


def read(path):
    return json.loads(path.read_bytes())


def dump(path, value):
    assert not path.exists()
    path.write_text(json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n', encoding='utf8', newline='\n')


freeze = read(OUT / 'frozen-build-inputs.json')
snapshot = freeze['Source_snapshot']
executions = {}
for role in ['configure-command', 'dry-verbose-command', 'compile-command', 'core-after-command']:
    path = OUT / role / 'receipt.json'; value = read(path)
    assert value['exit_code'] == 0 and value['launch_error'] is None and value['source_bytes_match_before_and_after'] is True
    assert value['source_snapshot'] == snapshot
    for key in ['stdout', 'stderr']:
        assert sha(ROOT / value[key]['path']) == value[key]['sha256']
    executions[role] = ref(path)
for row in freeze['frozen_Source_and_input']:
    path = ROOT / row['path']; assert sha(path) == row['sha256'] and path.stat().st_size == row['size_bytes']
binary_before, map_before = ref(BINARY), ref(MAP)
symbols = ['EnergyPlus::DataSurfaces::SetSurfaceWindSpeedAt(EnergyPlus::EnergyPlusData&)',
           'pow', 'log2l', 'exp2l', 'fegetround', '_fpreset']
selected = {name: [] for name in symbols}
section = None; pending = None; lines = []; loads = []
section_re = re.compile(r'^\s+(\.text\S*)\s+(0x[0-9a-fA-F]+)\s+(0x[0-9a-fA-F]+)\s+(.+?)\s*$')
continued_re = re.compile(r'^\s+(0x[0-9a-fA-F]+)\s+(0x[0-9a-fA-F]+)\s+(.+?)\s*$')
symbol_re = re.compile(r'^\s+(0x[0-9a-fA-F]+)\s+(.+?)\s*$')
with MAP.open('r', encoding='utf8', errors='strict') as stream:
    for number, line in enumerate(stream, 1):
        text = line.rstrip('\n')
        match = section_re.match(text)
        if match:
            name, start, size, owner = match.groups()
            section = {'section': name, 'start': int(start, 16), 'size': int(size, 16), 'owner': owner, 'line_number': number, 'literal_line': text}
            pending = None
        elif re.match(r'^\s+\.text\S*\s*$', text):
            pending = {'section': text.strip(), 'name_line': text, 'name_line_number': number}
        elif pending and (match := continued_re.match(text)):
            start, size, owner = match.groups()
            section = dict(pending, start=int(start, 16), size=int(size, 16), owner=owner, line_number=number, literal_line=text)
            pending = None
        if text.startswith('LOAD ') and ('src05_wind_pow_helper.dir/' in text or text == 'LOAD Products/libenergypluslib.a'):
            loads.append({'line_number': number, 'literal_line': text})
            lines.append(f'{number}: {text}')
        match = symbol_re.match(text)
        if match and match.group(2) in selected:
            address = int(match.group(1), 16); name = match.group(2)
            assert section and section['start'] <= address < section['start'] + section['size'], (name, section)
            selected[name].append({'symbol': name, 'address': match.group(1), 'address_integer': address,
                'line_number': number, 'literal_line': text, 'owning_text_section': dict(section)})
            if 'name_line' in section: lines.append(f"{section['name_line_number']}: {section['name_line']}")
            lines.extend([f"{section['line_number']}: {section['literal_line']}", f'{number}: {text}'])
assert all(len(rows) == 1 for rows in selected.values()), {name: len(rows) for name, rows in selected.items()}
providers = [selected[name][0] for name in symbols]
assert 'Products/libenergypluslib.a(DataSurfaces.cc.obj)' == providers[0]['owning_text_section']['owner']
assert 'libmingwex.a(' in providers[1]['owning_text_section']['owner'] and 'pow.o)' in providers[1]['owning_text_section']['owner']
assert all('libmingwex.a(' in row['owning_text_section']['owner'] for row in providers[2:4])
assert len(loads) == 2 and sum('src05_wind_pow_helper.dir/' in row['literal_line'] for row in loads) == 1
selected_path = OUT / 'address-bound-providers.txt'
assert not selected_path.exists(); selected_path.write_text('\n'.join(lines) + '\n', encoding='utf8', newline='\n')
mapping = native_pe.inspect(BINARY)
for row in providers:
    address = row['address_integer'] - mapping['image_base']
    assert any(not section['debug'] and section['characteristics'] & 0x20000000 and section['rva'] <= address < section['rva'] + section['raw_size'] for section in mapping['sections'])
dry_review = read(OUT / 'configure-and-dry-review.json')
object_path = Path(dry_review['new_compile_row']['output'])
if not object_path.is_absolute(): object_path = Path(dry_review['new_compile_row']['directory']) / object_path
assert object_path.is_file()
assert binary_before == ref(BINARY) and map_before == ref(MAP)
dump(OUT / 'linked-provider-and-PE-inventory.json', {'schema': 'src05-wind-pow-actual-linked-provider-and-PE-inventory.v1',
    'reviewed_Source_preparation': freeze['reviewed_Source_preparation'], 'frozen_build_inputs': ref(OUT / 'frozen-build-inputs.json'),
    'Source_snapshot': snapshot, 'actual_executions': executions, 'actual_Native_binary': binary_before, 'actual_full_link_map': map_before,
    'actual_helper_object': ref(object_path.resolve()), 'selected_provider_map_lines': ref(selected_path), 'actual_address_bound_providers': providers,
    'actual_target_and_core_LOAD_rows': loads, 'actual_PE_reader': ref(ROOT / 'tools/porting/native_pe.py'), 'actual_PE': mapping,
    'actual_evidence_collector': ref(Path(__file__)), 'Root_FULL_provider_and_PE_review_pending': True,
    'helper_executed': False, 'diagnostic_results_read': False, 'production_math_changed': False, 'gates_updated': False})
print(json.dumps({'inventory': ref(OUT / 'linked-provider-and-PE-inventory.json'), 'helper_executed': False}))

('model, Some(public), surfaces, Some(clock), outdoor, None, None, Some(route), None', '(model, Some(public), surfaces), Some(clock), outdoor, (None, None, Some(route)), None'),
('model, state.construction_ctf10_public_initialization.as_ref(), &state.surfaces, clock, outdoor, None, None, None, None', '(model, state.construction_ctf10_public_initialization.as_ref(), &state.surfaces), clock, outdoor, (None, None, None), None'),
('model, state.construction_ctf10_public_initialization.as_ref(), &state.surfaces, clock, outdoor, None, None, None, result.err()', '(model, state.construction_ctf10_public_initialization.as_ref(), &state.surfaces), clock, outdoor, (None, None, None), result.err()')]:
 assert a in s,a
 s=s.replace(a,b)

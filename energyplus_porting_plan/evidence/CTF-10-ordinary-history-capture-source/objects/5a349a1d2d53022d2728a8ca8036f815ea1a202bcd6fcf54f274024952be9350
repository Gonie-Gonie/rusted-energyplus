"""Publish reviewed source/application/quality facts; no scientific outputs read."""
import hashlib
import json
from pathlib import Path
import re
import shutil
import subprocess

ROOT = Path.cwd()
RAW = ROOT / '.runtime/porting'
OUT = ROOT / 'energyplus_porting_plan/evidence/CTF-10-ordinary-history-capture-source'
assert not OUT.exists()

def digest(data):
    return hashlib.sha256(data).hexdigest()

def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': digest(data), 'size_bytes': len(data)}

def dump(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n', encoding='utf8', newline='\n')

selected = set()
directories = [
    'SUR-04/inside-consumer-prep-01', 'SUR-04/scope-card-amendment-01',
    'SUR-04/inside-consumer-applied-01', 'SUR-04/inside-consumer-format-command-01',
    'SUR-04/inside-consumer-apply-command-01', 'CTF-09/scope-card-consistency-01',
    'CTF-10/ordinary-history-capture-prep-01', 'CTF-10/ordinary-history-capture-card-prep-01',
    'CTF-10/ordinary-history-capture-applied-01', 'CTF-10/ordinary-history-capture-format-command-01',
    'CTF-10/ordinary-history-capture-apply-command-01', 'CTF-10/ordinary-history-quality-01',
    'CTF-10/ordinary-history-build-command-01', 'CTF-10/ordinary-history-pairing-policy-prep-01',
    'CTF-10/ordinary-history-pairing-policy-prep-02', 'CTF-10/ordinary-history-invocation-prep-01',
]
for directory in directories:
    selected.update(p for p in (RAW / directory).rglob('*') if p.is_file() and '__pycache__' not in p.parts)
selected.update([Path(__file__).resolve(), RAW / 'SUR-04/apply-inside-consumer-01.py',
    RAW / 'CTF-10/apply-ordinary-history-capture-01.py', ROOT / 'tools/porting/record_command.py'])
applications = []
for relative in ['SUR-04/inside-consumer-applied-01/record.json', 'CTF-10/ordinary-history-capture-applied-01/record.json']:
    record = json.loads((RAW / relative).read_text(encoding='utf8'))
    for key in ['source_before', 'source_literal', 'source_final']:
        selected.add(ROOT / record[key]['path'])
    for row in record['application']:
        applications.append(row)
        selected.add(ROOT / row['actual_final_archive']['path'])
        assert ref(ROOT / row['canonical_path']) == row['actual_final']
quality_path = RAW / 'CTF-10/ordinary-history-quality-01/quality.json'
quality = json.loads(quality_path.read_text(encoding='utf8'))
assert [r['test_totals'] for r in quality['actual_commands']] == [[0,0,0],[0,0,0],[316,0,0],[4940,0,0]]
snapshot = quality['actual_commands'][0]['source_snapshot']
assert snapshot['sha256'] == 'c3151a006de7251964fdfe2c203f6563a88dd71b992310aac0d2602a340e30e7'
for role in quality['actual_commands']:
    receipt = json.loads((ROOT / role['execution']['path']).read_text(encoding='utf8'))
    assert receipt['source_snapshot'] == snapshot and receipt['exit_code'] == 0 and receipt['source_bytes_match_before_and_after']
    selected.add(ROOT / receipt['source_snapshot']['path'])
build = json.loads((RAW / 'CTF-10/ordinary-history-build-command-01/receipt.json').read_text(encoding='utf8'))
assert build['exit_code'] == 0 and build['source_bytes_match_before_and_after'] and build['source_snapshot'] == snapshot

# Reuse already-published byte-identical objects; preserve original identities.
existing = {}
for directory in (ROOT / 'energyplus_porting_plan/evidence').glob('*/objects'):
    for p in directory.iterdir():
        if p.is_file() and re.fullmatch('[0-9a-f]{64}', p.name):
            existing.setdefault(p.name, p)
(OUT / 'objects').mkdir(parents=True)
rows, stored = [], {}
for path in sorted(selected):
    identity = ref(path)
    sha = identity['sha256']
    if sha not in stored:
        target = existing.get(sha, OUT / 'objects' / sha)
        if not target.exists():
            shutil.copyfile(path, target)
        assert ref(target)['sha256'] == sha and target.stat().st_size == identity['size_bytes']
        stored[sha] = ref(target)
    rows.append({'original': identity, 'stored': stored[sha]})
manifest_path = OUT / 'manifest.json'
dump(manifest_path, {'schema':'selected-porting-evidence-archive.v1', 'selected_objects':rows,
    'unique_object_count':len(stored), 'selected_original_path_count':len(rows),
    'unique_logical_bytes':sum(r['size_bytes'] for r in stored.values()),
    'selection':'Reviewed bounded Source, literal/formatter application and actual quality/build facts only; no ordinary numerical results selected.'})
summary_path = OUT / 'summary.json'
dump(summary_path, {'schema':'ctf10-ordinary-history-source-and-quality.v1',
    'parent_git_commit':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),
    'Source_snapshot':snapshot, 'Source_file_count':3915,
    'source_reconstruction':'Parent Git source plus archived final changed files; raw path/hash snapshots and literal/formatter diffs retain both application steps.',
    'changed_Rust_files':[r['actual_final'] for r in applications],
    'SUR04_actual_application':ref(RAW/'SUR-04/inside-consumer-applied-01/record.json'),
    'persistent_capture_actual_application':ref(RAW/'CTF-10/ordinary-history-capture-applied-01/record.json'),
    'actual_quality':quality, 'actual_Cargo_build':ref(RAW/'CTF-10/ordinary-history-build-command-01/receipt.json'),
    'archive_manifest':ref(manifest_path),
    'source_changes':'Source-ordered SUR04 inside terms/reciprocal and genuine borrowed persistent lifecycle capture; unchanged ordinary solver/call/commit ordering.',
    'test_scope':'Four authored IEEE expression regressions and four capture/lifecycle tests; these are not Native reference endpoints.',
    'numerical_comparison_performed_on_this_Source':False,
    'ordinary_capture_or_reachability_certified':False, 'card_gates_updated':False,
    'remaining':'Actual ordinary capture, complete available Native/Rust boundary pairing and outstanding card dependencies/gates.'})
summary_ref = ref(summary_path)

# Fix the already-reviewed two-line documentation contradiction.
consistency = json.loads((RAW/'CTF-09/scope-card-consistency-01/manifest.json').read_text(encoding='utf8'))
assert ref(ROOT/consistency['canonical_path'])['sha256'] == consistency['actual_before']['sha256']
proposal = ROOT/consistency['proposal']['path']
assert ref(proposal)['sha256'] == consistency['proposal']['sha256']
(ROOT/consistency['canonical_path']).write_bytes(proposal.read_bytes())
plan_path = ROOT/'energyplus_porting_plan/plan.json'
plan = json.loads(plan_path.read_text(encoding='utf8'))
before_plan = json.loads(json.dumps(plan))
for task in plan['tasks']:
    if task['id'] in ['CTF-10','SUR-04']:
        task.setdefault('evidence', {})['actual_persistent_history_capture_source_and_quality'] = summary_ref
dump(plan_path, plan)
inverse = json.loads(json.dumps(plan))
for task in inverse['tasks']:
    if task['id'] in ['CTF-10','SUR-04']:
        del task['evidence']['actual_persistent_history_capture_source_and_quality']
assert inverse == before_plan
for card in ['CTF-10','SUR-04']:
    path=ROOT/f'energyplus_porting_plan/cards/{card}.md'
    with path.open('a', encoding='utf8', newline='\n') as stream:
        stream.write('\n## Applied Source and regression verification\n\n')
        stream.write(f'Actual Source snapshot `{snapshot["sha256"]}` has 3,915 files. fmt/Clippy passed; focused316 and workspace4,940 tests passed with zero failed/ignored. ')
        stream.write('The four authored SUR04 IEEE counterexamples and four real-owner capture tests do not substitute for Native reference endpoints. ')
        stream.write('Ordinary execution, complete persistent boundary comparison and pending dependency/gate certification remain open.\n')
        stream.write(f'Evidence: [summary](../evidence/CTF-10-ordinary-history-capture-source/summary.json) (`{summary_ref["sha256"]}`).\n')
checklist=ROOT/'energyplus_porting_plan/CHECKLIST.md'
with checklist.open('a',encoding='utf8',newline='\n') as stream:
    stream.write('\nCTF/SUR Source 진행: 원본 순서의 내부면 식과 수동 이력 캡처를 적용했다. fmt/Clippy, 관련316개·전체4,940개 시험 통과(실패·무시0). ')
    stream.write('[실제 적용·검증 기록](evidence/CTF-10-ordinary-history-capture-source/summary.json). Native 경계 수치 비교와 남은 게이트는 미확인이다.\n')
assert subprocess.run(['python','-X','utf8','tools/porting/sync_plan_views.py','--write']).returncode==0
print(json.dumps({'summary':summary_ref,'objects':len(stored),'rows':len(rows),'unique_bytes':sum(r['size_bytes'] for r in stored.values()),'Source_snapshot':snapshot,'gates_changed':False}))

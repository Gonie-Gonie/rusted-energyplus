+pub(super) struct Stream<W> {
+    writer: W,
+    keys: Vec<CtfSurfaceGenerationKey>,
+    observed: usize,
+    written: usize,
+    error: Option<io::Error>,
+}
+impl<W: Write> Stream<W> {
+    pub(super) fn new(writer: W) -> Self {
+        let mut value = Self { writer, keys:Vec::new(), observed:0, written:0, error:None };
+        value.write(&json!({"schema":"ctf10-persistent-ordinary-history-stream.v1","record_type":"header",
+            "Native_fields_unavailable":["environment_id","environment_name","KickOffSimulation","calendar_year","calendar_month","calendar_day"],
+            "expected_endpoints_read":false,"Native_prestate_replayed":false,"all_instrumented_lifecycle_visits_without_caps_or_filters":true,"absent_lifecycle_is_not_observed_or_assumed_reached":true,"counted_as_PASS":false}));
+        value
+    }
+    fn write(&mut self, value: &Value) {
+        if self.error.is_some() { return; }
+        let result = serde_json::to_writer(&mut self.writer, value).map_err(io::Error::other)
+            .and_then(|()| self.writer.write_all(b"\n"));
+        if let Err(error) = result { self.error = Some(error); }
+    }
+    pub(super) fn record(&mut self, event: CtfHistoryObservation<'_>) {
+        self.observed += 1;
+        if self.error.is_some() { return; }
+        let generation = match self.keys.iter().position(|key| key == event.owner.generation_key) {
+            Some(index) => index + 1,
+            None => {
+                self.keys.push(event.owner.generation_key.clone());
+                let id = self.keys.len();
+                self.write(&json!({"schema":"ctf10-persistent-ordinary-generation.v1","record_type":"generation",
+                    "rust_local_generation_id":id,"identity_contract":"exact producer-retained Rust key Eq; no Native equality asserted",
+                    "context":generation_context(event.owner.generation_context),"counted_as_PASS":false}));
+                id
+            }
+        };
+        self.write(&json!({"schema":"ctf10-persistent-ordinary-history-event.v1","record_type":"event","boundary":format!("{:?}",event.boundary),
+            "rust_local_generation_id":generation,"caller_clock":event.caller_clock.map(clock),"begin_timestep_seconds_argument":event.begin_timestep_seconds_argument.map(scalar),"outdoor_dry_bulb_c":scalar(event.outdoor_dry_bulb_c),
+            "owner":{"initialized":event.owner.initialized,"current_clock":event.owner.current_clock.map(clock),"last_committed_clock":event.owner.last_committed_clock.map(clock),
+                "failure":event.owner.failure.map(|v|format!("{v:?}")),"history":history(event.owner.history),
+                "heat_transfer_groups":groups(event.owner.heat_transfer_groups),"opaque_groups":groups(event.owner.opaque_groups),
+                "all_heat_transfer_surfaces":event.owner.all_heat_transfer_surfaces.iter().map(|id|id.0).collect::<Vec<_>>()},
+            "public":event.public.map(public),"model_catalog":model_catalog(event.model),
+            "consumer_surfaces":event.consumer_surfaces.iter().map(consumer).collect::<Vec<_>>(),
+            "selected_inputs":event.selected_inputs.map(|values|values.iter().map(|v|json!({"surface_id":v.surface_id.0,"construction_id":v.construction_id.0,
+                "public_owner_construction_id":v.public_owner_construction_id.0,"coefficients":public_storage(v.coefficients),
+                "algorithm":format!("{:?}",v.algorithm),"ordinary_opaque":v.ordinary_opaque,"source_sink_present":v.source_sink_present,
+                "outside_boundary":format!("{:?}",v.outside_boundary),"outside_dry_bulb":scalar(v.outside_dry_bulb),"area":scalar(v.area),
+                "inside_surface_temperature":scalar(v.inside_surface_temperature),"inside_constant":scalar(v.inside_constant),"outside_constant":scalar(v.outside_constant)})).collect::<Vec<_>>()),
+            "selected_context":event.selected_context.map(context),"update_route":event.update_route.map(|v|format!("{v:?}")),"error":event.error.map(|v|format!("{v:?}")),"counted_as_PASS":false}));
+        if self.error.is_none() { self.written += 1; }
+    }
+    pub(super) fn finish(&mut self, actual_runtime_exit_code: i32, actual_message: &str) -> io::Result<()> {
+        self.write(&json!({"schema":"ctf10-persistent-ordinary-history-stream.v1","record_type":"summary",
+            "actual_runtime_exit_code":actual_runtime_exit_code,"actual_runtime_message":actual_message,
+            "actual_observed_event_count":self.observed,"actual_written_event_count":self.written,
+            "actual_Rust_generation_count":self.keys.len(),"capture_complete":self.error.is_none() && self.observed==self.written,
+            "boundary_reachability_verified":false,"numerical_comparison_performed":false,"integration_PASS_claimed":false,"counted_as_PASS":false}));
+        if let Some(error) = self.error.take() { return Err(error); }
+        self.writer.flush()
+    }
+}

"""Finish partial document publication; retain the failed inverse and preflight."""
import copy
import hashlib
import json
from pathlib import Path
import subprocess

ROOT = Path.cwd()
OUT = ROOT/'energyplus_porting_plan/evidence/CTF-10-ordinary-history-capture-source'
FIELD = 'actual_persistent_history_capture_source_and_quality'
def ref(path):
    data=path.read_bytes()
    return {'path':path.relative_to(ROOT).as_posix(),'sha256':hashlib.sha256(data).hexdigest(),'size_bytes':len(data)}
def dump(path,value):
    path.write_text(json.dumps(value,ensure_ascii=False,allow_nan=False,indent=2)+'\n',encoding='utf8',newline='\n')
def archive(path):
    identity=ref(path); target=OUT/'objects'/identity['sha256']
    if not target.exists(): target.write_bytes(path.read_bytes())
    assert ref(target)['sha256']==identity['sha256']
    return {'original':identity,'stored':ref(target)}

summary=ref(OUT/'summary.json')
manifest=json.loads((OUT/'manifest.json').read_text(encoding='utf8'))
for row in manifest['selected_objects']:
    assert ref(ROOT/row['stored']['path'])==row['stored']
plan_path=ROOT/'energyplus_porting_plan/plan.json'
plan=json.loads(plan_path.read_text(encoding='utf8'))
before=json.loads(subprocess.check_output(['git','show','HEAD:energyplus_porting_plan/plan.json']))
for task in plan['tasks']:
    if task['id'] in ['CTF-10','SUR-04']:
        assert task['evidence']=={FIELD:summary}
        del task['evidence']
        task[FIELD]=summary
inverse=copy.deepcopy(plan)
for task in inverse['tasks']:
    if task['id'] in ['CTF-10','SUR-04']: del task[FIELD]
assert inverse==before
dump(plan_path,plan)
for card in ['CTF-10','SUR-04']:
    path=ROOT/f'energyplus_porting_plan/cards/{card}.md'
    text=path.read_text(encoding='utf8')
    assert '## Applied Source and regression verification' not in text
    text+='\n## Applied Source and regression verification\n\n'
    text+='Actual Source `c3151a006de7251964fdfe2c203f6563a88dd71b992310aac0d2602a340e30e7` has3,915 files. fmt/Clippy passed; focused316 and workspace4,940 tests passed with zero failed/ignored. '
    text+='Four authored SUR04 IEEE regressions and four real-owner capture tests do not substitute for Native endpoints. Ordinary execution, complete persistent boundary comparison and pending dependency/gate certification remain open.\n'
    text+=f'Evidence: [summary](../evidence/CTF-10-ordinary-history-capture-source/summary.json) (`{summary["sha256"]}`).\n'
    path.write_text(text,encoding='utf8',newline='\n')
checklist=ROOT/'energyplus_porting_plan/CHECKLIST.md'
text=checklist.read_text(encoding='utf8')
text+='\nCTF/SUR Source 진행: 원본 순서의 내부면 식과 이력 관측을 적용했다. fmt/Clippy, 관련316개·전체4,940개 시험 통과(실패·무시0). '
text+='[실제 적용·검증 기록](evidence/CTF-10-ordinary-history-capture-source/summary.json). Native 경계 수치 비교와 남은 게이트는 미확인이다.\n'
checklist.write_text(text,encoding='utf8',newline='\n')
assert subprocess.run(['python','-X','utf8','tools/porting/sync_plan_views.py','--write']).returncode==0
paths=[Path(__file__).resolve()]
for directory in ['ordinary-history-source-publication-command-01','ordinary-history-invocation-01/ordinary-execution-command']:
    paths.extend((ROOT/'.runtime/porting/CTF-10'/directory/name) for name in ['receipt.json','stdout.log','stderr.log'])
paths.append(ROOT/'.runtime/porting/CTF-10/ordinary-history-invocation-01/capture/events.ndjson')
for name in ['diagnostics.json','eplusrs.err','run-summary.json','support-assessment.json','support-report.md']:
    paths.append(ROOT/'.runtime/porting/CTF-10/ordinary-history-invocation-01/ordinary-output'/name)
dump(OUT/'document-recovery-and-first-preflight.json',{'schema':'ctf10-source-documents-recovery.v1',
    'failed_document_attempt_retained':True,'cause':'New empty evidence containers were omitted from the inverse; finished progress references as explicit task fields and verified exact inverse to original HEAD plan.',
    'complete_plan_inverse_verified':True,'all_gate_values_unchanged':True,
    'first_ordinary_preflight':{'actual_exit_code':4,'Source_snapshot_unchanged':True,'actual_event_count':0,'actual_generation_count':0,'capture_complete_IO_only':True,'lifecycle_reachability_or_numeric_PASS':False},
    'selected_objects':[archive(path) for path in paths],
    'documents':[ref(ROOT/'energyplus_porting_plan'/p) for p in ['plan.json','CHECKLIST.md','cards/CTF-10.md','cards/SUR-04.md','cards/CTF-09.md','energyplus_porting_checklist.html']]})
print(json.dumps({'summary':summary,'document_recovery':ref(OUT/'document-recovery-and-first-preflight.json'),'Source_or_gate_changes':False}))

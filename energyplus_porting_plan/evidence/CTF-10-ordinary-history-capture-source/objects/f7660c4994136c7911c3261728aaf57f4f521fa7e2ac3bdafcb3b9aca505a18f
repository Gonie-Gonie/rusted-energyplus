--- /dev/null
+++ .runtime/porting/CTF-10/ordinary-history-invocation-prep-01/write_request.py
@@ -0,0 +1,183 @@
+"""Freeze reviewed input/policy and actual Cargo authority; execute nothing."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[4]
+CTF = ROOT / ".runtime/porting/CTF-10"
+EXPORTER = "0754e521a9bbc6eac7a26aa96bc5865626343a9df011cce21a6e984c09ae879e"
+POLICY = "5e59c6e3e73d840e982f79fee676033919c353e3ce4b35295385349ea9b31031"
+EXAMPLE = "ctf10_ordinary_history_observer"
+OBSERVER = ["crates/ep_run/examples/ctf10_ordinary_history_observer.rs",
+            "crates/ep_run/examples/ctf10_ordinary_history_support/fields.rs"]
+CONFIG = ["--config", "profile.dev.debug=0", "--config", "profile.test.debug=0",
+          "--config", "build.incremental=false", "--locked"]
+QUALITY = {
+    "fmt_check": ["cargo", "fmt", "--all", "--", "--check"],
+    "clippy": ["cargo", "clippy", *CONFIG, "--workspace", "--all-targets", "--", "-D", "warnings"],
+    "focused": ["cargo", "test", *CONFIG, "-p", "ep_runtime", "--lib", "heat_balance::"],
+    "workspace": ["cargo", "test", *CONFIG, "--workspace"],
+}
+BUILD = ["cargo", "build", *CONFIG, "-p", "ep_run", "--example", EXAMPLE,
+         "--message-format=json-render-diagnostics"]
+BOUND = []
+
+
+def require(value, message):
+    if not value:
+        raise ValueError(message)
+
+
+def contained(value):
+    path = (ROOT / value).resolve()
+    require(path.is_relative_to(ROOT), "Path leaves workspace")
+    return path
+
+
+def identity(path):
+    path = contained(path)
+    digest = hashlib.sha256()
+    size = 0
+    with path.open("rb") as source:
+        for block in iter(lambda: source.read(1024 * 1024), b""):
+            size += len(block)
+            digest.update(block)
+    return {"path": path.relative_to(ROOT).as_posix(), "sha256": digest.hexdigest(), "size_bytes": size}
+
+
+def bind(ref):
+    actual = identity(ref["path"])
+    require(actual["sha256"] == ref["sha256"] and
+            ("size_bytes" not in ref or actual["size_bytes"] == ref["size_bytes"]), "Bound bytes differ")
+    BOUND.append(actual)
+    return actual
+
+
+def operand(value):
+    path, sha = value.rsplit("#", 1)
+    return bind({"path": path, "sha256": sha})
+
+
+def read(ref):
+    return json.loads(contained(bind(ref)["path"]).read_text(encoding="utf-8"))
+
+
+def recorded(ref, current=True):
+    data = read(ref)
+    require(data["schema"] == "recorded-porting-command.v1" and data["exit_code"] == 0 and
+            data["launch_error"] is None and data["source_bytes_match_before_and_after"] is True,
+            "Successful guarded actual command required")
+    require(Path(data["cwd"]).resolve() == ROOT, "Recorder cwd differs")
+    for key in ("stdout", "stderr", "source_snapshot"):
+        bind(data[key])
+    launcher = bind(data["executed_launcher"]["archive"])
+    if current:
+        require(launcher["sha256"] == identity(ROOT / "tools/porting/record_command.py")["sha256"],
+                "Current reviewed recorder required")
+    return data
+
+
+def run(args):
+    preparation_ref = operand(args.source_manifest)
+    preparation = read(preparation_ref)
+    require(bind(preparation["writer"])["sha256"] == identity(Path(__file__))["sha256"], "Writer authority differs")
+    exporter_ref = bind(preparation["exporter_source_preparation"])
+    policy_ref = bind(preparation["pairing_policy_preparation"])
+    require(exporter_ref["sha256"] == EXPORTER and policy_ref["sha256"] == POLICY, "Reviewed Sources differ")
+    policy = bind(read(policy_ref)["own_sources"][0])
+    freeze_ref, freeze_execution_ref = operand(args.native_freeze), operand(args.native_freeze_execution)
+    freeze, freeze_execution = read(freeze_ref), recorded(freeze_execution_ref, current=False)
+    require(freeze["schema"] == "ctf10-surface-consumer-input-freeze.v1" and freeze["selected_case_id"] == "A-24H",
+            "Exact selected Native05 A24 freeze required")
+    require(freeze["native_source_manifest"]["sha256"] ==
+            "8eac3eb0ec2a28c91db06e5c9d02ab0611090b68095183569df58b8198a8a94c", "Native05 Source differs")
+    require(json.loads(contained(freeze_execution["stdout"]["path"]).read_text(encoding="utf-8")) == freeze,
+            "Actual freeze stdout differs")
+    require(freeze_execution["command"] == ["python", "-X", "utf8", "-B", freeze["executed_literal_writer"]["path"]],
+            "Literal Native freeze command differs")
+    bind(freeze["executed_literal_writer"])
+    guards = freeze["all45_fixed_input_guards"]
+    require(len(guards) == 45 and len({(row["case_id"], row["kind"]) for row in guards}) == 45, "Full45 guards required")
+    for row in guards:
+        bind(row["actual"])
+    for key in ("selected_input", "selected_weather", "selected_metadata", "selected_idd", "fixed_scope"):
+        bind(freeze[key])
+    review_ref, review_execution_ref = operand(args.original_review), operand(args.original_review_execution)
+    review_execution = recorded(review_execution_ref, current=False)
+    qa_command = review_execution["command"]
+    require(qa_command[qa_command.index("--freeze-receipt") + 1] ==
+            freeze_ref["path"] + "#" + freeze_ref["sha256"] and
+            contained(qa_command[qa_command.index("--output-dir") + 1]) / "review.json" == contained(review_ref["path"]),
+            "Released Original QA is not associated with this freeze/review")
+    review = read(review_ref)
+    require(review["schema"] == "ctf10-surface-consumer05-independent-original-data-review.v1" and
+            review["Original_capture_custody_released"] is True and
+            review["complete_actual_event_ledger_validated"] is True, "Genuine Native custody release required")
+    applied_ref = operand(args.applied_source)
+    quality_refs = {key: operand(getattr(args, key)) for key in QUALITY}
+    quality = {key: recorded(ref) for key, ref in quality_refs.items()}
+    for key, value in quality.items():
+        require(value["command"] == QUALITY[key], "Actual quality command differs")
+    build_ref = operand(args.build_execution)
+    build = recorded(build_ref)
+    require(build["command"] == BUILD, "Actual CargoJSON example build differs")
+    snapshot = bind(build["source_snapshot"])
+    require(all(value["source_snapshot"]["sha256"] == snapshot["sha256"] and
+                value["finished_utc"] <= build["started_utc"] for value in quality.values()),
+            "All four quality commands must precede build on the same raw Source")
+    source_rows = {row["historical_path"]: row for row in read(snapshot)["files"]}
+    observer_sources = [identity(ROOT / path) for path in OBSERVER]
+    for ref in observer_sources:
+        require(ref["sha256"] == bind(source_rows[ref["path"]]["archive"])["sha256"], "Observer is not actual built Source")
+    capture = build["cargo_compiler_artifacts_capture"]
+    require(capture["requested"] is True and capture["status"] == "pass", "Actual Cargo artifact capture required")
+    artifacts = [row for row in capture["rows"] if row["cargo_message"]["target"]["name"] == EXAMPLE and
+                 "example" in row["cargo_message"]["target"]["kind"]]
+    require(len(artifacts) == 1, "Exactly one emitted observer executable required")
+    artifact = artifacts[0]
+    executable = bind({"path": artifact["executable"]["historical_path"], "sha256": artifact["executable"]["sha256"]})
+    require(contained(artifact["cargo_message"]["executable"]) == contained(executable["path"]), "Cargo executable association differs")
+    output = contained(args.output_dir)
+    require(output.is_relative_to(CTF) and output != CTF and not output.exists(), "Fresh CTF request directory required")
+    metadata = read(freeze["selected_metadata"])
+    forecast = {"Source_only_planning_not_reachability": True, "declared_object_counts": metadata["object_counts"],
+                "declared_settings": {key: metadata["expected_settings"][key] for key in ("timesteps_per_hour", "building")},
+                "ordinary_success_path_events_per_step": 6, "initialization_events_per_reached_initialization": 2,
+                "raw_bytes_guaranteed": None, "allocation_and_actual_reachability_not_predicted": True,
+                "note": "Full19/public/catalog repeated per event; plan several GiB raw. No sample cap or branch/count assertion."}
+    output.mkdir(parents=True, exist_ok=False)
+    capture_parent = output / "capture"
+    capture_parent.mkdir()
+    policy_copy = output / "policy.json"
+    policy_copy.write_bytes(contained(policy["path"]).read_bytes())
+    require(identity(policy_copy)["sha256"] == policy["sha256"], "Policy bytecopy differs")
+    command = [str(contained(executable["path"])), str(contained(freeze["selected_input"]["path"])),
+               str(contained(freeze["selected_weather"]["path"])), str(output / "ordinary-output"), str(capture_parent / "events.ndjson")]
+    request = {"schema": "ctf10-persistent-ordinary-history-invocation-request.v1", "selected_case_id": "A-24H",
+        "invocation_source_preparation": preparation_ref, "executed_literal_writer": identity(Path(__file__)),
+        "exporter_source_preparation": exporter_ref, "pairing_policy_preparation": policy_ref,
+        "observation_policy_source": policy, "observation_policy": identity(policy_copy),
+        "Native_freeze": freeze_ref, "Native_freeze_execution": freeze_execution_ref,
+        "reviewed_Original_data": review_ref, "reviewed_Original_data_execution": review_execution_ref,
+        "actual_applied_source_inventory": applied_ref, "quality_executions": quality_refs,
+        "Source_snapshot": snapshot, "actual_Cargo_build_execution": build_ref, "actual_Cargo_emitted_artifact": artifact,
+        "observer_sources": observer_sources, "all45_fixed_input_guards": guards,
+        **{key: freeze[key] for key in ("selected_input", "selected_weather", "selected_metadata", "selected_idd", "fixed_scope")},
+        "command": command, "recorded_command": ["python", "-X", "utf8", "-B", "tools/porting/record_command.py",
+            "--output-dir", str(output / "ordinary-execution-command"), "--", *command],
+        "empty_capture_parent": str(capture_parent), "optional_before_run_directory_compression_command": ["compact", "/c", str(capture_parent)],
+        "footprint_forecast": forecast, "engine_execution_performed": False, "expected_values_supplied": False,
+        "Native_owner_values_supplied_to_Rust": False, "integration_PASS_claimed": False}
+    for ref in BOUND:
+        require(identity(ref["path"]) == ref, "Input/Source/artifact changed during writer")
+    (output / "request.json").write_text(json.dumps(request, ensure_ascii=False, allow_nan=False, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(request, ensure_ascii=False, allow_nan=False, indent=2))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ("source-manifest", "native-freeze", "native-freeze-execution", "original-review",
+                 "original-review-execution", "applied-source", "build-execution", "output-dir", *QUALITY):
+        parser.add_argument("--" + name.replace("_", "-"), required=True)
+    run(parser.parse_args())

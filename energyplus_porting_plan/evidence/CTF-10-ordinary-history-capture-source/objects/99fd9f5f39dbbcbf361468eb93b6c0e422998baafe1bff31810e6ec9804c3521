include!("ctf_history_capture_fixture.rs");
use crate::heat_balance::ctf_surface_lifecycle as lifecycle;
use std::rc::Rc;

fn two_steps(model: &SimulationModel, state: &mut HeatBalanceState) -> TestResult {
    for (step, first, outdoor) in [(1, true, 6.0), (2, false, 8.0)] {
        lifecycle::begin_step(&model.typed, state, Some(clock(step, first)), outdoor, 1200.0)
            .map_err(|error| format!("begin: {error:?}"))?;
        lifecycle::commit_step(&model.typed, state, outdoor)
            .map_err(|error| format!("commit: {error:?}"))?;
    }
    Ok(())
}

#[test]
fn borrowed_capture_preserves_two_real_owner_commits_and_all19() -> TestResult {
    let model = model();
    let mut plain = state(&model)?;
    let mut observed = plain.clone();
    two_steps(&model, &mut plain)?;
    let records = Rc::new(RefCell::new(Vec::new()));
    let sink = Rc::clone(&records);
    with_sink(true, move |event| {
        sink.borrow_mut().push((event.boundary, event.owner.history.clone(),
            event.owner.generation_key.clone(), event.caller_clock,
            event.owner.current_clock, event.owner.last_committed_clock,
            event.update_route, event.selected_inputs.map(|values| values.len())));
    }, || two_steps(&model, &mut observed))?;
    let plain_owner = plain.ctf_surface_lifecycle.as_ref().ok_or("plain owner")?;
    let actual_owner = observed.ctf_surface_lifecycle.as_ref().ok_or("observed owner")?;
    assert_eq!(plain_owner, actual_owner);
    assert_eq!(plain.surfaces[0].ctf, observed.surfaces[0].ctf);
    let records = records.borrow();
    assert_eq!(records.iter().filter(|row| row.0 == CtfHistoryBoundary::InitializationReturned).count(), 1);
    assert_eq!(records.iter().filter(|row| row.0 == CtfHistoryBoundary::CommitReturned).count(), 2);
    for row in records.iter() {
        assert_eq!(row.1.surface_ids, [SurfaceId(500)]);
        assert_eq!(row.2, *actual_owner.generation_key());
        for array in [&row.1.normal.inside_temperature, &row.1.normal.outside_temperature,
            &row.1.normal.inside_flux, &row.1.normal.outside_flux] {
            assert_eq!(array.len(), 19);
            assert!(array.iter().all(|values| values.len() == 1));
        }
        if row.0 == CtfHistoryBoundary::HistoryUpdateReturned {
            assert_eq!(row.6, Some(CtfThermalHistoryUpdateRoute::SimpleShift));
            assert_eq!(row.7, Some(1));
        }
        if row.0 == CtfHistoryBoundary::HistoryCommitBeforeClockRelease {
            assert_eq!(row.3, row.4);
            assert_eq!(row.4, row.5);
        }
        if row.0 == CtfHistoryBoundary::CommitReturned {
            assert!(row.4.is_none());
            assert_eq!(row.3, row.5);
        }
    }
    assert!(!is_active());
    Ok(())
}

#[test]
fn genuine_missing_clock_retains_owner_and_failure_without_commit() -> TestResult {
    let model = model();
    let mut state = state(&model)?;
    let before = state.ctf_surface_lifecycle.as_ref().ok_or("owner")?.history().clone();
    let records = Rc::new(RefCell::new(Vec::new()));
    let sink = Rc::clone(&records);
    let result = with_sink(true, move |event| {
        sink.borrow_mut().push((event.boundary, event.owner.history.clone(), event.error,
            event.owner.failure, event.owner.current_clock, event.owner.initialized,
            event.begin_timestep_seconds_argument));
    }, || lifecycle::begin_step(&model.typed, &mut state, None, 7.0, 1200.0));
    assert_eq!(result, Err(CtfSurfaceLifecycleUnavailable::MissingCallerClock));
    let records = records.borrow();
    assert_eq!(records.len(), 2);
    assert_eq!(records[0].0, CtfHistoryBoundary::BeginEntry);
    assert_eq!(records[1].0, CtfHistoryBoundary::BeginFailed);
    assert_eq!(records[1].2, result.err());
    assert_eq!(records[1].3, result.err());
    assert!(records.iter().all(|row| row.1 == before && row.4.is_none() && !row.5));
    assert!(records.iter().all(|row| row.6.map(f64::to_bits) == Some(1200.0_f64.to_bits())));
    Ok(())
}

#[test]
fn disabled_sink_and_more_than_old_trace_limit_are_honest() -> TestResult {
    let model = model();
    let mut state = state(&model)?;
    let count = Rc::new(RefCell::new(0_usize));
    let sink = Rc::clone(&count);
    let result = with_sink(false, move |_| *sink.borrow_mut() += 1,
        || lifecycle::begin_step(&model.typed, &mut state, None, 7.0, 1200.0));
    assert!(result.is_err());
    assert_eq!(*count.borrow(), 0);
    let sink = Rc::clone(&count);
    with_sink(true, move |_| *sink.borrow_mut() += 1, || {
        for _ in 0..10_001 {
            assert_eq!(lifecycle::begin_step(&model.typed, &mut state, None, 7.0, 1200.0),
                Err(CtfSurfaceLifecycleUnavailable::MissingCallerClock));
        }
    });
    assert_eq!(*count.borrow(), 20_002);
    Ok(())
}

#[test]
fn nested_and_unwinding_guards_restore_the_real_outer_sink() -> TestResult {
    let model = model();
    let mut state = state(&model)?;
    let outer = Rc::new(RefCell::new(Vec::new()));
    let inner = Rc::new(RefCell::new(Vec::new()));
    let sink = Rc::clone(&outer);
    with_sink(true, move |event| sink.borrow_mut().push(event.boundary), || -> TestResult {
        let sink = Rc::clone(&inner);
        with_sink(true, move |event| sink.borrow_mut().push(event.boundary), || {
            lifecycle::begin_step(&model.typed, &mut state, Some(clock(1, true)), 6.0, 1200.0)
        }).map_err(|error| format!("begin: {error:?}"))?;
        assert!(std::panic::catch_unwind(|| with_sink(true, |_| {}, || std::panic::resume_unwind(Box::new("authored capture unwind")))).is_err());
        lifecycle::commit_step(&model.typed, &mut state, 6.0)
            .map_err(|error| format!("commit: {error:?}"))?;
        Ok(())
    })?;
    assert!(inner.borrow().contains(&CtfHistoryBoundary::BeginReturned));
    assert!(!outer.borrow().contains(&CtfHistoryBoundary::BeginReturned));
    assert!(outer.borrow().contains(&CtfHistoryBoundary::CommitReturned));
    assert!(!is_active());
    Ok(())
}

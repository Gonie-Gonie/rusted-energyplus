//! Run the existing ordinary pipeline once with a passive full-owner stream.
#[path = "ctf10_ordinary_history_support/fields.rs"]
mod fields;
use ep_run::{
    PartialRunPolicy, PortingScope, RunConfig, RunMode, RunOutputFormat, TraceLevel, TraceSelection,
    run_bounded_porting,
};
use ep_runtime::heat_balance::ctf_history_capture::with_sink;
use std::{cell::RefCell, error::Error, fs::OpenOptions, io::BufWriter, path::PathBuf, rc::Rc};

fn run() -> Result<i32, Box<dyn Error>> {
    let args = std::env::args_os().skip(1).collect::<Vec<_>>();
    if args.len() != 4 {
        return Err(
            "input, weather, fresh run output directory and fresh NDJSON path required".into(),
        );
    }
    let config = RunConfig {
        input_path: PathBuf::from(&args[0]),
        weather_path: Some(PathBuf::from(&args[1])),
        output_dir: PathBuf::from(&args[2]),
        mode: RunMode::Compatibility,
        partial_policy: PartialRunPolicy::Deny,
        output_format: RunOutputFormat::RustNative,
        overwrite: false,
        keep_intermediate: true,
        trace_level: TraceLevel::Off,
        trace_selection: TraceSelection::default(),
        fail_on_warning: false,
        dry_run: false,
        oracle_baseline: false,
        compare_oracle: false,
        json_stdout: false,
        oracle_root: None,
        hours: None,
    };
    let file = OpenOptions::new()
        .write(true)
        .create_new(true)
        .open(PathBuf::from(&args[3]))?;
    let stream = Rc::new(RefCell::new(fields::Stream::new(BufWriter::new(file))));
    let sink = Rc::clone(&stream);
    let actual = with_sink(
        true,
        move |event| sink.borrow_mut().record(event),
        || run_bounded_porting(&config, PortingScope::A),
    );
    let (code, message) = match &actual {
        Ok(value) => (value.exit_code.code(), value.message.as_str()),
        Err(error) => (error.exit_code.code(), error.message.as_str()),
    };
    // Sink failure never changes the real solver result/call order. It makes
    // this observer incomplete and failing after the original caller returns.
    stream.borrow_mut().finish(code, message)?;
    if let Err(error) = actual {
        eprintln!("{error}");
    }
    Ok(code)
}
fn main() {
    match run() {
        Ok(code) => std::process::exit(code),
        Err(error) => {
            eprintln!("{error}");
            std::process::exit(2);
        }
    }
}

"""Archive the actual caller correction and post-correction quality facts."""
import copy
import hashlib
import json
from pathlib import Path
import re
import subprocess

ROOT = Path.cwd()
RAW = ROOT / '.runtime/porting/CTF-10'
OUT = ROOT / 'energyplus_porting_plan/evidence/CTF-10-ordinary-history-capture-source'
def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(), 'size_bytes': len(data)}
def dump(path, data):
    path.write_text(json.dumps(data, ensure_ascii=False, allow_nan=False, indent=2)+'\n', encoding='utf8', newline='\n')
def load(path):
    return json.loads(path.read_text(encoding='utf8'))

destination = OUT / 'entry-and-quality.json'
assert not destination.exists()
post_path = RAW / 'ordinary-history-entry-applied-01/record.json'
post = load(post_path)
snapshot = post['source_final']
assert snapshot['sha256'] == 'e2dd7f51e2eda2899f028f281cbbb9d9d58690486754cc44c44c383101adf255'
selected = {Path(__file__).resolve(), RAW/'apply-ordinary-history-entry-01.py'}
for name in ['ordinary-history-stack-correction-prep-01', 'ordinary-history-entry-applied-01',
             'ordinary-history-entry-format-command-01', 'ordinary-history-entry-application-command-01',
             'ordinary-history-quality-03', 'ordinary-history-build-command-03',
             'ordinary-history-source-document-recovery-command-01']:
    selected.update(p for p in (RAW/name).rglob('*') if p.is_file() and '__pycache__' not in p.parts)
for name in ['receipt.json','stdout.log','stderr.log']:
    selected.add(RAW/'ordinary-history-invocation-02/ordinary-execution-command'/name)
selected.add(RAW/'ordinary-history-invocation-02/capture/events.ndjson')
for key in ['source_before','source_literal','source_final']:
    selected.add(ROOT/post[key]['path'])
for row in post['application']:
    selected.add(ROOT/row['actual_final_archive']['path'])
    assert ref(ROOT/row['canonical_path']) == row['actual_final']
quality = []
for role in ['fmt-check','clippy','focused','workspace']:
    path = RAW/f'ordinary-history-quality-03/{role}-command/receipt.json'
    value = load(path)
    assert value['exit_code'] == 0 and value['source_bytes_match_before_and_after'] is True and value['source_snapshot'] == snapshot
    stdout = (ROOT/value['stdout']['path']).read_text(encoding='utf8')
    groups = re.findall(r'test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored;', stdout)
    totals = [sum(int(row[i]) for row in groups) for i in range(3)]
    assert totals == ([316,0,0] if role=='focused' else [4940,0,0] if role=='workspace' else [0,0,0])
    quality.append({'role':role, 'execution':ref(path), 'test_totals':totals, 'test_result_groups':len(groups)})
build_path = RAW/'ordinary-history-build-command-03/receipt.json'
build = load(build_path)
assert build['exit_code'] == 0 and build['source_bytes_match_before_and_after'] is True and build['source_snapshot'] == snapshot
stored = {}
for object_dir in (ROOT/'energyplus_porting_plan/evidence').glob('*/objects'):
    for path in object_dir.iterdir():
        if path.is_file() and re.fullmatch('[0-9a-f]{64}', path.name):
            stored.setdefault(path.name, path)
rows = []
for path in sorted(selected):
    original = ref(path)
    target = stored.get(original['sha256'], OUT/'objects'/original['sha256'])
    if not target.exists(): target.write_bytes(path.read_bytes())
    identity = ref(target)
    assert identity['sha256'] == original['sha256'] and identity['size_bytes'] == original['size_bytes']
    stored[original['sha256']] = target
    rows.append({'original':original,'stored':identity})
dump(destination, {'schema':'ctf10-observer-entry-source-and-quality.v1',
    'parent_source_summary':ref(OUT/'summary.json'), 'scoped_caller_summary':ref(OUT/'scoped-caller-and-quality.json'), 'initial_failure_and_document_recovery':ref(OUT/'document-recovery-and-first-preflight.json'),
    'actual_caller_application':ref(post_path), 'Source_snapshot':snapshot, 'Source_file_count':3915,
    'unchanged_unrelated_source_files':3913, 'actual_quality':quality, 'actual_Cargo_build':ref(build_path),
    'selected_objects':rows, 'semantic_change':'Match the existing CLI 8 MiB worker stack with all runtime and sink owners on that worker; remove one fixture EOF blank line. Keep strict A/Deny/input/math/policy.',
    'ordinary_numerical_comparison_performed':False, 'ordinary_lifecycle_reachability_certified':False, 'card_gates_updated':False})
summary = ref(destination)
plan_path = ROOT/'energyplus_porting_plan/plan.json'
plan = load(plan_path)
old_plan = copy.deepcopy(plan)
task = next(row for row in plan['tasks'] if row['id']=='CTF-10')
field = 'actual_persistent_history_entry_and_quality'
assert field not in task
task[field] = summary
inverse = copy.deepcopy(plan)
del next(row for row in inverse['tasks'] if row['id']=='CTF-10')[field]
assert inverse == old_plan
dump(plan_path, plan)
card = ROOT/'energyplus_porting_plan/cards/CTF-10.md'
text = card.read_text(encoding='utf8')
text += '\n## Applied observer stack correction\n\n'
text += f'Actual Source `{snapshot["sha256"]}` keeps3,915 files;3,913 unrelated files are byte-exact. The example now uses the existing CLI 8 MiB worker stack with strict A/Deny. fmt/Clippy and focused316/workspace4,940 tests passed (zero failed/ignored), followed by the actual CargoJSON example build. Both the initial unscoped exit4/zero-event attempt and scoped Windows stack-overflow attempt remain preserved; the latter has an empty stream and no completion footer. Ordinary lifecycle reachability and numerical comparison remain unverified; no card gates changed.\n'
text += f'Evidence: [observer entry and quality](../evidence/CTF-10-ordinary-history-capture-source/entry-and-quality.json) (`{summary["sha256"]}`).\n'
card.write_text(text, encoding='utf8', newline='\n')
checklist = ROOT/'energyplus_porting_plan/CHECKLIST.md'
with checklist.open('a',encoding='utf8',newline='\n') as stream:
    stream.write('\nCTF-10 observer now uses the existing CLI 8 MiB worker stack with strict A/Deny. Focused316/workspace4,940 tests passed with zero failed/ignored. [Actual entry and quality](evidence/CTF-10-ordinary-history-capture-source/entry-and-quality.json). Ordinary reachability and numerical comparison remain unverified.\n')
assert subprocess.run(['python','-X','utf8','-B','tools/porting/sync_plan_views.py','--write']).returncode == 0
print(json.dumps({'summary':summary,'Source_snapshot':snapshot,'archived_paths':len(rows),'gates_changed':False}))

import difflib
import hashlib
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
spec = importlib.util.spec_from_file_location('recorder', ROOT / 'tools/porting/record_command.py')
rec = importlib.util.module_from_spec(spec)
spec.loader.exec_module(rec)
OUT = ROOT / '.runtime/porting/CTF-10/ordinary-history-capture-applied-01'

def checked(ref):
    data = (ROOT / ref['path']).read_bytes()
    assert hashlib.sha256(data).hexdigest() == ref['sha256'], ref['path']
    if 'size_bytes' in ref:
        assert len(data) == ref['size_bytes'], ref['path']
    return data

def rows(snapshot):
    return {r['historical_path']: r['archive']['sha256'] for r in json.loads(checked(snapshot))['files']}

assert len(sys.argv) == 3 and not OUT.exists()
card_ref = {'path': sys.argv[1], 'sha256': sys.argv[2]}
card = json.loads(checked(card_ref))
prep_ref = {'path': '.runtime/porting/CTF-10/ordinary-history-capture-prep-01/manifest.json', 'sha256': '0754e521a9bbc6eac7a26aa96bc5865626343a9df011cce21a6e984c09ae879e'}
prep = json.loads(checked(prep_ref))
applications = [*card['application'], *prep['application']]
for row in applications:
    if row['actual_before'] is None:
        assert not (ROOT / row['canonical_path']).exists()
        assert checked(row['before_archive']) == b''
    else:
        assert checked(row['actual_before']) == checked(row['before_archive'])
    checked(row['proposal'])
    checked(row['exact_diff'])
before = rec.source_snapshot()
OUT.mkdir()
for row in applications:
    target = ROOT / row['canonical_path']
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(checked(row['proposal']))
literal = rec.source_snapshot()
fmt_dir = '.runtime/porting/CTF-10/ordinary-history-capture-format-command-01'
code = subprocess.run([sys.executable, 'tools/porting/record_command.py', '--output-dir', fmt_dir, '--', 'cargo', 'fmt', '--all'], cwd=ROOT).returncode
assert code == 0
final = rec.source_snapshot()
fmt = json.loads((ROOT / fmt_dir / 'receipt.json').read_text(encoding='utf8'))
assert fmt['source_snapshot'] == literal
before_rows, final_rows = rows(before), rows(final)
new = {r['canonical_path'] for r in prep['application'] if r['actual_before'] is None}
changed = {r['canonical_path'] for r in prep['application']}
assert before_rows.keys() | new == final_rows.keys()
assert all(before_rows[p] == final_rows[p] for p in before_rows.keys() - changed)
applied = []
for index, row in enumerate(prep['application']):
    path = ROOT / row['canonical_path']
    data = path.read_bytes()
    delta = ''.join(difflib.unified_diff(checked(row['proposal']).decode('utf8').splitlines(keepends=True), data.decode('utf8').splitlines(keepends=True), fromfile=row['proposal']['path'], tofile=row['canonical_path'])).encode('utf8')
    diffpath = OUT / f'formatter-{index + 1}.diff'
    diffpath.write_bytes(delta)
    applied.append({**row, 'actual_final': {**rec.ref(path), 'size_bytes': len(data)}, 'actual_formatter_diff': {**rec.ref(diffpath), 'size_bytes': len(delta)}, 'actual_final_archive': rec.store_bytes(data)})
record = {'schema': 'ctf10-ordinary-history-actual-literal-application.v1', 'card_supplement': card_ref, 'implementation_preparation': prep_ref, 'source_before': before, 'source_literal': literal, 'source_final': final, 'source_file_count': len(final_rows), 'unrelated_source_files_verified_byte_exact': len(before_rows.keys() - changed), 'actual_format_receipt': rec.ref(ROOT / fmt_dir / 'receipt.json'), 'application': applied, 'numerical_comparison_performed': False, 'gates_updated': False}
record_path = OUT / 'record.json'
record_path.write_bytes(rec.json_bytes(record))
print(json.dumps({'record': rec.ref(record_path), 'final_source': final, 'unrelated_files': record['unrelated_source_files_verified_byte_exact']}))

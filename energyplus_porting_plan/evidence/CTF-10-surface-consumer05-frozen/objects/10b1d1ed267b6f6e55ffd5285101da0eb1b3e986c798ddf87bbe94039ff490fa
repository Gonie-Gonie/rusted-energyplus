def put(name, data):
    path = HERE / name
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        if name in ["review_data.py", "event_shape.py"]:
            path.write_bytes(data)
        else:
            assert path.read_bytes() == data
        return
    with path.open("xb") as handle:
        handle.write(data)


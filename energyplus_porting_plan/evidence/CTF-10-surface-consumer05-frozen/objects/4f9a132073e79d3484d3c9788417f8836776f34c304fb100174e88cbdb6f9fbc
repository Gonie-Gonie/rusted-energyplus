def ref(path):
    path = Path(path)
    assert path.suffix.lower() not in [".exe", ".obj", ".idf", ".epw"]
    data = path.read_bytes()
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": hashlib.sha256(data).hexdigest(),
            "size_bytes": len(data), "line_count": len(data.splitlines())}


def put(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data)


def delta(before, after):
    data = "".join(difflib.unified_diff(before.read_text(encoding="utf-8").splitlines(True),
        after.read_text(encoding="utf-8").splitlines(True), fromfile=ref(before)["path"],
        tofile=ref(after)["path"])).encode("utf-8")
    target = HERE / "diffs" / (after.name + ".diff")
    put(target, data)
    return {"before": ref(before), "after": ref(after), "exact_diff": ref(target)}



def ref(path):
    b = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(b).hexdigest(),
            'size_bytes': len(b), 'line_count': len(b.splitlines())}

def put(name, text):
    p = OUT / name
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('x', encoding='utf-8', newline='\n') as stream: stream.write(text)
    return p

def copy(name, source):
    p = OUT / name
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as stream: stream.write(source.read_bytes())
    return p

def store(name, value): return put(name, json.dumps(value, indent=2) + '\n')


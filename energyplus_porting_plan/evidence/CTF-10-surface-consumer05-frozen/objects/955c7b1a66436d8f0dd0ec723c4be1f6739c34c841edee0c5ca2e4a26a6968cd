"""Stdlib Source-only manifest seal. Never imports or executes workflow code."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path.cwd()
OUT = Path(__file__).resolve().parent
BASE = ROOT / '.runtime/porting/CTF-10'
assert not (OUT/'manifest.json').exists()

def ref(path):
    path = ROOT/path if not isinstance(path,Path) else path
    data=path.read_bytes()
    return {'path':path.relative_to(ROOT).as_posix(),'sha256':hashlib.sha256(data).hexdigest(),
            'size_bytes':len(data),'line_count':len(data.splitlines())}

def primary(path,start,end,purpose):
    lines=(ROOT/path).read_bytes().splitlines(keepends=True)
    assert 1<=start<=end<=len(lines)
    data=b''.join(lines[start-1:end])
    return {'path':path,'start_line':start,'end_line':end,'sha256':hashlib.sha256(data).hexdigest(),
            'size_bytes':len(data),'purpose':purpose}


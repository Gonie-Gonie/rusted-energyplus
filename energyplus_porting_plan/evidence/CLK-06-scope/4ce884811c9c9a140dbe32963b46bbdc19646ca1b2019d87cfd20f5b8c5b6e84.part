  "input_scope_expanded": false,
  "science_contract_frozen": false,
  "canonical_card_or_plan_written": false,
  "scope_decision": {
    "selected_lane": "CON RunPeriodWeather defaults: WP_Type1=0, skyTempModel=ClarkAllen(0), UseWeatherFileHorizontalIR=true",
    "source_registration_reason": "All15 admitted IDF inputs contain zero WeatherProperty:SkyTemperature objects; source Environment defaults remain unless conditional WP_Type1 property override exists. Actual prepared model/useIR observations remain required in future reference metadata.",
    "selected_branches": [
      "0<IRHoriz<9999: actual supplied IR copied; effective sky computed with source root4.",
      "IRHoriz<=0 first becomes9999; IRHoriz>=9999 selects default ClarkAllen calculation."
    ],
    "future_unverified": [
      "UseWeatherFileHorizontalIR=false/forced recomputation",
      "Brunt and Idso with cached PsyPsatFnTemp",
      "BerdahlMartin",
      "ScheduleValue/DryBulbDelta/DewPointDelta and post-read schedules",
      "design-day sky generation/EMS overrides/full InputProcessor parity",
      "non-hourly source files (NumIntervalsPerHour>1)",
      "current solar/night geometry and SRC04/SRC08 coefficient/heat-flux numerical parity"
    ]
  },
  "proposed_prerequisites": [
    "CLK-02",
    "CLK-03",
    "CLK-04",
    "CLK-05"
  ],
  "downstream_SRC08_is_not_a_prerequisite_or_pass_claim": true,
  "selected_input_units": {
    "DryBulb": "degC, processed hourly or interpolated Today operand",
    "DewPoint": "degC, processed hourly or interpolated Today operand",
    "RelHum": "fraction passed to helper; stored OutRelHum remains percent and caller multiplies0.01 exactly; default ClarkAllen does not evaluate RH",
    "OpaqueSkyCover": "tenths, not fraction; use actual processed opaque cover, not total cover",
    "IRHoriz": "W/m2 native numerical rate convention at selected source interval1; legacy raw property name Wh_per_m2 is not an instruction to divide by zone steps",
    "skyTempModel": "exact ClarkAllen enum0",
    "UseWeatherFileHorizontalIR": "exact true in selected lane"
  },
  "selected_output_units": {
    "ESky": "dimensionless; standalone CalcSkyEmissivity return only, no fabricated observation of calcSky local",
    "HorizIRSky": "W/m2",
    "SkyTemp": "degC",
    "SkyTempKelvin": "K only actual SetCurrent owner copy if explicitly observed"
  },
  "source_math": {
    "minimum": "ObjexxFCL double min(a,b) = a<b ? a:b; admitted default min(DryBulb,DewPoint)",
    "clear_emissivity": "0.787 + 0.764 * log((min(DryBulb,DewPoint) +273.15)/273.15)",
    "cloud_multiplier": "1.0 +0.0224*OSky -0.0035*pow2(OSky) +0.00028*pow3(OSky), original left-to-right expression",
    "missing_IR": "ESky *5.6697e-8 *pow4(DryBulb+273.15)",
    "missing_SkyTemp": "(DryBulb+273.15)*root4(ESky)-273.15",
    "valid_IR": "HorizIRSky=IRHoriz; SkyTemp=root4(IRHoriz/5.6697e-8)-273.15",
    "pow4": "t=x*x; t*t",
    "root4": "sqrt(sqrt(x))",
    "no_extra_generic_clamp_or_fallback": "Do not add max(0), air-temperature fallback, emissivity clipping, RH/cover normalization, Horner/FMA rewrite or source counter replay.",
    "selected_PSY_helper_dependency": null,
    "mathematical_formulas_are_documented_primary_source_not_reference_answers_supplied_to_production": true
  },
  "hourly_owner_order": [
    "Admit literal source date/hour and parse raw IR mandatory[6], total[16], opaque[17] without altering raw bytes.",
    "IR<=0 ->9999; negative Total/Opaque ->99 at original preceding scalar positions.",
    "Apply existing source dry/dew/RH missing/range handling, then cover>=99 substitution from actual missing cache and increment each selected count.",
    "Write Tomorrow hourly dry/dew/RHpercent/cover; pass RH*0.01 plus processed dry/dew/opaque and IR to actual default calcSky.",
    "Store actual computed HorizIRSky/SkyTemp in hourly Tomorrow before scalar/cover missing-history update; preserve RH percent/fraction/roundtrip order."
  ],
  "subhour_owner_order": [
    "Only source NumIntervalsPerHour==1 and steps>1 enters interpolation; steps1 keeps hourly outputs and does not advance LastHour/NextHour interpolation caches.",
    "Copy complete processed hourly carriers; if LastHourSet=false select actual Hour1 or Hour24 per frozen first policy.",
    "Use stored Interpolation(ts); interpolate processed dry/dew/RHpercent/total/opaque and processed hourly HorizIRSky.",
    "Call calcSky again with interpolated opaque/dry/dew/RHpercent*0.01 and interpolated processed IR. Do not interpolate SkyTemp or raw sentinel/preview IR.",
    "A hourly missing-IR calculation may yield a valid processed IR used by the subhour valid-IR branch; record actual branch rather than assuming missing status propagates.",
    "After all steps of each hour, update complete LastHour with the actual processed hourly carrier; source next cache continues only Beam/Dif/Liquid writes.",
    "UpdateWeatherData copies completed Tomorrow grid to Today once in existing handoff order before current/consumer."
  ],
  "required_production_transport": [
    "Bind actual selected model/useIR to authenticated absent-object CON inputs before first read; no source/default inference from numerical outputs.",
    "Observe actual Today.HorizIRSky and Today.SkyTemp at correct hour/step in a new frozen sky2 projection.",
    "Carry Today.HorizIRSky into ProductionWeatherContext.sample.horizontal_infrared_radiation_w_per_m2 or an explicit owned accessor; existing sample preview IR is not parity.",
    "Carry actual Today.SkyTemp as owned context.weather.sky_temp; retain source Weather.HorizIRSky and Environment.SkyTemp/SkyTempKelvin only if actual owners are introduced/observed.",
    "Prove Initialize ->SetCurrent ->actual consumer completion-prefix order; repeated first seed consumer reuses the same actual sky/IR payload, not recalculated metadata.",
    "Run unchanged A-24H/A-72H/B-BOTH-24H Full and Summary (six ordinary CLI runs) with recorded actual build/source/input/ENV before-after and no expected-output injection.",
    "Compare native sky2 at matching selected phase plus exact within-Rust Today ->sample/report/thermal operand copies; SRC08 downstream exchange coefficients/heat flux remain unpaired."
  ],
  "required_case_families": [
    {
      "id": "default-model-registration",
      "coverage": "All15 admitted IDF absence plus actual prepared ClarkAllen/useIRtrue; invalid or unsupported model inputs are not silently admitted."
    },
    {
      "id": "IR-branch-boundaries",
      "coverage": "Declared finite IR negative, -0.0, +0.0, small positive, ordinary supplied, immediately below9999, exactly9999 and above9999; real branch/type outcomes retained."
    },
    {
      "id": "opaque-clear-cloudy-minimum",
      "coverage": "Opaque0/5/10; Dry below/equal/above Dew; cold/warm finite inputs; total and opaque deliberately differ to expose wrong operand."
    },
    {
      "id": "RH-percent-fraction",
      "coverage": "Stored percent and helper fraction recorded at hourly and subhour calls; default result should have no hidden RH-based alternative helper evaluation."
    },
    {
      "id": "cover-missing-history",
      "coverage": "Negative and99 boundaries; initial true cache5, prior valid covers, subsequent missing values, separate Total/Opaque counts, warning flag independence and untouched raw/canary fields."
    },
    {
      "id": "hourly-subhour-source-order",
      "coverage": "Steps1/3/4; constant/ramp/two-day data; Hour1/Hour24 seeds; hour24/hour1 cache carry; processed IR and cloud interpolation before sky calculation; source stored weights canary."
    },
    {
      "id": "handoff-and-consumers",
      "coverage": "Genuine BeginEnvironment/BeginDay/Run2/end order, appropriate warmup repetition if independently frozen, unchanged other slots/counters/controls, actual owned IR+Sky sample/report/thermal handoff."
    }
  ],
  "proposed_precision_not_frozen": {
    "ClarkAllen_emissivity": {
      "unit": "1",
      "atol": 1e-13,
      "rtol": 1e-13
    },
    "SkyTemp": {
      "unit": "degC",
      "atol": 1e-10,
      "rtol": 1e-13
    },
    "HorizIRSky": {
      "unit": "W/m2",
      "atol": 1e-10,
      "rtol": 1e-13
    },
    "cloud_interpolation_operands": {
      "unit": "tenths",
      "atol": 1e-12,
      "rtol": 0.0
    },
    "discrete_controls_counts_shapes_clocks_call_history": "typed exact; no optional-null PASS",
    "same_owned_value_transport": "exact scalar bit/class identity; no tolerant reinterpretation",
    "Root_must_read_and_freeze_variable_policy_before_first_new_numerical_outputs": true
  },
  "unavailability_limits": [
    "C5 native Today/Tomorrow/selected-slot serializers are solar2-only; native sky2 was unavailable there. Last/Next/Missing full17 do not prove C5 sky grid generation.",
    "Existing C3/C4 full17 and current CLI full17 are historical observations, not newly paired C6 evidence. Their source/input/history and selected scope would need a separate preexecution admission before reuse.",
    "No fabrication of private hourly native locals, local ESky inside calcSky, full Factory state, hidden schedule/PSY counters or current sky globals absent from Rust owners.",
    "Required selected sky/IR fields must be actual available operands. Both-null remains unavailable/no numerical comparison/no PASS; one-sided absence is an availability failure.",
    "Nonfinite/out-of-supported-domain cases require separate explicit input admission; no invented finite fallback or zero value.",
    "Complete actual invocation/returned/sourcefatal/skipped coverage and typed raw scalar bits/classes are mandatory; factual metadata0 cannot become numerical PASS."
  ],
  "reuse_review": {
    "matching_existing_constants": true,
    "legacy_longwave_helper_default_missing_behavior_equivalent": false,
    "legacy_longwave_helper_fourth_root_source_order_equivalent": false,
    "legacy_WeatherTimestepSeries_public_API_preservation_required": true,
    "canonical_sky_owner_not_yet_ported_or_certified": true,
    "no_existing_CLK05_sky_claim_extended": true
  },

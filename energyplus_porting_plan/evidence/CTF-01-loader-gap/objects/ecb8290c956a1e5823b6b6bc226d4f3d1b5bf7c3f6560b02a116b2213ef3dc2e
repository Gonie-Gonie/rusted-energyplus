+
+    def absence(self, path, native_available, rust_available, required, reason):
+        self.unavailable.append({"path": path, "Native_available": native_available, "Rust_available": rust_available,
+                                 "required": required, "reason": reason, "counted_as_PASS": False})
+        if required:
+            self.failure(path, "availability_failures", native_available, rust_available)

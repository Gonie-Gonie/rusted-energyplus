"""Factual Original data/provenance review; no engine, CTF evaluator or numerical comparison."""
import argparse
import hashlib
import importlib.util
import json
import re
from datetime import datetime, timezone
from pathlib import Path

PREP = Path(__file__).resolve().parent
IO_SHA = "023296e2524afe4a3df24bba1bfe379dfa9197b2f2681ef833350769a3aff16d"
SHAPE_SHA = "2a970b84dfba58d440d96483e42cee647e3a1942f0dd90e6de886e1ac89debe2"
PE_READER_SHA = "42370e6a8c34ba19b1845d99cfc265194ab989566831e2c1948962342c0068cc"


def boot(name, filename, digest):
    path = PREP / filename
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise ValueError("Reviewed stdlib reader dependency differs before import")
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    return module


def run(args):
    m = boot("ctf01_production_data_io", "packet_io.py", IO_SHA)
    shape = boot("ctf01_production_data_shape", "shape.py", SHAPE_SHA)
    started = datetime.now(timezone.utc).isoformat()
    m.require(m.identity(__file__)["sha256"] == args.approved_source_sha256, "Root-reviewed reader SHA required")
    for path in [Path(__file__), PREP / "shape.py", PREP / "packet_io.py"]: m.bind(m.identity(path))
    m.require(Path.cwd().resolve() == m.ROOT, "Recorded repository cwd required")

    def same(left, right):
        for row in [left, right]:
            m.require(re.fullmatch("[0-9a-f]{64}", row["sha256"]), "Actual reference SHA required")
        m.require(m.contained(left["path"], existing=False) == m.contained(right["path"], existing=False) and
                  left["sha256"] == right["sha256"], "Actual direct artifact identities differ")

    def instant(text):
        value = datetime.fromisoformat(text.replace("Z", "+00:00"))
        m.require(value.tzinfo is not None, "Aware actual UTC interval required")
        return value

    def recorded(ref, before=None, require_zero=True):
        value = m.load(ref)
        m.require(value["schema"] == "recorded-porting-command.v1" and type(value["exit_code"]) is int and
                  value["source_bytes_match_before_and_after"] is True and Path(value["cwd"]).resolve() == m.ROOT,
                  "Genuine source-preserving repository recorder required")
        if require_zero:
            m.require(value["exit_code"] == 0 and value["launch_error"] is None, "Actual successful recorded command required")
        m.require(instant(value["started_utc"]) <= instant(value["finished_utc"]), "Actual command interval differs")
        if before is not None:
            m.require(instant(value["finished_utc"]) <= instant(before), "Required preceding actual command is later")
        for key in ["stdout", "stderr"]: m.bind(value[key])
        m.require(value["executed_launcher"]["historical_path"] == "tools/porting/record_command.py", "Actual recorder source owner differs")
        m.bind(value["executed_launcher"]["archive"])
        return value

    names = ["native-execution", "results", "freeze-receipt", "freeze-execution", "build", "build-execution", "build-review", "build-review-execution"]
    refs = {name: m.argument(getattr(args, name.replace("-", "_"))) for name in names if name != "results"}
    native = recorded(refs["native-execution"], started, require_zero=False)
    freeze = m.load(refs["freeze-receipt"])
    frozen_command = recorded(refs["freeze-execution"], native["started_utc"])
    m.require(m.load(frozen_command["stdout"]) == freeze and freeze["schema"] == "ctf01-production-frozen-packet.v1" and
              freeze["status"] == "frozen-input-and-inherited-zero-policy-before-production-helper" and
              freeze["frozen_before_this_production_helper_execution"] is True and freeze["numeric_PASS_claimed"] is False,
              "Genuine input-only freeze0/full recorder stdout required")
    writer = m.bind(freeze["executed_writer"])
    m.require(len(frozen_command["command"]) == 7 and Path(frozen_command["command"][0]).name.lower() in ["python", "python.exe"] and
              frozen_command["command"][1:4] == ["-X", "utf8", "-B"] and frozen_command["command"][5] == "--output-dir" and
              m.contained(frozen_command["command"][4]) == m.contained(writer["path"]) and
              m.contained(frozen_command["command"][6], existing=False) == m.contained(freeze["helper_request"]["path"]).parent,
              "Actual frozen-packet writer command/source/output differs")
    request_ref, admission_ref, projection_ref = freeze["helper_request"], freeze["native_admission_contract"], freeze["projection"]
    request, admission, projection = m.load(request_ref), m.load(admission_ref), m.load(projection_ref)
    m.require(request["schema"] == "ctf01-production-helper-cases.v1" and admission["schema"] == "ctf01-production-native-admission-contract.v1" and
              projection["schema"] == "ctf01-production-observation-projection.v1", "Actual frozen CTF packet schemas required")
    same(admission["helper_request"], request_ref); same(admission["projection"], projection_ref); same(projection["helper_request"], request_ref)
    m.require(set(request["contracts"]) == {"source", "tolerances"} and set(admission["contracts"]) == {"source", "cases", "tolerances"} and
              admission["contracts"] == projection["contracts"] == freeze["contracts"] and
              projection["native_observation_policy"] == request["observation_policy"], "Actual one-way contract policy differs")
    for value in [freeze, request, admission, projection]:
        m.require(value["frozen_before_this_production_helper_execution"] is True and value["expected_values_supplied"] is False and
                  value["expected_exits_supplied"] is False and value["scientific_execution_performed"] is False, "Production input-only policy differs")
    contracts = {}
    for key, ref in freeze["contracts"].items():
        contract = m.load(ref)
        m.require(contract["schema"] == "ctf01-production-" + key + "-contract.v1" and contract["frozen_before_this_production_helper_execution"] is True, "Frozen contract differs")
        m.require(contract["expected_values_supplied"] is False and contract["expected_exits_supplied"] is False and
                  contract["scientific_execution_performed"] is False, "Contract must remain input-only")
        contracts[key] = contract
        if key in request["contracts"]: same(request["contracts"][key], ref)
    m.bind(freeze["executed_writer"]); source_manifest = m.load(freeze["source_manifest"])
    same(contracts["source"]["helper_source_manifest"], freeze["source_manifest"])
    same(contracts["cases"]["helper_request"], request_ref)
    for key in ["source", "tolerances"]: same(contracts["cases"][key], freeze["contracts"][key])
    m.require(len(contracts["source"]["source_files"]) == 21 and contracts["source"]["energyplus_commit"] == request["energyplus_commit"] and
              admission["native_source_files"] == source_manifest["runtime_protocol"]["native_source_files"], "Actual Native7/Original21 source inventories differ")
    for row in contracts["source"]["source_files"]:
        bound = m.bind({**row, "path": ".reference/energyplus-src/26.1.0/" + row["path"]})
        lines = m.contained(bound["path"]).read_bytes().splitlines(True)
        for selected in row["selected_ranges"]:
            m.require(type(selected["start_line"]) is int and type(selected["end_line"]) is int and
                      1 <= selected["start_line"] <= selected["end_line"] <= len(lines) and selected["bytes_normalized"] is False,
                      "Actual source range metadata differs")
            data = b"".join(lines[selected["start_line"] - 1:selected["end_line"]])
            m.require(hashlib.sha256(data).hexdigest() == selected["sha256"] and len(data) == selected["size_bytes"], "Actual primary source range bytes differ")
    for row in request["all_45_guard_refs"]: m.bind(row)
    m.require(len(request["all_45_guard_refs"]) == 45, "Exact inherited 45 guards required")
    scope = m.load(request["fixed_scope"])
    m.require(request["all_45_guard_refs"] == [row[key] for row in scope["cases"] for key in ["input", "weather", "metadata"]] and
              contracts["cases"]["fixed_CON_scope"] == request["fixed_scope"] and contracts["cases"]["all_45_guard_refs"] == request["all_45_guard_refs"] and
              [{"id": row["id"], "input": row["input"]} for row in request["model_cases"]] == [{"id": row["id"], "input": row["input"]} for row in scope["cases"]],
              "Fixed15/ordered45 source-input associations differ")
    m.require(m.contained(frozen_command["stderr"]["path"]).stat().st_size == 0, "Actual freeze stderr differs")
    m.require(request["loader_phase_order"] == admission["loader_phase_order"] and len(request["loader_phase_order"]) == 13 and
              request["requested_counts"] == {"model_cases": len(request["model_cases"]), "loader_phase_records": len(request["model_cases"]) * len(request["loader_phase_order"])} and
              len(request["model_cases"]) == 15, "Production requested counts must derive from actual fixed arrays")
    build, peer = m.load(refs["build"]), m.load(refs["build-review"])
    compile_command = recorded(refs["build-execution"], native["started_utc"])
    peer_command = recorded(refs["build-review-execution"], native["started_utc"])
    m.require(build["schema"] == "ctf01-production-native-build.v1" and build["status"] == "pass-actual-3TU-link-and-preservation", "Actual build identity required")
    for key in ["all_previous_compile_commands_unchanged", "protected_artifacts_and_present_core_objects_unchanged", "link_provider_verified"]:
        m.require(build[key] is True, "Actual build preservation/provider evidence required")
    for key, expected in {"previous_compile_rows": 664, "current_compile_rows": 667, "core_registered": 643, "core_present": 631, "core_absent": 12}.items():
        m.require(type(build[key]) is int and build[key] == expected, "Actual build cache counts differ")
    preservation = m.load(build["preservation"])
    for key in ["all_protected_refs_unchanged", "all_present_core_objects_unchanged", "absent_registered_objects_still_absent", "all_previous_compile_commands_unchanged"]:
        m.require(preservation[key] is True, "Actual protected/cache preservation differs")
    m.require(len(preservation["protected_refs"]) == 26 and len(preservation["present_objects"]) == 631 and
              len(preservation["absent_registered_object_paths"]) == 12 and preservation["core_registered"] == 643 and
              preservation["previous_compile_rows"] == 664 and preservation["current_compile_rows"] == 667 and
              preservation["selected_core_Construction_object_hits"] == 0 and
              "native-observer-prep-01/Construction.ctf01.cc.obj" in preservation["derived_provider"]["section_provider"]["text"].replace("\\", "/"),
              "Actual 26 protected/core/provider metadata differs")
    # Reuse the genuine unit core check; a new expensive check is not required.
    recorded(build["core_before_check"], compile_command["started_utc"])
    same(build["compile_execution"], refs["build-execution"])
    for key in ["configure_execution", "derivation_execution"]: recorded(build[key], native["started_utc"])
    m.bind(build["validated_derivative"])
    m.require(peer["schema"] == "ctf01-production-independent-build-PE-review.v1" and
              peer["status"] == "pass-exact-retained-PE-runtime-and-actual-build-identity" and peer["retained_runtime_exact"] is True,
              "Actual independent build/PE review required")
    same(peer["build"], refs["build"])
    peer_reader = m.bind(peer["executed_reader"])
    m.require(peer_reader["sha256"] == PE_READER_SHA and len(peer_command["command"]) == 5 and
              Path(peer_command["command"][0]).name.lower() in ["python", "python.exe"] and
              peer_command["command"][1:4] == ["-X", "utf8", "-B"] and
              m.contained(peer_command["command"][4]) == m.contained(peer_reader["path"]), "Actual approved PE reader command/source differs")
    peer_stdout = m.load(peer_command["stdout"])
    m.require(set(peer_stdout) == {"review", "status"} and peer_stdout["status"] == peer["status"], "Actual PE stdout must be its exact compact two-key summary")
    same(peer_stdout["review"], refs["build-review"]); m.bind(peer_stdout["review"])
    m.require(m.contained(peer_command["stderr"]["path"]).stat().st_size == 0, "Actual independent PE stderr differs")
    for key in ["helper_binary", "linked_original", "validated_derivative"]: same(peer[key], build[key])
    m.bind(peer["native_pe_source"])
    maps = {key: m.load(peer["maps"][key]) for key in ["original", "derived", "comparison"]}
    for key, binary in [("original", "linked_original"), ("derived", "helper_binary")]:
        m.require(maps[key]["sha256"] == build[binary]["sha256"] and type(maps[key]["size_bytes"]) is int and
                  maps[key]["size_bytes"] > 0, "Actual PE map binary identity/size differs")
    native_sources = admission["native_source_files"]
    m.require(len(native_sources) == 7 and len(build["native_source_files"]) == 7, "Actual source7 required")
    for declared, compiled in zip(native_sources, build["native_source_files"]): same(declared, compiled); m.bind(declared)
    m.require(instant(frozen_command["finished_utc"]) <= instant(compile_command["started_utc"]), "Freeze must precede actual Native compilation")
    result_name, separator, result_sha = args.results.rpartition("#")
    if not separator: result_name, result_sha = args.results, None
    m.require(result_sha is None or re.fullmatch("[0-9a-f]{64}", result_sha), "Explicit preserved result SHA required when a file exists")
    result_path = m.contained(result_name, existing=False)
    m.require(result_path.name == "ctf01-production-helper-results.json", "Genuine helper result filename required")
    expected_argv = [m.contained(build["helper_binary"]["path"], existing=False), m.ROOT, m.contained(request_ref["path"]),
                     m.contained(admission_ref["path"]), result_path.parent]
    m.require(len(native["command"]) == 5 and [Path(value).resolve() if index == 1 else m.contained(value, existing=False) for index, value in enumerate(native["command"])] == expected_argv,
              "Actual direct Native argc5 command differs")
    counts, integrity, result_ref, output_files = None, [], None, []
    complete = False
    if result_path.is_file() and native["launch_error"] is None:
        m.require(result_sha is not None, "Existing actual result requires its supplied SHA")
        result_ref = m.bind({"path": result_name, "sha256": result_sha})
        # Actual scientific serialization uses the 64MB physical bound, not the 16MB small-metadata parser cap.
        result = json.loads(result_path.read_text(encoding="utf-8"), object_pairs_hook=m.unique_object,
                            parse_constant=lambda value: m.require(False, "Nonfinite JSON literal: " + value))
        m.require(result["schema"] == "ctf01-production-helper-results.v1" and result["complete_requested_model_ledger"] is True and
                  result["energyplus_commit"] == request["energyplus_commit"] and set(result["contracts"]) == set(freeze["contracts"]) and
                  result["requested_counts"] == freeze["requested_counts"] == request["requested_counts"] == admission["requested_counts"],
                  "Actual complete result ledger/source/count identities differ")
        for key, ref in freeze["contracts"].items(): same(result["contracts"][key], ref)
        for key, ref in [("actual_request", request_ref), ("native_admission_contract", admission_ref), ("observation_projection", projection_ref),
                         ("actual_binary", build["helper_binary"])]: same(result[key], ref)
        m.require(type(result["actual_binary"]["size_bytes"]) is int and result["actual_binary"]["size_bytes"] == maps["derived"]["size_bytes"], "Observed binary size differs from actual PE map")
        for key in ["actual_scope_amendment", "actual_scope_amendment_execution", "fixed_scope", "all_45_guard_refs", "native_source_files"]:
            m.require(result[key] == (admission[key] if key == "native_source_files" else request[key]), "Actual source/scope/input binding differs")
        for key in ["complete_all_phase_observations_claimed", "scientific_comparison_performed", "numerical_PASS_claimed", "gates_updated", "whole_building_or_CTF02_through_CTF10_certified"]:
            m.require(result[key] is False, "Actual result scope exceeds selected source")
        counts, integrity = shape.review(result, request, m.require, m.bind)
        m.require(all(type(value) is int for value in result["requested_counts"].values()), "Typed actual requested count metadata required")
        m.require(type(result["actual_helper_exit_code"]) is int and result["actual_helper_exit_code"] == (2 if integrity else 0), "Actual helper integrity exit differs")
        actual_files = {m.contained(path) for path in result_path.parent.rglob("*") if path.is_file()}
        declared_files = {result_path}
        for model in result["model_cases"]:
            for ref in (model["source_diagnostics"]["logs"] or {}).values():
                path = m.contained(ref["path"]); m.require(path.parent == result_path.parent / model["id"], "Diagnostic log escapes its actual case output")
                declared_files.add(path)
        m.require(declared_files <= actual_files, "Actual Native result/diagnostic file inventory is incomplete")
        output_files = []
        for path in sorted(actual_files):
            m.require(path.suffix.lower() not in [".exe", ".dll", ".obj", ".a"], "Native build payload is not a helper output")
            output_files.append(m.bind(m.identity(path)))
        # Retain additional genuine source-created text outputs; never hide them or invent a fixed count.
        complete = True
    release = complete and not integrity and native["exit_code"] == 0 and native["launch_error"] is None and counts["loader_unavailable_model_cases"] == 0
    output = m.contained(args.output_dir, existing=False)
    m.require(output.is_relative_to(m.CTF) and output != m.CTF and not output.exists(), "Fresh contained DataQA output required")
    output.mkdir(parents=True, exist_ok=False)
    sources = [m.archive(m.identity(path), output, index) for index, path in enumerate([Path(__file__), PREP / "shape.py", PREP / "packet_io.py"])]
    review = {"schema": "ctf01-production-independent-original-data-review.v1", "status": "pass-actual-original-production-data-and-provenance-before-Rust" if release else
        "fail-original-production-process-or-observation-integrity-before-Rust", "started_utc": started, "finished_utc": datetime.now(timezone.utc).isoformat(),
        "reviewed_results": result_ref, "reviewed_native_execution": refs["native-execution"], "reviewed_request": request_ref,
        "reviewed_native_admission_contract": admission_ref, "reviewed_projection": projection_ref, "reviewed_contracts": freeze["contracts"],
        "reviewed_build": refs["build"], "reviewed_build_execution": refs["build-execution"], "reviewed_build_review": refs["build-review"],
        "reviewed_build_review_execution": refs["build-review-execution"], "actual_packet_freeze": refs["freeze-receipt"],
        "actual_packet_freeze_execution": refs["freeze-execution"], "actual_native_process_exit_code": native["exit_code"],
        "actual_native_launch_error": native["launch_error"], "complete_requested_record_ledger_validated": complete,
        "actual_observation_counts": counts, "actual_method_counts_unknown": not complete,
        "actual_loaded_whole_call_obligations_unknown": not complete or counts["loader_unavailable_model_cases"] != 0,
        "actual_output_files": output_files, "observation_integrity_failures": integrity,
        "Rust_baseline_released": release, "requested_counts": request["requested_counts"], "executed_reader_sources": sources,
        "executed_reader_source_archive": sources[0]["archive"], "native_binary_payloads_rehashed_or_parsed": False,
        "build_compile_recorder_authored_build_metadata_claimed": False, "scientific_values_recomputed_or_compared": False,
        "numerical_comparison_count": None, "numerical_mismatch_count": None, "numerical_PASS_claimed": False,
        "unreached_or_uninvoked_observation_counted_as_PASS": False, "scientific_execution_performed": False, "gates_updated": False,
        "authorship_limits": "Raw authored preprocessing/unit observer; this production structural reader is not independent certification of its own formulas. Native helper/source outcomes remain genuine and Root/other-author source review is required."}
    m.recheck(); m.emit(output / "review.json", review); m.recheck()
    print(json.dumps(review, allow_nan=False, indent=2))
    return 0 if release else 1


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ["approved-source-sha256", "native-execution", "results", "freeze-receipt", "freeze-execution", "build", "build-execution", "build-review", "build-review-execution", "output-dir"]:
        parser.add_argument("--" + name, required=True)
    raise SystemExit(run(parser.parse_args()))

    for edge in ['below', 'equal', 'above']:
        case('conductivity-threshold-' + edge, ['K_' + edge], 'literal binary64 neighbors of <= PhysPropLimit; cc263')
        case('thin-metric-threshold-' + edge, ['THIN_' + edge], 'literal strict-< neighbors with binary-exact rho=1/128, cp=128, k=1; cc268')
        case('resistance-minimum-' + edge, ['N_R_' + edge.upper()], 'literal neighbors of < RValueLowLimit; cc277')
        case('thickness-maximum-' + edge, ['THICK_' + edge], 'literal neighbors of >3; cc257; actual whole-call exit remains unknown')
    cases += [
        {'id': 'shared-error-then-valid-then-unused', 'lane': 'explicit-member-unit',
         'initial_ErrorsFound': False, 'initial_DoCTFErrorReport': False,
         'construction_calls': [{'id': 'construction-1', 'IsUsedCTF': True, 'layer_material_ids': ['N_R_BELOW']},
             {'id': 'construction-2', 'IsUsedCTF': True, 'layer_material_ids': ['MASS_A']},
             {'id': 'construction-3', 'IsUsedCTF': False, 'layer_material_ids': ['MASS_B']}],
         'source_branch_intent_not_actual_coverage': 'same shared references; selected load error persists into following calls; HBM6155-6158'},
        {'id': 'incoming-shared-error-and-report-flag', 'lane': 'explicit-member-unit',
         'initial_ErrorsFound': True, 'initial_DoCTFErrorReport': True,
         'construction_calls': [{'id': 'construction-1', 'IsUsedCTF': True, 'layer_material_ids': ['MASS_A']},
             {'id': 'construction-2', 'IsUsedCTF': True, 'layer_material_ids': ['N25']}],
         'source_branch_intent_not_actual_coverage': 'incoming sticky error does not skip loading; later selected phases unavailable at cc313'}]
    names = {row['id'] for row in materials}
    scalar_ids = {row['id'] for row in scalars}
    assert len(names) == len(materials) and len({row['id'] for row in cases}) == len(cases)
    assert all(set(row['members'].values()) - {False, True} <= scalar_ids for row in materials)
    assert all(1 <= len(call['layer_material_ids']) <= 11 and set(call['layer_material_ids']) <= names
               for row in cases for call in row['construction_calls'])
    matrix = {'schema': 'ctf01-explicit-member-unit-input-proposal.v1', 'status': 'source-only-not-frozen-not-executed',
        'scalar_input_encoding': 'exact binary64 bits; decimal annotations never override bits',
        'common_caller_inputs': {'TimeStepZone': '0.25', 'TimeStepZoneSec': '900.0'},
        'common_construction_inputs': {'SourceSinkPresent': False, 'SolutionDimensions': 1,
            'SourceAfterLayer': 0, 'TempAfterLayer': 0, 'ThicknessPerpend': '0.0'},
        'input_owner_rule': 'actual MaterialBase objects and actual Construct array elements; literal ordered LayerPoint membership',
        'shared_flag_rule': 'initial flags once per model; pass same actual references in declared construction call order',
        'scalar_literals': scalars, 'material_member_seeds': materials, 'model_cases': cases,
        'proposed_array_derived_counts': {'model_cases': len(cases), 'calculateTransferFunction_calls':
            sum(len(row['construction_calls']) for row in cases)},
        'expected_output_arrays_or_method_exits_or_PASS_supplied': False}
    write('case-matrix.json', compact_sections(matrix))
    sources = [NATIVE / name for name in ['Construction.cc', 'Construction.hh', 'Material.hh', 'Material.cc',
               'DataConversions.hh', 'HeatBalanceManager.cc']]
    sources += [ROOT / name for name in ['energyplus_porting_plan/cards/CTF-01.md',
        'energyplus_porting_plan/contracts/scope.json', 'crates/ep_model/src/objects/materials.rs',
        'crates/ep_runtime/src/heat_balance/surface_manager/construction_cache.rs']]
    idd = ROOT / '.reference/energyplus-src/26.1.0/idd/Energy+.idd.in'
    sources += [idd]
    spans = [('Construction.cc', 59, 165), ('Construction.cc', 167, 221), ('Construction.cc', 222, 261),
        ('Construction.cc', 263, 309), ('Construction.cc', 311, 315), ('Construction.cc', 317, 372),
        ('Construction.cc', 374, 401), ('Construction.cc', 403, 466), ('Construction.hh', 67, 67),
        ('Construction.hh', 138, 145), ('Construction.hh', 188, 198), ('Construction.hh', 260, 260),
        ('Construction.hh', 317, 333), ('Material.hh', 218, 241), ('Material.cc', 170, 225),
        ('Material.cc', 249, 285), ('DataConversions.hh', 58, 69),
        ('HeatBalanceManager.cc', 1403, 1413), ('HeatBalanceManager.cc', 6153, 6167)]
    ranges = []
    for name, first, last in spans:
        lines = (NATIVE / name).read_bytes().splitlines(keepends=True)
        data = b''.join(lines[first-1:last])
        ranges.append({'source': ref(NATIVE / name), 'start_line': first, 'end_line': last,
                       'range_sha256': hashlib.sha256(data).hexdigest(), 'range_size_bytes': len(data)})
    for first, last in [(4912, 4948), (4965, 4985)]:
        data = b''.join(idd.read_bytes().splitlines(keepends=True)[first-1:last])
        ranges.append({'source': ref(idd), 'start_line': first, 'end_line': last,
                       'range_sha256': hashlib.sha256(data).hexdigest(), 'range_size_bytes': len(data)})
    assert ref(NATIVE / 'Construction.cc')['sha256'] == 'd85937a0de02afa4ceb7e4ae03210cf513ffb9f1b86505d2900496393e7a7695'
    manifest = {'schema': 'ctf01-input-projection-source-proposal.v1', 'status': 'SOURCE-READY-held-unexecuted-proposal',
        'held_utc': datetime.now(timezone.utc).isoformat(),
        'documents': [ref(PREP / name) for name in ['case-matrix.json', 'projection.json', 'numeric-policy.json', 'design.md', 'prepare_design.py']],
        'primary_source_identities': [ref(path) for path in sources], 'primary_source_ranges': ranges,
        'reviewed_observer_protocol_source': ref(ROOT / '.runtime/porting/CTF-01/native-observer-prep-01/manifest.json'),
        'actual_case_arrays_derived_counts': matrix['proposed_array_derived_counts'],
        'frozen_scientific_input_or_precision_policy': False, 'Root_approval_or_future_execution_hashes_invented': False,
        'target_imports_builds_engines_Git_canonical_edits_or_result_binary_payload_reads_performed': False,
        'new_QA_or_execution_stage_required': False}
    write('manifest.json', json.dumps(manifest, indent=2, ensure_ascii=False, allow_nan=False) + '\n')
    print(json.dumps({'manifest': ref(PREP / 'manifest.json'), 'proposed_counts': matrix['proposed_array_derived_counts']}))


if __name__ == '__main__':
    main()

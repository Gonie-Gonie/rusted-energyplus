"""Author input-only proposal bytes and source inventory; never import targets."""
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import struct

PREP = Path(__file__).resolve().parent
ROOT = PREP.parents[3]
NATIVE = ROOT / '.reference/energyplus-src/26.1.0/src/EnergyPlus'


def ref(path):
    data = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(data).hexdigest(),
            'size_bytes': len(data), 'line_count': len(data.splitlines())}


def write(name, value):
    path = PREP / name
    if path.exists():
        raise ValueError('Preserve existing held proposal bytes')
    path.write_text(value, encoding='utf-8', newline='\n')


def compact_sections(value):
    lines = ['{']
    for index, (key, item) in enumerate(value.items()):
        suffix = ',' if index + 1 < len(value) else ''
        if isinstance(item, list):
            lines += ['  ' + json.dumps(key) + ': [']
            lines += ['    ' + json.dumps(row, ensure_ascii=False, allow_nan=False)
                      + (',' if i + 1 < len(item) else '') for i, row in enumerate(item)]
            lines += ['  ]' + suffix]
        else:
            lines += ['  ' + json.dumps(key) + ': ' + json.dumps(item, ensure_ascii=False, allow_nan=False) + suffix]
    return '\n'.join(lines + ['}']) + '\n'


def main():
    # These are literal input encodings, not a classifier, evaluator or oracle.
    decimals = ['0.0', '0.0000000000000001', '0.001', '0.0078125', '0.025', '0.08', '0.1', '0.12',
                '0.125', '0.15', '0.16', '0.2', '0.25', '0.3', '0.4', '0.5', '0.8',

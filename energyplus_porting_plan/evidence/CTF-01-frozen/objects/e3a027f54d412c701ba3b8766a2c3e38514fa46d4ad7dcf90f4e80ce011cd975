    material('MASS_B', '0.08', '0.16', '800.0', '1400.0', '0.5', False)
    material('MASS_C', '0.025', '0.2', '30.0', '1000.0', '0.125', False)
    for name, resistance in [('N125', '0.125'), ('N25', '0.25'), ('N50', '0.5'),
                             ('N10', '0.1'), ('N20', '0.2'), ('N30', '0.3'), ('N40', '0.4'),
                             ('N_R_BELOW', 'R-below'), ('N_R_EQUAL', 'R-equal'), ('N_R_ABOVE', 'R-above')]:
        material(name, '0.0', '0.0', '0.0', '0.0', resistance, True)
    for edge in ['below', 'equal', 'above']:
        material('K_' + edge, '0.1', 'threshold-' + edge, '0.0078125', '128.0', '100000.0', False)
        material('THIN_' + edge, 'threshold-' + edge, '1.0', '0.0078125', '128.0', 'threshold-' + edge, False)
        material('THICK_' + edge, 'thickness-' + edge, '0.8', '1800.0', '900.0', '3.75', False)
    material('LIGHT_MASS', '0.25', '1.0', '0.0000000000000001', '1000.0', '0.25', False)
    cases = []

    def case(name, layers, intent, used=True):
        cases.append({'id': name, 'lane': 'explicit-member-unit', 'initial_ErrorsFound': False,
            'initial_DoCTFErrorReport': False, 'construction_calls': [
                {'id': 'construction-1', 'IsUsedCTF': used, 'layer_material_ids': layers}],
            'source_branch_intent_not_actual_coverage': intent})

    prefixes = [
        ['MASS_A'], ['MASS_A', 'MASS_B'], ['MASS_A', 'MASS_B', 'MASS_C'],
        ['MASS_A', 'MASS_B', 'MASS_C', 'MASS_A'],
        ['MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B'],
        ['MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C'],
        ['MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C', 'MASS_A'],
        ['MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B'],
        ['MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C'],
        ['MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C', 'MASS_A'],
        ['MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B', 'MASS_C', 'MASS_A', 'MASS_B']]
    for count, layers in enumerate(prefixes, 1):
        case(f'active-prefix-{count:02d}', layers, 'actual capacity/prefix and normal-mass loading; cc201-269')
    case('unused-before-layer-loading', ['N_R_BELOW'], 'unused return cc163 before any local callback', False)
    extras = [
        ('single-no-mass', ['N25'], 'single layer is both outside/inside boundary; cc274-305'),
        ('two-boundary-no-mass', ['N125', 'N25'], 'both boundary air-equivalent branches; cc296-300'),
        ('outside-no-mass', ['N25', 'MASS_A'], 'outside boundary resistance'),
        ('inside-no-mass', ['MASS_A', 'N25'], 'inside boundary resistance'),
        ('interior-no-mass', ['MASS_A', 'N25', 'MASS_B'], 'interior ROnly branch cc301-305'),
        ('two-adjacent-interior', ['MASS_A', 'N125', 'N25', 'MASS_B'], 'interior adjacent merge cc324-361'),
        ('three-adjacent-interior', ['MASS_A', 'N10', 'N20', 'N30', 'MASS_B'], 'shift-adjusted left-to-right repeated merge'),
        ('disjoint-adjacent-interiors', ['MASS_A', 'N125', 'N25', 'MASS_B', 'N10', 'N20', 'MASS_C'], 'two separated merge runs'),
        ('boundary-neighbor-three-layers', ['N125', 'N25', 'MASS_A'], 'three-layer merge gate and boundary handling'),
        ('boundary-neighbor-four-layers', ['N125', 'N25', 'N50', 'MASS_A'], 'interior pair only; original outside boundary excluded'),
        ('computed-reslayer-not-ronly', ['MASS_A', 'K_equal', 'LIGHT_MASS', 'MASS_B'], 'computed ResLayer differs from ROnly; cc296 and327'),

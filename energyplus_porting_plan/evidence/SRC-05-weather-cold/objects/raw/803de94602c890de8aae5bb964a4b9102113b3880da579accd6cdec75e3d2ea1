"""Apply the four reviewed Source proposals and record the real formatter delta."""
import difflib
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[3]
spec = importlib.util.spec_from_file_location('recorder', ROOT / 'tools/porting/record_command.py')
R = importlib.util.module_from_spec(spec)
spec.loader.exec_module(R)
BASE = ROOT / '.runtime/porting/SRC-05'

def ref(path):
    return dict(R.ref(path), size_bytes=path.stat().st_size)

def load(row):
    path = ROOT / row['path']
    assert R.sha(path) == row['sha256']
    return json.loads(path.read_bytes())

def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(value)
    return ref(path)

def dump(path, value):
    return write(path, R.json_bytes(value))

def rows(snapshot):
    value = load(snapshot)
    result = {row['historical_path']: row for row in value['files']}
    assert len(result) == len(value['files'])
    return result

def diff_bytes(before, after, name, new=False):
    return ''.join(difflib.unified_diff(
        before.decode().splitlines(keepends=True), after.decode().splitlines(keepends=True),
        fromfile='/dev/null' if new else name, tofile=name)).encode()

def delta(path, before, after, name):
    return write(path, diff_bytes(before, after, name))

def main():
    acceptance = ref(ROOT / sys.argv[1])
    review = load(acceptance)
    assert review['accepted'] and review['Root_FULL_Source_review_accepted'] and review['independent_FULL_Source_review_accepted']
    preparation = ref(BASE / 'absent-site-station-EIO-producer-prep-02/manifest.json')
    assert preparation['sha256'] == '048ad25469458f31b50dc566badb8a86f60115a9d371be2847db978a09882e08'
    assert review['producer_Source_preparation'] == preparation
    proposal = load(preparation)
    parent = ref(BASE / 'weather-cold-development-test-cleanup-01/record.json')
    assert parent['sha256'] == '4448026eb3fedc0ba32d14f3534fa77dc31a0e25967d5c43cd527ecd35572c2c'
    cleanup = load(parent)
    comparison = ref(BASE / 'cold-guard-selected-comparison-01/report.json')
    assert comparison['sha256'] == '0266f0aa1175e72c1d9e7681bf301872b55860736d5c3761b9bc976635a8aa21'
    failure = load(comparison)
    assert failure['status'] == 'MISMATCH_OR_REQUIRED_UNAVAILABLE' and not failure['all_available_selected_pairs_match'] and not failure['gates_updated']
    before_ref = cleanup['source_final']
    assert before_ref['sha256'] == proposal['Source_snapshot']['sha256']
    assert R.snapshot_still_matches(before_ref)
    before = rows(before_ref)
    held = proposal['source_proposals']
    assert len(held) == len({v['canonical_path'] for v in held}) == 4
    originals, proposed_bytes, semantic_diffs = {}, {}, {}
    for item in held:
        name = item['canonical_path']
        target = ROOT / name
        if item['new_destination_absent']:
            assert not target.exists() and name not in before
            original = b''
        else:
            original = target.read_bytes()
            assert R.sha(target) == item['actual_before']['sha256'] == before[name]['archive']['sha256']
        path = ROOT / item['proposed']['path']
        assert R.sha(path) == item['proposed']['sha256']
        originals[name] = original
        proposed_bytes[name] = path.read_bytes()
        semantic_diffs[name] = diff_bytes(original, proposed_bytes[name], name, item['new_destination_absent'])
        assert semantic_diffs[name] == (ROOT / item['exact_diff']['path']).read_bytes()
    output = BASE / 'weather-cold-site-station-application-01'
    output.mkdir(exist_ok=False)
    application = []
    for index, item in enumerate(held):
        name = item['canonical_path']
        raw = proposed_bytes[name]
        before_archive = R.store_bytes(originals[name])
        literal_archive = R.store_bytes(raw)
        semantic = write(output / f'diffs/{index:02}-semantic.diff', semantic_diffs[name])
        target = ROOT / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(raw)
        application.append(dict(canonical_path=name, new_destination_absent=item['new_destination_absent'], actual_before_archive=before_archive, actual_literal_archive=literal_archive, actual_semantic_diff=semantic))
    literal_ref = R.source_snapshot()
    literal = rows(literal_ref)
    changed = {r['canonical_path'] for r in application}
    assert all(before.get(n) == literal.get(n) for n in (set(before) | set(literal)) - changed)
    literal_record = dump(output / 'literal-application.json', dict(schema='src05-weather-cold-actual-producer-literal-application.v1', producer_Source_preparation=preparation, actual_producer_Source_acceptance=acceptance, source_before=before_ref, source_literal=literal_ref, application=application, target_execution_performed=False, gates_updated=False))
    result = subprocess.run(['python', '-X', 'utf8', '-B', 'tools/porting/record_command.py', '--output-dir', str((output / 'formatter-command').relative_to(ROOT)), '--', 'cargo', 'fmt', '--all'], cwd=ROOT)
    if result.returncode:
        return result.returncode
    formatter_ref = ref(output / 'formatter-command/receipt.json')
    formatter = load(formatter_ref)
    assert formatter['source_snapshot'] == literal_ref and formatter['exit_code'] == 0
    final_ref = R.source_snapshot()
    final = rows(final_ref)
    assert set(literal) == set(final)
    formatter_changed = {n for n in final if literal[n] != final[n]}
    assert formatter_changed <= changed
    for index, item in enumerate(application):
        name = item['canonical_path']
        target = ROOT / name
        raw = target.read_bytes()
        item.update(actual_final_archive=R.store_bytes(raw), actual_final=ref(target), actual_formatter_diff=delta(output / f'diffs/{index:02}-formatter.diff', (ROOT / item['actual_literal_archive']['path']).read_bytes(), raw, name))
        assert item['actual_final_archive'] == final[name]['archive']
    unrelated = (set(before) | set(final)) - changed
    assert all(before.get(n) == final.get(n) for n in unrelated)
    historical_runtime = cleanup['runtime_source_bindings']
    runtime = load(historical_runtime)
    for key in ('observer_sources', 'actual_public_API_sources'):
        runtime[key] = [ref(ROOT / row['path']) for row in runtime[key]]
    runtime['actual_public_API_sources'].append(ref(ROOT / 'crates/ep_runtime/src/heat_balance/convection/surface_environment/initialization.rs'))
    bindings = dump(output / 'runtime-source-bindings.json', runtime)
    record = dict(schema='src05-weather-cold-actual-producer-extension.v1', parent_cleanup_delta=parent, producer_Source_preparation=preparation, actual_producer_Source_acceptance=acceptance, prior_strict_comparison=comparison, source_before=before_ref, source_literal=literal_ref, source_final=final_ref, source_file_count=len(final), source_counts=dict(before=len(before), literal=len(literal), final=len(final)), unrelated_source_files_verified_byte_exact=len(unrelated), source_formatter_changed_paths=sorted(formatter_changed), actual_literal_application=literal_record, actual_formatter_execution=formatter_ref, historical_runtime_bindings=historical_runtime, runtime_source_bindings=bindings, application=application, actual_application_writer=ref(Path(__file__)), scientific_PASS_claimed=False, whole_surface_environment_or_ordinary_PASS_claimed=False, gates_updated=False, target_execution_performed=False)
    print(json.dumps(dict(actual_record=dump(output / 'record.json', record), source_final=final_ref, formatter_changed_paths=sorted(formatter_changed))))
    return 0

if __name__ == '__main__':
    sys.exit(main())

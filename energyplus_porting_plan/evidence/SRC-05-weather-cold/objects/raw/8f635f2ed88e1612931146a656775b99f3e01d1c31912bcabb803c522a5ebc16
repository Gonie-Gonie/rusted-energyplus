"""Rebase reviewed weather02 onto actual geometry-formatted Source; ignored files only."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / '.runtime/porting/SRC-05'
PARENT = BASE / 'ordinary-surface-environment-prep-02/manifest.json'
OUT = BASE / 'ordinary-surface-environment-prep-03'
SOURCE = ROOT / '.runtime/porting/source-objects/47/47ebf61d9be4dbfcb30fb9b2f3ae8e962c497b0de8857f4e659dba802a72328b'
GEOMETRY_APP = ROOT / '.runtime/porting/SRC-06/ordinary-geometry-applied-01/record.json'


def ref(path):
    data = path.read_bytes()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=hashlib.sha256(data).hexdigest(), size_bytes=len(data), line_count=len(data.splitlines()))


def bound(row):
    path = ROOT / row['path']; actual = ref(path)
    assert actual['sha256'] == row['sha256'] and actual['size_bytes'] == row['size_bytes'], row['path']
    return path


def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        assert path.read_bytes() == data, 'unsealed interrupted Source resumes only at exact byte identity'
        return ref(path)
    with path.open('xb') as stream: stream.write(data)
    return ref(path)


def delta(a, b, left, right):
    return ''.join(difflib.unified_diff(a.decode().splitlines(True), b.decode().splitlines(True), fromfile=left, tofile=right)).encode()


def mutations(a, b):
    return [line for line in delta(a, b, 'before', 'after').decode().splitlines(True) if line[:1] in ['+', '-'] and not line.startswith(('+++ ', '--- '))]


def main():
    assert not (OUT / 'manifest.json').exists(), 'immutable successor manifest must be fresh'
    assert ref(PARENT)['sha256'] == '2956019cda97a4f0b21b7d4c9264ea0bfa67f2bad6e9eba198cd659ad2b63446'
    assert ref(SOURCE)['sha256'] == SOURCE.name
    original = json.loads(PARENT.read_bytes()); manifest = copy.deepcopy(original)
    snapshot = json.loads(SOURCE.read_bytes()); members = {r['historical_path']: r for r in snapshot['files']}
    assert snapshot['schema'] == 'rust-command-source-snapshot.v1' and snapshot['bytes_normalized'] is False and len(members) == len(snapshot['files']) == 3942
    for name, row in members.items():
        archive = bound(dict(row['archive'], size_bytes=row['size_bytes']))
        assert (ROOT / name).read_bytes() == archive.read_bytes(), name
    actual_paths = set((ROOT / 'crates').rglob('*.rs')) | set((ROOT / 'crates').rglob('Cargo.toml'))
    actual_paths |= {ROOT / n for n in ['Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml', '.cargo/config.toml'] if (ROOT / n).is_file()}
    assert set(members) == {p.relative_to(ROOT).as_posix() for p in actual_paths}
    application = json.loads(GEOMETRY_APP.read_bytes())
    assert application['source_final']['sha256'] == SOURCE.name and application['source_file_count'] == 3942
    rows, correspondence, rebase = [], [], []
    for previous in original['source_proposals']:
        name = previous['canonical_path']; current = ROOT / name
        old_parent = bound(previous['before_archive']).read_bytes() if previous['before_archive'] else b''
        old_proposal = bound(previous['proposal']).read_bytes()
        before = current.read_bytes() if current.exists() else b''
        proposal = old_proposal; patches = []
        if before != old_parent:
            assert name == 'crates/ep_runtime/src/heat_balance/initialization.rs'
            geometry_row = next(r for r in application['application'] if r['canonical_path'] == name)
            assert bound(geometry_row['actual_literal_archive']).read_bytes() == old_parent
            assert bound(geometry_row['actual_final_archive']).read_bytes() == before
            fmt = bound(geometry_row['actual_formatter_diff']).read_bytes(); labels = fmt.decode().splitlines()
            assert fmt == delta(old_parent, before, labels[0][4:], labels[1][4:]), 'exact actual geometry formatter derivation required'
            left, right = old_parent.decode().splitlines(True), before.decode().splitlines(True)
            for kind, a, b, x, y in difflib.SequenceMatcher(None, left, right, autojunk=False).get_opcodes():
                if kind == 'equal': continue
                old, new = ''.join(left[a:b]), ''.join(right[x:y])
                assert kind == 'replace' and old.strip() and proposal.decode().count(old) == 1
                proposal = proposal.decode().replace(old, new, 1).encode(); patches.append(dict(before=old, after=new))
            inverse = proposal.decode()
            for patch in reversed(patches):
                assert inverse.count(patch['after']) == 1; inverse = inverse.replace(patch['after'], patch['before'], 1)
            assert inverse.encode() == old_proposal and len(patches) == 3
        assert mutations(old_parent, old_proposal) == mutations(before, proposal), 'weather changed lines must stay exact02'
        absent = previous['parent_kind'] == 'new-destination-absent'
        assert current.exists() is not absent
        before_ref = write(OUT / 'before' / name, before) if not absent else None
        proposed_ref = write(OUT / 'proposed' / name, proposal)
        exact = write(OUT / 'diffs' / (name.replace('/', '__') + '.diff'), delta(before, proposal, 'actual-geometry-before/' + name, 'proposed-weather/' + name))
        narrow = write(OUT / 'from02-diffs' / (name.replace('/', '__') + '.diff'), delta(old_proposal, proposal, previous['proposal']['path'], proposed_ref['path']))
        row = dict(canonical_path=name, parent_kind='new-destination-absent' if absent else 'actual-current-geometry-formatted-source',
            source_parent=None if absent else ref(current), actual_current_before=None if absent else ref(current), before_archive=before_ref,
            proposal=proposed_ref, exact_parent_diff=exact, application_authority_supplied=False)
        rows.append(row); correspondence.append(dict(canonical_path=name, before=previous['proposal'], proposal=proposed_ref, exact_diff=narrow, weather_changed_lines_exact02=True))
        rebase.append(dict(canonical_path=name, historical_source_parent=previous['source_parent'], historical_before_archive=previous['before_archive'], actual_before_archive=before_ref,
            weather02_proposal=previous['proposal'], rebased_proposal=proposed_ref, parent_formatter_rebase_hunks=patches, proposal_bytes_unchanged=proposal == old_proposal))
    assert len(rows) == 14 and sum(r['proposal_bytes_unchanged'] for r in rebase) == 13
    assert [r['canonical_path'] for r in rows] == [r['canonical_path'] for r in original['source_proposals']]
    ranges = manifest['Original_and_Source_ranges']
    manager = next(r for r in ranges if r['path'].endswith('/HeatBalanceSurfaceManager.cc'))
    whole = bound(manager['whole_source']); lines = whole.read_bytes().splitlines(keepends=True)
    assert manager['start_line'] == 298 and manager['end_line'] == 314
    data = b''.join(lines[297:315]); literal = write(OUT / 'Source-ranges/actual-manager-call-order-through-wind-direction.txt', data)
    manager.update(end_line=315, sha256=literal['sha256'], size_bytes=literal['size_bytes'], literal_archive=literal)
    assert b'SetSurfaceWindDir' in data, 'line315 actual direction setter must be retained'
    for item in ranges:
        archive = bound(item['literal_archive']).read_bytes(); raw = bound(item['whole_source']).read_bytes().splitlines(keepends=True)
        assert archive == b''.join(raw[item['start_line'] - 1:item['end_line']])
    old_readme = bound(original['own_sources']['README']).read_bytes()
    before_doc = write(OUT / 'before-02/README.md', old_readme)
    paragraph = 'state.rs and initialization.rs are explicitly composed over the reviewed geometry02 proposed parents. Their before archives are prospective, never represented as current/application authority. All other changed parents are actual current files. No application_sources or runnable application authority is supplied: after genuine geometry Native release and actual geometry application, a fresh successor must rebase every actual before and current full Source snapshot. This draft does not replace dispatcher or geometry modules and does not touch state_shell.rs.'
    replacement = 'Successor03 rebases every existing before against the actual geometry-formatted full Source47eb (3,942 files). state.rs already equals its reviewed prospective geometry parent. initialization.rs carries only the three genuine geometry rustfmt hunks into the old weather02 proposal; reversing those hunks restores weather02 exactly. All thirteen other proposal bytes remain unchanged. The fourteen ordered paths, weather changed lines, constructors, setters, guards, branches, and test inputs are preserved. The actual full Source and geometry application are explicit authorities. This Source hold supplies no runnable applicator and changes no canonical files; Root owns any later application. It does not replace dispatcher or geometry modules and does not touch state_shell.rs.'
    text = old_readme.decode(); assert text.count(paragraph) == 1; text = text.replace(paragraph, replacement, 1)
    text += '\n\nThe Original manager authority is extended from HBSM298–314 through315, retaining the actual wind-direction call. Prior01/02 holds and Root/Header reviews stay immutable historical authorities. No weather equations, policy, thresholds, inputs, or tolerated results changed during this rebase; no target, Native helper, Cargo, formatter, or numerical result was run/read. Fresh cold-guard and ordinary evidence remain required and no gate is claimed.\n'
    document = write(OUT / 'README.md', text.encode())
    doc_diff = write(OUT / 'README.from02.diff', delta(old_readme, text.encode(), before_doc['path'], document['path']))
    manifest.update(status='HELD-Source-only-actual-geometry-formatted-parent-rebase', source_proposals=rows, parent_preparation=ref(PARENT),
        historical_required_prospective_geometry_parent=manifest.pop('required_prospective_geometry_parent'), requires_fresh_actual_before_rebase_after_geometry_application=False,
        actual_before_rebase_completed=True, actual_geometry_application=ref(GEOMETRY_APP), actual_before_Source_snapshot=ref(SOURCE), actual_before_Source_file_count=3942,
        source_correspondence=correspondence, actual_parent_rebase_correspondence=rebase, own_sources=dict(author=ref(Path(__file__)), README=document),
        document_correspondence=dict(before=before_doc, proposal=document, exact_diff=doc_diff), unmodified_parent_source_proposal_count=13,
        parent_FULL_Source_reviews=[ref(BASE / 'Root-ordinary-surface-environment-Source-review-02/review.json'), ref(BASE / 'Header-ordinary-surface-environment-Source-review-02/review.json')],
        new_semantic_weather_changes=False, numerical_outputs_read_during_rebase=False, actual_geometry_output_values_read=False,
        author_initial_guard_draft=ref(Path(__file__).with_name('prepare-ordinary-surface-environment-03.initial-guard-draft.py')),
        author_initial_guard_note='Unsealed author first rejected legitimate rustfmt trailing commas as non-whitespace. Exact actual literal/final/formatter archives now authenticate all three parent hunks; no weather or canonical Source change.')
    for name, row in members.items(): assert (ROOT / name).read_bytes() == bound(dict(row['archive'], size_bytes=row['size_bytes'])).read_bytes()
    ast.parse(Path(__file__).read_bytes())
    write(OUT / 'manifest.json', (json.dumps(manifest, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())
    print(json.dumps(ref(OUT / 'manifest.json')))


if __name__ == '__main__': main()

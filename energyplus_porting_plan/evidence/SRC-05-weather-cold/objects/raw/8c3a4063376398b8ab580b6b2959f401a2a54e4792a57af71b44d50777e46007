def need(value, message):
    if not value: raise ValueError(message)


def ref(path):
    path = path.resolve()
    with path.open('rb') as stream: sha = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=sha, size_bytes=path.stat().st_size)


def bind(row):
    path = (ROOT / row['path']).resolve()
    need(path.is_relative_to(ROOT) and path.is_file(), 'contained actual artifact required: ' + row['path'])
    actual = ref(path)
    need(actual['sha256'] == row['sha256'] and all(row[k] == actual['size_bytes'] for k in ('size_bytes', 'bytes') if k in row), 'actual SHA/size differs: ' + row['path'])
    return path


def operand(token):
    name, sha = token.rsplit('#', 1)
    return ref(bind(dict(path=name, sha256=sha)))


def load(row): return json.loads(bind(row).read_bytes())
def same(a, b): need(bind(a) == bind(b), 'actual artifact identity differs')


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def dump(path, value): return write(path, (json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())


def module(name, row):
    spec = importlib.util.spec_from_file_location(name, bind(row))
    value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value)
    return value


def diff(before, after, row):
    raw = bind(row).read_bytes()
    if not raw: need(before == after, 'empty diff requires identical bytes'); return
    lines = raw.decode().splitlines(True)
    need(len(lines) >= 2 and lines[0].startswith('--- ') and lines[1].startswith('+++ '), 'literal unified diff labels required')
    expected = ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=lines[0][4:].rstrip('\n'), tofile=lines[1][4:].rstrip('\n'))).encode()
    need(raw == expected, 'complete regenerated diff differs')


def delta(path, before, after, left, right):
    return write(path, ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=left, tofile=right)).encode())



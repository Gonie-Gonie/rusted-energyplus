def receipt(row, source, command, allowed=(0,), stable=True):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] in allowed and value['launch_error'] is None and value['command'] == command and value['finished_utc'] is not None and value['started_utc'] <= value['finished_utc'], 'closed actual command differs')
    same(value['source_snapshot'], source)
    need(type(value['source_bytes_match_before_and_after']) is bool and (stable is None or value['source_bytes_match_before_and_after'] is stable) and value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'actual Source/scope guard differs')
    need(bind(value['executed_launcher']['archive']).read_bytes() == bind(RECORDER).read_bytes(), 'actual recorder Source differs')
    bind(value['stdout']); bind(value['stderr']); return value



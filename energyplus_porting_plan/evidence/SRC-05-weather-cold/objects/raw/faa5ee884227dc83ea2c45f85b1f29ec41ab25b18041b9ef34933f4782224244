class Rows:
    def __init__(self, output):
        self.output = output; self.streams = {name:gzip.GzipFile(filename=str(output / (name + '.jsonl.gz')), mode='xb', mtime=0) for name in ('inputs', 'prestates', 'endpoints', 'unavailable')}
        self.counts = {name:0 for name in self.streams}; self.mismatches = {name:0 for name in ('inputs', 'prestates', 'endpoints')}; self.required_unavailable = 0; self.nonfinite_excluded = 0

    def emit(self, phase, row):
        self.streams[phase].write((json.dumps(row, ensure_ascii=False, allow_nan=False, separators=(',', ':')) + '\n').encode()); self.counts[phase] += 1

    def unavailable(self, role, path, native, rust, required=False):
        self.emit('unavailable', dict(role=role, path=path, Native=native, Rust=rust, required=required, counted_as_PASS=False)); self.required_unavailable += required

    def pair(self, phase, path, native, rust, generated=False):
        if isinstance(native, dict) and isinstance(rust, dict) and set(native) == set(rust) == {'value', 'value_bits', 'value_class'}:
            nonfinite = any(v['value_class'] in ('nan', 'negative_infinity', 'positive_infinity') for v in (native, rust))
            derived_bulb = generated and any('/' + name + '/' in path for name in ('SurfOutDryBulbTemp', 'SurfOutWetBulbTemp'))
            if nonfinite and (derived_bulb or any(v['value_class'] in ('negative_infinity', 'positive_infinity') for v in (native, rust))):
                self.nonfinite_excluded += 1; self.unavailable('post_bulb_or_infinite_nonfinite_observation_origin_untraced_not_numerical_PASS', path, native, rust); return
            matched = native['value_bits'] == rust['value_bits'] and native['value_class'] == rust['value_class']
        elif isinstance(native, dict) and isinstance(rust, dict):
            self.pair(phase, path + '/actual_field_membership', sorted(native), sorted(rust), generated)
            for key in sorted(set(native) & set(rust)): self.pair(phase, path + '/' + key, native[key], rust[key], generated)
            return
        elif isinstance(native, list) and isinstance(rust, list):
            self.pair(phase, path + '/actual_length', len(native), len(rust), generated)
            for i, (a,b) in enumerate(zip(native, rust)): self.pair(phase, path + '/' + str(i), a,b, generated)
            return
        else: matched = type(native) is type(rust) and native == rust
        self.emit(phase, dict(path=path, Native=native, Rust=rust, matched=matched, absolute_tolerance=0, relative_tolerance=0)); self.mismatches[phase] += not matched

    def close(self):
        for stream in self.streams.values(): stream.close()
        return {name:full(self.output / (name + '.jsonl.gz')) for name in self.streams}



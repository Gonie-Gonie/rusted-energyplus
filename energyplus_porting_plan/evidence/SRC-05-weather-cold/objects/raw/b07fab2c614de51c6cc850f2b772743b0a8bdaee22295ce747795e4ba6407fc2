        const auto next_float = [](const double value) {
            if (std::signbit(value)) {
                if (value == -0.0) {
                    return value;
                }
                return std::nextafter(value, std::numeric_limits<decltype(value)>::lowest());
            }
            if (value == 0.0) {
                return value;
            }
            return std::nextafter(value, std::numeric_limits<decltype(value)>::max());
        };

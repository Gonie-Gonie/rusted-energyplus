def full(path):
    raw = path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': hashlib.sha256(raw).hexdigest(), 'size_bytes': len(raw)}


def write(relative, raw):
    path = OUT / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(raw)
    return full(path)


def check_current_source():
    assert full(SOURCE)['sha256'] == SOURCE_HASH
    snapshot = json.loads(SOURCE.read_bytes())
    expected = set()
    for row in snapshot['files']:
        expected.add(row['historical_path'])
        canonical = ROOT / row['historical_path']
        assert full(canonical)['sha256'] == row['archive']['sha256'], row['historical_path']
        assert canonical.stat().st_size == row['size_bytes']
    actual = {p.relative_to(ROOT).as_posix() for p in (ROOT / 'crates').rglob('*')
              if p.is_file() and (p.suffix == '.rs' or p.name == 'Cargo.toml')}
    actual.update(p for p in ['.cargo/config.toml', 'Cargo.lock', 'Cargo.toml', 'rust-toolchain.toml'] if (ROOT / p).is_file())
    assert actual == expected, {'added': sorted(actual - expected), 'missing': sorted(expected - actual)}
    return len(expected)


def replace_once(text, old, new):
    assert text.count(old) == 1, old
    return text.replace(old, new, 1)



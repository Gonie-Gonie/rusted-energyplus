        for role, command in {**V.QUALITY, 'observer_build': argv}.items():
            row, value = recorded(out, role, source, command, allowed=(0, 1, 2, 101))
            if value['exit_code'] != 0:
                dump(out / 'failed-build.json', dict(common, actual_failed_role=role, actual_execution=row, actual_exit_code=value['exit_code'], target_execution_performed=False)); return value['exit_code']

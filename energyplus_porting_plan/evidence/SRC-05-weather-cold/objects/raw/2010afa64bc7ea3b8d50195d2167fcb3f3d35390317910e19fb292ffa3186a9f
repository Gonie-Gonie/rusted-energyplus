    if args.phase == 'build':
        need(not args.build_record and not args.artifact_review, 'build cannot accept a prior artifact'); out.mkdir()
        frozen_policy = write(out / 'frozen-pair-policy.json', bind(observer['prospective_pairing_policy']).read_bytes()); quality, totals = {}, {}

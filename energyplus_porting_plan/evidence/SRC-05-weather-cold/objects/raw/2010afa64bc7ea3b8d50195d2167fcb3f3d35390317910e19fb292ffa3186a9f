    need(args.application and args.formatter_review and not args.source_before and not args.card_contract, 'later phases require actual application and formatter acceptance')
    app_ref, review_ref = operand(args.application), operand(args.formatter_review); app, fmt = actual_application(app_ref, review_ref, native_ref, rows); source = app['source_final']

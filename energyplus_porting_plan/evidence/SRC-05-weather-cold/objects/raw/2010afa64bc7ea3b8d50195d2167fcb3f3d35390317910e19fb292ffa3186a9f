def need(value, message):
    if not value: raise ValueError(message)


def ref(path):
    path = path.resolve()
    with path.open('rb') as stream: sha = hashlib.file_digest(stream, 'sha256').hexdigest()
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=sha, size_bytes=path.stat().st_size)


def bind(row):
    path = (ROOT / row['path']).resolve()
    need(path.is_relative_to(ROOT) and path.is_file(), 'contained actual artifact required: ' + row['path'])
    actual = ref(path)
    need(actual['sha256'] == row['sha256'] and all(row[k] == actual['size_bytes'] for k in ('size_bytes', 'bytes') if k in row), 'actual SHA/size differs: ' + row['path'])
    return path


def operand(token):
    name, sha = token.rsplit('#', 1)
    return ref(bind(dict(path=name, sha256=sha)))


def load(row): return json.loads(bind(row).read_bytes())
def same(a, b): need(bind(a) == bind(b), 'actual artifact identity differs')


def write(path, raw):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
    return ref(path)


def dump(path, value): return write(path, (json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + '\n').encode())


def module(name, row):
    spec = importlib.util.spec_from_file_location(name, bind(row))
    value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value)
    return value


def diff(before, after, row):
    raw = bind(row).read_bytes()
    if not raw: need(before == after, 'empty diff requires identical bytes'); return
    lines = raw.decode().splitlines(True)
    need(len(lines) >= 2 and lines[0].startswith('--- ') and lines[1].startswith('+++ '), 'literal unified diff labels required')
    expected = ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=lines[0][4:].rstrip('\n'), tofile=lines[1][4:].rstrip('\n'))).encode()
    need(raw == expected, 'complete regenerated diff differs')


def delta(path, before, after, left, right):
    return write(path, ''.join(difflib.unified_diff(before.decode().splitlines(True), after.decode().splitlines(True), fromfile=left, tofile=right)).encode())


def members(row, current=False):
    value = load(row); rows = {r['historical_path']: r for r in value['files']}
    need(value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False and len(rows) == len(value['files']), 'complete unique literal Source snapshot required')
    for name, item in rows.items():
        need(bind(item['archive']).stat().st_size == item['size_bytes'], 'Source archive size differs')
    if current: need(R.snapshot_still_matches(row), 'full current Source membership/bytes differ')
    return rows


def held_rows():
    weather, observer = load(WEATHER), load(OBSERVER); rows = []
    need(len(weather['source_proposals']) == 14 and len(observer['application_sources']) == 1, 'exact fourteen plus one held rows required')
    for item in weather['source_proposals']:
        rows.append(dict(canonical_path=item['canonical_path'], new_destination_absent=item['actual_current_before'] is None, actual_before=item['actual_current_before'], before_archive=item['before_archive'], proposal=item['proposal'], exact_diff=item['exact_parent_diff']))
    rows.extend(observer['application_sources'])
    names = [r['canonical_path'] for r in rows]
    need(len(set(names)) == 15 and sum(r['new_destination_absent'] for r in rows) == 3, 'fifteen disjoint held paths/three additions required')
    for row in rows:
        path = (ROOT / row['canonical_path']).resolve()
        need(path.is_relative_to(ROOT / 'crates') and path.suffix == '.rs', 'exact contained Rust destination required')
        before = b'' if row['new_destination_absent'] else bind(row['before_archive']).read_bytes()
        diff(before, bind(row['proposal']).read_bytes(), row['exact_diff'])
    same(observer['reviewed_weather_Source_preparation'], WEATHER)
    return rows, observer


def receipt(row, source, command, allowed=(0,), stable=True):
    value = load(row)
    need(value['schema'] == 'recorded-porting-command.v1' and value['exit_code'] in allowed and value['launch_error'] is None and value['command'] == command and value['finished_utc'] is not None and value['started_utc'] <= value['finished_utc'], 'closed actual command differs')
    same(value['source_snapshot'], source)
    need(type(value['source_bytes_match_before_and_after']) is bool and (stable is None or value['source_bytes_match_before_and_after'] is stable) and value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'actual Source/scope guard differs')
    need(bind(value['executed_launcher']['archive']).read_bytes() == bind(RECORDER).read_bytes(), 'actual recorder Source differs')
    bind(value['stdout']); bind(value['stderr']); return value


def native_release(row, observer):
    value = load(row)
    need(value['schema'] == 'src05-cold-guard-Native-baseline-acceptance.v1' and value['accepted'] is True and value['complete_input_owner_prefix_and_custody_review_accepted'] is True and value['whole_surface_environment_or_ordinary_PASS_claimed'] is False and value['gates_updated'] is False, 'genuine full-prefix Native cold baseline release required')
    same(value['Native_Source_preparation'], observer['reviewed_Native_Source_preparation'])
    need(value['Source_snapshot']['sha256'] == SOURCE_BEFORE, 'historical Native baseline Source differs')
    guard, before = load(value['actual_custody']), load(value['actual_before'])
    need(guard['schema'] == 'src05-cold-guard-execution-custody.v1' and guard['all_frozen_artifacts_unchanged'] is True, 'Native capture custody required')
    for field, expected in [('actual_before', value['actual_before']), ('actual_command_receipt', value['actual_Native_execution']), ('actual_authoritative_result', value['actual_authoritative_result'])]: same(guard[field], expected)
    same(before['Source_snapshot'], value['Source_snapshot']); same(before['Source_preparation'], value['Native_Source_preparation']); same(before['actual_input'], observer['input_only_request'])
    actual = receipt(value['actual_Native_execution'], value['Source_snapshot'], before['actual_argv'], allowed=(0, 2))
    need(guard['actual_target_exit_code'] == guard['actual_recorder_exit_code'] == actual['exit_code'], 'Native actual exit custody differs')
    bind(value['actual_provider_acceptance'])
    for field in ['Root_factual_review', 'independent_FULL_factual_review']:
        review = load(value[field]); need(review['accepted'] is True and review['gates_updated'] is False, 'both genuine Native factual reviews required')
        same(review['actual_custody'], value['actual_custody']); same(review['Source_snapshot'], value['Source_snapshot'])
    # The release retains intentional OriginalFatal/stream-stop prefixes; no zero-error/all-return assumption.
    return actual


def recorded(out, role, source, command, allowed=(0,), stable=True):
    if stable: members(source, current=True)
    code = subprocess.call([sys.executable, '-X', 'utf8', '-B', str(bind(RECORDER)), '--output-dir', str(out / (role + '-command')), '--', *command], cwd=ROOT)
    row = ref(out / (role + '-command/receipt.json')); value = receipt(row, source, command, allowed=allowed, stable=stable)
    need(code == value['exit_code'], 'actual recorder return differs')
    if stable: members(source, current=True)
    return row, value


def actual_application(row, review_ref, native_ref, rows):
    app, review = load(row), load(review_ref)
    need(app['schema'] == 'src05-weather-cold-actual-application.v1' and review['Root_FULL_formatter_correspondence_accepted'] is True and review['independent_FULL_formatter_correspondence_accepted'] is True, 'both complete actual formatter reviews required')
    same(review['actual_application'], row); same(review['Source_snapshot'], app['source_final']); same(app['Native_baseline_acceptance'], native_ref)
    same(app['actual_writer_Source'], ref(Path(__file__))); same(app['weather_Source_preparation'], WEATHER); same(app['observer_Source_preparation'], OBSERVER)
    before, literal, final = members(app['source_before']), members(app['source_literal']), members(app['source_final'], current=True)
    names = {r['canonical_path'] for r in rows}; added = {r['canonical_path'] for r in rows if r['new_destination_absent']}; unrelated = set(before) - names
    need(app['source_before']['sha256'] == SOURCE_BEFORE and len(before) == 3942 and len(final) == 3945 and set(literal) == set(final) == set(before) | added and len(unrelated) == 3930 and all(before[k] == literal[k] == final[k] for k in unrelated), 'complete membership/unrelated Source correspondence differs')
    need(len(app['application']) == 15, 'all fifteen actual rows required')
    for actual, held in zip(app['application'], rows):
        need(all(actual[k] == v for k, v in held.items()), 'literal held row authority differs')
        a, b, c = [bind(actual[k]).read_bytes() for k in ['actual_before_archive', 'actual_literal_archive', 'actual_final_archive']]
        need(a == (b'' if held['new_destination_absent'] else bind(held['before_archive']).read_bytes()) and b == bind(held['proposal']).read_bytes(), 'actual before/literal bytes differ')
        diff(a, b, actual['actual_semantic_diff']); diff(b, c, actual['actual_formatter_diff'])
        name = held['canonical_path']; need(literal[name]['archive']['sha256'] == actual['actual_literal_archive']['sha256'] and final[name]['archive']['sha256'] == actual['actual_final_archive']['sha256'] and bind(actual['actual_final']).read_bytes() == c, 'literal/final/snapshot/canonical join differs')
    observer = load(OBSERVER); runtime = load(app['runtime_source_bindings'])
    need(runtime['schema'] == 'src05-weather-cold-runtime-source-bindings.v1', 'actual runtime binding schema differs')
    for key, order in [('observer_sources', 'own_paths'), ('actual_public_API_sources', 'api_paths')]:
        need([r['path'] for r in runtime[key]] == observer['runtime_interfaces'][order], 'complete ordered runtime Source paths differ')
        for item in runtime[key]:
            bind(item); need(item['sha256'] == final[item['path']]['archive']['sha256'] and item['size_bytes'] == final[item['path']]['size_bytes'], 'runtime/full Source join differs')
    fmt = receipt(app['actual_formatter_execution'], app['source_literal'], ['cargo', 'fmt', '--all'], stable=bind(app['source_literal']) == bind(app['source_final']))
    return app, fmt


def main():
    global R
    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument('phase', choices=['apply', 'build', 'execute'])

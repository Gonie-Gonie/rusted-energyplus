        out.mkdir(); actual_rows = []
        for i, row in enumerate(rows):
            target = ROOT / row['canonical_path']; a = b'' if row['new_destination_absent'] else target.read_bytes(); b = bind(row['proposal']).read_bytes()
            actual_rows.append(dict(row, actual_before_archive=write(out / 'before' / row['canonical_path'], a), actual_literal_archive=write(out / 'literal' / row['canonical_path'], b)))
        need(R.snapshot_still_matches(before_ref), 'Source changed before literal writes')
        for row in actual_rows:
            target = ROOT / row['canonical_path']; target.parent.mkdir(parents=True, exist_ok=True); target.write_bytes(bind(row['proposal']).read_bytes())
        literal_ref = R.source_snapshot(); literal = members(literal_ref); names = {r['canonical_path'] for r in rows}; added = {r['canonical_path'] for r in rows if r['new_destination_absent']}; unrelated = set(before) - names
        need(set(literal) == set(before) | added and all(before[k] == literal[k] for k in unrelated), 'unexpected literal Source change')
        dump(out / 'before-format.json', dict(common, source_before=before_ref, source_literal=literal_ref, actual_card_contract=card_ref, application=actual_rows))
        fmt_ref, fmt = recorded(out, 'format', literal_ref, ['cargo', 'fmt', '--all'], stable=None)
        need(native['finished_utc'] <= fmt['started_utc'], 'Native baseline must precede Rust formatting')
        final_ref = R.source_snapshot(); final = members(final_ref, current=True)

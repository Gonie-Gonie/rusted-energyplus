    need(build['schema'] == 'src05-weather-cold-actual-quality-and-artifact.v1' and approval['accepted'] is True and approval['Root_FULL_PE_and_Cargo_artifact_accepted'] is True and approval['gates_updated'] is False, 'closed build/Root PE approval required')
    for key, expected in [('actual_application', app_ref), ('actual_formatter_review', review_ref), ('Source_snapshot', source)]: same(build[key], expected)
    same(build['actual_writer_Source'], ref(Path(__file__))); same(approval['actual_build_record'], build_ref); same(approval['Source_snapshot'], source)
    artifact = build['actual_Cargo_artifact']; same(approval['actual_executable'], artifact['executable']); binary_before = ref(bind(artifact['executable'])); bind(artifact['PE_inspection']['actual_PE_header_bytes']); need(artifact['PE_inspection']['stack_reserve_bytes'] == 8388608, 'actual accepted main-stack reserve required')

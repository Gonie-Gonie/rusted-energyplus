use super::*;

struct LimitedEio { bytes: Vec<u8>, remaining: usize }
impl Write for LimitedEio {
    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
        if bytes.is_empty() { return Ok(0); }
        if self.remaining == 0 { return Err(io::Error::new(io::ErrorKind::BrokenPipe, "actual test EIO exhausted")); }
        let count = self.remaining.min(bytes.len());
        self.bytes.extend_from_slice(&bytes[..count]); self.remaining -= count; Ok(count)
    }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}
type TestResult = Result<(), Box<dyn std::error::Error>>;

#[test]
fn absent_site_and_station_append_in_call_order_to_the_actual_seeded_eio() -> TestResult {
    let mut parameters = SurfaceOutdoorEnvironmentParameters::for_building_terrain(Terrain::City);
    let mut eio = b"EIO incoming\n".to_vec();
    parameters.initialize_absent_site_height_variation(&mut eio)?;
    parameters.initialize_absent_weather_station(&mut eio)?;
    let text = std::str::from_utf8(&eio)?; let lines = text.lines().collect::<Vec<_>>();
    assert_eq!(lines.len(), 5); assert_eq!(lines[0], "EIO incoming");
    assert_eq!(lines[1], SITE_HEADER.trim_end_matches('\n'));
    assert_eq!(lines[2], "Environment:Site Atmospheric Variation,0.330,460.000,6.500000E-003");
    assert_eq!(lines[3], STATION_HEADER.trim_end_matches('\n'));
    assert!(lines[4].starts_with("Environment:Weather Station,10.000,0.140,270.000,1.500,"));
    assert_eq!(lines[4].split(',').count(), 7);
    assert_eq!(parameters, SurfaceOutdoorEnvironmentParameters::default_weather_station(Terrain::City));
    Ok(())
}

#[test]
fn first_site_write_failure_retains_site_change_prefix_and_unreached_station() {
    let mut parameters = SurfaceOutdoorEnvironmentParameters::for_building_terrain(Terrain::Ocean);
    parameters.site_temperature_gradient_k_per_m = 0.125;
    parameters.weather_file_temperature_modifier_c = 7.0;
    parameters.weather_file_wind_modifier = 11.0;
    let before = parameters;
    let mut eio = LimitedEio { bytes: b"seed".to_vec(), remaining: 5 };
    let result = parameters.initialize_absent_site_height_variation(&mut eio)
        .and_then(|()| parameters.initialize_absent_weather_station(&mut eio));
    assert!(matches!(result, Err(SurfaceOutdoorInitializationError::Io(ref e)) if e.kind()==io::ErrorKind::BrokenPipe && e.to_string()=="actual test EIO exhausted"));
    assert_eq!(eio.bytes, b"seed! <En");
    assert_eq!(parameters.site_temperature_gradient_k_per_m.to_bits(), 0.0065_f64.to_bits());
    assert_eq!(parameters.site_wind_exponent.to_bits(), before.site_wind_exponent.to_bits());
    assert_eq!(parameters.site_wind_boundary_layer_height_m.to_bits(), before.site_wind_boundary_layer_height_m.to_bits());
    assert_eq!(parameters.weather_file_temperature_modifier_c.to_bits(), before.weather_file_temperature_modifier_c.to_bits());
    assert_eq!(parameters.weather_file_wind_modifier.to_bits(), before.weather_file_wind_modifier.to_bits());
}

#[test]
fn site_row_failure_keeps_completed_header_and_actual_partial_row() {
    let mut parameters = SurfaceOutdoorEnvironmentParameters::for_building_terrain(Terrain::Country);
    let mut eio = LimitedEio { bytes: Vec::new(), remaining: SITE_HEADER.len() + 4 };
    let result = parameters.initialize_absent_site_height_variation(&mut eio);
    assert!(matches!(result, Err(SurfaceOutdoorInitializationError::Io(ref e)) if e.kind()==io::ErrorKind::BrokenPipe));
    let mut expected = SITE_HEADER.as_bytes().to_vec(); expected.extend_from_slice(b"Envi");
    assert_eq!(eio.bytes, expected);
    assert_eq!(parameters.weather_file_temperature_modifier_c.to_bits(), 0.0_f64.to_bits());
    assert_eq!(parameters.weather_file_wind_modifier.to_bits(), 1.5863_f64.to_bits());
}

#[test]
fn station_coefficients_assign_before_its_header_write_failure() {
    let mut parameters = SurfaceOutdoorEnvironmentParameters::for_building_terrain(Terrain::Urban);
    parameters.site_temperature_gradient_k_per_m = 0.25;
    let mut eio = LimitedEio { bytes: b"seed".to_vec(), remaining: 0 };
    let result = parameters.initialize_absent_weather_station(&mut eio);
    assert!(matches!(result, Err(SurfaceOutdoorInitializationError::Io(ref e)) if e.kind()==io::ErrorKind::BrokenPipe));
    let completed = SurfaceOutdoorEnvironmentParameters::default_weather_station(Terrain::Urban);
    assert_eq!(parameters.weather_file_wind_modifier.to_bits(), completed.weather_file_wind_modifier.to_bits());
    assert_eq!(parameters.weather_file_temperature_modifier_c.to_bits(), completed.weather_file_temperature_modifier_c.to_bits());
    assert_eq!(parameters.site_temperature_gradient_k_per_m.to_bits(), 0.25_f64.to_bits());
    assert_eq!(eio.bytes, b"seed");
}

#[test]
fn site_format_unavailable_keeps_header_and_never_writes_a_replacement_row() {
    let mut parameters = SurfaceOutdoorEnvironmentParameters::for_building_terrain(Terrain::Suburbs);
    parameters.site_wind_exponent = f64::INFINITY;
    let mut eio = Vec::new();
    let result = parameters.initialize_absent_site_height_variation(&mut eio);
    assert!(matches!(result, Err(SurfaceOutdoorInitializationError::Format(_))));
    assert_eq!(eio, SITE_HEADER.as_bytes());
    assert_eq!(parameters.weather_file_temperature_modifier_c.to_bits(), 0.0_f64.to_bits());
    assert_eq!(parameters.weather_file_wind_modifier.to_bits(), 1.5863_f64.to_bits());
}

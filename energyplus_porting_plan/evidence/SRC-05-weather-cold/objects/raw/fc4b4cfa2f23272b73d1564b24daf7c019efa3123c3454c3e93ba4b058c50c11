"""HELD finite weather/cold publication; execute only with reviewed actual receipts."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import shutil

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / 'energyplus_porting_plan/evidence/SRC-05-weather-cold'
SELECTED, SEEN, PROVENANCE = {}, {}, []
KEYS = {
    'schema', 'writer_Source_preparation', 'facts_Source_preparation',
    'actual_application', 'actual_compile_correction', 'actual_cleanup',
    'actual_producer_extension', 'actual_build_record', 'actual_Root_artifact_acceptance',
    'actual_Rust_custody', 'Root_Rust_factual_review', 'independent_Rust_factual_review',
    'actual_Root_facts_execution', 'actual_independent_facts_execution',
    'Native_baseline_acceptance', 'Native_provider_acceptance',
    'first_comparison', 'first_comparison_execution', 'actual_comparison',
    'actual_comparison_execution', 'Root_comparison_factual_review',
    'independent_comparison_factual_review', 'Source_acceptances',
    'retained_closed_failures', 'Root_publication_Source_review',
    'independent_publication_Source_review',
}
LEDGERS = {'inputs', 'prestates', 'endpoints', 'unavailable'}


def need(value, message):
    if not value:
        raise ValueError(message)


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def full(path):
    return dict(path=path.relative_to(ROOT).as_posix(), sha256=digest(path), size_bytes=path.stat().st_size)


def checked(row):
    need(isinstance(row, dict) and isinstance(row.get('path'), str) and
         re.fullmatch('[0-9a-f]{64}', row.get('sha256', '')), 'literal artifact reference required')
    path = (ROOT / row['path']).resolve()
    need(path.is_relative_to(ROOT) and path.is_file(), 'contained selected artifact required')
    need(path.suffix.lower() not in {'.exe', '.dll', '.obj', '.o', '.a', '.lib', '.map'}, 'binary/map payload selection forbidden')
    need(digest(path) == row['sha256'] and ('size_bytes' not in row or path.stat().st_size == row['size_bytes']), 'full SHA/size differs: ' + row['path'])
    SEEN[path] = (row['sha256'], path.stat().st_size)
    return path


def unique(pairs):
    value = {}
    for key, row in pairs:
        need(key not in value, 'duplicate JSON key')
        value[key] = row
    return value


def load(row):
    return json.loads(checked(row).read_bytes(), object_pairs_hook=unique,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))


def select(row, role):
    path = checked(row)
    if path.name in {'stdout.log', 'stderr.log'}:
        receipt_path = path.parent / 'receipt.json'
        need(receipt_path.is_file(), 'closed sibling receipt required for selected stdio')
        command = load(full(receipt_path))
        need(command['schema'] == 'recorded-porting-command.v1' and command['finished_utc'] is not None and command['launch_error'] is None, 'active/failed-launch stdio forbidden')
        same(command['stdout' if path.name == 'stdout.log' else 'stderr'], row)
    SELECTED.setdefault(path, set()).add(role)


def same(left, right):
    need(checked(left) == checked(right), 'artifact path/SHA/size identity differs')


def metadata(row, role):
    value = load(row)
    select(row, role)
    need(value.get('gates_updated', False) is False, 'gate mutation forbidden')
    return value


def receipt(row, role, source=None, allowed=(0,), stable=True):
    value = metadata(row, role)
    need(value['schema'] == 'recorded-porting-command.v1' and value['finished_utc'] is not None and
         value['launch_error'] is None and value['exit_code'] in allowed and
         value['started_utc'] <= value['finished_utc'], 'closed actual command required')
    need(value['recorder_updates_gates'] is False and value['recorder_supplies_reference_answers'] is False, 'recorder scope differs')
    if stable is not None:
        need(value['source_bytes_match_before_and_after'] is stable, 'command Source stability differs')
    if source is not None:
        same(value['source_snapshot'], source)
    for field in ['stdout', 'stderr']:
        select(value[field], role + ':' + field)
    select(value['executed_launcher']['archive'], role + ':actual-recorder-Source')
    return value


def provenance(row, reason):
    need(isinstance(row, dict) and isinstance(row.get('path'), str) and
         re.fullmatch('[0-9a-f]{64}', row.get('sha256', '')), 'literal provenance hash required')
    PROVENANCE.append(dict(artifact=row, reason=reason, payload_published=False,
                           current_payload_rehashed_by_publisher=False,
                           payload_availability='metadata-only-no-current-payload-claim'))


def snapshot(row):
    value = metadata(row, 'Source-map-descriptor-only')
    names = [item['historical_path'] for item in value['files']]
    need(value['schema'] == 'rust-command-source-snapshot.v1' and value['bytes_normalized'] is False and
         len(names) == len(set(names)), 'unique byte-exact Source map required')
    return {item['historical_path']: item for item in value['files']}


def children(value, role):
    """Select references inside one explicitly chosen field; never load its ancestry."""
    if isinstance(value, dict):
        if {'path', 'sha256'} <= set(value):
            select(value, role)
        else:
            for child in value.values():
                children(child, role)
    elif isinstance(value, list):
        for child in value:
            children(child, role)


def preparation(row, role):
    value = metadata(row, role)
    for key in ['own_sources', 'README', 'author', 'writer_Source', 'complete_before',
                'complete_parent_diff', 'factual_checker', 'same_input_comparer',
                'complete_before_and_parent_diffs', 'document_correspondence',
                'source_correspondence', 'input_only_request', 'prospective_pairing_policy']:
        if key in value:
            children(value[key], role + ':' + key)
    for family in ['source_proposals', 'application_sources']:
        for item in value.get(family, []):
            for key in ['actual_before', 'before_archive', 'proposal', 'proposed', 'exact_diff', 'exact_parent_diff']:
                if isinstance(item.get(key), dict):
                    select(item[key], role + ':proposal-correspondence')
    for family in ['Original_ranges', 'Original_and_Source_ranges']:
        for item in value.get(family, []):
            select(item.get('full_literal_range', item.get('literal_archive')), role + ':complete-Original-range')
    return value


def application(row, role, family='application'):
    value = metadata(row, role)
    for key in ['source_before', 'source_literal', 'source_cleanup_literal', 'source_final']:
        if key in value:
            snapshot(value[key])
    for item in value[family]:
        for key in ['before_archive', 'proposal', 'exact_diff', 'actual_before_archive',
                    'actual_literal_archive', 'actual_final_archive', 'actual_semantic_diff',
                    'actual_formatter_diff', 'complete_cleanup_diff', 'complete_formatter_diff']:
            if isinstance(item.get(key), dict):
                select(item[key], role + ':literal-diff-or-selected-archive')
    for key in ['actual_literal_application', 'actual_application_writer', 'actual_correction_Source',
                'actual_writer_Source', 'runtime_source_bindings']:
        if key in value:
            select(value[key], role + ':' + key)
    receipt(value['actual_formatter_execution'], role + ':actual-formatter', stable=None)
    return value


def comparison(row, execution, role, expected_source, baseline, historical_direct=False):
    value = metadata(row, role)
    need(value['schema'] == 'src05-cold-guard-actual-selected-comparison.v1' and
         value['scientific_PASS_claimed'] is False and
         value['whole_surface_environment_or_ordinary_PASS_claimed'] is False, 'bounded actual cold report required')
    same(value['actual_Rust_Source'], expected_source)
    same(value['actual_Native_baseline'], baseline)
    need(value['status'] in {'MISMATCH_OR_REQUIRED_UNAVAILABLE', 'NO_MISMATCH_IN_AVAILABLE_SELECTED_PAIRS'}, 'unrecognized actual comparer status')
    if historical_direct:
        need(execution is None, 'historical direct comparison has no recorder receipt; never retrofit one')
    else:
        need(execution is not None, 'new comparison requires its genuine recorder receipt')
        command = receipt(execution, role + ':actual-execution', expected_source, allowed=(0, 2))
        need(command['exit_code'] == (0 if value['status'] == 'NO_MISMATCH_IN_AVAILABLE_SELECTED_PAIRS' else 2), 'actual status/exit differs')
        emitted = load(command['stdout'])
        same(emitted['report'], row)
        need(emitted['status'] == value['status'] and emitted['scientific_PASS_claimed'] is False, 'actual comparer stdout differs')
    need(set(value['full_pair_and_unavailable_logs']) == LEDGERS, 'all four complete cold gzip ledgers required')
    for name, artifact in value['full_pair_and_unavailable_logs'].items():
        need(artifact['path'].endswith('.jsonl.gz'), 'complete gzip artifact required')
        select(artifact, role + ':complete-opaque-gzip:' + name)
    for key in ['comparer_Source', 'frozen_pair_policy', 'actual_Rust_custody',
                'Root_Rust_factual_review', 'independent_Rust_factual_review']:
        select(value[key], role + ':' + key)
    select(value['actual_Native_result'], role + ':complete-Native-stdout')
    select(value['actual_Rust_result'], role + ':complete-Rust-stdout')
    return value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--packet', required=True, help='reviewed actual packet path#sha256')
    args = parser.parse_args()
    name, sha = args.packet.rsplit('#', 1)
    packet_ref = dict(path=name, sha256=sha)
    packet = metadata(packet_ref, 'actual-finite-publication-packet')
    need(set(packet) == KEYS and packet['schema'] == 'src05-weather-cold-publication-inputs.v1', 'exact finite packet schema required')
    for key in ['Source_acceptances', 'retained_closed_failures']:
        need(isinstance(packet[key], list), 'explicit finite list required')
    for key in ['Root_publication_Source_review', 'independent_publication_Source_review']:
        review = metadata(packet[key], key)
        need(review['accepted'] is True, 'both publication Source reviews required')
        same(review['publisher_Source'], full(Path(__file__)))
    need(packet['Source_acceptances'], 'approved actual Source roots required')
    for row in packet['Source_acceptances']:
        review = metadata(row, 'approved-Source-or-resumption-review')
        need(review.get('accepted', review.get('Root_FULL_Source_review_accepted', False)) is True, 'accepted Source root required')
    old = application(packet['actual_application'], 'weather15-actual-application')
    correction = application(packet['actual_compile_correction'], 'actual-compile-corrections', 'corrections')
    cleanup = application(packet['actual_cleanup'], 'actual-development-test-cleanup', 'changes')
    producer = application(packet['actual_producer_extension'], 'actual-site-station-producer4')
    same(correction['prior_application'], packet['actual_application'])
    same(cleanup['historical_actual_compile_correction'], packet['actual_compile_correction'])
    same(producer['parent_cleanup_delta'], packet['actual_cleanup'])
    same(producer['source_before'], cleanup['source_final'])
    need(len(old['application']) == 15 and len(producer['application']) == 4, 'actual weather15/producer4 closure required')
    preparation(old['weather_Source_preparation'], 'reviewed-weather-Source-preparation')
    preparation(old['observer_Source_preparation'], 'reviewed-observer-Source-preparation')
    pp = preparation(producer['producer_Source_preparation'], 'reviewed-producer-Source-preparation')
    need(len(pp['source_proposals']) == 4 and len(pp['Original_ranges']) == 9, 'four proposals and nine full Original ranges required')
    writer = preparation(packet['writer_Source_preparation'], 'reviewed-W04-Source-preparation')
    facts = preparation(packet['facts_Source_preparation'], 'reviewed-facts05-Source-preparation')
    same(writer['actual_producer_extension'], packet['actual_producer_extension'])
    same(facts['actual_producer_extension'], packet['actual_producer_extension'])
    source = producer['source_final']
    members = snapshot(source)
    names = {item['canonical_path'] for item in old['application'] + producer['application']}
    need(len(names) == 17, 'exact seventeen final weather/observer paths required')
    bindings = metadata(producer['runtime_source_bindings'], 'actual-current-runtime-bindings')
    names.update(item['path'] for item in bindings['observer_sources'] + bindings['actual_public_API_sources'])
    for name in sorted(names):
        member = members[name]
        select(member['archive'], 'selected-final-Rust-Source:' + name)
        checked(dict(path=name, sha256=member['archive']['sha256'], size_bytes=member['size_bytes']))
    native = metadata(packet['Native_baseline_acceptance'], 'actual-Native-baseline-acceptance')
    provider = metadata(packet['Native_provider_acceptance'], 'actual-Native-provider-acceptance')
    need(native['accepted'] is True and provider['accepted'] is True, 'actual Native release and provider acceptance required')
    same(native['actual_provider_acceptance'], packet['Native_provider_acceptance'])
    for key in ['Native_Source_preparation', 'actual_custody', 'actual_before', 'Root_factual_review', 'independent_FULL_factual_review']:
        select(native[key], 'actual-Native:' + key)
    select(native['actual_authoritative_result'], 'actual-Native:complete-authoritative-stdout')
    receipt(native['actual_Native_execution'], 'actual-Native-capture', native['Source_snapshot'])
    snapshot(native['Source_snapshot'])
    inventory = metadata(provider['provider_inventory'], 'actual-Native-provider-and-PE-inventory')
    for key in ['Root_actual_FULL_review', 'independent_actual_FULL_review']:
        select(provider[key], 'actual-Native-provider:' + key)
    select(inventory['selected_provider_map_lines'], 'actual-Native-selected-map-lines')
    for key in ['actual_Native_binary', 'actual_full_link_map', 'actual_helper_object']:
        provenance(provider[key], 'accepted Native provider custody; large payload deliberately not republished')
    build = metadata(packet['actual_build_record'], 'actual-final-quality-and-build')
    same(build['Source_snapshot'], source)
    need(set(build['quality_executions']) == {'fmt_check', 'clippy', 'workspace'}, 'three actual quality roles required')
    for name, row in build['quality_executions'].items():
        receipt(row, 'actual-quality:' + name, source)
    cargo = build['actual_Cargo_artifact']
    receipt(cargo['actual_build_execution'], 'actual-Cargo-build-and-full-JSON', source)
    select(cargo['PE_inspection']['actual_PE_header_bytes'], 'actual-Rust-PE-header-bytes')
    artifact = metadata(packet['actual_Root_artifact_acceptance'], 'actual-Root-PE-and-artifact-acceptance')
    need(artifact['accepted'] is True, 'actual Root artifact acceptance required')
    same(artifact['actual_build_record'], packet['actual_build_record'])
    same(artifact['Source_snapshot'], source)
    for key in ['actual_executable', 'immutable_binary_archive']:
        provenance(artifact[key], 'accepted immutable Rust build/capture hash; executable payload not republished')
    custody = metadata(packet['actual_Rust_custody'], 'actual-final-Rust-capture-custody')
    same(custody['Source_snapshot'], source)
    same(custody['actual_build_record'], packet['actual_build_record'])
    same(custody['actual_Root_artifact_acceptance'], packet['actual_Root_artifact_acceptance'])
    receipt(custody['actual_execution'], 'actual-final-Rust-capture', source, allowed=(custody['actual_exit_code'],))
    for key in ['actual_input', 'actual_pair_policy', 'actual_complete_stdout', 'actual_complete_stderr']:
        select(custody[key], 'actual-final-Rust-capture:' + key)
    for key in ['Root_Rust_factual_review', 'independent_Rust_factual_review']:
        review = metadata(packet[key], key)
        need(review['accepted'] is True, 'both actual Rust facts required')
        same(review['actual_custody'], packet['actual_Rust_custody'])
        same(review['Source_snapshot'], source)
        same(review['factual_checker_source'], facts['factual_checker'])
        receipt(review['actual_outer_execution'], key + ':actual-capture-driver-outer', source)
    for execution_key, review_key in [('actual_Root_facts_execution', 'Root_Rust_factual_review'),
                                      ('actual_independent_facts_execution', 'independent_Rust_factual_review')]:
        command = receipt(packet[execution_key], execution_key, source)
        emitted = load(command['stdout'])
        same(emitted['review'], packet[review_key])
        need(emitted['scientific_PASS_claimed'] is False, 'actual facts command scope differs')
    need(packet['first_comparison']['sha256'] == '0266f0aa1175e72c1d9e7681bf301872b55860736d5c3761b9bc976635a8aa21', 'literal first genuine failure required')
    first = comparison(packet['first_comparison'], packet['first_comparison_execution'], 'preserved-first-genuine-FAIL', cleanup['source_final'], packet['Native_baseline_acceptance'], historical_direct=True)
    need(first['status'] == 'MISMATCH_OR_REQUIRED_UNAVAILABLE', 'first actual failure must remain a failure')
    previous_custody = metadata(first['actual_Rust_custody'], 'first-FAIL-historical-Rust-custody')
    receipt(previous_custody['actual_execution'], 'first-FAIL-historical-Rust-capture', cleanup['source_final'], allowed=(previous_custody['actual_exit_code'],))
    provenance(previous_custody['actual_executable_after'], 'first-FAIL historical immutable executable identity only')
    final = comparison(packet['actual_comparison'], packet['actual_comparison_execution'], 'actual-final-strict-comparison', source, packet['Native_baseline_acceptance'])
    same(final['actual_Rust_custody'], packet['actual_Rust_custody'])
    same(final['comparer_Source'], facts['same_input_comparer'])
    for key in ['Root_Rust_factual_review', 'independent_Rust_factual_review']:
        same(final[key], packet[key])
    for key in ['Root_comparison_factual_review', 'independent_comparison_factual_review']:
        review = metadata(packet[key], key)
        need(review['accepted'] is True, 'both final comparison factual reviews required')
        same(review['actual_comparison'], packet['actual_comparison'])
        same(review['actual_execution'], packet['actual_comparison_execution'])
        same(review['Source_snapshot'], source)
    for row in packet['retained_closed_failures']:
        receipt(row, 'preserved-closed-historical-failure', allowed=(1, 2, 101), stable=None)
    select(full(Path(__file__)), 'actual-publication-Source')
    for path, (sha, size) in SEEN.items():
        need(digest(path) == sha and path.stat().st_size == size, 'authenticated bytes changed before publication')
    need(not OUT.exists(), 'fresh canonical evidence directory required')
    objects = OUT / 'objects/raw'
    objects.mkdir(parents=True)
    rows = []
    for path in sorted(SELECTED):
        original = full(path)
        stored_path = objects / original['sha256']
        if not stored_path.exists():
            with path.open('rb') as stream, stored_path.open('xb') as sink:
                shutil.copyfileobj(stream, sink, 1024 * 1024)
        stored = full(stored_path)
        need(stored['sha256'] == original['sha256'] and stored['size_bytes'] == original['size_bytes'], 'complete raw storage differs')
        rows.append(dict(historical_path=original['path'], original=original, stored=stored, storage='raw-byte-exact', roles=sorted(SELECTED[path])))
    for path, (sha, size) in SEEN.items():
        need(digest(path) == sha and path.stat().st_size == size, 'authenticated bytes changed during publication')
    archive = dict(schema='src05-weather-cold-selected-archive.v1', objects=rows,
                   all_selected_bytes_stored_exact=True, recursive_ancestry_collected=False,
                   whole_Source_snapshot_payloads_published=False,
                   Source_maps_are_metadata_only=True, executable_map_object_library_payloads_published=False)
    with (OUT / 'manifest.json').open('x', encoding='utf8', newline='\n') as stream:
        json.dump(archive, stream, ensure_ascii=False, allow_nan=False, indent=2); stream.write('\n')
    fields = ['status', 'paired_row_counts', 'mismatch_counts', 'required_unavailable',
              'nonfinite_observations_excluded_from_numerical_PASS', 'full_pair_and_unavailable_logs']
    summary = dict(schema='src05-weather-cold-evidence.v1', status=final['status'], actual_packet=packet_ref,
                   Source_snapshot=source, selected_archive=full(OUT / 'manifest.json'),
                   preserved_first_failure={key: first[key] for key in fields},
                   first_comparison_execution=None,
                   first_comparison_execution_provenance='historical direct tool execution; no recorder receipt retained',
                   first_comparison_actual_program_exit_code=None,
                   actual_final_comparison={key: final[key] for key in fields},
                   actual_test_totals=build['actual_test_totals'], provenance_only=PROVENANCE,
                   selected_closure_transitively_replayable=False,
                   scientific_outcome_copied_from_actual_comparer=True,
                   publisher_storage_success_is_not_scientific_PASS=True,
                   scientific_PASS_claimed=False, whole_surface_environment_or_ordinary_PASS_claimed=False,
                   pending_SRC05=['complete ordinary weather/inside arrays and cold-guard reachability',
                                  'persistent ordinary air/surface owners and correction cadence',
                                  'SRC07/08 consumer handoff and successful complete ordinary comparison'],
                   gates_updated=False)
    with (OUT / 'summary.json').open('x', encoding='utf8', newline='\n') as stream:
        json.dump(summary, stream, ensure_ascii=False, allow_nan=False, indent=2); stream.write('\n')
    print(json.dumps(dict(summary=full(OUT / 'summary.json'), manifest=full(OUT / 'manifest.json'),
                          actual_comparison_status=final['status'], selected_rows=len(rows))))


if __name__ == '__main__':
    main()

fn parameter_snapshot(p: SurfaceOutdoorEnvironmentParameters) -> Value {
    json!({"SiteTempGradient":scalar(p.site_temperature_gradient_k_per_m),"WeatherFileTempModCoeff":scalar(p.weather_file_temperature_modifier_c),
        "SiteWindExp":scalar(p.site_wind_exponent),"SiteWindBLHeight":scalar(p.site_wind_boundary_layer_height_m),"WeatherFileWindModCoeff":scalar(p.weather_file_wind_modifier)})
}
fn environment_snapshot(p: SurfaceOutdoorEnvironmentParameters, w: SurfaceOutdoorWeather) -> Value {
    let mut value = parameter_snapshot(p);
    let map = value.as_object_mut().expect("parameter snapshot is an object");
    for (key, owner) in [("OutDryBulbTemp",w.dry_bulb_c),("OutWetBulbTemp",w.wet_bulb_c),("WindSpeed",w.wind_speed_m_per_s),("WindDir",w.wind_direction_deg)] {
        map.insert(key.into(),scalar(owner));
    }
    value
}
fn backend_failure(e: &SourceErrorBackendFailure) -> Value {
    match e {
        SourceErrorBackendFailure::Effect { operation, source } => json!({"kind":"Rust_backend_IO_error","operation":operation,
            "io_kind":format!("{:?}",source.kind()),"raw_os_error":source.raw_os_error(),"message":source.to_string()}),
        SourceErrorBackendFailure::UndefinedCounterIncrement { counter } => json!({"kind":"undefined_counter_increment","counter":counter}),
    }
}
fn stopped_cause(e: &SurfaceOutdoorEnvironmentError) -> Value {
    match e {
        SurfaceOutdoorEnvironmentError::Backend(e) | SurfaceOutdoorEnvironmentError::Fatal(SourceFatalStop::Backend(e)) => backend_failure(e),
        SurfaceOutdoorEnvironmentError::Fatal(SourceFatalStop::Fatal(e)) => json!({"kind":"Rust_source_fatal","message":e.message}),
        SurfaceOutdoorEnvironmentError::Format(e) => json!({"kind":"selected_format_unavailable","message":e}),
        SurfaceOutdoorEnvironmentError::Unavailable(e) => json!({"kind":"selected_prerequisite_unavailable","message":e}),
    }
}
fn evaluate(item: &Value) -> Result<Value> {
    keys(item, &["case_id","purpose","admission_lane","initial","operations"])?;
    text(&item["case_id"])?; text(&item["purpose"])?;
    let lane = text(&item["admission_lane"])?;
    require(matches!(lane,"manager-sequence-direct"|"incoming-array-cold-check-direct"), "selected direct lane required")?;
    let (mut f, defaults) = Fixture::new(&item["initial"])?;
    let prepared = f.snapshot(); let mut calls = Vec::new(); let mut boundaries = Vec::new(); let mut unreached = Vec::new();
    let mut ids = BTreeSet::new();
    for op in rows(&item["operations"])? {
        keys(op, &["operation_id","weather","sequence"])?;
        let id = text(&op["operation_id"])?;
        require(ids.insert(id),"unique operation ID required")?;
        let sequence = rows(&op["sequence"])?;
        let expected = if lane == "manager-sequence-direct" { vec!["bulbs","check","wind_speed","wind_direction"] } else { vec!["check"] };
        require(sequence.iter().map(text).collect::<Result<Vec<_>>>()? == expected,"exact admitted stage order required")?;
        if f.stopped { unreached.push(op.clone()); continue; }
        let w = &op["weather"];
        keys(w, &["OutDryBulbTemp","OutWetBulbTemp","WindSpeed","WindDir"])?;
        let before = f.snapshot();
        f.weather = SurfaceOutdoorWeather { dry_bulb_c:real(&w["OutDryBulbTemp"],true)?,wet_bulb_c:real(&w["OutWetBulbTemp"],true)?,
            wind_speed_m_per_s:real(&w["WindSpeed"],false)?,wind_direction_deg:real(&w["WindDir"],false)? };
        f.weather_assigned = true;
        boundaries.push(json!({"literal_operation":op,"before_declared_weather_writes":before,"after_declared_weather_writes":f.snapshot()}));
        for stage in expected {
            if f.stopped { unreached.push(json!({"operation_id":id,"unreached_stage":stage})); continue; }
            let before = f.snapshot();
            let (api,result) = match stage {
                "bulbs" => { set_surface_out_bulb_temperatures(f.parameters,f.weather,&mut f.rows); ("set_surface_out_bulb_temperatures",Ok(())) },
                "check" => ("check_surface_out_bulb_temperatures",f.guard()),
                "wind_speed" => { set_surface_wind_speeds(f.parameters,f.weather.wind_speed_m_per_s,&mut f.rows); ("set_surface_wind_speeds",Ok(())) },
                "wind_direction" => { set_surface_wind_directions(f.weather.wind_direction_deg,&mut f.rows); ("set_surface_wind_directions",Ok(())) },
                _ => return Err("unadmitted stage".into()),
            };
            f.stopped = result.is_err();
            calls.push(json!({"operation_id":id,"actual_call_ordinal":calls.len()+1,"stage":stage,"api":api,
                "actual_source_invoked":true,"actual_source_return_observed":result.is_ok(),"source_exception":result.as_ref().err().map(stopped_cause),
                "before":before,"after":f.snapshot()}));
        }
    }
    require(!ids.is_empty(),"full nonempty operation list required")?;
    Ok(json!({"case_id":item["case_id"],"literal_input":item,"Native_fresh_constructor_state":{"available":false,"counted_as_PASS":false},
        "actual_Rust_default_producer":{"api":"SurfaceOutdoorEnvironmentParameters::default_weather_station","terrain":"Suburbs","actual_return":defaults},
        "prepared_state":prepared,"declared_weather_boundaries":boundaries,"actual_calls":calls,"unreached_operations_or_stages":unreached,
        "final":f.snapshot(),"actual_source_call_count":calls.len(),"actual_source_stopped":f.stopped,
        "unavailable_families":UNAVAILABLE,"ordinary_production_handoff_verified":false,"numerical_PASS_claimed":false}))
}
fn run() -> Result<()> {
    let args = std::env::args_os().collect::<Vec<_>>();
    require(args.len() == 2,"usage: src05_surface_cold_guard_main <fixed-input-only-request.json>")?;
    let bytes = std::fs::read(&args[1])?;
    require(bytes.len() == INPUT_SIZE && digest::sha256(&bytes) == INPUT_SHA256,"exact accepted input-only request bytes required")?;
    let request: Value = serde_json::from_slice(&bytes)?;
    keys(&request,&["schema","expected_values_supplied","ordinary_production_prestate_supplied","cases"])?;
    require(request["schema"] == "src05-surface-cold-guard-direct-request.v1" && request["expected_values_supplied"] == false
        && request["ordinary_production_prestate_supplied"] == false,"unadmitted request schema or expected answer input")?;
    let mut ids = BTreeSet::new(); let mut cases = Vec::new();
    for item in rows(&request["cases"])? {
        require(ids.insert(text(&item["case_id"])?),"unique case ID required")?;
        cases.push(evaluate(item)?);
    }
    require(cases.len() == 29,"all twenty-nine frozen cases required")?;
    require(std::fs::read(&args[1])? == bytes,"literal input changed during the selected calls")?;
    let result = json!({"schema":"src05-surface-cold-guard-Rust-direct-results.v1","input":{"sha256":INPUT_SHA256,"size_bytes":bytes.len()},
        "cases":cases,"requested_case_count":29,"recorded_case_count":cases.len(),"expected_values_supplied":false,
        "scientific_PASS_claimed":false,"whole_SRC05_or_ordinary_PASS_claimed":false,"gates_updated":false});
    serde_json::to_writer(io::stdout().lock(),&result)?;
    println!();
    Ok(())
}
fn main() -> std::process::ExitCode {
    match run() {
        Ok(()) => std::process::ExitCode::SUCCESS,
        Err(error) => { eprintln!("{error}"); std::process::ExitCode::from(2) }
    }
}

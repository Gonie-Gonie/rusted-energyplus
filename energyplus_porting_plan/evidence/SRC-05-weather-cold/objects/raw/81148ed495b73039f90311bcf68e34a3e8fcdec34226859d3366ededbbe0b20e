}
fn text(v: &Value) -> Result<&str> { v.as_str().ok_or_else(|| "string input required".into()) }
fn boolean(v: &Value) -> Result<bool> { v.as_bool().ok_or_else(|| "boolean input required".into()) }
fn counter(v: &Value) -> Result<i32> {
    let n = v.as_i64().ok_or("bounded signed input counter required")?;
    require((0..=1_000_000).contains(&n), "defined bounded counter domain required")?;
    Ok(i32::try_from(n)?)
}
fn real(v: &Value, nan_allowed: bool) -> Result<f64> {
    keys(v, &["bits"])?;
    let bits = text(&v["bits"])?;
    require(bits.len() == 16 && bits.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c)),
        "canonical sixteen lowercase hex digits required")?;
    let raw = u64::from_str_radix(bits, 16)?;
    let number = f64::from_bits(raw);
    require(number.is_finite() || (nan_allowed && number.is_nan() && raw & 0x0008_0000_0000_0000 != 0),
        "finite or explicitly allowed quiet NaN literal required")?;
    Ok(number)
}
fn scalar(v: f64) -> Value {
    let class = if v.is_nan() { "nan" } else if v.is_infinite() {
        if v.is_sign_negative() { "negative_infinity" } else { "positive_infinity" }
    } else if v == 0.0 {
        if v.is_sign_negative() { "negative_zero" } else { "positive_zero" }
    } else { "finite" };
    json!({"value":if v.is_finite() { Some(v) } else { None },
        "value_bits":format!("{:016x}",v.to_bits()),"value_class":class})
}

// A real Rust Write sink. Partial bytes and the real typed IO failure are retained;
// Native ostream exception/fragmentation state is explicitly unrepresented.
struct ErrorSink {
    bytes: Vec<u8>, limit: Option<usize>, appended: usize, attempts: usize, failed: bool,
}
impl Write for ErrorSink {
    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
        self.attempts += 1;
        let available = self.limit.map_or(bytes.len(), |limit| limit.saturating_sub(self.appended));
        if available == 0 && !bytes.is_empty() {
            self.failed = true;
            return Err(io::Error::new(io::ErrorKind::BrokenPipe, "declared cold-guard error byte budget exhausted"));
        }
        let accepted = bytes.len().min(available);
        self.bytes.extend_from_slice(&bytes[..accepted]);
        self.appended += accepted;
        Ok(accepted)
    }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

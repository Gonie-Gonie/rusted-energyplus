fn require(ok: bool, message: &str) -> Result<()> {
    if ok { Ok(()) } else { Err(message.to_owned().into()) }
}
fn keys(v: &Value, names: &[&str]) -> Result<()> {
    require(v.as_object().is_some_and(|o| o.len() == names.len()
        && names.iter().all(|name| o.contains_key(*name))), "exact literal input object required")
}
fn rows(v: &Value) -> Result<&[Value]> {

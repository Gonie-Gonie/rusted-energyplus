+GammaInvocationSnapshot *gamma_visit(Capture &capture,
+                                     Construction::ConstructionProps const &construction,
+                                     GammaStage stage) noexcept
+{
+    GammaCapture &ledger = capture.gamma;
+    std::size_t const index = static_cast<std::size_t>(stage);
+    ++ledger.actual_stage_callback_counts[index];
+    if (ledger.invocations.empty() ||
+        ledger.invocations.back().observed_invocation_ordinal != ledger.actual_invocation_count) {
+        ++ledger.stage_records_omitted[index];
+        gamma_failure(capture, nullptr, stage, MethodFailureKind::AssociationFailure);
+        return nullptr;
+    }
+    GammaInvocationSnapshot &invocation = ledger.invocations.back();
+    if (++invocation.actual_stage_callback_counts[index] > 1) {
+        ++ledger.stage_records_omitted[index];
+        gamma_failure(capture, &invocation, stage, MethodFailureKind::OrderFailure);
+        return nullptr;
+    }
+    if (capture.bound_state == nullptr || capture.bound_construction != &construction) {
+        gamma_failure(capture, &invocation, stage, MethodFailureKind::IdentityMismatch);
+    }
+    if (invocation.observed_invocation_ordinal != invocation.observed_assembly_ordinal ||
+        associated_assembly(capture, construction, invocation.observed_assembly_ordinal) == nullptr) {
+        gamma_failure(capture, &invocation, stage, MethodFailureKind::AssociationFailure);
+    }
+    bool ordered = invocation.entry.reached && !invocation.source_return.reached;
+    switch (stage) {
+    case GammaStage::ATempReady:
+        ordered = ordered && !invocation.ATemp_ready.reached && !invocation.Gamma1_final.reached &&
+                  !invocation.Gamma2_final.reached;
+        break;
+    case GammaStage::Gamma1Final:
+        ordered = ordered && invocation.ATemp_ready.reached && !invocation.Gamma1_final.reached &&
+                  !invocation.Gamma2_final.reached;
+        break;
+    case GammaStage::Gamma2Final:
+        ordered = ordered && invocation.Gamma1_final.reached && !invocation.Gamma2_final.reached;
+        break;
+    case GammaStage::SourceReturn:
+        ordered = ordered && invocation.Gamma2_final.reached;
+        break;
+    case GammaStage::Entry:
+        ordered = false;
+        break;
+    }
+    if (!ordered) gamma_failure(capture, &invocation, stage, MethodFailureKind::OrderFailure);
+    return &invocation;
+}

+void gamma_entry(Construction::ConstructionProps const &construction) noexcept
+{
+    Capture *capture = active_capture;
+    if (capture == nullptr) return;
+    GammaCapture &ledger = capture->gamma;
+    std::size_t const ordinal = ++ledger.actual_invocation_count;
+    std::size_t const entry = static_cast<std::size_t>(GammaStage::Entry);
+    ++ledger.actual_stage_callback_counts[entry];
+    bool const previous_returned = ordinal == 1 ||
+        (!ledger.invocations.empty() && ledger.invocations.back().observed_invocation_ordinal == ordinal - 1 &&
+         ledger.invocations.back().source_return.reached);
+    try {
+        ledger.invocations.emplace_back();
+    } catch (...) {
+        ++ledger.stage_records_omitted[entry];
+        gamma_failure(*capture, nullptr, GammaStage::Entry, MethodFailureKind::LedgerAppendException);
+        return;
+    }
+    GammaInvocationSnapshot &invocation = ledger.invocations.back();
+    invocation.observed_invocation_ordinal = ordinal;
+    invocation.observed_assembly_ordinal = capture->actual_matrix_attempt_callback_count;
+    ++invocation.actual_stage_callback_counts[entry];
+    if (capture->bound_state == nullptr || capture->bound_construction != &construction) {
+        gamma_failure(*capture, &invocation, GammaStage::Entry, MethodFailureKind::IdentityMismatch);
+        invocation.entry.reached = true;
+        return;
+    }
+    invocation.association_available = ordinal == invocation.observed_assembly_ordinal &&
+        associated_assembly(*capture, construction, invocation.observed_assembly_ordinal) != nullptr;
+    if (!invocation.association_available) {
+        gamma_failure(*capture, &invocation, GammaStage::Entry, MethodFailureKind::AssociationFailure);
+    }
+    if (!previous_returned || !gamma_prior_methods_returned(*capture, ordinal)) {
+        gamma_failure(*capture, &invocation, GammaStage::Entry, MethodFailureKind::OrderFailure);
+    }
+    copy_gamma_matrices(*capture, invocation, GammaStage::Entry, construction, invocation.entry,
+        {{GammaMatrixOwner::AExp, &construction.AExp}, {GammaMatrixOwner::IdenMatrix, &construction.IdenMatrix},
+         {GammaMatrixOwner::AInv, &construction.AInv}});
+    invocation.entry.BMat_bounds = array_bounds(construction.BMat);
+    if (!exact_vector(invocation.entry.BMat_bounds, 3)) {
+        gamma_failure(*capture, &invocation, GammaStage::Entry, MethodFailureKind::MatrixShape);
+        return;
+    }
+    for (int i = 1; i <= 3; ++i) invocation.entry.BMat[static_cast<std::size_t>(i - 1)] = copy_bits(construction.BMat(i));
+    invocation.entry.BMat_available = true;
+}

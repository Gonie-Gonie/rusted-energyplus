+
+void copy_gamma_matrices(Capture &capture, GammaInvocationSnapshot &invocation,
+                         GammaStage stage, Construction::ConstructionProps const &construction,
+                         GammaValueSnapshot &snapshot,
+                         std::initializer_list<GammaMatrixView> views) noexcept
+{
+    snapshot.reached = true;
+    snapshot.context = method_context(capture, construction, invocation.observed_assembly_ordinal);
+    snapshot.NumOfPerpendNodes = construction.NumOfPerpendNodes;
+    if (capture.bound_state == nullptr || capture.bound_construction != &construction) return;
+    if (views.size() > snapshot.matrices.size()) {
+        gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+        return;
+    }
+    snapshot.observed_matrix_count = views.size();
+    std::size_t index = 0;
+    for (GammaMatrixView const &view : views) {
+        GammaMatrixSnapshot &copy = snapshot.matrices[index++];
+        copy.owner = view.owner;
+        copy.bounds = array_bounds(*view.values);
+    }
+    int const columns = snapshot.context.rcmax;
+    if (columns < 1) {
+        gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+        return;
+    }
+    std::size_t const count = static_cast<std::size_t>(columns);
+    index = 0;
+    bool complete = true;
+    for (GammaMatrixView const &view : views) {
+        GammaMatrixSnapshot &copy = snapshot.matrices[index++];
+        int const rows = view.owner == GammaMatrixOwner::Gamma1 || view.owner == GammaMatrixOwner::Gamma2 ? 3 : columns;
+        std::size_t const row_count = static_cast<std::size_t>(rows);
+        if (count > std::numeric_limits<std::size_t>::max() / row_count) {
+            complete = false;
+            gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+            continue;
+        }
+        std::size_t const elements = row_count * count;
+        if (!copy.bounds || copy.bounds->lower1 != 1 || copy.bounds->upper1 != rows ||
+            copy.bounds->lower2 != 1 || copy.bounds->upper2 != columns || copy.bounds->size != elements) {
+            complete = false;
+            gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+            continue;
+        }
+        try {
+            copy.values.reserve(elements);
+            for (int i1 = 1; i1 <= rows; ++i1) {
+                for (int i2 = 1; i2 <= columns; ++i2) {
+                    copy.values.push_back(copy_bits((*view.values)(i1, i2)));
+                }
+            }
+            copy.copy_available = copy.values.size() == elements;
+            if (!copy.copy_available) {
+                complete = false;
+                gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
+            }
+        } catch (...) {
+            copy.values.clear();
+            complete = false;
+            gamma_failure(capture, &invocation, stage, MethodFailureKind::CopyException);
+        }
+    }
+    snapshot.matrices_available = complete;
+}

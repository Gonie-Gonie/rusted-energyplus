void post_conversion(EnergyPlusData const &state, Construction::ConstructionProps const &construction,
                     bool ErrorsFound, bool DoCTFErrorReport, int LayersInConstruct, int NumResLayers,
                     Array1D<Real64> const &dl, Array1D<Real64> const &rk,
                     Array1D<Real64> const &rho, Array1D<Real64> const &cp,
                     Array1D<Real64> const &lr, Array1D_bool const &ResLayer,
                     Real64 const &dyn, Real64 const &rs, Real64 const &cnd) noexcept
{
    Snapshot *snapshot = copy_prefix(Phase::PostConversion, state, construction, ErrorsFound, DoCTFErrorReport,
                                     LayersInConstruct, NumResLayers, dl, rk, rho, cp, lr, ResLayer);
    if (snapshot != nullptr) {
        snapshot->dyn = copy_bits(dyn);
        snapshot->rs = copy_bits(rs);
        snapshot->cnd = copy_bits(cnd);
    }
}

void post_initial_discretization(EnergyPlusData const &state,
                                 Construction::ConstructionProps const &construction,
                                 bool ErrorsFound, bool DoCTFErrorReport,
                                 int LayersInConstruct, int NumResLayers,
                                 Array1D_int const &Nodes, Array1D<Real64> const &dx,
                                 Real64 const &TimeStepZone) noexcept
{
    Capture *capture = active_capture;
    if (capture == nullptr) {
        return;
    }
    std::size_t const index = static_cast<std::size_t>(Phase::InitialDiscretization);
    std::size_t const previous_count = capture->actual_callback_count++;
    if (capture->bound_state != &state || capture->bound_construction != &construction) {
        capture->identity_mismatch = true;
        return;
    }
    ++capture->actual_phase_callback_counts[index];
    if (previous_count != index) {
        capture->phase_order_invalid = true;
    }
    InitialDiscretizationSnapshot &snapshot = capture->initial_discretization;
    if (snapshot.reached) {
        capture->duplicate_phase = true;
        return;
    }
    snapshot.reached = true;
    snapshot.ErrorsFound = ErrorsFound;
    snapshot.DoCTFErrorReport = DoCTFErrorReport;
    snapshot.LayersInConstruct = LayersInConstruct;
    snapshot.NumResLayers = NumResLayers;
    snapshot.rcmax = construction.rcmax;
    snapshot.NodeSource = construction.NodeSource;
    snapshot.NodeUserTemp = construction.NodeUserTemp;
    snapshot.CTFTimeStep = copy_bits(construction.CTFTimeStep);
    snapshot.NumHistories = construction.NumHistories;
    snapshot.TimeStepZone = copy_bits(TimeStepZone);
    if (LayersInConstruct < 0 || LayersInConstruct > Construction::MaxLayersInConstruct ||
        !covers_prefix(Nodes, LayersInConstruct) || !covers_prefix(dx, LayersInConstruct)) {
        capture->active_prefix_invalid = true;
        return;
    }
    for (int layer = 1; layer <= LayersInConstruct; ++layer) {
        InitialLayerSnapshot &copy = snapshot.active_prefix[static_cast<std::size_t>(layer - 1)];
        copy.Nodes = Nodes(layer);
        copy.dx = copy_bits(dx(layer));
    }
    snapshot.copied_layer_count = static_cast<std::size_t>(LayersInConstruct);
    snapshot.active_prefix_available = true;
}

namespace {

void matrix_failure(Capture &capture, MatrixAttemptSnapshot *snapshot,
                    std::size_t ordinal, MatrixAttemptFailureKind kind) noexcept
{
    capture.matrix_observer_failure = true;
    std::size_t const index = static_cast<std::size_t>(kind);
    ++capture.matrix_failure_event_counts[index];
    if (snapshot != nullptr) snapshot->failure_kinds[index] = true;
    MatrixAttemptFailure const failure{ordinal, kind};
    if (!capture.first_matrix_failure) capture.first_matrix_failure = failure;
    capture.last_matrix_failure = failure;
}

std::optional<Array1Bounds> array_bounds(Array1D<Real64> const &values) noexcept
{
    if (!values.allocated()) return std::nullopt;
    return Array1Bounds{values.l(), values.u(), values.size()};
}

std::optional<Array2Bounds> array_bounds(Array2D<Real64> const &values) noexcept
{
    if (!values.allocated()) return std::nullopt;
    return Array2Bounds{values.l1(), values.u1(), values.l2(), values.u2(), values.size()};
}

bool exact_vector(std::optional<Array1Bounds> const &bounds, int count) noexcept
{
    return bounds && bounds->lower == 1 && bounds->upper == count &&
           bounds->size == static_cast<std::size_t>(count);
}

bool exact_square(std::optional<Array2Bounds> const &bounds, int count,
                  std::size_t elements) noexcept
{
    return bounds && bounds->lower1 == 1 && bounds->upper1 == count &&
           bounds->lower2 == 1 && bounds->upper2 == count && bounds->size == elements;
}

} // namespace

void post_matrix_assembly(EnergyPlusData const &state,
                          Construction::ConstructionProps const &construction,
                          bool ErrorsFound, bool DoCTFErrorReport,
                          int LayersInConstruct, int NumResLayers,
                          Array1D<Real64> const &dl, Array1D<Real64> const &rk,
                          Array1D<Real64> const &rho, Array1D<Real64> const &cp,
                          Array1D<Real64> const &lr, Array1D_bool const &ResLayer,
                          Array1D_int const &Nodes, Array1D<Real64> const &dx,
                          Real64 const &TimeStepZone) noexcept
{
    Capture *capture = active_capture;
    if (capture == nullptr) return;
    std::size_t const ordinal = ++capture->actual_matrix_attempt_callback_count;
    if (capture->bound_state != &state || capture->bound_construction != &construction) {
        ++capture->matrix_attempt_records_omitted;
        matrix_failure(*capture, nullptr, ordinal, MatrixAttemptFailureKind::IdentityMismatch);
        return;
    }
    // Keep the visit identity even if dynamic record storage cannot be obtained.
    try {
        capture->matrix_attempts.emplace_back();
    } catch (...) {
        ++capture->matrix_attempt_records_omitted;
        matrix_failure(*capture, nullptr, ordinal, MatrixAttemptFailureKind::LedgerAppendException);
        return;
    }
    MatrixAttemptSnapshot &snapshot = capture->matrix_attempts.back();
    snapshot.observed_attempt_ordinal = ordinal;
    snapshot.reached = true;
    if (capture->actual_callback_count != 4 ||
        !capture->initial_discretization.reached ||
        capture->actual_phase_callback_counts != std::array<std::size_t, 4>{1, 1, 1, 1}) {
        matrix_failure(*capture, &snapshot, ordinal, MatrixAttemptFailureKind::OrderFailure);
    }
    snapshot.ErrorsFound = ErrorsFound;
    snapshot.DoCTFErrorReport = DoCTFErrorReport;
    snapshot.IsUsedCTF = construction.IsUsedCTF;
    snapshot.SourceSinkPresent = construction.SourceSinkPresent;
    snapshot.SolutionDimensions = construction.SolutionDimensions;
    snapshot.TotLayers = construction.TotLayers;
    snapshot.LayersInConstruct = LayersInConstruct;
    snapshot.NumResLayers = NumResLayers;
    snapshot.rcmax = construction.rcmax;
    snapshot.NodeSource = construction.NodeSource;
    snapshot.NodeUserTemp = construction.NodeUserTemp;
    snapshot.CTFTimeStep = copy_bits(construction.CTFTimeStep);
    snapshot.NumHistories = construction.NumHistories;
    snapshot.TimeStepZone = copy_bits(TimeStepZone);
    snapshot.AMat_bounds = array_bounds(construction.AMat);
    snapshot.IdenMatrix_bounds = array_bounds(construction.IdenMatrix);
    snapshot.BMat_bounds = array_bounds(construction.BMat);
    snapshot.CMat_bounds = array_bounds(construction.CMat);
    snapshot.DMat_bounds = array_bounds(construction.DMat);
    if (LayersInConstruct < 1 || LayersInConstruct > Construction::MaxLayersInConstruct ||
        NumResLayers < 0 || NumResLayers > LayersInConstruct ||
        !covers_prefix(dl, LayersInConstruct) || !covers_prefix(rk, LayersInConstruct) ||
        !covers_prefix(rho, LayersInConstruct) || !covers_prefix(cp, LayersInConstruct) ||
        !covers_prefix(lr, LayersInConstruct) || !covers_prefix(ResLayer, LayersInConstruct) ||
        !covers_prefix(Nodes, LayersInConstruct) || !covers_prefix(dx, LayersInConstruct)) {
        matrix_failure(*capture, &snapshot, ordinal, MatrixAttemptFailureKind::ActivePrefixShape);
        return;
    }
    for (int layer = 1; layer <= LayersInConstruct; ++layer) {
        MatrixLayerSnapshot &copy = snapshot.active_prefix[static_cast<std::size_t>(layer - 1)];
        copy.converted.dl = copy_bits(dl(layer));
        copy.converted.rk = copy_bits(rk(layer));
        copy.converted.rho = copy_bits(rho(layer));
        copy.converted.cp = copy_bits(cp(layer));
        copy.converted.lr = copy_bits(lr(layer));
        copy.converted.ResLayer = ResLayer(layer);
        copy.Nodes = Nodes(layer);
        copy.dx = copy_bits(dx(layer));
    }
    snapshot.copied_layer_count = static_cast<std::size_t>(LayersInConstruct);
    snapshot.active_prefix_available = true;
    if (construction.SolutionDimensions != 1 || construction.rcmax < 1) {
        matrix_failure(*capture, &snapshot, ordinal, MatrixAttemptFailureKind::MatrixShape);
        return;
    }
    std::size_t const count = static_cast<std::size_t>(construction.rcmax);
    if (count > std::numeric_limits<std::size_t>::max() / count) {
        matrix_failure(*capture, &snapshot, ordinal, MatrixAttemptFailureKind::MatrixShape);
        return;
    }
    std::size_t const elements = count * count;
    if (!exact_square(snapshot.AMat_bounds, construction.rcmax, elements) ||
        !exact_square(snapshot.IdenMatrix_bounds, construction.rcmax, elements) ||
        !exact_vector(snapshot.BMat_bounds, 3) || !exact_vector(snapshot.CMat_bounds, 2) ||
        !exact_vector(snapshot.DMat_bounds, 2)) {
        matrix_failure(*capture, &snapshot, ordinal, MatrixAttemptFailureKind::MatrixShape);
        return;
    }
    try {
        snapshot.AMat.reserve(elements);
        snapshot.IdenMatrix.reserve(elements);
        for (int i1 = 1; i1 <= construction.rcmax; ++i1) {
            for (int i2 = 1; i2 <= construction.rcmax; ++i2) {
                snapshot.AMat.push_back(copy_bits(construction.AMat(i1, i2)));
                snapshot.IdenMatrix.push_back(copy_bits(construction.IdenMatrix(i1, i2)));
            }
        }
        for (int i = 1; i <= 3; ++i) snapshot.BMat[static_cast<std::size_t>(i - 1)] = copy_bits(construction.BMat(i));
        for (int i = 1; i <= 2; ++i) {
            snapshot.CMat[static_cast<std::size_t>(i - 1)] = copy_bits(construction.CMat(i));
            snapshot.DMat[static_cast<std::size_t>(i - 1)] = copy_bits(construction.DMat(i));
        }
        if (snapshot.AMat.size() != elements || snapshot.IdenMatrix.size() != elements) {
            matrix_failure(*capture, &snapshot, ordinal, MatrixAttemptFailureKind::MatrixShape);
            return;
        }
        snapshot.matrices_available = true;
    } catch (...) {
        // Partial dynamic buffers remain unavailable, and no exception reaches Native.
        snapshot.AMat.clear();
        snapshot.IdenMatrix.clear();
        matrix_failure(*capture, &snapshot, ordinal, MatrixAttemptFailureKind::CopyException);
    }
}


namespace {

MethodCapture &method_capture(Capture &capture, MethodKind method) noexcept
{
    return method == MethodKind::Exponential ? capture.exponential : capture.inverse;
}

void method_failure(Capture &capture, MethodKind method, MethodInvocationSnapshot *invocation,
                    MethodStage stage, MethodFailureKind kind) noexcept
{
    MethodCapture &ledger = method_capture(capture, method);
    ledger.observer_failure = true;
    std::size_t const index = static_cast<std::size_t>(kind);
    ++ledger.failure_event_counts[index];
    if (invocation != nullptr) invocation->failure_kinds[index] = true;
    MethodFailure const failure{method, ledger.actual_invocation_count,
        invocation == nullptr ? capture.actual_matrix_attempt_callback_count : invocation->observed_assembly_ordinal,
        stage, kind};
    if (!ledger.first_failure) ledger.first_failure = failure;
    ledger.last_failure = failure;
}

MatrixAttemptSnapshot const *associated_assembly(Capture const &capture,
                                                Construction::ConstructionProps const &construction,
                                                std::size_t ordinal) noexcept
{
    if (ordinal == 0 || ordinal != capture.actual_matrix_attempt_callback_count ||
        capture.matrix_attempts.empty()) return nullptr;
    MatrixAttemptSnapshot const &assembly = capture.matrix_attempts.back();
    if (assembly.observed_attempt_ordinal != ordinal || !assembly.reached ||
        !assembly.active_prefix_available || !assembly.matrices_available) return nullptr;
    for (bool failed : assembly.failure_kinds) if (failed) return nullptr;
    if (assembly.IsUsedCTF != construction.IsUsedCTF ||
        assembly.SourceSinkPresent != construction.SourceSinkPresent ||
        assembly.SolutionDimensions != construction.SolutionDimensions ||
        assembly.TotLayers != construction.TotLayers || assembly.rcmax != construction.rcmax ||
        assembly.NodeSource != construction.NodeSource || assembly.NodeUserTemp != construction.NodeUserTemp ||
        assembly.NumHistories != construction.NumHistories ||
        assembly.CTFTimeStep.bits != copy_bits(construction.CTFTimeStep).bits) return nullptr;
    return &assembly;
}

MethodContext method_context(Capture const &capture,
                             Construction::ConstructionProps const &construction,
                             std::size_t ordinal) noexcept
{
    MethodContext context;
    context.IsUsedCTF = construction.IsUsedCTF;
    context.SourceSinkPresent = construction.SourceSinkPresent;
    context.SolutionDimensions = construction.SolutionDimensions;
    context.TotLayers = construction.TotLayers;
    context.rcmax = construction.rcmax;
    context.NodeSource = construction.NodeSource;
    context.NodeUserTemp = construction.NodeUserTemp;
    context.CTFTimeStep = copy_bits(construction.CTFTimeStep);
    context.NumHistories = construction.NumHistories;
    MatrixAttemptSnapshot const *assembly = associated_assembly(capture, construction, ordinal);
    if (assembly != nullptr) {
        context.assembly_context_available = true;
        context.assembly_ErrorsFound = assembly->ErrorsFound;
        context.assembly_DoCTFErrorReport = assembly->DoCTFErrorReport;
        context.assembly_TimeStepZone = assembly->TimeStepZone;
    }
    return context;
}

MethodInvocationSnapshot *method_visit(Capture &capture, MethodKind method,
                                       Construction::ConstructionProps const &construction,
                                       MethodStage stage) noexcept
{
    MethodCapture &ledger = method_capture(capture, method);
    std::size_t const index = static_cast<std::size_t>(stage);
    ++ledger.actual_stage_callback_counts[index];
    if (ledger.invocations.empty() ||
        ledger.invocations.back().observed_invocation_ordinal != ledger.actual_invocation_count) {
        ++ledger.stage_records_omitted[index];
        method_failure(capture, method, nullptr, stage, MethodFailureKind::AssociationFailure);
        return nullptr;
    }
    MethodInvocationSnapshot &invocation = ledger.invocations.back();
    ++invocation.actual_stage_callback_counts[index];
    if (stage != MethodStage::PowerControl && stage != MethodStage::SquareControl &&
        invocation.actual_stage_callback_counts[index] > 1) {
        ++ledger.stage_records_omitted[index];
        method_failure(capture, method, &invocation, stage, MethodFailureKind::OrderFailure);
        return nullptr; // Preserve the first real value record, retaining the extra visit count.
    }
    if (capture.bound_state == nullptr || capture.bound_construction != &construction) {
        method_failure(capture, method, &invocation, stage, MethodFailureKind::IdentityMismatch);
    }
    if (invocation.observed_invocation_ordinal != invocation.observed_assembly_ordinal ||
        associated_assembly(capture, construction, invocation.observed_assembly_ordinal) == nullptr) {
        method_failure(capture, method, &invocation, stage, MethodFailureKind::AssociationFailure);
    }
    bool ordered = invocation.entry.reached && !invocation.source_return.reached;
    switch (stage) {
    case MethodStage::InitializedInputs:
        ordered = ordered && !invocation.initialized_inputs.reached;
        break;
    case MethodStage::ScalingControls:
        ordered = ordered && method == MethodKind::Exponential && invocation.initialized_inputs.reached &&
                  !invocation.scaling_controls.reached;
        break;
    case MethodStage::PowerControl:
        ordered = ordered && method == MethodKind::Exponential && invocation.scaling_controls.reached &&
                  !invocation.final_workspace.reached &&
                  invocation.actual_stage_callback_counts[static_cast<std::size_t>(MethodStage::SquareControl)] == 0;
        break;
    case MethodStage::SquareControl:
        ordered = ordered && method == MethodKind::Exponential && invocation.scaling_controls.reached &&
                  !invocation.final_workspace.reached;
        break;
    case MethodStage::FinalWorkspace:
        ordered = ordered && !invocation.final_workspace.reached && invocation.initialized_inputs.reached &&
                  (method == MethodKind::Inverse || invocation.scaling_controls.reached);
        break;
    case MethodStage::SourceReturn:
        ordered = ordered && invocation.final_workspace.reached;
        break;
    case MethodStage::Entry:
        ordered = false; // Entry has its own independent actual invocation counter.
        break;
    }
    if (!ordered) method_failure(capture, method, &invocation, stage, MethodFailureKind::OrderFailure);
    return &invocation;
}

struct MatrixView
{
    MatrixOwner owner;
    Array2D<Real64> const *values;
};

void copy_method_matrices(Capture &capture, MethodKind method, MethodInvocationSnapshot &invocation,
                          MethodStage stage, Construction::ConstructionProps const &construction,
                          MethodValueSnapshot &snapshot,
                          std::initializer_list<MatrixView> views) noexcept
{
    snapshot.reached = true;
    snapshot.context = method_context(capture, construction, invocation.observed_assembly_ordinal);
    if (views.size() > snapshot.matrices.size()) {
        method_failure(capture, method, &invocation, stage, MethodFailureKind::MatrixShape);
        return;
    }
    snapshot.observed_matrix_count = views.size();
    std::size_t index = 0;
    for (MatrixView const &view : views) {
        MethodMatrixSnapshot &copy = snapshot.matrices[index++];
        copy.owner = view.owner;
        copy.bounds = array_bounds(*view.values);
    }
    int const dimension = snapshot.context.rcmax;
    if (dimension < 1) {
        method_failure(capture, method, &invocation, stage, MethodFailureKind::MatrixShape);
        return;
    }
    std::size_t const count = static_cast<std::size_t>(dimension);
    if (count > std::numeric_limits<std::size_t>::max() / count) {
        method_failure(capture, method, &invocation, stage, MethodFailureKind::MatrixShape);
        return;
    }
    std::size_t const elements = count * count;
    index = 0;
    bool complete = true;
    for (MatrixView const &view : views) {
        MethodMatrixSnapshot &copy = snapshot.matrices[index++];
        if (!exact_square(copy.bounds, dimension, elements)) {
            complete = false;
            method_failure(capture, method, &invocation, stage, MethodFailureKind::MatrixShape);
            continue;
        }
        try {
            copy.values.reserve(elements);
            for (int i1 = 1; i1 <= dimension; ++i1) {
                for (int i2 = 1; i2 <= dimension; ++i2) {
                    copy.values.push_back(copy_bits((*view.values)(i1, i2)));
                }
            }
            copy.copy_available = copy.values.size() == elements;
            if (!copy.copy_available) {
                complete = false;
                method_failure(capture, method, &invocation, stage, MethodFailureKind::MatrixShape);
            }
        } catch (...) {
            copy.values.clear();
            complete = false;
            method_failure(capture, method, &invocation, stage, MethodFailureKind::CopyException);
        }
    }
    snapshot.matrices_available = complete;
}

ExponentialControls copy_controls(Real64 const &norm, int k, Real64 const &fact,
                                  Real64 const &check, int l, std::optional<int> final_i) noexcept
{
    return ExponentialControls{copy_bits(norm), k, copy_bits(fact), copy_bits(check), l, final_i};
}


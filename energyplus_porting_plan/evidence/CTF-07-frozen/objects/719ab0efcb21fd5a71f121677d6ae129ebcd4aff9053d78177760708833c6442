void method_return(MethodKind method, EnergyPlusData const &state,
                   Construction::ConstructionProps const &construction,
                   bool ErrorsFound, bool DoCTFErrorReport, Real64 const &TimeStepZone) noexcept
{
    Capture *capture = active_capture;
    if (capture == nullptr) return;
    MethodInvocationSnapshot *invocation = method_visit(*capture, method, construction, MethodStage::SourceReturn);
    if (invocation == nullptr) return;
    if (capture->bound_state != &state) {
        method_failure(*capture, method, invocation, MethodStage::SourceReturn, MethodFailureKind::IdentityMismatch);
    }
    MethodValueSnapshot &snapshot = invocation->source_return;
    snapshot.caller_context_available = capture->bound_state == &state && capture->bound_construction == &construction;
    snapshot.caller_ErrorsFound = ErrorsFound;
    snapshot.caller_DoCTFErrorReport = DoCTFErrorReport;
    snapshot.caller_TimeStepZone = copy_bits(TimeStepZone);
    MatrixAttemptSnapshot const *assembly = associated_assembly(*capture, construction, invocation->observed_assembly_ordinal);
    if (assembly == nullptr || assembly->ErrorsFound != ErrorsFound ||
        assembly->DoCTFErrorReport != DoCTFErrorReport || assembly->TimeStepZone.bits != copy_bits(TimeStepZone).bits) {
        method_failure(*capture, method, invocation, MethodStage::SourceReturn, MethodFailureKind::AssociationFailure);
    }
    copy_method_matrices(*capture, method, *invocation, MethodStage::SourceReturn, construction, snapshot,
        {{MatrixOwner::AMat, &construction.AMat}, {MatrixOwner::IdenMatrix, &construction.IdenMatrix},
        {method == MethodKind::Exponential ? MatrixOwner::AExp : MatrixOwner::AInv,
         method == MethodKind::Exponential ? &construction.AExp : &construction.AInv}});
}

// Independent Gamma observer: copies actual owners and never evaluates Gamma.
namespace {

void gamma_failure(Capture &capture, GammaInvocationSnapshot *invocation,
                   GammaStage stage, MethodFailureKind kind) noexcept
{
    GammaCapture &ledger = capture.gamma;
    ledger.observer_failure = true;
    std::size_t const index = static_cast<std::size_t>(kind);
    ++ledger.failure_event_counts[index];
    if (invocation != nullptr) invocation->failure_kinds[index] = true;
    GammaFailure const failure{ledger.actual_invocation_count,
        invocation == nullptr ? capture.actual_matrix_attempt_callback_count : invocation->observed_assembly_ordinal,
        stage, kind};
    if (!ledger.first_failure) ledger.first_failure = failure;
    ledger.last_failure = failure;
}

bool gamma_prior_methods_returned(Capture const &capture, std::size_t ordinal) noexcept
{
    std::size_t const returned = static_cast<std::size_t>(MethodStage::SourceReturn);
    for (MethodCapture const *ledger : {&capture.exponential, &capture.inverse}) {
        if (ledger->actual_invocation_count != ordinal ||
            ledger->actual_stage_callback_counts[returned] != ordinal || ledger->invocations.empty() ||
            ledger->invocations.back().observed_invocation_ordinal != ordinal ||
            ledger->invocations.back().observed_assembly_ordinal != ordinal ||
            !ledger->invocations.back().source_return.reached) return false;
    }
    return true;
}

GammaInvocationSnapshot *gamma_visit(Capture &capture,
                                     Construction::ConstructionProps const &construction,
                                     GammaStage stage) noexcept
{
    GammaCapture &ledger = capture.gamma;
    std::size_t const index = static_cast<std::size_t>(stage);
    ++ledger.actual_stage_callback_counts[index];
    if (ledger.invocations.empty() ||
        ledger.invocations.back().observed_invocation_ordinal != ledger.actual_invocation_count) {
        ++ledger.stage_records_omitted[index];
        gamma_failure(capture, nullptr, stage, MethodFailureKind::AssociationFailure);
        return nullptr;
    }
    GammaInvocationSnapshot &invocation = ledger.invocations.back();
    if (++invocation.actual_stage_callback_counts[index] > 1) {
        ++ledger.stage_records_omitted[index];
        gamma_failure(capture, &invocation, stage, MethodFailureKind::OrderFailure);
        return nullptr;
    }
    if (capture.bound_state == nullptr || capture.bound_construction != &construction) {
        gamma_failure(capture, &invocation, stage, MethodFailureKind::IdentityMismatch);
    }
    if (invocation.observed_invocation_ordinal != invocation.observed_assembly_ordinal ||
        associated_assembly(capture, construction, invocation.observed_assembly_ordinal) == nullptr) {
        gamma_failure(capture, &invocation, stage, MethodFailureKind::AssociationFailure);
    }
    bool ordered = invocation.entry.reached && !invocation.source_return.reached;
    switch (stage) {
    case GammaStage::ATempReady:
        ordered = ordered && !invocation.ATemp_ready.reached && !invocation.Gamma1_final.reached &&
                  !invocation.Gamma2_final.reached;
        break;
    case GammaStage::Gamma1Final:
        ordered = ordered && invocation.ATemp_ready.reached && !invocation.Gamma1_final.reached &&
                  !invocation.Gamma2_final.reached;
        break;
    case GammaStage::Gamma2Final:
        ordered = ordered && invocation.Gamma1_final.reached && !invocation.Gamma2_final.reached;
        break;
    case GammaStage::SourceReturn:
        ordered = ordered && invocation.Gamma2_final.reached;
        break;
    case GammaStage::Entry:
        ordered = false;
        break;
    }
    if (!ordered) gamma_failure(capture, &invocation, stage, MethodFailureKind::OrderFailure);
    return &invocation;
}

struct GammaMatrixView
{
    GammaMatrixOwner owner;
    Array2D<Real64> const *values;
};

void copy_gamma_matrices(Capture &capture, GammaInvocationSnapshot &invocation,
                         GammaStage stage, Construction::ConstructionProps const &construction,
                         GammaValueSnapshot &snapshot,
                         std::initializer_list<GammaMatrixView> views) noexcept
{
    snapshot.reached = true;
    snapshot.context = method_context(capture, construction, invocation.observed_assembly_ordinal);
    snapshot.NumOfPerpendNodes = construction.NumOfPerpendNodes;
    if (capture.bound_state == nullptr || capture.bound_construction != &construction) return;
    if (views.size() > snapshot.matrices.size()) {
        gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
        return;
    }
    snapshot.observed_matrix_count = views.size();
    std::size_t index = 0;
    for (GammaMatrixView const &view : views) {
        GammaMatrixSnapshot &copy = snapshot.matrices[index++];
        copy.owner = view.owner;
        copy.bounds = array_bounds(*view.values);
    }
    int const columns = snapshot.context.rcmax;
    if (columns < 1) {
        gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
        return;
    }
    std::size_t const count = static_cast<std::size_t>(columns);
    index = 0;
    bool complete = true;
    for (GammaMatrixView const &view : views) {
        GammaMatrixSnapshot &copy = snapshot.matrices[index++];
        int const rows = view.owner == GammaMatrixOwner::Gamma1 || view.owner == GammaMatrixOwner::Gamma2 ? 3 : columns;
        std::size_t const row_count = static_cast<std::size_t>(rows);
        if (count > std::numeric_limits<std::size_t>::max() / row_count) {
            complete = false;
            gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
            continue;
        }
        std::size_t const elements = row_count * count;
        if (!copy.bounds || copy.bounds->lower1 != 1 || copy.bounds->upper1 != rows ||
            copy.bounds->lower2 != 1 || copy.bounds->upper2 != columns || copy.bounds->size != elements) {
            complete = false;
            gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
            continue;
        }
        try {
            copy.values.reserve(elements);
            for (int i1 = 1; i1 <= rows; ++i1) {
                for (int i2 = 1; i2 <= columns; ++i2) {
                    copy.values.push_back(copy_bits((*view.values)(i1, i2)));
                }
            }
            copy.copy_available = copy.values.size() == elements;
            if (!copy.copy_available) {
                complete = false;
                gamma_failure(capture, &invocation, stage, MethodFailureKind::MatrixShape);
            }
        } catch (...) {
            copy.values.clear();
            complete = false;
            gamma_failure(capture, &invocation, stage, MethodFailureKind::CopyException);
        }
    }
    snapshot.matrices_available = complete;
}

} // namespace

void gamma_entry(Construction::ConstructionProps const &construction) noexcept
{
    Capture *capture = active_capture;
    if (capture == nullptr) return;
    GammaCapture &ledger = capture->gamma;
    std::size_t const ordinal = ++ledger.actual_invocation_count;
    std::size_t const entry = static_cast<std::size_t>(GammaStage::Entry);
    ++ledger.actual_stage_callback_counts[entry];
    bool const previous_returned = ordinal == 1 ||
        (!ledger.invocations.empty() && ledger.invocations.back().observed_invocation_ordinal == ordinal - 1 &&
         ledger.invocations.back().source_return.reached);
    try {
        ledger.invocations.emplace_back();
    } catch (...) {
        ++ledger.stage_records_omitted[entry];
        gamma_failure(*capture, nullptr, GammaStage::Entry, MethodFailureKind::LedgerAppendException);
        return;
    }
    GammaInvocationSnapshot &invocation = ledger.invocations.back();
    invocation.observed_invocation_ordinal = ordinal;
    invocation.observed_assembly_ordinal = capture->actual_matrix_attempt_callback_count;
    ++invocation.actual_stage_callback_counts[entry];
    if (capture->bound_state == nullptr || capture->bound_construction != &construction) {
        gamma_failure(*capture, &invocation, GammaStage::Entry, MethodFailureKind::IdentityMismatch);
        invocation.entry.reached = true;
        return;
    }
    invocation.association_available = ordinal == invocation.observed_assembly_ordinal &&
        associated_assembly(*capture, construction, invocation.observed_assembly_ordinal) != nullptr;
    if (!invocation.association_available) {
        gamma_failure(*capture, &invocation, GammaStage::Entry, MethodFailureKind::AssociationFailure);
    }
    if (!previous_returned || !gamma_prior_methods_returned(*capture, ordinal)) {
        gamma_failure(*capture, &invocation, GammaStage::Entry, MethodFailureKind::OrderFailure);
    }
    copy_gamma_matrices(*capture, invocation, GammaStage::Entry, construction, invocation.entry,
        {{GammaMatrixOwner::AExp, &construction.AExp}, {GammaMatrixOwner::IdenMatrix, &construction.IdenMatrix},
         {GammaMatrixOwner::AInv, &construction.AInv}});
    invocation.entry.BMat_bounds = array_bounds(construction.BMat);
    if (!exact_vector(invocation.entry.BMat_bounds, 3)) {
        gamma_failure(*capture, &invocation, GammaStage::Entry, MethodFailureKind::MatrixShape);
        return;
    }
    for (int i = 1; i <= 3; ++i) invocation.entry.BMat[static_cast<std::size_t>(i - 1)] = copy_bits(construction.BMat(i));
    invocation.entry.BMat_available = true;
}


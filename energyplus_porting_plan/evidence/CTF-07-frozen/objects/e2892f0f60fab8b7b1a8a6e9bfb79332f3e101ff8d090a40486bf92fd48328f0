+inline bool gamma_copy_failed(MethodObservation::GammaCapture const &source)
+{
+    if (source.observer_failure || source.actual_invocation_count != source.invocations.size() ||
+        source.first_failure || source.last_failure) return true;
+    for (auto count : source.failure_event_counts) if (count != 0) return true;
+    for (auto count : source.stage_records_omitted) if (count != 0) return true;
+    std::array<std::size_t, 5> retained_counts{};
+    for (std::size_t index = 0; index < source.invocations.size(); ++index) {
+        auto const &record = source.invocations[index];
+        if (record.observed_invocation_ordinal != index + 1 || !record.association_available ||
+            record.observed_assembly_ordinal != record.observed_invocation_ordinal) return true;
+        for (bool failed : record.failure_kinds) if (failed) return true;
+        std::array<std::size_t, 5> const retained{{record.entry.reached ? 1u : 0u, record.ATemp_ready.reached ? 1u : 0u,
+            record.Gamma1_final.reached ? 1u : 0u, record.Gamma2_final.reached ? 1u : 0u, record.source_return.reached ? 1u : 0u}};
+        if (record.actual_stage_callback_counts != retained) return true;
+        for (std::size_t stage = 0; stage < retained.size(); ++stage) retained_counts[stage] += retained[stage];
+        for (auto const *value : {&record.entry, &record.ATemp_ready, &record.Gamma1_final, &record.Gamma2_final, &record.source_return}) {
+            if (!value->reached) continue; // Preserve actual source stops without inventing stages.
+            if (!value->matrices_available || !value->context.assembly_context_available ||
+                value->observed_matrix_count > value->matrices.size()) return true;
+            for (std::size_t matrix = 0; matrix < value->observed_matrix_count; ++matrix)
+                if (!value->matrices[matrix].copy_available) return true;
+        }
+        if (record.entry.reached && !record.entry.BMat_available) return true;
+        if (record.source_return.reached && (!record.source_return.caller_context_available || !record.source_return.caller_TimeStepZone)) return true;
+    }
+    return retained_counts != source.actual_stage_callback_counts;
+}
+inline json gamma_observations(MethodObservation::GammaCapture const &source)
+{
+    json invocations = json::array(), stages = json::array(), failures = json::array();
+    for (auto const &record : source.invocations) {
+        json kinds = json::array();
+        for (std::size_t index = 0; index < record.failure_kinds.size(); ++index)
+            kinds.push_back({{"kind", method_failure_name(static_cast<MethodObservation::MethodFailureKind>(index))}, {"failed", record.failure_kinds[index]}});
+        invocations.push_back({{"observed_invocation_ordinal", record.observed_invocation_ordinal},
+            {"observed_assembly_ordinal", record.observed_assembly_ordinal}, {"association_available", record.association_available},
+            {"failure_kinds", kinds}, {"actual_stage_callback_counts", record.actual_stage_callback_counts},
+            {"Entry", gamma_value(record.entry, true)}, {"ATempReady", gamma_value(record.ATemp_ready)},
+            {"Gamma1Final", gamma_value(record.Gamma1_final)}, {"Gamma2Final", gamma_value(record.Gamma2_final)},
+            {"SourceReturn", gamma_value(record.source_return)}, {"counted_as_PASS", false}});
+    }
+    for (std::size_t index = 0; index < source.actual_stage_callback_counts.size(); ++index)
+        stages.push_back({{"stage", gamma_stage_name(static_cast<MethodObservation::GammaStage>(index))},
+            {"actual_callback_count", source.actual_stage_callback_counts[index]}, {"records_omitted", source.stage_records_omitted[index]}});
+    for (std::size_t index = 0; index < source.failure_event_counts.size(); ++index)
+        failures.push_back({{"kind", method_failure_name(static_cast<MethodObservation::MethodFailureKind>(index))},
+            {"actual_event_count", source.failure_event_counts[index]}});
+    return {{"protocol", "ctf07-gamma-method-observation.v1"}, {"method", "Gamma"},
+        {"actual_invocation_count", source.actual_invocation_count}, {"actual_retained_invocation_count", source.invocations.size()},
+        {"actual_stage_callback_counts", source.actual_stage_callback_counts}, {"stage_records_omitted", source.stage_records_omitted},
+        {"stage_ledger", stages}, {"observer_failure", source.observer_failure}, {"method_copy_integrity_failed", gamma_copy_failed(source)},
+        {"failure_event_counts", failures}, {"first_failure", gamma_failure_event(source.first_failure)},
+        {"last_failure", gamma_failure_event(source.last_failure)}, {"invocations", invocations},
+        {"no_actual_entry_observed", source.actual_invocation_count == 0}, {"record_cap", nullptr}, {"deduplicated", false},
+        {"truncated", false}, {"unreached_counted_as_PASS", false}, {"later_attempts_counted_as_PASS", false},
+        {"values_or_identity_or_return_reconstructed", false}, {"old_checkpoint_matrix_05_06_counters_include_Gamma_callbacks", false}};
+}

+    case Stage::Entry: return "Entry";
+    case Stage::ATempReady: return "ATempReady";
+    case Stage::Gamma1Final: return "Gamma1Final";
+    case Stage::Gamma2Final: return "Gamma2Final";
+    case Stage::SourceReturn: return "SourceReturn";
+    }

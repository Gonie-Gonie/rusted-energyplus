+}
+inline char const *gamma_matrix_name(MethodObservation::GammaMatrixOwner value)
+{
+    using Owner = MethodObservation::GammaMatrixOwner;
+    switch (value) {
+    case Owner::AExp: return "AExp";
+    case Owner::IdenMatrix: return "IdenMatrix";
+    case Owner::AInv: return "AInv";
+    case Owner::ATemp: return "ATemp";
+    case Owner::Gamma1: return "Gamma1";
+    case Owner::Gamma2: return "Gamma2";
+    }
+    throw std::runtime_error("Unknown actual Gamma matrix owner");
+}
+inline json gamma_value(MethodObservation::GammaValueSnapshot const &source, bool BMat_required = false)
+{
+    if (!source.reached) return {{"reached", false}, {"available", false}, {"snapshot", nullptr},
+        {"unavailable_reason", "actual_stage_callback_not_retained_or_not_reached"}, {"counted_as_PASS", false}};
+    require(source.observed_matrix_count <= source.matrices.size(), "Observed Gamma matrix count exceeds owner storage");
+    json matrices = json::array(), BMat = nullptr, BMat_bounds = nullptr, caller = nullptr;
+    for (std::size_t index = 0; index < source.observed_matrix_count; ++index) {
+        auto const &copy = source.matrices[index]; json bounds = nullptr, values = nullptr;
+        if (copy.bounds) bounds = {{"lower1", copy.bounds->lower1}, {"upper1", copy.bounds->upper1},
+            {"lower2", copy.bounds->lower2}, {"upper2", copy.bounds->upper2}, {"size", copy.bounds->size}};
+        if (copy.copy_available) {
+            values = json::array();
+            for (auto const &value : copy.values) values.push_back(scalar_bits(value.bits));
+        }
+        matrices.push_back({{"owner", gamma_matrix_name(copy.owner)}, {"actual_bounds", bounds},
+            {"copy_available", copy.copy_available}, {"values", values}});
+    }
+    if (source.BMat_bounds) BMat_bounds = {{"lower", source.BMat_bounds->lower},
+        {"upper", source.BMat_bounds->upper}, {"size", source.BMat_bounds->size}};
+    if (source.BMat_available) {
+        BMat = json::array();
+        for (auto const &value : source.BMat) BMat.push_back(scalar_bits(value.bits));
+    }
+    if (source.caller_context_available) caller = {{"ErrorsFound", source.caller_ErrorsFound},
+        {"DoCTFErrorReport", source.caller_DoCTFErrorReport},
+        {"TimeStepZone", source.caller_TimeStepZone ? scalar_bits(source.caller_TimeStepZone->bits) : json(nullptr)}};
+    bool const available = source.matrices_available && (!BMat_required || source.BMat_available);
+    json context = source.observed_matrix_count != 0 ? method_context(source.context) : json(nullptr);
+    if (!context.is_null()) context["NumOfPerpendNodes"] = source.NumOfPerpendNodes;
+    return {{"reached", true}, {"available", available},
+        {"unavailable_reason", available ? json(nullptr) : json("required_Gamma_owner_copy_unavailable")},
+        {"snapshot", {{"context_available", source.observed_matrix_count != 0}, {"context", context},
+            {"matrices_available", source.matrices_available}, {"observed_matrix_count", source.observed_matrix_count},
+            {"matrices", matrices}, {"BMat_available", source.BMat_available}, {"BMat_actual_bounds", BMat_bounds}, {"BMat", BMat},
+            {"caller_context_available", source.caller_context_available}, {"actual_return_site_caller_context", caller}}},
+        {"counted_as_PASS", false}};
+}
